# All tunables in one place. Override any from the environment: SFT_EPOCHS=1 ./run_all.sh
# --- training ---
: "${SFT_EPOCHS:=2}"
: "${SFT_LR:=2e-4}"
: "${LORA_BATCH:=2}"          # SFT per-device batch (grad-accum SFT_ACCUM). Lower if RAM is short: logits cost batch x seq x 151k x 4 bytes
: "${SFT_ACCUM:=4}"
: "${LORA_DPO_BATCH:=4}"      # pairs per DPO step
: "${LORA_SEQ:=1024}"         # max tokens per sequence (left-truncated)
: "${DPO_MAX:=400}"           # preference pairs used
: "${DPO_EPOCHS:=1}"
: "${DPO_LR:=2e-5}"
: "${DPO_BETA:=0.1}"
# --- data (relative to lora-train/) ---
: "${TRAIN_FILE:=data/train.jsonl}"
: "${EVAL_FILE:=data/heldout.jsonl}"
# --- evaluation ---
: "${LORA_EVAL_EVERY:=1}"     # every n-th eval row; base and tuned are compared in ONE pass on identical rows
: "${LORA_EVAL_BATCH:=12}"
# --- machine ---
: "${LORA_THREADS:=$(nproc)}"
# --- stages, in order; remove one to skip it. Finished stages are skipped on re-run (work/done/<stage>) -- rm the marker to redo
: "${STAGES:=setup base data sft eval_sft dpo eval_dpo pack}"
: "${WORK:=$(pwd)/work}"
: "${BASE_DIR:=}"             # optional: an existing copy of Qwen/Qwen3-0.6B (skips the download)
