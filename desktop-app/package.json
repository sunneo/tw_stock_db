{
  "name": "floating-assistant-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "floating-assistant.js 的Electron單機封裝——檔案存取直接授權（不用瀏覽器每次重新授權）、可執行本機程式的subagent、內建本地proxy取代Cloudflare Worker",
  "main": "main.js",
  "scripts": {
    "build:assistant": "node build-assistant.js",
    "prestart": "npm run build:assistant",
    "start": "electron .",
    "prepack": "npm run build:assistant",
    "pack": "electron-builder --dir",
    "predist:win": "npm run build:assistant",
    "dist:win": "electron-builder --win dir",
    "predist:linux": "npm run build:assistant",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^44.4.0",
    "electron-builder": "^24.13.3",
    "terser": "^5.51.2"
  },
  "build": {
    "appId": "com.tw-stock-db.floating-assistant-desktop",
    "productName": "FloatingAssistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "local-proxy.js",
      "browser-search.js",
      "edge-tts.js",
      "cli-format.js",
      "browser-control-server.js",
      "coding-workspace.js",
      "build-config.json",
      "renderer/**/*",
      "!renderer/src/**",
      "build/icon.png",
      "builtin-secrets.json"
    ],
    "afterPack": "build/afterPack.js",
    "win": {
      "executableName": "FloatingAssistantApp",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FloatingAssistant",
      "uninstallDisplayName": "FloatingAssistant",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "asar": true
  }
}
