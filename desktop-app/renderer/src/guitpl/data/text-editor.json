{
  "format": "guitpl-domain/1",
  "domain": "text-editor",
  "label": "文字編輯器",
  "keywords": ["文字編輯", "編輯器", "記事本", "筆記", "日記", "notepad", "editor"],
  "steps": [
    {
      "id": "layout", "ask": "版面要哪一種？",
      "options": [
        { "id": "toolbar-top", "label": "上方工具列、中間大編輯區、下方狀態列", "keywords": ["工具列", "傳統", "簡單"], "default": true,
          "fragment": {
            "layout": {
              "window": { "title": "文字編輯器", "width": 560, "resizable": true },
              "tree": [ { "kind": "column", "children": [
                { "kind": "row", "children": [
                  { "id": "new", "kind": "button", "text": "新增" },
                  { "id": "save", "kind": "button", "text": "存檔" },
                  { "id": "wrap", "kind": "checkbox", "text": "自動換行", "checked": true } ] },
                { "id": "editor", "kind": "editor", "value": "", "lang": "text", "rows": 16 },
                { "id": "status", "kind": "label", "text": "就緒" } ] } ] },
            "scenes": [
              { "id": "main", "title": "編輯中", "note": "上方工具列、中間編輯區、下方狀態列" },
              { "id": "saved", "title": "存檔後", "note": "狀態列顯示已存次數與字數", "state": { "saved": 1 } } ] } },
        { "id": "side-list", "label": "左側檔案清單、右側編輯區（多檔）", "keywords": ["多檔", "側邊", "清單", "檔案清單"],
          "fragment": {
            "layout": {
              "window": { "title": "多檔文字編輯器", "width": 680, "resizable": true },
              "tree": [ { "kind": "column", "children": [
                { "kind": "row", "children": [
                  { "id": "new", "kind": "button", "text": "新增" },
                  { "id": "save", "kind": "button", "text": "存檔" },
                  { "id": "wrap", "kind": "checkbox", "text": "自動換行", "checked": true } ] },
                { "kind": "row", "children": [
                  { "id": "files", "kind": "list", "items": ["未命名 1"], "selected": "未命名 1" },
                  { "id": "editor", "kind": "editor", "value": "", "lang": "text", "rows": 16 } ] },
                { "id": "status", "kind": "label", "text": "就緒" } ] } ] },
            "scenes": [
              { "id": "main", "title": "單檔編輯", "note": "左側只有一個檔案" },
              { "id": "multi", "title": "多檔切換", "note": "新增後清單變長，點選切換", "state": { "files": 2 } } ] } }
      ]
    },
    {
      "id": "behavior", "ask": "編輯時要哪些行為？",
      "options": [
        { "id": "basic", "label": "基本：存檔次數與字數統計", "keywords": ["基本", "字數"], "default": true,
          "fragment": { "behavior": { "state": { "saved": 0, "wrap": true }, "handlers": [
            { "on": "click:save", "do": "save_file" },
            { "on": "click:new", "do": "new_file" },
            { "on": "input:editor", "do": "count_words" },
            { "on": "change:wrap", "do": "toggle_wrap" } ] } } },
        { "id": "plain", "label": "精簡：只有新增與存檔", "keywords": ["精簡", "最少"],
          "fragment": { "behavior": { "state": { "saved": 0 }, "handlers": [
            { "on": "click:save", "do": "save_file" },
            { "on": "click:new", "do": "new_file" } ] } } }
      ]
    },
    { "id": "palette", "ask": "配色要哪一種？", "use": "_common:palette" },
    { "id": "theme", "ask": "佈景要哪一種？", "use": "_common:theme" },
    {
      "id": "shortcuts", "ask": "快捷鍵要哪一組？",
      "options": [
        { "id": "editor", "label": "編輯器慣用（Ctrl+S 存檔、Ctrl+N 新增）", "keywords": ["慣用", "Ctrl"], "default": true,
          "fragment": { "shortcuts": [ { "keys": "Ctrl+S", "do": "save_file" }, { "keys": "Ctrl+N", "do": "new_file" } ] } },
        { "id": "minimal", "label": "只有 Ctrl+S 存檔", "keywords": ["只有存檔"],
          "fragment": { "shortcuts": [ { "keys": "Ctrl+S", "do": "save_file" } ] } }
      ]
    },
    {
      "id": "sound", "ask": "要不要音效？", "optional": true,
      "options": [
        { "id": "quiet", "label": "安靜（不要音效）", "keywords": ["安靜", "不要音效", "靜音"], "default": true, "fragment": {} },
        { "id": "beeps", "label": "存檔與新增有短音效", "keywords": ["音效", "聲音", "提示音"],
          "fragment": { "sound": [ { "on": "save_file", "tone": "ok" }, { "on": "new_file", "tone": "click" } ] } }
      ]
    }
  ],
  "actions": {
    "save_file": { "params": [], "python": "def save_file(ctx):\n    ctx.state[\"saved\"] += 1\n    text = ctx.get(\"editor\")\n    ctx.set(\"status\", text=\"已存 %d 次，%d 字\" % (ctx.state[\"saved\"], len(text)))\n" },
    "new_file": { "params": [], "python": "def new_file(ctx):\n    ctx.set(\"editor\", value=\"\")\n    ctx.set(\"status\", text=\"新文件\")\n" },
    "count_words": { "params": [], "python": "def count_words(ctx):\n    text = ctx.get(\"editor\")\n    ctx.set(\"status\", text=\"%d 字\" % len(text))\n" },
    "toggle_wrap": { "params": [], "python": "def toggle_wrap(ctx):\n    ctx.state[\"wrap\"] = ctx.get(\"wrap\")\n    ctx.set(\"status\", text=\"自動換行：\" + (\"開\" if ctx.state[\"wrap\"] else \"關\"))\n" }
  },
  "presets": [
    { "id": "simple-notepad", "label": "簡單記事本", "keywords": ["簡單記事本", "照預設", "你決定"], "picks": { "layout": "toolbar-top", "behavior": "basic", "palette": "light", "theme": "comfy", "shortcuts": "editor", "sound": "quiet" } }
  ]
}
