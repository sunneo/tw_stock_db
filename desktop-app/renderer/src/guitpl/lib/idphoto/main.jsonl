{"kind":"meta","id":"idphoto/main","title":"證件照（簡化版）","keywords":["證件照","大頭照","證件","照片","背景色"],"entry":"build","standalone":true}
{"kind":"param","name":"name","default":"證件照","ask":"視窗標題要寫什麼？"}
{"kind":"param","name":"bg","default":"白","ask":"預設背景色要選哪一個（白、淺藍、淺灰、紅）？"}
{"kind":"require","module":"gui","source":"builtin"}
{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}
{"kind":"layout","window":{"title":"{{name}}","width":560,"resizable":true},"tree":[{"kind":"column","children":[{"slot":"toolbar"},{"kind":"row","children":[{"id":"choose_panel","kind":"column","children":[{"kind":"label","text":"尺寸"},{"id":"size_list","kind":"list","items":["一吋 2.5×3.5 公分","二吋 3.5×5.3 公分","護照 3.3×4.8 公分"],"selected":"一吋 2.5×3.5 公分"},{"kind":"label","text":"背景色"},{"id":"bg_list","kind":"list","items":["白","淺藍","淺灰","紅"],"selected":"{{bg}}"},{"kind":"row","children":[{"id":"preview_btn","kind":"button","text":"預覽"},{"id":"finish_btn","kind":"button","text":"輸出"}]}]},{"id":"view","kind":"canvas","width":240,"height":300}]},{"id":"info","kind":"label","text":"尺寸與背景色"},{"id":"done_panel","kind":"column","children":[{"id":"done_txt","kind":"label","text":"已輸出（簡化版：只示意，未存檔）"},{"id":"back_btn","kind":"button","text":"重新選擇"}]},{"slot":"statusbar"}]}]}
{"kind":"slot","name":"toolbar","use":"idphoto/toolbar","params":{"caption":"證件照工具"}}
{"kind":"slot","name":"statusbar","use":"idphoto/statusbar","params":{"hint":"請選尺寸與背景色"}}
{"kind":"scene","id":"choose","title":"選擇中","note":"選尺寸與背景色，預覽框顯示裁切線示意","show":["choose_panel","view","info"],"hide":["done_panel"],"on":{"click:finish_btn":"done","shortcut:finish":"done"}}
{"kind":"scene","id":"done","title":"已輸出","note":"只顯示完成訊息","show":["done_panel"],"hide":["choose_panel","view","info"],"on":{"click:back_btn":"choose"}}
{"kind":"shortcut","keys":"Ctrl+R","do":"redraw"}
{"kind":"shortcut","keys":"Ctrl+E","do":"finish"}
