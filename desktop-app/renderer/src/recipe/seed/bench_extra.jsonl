{"id": "b-pad-seq", "title": "四項遞推第 n 項", "level": "L1", "statement": "a(0)=1，a(1)=1，a(2)=2，a(3)=3，a(n)=a(n-1)+a(n-2)+a(n-4)。輸入 n（0≤n≤70），輸出 a(n)。", "tags": ["recurrence"], "checker": "tokens", "tests": [{"in": "23\n", "out": "252672\n"}, {"in": "6\n", "out": "18\n"}], "hidden": [{"in": "62\n", "out": "847587395370322\n"}, {"in": "37\n", "out": "663763424\n"}, {"in": "17\n", "out": "8651\n"}, {"in": "54\n", "out": "9423445312544\n"}, {"in": "47\n", "out": "183857684514\n"}, {"in": "1\n", "out": "1\n"}], "ref": {"python": "def main():\n    n = int(input()); a = [1, 1, 2, 3]\n    while len(a) <= n: a.append(a[-1] + a[-2] + a[-4])\n    print(a[n])\n"}}
{"id": "b-stairs-123", "title": "爬樓梯（一二三階）取模", "level": "L1", "statement": "每次爬 1、2 或 3 階，爬到第 n 階（1≤n≤10^18）有幾種方法？輸出除以 10^9+7 的餘數。", "tags": ["recurrence", "big-n"], "checker": "tokens", "tests": [{"in": "236462517608414649\n", "out": "414972033\n"}, {"in": "186005026620106937\n", "out": "404413198\n"}], "hidden": [{"in": "970711701145439105\n", "out": "559358819\n"}, {"in": "186132656218137541\n", "out": "583138131\n"}, {"in": "250807332387187222\n", "out": "832822611\n"}, {"in": "28\n", "out": "15902591\n"}, {"in": "803888571024524730\n", "out": "546558688\n"}, {"in": "974849286326778738\n", "out": "13570171\n"}], "ref": {"python": "def mul(A, B, M):\n    n = len(A)\n    return [[sum(A[i][k] * B[k][j] for k in range(n)) % M for j in range(n)] for i in range(n)]\ndef main():\n    n = int(input()); M = 10**9 + 7\n    R_ = [[1 if i == j else 0 for j in range(3)] for i in range(3)]; A = [[1, 1, 1], [1, 0, 0], [0, 1, 0]]; e = n\n    while e:\n        if e & 1: R_ = mul(R_, A, M)\n        A = mul(A, A, M); e >>= 1\n    # 向量 (f(n), f(n-1), f(n-2)) = A^n (f(0), f(-1), f(-2)) = A^n (1, 0, 0)\n    print(R_[0][0] % M)\n"}}
{"id": "b-no-aa", "title": "不含連續兩個 a", "level": "L2", "statement": "輸入一個由 a、b 組成的字串（長度 1～40），若不含連續兩個 a 印 yes，否則印 no。", "tags": ["dfa"], "checker": "tokens", "tests": [{"in": "bbbba\n", "out": "yes\n"}, {"in": "aabaaaaabbababb\n", "out": "no\n"}], "hidden": [{"in": "babaaaaaaaaabaabaaabbbbba\n", "out": "no\n"}, {"in": "bbabbabaabbbbabbbaabbbaba\n", "out": "no\n"}, {"in": "bbaabaabbabbb\n", "out": "no\n"}, {"in": "bbaaaaabbba\n", "out": "no\n"}, {"in": "bbbbbabbaaaabbababab\n", "out": "no\n"}, {"in": "b\n", "out": "yes\n"}], "ref": {"python": "def main():\n    print(\"no\" if \"aa\" in input().strip() else \"yes\")\n"}}
{"id": "b-mod-count-3", "title": "1 的個數除以 3 的餘數", "level": "L2", "statement": "輸入一個由 0、1 組成的字串（長度 1～40），輸出其中 1 的個數除以 3 的餘數。", "tags": ["dfa", "count"], "checker": "tokens", "tests": [{"in": "1011100011001110100\n", "out": "1\n"}, {"in": "0000100010001001111100100110001011100110\n", "out": "2\n"}], "hidden": [{"in": "1100001100111011000010100\n", "out": "2\n"}, {"in": "000010010011011111001000100100111100001\n", "out": "2\n"}, {"in": "1000111110110010011110101\n", "out": "0\n"}, {"in": "11010100111001\n", "out": "2\n"}, {"in": "100110101100110000011001110011101\n", "out": "2\n"}, {"in": "010110110100101\n", "out": "2\n"}], "ref": {"python": "def main():\n    print(input().strip().count(\"1\") % 3)\n"}}
{"id": "b-in-degree-max", "title": "最大入度", "level": "L3", "statement": "第一行 n m，接著 m 行 a b（有向邊）。輸出所有點中最大的入度。", "tags": ["semiring"], "checker": "tokens", "tests": [{"in": "6 1\n2 5\n", "out": "1\n"}, {"in": "3 8\n2 1\n3 3\n1 1\n2 1\n3 1\n1 2\n1 2\n3 2\n", "out": "4\n"}], "hidden": [{"in": "7 6\n4 2\n3 6\n6 6\n3 3\n7 7\n3 1\n", "out": "2\n"}, {"in": "3 8\n2 3\n2 3\n1 3\n3 1\n3 2\n2 1\n1 2\n3 1\n", "out": "3\n"}, {"in": "8 5\n8 8\n6 5\n4 6\n7 2\n7 5\n", "out": "2\n"}, {"in": "2 9\n2 1\n1 2\n1 1\n1 2\n1 2\n1 2\n2 1\n2 1\n1 1\n", "out": "5\n"}, {"in": "2 8\n2 2\n2 2\n1 2\n2 2\n2 2\n2 1\n2 1\n2 1\n", "out": "5\n"}, {"in": "6 2\n5 5\n4 2\n", "out": "1\n"}], "ref": {"python": "def main():\n    n, m = map(int, input().split()); d = [0] * (n + 1)\n    for _ in range(m):\n        a, b = map(int, input().split()); d[b] += 1\n    print(max(d))\n"}}
{"id": "b-lattice-binom", "title": "組合數（格子路徑）", "level": "L3", "statement": "輸入 n k（0≤k≤n≤30），輸出 C(n,k)。", "tags": ["semiring", "dp"], "checker": "tokens", "tests": [{"in": "9 4\n", "out": "126\n"}, {"in": "2 0\n", "out": "1\n"}], "hidden": [{"in": "0 0\n", "out": "1\n"}, {"in": "6 6\n", "out": "1\n"}, {"in": "9 8\n", "out": "9\n"}, {"in": "18 11\n", "out": "31824\n"}, {"in": "30 13\n", "out": "119759850\n"}, {"in": "15 9\n", "out": "5005\n"}], "ref": {"python": "def main():\n    n, k = map(int, input().split()); d = [[0] * (k + 1) for _ in range(n + 1)]\n    for i in range(n + 1):\n        d[i][0] = 1\n        for j in range(1, min(i, k) + 1): d[i][j] = d[i - 1][j - 1] + (d[i - 1][j] if j <= i - 1 else 0)\n    print(d[n][k])\n"}}
{"id": "b-lcm", "title": "最小公倍數", "level": "L4", "statement": "輸入兩個正整數 a b（≤10^9），輸出 lcm(a,b)。", "tags": ["counter"], "checker": "tokens", "tests": [{"in": "895770084 468387165\n", "out": "139855736712190620\n"}, {"in": "375653755 973633303\n", "out": "365749006265002765\n"}], "hidden": [{"in": "66890232 907723888\n", "out": "7589732682532752\n"}, {"in": "516348173 923736149\n", "out": "476969472870205777\n"}, {"in": "529455217 638092867\n", "out": "337841597363637139\n"}, {"in": "919562355 748252210\n", "out": "137612912872310910\n"}, {"in": "603606585 349511669\n", "out": "210967544942740365\n"}, {"in": "830495531 866810770\n", "out": "719882470707668870\n"}], "ref": {"python": "def main():\n    a, b = map(int, input().split()); x, y = a, b\n    while y: x, y = y, x % y\n    print(a // x * b)\n"}}
{"id": "b-is-prime", "title": "質數判斷", "level": "L4", "statement": "輸入正整數 n（≤10^9），是質數印 yes，否則 no。", "tags": ["counter"], "checker": "tokens", "tests": [{"in": "83\n", "out": "yes\n"}, {"in": "44\n", "out": "no\n"}], "hidden": [{"in": "281678144\n", "out": "no\n"}, {"in": "559439328\n", "out": "no\n"}, {"in": "593613961\n", "out": "no\n"}, {"in": "799719933\n", "out": "no\n"}, {"in": "75\n", "out": "no\n"}, {"in": "78\n", "out": "no\n"}], "ref": {"python": "def main():\n    n = int(input()); ok = n > 1; d = 2\n    while ok and d * d <= n:\n        if n % d == 0: ok = False\n        d += 1\n    print(\"yes\" if ok else \"no\")\n"}}
{"id": "b-valid-tags", "title": "標籤配對", "level": "L5", "statement": "輸入一行以空格分隔的標籤，<x> 是開、</x> 是關（x 為小寫單字母）。若全部正確配對印 yes，否則 no。", "tags": ["stack"], "checker": "tokens", "tests": [{"in": "<a> </a>\n", "out": "yes\n"}, {"in": "<b> </b> <a> </b>\n", "out": "no\n"}], "hidden": [{"in": "<a> <b> </b> <b>\n", "out": "no\n"}, {"in": "<b> </a>\n", "out": "no\n"}, {"in": "<b> <a> <a> </a>\n", "out": "no\n"}, {"in": "<a> <a>\n", "out": "no\n"}, {"in": "<b> <b> <a> </a>\n", "out": "no\n"}, {"in": "</b> <a> <a> <a>\n", "out": "no\n"}], "ref": {"python": "def main():\n    st = []\n    for t in input().split():\n        if t.startswith(\"</\"):\n            if not st or st.pop() != t[2:-1]:\n                print(\"no\"); return\n        else: st.append(t[1:-1])\n    print(\"yes\" if not st else \"no\")\n"}}
{"id": "b-dedupe-sorted", "title": "去重並排序", "level": "L6", "statement": "第一行 n，第二行 n 個整數。輸出去重後由小到大排序的結果（以空格分隔）。", "tags": ["array", "hash"], "checker": "tokens", "tests": [{"in": "4\n0 -4 -4 -3\n", "out": "-4 -3 0\n"}, {"in": "6\n5 -1 0 -1 -1 -4\n", "out": "-4 -1 0 5\n"}], "hidden": [{"in": "7\n2 -2 0 0 4 0 4\n", "out": "-2 0 2 4\n"}, {"in": "5\n1 -2 -5 -5 1\n", "out": "-5 -2 1\n"}, {"in": "7\n1 1 2 -4 -2 3 4\n", "out": "-4 -2 1 2 3 4\n"}, {"in": "4\n-2 3 0 2\n", "out": "-2 0 2 3\n"}, {"in": "10\n1 5 0 -1 -2 -4 -3 0 0 1\n", "out": "-4 -3 -2 -1 0 1 5\n"}, {"in": "1\n4\n", "out": "4\n"}], "ref": {"python": "def main():\n    input(); print(*sorted(set(map(int, input().split()))))\n"}}
