ryError 時傾印堆積到檔案"},{flag:"-XX:+UseG1GC",arg:"",desc:"使用 G1 垃圾回收器"},{flag:"-XX:+UseZGC",arg:"",desc:"使用 ZGC 低延遲垃圾回收器"}],subs:{},lists:{}},python:{name:"python",aliases:["python3","python2","python.exe","py","python3.8","python3.9","python3.10","python3.11","python3.12","python3.13"],summary:"Python 直譯器：執行腳本、模組或互動模式",synopsis:"python [選項] [-c 指令",options:[{flag:"-c",arg:"程式碼",desc:"執行一段字串形式的程式碼"},{flag:"-m",arg:"模組",desc:"以模組方式執行（例如 -m venv、-m pip、-m http.server、-m unittest、-m pytest、-m json.tool）"},{flag:"-i",arg:"",desc:"執行完腳本後進入互動模式"},{flag:"-u",arg:"",desc:"不緩衝標準輸出與錯誤（日誌即時輸出，管線與容器常用）"},{flag:"-O",arg:"",desc:"最佳化：移除 assert 與 __debug__ 程式碼"},{flag:"-OO",arg:"",desc:"再移除 docstring"},{flag:"-B",arg:"",desc:"不寫 .pyc 位元組碼檔"},{flag:"-E",arg:"",desc:"忽略 PYTHON* 環境變數"},{flag:"-I",arg:"",desc:"隔離模式：忽略環境變數與使用者站台目錄"},{flag:"-s",arg:"",desc:"不加入使用者站台目錄"},{flag:"-S",arg:"",desc:"不匯入 site 模組"},{flag:"-W",arg:"動作",desc:"控制警告（例如 -W error 把警告當錯誤、-W ignore）"},{flag:"-X",arg:"選項",desc:"實作特定選項（例如 -X utf8、-X dev、-X importtime、-X faulthandler）"},{flag:"-q",arg:"",desc:"互動模式不印版本與版權"},{flag:"-v",arg:"",desc:"詳細輸出（顯示每次匯入）"},{flag:"-V",arg:"",desc:"印出版本後結束"},{flag:"--version",arg:"",desc:"印出版本後結束"},{flag:"-h",arg:"",desc:"顯示說明"},{flag:"-b",arg:"",desc:"對 bytes 與 str 混用發出警告"},{flag:"-d",arg:"",desc:"除錯解析器"},{flag:"-x",arg:"",desc:"跳過第一行（非 Unix 的 #! 用）"},{flag:"-P",arg:"",desc:"不把腳本所在目錄或目前目錄放進 sys.path（3.11+）"},{flag:"-R",arg:"",desc:"啟用雜湊隨機化"}],subs:{},lists:{}},node:{name:"node",aliases:["nodejs","node.exe"],summary:"Node.js：用 V8 引擎在伺服端執行 JavaScript",synopsis:"node [選項] [腳本.js",options:[{flag:"-e",arg:"程式碼",desc:"執行一段字串形式的 JavaScript"},{flag:"--eval",arg:"程式碼",desc:"同 -e"},{flag:"-p",arg:"程式碼",desc:"執行並印出結果"},{flag:"--print",arg:"程式碼",desc:"同 -p"},{flag:"-r",arg:"模組",desc:"啟動前預先載入模組（例如 -r ts-node/register、-r dotenv/config）"},{flag:"--require",arg:"模組",desc:"同 -r"},{flag:"--import",arg:"模組",desc:"預先載入 ES 模組"},{flag:"-i",arg:"",desc:"互動模式（REPL）"},{flag:"--inspect",arg:"",desc:"開啟除錯器（預設 127.0