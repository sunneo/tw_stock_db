ript",desc:"TAP 啟動時執行的腳本（no 表示不執行）"},{key:"downscript",desc:"TAP 關閉時執行的腳本"},{key:"br",desc:"橋接器名稱"},{key:"helper",desc:"橋接輔助程式路徑"},{key:"vhost",desc:"on 表示用 vhost 核心加速"},{key:"listen",desc:"socket 後端監聽位址"},{key:"connect",desc:"socket 後端連線位址"},{key:"mcast",desc:"多點傳送位址"},{key:"model",desc:"網卡型號（-nic 用）：virtio-net-pci、e1000、rtl8139、smc91c111（arm 舊板）"},{key:"mac",desc:"MAC 位址"}],chardev:[{key:"@type:stdio",desc:"主機的標準輸入輸出"},{key:"@type:file",desc:"輸出到檔案（path=）"},{key:"@type:pipe",desc:"具名管線"},{key:"@type:socket",desc:"TCP 或 Unix socket（host=、port=、path=、server=on、wait=off）"},{key:"@type:udp",desc:"UDP"},{key:"@type:pty",desc:"建立偽終端機並印出路徑"},{key:"@type:serial",desc:"主機的實體序列埠"},{key:"@type:null",desc:"丟棄"},{key:"@type:vc",desc:"虛擬主控台（圖形視窗內）"},{key:"@type:msmouse",desc:"微軟滑鼠協定"},{key:"@type:mux",desc:"多工：多個前端共享一個後端"},{key:"id",desc:"字元裝置 ID"},{key:"path",desc:"檔案或 socket 路徑"},{key:"host",desc:"socket 主機"},{key:"port",desc:"socket 埠"},{key:"server",desc:"on 表示在本機監聽等人連入"},{key:"wait",desc:"off 或 nowait 表示不等待對方連入就繼續開機"},{key:"nowait",desc:"不等待對方連入"},{key:"telnet",desc:"以 telnet 協定"},{key:"mux",desc:"on 表示可多工"},{key:"logfile",desc:"同時記錄到檔案"},{key:"signal",desc:"是否把 Ctrl+C 當訊號"}],machine:[{key:"type",desc:"機型名稱"},{key:"accel",desc:"加速器：kvm、tcg、hvf、whpx（可用 : 組合）"},{key:"kernel_irqchip",desc:"是否使用核心中斷控制器（on／off／split）"},{key:"gic-version",desc:"ARM GIC 版本：2、3、4、host、max"},{key:"secure",desc:"on 表示模擬 TrustZone 安全世界（ARM virt）"},{key:"virtualization",desc:"on 表示模擬 EL2 虛擬化擴充（ARM virt，客體要跑虛擬機時用）"},{key:"highmem",desc:"off 表示不使用 4GB 以上的位址（ARM virt）"},{key:"iommu",desc:"使用 IOMMU：smmuv3 等"},{key:"dumpdtb",desc:"把裝置樹輸出到檔案"},{key:"mte",desc:"on 表示啟用記憶體標籤擴充（ARM）"},{key:"usb",desc:"啟用 USB 控制器"},{key:"vmport",desc:"VMware 後門連接埠"},{key:"dump-guest-core",desc:"傾印時是否包含客體記憶體"},{key:"mem-merge",desc:"記憶體頁面合併"},{key:"suppress-vmdesc",desc:"不傳送虛擬機描述"}],serial:[{key:"stdio",desc:"主機標準輸入輸出（序列埠印在目前終端機）"},{key:"mon:stdio",desc:"序列埠與 QEMU 監控器共用標準輸入輸出；Ctrl+A 然後 C 切換，Ctrl+A 然後 X 結束"},{key:"null",desc:"丟棄輸出"},{key:"pty",desc:"建立偽終端機，QEMU 啟動時印出 /dev/pts/N"},{key:"vc",desc:"圖形視窗內的虛擬主控台"},{key:"none",desc:"不接任何東西"},{key:"file:*",desc:"輸出到檔案"},{key:"tcp:*",desc:"透過 TCP（如 tcp::4444,server,nowait 表示在 4444 埠等人連入，不阻塞開機）"},{key:"telnet:*",desc:"透過 telnet 協定"},{key:"unix:*",desc:"Unix socket"},{key:"chardev:*",desc:"使用先前定義的 chardev ID"},{key:"server",desc:"在本機監聽"},{key:"nowait",desc:"不等待連入"},{key:"wait",desc:"等待連入才開機"},{key:"telnet",desc:"使用 telnet 協定"}],append:[{key:"console=*",desc:"核心主控台設備與參數：ttyS0（x86 序列埠）、ttyAMA0（ARM PL011）、tty0（螢幕）；可附鮑率如 ttyS0,115200"},{key:"root=*",desc:"根檔案系統所在裝置：/dev/vda（virtio 磁碟）、/dev/sda、/dev/mmcblk0p2、PARTUUID=、/dev/nfs"},{key:"rootfstype=*",desc:"根檔案系統型態（ext4、squashfs、9p …）"},{key:"rootwait",desc:"等待根裝置出現才掛載（USB／SD 開機常需要）"},{key:"rootflags=*",desc:"掛載根檔案系統的選項"},{key:"rw",desc:"以讀寫掛載根檔案系統"},{key:"ro",desc:"以唯讀掛載根檔案系統"},{key:"init=*",desc:"指定第一個使用者行程（預設 /sbin/init）；除錯常用 init=/bin/sh"},{key:"earlycon",desc:"啟用早期主控台（在正式主控台出現前就能看到核心訊息）"},{key:"earlycon=*",desc:"指定早期主控台（如 earlycon=pl011,0x9000000 ）"},{key:"earlyprintk=*",desc:"x86 早期輸出（serial,ttyS0,115200）"},{key:"nokaslr",desc:"關閉核心位址隨機化（用 gdb 除錯核心時需要）"},{key:"loglevel=*",desc:"核心訊息等級 0 到 7（7 為 debug）"},{key:"quiet",desc:"隱藏大部分開機訊息"},{key:"debug",desc:"顯示除錯訊息"},{key:"panic=*",desc:"核心 panic 後 N 秒自動重開機（0 表示不重開）"},{key:"maxcpus=*",desc:"最多啟用的 CPU 數"},{key:"mem=*",desc:"限制使用的記憶體大小"},{key:"ip=*",desc:"核心啟動時設定網路（ip=dhcp 或 ip=客戶端:伺服器:閘道:遮罩）"},{key:"nfsroot=*",desc:"以 NFS 當根檔案系統"},{key:"cma=*",desc:"連續記憶體配置器大小"},{key:"isolcpus=*",desc:"隔離給特定用途的 CPU"},{key:"systemd.unit=*",desc:"指定 systemd 開機目標（如 rescue.target）"},{key:"single",desc:"單人模式開機"},{key:"selinux=*",desc:"SELinux 開關"},{key:"apparmor=*",desc:"AppArmor 開關"},{key:"net.ifnames=*",desc:"網卡命名規則（0 表示沿用 eth0 這種舊名稱）"},{key:"elevator=*",desc:"指定 I/O 排程器"},{key:"hugepages=*",desc:"預留巨頁數量"},{key:"mitigations=*",desc:"CPU 漏洞緩解（off 關閉換取效能）"}],display:[{key:"none",desc:"不顯示畫面"},{key:"gtk",desc:"GTK 視窗"},{key:"sdl",desc:"SDL 視窗"},{key:"curses",desc:"文字模式"},{key:"vnc=*",desc:"VNC 伺服器（例如 vnc=:0 對應 5900 埠）"},{key:"egl-headless",desc:"無頭 EGL 繪圖"}],smp:[{key:"cpus",desc:"啟動時的 CPU 數量"},{key:"maxcpus",desc:"最大可熱插拔 CPU 數"},{key:"sockets",desc:"處理器插座數"},{key:"cores",desc:"每個插座的核心數"},{key:"threads",desc:"每個核心的執行緒數"}]},lists:{machines:[{name:"virt",desc:"通用 64 位元虛擬機型：使用 GICv2/v3、PCIe、virtio-mmio，裝置樹由 QEMU 產生；跑 aarch64 Linux 首選（可用 -machine virt,gic-version=3,virtualization=on,secure=on 調整）"},{name:"raspi3b",desc:"樹莓派 3B（Cortex-A53）"},{name:"raspi3ap",desc:"樹莓派 3A+（Cortex-A53）"},{name:"raspi4b",desc:"樹莓派 4B（Cortex-A72）"},{name:"sbsa-ref",desc:"伺服器基礎系統架構參考平台：用 UEFI 開機，貼近伺服器 ARM"},{name:"xlnx-versal-virt",desc:"Xilinx Versal 虛擬平台"},{name:"xlnx-zcu102",desc:"Xilinx ZynqMP ZCU102 開發板"},{name:"imx8mp-evk",desc:"NXP i.MX 8M Plus 評估板"},{name:"nuri",desc:"Samsung NURI"},{name:"orangepi-pc",desc:"Orange Pi PC"},{name:"vexpress-a9",desc:"ARM Versatile Express A9（32 位元客體）"},{name:"fby35-bmc",desc:"Facebook FBY35 BMC"},{name:"none",desc:"沒有預設硬體"}],cpus:[{name:"cortex-a35",desc:"ARM Cortex-A35（ARMv8 省電小核）"},{name:"cortex-a53",desc:"ARM Cortex-A53（ARMv8 小核，最常用於教學）"},{name:"cortex-a55",desc:"ARM Cortex-A55（ARMv8.2）"},{name:"cortex-a57",desc:"ARM Cortex-A57（ARMv8 大核）"},{name:"cortex-a72",desc:"ARM Cortex-A72（ARMv8 大核，樹莓派 4）"},{name:"cortex-a76",desc:"ARM Cortex-A76（ARMv8.2）"},{name:"neoverse-n1",desc:"ARM Neoverse N1（伺服器）"},{name:"neoverse-v1",desc:"ARM Neoverse V1（伺服器，含 SVE）"},{name:"a64fx",desc:"富士通 A64FX（含 SVE，512 位元）"},{name:"max",desc:"最大功能 CPU：開啟 QEMU 支援的全部 ARMv8/v9 功能（含 SVE、MTE、PAuth）；用 TCG 時最方便"},{name:"host",desc:"與主機相同的 CPU（需要 KVM／HVF）"},{name:"cortex-a15",desc:"ARM Cortex-A15（32 位元）"},{name:"cortex-a7",desc:"ARM Cortex-A7（32 位元）"}]},inherit:"qemu-system-arm"},"qemu-system-x86_64":{name:"qemu-system-x86_64",aliases:["qemu-system-x64","qemu-system-amd64","qemu-system-x86","qemu-system-i386","qemu-system-x86_64.exe","qemu-system-i386.exe","qemu-kvm"],summary:"QEMU 的 x86／x86-64 全系統模擬器：模擬一台 PC（BIOS/UEFI 開機、PCI 匯流排、VGA、磁碟、網卡）",synopsis:"qemu-system-x86_64 [選項] [磁碟映像]",options:[{flag:"-boot",arg:"設定",desc:"開機順序：-boot order=dc（先光碟 d 再硬碟 c）、once=d（只這次先從光碟開機）、menu=on 顯示開機選單"},{flag:"-cdrom",arg:"檔案",desc:"光碟映像（ISO），常用來安裝作業系統"},{flag:"-enable-kvm",arg:"",desc:"使用 KVM 硬體加速（Linux 主機，客體與主機都是 x86 才有意義）"},{flag:"-spice",arg:"設定",desc:"用 SPICE 遠端桌面輸出"},{flag:"-smbios",arg:"設定",desc:"設定 SMBIOS（DMI）資訊"},{flag:"-no-acpi",arg:"",desc:"停用 ACPI"},{flag:"-no-hpet",arg:"",desc:"停用高精度事件計時器"},{flag:"-no-fd-bootchk",arg:"",desc:"不檢查軟碟開機簽章"},{flag:"-vga",arg:"類型",desc:"虛擬顯示卡：std（預設）、virtio、qxl、cirrus、vmware、none"},{flag:"-machine",arg:"機型[,屬性]",desc:"機型，例如 q35,accel=kvm；accel=、kernel_irqchip=、usb=、vmport= 等屬性"},{flag:"-kernel",arg:"檔案",desc:"直接載入 Linux bzImage 並用 -append 傳核心命令列（略過 BIOS 開機載入器）"},{flag:"-bios",arg:"檔案",desc:"指定 BIOS／UEFI 韌體（例如 OVMF.fd、seabios）"},{flag:"-soundhw",arg:"裝置",desc:"舊式音效卡（例如 hda、ac97）"},{flag:"-usb",arg:"",desc:"啟用 USB"},{flag:"-usbdevice",arg:"裝置",desc:"舊式 USB 裝置，如 tablet（絕對座標滑鼠，避免滑鼠游標偏移）"},{flag:"-M",arg:"機型",desc:"指定要模擬的機型（板子），例如 virt（虛擬化用的通用板）、versatilepb、vexpress-a9、raspi2b、mps2-an385、lm3s6965evb；-M help 列出全部"},{flag:"-cpu",arg:"CPU",desc:"指定 CPU 型號（例如 cortex-a15、cortex-m3、max）；-cpu help 列出"},{flag:"-smp",arg:"數量",desc:"模擬的核心數與拓撲（例如 -smp 4 或 cpus=4,sockets=1,cores=4）"},{flag:"-m",arg:"大小",desc:"客體記憶體大小，單位預設 MB（例如 -m 512 或 -m 2G）"},{flag:"-mem-path",arg:"路徑",desc:"用檔案（例如 hugetlbfs）當客體記憶體後端"},{flag:"-accel",arg:"加速器",desc:"加速器：kvm（硬體虛擬化）、tcg（純軟體翻譯，預設）、hvf、whpx"},{flag:"-initrd",arg:"檔案",desc:"載入初始 RAM 磁碟（initramfs）"},{flag:"-append",arg:"命令列",desc:'核心命令列（例如 "console=ttyAMA0 root=/dev/vda rw"）'},{flag:"-dtb",arg:"檔案",desc:"使用指定的裝置樹（Device Tree Blob）；沒有指定時 QEMU 會自己為 virt 等機型產生"},{flag:"-dumpdtb",arg:"檔案",desc:"把機型產生的裝置樹寫到檔案後結束（搭配 -machine 屬性）"},{flag:"-pflash",arg:"檔案",desc:"把檔案當 parallel flash 載入（UEFI 韌體常用）"},{flag:"-drive",arg:"參數",desc:"定義一個儲存裝置：file=、if=、format=、media= 等"},{flag:"-hda",arg:"檔案",desc:"第一個 IDE 硬碟映像"},{flag:"-hdb",arg:"檔案",desc:"第二個 IDE 硬碟映像"},{flag:"-sd",arg:"檔案",desc:"SD 卡映像"},{flag:"-mtdblock",arg:"檔案",desc:"板載 flash 映像"},{flag:"-fda",arg:"檔案",desc:"軟碟映像"},{flag:"-device",arg:"裝置[,屬性]",desc:"加入一個裝置（可重複）：例如 virtio-blk-device,drive=hd0；-device help 列出所有裝置"},{flag:"-netdev",arg:"後端",desc:"定義網路後端：user、tap、bridge、socket；常搭配 -device 的 netdev="},{flag:"-nic",arg:"設定",desc:"一次建立網卡與後端的簡寫（例如 -nic user,model=virtio-net-pci,hostfwd=tcp::2222-:22）"},{flag:"-net",arg:"設定",desc:"舊式網路選項（-net nic -net user）"},{flag:"-serial",arg:"字元裝置",desc:"把客體序列埠導向主機端：stdio、mon:stdio（序列埠與監控共用標準輸入輸出）、null、pty、file:檔名、tcp::埠,server,nowait、telnet:、unix:"},{flag:"-monitor",arg:"字元裝置",desc:"把 QEMU 監控器（命令介面）導向某處：stdio、none、telnet:…、unix:…"},{flag:"-qmp",arg:"字元裝置",desc:"開 QMP（機器可讀的 JSON 控制介面）"},{flag:"-mon",arg:"設定",desc:"詳細設定監控器：chardev=,mode=readline|control"},{flag:"-chardev",arg:"後端",desc:"定義字元裝置後端，之後用 -serial chardev:ID、-device virtconsole,chardev=ID 引用"},{flag:"-display",arg:"類型",desc:"顯示輸出類型：none、gtk、sdl、vnc=:0、curses"},{flag:"-nographic",arg:"",desc:"不開圖形視窗：預設把序列埠與監控接到終端機（等於 -display none -serial mon:stdio）；跑嵌入式 Linux 最常用，結束用 Ctrl+A 然後 X"},{flag:"-vnc",arg:"位址",desc:"用 VNC 輸出畫面（例如 -vnc :1 為連接埠 5901）"},{flag:"-sdl",arg:"",desc:"使用 SDL 視窗"},{flag:"-curses",arg:"",desc:"用文字模式顯示（curses）"},{flag:"-audiodev",arg:"後端",desc:"音訊後端"},{flag:"-object",arg:"物件",desc:"建立 QEMU 物件（記憶體後端 memory-backend-file、rng-random、secret、iothread 等）"},{flag:"-fsdev",arg:"後端",desc:"檔案系統分享後端（9p）"},{flag:"-virtfs",arg:"設定",desc:"用 9p 分享主機資料夾給客體：-virtfs local,path=/src,mount_tag=host0,security_model=none"},{flag:"-s",arg:"",desc:"在 TCP 1234 開 gdb 伺服器（等於 -gdb tcp::1234）"},{flag:"-S",arg:"",desc:"啟動時 CPU 先暫停，等 gdb 或監控器下 continue 才開始跑"},{flag:"-gdb",arg:"設備",desc:"開 gdb 伺服器於指定位址，例如 -gdb tcp::3333"},{flag:"-d",arg:"項目",desc:"開啟偵錯記錄：in_asm（翻譯的客體指令）、cpu、int（中斷）、exec、guest_errors、unimp（未實作週邊）、mmu；以逗號分隔"},{flag:"-D",arg:"檔案",desc:"把 -d 的偵錯記錄寫到檔案"},{flag:"-trace",arg:"事件",desc:"開啟追蹤事件"},{flag:"-semihosting",arg:"",desc:"啟用半主機（讓客體透過特殊指令使用主機的檔案、主控台；裸機程式常用）"},{flag:"-semihosting-config",arg:"設定",desc:"半主機詳細設定：enable=on,target=native,chardev=ID,arg=…"},{flag:"-snapshot",arg:"",desc:"唯讀使用磁碟映像：所有寫入丟到暫存，結束後消失"},{flag:"-loadvm",arg:"名稱",desc:"啟動時載入虛擬機快照"},{flag:"-incoming",arg:"位址",desc:"等待遷移的進入連線"},{flag:"-no-reboot",arg:"",desc:"客體要重新開機時改成結束 QEMU（除錯開機失敗時常用）"},{flag:"-no-shutdown",arg:"",desc:"客體關機後不結束 QEMU"},{flag:"-rtc",arg:"設定",desc:"設定即時時鐘：base=utc|localtime、clock=host|vm"},{flag:"-icount",arg:"設定",desc:"啟用指令計數時間（確定性模擬）：-icount shift=auto"},{flag:"-name",arg:"名稱",desc:"設定客體名稱"},{flag:"-uuid",arg:"UUID",desc:"設定客體 UUID"},{flag:"-global",arg:"設定",desc:"設定驅動屬性預設值"},{flag:"-readconfig",arg:"檔案",desc:"從設定檔讀取"},{flag:"-writeconfig",arg:"檔案",desc:"把目前設定寫到檔案"},{flag:"-L",arg:"目錄",desc:"指定 BIOS 與 ROM 檔搜尋目錄"},{flag:"-daemonize",arg:"",desc:"啟動後轉入背景"},{flag:"-pidfile",arg:"檔案",desc:"寫入 PID"},{flag:"-sandbox",arg:"設定",desc:"啟用 seccomp 沙盒"},{flag:"-numa",arg:"設定",desc:"設定 NUMA 節點"},{flag:"-fw_cfg",arg:"設定",desc:"透過 fw_cfg 傳資料給韌體"},{flag:"-watchdog",arg:"型號",desc:"模擬看門狗"},{flag:"-watchdog-action",arg:"動作",desc:"看門狗觸發時的動作（reset、shutdown、poweroff、pause、debug、none）"},{flag:"-overcommit",arg:"設定",desc:"記憶體與 CPU 超額配置設定"},{flag:"-parallel",arg:"字元裝置",desc:"並列埠導向"},{flag:"-echr",arg:"字元",desc:"設定終端機跳脫字元（預設 Ctrl+A）"},{flag:"-k",arg:"鍵盤配置",desc:"設定鍵盤配置"},{flag:"-version",arg:"",desc:"顯示版本"},{flag:"-h",arg:"",desc:"顯示說明"},{flag:"-help",arg:"",desc:"顯示說明"},{flag:"-cpu help",arg:"",desc:"列出支援的 CPU"}],subs:{drive:[{key:"file",desc:"磁碟映像檔路徑（raw、qcow2 等）"},{key:"if",desc:"介面類型：virtio（半虛擬化，效能好）、ide、scsi、sd（SD 卡）、mtd、pflash、none（只定義，之後用 -device 的 drive=ID 引用）"},{key:"format",desc:"映像格式：raw（原始）、qcow2（支援快照與稀疏）、vmdk、vdi"},{key:"media",desc:"媒體類型：disk 或 cdrom"},{key:"index",desc:"在介面上的索引編號"},{key:"id",desc:"裝置 ID，供 -device 的 drive= 引用"},{key:"cache",desc:"快取模式：none、writeback、writethrough、directsync、unsafe"},{key:"aio",desc:"非同步 I/O 模式：threads、native、io_uring"},{key:"snapshot",desc:"on 表示寫入暫存、結束後丟棄"},{key:"readonly",desc:"on 表示唯讀"},{key:"unit",desc:"在匯流排上的單元編號"},{key:"bus",desc:"匯流排編號"},{key:"werror",desc:"寫入錯誤時的處理：report、stop、ignore、enospc"},{key:"rerror",desc:"讀取錯誤時的處理"},{key:"discard",desc:"是否傳遞 discard／trim：on／off、unmap"},{key:"detect-zeroes",desc:"偵測寫入全零並以稀疏方式處理"}],device:[{key:"@type:virtio-blk-device",desc:"virtio 區塊裝置（MMIO 版，用於 virt、microvm 等無 PCI 的機型）"},{key:"@type:virtio-blk-pci",desc:"virtio 區塊裝置（PCI 版）"},{key:"@type:virtio-net-device",desc:"virtio 網卡（MMIO 版）"},{key:"@type:virtio-net-pci",desc:"virtio 網卡（PCI 版，效能最好）"},{key:"@type:virtio-scsi-pci",desc:"virtio SCSI 控制器"},{key:"@type:virtio-serial-pci",desc:"virtio 序列埠（供 virtconsole、qemu-guest-agent 使用）"},{key:"@type:virtio-gpu-pci",desc:"virtio 顯示卡（PCI）"},{key:"@type:virtio-gpu-device",desc:"virtio 顯示卡（MMIO）"},{key:"@type:virtio-rng-pci",desc:"virtio 亂數產生器"},{key:"@type:virtio-rng-device",desc:"virtio 亂數產生器（MMIO）"},{key:"@type:virtio-balloon-pci",desc:"virtio 記憶體氣球"},{key:"@type:virtio-9p-pci",desc:"virtio 9p 檔案系統分享"},{key:"@type:virtio-keyboard-pci",desc:"virtio 鍵盤"},{key:"@type:virtio-mouse-pci",desc:"virtio 滑鼠"},{key:"@type:vhost-user-fs-pci",desc:"vhost-user 檔案系統（virtiofs）"},{key:"@type:e1000",desc:"Intel 82540EM 網卡（相容性好）"},{key:"@type:e1000e",desc:"Intel 82574L 網卡"},{key:"@type:rtl8139",desc:"Realtek 8139 網卡"},{key:"@type:pcnet",desc:"AMD PCnet 網卡"},{key:"@type:ne2k_pci",desc:"NE2000 PCI 網卡"},{key:"@type:VGA",desc:"標準 VGA 顯示卡"},{key:"@type:cirrus-vga",desc:"Cirrus Logic 顯示卡"},{key:"@type:qxl-vga",desc:"QXL（SPICE）顯示卡"},{key:"@type:ramfb",desc:"簡單的記憶體幀緩衝（ARM virt 用來給韌體顯示）"},{key:"@type:usb-ehci",desc:"USB 2.0 控制器"},{key:"@type:qemu-xhci",desc:"USB 3.0 控制器"},{key:"@type:nec-usb-xhci",desc:"NEC USB 3.0 控制器"},{key:"@type:usb-kbd",desc:"USB 鍵盤"},{key:"@type:usb-mouse",desc:"USB 滑鼠"},{key:"@type:usb-tablet",desc:"USB 平板（絕對座標指標，滑鼠整合最順）"},{key:"@type:usb-storage",desc:"USB 儲存裝置"},{key:"@type:usb-host",desc:"直通主機的 USB 裝置"},{key:"@type:ahci",desc:"AHCI SATA 控制器"},{key:"@type:ich9-ahci",desc:"ICH9 AHCI SATA 控制器（q35 內建）"},{key:"@type:ide-hd",desc:"IDE 硬碟"},{key:"@type:ide-cd",desc:"IDE 光碟機"},{key:"@type:scsi-hd",desc:"SCSI 硬碟"