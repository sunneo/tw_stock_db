utive memory."},{name:"ldrb",format:"LDRB Rt, [Rn, #imm]",description:"Loads an unsigned byte from memory."},{name:"strb",format:"STRB Rt, [Rn, #imm]",description:"Stores a byte to memory."},{name:"ldrh",format:"LDRH Rt, [Rn, #imm]",description:"Loads an unsigned halfword from memory."},{name:"strh",format:"STRH Rt, [Rn, #imm]",description:"Stores a halfword to memory."},{name:"ldrd",format:"LDRD Rt, Rt2, [Rn, #imm]",description:"Loads a register pair (64 bits) from memory."},{name:"strd",format:"STRD Rt, Rt2, [Rn, #imm]",description:"Stores a register pair (64 bits) to memory."},{name:"push",format:"PUSH {reglist}",description:"Pushes registers onto the stack (alias for STMDB sp!)."},{name:"pop",format:"POP {reglist}",description:"Pops registers off the stack (alias for LDMIA sp!)."},{name:"ldrsb",format:"LDRSB Rt, [Rn]",description:"Loads a byte and sign-extends it."},{name:"ldrsh",format:"LDRSH Rt, [Rn]",description:"Loads a halfword and sign-extends it."},{name:"ldrex",format:"LDREX Rt, [Rn]",description:"Load-exclusive - first half of an atomic RMW sequence."},{name:"strex",format:"STREX Rd, Rt, [Rn]",description:"Store-exclusive - second half of an atomic RMW sequence."},{name:"swp",format:"SWP Rt, Rt2, [Rn]",description:"Atomically swaps a register with memory (deprecated, pre-LDREX/STREX)."}],control_flow:[{name:"b",format:"B target",description:"Unconditional branch."},{name:"bl",format:"BL target",description:"Branch with link - saves return address in LR (function call)."},{name:"bx",format:"BX Rm",description:"Branch and exchange instruction set (ARM/Thumb) to address in Rm."},{name:"blx",format:"BLX target/Rm",description:"Branch with link and exchange instruction set."},{name:"cbz",format:"CBZ Rn, target",description:"Compare and branch if Rn is zero (Thumb-only)."},{name:"cbnz",format:"CBNZ Rn, target",description:"Compare and branch if Rn is nonzero (Thumb-only)."},{name:"beq",format:"BEQ target",description:"Branch if equal (Z=1)."},{name:"bne",format:"BNE target",description:"Branch if not equal (Z=0)."},{name:"bgt",format:"BGT target",description:"Branch if greater than (signed)."},{name:"blt",format:"BLT target",description:"Branch if less than (signed)."},{name:"bge",format:"BGE target",description:"Branch if greater or equal (signed)."},{name:"ble",format:"BLE target",description:"Branch if less or equal (signed)."},{name:"bls",format:"BLS target",description:"Branch if lower or same (unsigned <=)."},{name:"bhi",format:"BHI target",description:"Branch if higher (unsigned >)."},{name:"bpl",format:"BPL target",description:"Branch if plus (N=0)."},{name:"bmi",format:"BMI target",description:"Branch if minus/negative (N=1)."},{name:"bvs",format:"BVS target",description:"Branch if overflow set."},{name:"bvc",format:"BVC target",description:"Branch if no overflow."},{name:"bcs",format:"BCS target",description:"Branch if carry set (alias BHS, unsigned >=)."},{name:"bcc",format:"BCC target",description:"Branch if carry clear (alias BLO, unsigned <)."}],simd_vector:[{name:"vadd.i32",format:"VADD.I32 Dd, Dn, Dm",description:"NEON: add packed 32-bit integers."},{name:"vsub.i32",format:"VSUB.I32 Dd, Dn, Dm",description:"NEON: subtract packed 32-bit integers."},{name:"vmul.f32",format:"VMUL.F32 Dd, Dn, Dm",description:"NEON: multiply packed single-precision floats."},{name:"vld1.32",format:"VLD1.32 {Dd}, [Rn]",description:"NEON: load packed 32-bit elements from memory."},{name:"vst1.32",format:"VST1.32 {Dd}, [Rn]",description:"NEON: store packed 32-bit elements to memory."},{name:"vmov",format:"VMOV Dd, Dm",description:"NEON/VFP: move between vector/float registers (or GP<->float)."},{name:"vdup.32",format:"VDUP.32 Qd, Dm[x]",description:"NEON: duplicate one lane across all lanes of a vector register."},{name:"vmla.f32",format:"VMLA.F32 Dd, Dn, Dm",description:"NEON: multiply-accumulate packed single-precision floats."},{name:"vand",format:"VAND Dd, Dn, Dm",description:"NEON: bitwise AND of two vector registers."},{name:"veor",format:"VEOR Dd, Dn, Dm",description:"NEON: bitwise XOR of two vector registers."},{name:"vceq",format:"VCEQ Dd, Dn, Dm",description:"NEON: per-lane compare-equal, result is all-1s/all-0s mask."},{name:"vmax",format:"VMAX Dd, Dn, Dm",description:"NEON: per-lane maximum."}],arithmetic_logic:[{name:"add",format:"ADD Rd, Rn, Op2",description:"Rd = Rn + Op2."},{name:"adc",format:"ADC Rd, Rn, Op2",description:"Rd = Rn + Op2 + carry."},{name:"sub",format:"SUB Rd, Rn, Op2",description:"Rd = Rn - Op2."},{name:"sbc",format:"SBC Rd, Rn, Op2",description:"Rd = Rn - Op2 - NOT(carry)."},{name:"rsb",format:"RSB Rd, Rn, Op2",description:"Rd = Op2 - Rn (reverse subtract)."},{name:"mul",format:"MUL Rd, Rm, Rs",description:"Rd = Rm * Rs (low 32 bits)."},{name:"mla",format:"MLA Rd, Rm, Rs, Rn",description:"Rd = (Rm * Rs) + Rn (multiply-accumulate)."},{name:"umull",format:"UMULL RdLo, RdHi, Rm, Rs",description:"64-bit unsigned multiply: RdHi:RdLo = Rm * Rs."},{name:"smull",format:"SMULL RdLo, RdHi, Rm, Rs",description:"64-bit signed multiply: RdHi:RdLo = Rm * Rs."},{name:"and",format:"AND Rd, Rn, Op2",description:"Rd = Rn AND Op2 (bitwise)."},{name:"orr",format:"ORR Rd, Rn, Op2",description:"Rd = Rn OR Op2 (bitwise)."},{name:"eor",format:"EOR Rd, Rn, Op2",description:"Rd = Rn XOR Op2 (bitwise)."},{name:"bic",format:"BIC Rd, Rn, Op2",description:"Rd = Rn AND NOT(Op2) (bit clear)."},{name:"mvn",format:"MVN Rd, Op2",description:"Rd = NOT(Op2) (bitwise complement/move-negate)."},{name:"lsl",format:"LSL Rd, Rm, #imm",description:"Logical shift left."},{name:"lsr",format:"LSR Rd, Rm, #imm",description:"Logical shift right (zero-fill)."},{name:"asr",format:"ASR Rd, Rm, #imm",description:"Arithmetic shift right (sign-extending)."},{name:"ror",format:"ROR Rd, Rm, #imm",description:"Rotate right."},{name:"cmp",format:"CMP Rn, Op2",description:"Sets flags from Rn - Op2 (result discarded)."},{name:"cmn",format:"CMN Rn, Op2",description:"Sets flags from Rn + Op2 (result discarded)."},{name:"tst",format:"TST Rn, Op2",description:"Sets flags from Rn AND Op2 (result discarded)."},{name:"teq",format:"TEQ Rn, Op2",description:"Sets flags from Rn XOR Op2 (result discarded)."},{name:"clz",format:"CLZ Rd, Rm",description:"Counts leading zero bits in Rm."}]},aarch64:{process_exec:[{name:"svc",format:"SVC #imm",description:"Supervisor Call - AArch64's syscall trap to EL1 (Linux syscall entry)."},{name:"hvc",format:"HVC #imm",description:"Hypervisor Call - traps to EL2."},{name:"smc",format:"SMC #imm",description:"Secure Monitor Call - traps to EL3 (TrustZone)."}],low_level_hardware:[{name:"mrs",format:"MRS Xt, <system_reg>",description:"Reads a system register into a general-purpose register."},{name:"msr",format:"MSR <system_reg>, Xt",description:"Writes a general-purpose register into a system register."},{name:"wfi",format:"WFI",description:"Wait For Interrupt - suspends execution."},{name:"wfe",format:"WFE",description:"Wait For Event - suspends execution until an event."},{name:"sev",format:"SEV",description:"Send Event to all cores waiting via WFE."},{name:"sevl",format:"SEVL",description:"Send Event Local - sets the local event register."},{name:"dsb",format:"DSB <option>",description:"Data Synchronization Barrier."},{name:"dmb",format:"DMB <option>",description:"Data Memory Barrier."},{name:"isb",format:"ISB <option>",description:"Instruction Synchronization Barrier."},{name:"ic",format:"IC <op>, Xt",description:"Instruction Cache maintenance operation."},{name:"tlbi",format:"TLBI <op>, Xt",description:"TLB Invalidate operation."}],memory_management:[{name:"ldr",format:"LDR Xt, [Xn, #imm]",description:"Loads a register from memory."},{name:"str",format:"STR Xt, [Xn, #imm]",description:"Stores a register to memory."},{name:"ldp",format:"LDP Xt1, Xt2, [Xn, #imm]",description:"Loads a pair of registers from memory."},{name:"stp",format:"STP Xt1, Xt2, [Xn, #imm]",description:"Stores a pair of registers to memory."},{name:"ldrb",format:"LDRB Wt, [Xn, #imm]",description:"Loads an unsigned byte from memory."},{name:"strb",format:"STRB Wt, [Xn, #imm]",description:"Stores a byte to memory."},{name:"ldrh",format:"LDRH Wt, [Xn, #imm]",description:"Loads an unsigned halfword from memory."},{name:"strh",format:"STRH Wt, [Xn, #imm]",description:"Stores a halfword to memory."},{name:"ldur",format:"LDUR Xt, [Xn, #simm]",description:"Loads a register using an unscaled immediate offset."},{name:"stur",format:"STUR Xt, [Xn, #simm]",description:"Stores a register using an unscaled immediate offset."},{name:"ldxr",format:"LDXR Xt, [Xn]",description:"Load-exclusive - first half of an atomic RMW sequence."},{name:"stxr",format:"STXR Ws, Xt, [Xn]",description:"Store-exclusive - second half of an atomic RMW sequence."},{name:"ldar",format:"LDAR Xt, [Xn]",description:"Load-acquire - an atomic load with acquire ordering semantics."},{name:"stlr",format:"STLR Xt, [Xn]",description:"Store-release - an atomic store with release ordering semantics."},{name:"cas",format:"CAS Xs, Xt, [Xn]",description:"Compare-And-Swap (ARMv8.1 atomics) - single-instruction atomic RMW."},{name:"ldadd",format:"LDADD Xs, Xt, [Xn]",description:"Atomic add to memory, returns the old value (ARMv8.1 atomics)."}],control_flow:[{name:"b",format:"B target",description:"Unconditional branch."},{name:"bl",format:"BL target",description:"Branch with link (function call), saves return address in X30/LR."},{name:"br",format:"BR Xn",description:"Branch to address in register Xn."},{name:"blr",format:"BLR Xn",description:"Branch with link to address in register Xn."},{name:"ret",format:"RET {Xn}",description:"Return - branches to X30 (or Xn if given)."},{name:"cbz",format:"CBZ Xt, target",description:"Compare and branch if Xt is zero."},{name:"cbnz",format:"CBNZ Xt, target",description:"Compare and branch if Xt is nonzero."},{name:"beq",format:"B.EQ target",description:"Branch if equal (Z=1)."},{name:"bne",format:"B.NE target",description:"Branch if not equal (Z=0)."},{name:"t