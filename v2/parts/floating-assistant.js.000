3、4、host、max"},{key:"secure",desc:"on 表示模擬 TrustZone 安全世界（ARM virt）"},{key:"virtualization",desc:"on 表示模擬 EL2 虛擬化擴充（ARM virt，客體要跑虛擬機時用）"},{key:"highmem",desc:"off 表示不使用 4GB 以上的位址（ARM virt）"},{key:"iommu",desc:"使用 IOMMU：smmuv3 等"},{key:"dumpdtb",desc:"把裝置樹輸出到檔案"},{key:"mte",desc:"on 表示啟用記憶體標籤擴充（ARM）"},{key:"usb",desc:"啟用 USB 控制器"},{key:"vmport",desc:"VMware 後門連接埠"},{key:"dump-guest-core",desc:"傾印時是否包含客體記憶體"},{key:"mem-merge",desc:"記憶體頁面合併"},{key:"suppress-vmdesc",desc:"不傳送虛擬機描述"}],serial:[{key:"stdio",desc:"主機標準輸入輸出（序列埠印在目前終端機）"},{key:"mon:stdio",desc:"序列埠與 QEMU 監控器共用標準輸入輸出；Ctrl+A 然後 C 切換，Ctrl+A 然後 X 結束"},{key:"null",desc:"丟棄輸出"},{key:"pty",desc:"建立偽終端機，QEMU 啟動時印出 /dev/pts/N"},{key:"vc",desc:"圖形視窗內的虛擬主控台"},{key:"none",desc:"不接任何東西"},{key:"file:*",desc:"輸出到檔案"},{key:"tcp:*",desc:"透過 TCP（如 tcp::4444,server,nowait 表示在 4444 埠等人連入，不阻塞開機）"},{key:"telnet:*",desc:"透過 telnet 協定"},{key:"unix:*",desc:"Unix socket"},{key:"chardev:*",desc:"使用先前定義的 chardev ID"},{key:"server",desc:"在本機監聽"},{key:"nowait",desc:"不等待連入"},{key:"wait",desc:"等待連入才開機"},{key:"telnet",desc:"使用 telnet 協定"}],append:[{key:"console=*",desc:"核心主控台設備與參數：ttyS0（x86 序列埠）、ttyAMA0（ARM PL011）、tty0（螢幕）；可附鮑率如 ttyS0,115200"},{key:"root=*",desc:"根檔案系統所在裝置：/dev/vda（virtio 磁碟）、/dev/sda、/dev/mmcblk0p2、PARTUUID=、/dev/nfs"},{key:"rootfstype=*",desc:"根檔案系統型態（ext4、squashfs、9p …）"},{key:"rootwait",desc:"等待根裝置出現才掛載（USB／SD 開機常需要）"},{key:"rootflags=*",desc:"掛載根檔案系統的選項"},{key:"rw",desc:"以讀寫掛載根檔案系統"},{key:"ro",desc:"以唯讀掛載根檔案系統"},{key:"init=*",desc:"指定第一個使用者行程（預設 /sbin/init）；除錯常用 init=/bin/sh"},{key:"earlycon",desc:"啟用早期主控台（在正式主控台出現前就能看到核心訊息）"},{key:"earlycon=*",desc:"指定早期主控台（如 earlycon=pl011,0x9000000 ）"},{key:"earlyprintk=*",desc:"x86 早期輸出（serial,ttyS0,115200）"},{key:"nokaslr",desc:"關閉核心位址隨機化（用 gdb 除錯核心時需要）"},{key:"loglevel=*",desc:"核心訊息等級 0 到 7（7 為 debug）"},{key:"quiet",desc:"隱藏大部分開機訊息"},{key:"debug",desc:"顯示除錯訊息"},{key:"panic=*",desc:"核心 panic 後 N 秒自動重開機（0 表示不重開）"},{key:"maxcpus=*",desc:"最多啟用的 CPU 數"},{key:"mem=*",desc:"限制使用的記憶體大小"},{key:"ip=*",desc:"核心啟動時設定網路（ip=dhcp 或 ip=客戶端:伺服器:閘道:遮罩）"},{key:"nfsroot=*",desc:"以 NFS 當根檔案系統"},{key:"cma=*",desc:"連續記憶體配置器大小"},{key:"isolcpus=*",desc:"隔離給特定用途的 CPU"},{key:"systemd.unit=*",desc:"指定 systemd 開機目標（如 rescue.target）"},{key:"single",desc:"單人模式開機"},{key:"selinux=*",desc:"SELinux 開關"},{key:"apparmor=*",desc:"AppArmor 開關"},{key:"net.ifnames=*",desc:"網卡命名規則（0 表示沿用 eth0 這種舊名稱）"},{key:"elevator=*",desc:"指定 I/O 排程器"},{key:"hugepages=*",desc:"預留巨頁數量"},{key:"mitigations=*",desc:"CPU 漏洞緩解（off 關閉換取效能）"}],display:[{key:"none",desc:"不顯示畫面"},{key:"gtk",desc:"GTK 視窗"},{key:"sdl",desc:"SDL 視窗"},{key:"curses",desc:"文字模式"},{key:"vnc=*",desc:"VNC 伺服器（例如 vnc=:0 對應 5900 埠）"},{key:"egl-headless",desc:"無頭 EGL 繪圖"}],smp:[{key:"cpus",desc:"啟動時的 CPU 數量"},{key:"maxcpus",desc:"最大可熱插拔 CPU 數"},{key:"sockets",desc:"處理器插座數"},{key:"cores",desc:"每個插座的核心數"},{key:"threads",desc:"每個核心的執行緒數"}]},lists:{machines:[{name:"pc",desc:"標準 PC（i440FX＋PIIX 晶片組，預設）：相容性最好，ISA 與舊式 PCI 架構"},{name:"q35",desc:"較新 PC（Q35＋ICH9 晶片組）：PCIe 匯流排、AHCI，較適合現代客體與裝置直通"},{name:"microvm",desc:"極簡虛擬機：沒有 PCI、ACPI 與 ISA 舊裝置，用 virtio-mmio；開機極快，用於容器式輕量虛擬化"},{name:"isapc",desc:"純 ISA PC（老舊 486 時代）"},{name:"xenfv",desc:"Xen 全虛擬化 PC"},{name:"pc-i440fx-8.2",desc:"固定版本的 i440FX 機型（跨 QEMU 版本保持相容，用於遷移）"},{name:"pc-q35-8.2",desc:"固定版本的 Q35 機型"},{name:"none",desc:"沒有預設硬體"}],cpus:[{name:"qemu64",desc:"預設 64 位元通用 CPU：只有基本功能（SSE2），跨主機最相容"},{name:"qemu32",desc:"預設 32 位元通用 CPU"},{name:"max",desc:"開啟 QEMU 支援的所有 CPU 功能（TCG 時最方便；KVM 時等同 host 的可用功能）"},{name:"host",desc:"與主機 CPU 相同（需要 KVM、HVF 或 WHPX）"},{name:"base",desc:"最小功能 CPU，自己用旗標組裝"},{name:"kvm64",desc:"供 KVM 客體用的通用 64 位元 CPU"},{name:"Haswell",desc:"Intel Haswell（AVX2、FMA）"},{name:"Skylake-Client",desc:"Intel Skylake 用戶端（AVX2）"},{name:"Skylake-Server",desc:"Intel Skylake 伺服器（AVX-512）"},{name:"Cascadelake-Server",desc:"Intel Cascade Lake 伺服器"},{name:"Icelake-Server",desc:"Intel Ice Lake 伺服器"},{name:"SapphireRapids",desc:"Intel Sapphire Rapids"},{name:"Nehalem",desc:"Intel Nehalem（SSE4.2）"},{name:"SandyBridge",desc:"Intel Sandy Bridge（AVX）"},{name:"EPYC",desc:"AMD EPYC（Zen）"},{name:"EPYC-Rome",desc:"AMD EPYC Rome（Zen 2）"},{name:"Opteron_G5",desc:"AMD Opteron G5"},{name:"pentium3",desc:"Intel Pentium III（32 位元）"},{name:"pentium",desc:"Intel Pentium"},{name:"486",desc:"Intel 486"}]},inherit:"qemu-system-arm"},gcc:{name:"gcc",aliases:["cc","gcc-9","gcc-10","gcc-11","gcc-12","gcc-13","gcc-14","x86_64-linux-gnu-gcc","aarch64-linux-gnu-gcc","arm-linux-gnueabihf-gcc","arm-none-eabi-gcc","aarch64-none-elf-gcc","riscv64-linux-gnu-gcc","mingw32-gcc","x86_64-w64-mingw32-gcc"],summary:"GNU C 編譯器驅動程式：依序做前處理、編譯、組譯、連結；可用選項讓流程停在任一階段",synopsis:"gcc [選項] 檔案... [-o 輸出]",options:[{flag:"-c",arg:"",desc:"只編譯與組譯成目的檔（.o），不連結"},{flag:"-S",arg:"",desc:"只編譯成組合語言（.s），不組譯"},{flag:"-E",arg:"",desc:"只做前處理（展開 #include、巨集），結果輸出到標準輸出"},{flag:"-o",arg:"檔案",desc:"指定輸出檔名"},{flag:"-x",arg:"語言",desc:"指定輸入檔語言而不看副檔名（c、c++、assembler、assembler-with-cpp、none）"},{flag:"-O0",arg:"",desc:"不最佳化（預設）；編譯最快，除錯最方便"},{flag:"-O1",arg:"",desc:"基本最佳化"},{flag:"-O2",arg:"",desc:"常用的一般最佳化（不含以空間換時間的展開）；發行版預設選擇"},{flag:"-O3",arg:"",desc:"積極最佳化：更多內聯、迴圈展開與向量化；程式碼可能變大"},{flag:"-Os",arg:"",desc:"為縮小程式碼而最佳化（嵌入式常用）"},{flag:"-Oz",arg:"",desc:"比 -Os 更積極縮小（clang）"},{flag:"-Og",arg:"",desc:"為除錯體驗做的最佳化（除錯建置建議）"},{flag:"-Ofast",arg:"",desc:"-O3 加上不嚴格遵守標準的數學最佳化（-ffast-math）；浮點結果可能不同"},{flag:"-g",arg:"",desc:"產生除錯資訊（預設 DWARF），讓 gdb 能顯示原始碼與變數"},{flag:"-g0",arg:"",desc:"不產生除錯資訊"},{flag:"-g1",arg:"",desc:"最少的除錯資訊（只有回溯所需）"},{flag:"-g2",arg:"",desc:"一般除錯資訊（與 -g 相同）"},{flag:"-g3",arg:"",desc:"除錯資訊含巨集定義"},{flag:"-ggdb",arg:"",desc:"產生 gdb 最適用的除錯資訊格式"},{flag:"-gdwarf-*",arg:"",desc:"指定 DWARF 版本 {v}"},{flag:"-Wall",arg:"",desc:"開啟大多數有用的警告（並不是「全部」）"},{flag:"-Wextra",arg:"",desc:"開啟額外的警告（未使用參數、比較有號與無號等）"},{flag:"-Werror",arg:"",desc:"把警告當成錯誤，有警告就編譯失敗"},{flag:"-Werror=*",arg:"",desc:"只把指定警告 {v} 當成錯誤"},{flag:"-Wpedantic",arg:"",desc:"嚴格依標準給出警告"},{flag:"-pedantic",arg:"",desc:"嚴格依 ISO 標準，拒絕非標準擴充"},{flag:"-pedantic-errors",arg:"",desc:"違反標準的地方直接當成錯誤"},{flag:"-Wno-*",arg:"",desc:"關閉警告 {v}"},{flag:"-W*",arg:"",desc:"開啟警告 -W{v}（例如 -Wshadow、-Wconversion、-Wformat=2、-Wunused）"},{flag:"-w",arg:"",desc:"關閉所有警告"},{flag:"-std=*",arg:"",desc:"指定語言標準 {v}（c99、c11、c17、gnu11、c++11、c++17、c++20、gnu++17 …）"},{flag:"-ansi",arg:"",desc:"等於 -std=c90"},{flag:"-I*",arg:"",desc:"增加標頭檔搜尋路徑 {v}"},{flag:"-isystem",arg:"目錄",desc:"增加「系統」標頭檔搜尋路徑（警告會被抑制）"},{flag:"-iquote",arg:"目錄",desc:'只用於 #include "..." 的搜尋路徑'},{flag:"-idirafter",arg:"目錄",desc:"搜尋路徑最後才找的目錄"},{flag:"-include",arg:"檔案",desc:"在每個原始檔最前面強制 #include 該檔"},{flag:"-L*",arg:"",desc:"增加函式庫搜尋路徑 {v}（連結階段）"},{flag:"-l*",arg:"",desc:"連結函式庫 lib{v}.so 或 lib{v}.a（例如 -lm 數學、-lpthread 執行緒、-ldl 動態載入、-lrt 即時）"},{flag:"-D*",arg:"",desc:"定義前處理巨集 {v}（-DNAME 等於 -DNAME=1）"},{flag:"-U*",arg:"",desc:"取消定義前處理巨集 {v}"},{flag:"-shared",arg:"",desc:"產生共享函式庫（.so／.dll），通常要搭配 -fPIC"},{flag:"-static",arg:"",desc:"靜態連結：把函式庫打包進可執行檔，不依賴執行時的共享函式庫"},{flag:"-static-libgcc",arg:"",desc:"靜態連結 libgcc"},{flag:"-static-libstdc++",arg:"",desc:"靜態連結 C++ 標準函式庫"},{flag:"-pie",arg:"",desc:"產生位置獨立執行檔（配合 ASLR）"},{flag:"-no-pie",arg:"",desc:"不產生位置獨立執行檔"},{flag:"-rdynamic",arg:"",desc:"把所有符號匯出到動態符號表（讓 dlsym、backtrace_symbols 看得到）"},{flag:"-pthread",arg:"",desc:"啟用 POSIX 執行緒：編譯與連結都需要（等於 -D_REENTRANT -lpthread）"},{flag:"-fopenmp",arg:"",desc:"啟用 OpenMP：處理 #pragma omp 並連結 libgomp"},{flag:"-fopenacc",arg:"",desc:"啟用 OpenACC"},{flag:"-fPIC",arg:"",desc:"產生位置獨立程式碼（共享函式庫必要；大型 GOT 版本）"},{flag:"-fpic",arg:"",desc:"產生位置獨立程式碼（小型 GOT 版本）"},{flag:"-fPIE",arg:"",desc:"產生位置獨立的可執行檔程式碼"},{flag:"-fno-*",arg:"",desc:"關閉功能 -f{v}（例如 -fno-builtin、-fno-exceptions、-fno-rtti、-fno-omit-frame-pointer）"},{flag:"-fsanitize=*",arg:"",desc:"啟用執行期檢查工具：{v}（address 記憶體錯誤、undefined 未定義行為、thread 資料競爭、leak 洩漏）"},{flag:"-fstack-protector",arg:"",desc:"為有陣列的函式加堆疊保護（Canary）"},{flag:"-fstack-protector-strong",arg:"",desc:"更廣泛地加堆疊保護"},{flag:"-fstack-protector-all",arg:"",desc:"為所有函式加堆疊保護"},{flag:"-fvisibility=*",arg:"",desc:"預設符號可見度 {v}（hidden 讓共享函式庫預設不匯出）"},{flag:"-ffunction-sections",arg:"",desc:"每個函式放自己的段，讓連結器能搭配 --gc-sections 移除未使用的函式"},{flag:"-fdata-sections",arg:"",desc:"每個資料物件放自己的段"},{flag:"-flto",arg:"",desc:"連結時最佳化：跨檔案內聯與最佳化（編譯與連結都要加）"},{flag:"-fno-omit-frame-pointer",arg:"",desc:"保留框架指標，讓除錯與效能分析的回溯更準"},{flag:"-fomit-frame-pointer",arg:"",desc:"省略框架指標（-O1 以上預設）"},{flag:"-fno-strict-aliasing",arg:"",desc:"不假設嚴格別名規則（舊程式碼與核心常用）"},{flag:"-ffreestanding",arg:"",desc:"獨立環境：不假設有標準函式庫（核心、啟動碼、韌體）"},{flag:"-fno-builtin",arg:"",desc:"不把 memcpy、printf 等當成內建函式特別處理"},{flag:"-fcommon",arg:"",desc:"未初始化的全域變數放 common 區（GCC 10 起預設是 -fno-common）"},{flag:"-funroll-loops",arg:"",desc:"展開迴圈"},{flag:"-ffast-math",arg:"",desc:"放寬浮點規則以換取速度（不保證 IEEE 精確）"},{flag:"-fno-exceptions",arg:"",desc:"不支援 C++ 例外"},{flag:"-fno-rtti",arg:"",desc:"不產生 C++ 執行期型別資訊"},{flag:"-fprofile-generate",arg:"",desc:"產生剖析資料用的偵測程式碼（PGO 第一步）"},{flag:"-fprofile-use",arg:"",desc:"使用剖析資料最佳化（PGO 第二步）"},{flag:"-fverbose-asm",arg:"",desc:"組合語言輸出附上註解"},{flag:"-fdiagnostics-color=*",arg:"",desc:"診斷訊息上色：{v}"},{flag:"-fmax-errors=*",arg:"",desc:"最多報 {v} 個錯誤就停止"},{flag:"-m32",arg:"",desc:"產生 32 位元程式碼（x86）"},{flag:"-m64",arg:"",desc:"產生 64 位元程式碼（x86）"},{flag:"-mthumb",arg:"",desc:"產生 Thumb 指令集程式碼（ARM，較省空間）"},{flag:"-marm",arg:"",desc:"產生 ARM 指令集程式碼"},{flag:"-march=*",arg:"",desc:"指定目標指令集架構 {v}（例如 x86-64、native 為本機、armv7-a、armv8-a+crypto、rv64gc）"},{flag:"-mtune=*",arg:"",desc:"針對特定處理器調校排程 {v}（不改變可使用的指令）"},{flag:"-mcpu=*",arg:"",desc:"指定目標處理器 {v}（ARM：cortex-a53、cortex-m4 等；同時決定 -march 與 -mtune）"},{flag:"-mfpu=*",arg:"",desc:"指定 ARM 浮點單元 {v}（neon、vfpv4 …）"},{flag:"-mfloat-abi=*",arg:"",desc:"ARM 浮點呼叫慣例 {v}（soft 軟體浮點、softfp、hard 硬體浮點暫存器傳參）"},{flag:"-mabi=*",arg:"",desc:"指定 ABI {v}（RISC-V：lp64d、ilp32 等）"},{flag:"-msse4.2",arg:"",desc:"允許使用 SSE4.2 指令"},{flag:"-mavx",arg:"",desc:"允許使用 AVX 指令"},{flag:"-mavx2",arg:"",desc:"允許使用 AVX2 指令"},{flag:"-mfma",arg:"",desc:"允許使用 FMA（融合乘加）指令"},{flag:"-mno-*",arg:"",desc:"關閉機器相關功能 -m{v}"},{flag:"-m*",arg:"",desc:"機器相關選項 -m{v}（依目標架構而異）"},{flag:"-pipe",arg:"",desc:"用管線取代暫存檔在各階段傳遞資料"},{flag:"-v",arg:"",desc:"顯示詳細的編譯過程（呼叫了哪些子程式、搜尋路徑）"},{flag:"--version",arg:"",desc:"顯示版本"},{flag:"-dumpmachine",arg:"",desc:"印出目標機器三元組（例如 x86_64-linux-gnu、arm-none-eabi）"},{flag:"-dumpversion",arg:"",desc:"印出編譯器版本"},{flag:"-print-search-dirs",arg:"",desc:"印出編譯器搜尋路徑"},{flag:"-print-file-name=*",arg:"",desc:"印出函式庫 {v} 的完整路徑"},{flag:"-save-temps",arg:"",desc:"保留中間檔（.i、.s、.o）"},{flag:"-M",arg:"",desc:"輸出相依規則（Makefile 格式）並停在前處理"},{flag:"-MM",arg:"",desc:"同 -M 但略過系統標頭"},{flag:"-MD",arg:"",desc:"編譯同時輸出 .d 相依檔（含系統標頭）"},{flag:"-MMD",arg:"",desc:"編譯同時輸出 .d 相依檔（不含系統標頭）；Makefile 增量編譯常用"},{flag:"-MP",arg:"",desc:"為每個標頭加一條空目標，避免標頭被刪除時 make 報錯"},{flag:"-MF",arg:"檔案",desc:"指定相依檔輸出位置"},{flag:"-MT",arg:"目標",desc:"指定相依規則的目標名稱"},{flag:"-Wl,*",arg:"",desc:"把逗號分隔的選項 {v} 傳給連結器（例如 -Wl,--gc-sections、-Wl,-rpath,/path、-Wl,-Map=out.map）"},{flag:"-Wa,*",arg:"",desc:"把選項 {v} 傳給組譯器"},{flag:"-Wp,*",arg:"",desc:"把選項 {v} 傳給前處理器"},{flag:"-Xlinker",arg:"選項",desc:"把一個選項原樣傳給連結器"},{flag:"-Xassembler",arg:"選項",desc:"把一個選項原樣傳給組譯器"},{flag:"-T",arg:"腳本",desc:"使用指定的連結器腳本（嵌入式、核心常用）"},{flag:"-nostdlib",arg:"",desc:"不連結標準函式庫與啟動檔"},{flag:"-nostartfiles",arg:"",desc:"不連結標準啟動檔（crt0）"},{flag:"-nodefaultlibs",arg:"",desc:"不連結預設函式庫"},{flag:"-nostdinc",arg:"",desc:"不搜尋標準系統標頭目錄"},{flag:"-specs=*",arg:"",desc:"使用規格檔 {v}（例如 -specs=nosys.specs、nano.specs，嵌入式 newlib 常用）"},{flag:"--sysroot=*",arg:"",desc:"以 {v} 為根目錄搜尋標頭與函式庫（交叉編譯）"},{flag:"-B*",arg:"",desc:"增加編譯器子程式與資料檔的搜尋前綴 {v}"},{flag:"-pg",arg:"",desc:"產生 gprof 剖析用的程式碼"},{flag:"--coverage",arg:"",desc:"產生程式碼覆蓋率資訊（gcov），等於 -fprofile-arcs -ftest-coverage 並連結 gcov"},{flag:"-r",arg:"",desc:"產生可重定位的目的檔（部分連結）"},{flag:"-s",arg:"",desc:"連結後移除符號表（縮小檔案）"},{flag:"-z",arg:"關鍵字",desc:"傳給連結器的 -z 選項（例如 noexecstack、relro、now）"},{flag:"-Q",arg:"",desc:"顯示每個函式編譯時的統計"},{flag:"-H",arg:"",desc:"顯示每個被引入的標頭"},{flag:"-trigraphs",arg:"",desc:"支援三字元序列"},{flag:"-C",arg:"",desc:"前處理時保留註解"},{flag:"-P",arg:"",desc:"前處理時不產生 #line 標記"},{flag:"-undef",arg:"",desc:"不預先定義系統特定的巨集"},{flag:"-fno-common",arg:"",desc:"未初始化全域變數不放 common 區（重複定義會連結失敗）"}],subs:{},lists:{}},"g++":{name:"g++",aliases:["c++","g++-9","g++-10","g++-11","g++-12","g++-13","g++-14","x86_64-linux-gnu-g++","aarch64-linux-gnu-g++","arm-linux-gnueabihf-g++","arm-none-eabi-g++"],summary:"GNU C++ 編譯器驅動程式：用法與 gcc 相同，但預設以 C++ 編譯 .c 以外的來源，並自動連結 libstdc++",synopsis:"g++ [選項] 檔案... [-o 輸出]",options:[{flag:"-stdlib=*",arg:"",desc:"指定 C++ 標準函式庫 {v}（clang：libc++ 或 libstdc++）"},{flag:"-fexceptions",arg:"",desc:"啟用 C++ 例外（預設）"},{flag:"-frtti",arg:"",desc:"啟用執行期型別資訊（預設）"},{flag:"-fcoroutines",arg:"",desc:"啟用 C++20 協程"},{flag:"-fmodules-ts",arg:"",desc:"啟用 C++20 模組（實驗性）"},{flag:"-Weffc++",arg:"",desc:"警告違反 Effective C++ 準則的寫法"},{flag:"-Woverloaded-virtual",arg:"",desc:"警告隱藏了基底類別虛擬函式的多載"},{flag:"-fconcepts",arg:"",desc:"啟用 C++ concepts（舊版 GCC）"},{flag:"-D_GLIBCXX_DEBUG",arg:"",desc:"啟用 libstdc++ 偵錯模式（容器越界檢查；巨集，用 -D 定義）"},{flag:"-c",arg:"",desc:"只編譯與組譯成目的檔（.o），不連結"},{flag:"-S",arg:"",desc:"只編譯成組合語言（.s），不組譯"},{flag:"-E",arg:"",desc:"只做前處理（展開 #include、巨集），結果輸出到標準輸出"},{flag:"-o",arg:"檔案",desc:"指定輸出檔名"},{flag:"-x",arg:"語言",desc:"指定輸入檔語言而不看副檔名（c、c++、assembler、assembler-with-cpp、none）"},{flag:"-O0",arg:"",desc:"不最佳化（預設）；編譯最快，除錯最方便"},{flag:"-O1",arg:"",desc:"基本最佳化"},{flag:"-O2",arg:"",desc:"常用的一般最佳化（不含以空間換時間的展開）；發行版預設選擇"},{flag:"-O3",arg:"",desc:"積極最佳化：更多內聯、迴圈展開與向量化；程式碼可能變大"},{flag:"-Os",arg:"",desc:"為縮小程式碼而最佳化（嵌入式常用）"},{flag:"-Oz",arg:"",desc:"比 -Os 更積極縮小（clang）"},{flag:"-Og",arg:"",desc:"為除錯體驗做的最佳化（除錯建置建議）"},{flag:"-Ofast",arg:"",desc:"-O3 加上不嚴格遵守標準的數學最佳化（-ffast-math）；浮點結果可能不同"},{flag:"-g",arg:"",desc:"產生除錯資訊（預設 DWARF），讓 gdb 能顯示原始碼與變數"},{flag:"-g0",arg:"",desc:"不產生除錯資訊"},{flag:"-g1",arg:"",desc:"最少的除錯資訊（只有回溯所需）"},{flag:"-g2",arg:"",desc:"一般除錯資訊（與 -g 相同）"},{flag:"-g3",arg:"",desc:"除錯資訊含巨集定義"},{flag:"-ggdb",arg:"",desc:"產生 gdb 最適用的除錯資訊格式"},{flag:"-gdwarf-*",arg:"",desc:"指定 DWARF 版本 {v}"},{flag:"-Wall",arg:"",desc:"開啟大多數有用的警告（並不是「全部」）"},{flag:"-Wextra",arg:"",desc:"開啟額外的警告（未使用參數、比較有號與無號等）"},{flag:"-Werror",arg:"",desc:"把警告當成錯誤，有警告就編譯失敗"},{flag:"-Werror=*",arg:"",desc:"只把指定警告 {v} 當成錯誤"},{flag:"-Wpedantic",arg:"",desc:"嚴格依標準給出警告"},{flag:"-pedantic",arg:"",desc:"嚴格依 ISO 標準，拒絕非標準擴充"},{flag:"-pedantic-errors",arg:"",desc:"違反標準的地方直接當成錯誤"},{flag:"-Wno-*",arg:"",desc:"關閉警告 {v}"},{flag:"-W*",arg:"",desc:"開啟警告 -W{v}（例如 -Wshadow、-Wconversion、-Wformat=2、-Wunused）"},{flag:"-w",arg:"",desc:"關閉所有警告"},{flag:"-std=*",arg:"",desc:"指定語言標準 {v}（c99、c11、c17、gnu11、c++11、c++17、c++20、gnu++17 …）"},{flag:"-ansi",arg:"",desc:"等於 -std=c90"},{flag:"-I*",arg:"",desc:"增加標頭檔搜尋路徑 {v}"},{flag:"-isystem",arg:"目錄",desc:"增加「系統」標頭檔搜尋路徑（警告會被抑制）"},{flag:"-iquote",arg:"目錄",desc:'只用於 #include "..." 的搜尋路徑'},{flag:"-idirafter",arg:"目錄",desc:"搜尋路徑最後才找的目錄"},{flag:"-include",arg:"檔案",desc:"在每個原始檔最前面強制 #include 該檔"},{flag:"-L*",arg:"",desc:"增加函式庫搜尋路徑 {v}（連結階段）"},{flag:"-l*",arg:"",desc:"連結函式庫 lib{v}.so 或 lib{v}.a（例如 -lm 數學、-lpthread 執行緒、-ldl 動態載入、-lrt 即時）"},{flag:"-D*",arg:"",desc:"定義前處理巨集 {v}（-DNAME 等於 -DNAME=1）"},{flag:"-U*",arg:"",desc:"取消定義前處理巨集 {v}"},{flag:"-shared",arg:"",desc:"產生共享函式庫（.so／.dll），通常要搭配 -fPIC"},{flag:"-static",arg:"",desc:"靜態連結：把函式庫打包進可執行檔，不依賴執行時的共享函式庫"},{flag:"-static-libgcc",arg:"",desc:"靜態連結 libgcc"},{flag:"-static-libstdc++",arg:"",desc:"靜態連結 C++ 標準函式庫"},{flag:"-pie",arg:"",desc:"產生位置獨立執行檔（配合 ASLR）"},{flag:"-no-pie",arg:"",desc:"不產生位置獨立執行檔"},{flag:"-rdynamic",arg:"",desc:"把所有符號匯出到動態符號表（讓 dlsym、backtrace_symbols 看得到）"},{flag:"-pthread",arg:"",desc:"啟用 POSIX 執行緒：編譯與連結都需要（等於 -D_REENTRANT -lpthread）"},{flag:"-fopenmp",arg:"",desc:"啟用 OpenMP：處理 #pragma omp 並連結 libgomp"},{flag:"-fopenacc",arg:"",desc:"啟用 OpenACC"},{flag:"-fPIC",arg:"",desc:"產生位置獨立程式碼（共享函式庫必要；大型 GOT 版本）"},{flag:"-fpic",arg:"",desc:"產生位置獨立程式碼（小型 GOT 版本）"},{flag:"-fPIE",arg:"",desc:"產生位置獨立的可執行檔程式碼"},{flag:"-fno-*",arg:"",desc:"關閉功能 -f{v}（例如 -fno-builtin、-fno-exceptions、-fno-rtti、-fno-omit-frame-pointer）"},{flag:"-fsanitize=*",arg:"",desc:"啟用執行期檢查工具：{v}（address 記憶體錯誤、undefined 未定義行為、thread 資料競爭、leak 洩漏）"},{flag:"-fstack-protector",arg:"",desc:"為有陣列的函式加堆疊保護（Canary）"},{flag:"-fstack-protector-strong",arg:"",desc:"更廣泛地加堆疊保護"},{flag:"-fstack-protector-all",arg:"",desc:"為所有函式加堆疊保護"},{flag:"-fvisibility=*",arg:"",desc:"預設符號可見度 {v}（hidden 讓共享函式庫預設不匯出）"},{flag:"-ffunction-sections",arg:"",desc:"每個函式放自己的段，讓連結器能搭配 --gc-sections 移除未使用的函式"},{flag:"-fdata-sections",arg:"",desc:"每個資料物件放自己的段"},{flag:"-flto",arg:"",desc:"連結時最佳化：跨檔案內聯與最佳化（編譯與連結都要加）"},{flag:"-fno-omit-frame-pointer",arg:"",desc:"保留框架指標，讓除錯與效能分析的回溯更準"},{flag:"-fomit-frame-pointer",arg:"",desc:"省略框架指標（-O1 以上預設）"},{flag:"-fno-strict-aliasing",arg:"",desc:"不假設嚴格別名規則（舊程式碼與核心常用）"},{flag:"-ffreestanding",arg:"",desc:"獨立環境：不假設有標準函式庫（核心、啟動碼、韌體）"},{flag:"-fno-builtin",arg:"",desc:"不把 memcpy、printf 等當成內建函式特別處理"},{flag:"-fcommon",arg:"",desc:"未初始化的全域變數放 common 區（GCC 10 起預設是 -fno-common）"},{flag:"-funroll-loops",arg:"",desc:"展開迴圈"},{flag:"-ffast-math",arg:"",desc:"放寬浮點規則以換取速度（不保證 IEEE 精確）"},{flag:"-fno-exceptions",arg:"",desc:"不支援 C++ 例外"},{flag:"-fno-rtti",arg:"",desc:"不產生 C++ 執行期型別資訊"},{flag:"-fprofile-generate",arg:"",desc:"產生剖析資料用的偵測程式碼（PGO 第一步）"},{flag:"-fprofile-use",arg:"",desc:"使用剖析資料最佳化（PGO 第二步）"},{flag:"-fverbose-asm",arg:"",desc:"組合語言輸出附上註解"},{flag:"-fdiagnostics-color=*",arg:"",desc:"診斷訊息上色：{v}"},{flag:"-fmax-errors=*",arg:"",desc:"最多報 {v} 個錯誤就停止"},{flag:"-m32",arg:"",desc:"產生 32 位元程式碼（x86）"},{flag:"-m64",arg:"",desc:"產生 64 位元程式碼（x86）"},{flag:"-mthumb",arg:"",desc:"產生 Thumb 指令集程式碼（ARM，較省空間）"},{flag:"-marm",arg:"",desc:"產生 ARM 指令集程式碼"},{flag:"-march=*",arg:"",desc:"指定目標指令集架構 {v}（例如 x86-64、native 為本機、armv7-a、armv8-a+crypto、rv64gc）"},{flag:"-mtune=*",arg:"",desc:"針對特定處理器調校排程 {v}（不改變可使用的指令）"},{flag:"-mcpu=*",arg:"",desc:"指定目標處理器 {v}（ARM：cortex-a53、cortex-m4 等；同時決定 -march 與 -mtune）"},{flag:"-mfpu=*",arg:"",desc:"指定 ARM 浮點單元 {v}（neon、vfpv4 …）"},{flag:"-mfloat-abi=*",arg:"",desc:"ARM 浮點呼叫慣例 {v}（soft 軟體浮點、softfp、hard 硬體浮點暫存器傳參）"},{flag:"-mabi=*",arg:"",desc:"指定 ABI {v}（RISC-V：lp64d、ilp32 等）"},{flag:"-msse4.2",arg:"",desc:"允許使用 SSE4.2 指令"},{flag:"-mavx",arg:"",desc:"允許使用 AVX 指令"},{flag:"-mavx2",arg:"",desc:"允許使用 AVX2 指令"},{flag:"-mfma",arg:"",desc:"允許使用 FMA（融合乘加）指令"},{flag:"-mno-*",arg:"",desc:"關閉機器相關功能 -m{v}"},{flag:"-m*",arg:"",desc:"機器相關選項 -m{v}（依目標架構而異）"},{flag:"-pipe",arg:"",desc:"用管線取代暫存檔在各階段傳遞資料"},{flag:"-v",arg:"",desc:"顯示詳細的編譯過程（呼叫了哪些子程式、搜尋路徑）"},{flag:"--version",arg:"",desc:"顯示版本"},{flag:"-dumpmachine",arg:"",desc:"印出目標機器三元組（例如 x86_64-linux-gnu、arm-none-eabi）"},{flag:"-dumpversion",arg:"",desc:"印出編譯器版本"},{flag:"-print-search-dirs",arg:"",desc:"印出編譯器搜尋路徑"},{flag:"-print-file-name=*",arg:"",desc:"印出函式庫 {v} 的完整路徑"},{flag:"-save-temps",arg:"",desc:"保留中間檔（.i、.s、.o）"},{flag:"-M",arg:"",desc:"輸出相依規則（Makefile 格式）並停在前處理"},{flag:"-MM",arg:"",desc:"同 -M 但略過系統標頭"},{flag:"-MD",arg:"",desc:"編譯同時輸出 .d 相依檔（含系統標頭）"},{flag:"-MMD",arg:"",desc:"編譯同時輸出 .d 相依檔（不含系統標頭）；Makefile 增量編譯常用"},{flag:"-MP",arg:"",desc:"為每個標頭加一條空目標，避免標頭被刪除時 make 報錯"},{flag:"-MF",arg:"檔案",desc:"指定相依檔輸出位置"},{flag:"-MT",arg:"目標",desc:"指定相依規則的目標名稱"},{flag:"-Wl,*",arg:"",desc:"把逗號分隔的選項 {v} 傳給連結器（例如 -Wl,--gc-sections、-Wl,-rpath,/path、-Wl,-Map=out.map）"},{flag:"-Wa,*",arg:"",desc:"把選項 {v} 傳給組譯器"},{flag:"-Wp,*",arg:"",desc:"把選項 {v} 傳給前處理器"},{flag:"-Xlinker",arg:"選項",desc:"把一個選項原樣傳給連結器"},{flag:"-Xassembler",arg:"選項",desc:"把一個選項原樣傳給組譯器"},{flag:"-T",arg:"腳本",desc:"使用指定的連結器腳本（嵌入式、核心常用）"},{flag:"-nostdlib",arg:"",desc:"不連結標準函式庫與啟動檔"},{flag:"-nostartfiles",arg:"",desc:"不連結標準啟動檔（crt0）"},{flag:"-nodefaultlibs",arg:"",desc:"不連結預設函式庫"},{flag:"-nostdinc",arg:"",desc:"不搜尋標準系統標頭目錄"},{flag:"-specs=*",arg:"",desc:"使用規格檔 {v}（例如 -specs=nosys.specs、nano.specs，嵌入式 newlib 常用）"},{flag:"--sysroot=*",arg:"",desc:"以 {v} 為根目錄搜尋標頭與函式庫（交叉編譯）"},{flag:"-B*",arg:"",desc:"增加編譯器子程式與資料檔的搜尋前綴 {v}"},{flag:"-pg",arg:"",desc:"產生 gprof 剖析用的程式碼"},{flag:"--coverage",arg:"",desc:"產生程式碼覆蓋率資訊（gcov），等於 -fprofile-arcs -ftest-coverage 並連結 gcov"},{flag:"-r",arg:"",desc:"產生可重定位的目的檔（部分連結）"},{flag:"-s",arg:"",desc:"連結後移除符號表（縮小檔案）"},{flag:"-z",arg:"關鍵字",desc:"傳給連結器的 -z 選項（例如 noexecstack、relro、now）"},{flag:"-Q",arg:"",desc:"顯示每個函式編譯時的統計"},{flag:"-H",arg:"",desc:"顯示每個被引入的標頭"},{flag:"-trigraphs",arg:"",desc:"支援三字元序列"},{flag:"-C",arg:"",desc:"前處理時保留註解"},{flag:"-P",arg:"",desc:"前處理時不產生 #line 標記"},{flag:"-undef",arg:"",desc:"不預先定義系統特定的巨集"},{flag:"-fno-common",arg:"",desc:"未初始化全域變數不放 common 區（重複定義會連結失敗）"}],subs:{},lists:{},inherit:"gcc"},javac:{name:"javac",aliases:["javac.exe"],summary:"Java 編譯器：把 .java 原始碼編譯成 .class 位元組碼",synopsis:"javac [選項] 原始檔...",options:[{flag:"-d",arg:"目錄",desc:"指定 .class 輸出目錄（會依套件建立子資料夾）"},{flag:"-cp",arg:"路徑",desc:"類別搜尋路徑（資料夾與 jar，分隔字元 Linux 用 : ，Windows 用 ;）"},{flag:"-classpath",arg:"路徑",desc:"同 -cp"},{flag:"--class-path",arg:"路徑",desc:"同 -cp"},{flag:"-sourcepath",arg:"路徑",desc:"原始碼搜尋路徑"},{flag:"--source-path",arg:"路徑",desc:"同 -sourcepath"},{flag:"-encoding",arg:"編碼",desc:"原始檔編碼（例如 UTF-8）；編碼不對會出現亂碼或「unmappable character」"},{flag:"-source",arg:"版本",desc:"原始碼相容的語言版本"},{flag:"-target",arg:"版本",desc:"產生適用該 JVM 版本的位元組碼"},{flag:"--release",arg:"版本",desc:"同時指定 source、target 並使用對應版本的標準函式庫 API（建議取代 -source/-target）"},{flag:"-g",arg:"",desc:"產生全部除錯資訊"},{flag:"-g:*",arg:"",desc:"指定除錯資訊 {v}（none、lines、vars、source）"},{flag:"-nowarn",arg:"",desc:"關閉警告"},{flag:"-Xlint",arg:"",desc:"啟用所有建議的警告"},{flag:"-Xlint:*",arg:"",desc:"啟用特定警告 {v}（unchecked、deprecation、rawtypes …）"},{flag:"-Werror",arg:"",desc:"警告當錯誤"},{flag:"-deprecation",arg:"",desc:"顯示已棄用 API 的細節"},{flag:"-verbose",arg:"",desc:"顯示編譯器正在做什麼"},{flag:"-processor",arg:"類別",desc:"指定註解處理器"},{flag:"-processorpath",arg:"路徑",desc:"註解處理器的搜尋路徑"},{flag:"-proc:*",arg:"",desc:"註解處理方式 {v}（none 不處理、only 只處理）"},{flag:"-parameters",arg:"",desc:"在 .class 保留方法參數名稱（反射、Spring 等用）"},{flag:"-p",arg:"路徑",desc:"模組路徑（Java 9+）"},{flag:"--module-path",arg:"路徑",desc:"模組路徑"},{flag:"--add-modules",arg:"模組",desc:"額外加入的模組"},{flag:"--add-exports",arg:"設定",desc:"把模組內的套件匯出給其他模組"},{flag:"--enable-preview",arg:"",desc:"啟用預覽語言功能"},{flag:"-version",arg:"",desc:"顯示版本"},{flag:"-J*",arg:"",desc:"把選項 {v} 傳給底層 JVM（例如 -J-Xmx2g）"},{flag:"-h",arg:"目錄",