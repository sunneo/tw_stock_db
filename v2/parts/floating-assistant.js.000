出快取變數與說明"},{flag:"--fresh",arg:"",desc:"重新設定（忽略舊快取）"},{flag:"--preset",arg:"預設",desc:"使用 CMakePresets"},{flag:"-E",arg:"命令",desc:"內建跨平台命令（copy、rm、make_directory、tar、sleep）"},{flag:"-N",arg:"",desc:"只檢視模式"},{flag:"--trace",arg:"",desc:"追蹤 CMake 腳本執行"},{flag:"-Wno-dev",arg:"",desc:"不顯示開發者警告"},{flag:"-v",arg:"",desc:"詳細輸出"}],subs:{},lists:{}},ninja:{name:"ninja",aliases:[],summary:"專注速度的建置工具（常搭配 CMake、Meson）",synopsis:"ninja [選項] [目標...]",options:[{flag:"-C",arg:"資料夾",desc:"先切換資料夾"},{flag:"-j",arg:"數量",desc:"平行工作數"},{flag:"-n",arg:"",desc:"試跑"},{flag:"-v",arg:"",desc:"顯示完整命令"},{flag:"-k",arg:"數量",desc:"容許失敗次數後才停止"},{flag:"-t",arg:"工具",desc:"子工具（clean、targets、commands、graph、compdb）"},{flag:"-f",arg:"檔案",desc:"指定建置檔"},{flag:"-d",arg:"模式",desc:"除錯模式（explain 解釋為何重建）"}],subs:{},lists:{}},git:{name:"git",aliases:[],summary:"分散式版本控制",synopsis:"git [選項] 命令 [引數...]",options:[{flag:"status",arg:"",desc:"顯示工作區與暫存區狀態"},{flag:"add",arg:"",desc:"加入暫存區"},{flag:"commit",arg:"",desc:"建立提交（-m 訊息、-a 自動暫存已追蹤檔案、--amend 修改上一個提交）"},{flag:"push",arg:"",desc:"推送到遠端（-u 設定上游、--force 強制覆蓋遠端，危險）"},{flag:"pull",arg:"",desc:"抓取並合併（--rebase 以 rebase 取代 merge）"},{flag:"fetch",arg:"",desc:"只抓取遠端更新，不合併"},{flag:"clone",arg:"",desc:"複製遠端儲存庫（--depth 1 淺層、--branch 指定分支、--recursive 含子模組）"},{flag:"checkout",arg:"",desc:"切換分支或還原檔案"},{flag:"switch",arg:"",desc:"切換分支"},{flag:"restore",arg:"",desc:"還原工作區或暫存區檔案"},{flag:"branch",arg:"",desc:"列出、建立、刪除分支"},{flag:"merge",arg:"",desc:"合併分支"},{flag:"rebase",arg:"",desc:"把提交重新接到另一個基底上（-i 互動式整理）"},{flag:"log",arg:"",desc:"看提交歷史（--oneline、--graph、-p 顯示差異、-n 數量）"},{flag:"diff",arg:"",desc:"顯示差異（--staged 暫存區、--stat 摘要）"},{flag:"stash",arg:"",desc:"暫存目前修改（stash pop 取回）"},{flag:"reset",arg:"",desc:"移動分支指標（--soft 保留暫存、--mixed 預設、--hard 丟棄工作區修改，危險）"},{flag:"revert",arg:"",desc:"建立一個反向的提交"},{flag:"cherry-pick",arg:"",desc:"挑選特定提交套用"},{flag:"tag",arg:"",desc:"標籤"},{flag:"remote",arg:"",desc:"管理遠端"},{flag:"blame",arg:"",desc:"逐行顯示最後修改者"},{flag:"bisect",arg:"",desc:"二分搜尋找出引入問題的提交"},