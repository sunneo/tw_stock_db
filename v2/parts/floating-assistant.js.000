張圖變成油畫／水彩／素描／卡通…」會加一個風格濾鏡，並請視覺模型看過、不像就加強；說「用 AI 重畫成…」則用生圖模型（線上或本機，同 /image）依這張圖的內容重新畫一張。「修復畫筆」可以在畫面上塗出要修的地方。可以貼圖、給網址、或說「找一張…的圖」。":'I am a concept painter led by language, with GIMP-like after-work: say what to draw, where, or how to fix it, and I add a new layer (pictures, shapes, filters and repairs are all layers); the original is untouched and you can hide, adjust or undo any time. The plane has no boundary: add anywhere; drag and zoom the view, ⌖ goes back to the middle of the first layer (the picture). "Make it an oil painting / watercolor / sketch / cartoon…" adds a style filter and asks the vision model whether it looks like it, a stronger one if not; "repaint it as…" paints a new picture of what is in it with the image model (online or local, as in /image). The "repair brush" paints the places to fix. Paste a picture, give an address, or say "find a picture of …".',"AI 畫的":"Painted by the AI","圖片・":"Picture · ","圖片":"Picture","PNG 圖片":"PNG picture","JPEG 圖片":"JPEG picture","專案（JSON）":"Project (JSON)","合成中…":"Compositing…","補畫修復標記":"Add repair marks","修復":"Repair","用畫筆標出要修復的地方":"Mark the places to repair with the brush","移動 ":"Move ","🩹 修復畫筆":"🩹 Repair brush","畫筆大小（畫面上的單位）":"Brush size (units on the plane)","在畫面上塗出要修復的地方（會變成一個修復圖層）":"Paint the places to repair (it becomes a repair layer)","套用風格…":"Apply a style…","套用風格「":'Applied the style "',"改 ":"Change ","畫布（裁切與輸出的範圍框，不是邊界）":"Canvas (the frame that is cropped and exported, not a boundary)","畫布 ":"Canvas ","背景 ":"Background ","畫布貼合內容":"Canvas fitted to the content","對整張圖：":"For the whole picture: ","自動對比":"Auto contrast","去雜訊":"Denoise","去污點":"Remove specks","銳化":"Sharpen","混合":"Blend","水平翻轉":"Flip horizontally","垂直翻轉":"Flip vertically","出處：":"Source: ","提示詞：":"Prompt: ","對這張圖：":"For this picture: ","🩹 修復這張圖的中央":"🩹 Repair the middle of this picture","修復 ":"Repair ","強度":"Strength","整張圖":"The whole picture","作用在":"Acts on"," 作用在 ":" acts on ","刪掉 ":"Deleted "," 拿掉 ":" removed ","亮度":"Brightness","對比":"Contrast","飽和度":"Saturation","模糊":"Blur","黑白":"Black and white","油畫":"Oil painting","水彩":"Watercolor","素描":"Sketch","卡通":"Cartoon","降噪":"Denoise","數值":"Value","＋ 加一個處理":"+ Add a process"," 加 ":" add ","方法":"Method","補洞（從周圍填入）":"Fill the hole (from around it)","半徑":"Radius","標記 ":"Marks "," 處（用「🩹 修復畫筆」可以再塗）":' places (use the "🩹 repair brush" to paint more)',"清除標記":"Clear the marks","所有圖層與它們的設定（唯讀）。圖片的像素另外存在這個瀏覽器裡，這裡只有代號。":"All layers and their settings (read only). The pixels of the pictures are kept apart in this browser; only a reference is here."};e.FaEditPictureI18n=!0,n&&n.STYLES&&Object.keys(n.STYLES).forEach(function(e){var t=n.STYLES[e];t.label&&!r[t.label]&&(r[t.label]=String(t.en||e).replace(/^(an?|the) /,""))}),r["⬇ 下載 JPEG 圖片"]="⬇ Download JPEG picture",r["💬 放進對話 JPEG 圖片"]="💬 Put the JPEG picture into the conversation",t.extend(r,[[/^套用風格「(.+)」$/,'Applied the style "$1"'],[/^修復 (.*)$/,"Repair $1"],[/^標記 (\d+) 處.*$/,'$1 marks (use the "🩹 repair brush" to paint more)'],[/^移動 (.*)$/,"Move $1"],[/^畫布 (.+)$/,"Canvas $1"],[/^修復（(.+)）$/,"Repair ($1)"],[/^(.+?)；(.+)$/,"$1; $2"],[/^(.+?)\u3000— (.+)$/,"$1 — $2"]])}}(void 0!==t?t:this,void 0!==t&&t.FaEditI18n||(void 0!==FaEditI18n?FaEditI18n:void 0),void 0!==t&&t.FaPicFx||(void 0!==FaPicFx?FaPicFx:void 0))}.call(null,void 0,e),e.FaEditPictureI18n}(),FaEdit3d=function(){const e={};return function(e,t){var n,r;n=void 0!==t?t:this,r=function(){"use strict";var e=Math.PI,t={objects:400,name:60,title:80,coord:1e4,skins:24,extra:3e6},n={box:"方塊",sphere:"球",cylinder:"圓柱",cone:"圓錐",plane:"平面",torus:"圓環",polygon:"自訂形狀",particles:"粒子",line:"線"},r=["set_title","set_background","set_camera","add_object","update_object","remove_object","rename_object","move_object","set_visible","set_locked","duplicate_object","clear_objects","place_object","transform_object","group_objects","ungroup","set_parent","set_material","add_skin","update_skin","remove_skin","clear_skins","set_skins","drop_to_ground","align_objects"],a=["find_picture","gene