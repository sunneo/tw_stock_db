multiply unsigned word modulo."},{name:"lvx",format:"LVX Vt, Ra, Rb",description:"AltiVec: loads a 128-bit vector register from memory."},{name:"stvx",format:"STVX Vs, Ra, Rb",description:"AltiVec: stores a 128-bit vector register to memory."},{name:"vperm",format:"VPERM Vd, Va, Vb, Vc",description:"AltiVec: byte-wise permute of two vectors using a control vector."},{name:"vxor",format:"VXOR Vd, Va, Vb",description:"AltiVec: bitwise XOR of two vector registers."}],arithmetic_logic:[{name:"add",format:"ADD rd, ra, rb",description:"rd = ra + rb."},{name:"addi",format:"ADDI rd, ra, imm",description:"rd = ra + imm (also the LI idiom when ra=r0)."},{name:"subf",format:"SUBF rd, ra, rb",description:"rd = rb - ra (note reversed operand order)."},{name:"mullw",format:"MULLW rd, ra, rb",description:"rd = low 32 bits of ra * rb."},{name:"divw",format:"DIVW rd, ra, rb",description:"Signed 32-bit division."},{name:"and",format:"AND rd, ra, rb",description:"rd = ra AND rb."},{name:"or",format:"OR rd, ra, rb",description:"rd = ra OR rb (also the MR register-copy idiom: or rd,ra,ra)."},{name:"xor",format:"XOR rd, ra, rb",description:"rd = ra XOR rb."},{name:"nand",format:"NAND rd, ra, rb",description:"rd = NOT(ra AND rb)."},{name:"slw",format:"SLW rd, ra, rb",description:"Shift left word."},{name:"srw",format:"SRW rd, ra, rb",description:"Shift right word (logical)."},{name:"sraw",format:"SRAW rd, ra, rb",description:"Shift right word arithmetic."},{name:"cmpw",format:"CMPW ra, rb",description:"Compares two words, sets a condition register field."}]},mips:{process_exec:[{name:"syscall",format:"SYSCALL",description:"System Call - traps to the kernel."},{name:"break",format:"BREAK",description:"Breakpoint trap (debugger exception)."}],low_level_hardware:[{name:"mtc0",format:"MTC0 Rt, Rd",description:"Moves a GP register to a Coprocessor 0 (system control) register."},{name:"mfc0",format:"MFC0 Rt, Rd",description:"Moves a Coprocessor 0 register to a GP register."},{name:"mtc1",format:"MTC1 Rt, Fs",description:"Moves a GP register to an FPU (Coprocessor 1) register."},{name:"mfc1",format:"MFC1 Rt, Fs",description:"Moves an FPU register to a GP register."},{name:"eret",format:"ERET",description:"Exception return - restores state and resumes from an exception handler."},{name:"sync",format:"SYNC",description:"Memory ordering barrier."},{name:"cache",format:"CACHE op, offset(base)",description:"Performs a cache maintenance operation."}],memory_management:[{name:"lw",format:"LW Rt, offset(Rs)",description:"Load Word from memory."},{name:"sw",format:"SW Rt, offset(Rs)",description:"Store Word to memory."},{name:"lb",format:"LB Rt, offset(Rs)",description:"Load Byte (sign-extended) from memory."},{name:"sb",format:"SB Rt, offset(Rs)",description:"Store Byte to memory."},{name:"lh",format:"LH Rt, offset(Rs)",description:"Load Halfword (sign-extended) from memory."},{name:"sh",format:"SH Rt, offset(Rs)",description:"Store Halfword to memory."},{name:"lui",format:"LUI Rt, imm",description:"Load Upper Immediate - sets the high 16 bits of a register."},{name:"la",format:"LA Rt, label",description:"Load Address pseudo-instruction (assembles to LUI+ORI/ADDIU)."},{name:"ld",format:"LD Rt, offset(Rs)",description:"Load Doubleword (64-bit, MIPS64)."},{name:"sd",format:"SD Rt, offset(Rs)",description:"Store Doubleword (64-bit, MIPS64)."},{name:"lwu",format:"LWU Rt, offset(Rs)",description:"Load Word Unsigned (zero-extended, MIPS64)."}],control_flow:[{name:"j",format:"J target",description:"Unconditional jump."},{name:"jal",format:"JAL target",description:"Jump and link (function call), saves return address in $ra."},{name:"jr",format:"JR Rs",description:"Jump to the address in register Rs."},{name:"jalr",format:"JALR Rd, Rs",description:"Jump and link register (indirect call)."},{name:"beq",format:"BEQ Rs, Rt, target",description:"Branch if Rs equals Rt."},{name:"bne",format:"BNE Rs, Rt, target",description:"Branch if Rs does not equal Rt."},{name:"beqz",format:"BEQZ Rs, target",description:"Branch if Rs equals zero."},{name:"bnez",format:"BNEZ Rs, target",description:"Branch if Rs is nonzero."},{name:"bgez",format:"BGEZ Rs, target",description:"Branch if Rs is greater than or equal to zero."},{name:"bltz",format:"BLTZ Rs, target",description:"Branch if Rs is less than zero."},{name:"b",format:"B target",description:"Unconditional branch pseudo-instruction (assembles to BEQ $zero,$zero)."}],simd_vector:[{name:"addv.b",format:"ADDV.B Wd, Ws, Wt",description:"MSA: add packed bytes."},{name:"addv.h",format:"ADDV.H Wd, Ws, Wt",description:"MSA: add packed halfwords."},{name:"addv.w",format:"ADDV.W Wd, Ws, Wt",description:"MSA: add packed words."},{name:"subv.b",format:"SUBV.B Wd, Ws, Wt",description:"MSA: subtract packed bytes."},{name:"ld.b",format:"LD.B Wd, offset(Rs)",description:"MSA: loads a vector register with byte elements."},{name:"st.b",format:"ST.B Wd, offset(Rs)",description:"MSA: stores a vector register's byte elements."},{name:"ld.w",format:"LD.W Wd, offset(Rs)",description:"MSA: loads a vector register with word elements."},{name:"st.w",format:"ST.W Wd, offset(Rs)",description:"MSA: stores a vector register's word elements."}],arithmetic_logic:[{name:"add",format:"ADD rd, rs, rt",description:"rd = rs + rt (trapping on overflow)."},{name:"addu",format:"ADDU rd, rs, rt",description:"rd = rs + rt (no overflow trap - the common one)."},{name:"addiu",format:"ADDIU rd, rs, imm",description:"rd = rs + imm (also the MOVE/LI idiom)."},{name:"sub",format:"SUB rd, rs, rt",description:"rd = rs - rt (trapping on overflow)."},{name:"subu",format:"SUBU rd, rs, rt",description:"rd = rs - rt (no overflow trap)."},{name:"mult",format:"MULT rs, rt",description:"Signed multiply into HI:LO."},{name:"div",format:"DIV rs, rt",description:"Signed divide: LO=quotient, HI=remainder."},{name:"and",format:"AND rd, rs, rt",description:"rd = rs AND rt."},{name:"or",format:"OR rd, rs, rt",description:"rd = rs OR rt (also the MOVE idiom: or rd,rs,$zero)."},{name:"xor",format:"XOR rd, rs, rt",description:"rd = rs XOR rt."},{name:"nor",format:"NOR rd, rs, rt",description:"rd = NOT(rs OR rt) (also the NOT idiom: nor rd,rs,$zero)."},{name:"sll",format:"SLL rd, rt, shamt",description:"Shift left logical (also the classic NOP: sll $zero,$zero,0)."},{name:"srl",format:"SRL rd, rt, shamt",description:"Shift right logical."},{name:"sra",format:"SRA rd, rt, shamt",description:"Shift right arithmetic."},{name:"slt",format:"SLT rd, rs, rt",description:"rd = (rs < rt) ? 1 : 0, signed."},{name:"sltu",format:"SLTU rd, rs, rt",description:"rd = (rs < rt) ? 1 : 0, unsigned."}]},riscv:{process_exec:[{name:"ecall",format:"ECALL",description:"Environment Call - traps to the next-higher privilege level (Linux syscall entry)."},{name:"ebreak",format:"EBREAK",description:"Breakpoint trap (debugger exception)."}],low_level_hardware:[{name:"csrrw",format:"CSRRW rd, csr, rs1",description:"Atomically swaps a CSR with a GP register."},{name:"csrrs",format:"CSRRS rd, csr, rs1",description:"Atomically sets bits in a CSR using a GP register as a mask."},{name:"csrrc",format:"CSRRC rd, csr, rs1",description:"Atomically clears bits in a CSR using a GP register as a mask."},{name:"csrrwi",format:"CSRRWI rd, csr, imm",description:"CSRRW with a 5-bit immediate instead of a register."},{name:"csrrsi",format:"CSRRSI rd, csr, imm",description:"CSRRS with a 5-bit immediate instead of a register."},{name:"csrrci",format:"CSRRCI rd, csr, imm",description:"CSRRC with a 5-bit immediate instead of a register."},{name:"fence",format:"FENCE pred, succ",description:"Orders memory accesses between the pred and succ sets."},{name:"fence.i",format:"FENCE.I",description:"Synchronizes the instruction and data streams (for self-modifying code)."},{name:"wfi",format:"WFI",description:"Wait For Interrupt - hints the hart may stall until an interrupt."}],memory_management:[{name:"lw",format:"LW rd, offset(rs1)",description:"Load Word from memory."},{name:"sw",format:"SW rs2, offset(rs1)",description:"Store Word to memory."},{name:"lb",format:"LB rd, offset(rs1)",description:"Load Byte (sign-extended) from memory."},{name:"sb",format:"SB rs2, offset(rs1)",description:"Store Byte to memory."},{name:"lh",format:"LH rd, offset(rs1)",description:"Load Halfword (sign-extended) from memory."},{name:"sh",format:"SH rs2, offset(rs1)",description:"Store Halfword to memory."},{name:"ld",format:"LD rd, offset(rs1)",description:"Load Doubleword (RV64)."},{name:"sd",format:"SD rs2, offset(rs1)",description:"Store Doubleword (RV64)."},{name:"la",format:"LA rd, symbol",description:"Load Address pseudo-instruction."},{name:"li",format:"LI rd, imm",description:"Load Immediate pseudo-instruction."},{name:"lbu",format:"LBU rd, offset(rs1)",description:"Load Byte Unsigned (zero-extended)."},{name:"lhu",format:"LHU rd, offset(rs1)",description:"Load Halfword Unsigned (zero-extended)."},{name:"lwu",format:"LWU rd, offset(rs1)",description:"Load Word Unsigned (zero-extended, RV64)."},{name:"flw",format:"FLW rd, offset(rs1)",description:"Loads a single-precision float (F extension)."},{name:"fsw",format:"FSW rs2, offset(rs1)",description:"Stores a single-precision float (F extension)."},{name:"fld",format:"FLD rd, offset(rs1)",description:"Loads a double-precision float (D extension)."},{name:"fsd",format:"FSD rs2, offset(rs1)",description:"Stores a double-precision float (D extension)."},{name:"lr.w",format:"LR.W rd, (rs1)",description:"Load-Reserved - first half of an atomic RMW sequence (A extension)."},{name:"sc.w",format:"SC.W rd, rs2, (rs1)",description:"Store-Conditional - second half of an atomic RMW sequence (A extension)."},{name:"amoadd.w",format:"AMOADD.W rd, rs2, (rs1)",description:"Atomic memory add, returns the old value (A extension)."},{name:"amoswap.w",format:"AMOSWAP.W rd, rs2, (rs1)",description:"Atomic memory swap (A extension)."}],control_flow:[{name:"beq",format:"BEQ rs1, rs2, target",description:"Branch if rs1 equals rs2."},{name:"bne",format:"BNE rs1, rs2, target",description:"Branch if rs1 does not equal rs2."},{name:"blt",format:"BLT rs1, rs2, target",description:"Branch if rs1 < rs2 (signed)."},{name:"bge",format:"BGE rs1, rs2, target",description:"Branch if rs1 >= rs2 (signed)."},{name:"bltu",format:"BLTU rs1, rs2, target",description:"Branch if rs1 < rs2 (unsigned)."},{name:"bgeu",format:"BGEU rs1, rs2, target",description:"Branch if rs1 >= rs2 (unsigned)."},{name:"jal",format:"JAL rd, target",description:"Jump and link (function call), saves return address in rd."},{name:"jalr",format:"JALR rd, offset(rs1)",description:"Jump and link register (indirect call)."},{name:"ret",format:"RET",description:"Return pseudo-instruction (JALR x0, 0(x1))."},{name:"j",format:"J target",description:"Unconditional jump pseudo-instruction (JAL x0, target)."}],simd_vector:[{name:"vadd.vv",format:"VADD.VV vd, vs2, vs1",description:"RVV: adds two vector registers element-wise."},{name:"vsub.vv",format:"VSUB.VV vd, vs2, vs1",description:"RVV: subtracts two vector registers element-wise."},{name:"vmul.vv",format:"VMUL.VV vd, vs2, vs1",description:"RVV: multiplies two vector registers element-wise."},{name:"vle32.v",format:"VLE32.V vd, (rs1)",description:"RVV: vector load of 32-bit elements from memory."},{name:"vse32.v",format:"VSE32.V vs3, (rs1)",description:"RVV: vector store of 32-bit elements to memory."},{name:"vsetvli",format:"VSETVLI rd, rs1, vtypei",description:"RVV: configures the vector length and element type."},{name:"vfadd.vv",format:"VFADD.VV vd, vs2, vs1",description:"RVV: adds two floating-point vector registers element-wise."},{name:"vfmul.vv",format:"VFMUL.VV vd, vs2, vs1",description:"RVV: multiplies two floating-point vector registers element-wise."},{name:"vand.vv",format:"VAND.VV vd, vs2, vs1",description:"RVV: bitwise AND of two vector registers."},{name:"vor.vv",format:"VOR.VV vd, vs2, vs1",description:"RVV: bitwise OR of two vector registers."},{name:"vxor.vv",format:"VXOR