int value."},{name:"fabs",format:"FABS Vd, Vn",description:"Absolute value of a floating-point value."},{name:"fmax",format:"FMAX Vd, Vn, Vm",description:"Per-lane floating-point maximum."},{name:"fmin",format:"FMIN Vd, Vn, Vm",description:"Per-lane floating-point minimum."}],arithmetic_logic:[{name:"add",format:"ADD Xd, Xn, Xm",description:"Xd = Xn + Xm."},{name:"adds",format:"ADDS Xd, Xn, Xm",description:"Xd = Xn + Xm, updates NZCV flags."},{name:"sub",format:"SUB Xd, Xn, Xm",description:"Xd = Xn - Xm."},{name:"subs",format:"SUBS Xd, Xn, Xm",description:"Xd = Xn - Xm, updates NZCV flags (also CMP's underlying op)."},{name:"mul",format:"MUL Xd, Xn, Xm",description:"Xd = Xn * Xm (low bits)."},{name:"madd",format:"MADD Xd, Xn, Xm, Xa",description:"Xd = Xa + (Xn * Xm) (multiply-add)."},{name:"msub",format:"MSUB Xd, Xn, Xm, Xa",description:"Xd = Xa - (Xn * Xm) (multiply-subtract)."},{name:"sdiv",format:"SDIV Xd, Xn, Xm",description:"Signed division: Xd = Xn / Xm."},{name:"udiv",format:"UDIV Xd, Xn, Xm",description:"Unsigned division: Xd = Xn / Xm."},{name:"and",format:"AND Xd, Xn, Xm",description:"Xd = Xn AND Xm."},{name:"orr",format:"ORR Xd, Xn, Xm",description:"Xd = Xn OR Xm."},{name:"eor",format:"EOR Xd, Xn, Xm",description:"Xd = Xn XOR Xm."},{name:"bic",format:"BIC Xd, Xn, Xm",description:"Xd = Xn AND NOT(Xm)."},{name:"mvn",format:"MVN Xd, Xm",description:"Xd = NOT(Xm)."},{name:"lsl",format:"LSL Xd, Xn, #imm",description:"Logical shift left."},{name:"lsr",format:"LSR Xd, Xn, #imm",description:"Logical shift right."},{name:"asr",format:"ASR Xd, Xn, #imm",description:"Arithmetic shift right."},{name:"cmp",format:"CMP Xn, Xm",description:"Sets flags from Xn - Xm (alias of SUBS with discarded result)."},{name:"cmn",format:"CMN Xn, Xm",description:"Sets flags from Xn + Xm (alias of ADDS with discarded result)."},{name:"tst",format:"TST Xn, Xm",description:"Sets flags from Xn AND Xm (alias of ANDS with discarded result)."},{name:"neg",format:"NEG Xd, Xm",description:"Xd 