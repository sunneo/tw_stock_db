iod_line_release","gpiod_line_set_value","gpiod_line_get_value","gpiod_line_event_wait","gpiod_line_event_read","gpiod_line_set_config"],java:[],python:[],javascript:[],html:[]}},i2c_bus:{label:"I2C / SMBus",description:"Linux i2c-dev/SMBus transactions - the standard way userspace (including BMC firmware) talks to sensors, EEPROMs, and other I2C peripherals. The ioctl(fd, I2C_SLAVE, addr) address-set step itself just shows up as the generic `ioctl` name under file_io.",languages:{c:["i2c_smbus_read_byte","i2c_smbus_write_byte","i2c_smbus_read_byte_data","i2c_smbus_write_byte_data","i2c_smbus_read_word_data","i2c_smbus_write_word_data","i2c_smbus_read_i2c_block_data","i2c_smbus_write_i2c_block_data","i2c_smbus_xfer","i2c_smbus_access","i2c_transfer","i2c_master_send","i2c_master_recv","devm_regmap_init_i2c"],java:[],python:[],javascript:[],html:[]}},peci_bus:{label:"PECI (Platform Environment Control Interface)",description:"Intel PECI - the sideband bus a BMC uses to query CPU temperature/config registers directly, without going through the host OS. Directly relevant to this project's BMC/IPMI domain (ipmitool's sensor-reading code is PECI's userspace-visible sibling).",languages:{c:["peci_Ping","peci_GetDIB","peci_GetTemp","peci_RdPkgConfig","peci_WrPkgConfig","peci_RdIAMSR","peci_RdPCIConfig","peci_WrPCIConfig","peci_Lock","peci_Unlock","peci_GetCPUID","peci_request_alloc","peci_request_free","peci_command"],java:[],python:[],javascript:[],html:[]}},kernel_mailbox:{label:"Linux kernel mailbox framework (BMC<->host IPC)",description:"The kernel mailbox subsystem used for BMC<->host or SoC<->coprocessor message passing (e.g. ASPEED/Nuvoton BMC mailbox controllers) - a hardware-backed IPC channel, distinct from the OS-level `ipc` category.",languages:{c:["mbox_request_channel","mbox_request_channel_byname","mbox_send_message","mbox_client_register","mbox_client_unregister","mbox_free_channel","mbox_client_txdone","mbox_flush"],java:[],python:[],javascript:[],html:[]}},usb_hid:{label:"USB / HID device access (libusb, hidapi, WinUSB)",description:"Cross-platform USB bulk/control/interrupt transfers and HID report I/O - libusb + hidapi on Linux, WinUSB + the hid.dll HidD_* API + SetupAPI device enumeration on Windows. Kept as one category since it's the same conceptual operation (talk to a USB device) regardless of OS.",languages:{c:["libusb_init","libusb_exit","libusb_open","libusb_close","libusb_open_device_with_vid_pid","libusb_get_device_list","libusb_free_device_list","libusb_claim_interface","libusb_release_interface","libusb_control_transfer","libusb_bulk_transfer","libusb_interrupt_transfer","libusb_submit_transfer","hid_init","hid_exit","hid_open","hid_open_path","hid_close","hid_read","hid_write","hid_get_feature_report","hid_send_feature_report","hid_enumerate","hid_free_enumeration","HidD_GetAttributes","HidD_GetHidGuid","HidD_GetPreparsedData","HidD_SetFeature","HidD_GetFeature","HidD_SetOutputReport","HidD_GetInputReport","WinUsb_Initialize","WinUsb_Free","WinUsb_ControlTransfer","WinUsb_ReadPipe","WinUsb_WritePipe","WinUsb_QueryDeviceInformation","SetupDiGetClassDevs","SetupDiEnumDeviceInterfaces","SetupDiGetDeviceInterfaceDetail"],java:[],python:[],javascript:[],html:[],shell:["lsusb"]}},device_tree_api:{label:"Linux kernel Device Tree (OF) runtime API",description:"The kernel-side counterpart to the static .dts/.dtsi descriptions build_system_tools.py now recognizes (device_tree_source) - drivers call this API to read properties/resources out of the device tree the bootloader handed the kernel.",languages:{c:["of_property_read_u32","of_property_read_u32_array","of_property_read_string","of_property_read_bool","of_get_property","of_find_node_by_name","of_find_compatible_node","of_match_device","of_device_get_match_data","of_parse_phandle","of_node_put","of_get_child_count","of_property_count_elems_of_size","of_address_to_resource","of_iomap","devm_of_iomap","platform_get_resource","platform_get_irq","devm_ioremap_