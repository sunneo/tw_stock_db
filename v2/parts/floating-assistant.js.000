TML","insertAdjacentElement","insertAdjacentText","getBoundingClientRect","scrollIntoView","focus","blur","click","style.setProperty","getComputedStyle","innerHTML"],html:[]}},event_handling:{label:"Event listener registration / dispatch",description:'Registers, removes, or manually fires a DOM/browser event, or intercepts its default behavior/propagation - a distinct concern from dom_manipulation (shaping the tree) and from asynchronous control flow (concurrency category\'s Promise/timer entries), since "does this function react to something happening" is its own real behavior question.',languages:{c:[],java:["addMouseListener","addKeyListener","addWindowListener","addPropertyChangeListener","addChangeListener","addItemListener","addFocusListener","addListSelectionListener","removeActionListener","invokeLater","invokeAndWait","EventQueue.invokeLater","SwingUtilities.invokeAndWait","Platform.runLater","setOnAction","setOnMouseClicked","setOnKeyPressed","setOnKeyReleased","setOnMouseMoved","setOnDragDetected","EventBus.post","EventBus.register","ApplicationEventPublisher.publishEvent"],python:["bind_all","after","after_cancel","mainloop","disconnect","emit","pyqtSignal","Signal","clicked.connect","pygame.event.post","pygame.event.pump","pygame.event.wait","pygame.event.poll","keyboard.on_press","keyboard.add_hotkey","keyboard.wait","mouse.on_click","pynput.keyboard.Listener","pynput.mouse.Listener","add_done_callback","add_signal_handler"],javascript:["addEventListener","removeEventListener","dispatchEvent","preventDefault","stopPropagation","stopImmediatePropagation","on","once","off","emit","emitter.on","emitter.once","emitter.emit","emitter.off","emitter.removeListener","emitter.removeAllListeners","EventEmitter","EventTarget","CustomEvent","process.off","process.emit","window.onerror","window.onload","document.onreadystatechange","MutationObserver","IntersectionObserver","ResizeObserver","PerformanceObserver","ReportingObserver","readline.on","stream.on"],html:[]