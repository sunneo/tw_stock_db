;color:#222;border-radius:12px;padding:18px 20px;box-shadow:0 12px 40px rgba(0,0,0,.45);font:14px/1.5 sans-serif;box-sizing:border-box}'\n      + '.ai-chat-dialog h3{margin:0 0 12px;font-size:17px;color:#222}'\n      + '.ai-chat-dialog select,.ai-chat-dialog input[type=number]{padding:6px 8px;border:1px solid #bbb;border-radius:6px;background:#fff;color:#222;box-sizing:border-box;font:inherit}'\n      + '.ai-chat-dialog .block{display:block}'\n      + '.ai-chat-dialog-actions{display:flex;gap:8px;margin-top:14px}.ai-chat-dialog-actions-spacer{flex:1}'\n      + '.ai-chat-dialog-actions button{padding:6px 16px;border-radius:6px;border:1px solid #bbb;background:#f3f3f3;color:#222;cursor:pointer;font:inherit}'\n      + '.ai-chat-dialog-actions button:last-child{background:#76b900;border-color:#76b900;color:#fff;font-weight:bold}';\n    document.head.appendChild(s);\n  }\n  function showMp4ExportOptionsDialog(defaults) {\n    defaults = defaults || {};\n    return new Promise(function (resolve) {\n      ensureDialogStyle();\n      var overlay = document.createElement('div');\n      overlay.className = 'ai-chat-dialog-overlay';\n\n      var dialog = document.createElement('div');\n      dialog.className = 'ai-chat-dialog';\n      dialog.innerHTML =\n        '<h3>匯出MP4影片</h3>' +\n        '<div style=\"margin-bottom:0.8em;\">' +\n        '<label class=\"block\">秒數（至少1秒，無上限）<br>' +\n        '<input type=\"number\" class=\"ai-chat-mp4dlg-duration\" min=\"1\" step=\"1\" style=\"width:100%;\"></label>' +\n        '</div>' +\n        '<div style=\"margin-bottom:0.8em;\">' +\n        '<label class=\"block\">播放速度（0.1x ~ 4.0x）<br>' +\n        '<input type=\"number\" class=\"ai-chat-mp4dlg-speed\" min=\"0.1\" max=\"4\" step=\"0.1\" style=\"width:100%;\"></label>' +\n        '</div>' +\n        '<div class=\"ai-chat-dialog-actions\">' +\n        '<span class=\"ai-chat-dialog-actions-spacer\"></span>' +\n        '<button type=\"button\" class=\"ai-chat-mp4dlg-cancel\">取消</button>' +\n