_proc_sysfs",description:"sysfs - kernel object/device attributes exposed as files (what libgpiod/hwmon/etc sit on top of)."},{prefix:"/etc/fstab",category:"filesystem_management",description:"Static filesystem mount table read by mount -a and boot scripts."},{prefix:"/etc/shadow",category:"crypto_security",description:"Hashed password database - touching this is a strong credential-handling signal."},{prefix:"/etc/passwd",category:"crypto_security",description:"User account database - identity/credential-adjacent."},{prefix:"/etc/sudoers",category:"crypto_security",description:"Privilege-escalation policy - editing/reading this is a strong security signal."},{prefix:"/var/log/",category:"logging_output",description:"Persistent log storage."}],well_known_env_vars:[{name:"PATH",category:"env_config_access",description:"Executable search path - also a classic PATH-hijacking vector if untrusted-writable."},{name:"HOME",category:"env_config_access",description:"Current user's home directory."},{name:"USER",category:"env_config_access",description:"Current username."},{name:"SHELL",category:"env_config_access",description:"User's login shell."},{name:"LANG",category:"env_config_access",description:"Locale setting."},{name:"LC_ALL",category:"env_config_access",description:"Locale override."},{name:"PWD",category:"env_config_access",description:"Current working directory."},{name:"TERM",category:"env_config_access",description:"Terminal type."},{name:"DISPLAY",category:"env_config_access",description:"X11 display target."},{name:"TMPDIR",category:"env_config_access",description:"Preferred temp-file directory."},{name:"SUDO_USER",category:"env_config_access",description:"Original user behind a sudo invocation."},{name:"SSH_AUTH_SOCK",category:"network_io",description:"ssh-agent socket path - credential-forwarding channel."},{name:"LD_PRELOAD",category:"crypto_security",description:"Forces a shared library to load before all others - a classic hijacking/injection vector."},{name:"LD_LIBRARY_PATH",category:"crypto_security",description:"Overrides the shared-library search path - can be abused to load a malicious library instead of the intended one."}],well_known_js_libraries:[{match:"cdnjs.cloudflare.com/ajax/libs/marked/",name:"marked",description:"Markdown-to-HTML parser/renderer - converts AI-authored or user-authored markdown text into displayable HTML."},{match:"/dompurify/",name:"DOMPurify",description:"HTML sanitizer - strips XSS-unsafe markup before untrusted/AI-generated HTML is inserted into the page, typically paired with a markdown renderer like marked."},{match:"/katex/",name:"KaTeX",description:"Fast client-side math typesetting (LaTeX-notation-to-HTML) library."},{match:"/jszip/",name:"JSZip",description:"Creates, reads, and edits .zip archives entirely in the browser (no server round-trip)."},{match:"pptxgenjs",name:"PptxGenJS",description:"Generates PowerPoint (.pptx) files client-side from a declarative slide/shape API."},{match:"/pdfmake/",name:"pdfmake",description:"Generates PDF files client-side from a declarative document-definition object."},{match:"/jquery",name:"jQuery",description:"General-purpose DOM manipulation/AJAX utility library (legacy - most of its DOM/event helpers have native browser equivalents now)."},{match:"/chart.js",name:"Chart.js",description:"Canvas-based charting/data-visualization library."},{match:"/three.min.js",name:"three.js",description:"WebGL 3D rendering library."},{match:"/highlight.js",name:"highlight.js",description:"Client-side syntax highlighting for code blocks."}],assembly_idioms:{x86:[{pattern:["rep","stosb"],name:"memset_zero_or_fill",template:"clears/fills a block of memory one BYTE at a time (the classic `rep stosb` bzero/memset idiom - AL holds the fill value, ECX/RCX the byte count, EDI the destination)"},{pattern:["rep","stosw"],name:"memset_zero_or_fill",template:"clears/fills a block of memory one WORD (2 bytes) at a time (`rep stosw`)"},{pattern:["rep","stosd"],name:"memset_zero_or_fill",template:"clears/fills a block of memory one DOUBLEWORD (4 bytes) at a time (`rep stosd`)"},{pattern:["rep","stosq"],name:"memset_zero_or_fill",template:"clears/fills a block of memory one QUADWORD (8 bytes) at a time, 64-bit mode (`rep stosq`)"},{pattern:["rep","movsb"],name:"memcpy",template:"copies a block of memory one BYTE at a time (the classic `rep movsb` memcpy idiom - ECX/RCX the byte count, ESI the source, EDI the destination)"},{pattern:["rep","movsw"],name:"memcpy",template:"copies a block of memory one WORD (2 bytes) at a time (`rep movsw`)"},{pattern:["rep","movsd"],name:"memcpy",template:"copies a block of memory one DOUBLEWORD (4 bytes) at a time (`rep movsd`)"},{pattern:["rep","movsq"],name:"memcpy",template:"copies a block of memory one QUADWORD (8 bytes) at a time, 64-bit mode (`rep movsq`)"},{pattern:["repe","cmpsb"],name:"memcmp",template:"compares two blocks of memory byte-by-byte WHILE they keep matching, stopping at the first difference (the classic `repe cmpsb` memcmp idiom)"},{pattern:["repz","cmpsb"],name:"memcmp",template:"compares two blocks of memory byte-by-byte WHILE they keep matching, stopping at the first difference (`repz cmpsb`, alias of REPE)"},{pattern:["repne","scasb"],name:"memchr_or_strlen",template:"scans a block of memory byte-by-byte for a matching value, stopping at the FIRST match (the classic `repne scasb` memchr/strlen-style idiom)"},{pattern:["repnz","scasb"],name:"memchr_or_strlen",template:"scans a block of memory byte-by-byte for a matching value, stopping at the FIRST match (`repnz scasb`, alias of REPNE)"}]}},api:{c:{socket:{summary:"Creates an endpoint for network communication and returns a file descriptor for it.",parameters:[{name:"domain",meaning:"address family (e.g. AF_INET = IPv4, AF_INET6 = IPv6, AF_UNIX = local socket)"},{name:"type",meaning:"socket type (e.g. SOCK_STREAM = reliable connection-oriented/TCP, SOCK_DGRAM = connectionless/UDP)"},{name:"protocol",meaning:"specific protocol (0 = the default protocol for the given domain/type)"}],return:{meaning:"a file descriptor for the new socket on success",rules:[{when:{op:"<",value:0},meaning:"socket creation failed (see errno)"},{when:{op:">=",value:0},meaning:"a valid socket file descriptor"}]}},setsockopt:{summary:"Sets a configuration option on a socket.",parameters:[{name:"sockfd",meaning:"the socket being configured"},{name:"level",meaning:"the option's protocol level (e.g. SOL_SOCKET = socket-API-level options)"},{name:"optname",meaning:"which option to set (e.g. SO_REUSEADDR = allow rebinding an address still in TIME_WAIT)"},{name:"optval",meaning:"pointer to the value to set the option to"},{name:"optlen",meaning:"size in bytes of the value pointed to by optval"}],return:{meaning:"0 on success",rules:[{when:{op:"<",value:0},meaning:"setting the option failed (see errno) - the call's effect did NOT take place"},{when:{op:"==",value:0},meaning:"the option was set successfully"}]}},bind:{summary:"Assigns a local address (IP + port) to a socket.",parameters:[{name:"sockfd",meaning:"the socket to bind"},{name:"addr",meaning:"the local address (IP and port) to bind the socket to"},{name:"addrlen",meaning:"size in bytes of the addr structure"}],return:{meaning:"0 on success",rules:[{when:{op:"<",value:0},meaning:"the bind failed (see errno - commonly EADDRINUSE, the port is already in use)"},{when:{op:"==",value:0},meaning:"the address was successfully bound to the socket"}]}},listen:{summary:"Marks a bound socket as passive/listening, ready to accept incoming connections.",parameters:[{name:"sockfd",meaning:"the bound socket to start listening on"},{name:"backlog",meaning:"maximum number of pending (not-yet-accepted) connections to queue"}],return:{meaning:"0 on success",rules:[{when:{op:"<",value:0},meaning:"the socket could not be put into listening state (see errno)"},{when:{op:"==",value:0},meaning:"the socket is now listening for incoming connections"}]}},accept:{summary:"Blocks until a client connects to a listening socket, then returns a NEW socket connected to that client.",parameters:[{name:"sockfd",meaning:"the listening socket to accept a connection from"},{name:"addr",meaning:"(output) filled in with the connecting client's address"},{name:"addrlen",meaning:"(input/output) size of the addr buffer on input, actual address size written on output"}],return:{meaning:"a NEW file descriptor for the accepted connection on success (the original sockfd keeps listening)",rules:[{when:{op:"<",value:0},meaning:"no connection was accepted - an error occurred (see errno)"},{when:{op:">=",value:0},meaning:"a new connected-client socket file descriptor"}]}},recv:{summary:"Reads up to `len` bytes from an already-connected socket into `buf`.",parameters:[{name:"sockfd",meaning:"the connected socket to read from"},{name:"buf",meaning:"destination buffer that receives the incoming bytes"},{name:"len",meaning:"maximum number of bytes to read into buf"},{name:"flags",meaning:"receive behavior flags (0 = normal blocking receive)"}],return:{meaning:"the number of bytes actually placed into buf",rules:[{when:{op:"<",value:0},meaning:"a receive error occurred (see errno) - no data was read"},{when:{op:"==",value:0},meaning:"the peer performed an orderly shutdown - the connection is closed, no more data will ever arrive"},{when:{op:">",value:0},meaning:"the number of bytes of real data successfully received into buf"}]}},send:{summary:"Writes up to `len` bytes from `buf` to an already-connected socket.",parameters:[{name:"sockfd",meaning:"the connected socket to write to"},{name:"buf",meaning:"source buffer containing the bytes to send"},{name:"len",meaning:"number of bytes from buf to send"},{name:"flags",meaning:"send behavior flags (0 = normal blocking send)"}],return:{meaning:"the number of bytes actually queued/sent",rules:[{when:{op:"<",value:0},meaning:"a send error occurred (see errno) - no data was sent"},{when:{op:">=",value:0},meaning:"the number of bytes successfully sent (may be less than len)"}]}},htons:{summary:"Converts a 16-bit value from host byte order to network byte order (big-endian) - used to prepare a port number for a sockaddr_in.",parameters:[{name:"hostshort",meaning:"the 16-bit value in the host's native byte order"}],return:{meaning:"the same value, reordered into network byte order - there is no error case"}},perror:{summary:"Writes a human-readable description of the CURRENT errno value to standard error (stderr), prefixed by the caller's own message.",parameters:[{name:"s",meaning:"a caller-supplied prefix string (e.g. the name of the call that just failed) prepended to the error text"}],return:{meaning:"none (void) - always writes to stderr, never fails observably"}},printf:{summary:"Formats and writes text to standard output (stdout).",parameters:[{name:"format",meaning:"a printf-style format string"}],return:{meaning:"the number of characters written on success, or a negative value if an output error occurred"}},malloc:{summary:"Allocates a block of uninitialized heap memory.",parameters:[{name:"size",meaning:"number of bytes to allocate"}],return:{meaning:"a pointer to the allocated block on success",rules:[{when:{op:"falsy"},meaning:"allocation failed (out of memory) - the pointer is NULL, must not be dereferenced"},{when:{op:"truthy"},meaning:"a valid pointer to size bytes of uninitialized heap memory"}]}},free:{summary:"Releases a block of heap memory previously returned by malloc/calloc/realloc, making it invalid to use afterward.",parameters:[{name:"ptr",meaning:"the pointer to release (freeing NULL is explicitly a safe no-op)"}],return:{meaning:"none (void)"}},memset:{summary:"Fills a block of memory with a constant byte value.",parameters:[{name:"s",meaning:"start of the memory region to fill"},{name:"c",meaning:"the byte value to write into every position (commonly 0, to zero-initialize)"},{name:"n",meaning:"number of bytes to fill"}],return:{meaning:"returns s unchanged (rarely used, since the caller already has s)"}},memcpy:{summary:"Copies a block of memory from one location to another (regions must not overlap).",parameters:[{name:"dest",meaning:"destination address the bytes are copied INTO"},{name:"src",meaning:"source address the bytes are copied FROM"},{name:"n",meaning:"number of bytes to copy"}],return:{meaning:"returns dest unchanged (rarely used, since the caller already has dest)"}},open:{summary:"Opens (or creates) a file/device special file, returning a file descriptor for it.",parameters:[{name:"pathname",meaning:"path of the file/device to open"},{name:"flags",meaning:"access mode and behavior flags (e.g. O_RDWR = read+write, O_SYNC = writes complete before returning)"},{name:"mode",meaning:"permission bits to apply if the file is being newly created (only used with O_CREAT)"}],return:{meaning:"a file descriptor on success",rules:[{when:{op:"<",value:0},meaning:"the file/device could not be opened (see errno - permissions, doesn't exist, etc.)"},{when:{op:">=",value:0},meaning:"a valid open file descriptor"}]}},close:{summary:"Closes a file descriptor, releasing the underlying resource.",parameters:[{name:"fd",meaning:"the file descriptor to close"}],return:{meaning:"0 on success",rules:[{when:{op:"<",value:0},meaning:"the close failed (see errno) - rare, but means the fd's state is now unspecified"},{when:{op:"==",value:0},meaning:"the descriptor was closed successfully"}]}},mmap:{summary:"Maps a region of a file/device directly into this process's virtual address space, so ordinary memory reads/writes act on the underlying file/device.",parameters:[{name:"addr",meaning:"preferred starting address (NULL = let the kernel choose the address)"},{name:"length",meaning:"number of bytes to map"},{name:"prot",meaning:"memory protection for the mapping (e.g. PROT_READ|PROT_WRITE = readable and writable)"},{name:"flags",meaning:"mapping visibility (e.g. MAP_SHARED = writes go through to the underlying file/device and are visible to other mappers; MAP_PRIVATE = copy-on-write, changes stay local)"},{name:"fd",meaning:"file descriptor of the already-open file/device being mapped"},{name:"offset",meaning:"byte offset within the file/device where the mapping begins (for /dev/mem, this IS the physical address being mapped)"}],return:{meaning:"a pointer usable to directly read/write the mapped region on success",rules:[{when:{op:"==",value:"MAP_FAILED"},meaning:"the mapping failed (see errno) - the pointer must NOT be dereferenced or passed to munmap"}]}},munmap:{summary:"Unmaps a memory region previously established by mmap, releasing that virtual address range - the mapped file/device is untouched, only this process's access to it via that pointer is removed.",parameters:[{name:"addr",meaning:"starting address of the mapping to remove (must be a value previously returned by mmap)"},{name:"length",meaning:"size of the region to unmap (should match the original mmap length)"}],return:{meaning:"0 on success",rules:[{when:{op:"<",value:0},meaning:"the unmap failed (see errno)"},{when:{op:"==",value:0},meaning:"the mapping was removed successfully"}]}},pthread_create:{summary:"Creates a new thread that begins executing the given start-routine function, running concurrently with the caller.",parameters:[{name:"thread",meaning:"(output) filled in with an identifier for the newly created thread"},{name:"attr",meaning:"thread creation attributes (NULL = default attributes)"},{name:"start_routine",meaning:"the function the new thread begins executing"},{name:"arg",meaning:"the single argument passed through to start_routine when the new thread begins"}],return:{meaning:"0 on success - NOTE this returns a raw error NUMBER directly, NOT via errno like most other calls here",rules:[{when:{op:"==",value:0},meaning:"the thread was created and is now running concurrently"},{when:{op:"!=",value:0},meaning:"thread creation failed - the returned value IS the error number (not read from errno)"}]}},pthread_detach:{summary:"Marks a thread as detached, so its resources are automatically released when it exits (no other thread needs to pthread_join it).",parameters:[{name:"thread",meaning:"identifier of the thread to detach"}],return:{meaning:"0 on success",rules:[{when:{op:"==",value:0},meaning:"the thread is now detached"},{when:{op:"!=",value:0},meaning:"detaching failed - the returned value is the error number"}]}},exit:{summary:"Immediately terminates the calling PROCESS (not just the current function) - does not return.",parameters:[{name:"status",meaning:"the process exit status reported to the parent process/shell (0 = conventionally success, nonzero = failure)"}],return:{meaning:"never returns - execution stops here"}},read:{summary:"Reads up to count bytes from a file descriptor into a buffer.",parameters:[{name:"fd",meaning:"the open file descriptor to read from"},{name:"buf",meaning:"destination buffer"},{name:"count",meaning:"maximum number of bytes to read"}],return:{meaning:"the number of bytes actually read",rules:[{when:{op:"<",value:0},meaning:"the read failed (see errno)"},{when:{op:"==",value:0},meaning:"end of file (or the peer closed the connection) - no more data"},{when:{op:">",value:0},meaning:"that many bytes of real data were read"}]}},write:{summary:"Writes up to count bytes from a buffer to a file descriptor.",parameters:[{name:"fd",meaning:"the open file descriptor to write to"},{name:"buf",meaning:"source buffer holding the bytes"},{name:"count",meaning:"number of bytes to write"}],return:{meaning:"the number of bytes actually written (can be fewer than count)",rules:[{when:{op:"<",value:0},meaning:"the write failed (see errno)"},{when:{op:">=",value:0},meaning:"that many bytes were written - a short write needs the caller to retry the rest"}]}},pread:{summary:"Reads or writes at an explicit file offset without moving the file position.",parameters:[{name:"fd",meaning:"the open file descriptor"},{name:"buf",meaning:"the data buffer"},{name:"count",meaning:"number of bytes"},{name:"offset",meaning:"byte offset in the file at which to start"}],return:{meaning:"the number of bytes transferred",rules:[{when:{op:"<",value:0},meaning:"the operation failed (see errno)"},{when:{op:"==",value:0},meaning:"end of file (pread)"},{when:{op:">",value:0},meaning:"that many bytes were transferred"}]}},pwrite:{summary:"Reads or writes at an explicit file offset without moving the file position.",parameters:[{name:"fd",meaning:"the open file descriptor"},{name:"buf",meaning:"the data buffer"},{name:"count",meaning:"number of bytes"},{name:"offset",meaning:"byte offset in the file at which to start"}],return:{meaning:"the number of bytes transferred",rules:[{when:{op:"<",value:0},meaning:"the operation failed (see errno)"},{when:{op:"==",value:0},meaning:"end of file (pread)"},{when:{op:">",value:0},meaning:"that many bytes were transferred"}]}},lseek:{summary:"Moves the read/write position of an open file.",parameters:[{name:"fd",meaning:"the open file descriptor"},{name:"offset",meaning:"byte distance to move, interpreted according to whence"},{name:"whence",meaning:"the reference point (SEEK_SET = file start, SEEK_CUR = current position, SEEK_END = file end)"}],return:{meaning:"the new position measured from the start of the file",rules:[{when:{op:"<",value:0},meaning:"the seek failed (see errno)"},{when:{op:">=",value:0},meaning:"the new absolute file position"}]}},fsync:{summary:"Forces buffered changes of a file to be physically written to the storage device.",parameters:[{name:"fd",meaning:"the open file descriptor to flush"}],return:{meaning:"0 on success",rules:[{when:{op:"!=",value:0},meaning:"the flush failed (see errno)"},{when:{op:"==",value:0},meaning:"data is durably on the device"}]}},fdatasync:{summary:"Forces buffered changes of a file to be physically written to the storage device.",parameters:[{name:"fd",meaning:"the open file descriptor to flush"}],return:{meaning:"0 on success",rules:[{when:{op:"!=",value:0},meaning:"the flush failed (see errno)"},{when:{op:"==",value:0},meaning:"data is durably on the device"}]}},dup:{summary:"Duplicates a file descriptor so two numbers refer to the same open file.",parameters:[{name:"oldfd",meaning:"the descriptor to duplicate"},{name:"newfd",meaning:"the descriptor number to make into a copy (dup2 closes it first if it is open)"}],return:{meaning:"the new descriptor",rules:[{when:{op:"<",value:0},meaning:"duplication failed (see errno)"},{when:{op:">=",value:0},meaning:"the new descriptor number"}]}},dup2:{summary:"Duplicates a file descriptor so two numbers refer to the same open file.",parameters:[{name:"oldfd",meaning:"the descriptor to duplicate"},{name:"newfd",meaning:"the descriptor number to make into a copy (dup2 closes it first if it is open)"}],return:{meaning:"the new descriptor",rules:[{when:{op:"<",value:0},meaning:"duplication failed (see errno)"},{when:{op:">=",value:0},meaning:"the new descriptor number"}]}},fcntl:{summary:"Performs a control operation on a file descriptor (flags, locks, duplicate).",parameters:[{name:"fd",meaning:"the open file descriptor"},{name:"cmd",meaning:"which operation to perform (F_GETFL, F_SETFL, F_SETFD, F_DUPFD, F_SETLK ...)"},{name:"arg",meaning:"operation-specific argument"}],return:{meaning:"operation-specific result",rules:[{when:{op:"<",value:0},meaning:"the operation failed (see errno)"}]}},ioctl:{summary:"Sends a device-specific control request to a file descriptor (driver).",parameters:[{name:"fd",meaning:"the open device descriptor"},{name:"request",meaning:"the device-defined request code"},{name:"argp",meaning:"pointer to the request's argument/result data"}],return:{meaning:"usually 0 on success",rules:[{when:{op:"<",value:0},meaning:"the request failed or is unsupported (see errno)"},{when:{op:">=",value:0},meaning:"the request succeeded"}]}},stat:{summary:"Reads file metadata (size, type, permissions, timestamps) into a struct stat.",parameters:[{name:"path",meaning:"path of t