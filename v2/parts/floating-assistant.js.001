[n,k]，即 Y = A · Wᵀ。\n// 本檔只是參考實作與介面，不含 GPU 核心；網頁版真正的 q4 權重尚未在本機取得，所以目前沒有與 q8 路徑的真權重對拍。\n\nconst BLOCK = 32, BYTES = 16, ZP = 8;\n\nfunction nBlocksOf(K) { return Math.ceil(K / BLOCK); }\n\n// 把 B 解成每個 (n, k) 的 4 位元整數（Uint8Array，長度 N×K，已去掉 K 之後的 padding）\nfunction unpackQ4(B, N, K) {\n  const nb = nBlocksOf(K);\n  if (B.length !== N * nb * BYTES) throw new Error('unpackQ4：B 的長度 ' + B.length + ' 與 N×nBlocks×16=' + (N * nb * BYTES) + ' 不符');\n  const q = new Uint8Array(N * K);\n  for (let n = 0; n < N; n++) {\n    for (let b = 0; b < nb; b++) {\n      const base = (n * nb + b) * BYTES;\n      for (let j = 0; j < BYTES; j++) {\n        const k0 = b * BLOCK + 2 * j, k1 = k0 + 1, byte = B[base + j];\n        if (k0 < K) q[n * K + k0] = byte & 0x0f;\n        if (k1 < K) q[n * K + k1] = byte >> 4;\n      }\n    }\n  }\n  return q;\n}\n\n// 反量化成 Float32Array（N×K），用於參考與測試\nfunction dequantQ4(B, scales, N, K, zp = ZP) {\n  const nb = nBlocksOf(K);\n  if (scales.length !== N * nb) throw new Error('dequantQ4：scales 的長度 ' + scales.length + ' 與 N×nBlocks=' + (N * nb) + ' 不符');\n  const q = unpackQ4(B, N, K);\n  const w = new Float32Array(N * K);\n  for (let n = 0; n < N; n++) for (let k = 0; k < K; k++) {\n    w[n * K + k] = (q[n * K + k] - zp) * scales[n * nb + Math.floor(k / BLOCK)];\n  }\n  return w;\n}\n\n// Y = A · Wᵀ，A 是 M×K（Float32Array，列優先），回傳 Float32Array（M×N）。\n// 累加用 f64，最後存成 f32（參考版的數值基準）。\nfunction matmulNBitsRef(A, M, K, B, scales, N, zp = ZP) {\n  if (A.length !== M * K) throw new Error('matmulNBitsRef：A 的長度 ' + A.length + ' 與 M×K=' + (M * K) + ' 不符');\n  const w = dequantQ4(B, scales, N, K, zp);\n  const Y = new Float32Array(M * N);\n  for (let m = 0; m < M; m++) for (let n = 0; n < N; n++) {\n    let acc = 0;\n    const ao = m * K, wo = n * K;\n    for (let k = 0; k < K; k++) acc += A[ao + k] * w[wo + k];\n    Y[m * N + n] = acc;\n  }\n  return Y;\n}\n\n// 反向打包（測試與頁面用）：q 是 N×K（每格 0..15），回傳 B（N×nBlocks×16）\nfunction packQ4(q, N, K) {\n  const nb = nBlocksOf(K);\n  const B = new Uint8Array(N * nb * BYTES);\n  for (let n = 0; n < N; n++) for (let b = 0; b < nb; b++) for (let j = 0; j < BYTES; j++) {\n    const k0 = b * BLOCK + 2 * j, k1 = k0 + 1;\n    const lo = k0 < K ? q[n * K + k0] : 0, hi = k1 < K ? q[n * K + k1] : 0;\n    B[(n * nb + b) * BYTES + j] = (hi << 4) | lo;\n  }\n  return B;\n}\n\nmodule.exports = { BLOCK, BYTES, ZP, nBlocksOf, unpackQ4, dequantQ4, matmulNBitsRef, packQ4 };\n\n};\nMODS[\"matmulnbits_gpu\"] = function (module, exports, require) {\n'use strict';\n// MatMulNBits（bits=4、block 32、無 zero_points）的 GPU 核心（WGSL），退路：WebGL2 未做 → cpu-js（matmulnbits_ref.js）。\n// 一個 invocation 算一個輸出格 (m, n)：沿 K 逐元素累加，權重是 4 位元，從 u32 打包的位元組中取出（低位元是偶數 k）。\n// 介面與 q8mm 相同風格：matmulNBits(A, M, K, B, scales, N, opts) → {result: Float32Array(M×N), info}。\n// pipeline 由 nn.runWgsl 以 WGSL 字串為鍵快取（第二次呼叫不重建，見 gpu_cache_fallback_test.js）；退路：WebGPU 失敗 → cpu-js（matmulnbits_ref）。\n\nconst nn = require('./nn_ops.js');\nconst REF = require('./matmulnbits_ref.js');\n\nconst WGSL_MATMULNBITS = `\nstruct P { M: u32, K: u32, N: u32, nb: u32 }\n@group(0) @binding(0) var<storage, read> a: array<f32>;\n@group(0) @binding(1) var<storage, read> bq: array<u32>;\n@group(0) @binding(2) var<storage, read> sc: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n// @kernel matmulnbits\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  // 一維派發（runWgsl 只接受一個數字）：扁平索引 idx = m × npad + n，npad 是 N 向上取 64 的倍數\n  let npad = ((p.N + 63u) / 64u) * 64u;\n  let idx = gid.x;\n  let m = idx / npad;\n  let n = idx % npad;\n  if (n >= p.N || m >= p.M) { return; }\n  var acc: f32 = 0.0;\n  for (var k: u32 = 0u; k < p.K; k = k + 1u) {\n    let b = k / 32u;\n    let bi = (n * p.nb + b) * 16u + (k % 32u) / 2u;\n    let byte = (bq[bi >> 2u] >> ((bi & 3u) * 8u)) & 255u;\n    let nib = (byte >> ((k & 1u) * 4u)) & 15u;\n    let w = (f32(nib) - 8.0) * sc[n * p.nb + b];\n    acc = acc + a[m * p.K + k] * w;\n  }\n  y[m * p.N + n] = acc;\n}\n`;\n\n// 解碼（M 小）變體（清單 O3，@kernel matmulnbits_dec）：一個工作群組 256 執行緒負責「1 列 m × 16 個輸出欄」。\n// 執行緒 t：欄 = t/16（16 欄），lane = t%16 負責該欄的 4 位元字（一個 u32 ＝ 8 個權重，同一個區塊的同一個縮放值）。\n// 輸入 A 的一段（256 個 k ＝ 32 個字）先搬進共用記憶體 xs（1 KiB），16 條 lane 各取其中 2 個字。\n// 反量化在區塊層級：每個字只讀一次縮放值，權重是 nibble−8。最後 16 條 lane 的部分和經共用記憶體 red（1 KiB）歸約。\n// 共用記憶體用量：xs 1 KiB ＋ red 1 KiB ＝ 2 KiB。派發：[ceil(N/16), M, 1]。\nconst WGSL_MATMULNBITS_DEC = `\nstruct P { M: u32, K: u32, N: u32, nb: u32 }\n@group(0) @binding(0) var<storage, read> a: array<f32>;\n@group(0) @binding(1) var<storage, read> bq: array<u32>;\n@group(0) @binding(2) var<storage, read> sc: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\nvar<workgroup> xs: array<f32, 256>;\nvar<workgroup> red: array<f32, 256>;\n// @kernel matmulnbits_dec\n@compute @workgroup_size(256)\nfn main(@builtin(local_invocation_id) lid: vec3<u32>, @builtin(workgroup_id) wid: vec3<u32>) {\n  let t = lid.x;\n  let m = wid.y;\n  let col = wid.x * 16u + t / 16u;\n  let lane = t % 16u;\n  let nw = p.nb * 4u;\n  var acc: f32 = 0.0;\n  for (var kt: u32 = 0u; kt < p.K; kt = kt + 256u) {\n    let kk = kt + t;\n    if (kk < p.K) { xs[t] = a[m * p.K + kk]; } else { xs[t] = 0.0; }\n    workgroupBarrier();\n    for (var j: u32 = 0u; j < 2u; j = j + 1u) {\n      let wl = lane + j * 16u;\n      let gw = kt / 8u + wl;\n      if (col < p.N && gw < nw) {\n        let word = bq[col * nw + gw];\n        let s = sc[col * p.nb + gw / 4u];\n        for (var i: u32 = 0u; i < 8u; i = i + 1u) {\n          let byte = (word >> ((i / 2u) * 8u)) & 255u;\n          let nib = (byte >> ((i & 1u) * 4u)) & 15u;\n          acc = acc + xs[wl * 8u + i] * ((f32(nib) - 8.0) * s);\n        }\n      }\n    }\n    workgroupBarrier();\n  }\n  red[t] = acc;\n  workgroupBarrier();\n  if (lane == 0u && col < p.N) {\n    var sum: f32 = 0.0;\n    for (var l: u32 = 0u; l < 16u; l = l + 1u) { sum = sum + red[t + l]; }\n    y[m * p.N + col] = sum;\n  }\n}\n`;\n\n// 預填（M 大）變體（清單 O3，@kernel matmulnbits_pf）：一個工作群組 256 執行緒負責 16 列 × 16 欄的一塊輸出。\n// 執行緒 (row = t/16, cq = t%16) 算一個輸出格。每次沿 K 取 128 個 k（16 個字、4 個區塊）：\n// 輸入 xs 16×128 f32（8 KiB）、權重字 ws 16×16 u32（1 KiB）、縮放值 ss 16×4 f32（256 B），都搬進共用記憶體，共用 9.25 KiB。\n// 同一組權重字被 16 列重複使用（共用記憶體），縮放值每區塊讀一次。派發：[ceil(N/16), ceil(M/16), 1]。\nconst WGSL_MATMULNBITS_PF = `\nstruct P { M: u32, K: u32, N: u32, nb: u32 }\n@group(0) @binding(0) var<storage, read> a: array<f32>;\n@group(0) @binding(1) var<storage, read> bq: array<u32>;\n@group(0) @binding(2) var<storage, read> sc: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\nvar<workgroup> xs: array<f32, 2048>;\nvar<workgroup> ws: array<u32, 256>;\nvar<workgroup> ss: array<f32, 64>;\n// @kernel matmulnbits_pf\n@compute @workgroup_size(256)\nfn main(@builtin(local_invocation_id) lid: vec3<u32>, @builtin(workgroup_id) wid: vec3<u32>) {\n  let t = lid.x;\n  let row = t / 16u;\n  let cq = t % 16u;\n  let m0 = wid.y * 16u;\n  let n0 = wid.x * 16u;\n  let nw = p.nb * 4u;\n  var acc: f32 = 0.0;\n  for (var kt: u32 = 0u; kt < p.K; kt = kt + 128u) {\n    for (var i: u32 = 0u; i < 8u; i = i + 1u) {\n      let idx = t + i * 256u;\n      let gm = m0 + idx / 128u;\n      let gk = kt + idx % 128u;\n      if (gm < p.M && gk < p.K) { xs[idx] = a[gm * p.K + gk]; } else { xs[idx] = 0.0; }\n    }\n    let c = t / 16u;\n    let w = t % 16u;\n    let gc = n0 + c;\n    let gw = kt / 8u + w;\n    if (gc < p.N && gw < nw) { ws[t] = bq[gc * nw + gw]; } else { ws[t] = 0u; }\n    if (t < 64u) {\n      let cc = t / 4u;\n      let b = t % 4u;\n      let gcc = n0 + cc;\n      let gb = kt / 32u + b;\n      if (gcc < p.N && gb < p.nb) { ss[t] = sc[gcc * p.nb + gb]; } else { ss[t] = 0.0; }\n    }\n    workgroupBarrier();\n    for (var q: u32 = 0u; q < 16u; q = q + 1u) {\n      let word = ws[cq * 16u + q];\n      let s = ss[cq * 4u + q / 4u];\n      for (var i: u32 = 0u; i < 8u; i = i + 1u) {\n        let byte = (word >> ((i / 2u) * 8u)) & 255u;\n        let nib = (byte >> ((i & 1u) * 4u)) & 15u;\n        acc = acc + xs[row * 128u + q * 8u + i] * ((f32(nib) - 8.0) * s);\n      }\n    }\n    workgroupBarrier();\n  }\n  if (m0 + row < p.M && n0 + cq < p.N) { y[(m0 + row) * p.N + n0 + cq] = acc; }\n}\n`;\n\n// 變體條件（閾值以下面的實測為準，見 matmulnbits_dec_check.html 的計時）：\n// M ≤ NB_DEC_MAX_M 用 matmulnbits_dec；更大的 M 用 matmulnbits_pf；matmulnbits（逐格）只作保底與對拍。\nconst NB_DEC_MAX_M = 8;\nfunction matmulNBitsVariant(M, opts) {\n  const forced = opts && opts.nbVariant;\n  if (forced === 'matmulnbits' || forced === 'matmulnbits_dec' || forced === 'matmulnbits_pf') return forced;\n  return M <= NB_DEC_MAX_M ? 'matmulnbits_dec' : 'matmulnbits_pf';\n}\n\n// A：Float32Array（M×K），B：Uint8Array（N×nBlocks×16），scales：Float32Array（N×nBlocks）\nasync function matmulNBits(A, M, K, B, scales, N, opts) {\n  const nb = REF.nBlocksOf(K);\n  const variant = matmulNBitsVariant(M, opts);\n  return nn.tryLayers('matmulnbits', opts,\n    async (dev) => {\n      if (B.length % 4 !== 0) throw new Error('matmulNBits：B 的長度必須是 4 的倍數（每格 16 位元組）');\n      const bq = new Uint32Array(B.length / 4);\n      new Uint8Array(bq.buffer).set(B); // 小端序（WebGPU 所在平台皆為小端序）\n      const u = new Uint32Array([M, K, N, nb]);\n      const bufs = [{ data: Float32Array.from(A) }, { data: bq }, { data: Float32Array.from(scales) }, { data: new Float32Array(M * N), out: true }];\n      let outs;\n      if (variant === 'matmulnbits_dec') outs = await nn.runWgsl(dev, WGSL_MATMULNBITS_DEC, bufs, new Uint8Array(u.buffer), [Math.ceil(N / 16), M, 1]);\n      else if (variant === 'matmulnbits_pf') outs = await nn.runWgsl(dev, WGSL_MATMULNBITS_PF, bufs, new Uint8Array(u.buffer), [Math.ceil(N / 16), Math.ceil(M / 16), 1]);\n      else outs = await nn.runWgsl(dev, WGSL_MATMULNBITS, bufs, new Uint8Array(u.buffer), M * Math.ceil(N / 64));\n      return outs[0];\n    },\n    null,\n    () => REF.matmulNBitsRef(A, M, K, B, scales, N));\n}\n\n// 批次版（O6）：A（M×K f32 句柄）、bqH（權重句柄，u32 布局，與 matmulNBits 的 B 相同位元組）、scH（scales 句柄，f32）都在批次裡；\n// 回傳 y（M×N）句柄，整段不回讀。綁定順序 a、bq、sc、y、uniform（dispatchRaw 接在最後）。\nfunction matmulNBitsBatched(b, A, bqH, scH, M, K, N, opts) {\n  const nb = REF.nBlocksOf(K);\n  const variant = matmulNBitsVariant(M, opts);\n  const y = b.alloc(M * N);\n  const u = new Uint32Array([M, K, N, nb]);\n  const uni = new Uint8Array(u.buffer);\n  const binds = [A.buf, bqH.buf, scH.buf, y.buf];\n  if (variant === 'matmulnbits_dec') b.dispatchRaw(WGSL_MATMULNBITS_DEC, binds, uni, [Math.ceil(N / 16), M, 1]);\n  else if (variant === 'matmulnbits_pf') b.dispatchRaw(WGSL_MATMULNBITS_PF, binds, uni, [Math.ceil(N / 16), Math.ceil(M / 16), 1]);\n  else b.dispatchRaw(WGSL_MATMULNBITS, binds, uni, M * Math.ceil(N / 64));\n  return y;\n}\n\nmodule.exports = { WGSL_MATMULNBITS, WGSL_MATMULNBITS_DEC, WGSL_MATMULNBITS_PF, matmulNBits, matmulNBitsVariant, matmulNBitsBatched };\n\n};\nMODS[\"midi_decoder\"] = function (module, exports, require) {\n'use strict';\n// midigenai v5 解碼器（網頁 q4 版，ONNX）的手寫 CPU 參考版：依圖的實際運算（已逐節點確認）。\n// 結構：12 層 pre-norm；每層 attn_norm → q/k/v（MatMulNBits）→ 交錯式 RoPE（偶奇配對，inv_freq 32 個）→ 寫入 KV 快取 → 注意力（scale 1/√64，因果遮罩）\n//       → o_proj → 殘差；ffn_norm → gate、up（MatMulNBits）→ SiLU(gate)·up → down → 殘差。\n// 最後：norm → Slice 取最後一個位置 → lm_head（MatMulNBits，K=768、N=598）→ logits。RMSNorm：x·w / sqrt(mean(x²)+1e-6)。\n// 矩陣乘透過 mm(name, X, T) 注入：CPU 版用 matmulnbits_ref；之後 GPU 版換成 matmulnbits_gpu。\nconst lite = require('./onnx_lite.js');\nconst REF = require('./matmulnbits_ref.js');\n\nconst H = 12, HD = 64, D = H * HD, EPS = 1e-6, SCALE = 0.125, NL = 12;\n\nfunction f32Copy(bytes) { const n = bytes.length / 4, o = new Float32Array(n); new Uint8Array(o.buffer).set(bytes); return o; }\nfunction u8Copy(bytes) { return new Uint8Array(bytes); }\n\n// 讀入模型：回傳 { layers:[{attnNorm, ffnNorm, q, k, v, o, gate, up, down}], norm, lmHead, embed, invFreq }\n// 每個投影是 { name, B, S（scales f32）, K, N }。name 是圖中 MatMulNBits 節點的輸出名（mm 用它找 GPU 快取）。\nfunction loadMidiDecoder(buf) {\n  const m = lite.parseModel(buf);\n  const mm = new Map();\n  for (const n of m.nodes) if (n.op === 'MatMulNBits') {\n    const q = m.inits[n.inputs[1]], s = m.inits[n.inputs[2]];\n    mm.set(n.outputs[0], { name: n.outputs[0], K: n.attrs.K.i, N: n.attrs.N.i, B: u8Copy(lite.tensorBytes(m, n.inputs[1])), S: f32Copy(lite.tensorBytes(m, n.inputs[2])), qDims: q.dims, sDims: s.dims });\n  }\n  const proj = (base) => { const p = mm.get(base + '/MatMul_output_0'); if (!p) throw new Error('找不到投影 ' + base); return p; };\n  const layers = [];\n  for (let i = 0; i < NL; i++) {\n    const sfx = i === 0 ? '' : '_' + i;\n    layers.push({\n      attnNorm: f32Copy(lite.tensorBytes(m, 'm.blocks.' + i + '.attn_norm.weight')),\n      ffnNorm: f32Copy(lite.tensorBytes(m, 'm.blocks.' + i + '.ffn_norm.weight')),\n      q: proj('/q_proj' + sfx), k: proj('/k_proj' + sfx), v: proj('/v_proj' + sfx), o: proj('/o_proj' + sfx),\n      gate: proj('/ffn/gate' + sfx), up: proj('/ffn/up' + sfx), down: proj('/ffn/down' + sfx),\n    });\n  }\n  return {\n    layers,\n    norm: f32Copy(lite.tensorBytes(m, 'm.norm.weight')),\n    lmHead: proj('/lm_head'),\n    embed: f32Copy(lite.tensorBytes(m, 'm.embed.weight')), // [598, 768]\n    invFreq: f32Copy(lite.tensorBytes(m, 'inv_freq')),     // [32]\n    VOCAB: 598,\n    projs: mm,\n  };\n}\n\n// 純 CPU 的矩陣乘（參考）：X 是 T×K（Float32Array），回傳 T×N\nfunction cpuMatmul(p, X, T) { return REF.matmulNBitsRef(X, T, p.K, p.B, p.S, p.N); }\n\n// RMSNorm，逐列：x·w / sqrt(mean(x²)+eps)\nfunction rmsRows(X, w, T) {\n  const out = new Float32Array(T * D);\n  for (let t = 0; t < T; t++) {\n    let s = 0; for (let i = 0; i < D; i++) s += X[t * D + i] * X[t * D + i];\n    const r = 1 / Math.sqrt(s / D + EPS);\n    for (let i = 0; i < D; i++) out[t * D + i] = X[t * D + i] * r * w[i];\n  }\n  return out;\n}\n\n// 交錯式 RoPE：x 是 T×H×HD（每列 768），位置 pos[t]；偶數索引 2i、奇數 2i+1 配對，角度 pos·inv_freq[i]\nfunction rope(X, T, pos, invFreq) {\n  const out = new Float32Array(T * D);\n  for (let t = 0; t < T; t++) for (let h = 0; h < H; h++) {\n    const base = t * D + h * HD;\n    for (let i = 0; i < HD / 2; i++) {\n      const a = Math.cos(pos[t] * invFreq[i]), b = Math.sin(pos[t] * invFreq[i]);\n      const e = X[base + 2 * i], o = X[base + 2 * i + 1];\n      out[base + 2 * i] = e * a - o * b;\n      out[base + 2 * i + 1] = e * b + o * a;\n    }\n  }\n  return out;\n}\n\n// 因果注意力參考：q 為 T×D，Kc/Vc 為 H×Ln×HD；查詢 t（絕對位置 past+t）只看 j ≤ past+t\nfunction attnRef(q, Kc, Vc, T, past, Ln, scale) {\n  const ao = new Float32Array(T * D), sc = new Float64Array(Ln);\n  for (let t = 0; t < T; t++) for (let hh = 0; hh < H; hh++) {\n    const qo = t * D + hh * HD, lim = past + t + 1;\n    let mx = -Infinity;\n    for (let j = 0; j < lim; j++) {\n      let dot = 0; const ko = (hh * Ln + j) * HD;\n      for (let d = 0; d < HD; d++) dot += q[qo + d] * Kc[ko + d];\n      sc[j] = dot * scale; if (sc[j] > mx) mx = sc[j];\n    }\n    let sum = 0; for (let j = 0; j < lim; j++) { sc[j] = Math.exp(sc[j] - mx); sum += sc[j]; }\n    for (let j = 0; j < lim; j++) {\n      const p = sc[j] / sum, vo = (hh * Ln + j) * HD;\n      for (let d = 0; d < HD; d++) ao[t * D + hh * HD + d] += p * Vc[vo + d];\n    }\n  }\n  return ao;\n}\nfunction siluMulRef(g, u) { const y = new Float32Array(g.length); for (let i = 0; i < y.length; i++) y[i] = (g[i] / (1 + Math.exp(-g[i]))) * u[i]; return y; }\n\n// 解一步（或多步預填）。ids：長度 T 的詞元；cache：每層 {K, V, L}（K/V 為 H×L×HD，列優先）；回傳 {logits, cache}\n// mm(p, X, T) → Float32Array(T×N)；預設用 CPU 參考。\n// ops（可選）：{rms(X,w,T,eps), rope(X,T,pos,invFreq), attn(q,Kc,Vc,T,past,Ln,scale), siluMul(g,u)} 的 GPU 版，缺的用 CPU 參考。\nasync function decode(model, ids, cache, mm, ops) {\n  ops = ops || {};\n  const rmsF = (X, w, T) => (ops.rms ? ops.rms(X, w, T, EPS) : rmsRows(X, w, T));\n  const ropeF = async (X, T, pos, inv) => (ops.rope ? ops.rope(X, T, pos, inv) : rope(X, T, pos, inv));\n  const T = ids.length;\n  const mmf = mm || (async (p, X, t) => cpuMatmul(p, X, t));\n  const past = cache ? cache[0].L : 0;\n  const pos = Array.from({ length: T }, (_, t) => past + t);\n  let x = new Float32Array(T * D);\n  for (let t = 0; t < T; t++) x.set(model.embed.subarray(ids[t] * D, (ids[t] + 1) * D), t * D);\n  const nextCache = [];\n  for (let li = 0; li < NL; li++) {\n    const L = model.layers[li];\n    const h = await rmsF(x, L.attnNorm, T);\n    const q = await ropeF(await mmf(L.q, h, T), T, pos, model.invFreq);\n    const k = await ropeF(await mmf(L.k, h, T), T, pos, model.invFreq);\n    const v = await mmf(L.v, h, T);\n    // 寫入快取：新 L = past+T；K/V 布局 H×L×HD\n    const Ln = past + T;\n    const Kc = new Float32Array(H * Ln * HD), Vc = new Float32Array(H * Ln * HD);\n    for (let hh = 0; hh < H; hh++) {\n      if (past > 0) {\n        Kc.set(cache[li].K.subarray(hh * past * HD, (hh + 1) * past * HD), hh * Ln * HD);\n        Vc.set(cache[li].V.subarray(hh * past * HD, (hh + 1) * past * HD), hh * Ln * HD);\n      }\n      for (let t = 0; t < T; t++) for (let d = 0; d < HD; d++) {\n        Kc[(hh * Ln + past + t) * HD + d] = k[t * D + hh * HD + d];\n        Vc[(hh * Ln + past + t) * HD + d] = v[t * D + hh * HD + d];\n      }\n    }\n    nextCache.push({ K: Kc, V: Vc, L: Ln });\n    const ao = ops && ops.attn ? await ops.attn(q, Kc, Vc, T, past, Ln, SCALE) : attnRef(q, Kc, Vc, T, past, Ln, SCALE);\n    const o = await mmf(L.o, ao, T);\n    const x2 = new Float32Array(T * D); for (let i = 0; i < T * D; i++) x2[i] = x[i] + o[i];\n    // FFN\n    const h2 = await rmsF(x2, L.ffnNorm, T);\n    const g = await mmf(L.gate, h2, T);\n    const u = await mmf(L.up, h2, T);\n    const mid = ops.siluMul ? await ops.siluMul(g, u) : siluMulRef(g, u);\n    const dn = await mmf(L.down, mid, T);\n    x = new Float32Array(T * D); for (let i = 0; i < T * D; i++) x[i] = x2[i] + dn[i];\n  }\n  // 最後：取最後一個位置 → norm → lm_head\n  const last = x.subarray((T - 1) * D, T * D);\n  const hf = await rmsF(Float32Array.from(last), model.norm, 1);\n  const logits = await mmf(model.lmHead, hf, 1);\n  return { logits: Float32Array.from(logits), cache: nextCache };\n}\n\nmodule.exports = { loadMidiDecoder, decode, cpuMatmul, rmsRows, rope, attnRef, siluMulRef, H, HD, D, NL, EPS, SCALE };\n\n};\nMODS[\"midi_gpu\"] = function (module, exports, require) {\n'use strict';\n// midigenai 解碼器的非矩陣乘運算（WGSL）：RMSNorm、交錯式 RoPE、因果注意力（含多詞元預填）、SiLU(gate)·up。\n// 介面：makeMidiOps(opts) → { rms, rope, attn, siluMul, tiers }，傳給 midi_decoder.decode 的第 5 個參數；\n// 每個運算失敗或沒有 WebGPU 時由 nn.tryLayers 退 cpu-js（midi_decoder 的同一份參考實作），tiers 記每個運算的層級與原因。\n// 布局與 midi_decoder 一致：x 為 T×768 列主序；K/V 為 H×Ln×64。每個 invocation 一個（列或頭），不做歸約（先求正確）。\nconst nn = require('./nn_ops.js');\nconst MD = require('./midi_decoder.js');\nconst H = 12, HD = 64, D = 768;\n\nconst WGSL_RMS = `\nstruct P { T: u32, D: u32, p0: u32, p1: u32, eps: f32, p2: u32, p3: u32, p4: u32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read> w: array<f32>;\n@group(0) @binding(2) var<storage, read_write> y: array<f32>;\n@group(0) @binding(3) var<uniform> p: P;\n@compute @workgroup_size(1)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let t = gid.x;\n  if (t >= p.T) { return; }\n  var s: f32 = 0.0;\n  for (var i: u32 = 0u; i < p.D; i = i + 1u) { let v = x[t * p.D + i]; s = s + v * v; }\n  let r = 1.0 / sqrt(s / f32(p.D) + p.eps);\n  for (var i: u32 = 0u; i < p.D; i = i + 1u) { y[t * p.D + i] = x[t * p.D + i] * r * w[i]; }\n}\n`;\nconst WGSL_ROPE = `\nstruct P { T: u32, H: u32, HD: u32, p0: u32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read> pos: array<f32>;\n@group(0) @binding(2) var<storage, read> invf: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let half = p.HD / 2u;\n  let n = p.T * p.H * half;\n  let q = gid.x;\n  if (q >= n) { return; }\n  let t = q / (p.H * half);\n  let h = (q / half) % p.H;\n  let i = q % half;\n  let b = t * p.H * p.HD + h * p.HD + 2u * i;\n  let f = pos[t] * invf[i];\n  let c = cos(f);\n  let s = sin(f);\n  let e = x[b];\n  let o = x[b + 1u];\n  y[b] = e * c - o * s;\n  y[b + 1u] = e * s + o * c;\n}\n`;\nconst WGSL_ATTN = `\nstruct P { T: u32, H: u32, HD: u32, Ln: u32, past: u32, p0: u32, p1: u32, p2: u32, scale: f32, p3: u32, p4: u32, p5: u32 }\n@group(0) @binding(0) var<storage, read> q: array<f32>;\n@group(0) @binding(1) var<storage, read> kc: array<f32>;\n@group(0) @binding(2) var<storage, read> vc: array<f32>;\n@group(0) @binding(3) var<storage, read_write> o: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n@compute @workgroup_size(1)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let th = gid.x;\n  if (th >= p.T * p.H) { return; }\n  let t = th / p.H;\n  let h = th % p.H;\n  let D = p.H * p.HD;\n  let qo = t * D + h * p.HD;\n  let lim = p.past + t + 1u;\n  var mx: f32 = -3.0e38;\n  for (var j: u32 = 0u; j < lim; j = j + 1u) {\n    var dot: f32 = 0.0;\n    let ko = (h * p.Ln + j) * p.HD;\n    for (var d: u32 = 0u; d < p.HD; d = d + 1u) { dot = dot + q[qo + d] * kc[ko + d]; }\n    mx = max(mx, dot * p.scale);\n  }\n  var sum: f32 = 0.0;\n  for (var d: u32 = 0u; d < p.HD; d = d + 1u) { o[qo + d] = 0.0; }\n  for (var j: u32 = 0u; j < lim; j = j + 1u) {\n    var dot: f32 = 0.0;\n    let ko = (h * p.Ln + j) * p.HD;\n    for (var d: u32 = 0u; d < p.HD; d = d + 1u) { dot = dot + q[qo + d] * kc[ko + d]; }\n    let e = exp(dot * p.scale - mx);\n    sum = sum + e;\n    for (var d: u32 = 0u; d < p.HD; d = d + 1u) { o[qo + d] = o[qo + d] + e * vc[ko + d]; }\n  }\n  for (var d: u32 = 0u; d < p.HD; d = d + 1u) { o[qo + d] = o[qo + d] / sum; }\n}\n`;\nconst WGSL_SILUMUL = `\nstruct P { n: u32, p0: u32, p1: u32, p2: u32 }\n@group(0) @binding(0) var<storage, read> g: array<f32>;\n@group(0) @binding(1) var<storage, read> u: array<f32>;\n@group(0) @binding(2) var<storage, read_write> y: array<f32>;\n@group(0) @binding(3) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let i = gid.x;\n  if (i >= p.n) { return; }\n  y[i] = (g[i] / (1.0 + exp(-g[i]))) * u[i];\n}\n`;\n\nconst u32f = (a) => { const b = new ArrayBuffer(Math.ceil(a.length * 4 / 16) * 16), v = new DataView(b); a.forEach((x, i) => { if (x && x.f !== undefined) v.setFloat32(i * 4, x.f, true); else v.setUint32(i * 4, x, true); }); return new Uint8Array(b); };\n\nfunction makeMidiOps(opts) {\n  const o = opts || {};\n  const tiers = {};\n  const note = (name, info) => { tiers[name] = info.layer + (info.reason ? '（' + info.reason + '）' : ''); };\n  const wrap = (name, gpuFn, refFn) => async (...args) => {\n    const r = await nn.tryLayers(name, o, (dev) => gpuFn(dev, ...args), null, () => refFn(...args));\n    note(name, r.info); return r.result;\n  };\n  const rms = wrap('midi_rms', async (dev, X, w, T, eps) => (await nn.runWgsl(dev, WGSL_RMS, [{ data: X }, { data: w }, { data: new Float32Array(T * D), out: true }], u32f([T, D, 0, 0, { f: eps }, 0, 0, 0]), Math.ceil(T / 1)))[0],\n    (X, w, T, eps) => { const out = new Float32Array(T * D); for (let t = 0; t < T; t++) { let s = 0; for (let i = 0; i < D; i++) s += X[t * D + i] * X[t * D + i]; const r = 1 / Math.sqrt(s / D + eps); for (let i = 0; i < D; i++) out[t * D + i] = X[t * D + i] * r * w[i]; } return out; });\n  const rope = wrap('midi_rope', async (dev, X, T, pos, invf) => (await nn.runWgsl(dev, WGSL_ROPE, [{ data: X }, { data: Float32Array.from(pos) }, { data: invf }, { data: new Float32Array(T * D), out: true }], u32f([T, H, HD, 0]), Math.ceil(T * H * HD / 2 / 64)))[0],\n    (X, T, pos, invf) => { const out = new Float32Array(T * D); for (let t = 0; t < T; t++) for (let h = 0; h < H; h++) for (let i = 0; i < HD / 2; i++) { const b = t * D + h * HD + 2 * i, a = Math.cos(pos[t] * invf[i]), s = Math.sin(pos[t] * invf[i]); out[b] = X[b] * a - X[b + 1] * s; out[b + 1] = X[b] * s + X[b + 1] * a; } return out; });\n  const attn = wrap('midi_attn', async (dev, q, Kc, Vc, T, past, Ln, scale) => (await nn.runWgsl(dev, WGSL_ATTN, [{ data: q }, { data: Kc }, { data: Vc }, { data: new Float32Array(T * D), out: true }], u32f([T, H, HD, Ln, past, 0, 0, 0, { f: scale }, 0, 0, 0]), T * H))[0],\n    (q, Kc, Vc, T, past, Ln, scale) => MD.attnRef(q, Kc, Vc, T, past, Ln, scale));\n  const siluMul = wrap('midi_silu_mul', async (dev, g, u) => (await nn.runWgsl(dev, WGSL_SILUMUL, [{ data: g }, { data: u }, { data: new Float32Array(g.length), out: true }], u32f([g.length, 0, 0, 0]), Math.ceil(g.length / 64)))[0],\n    (g, u) => { const y = new Float32Array(g.length); for (let i = 0; i < y.length; i++) y[i] = (g[i] / (1 + Math.exp(-g[i]))) * u[i]; return y; });\n  return { rms, rope, attn, siluMul, tiers };\n}\nmodule.exports = { makeMidiOps, WGSL_RMS, WGSL_ROPE, WGSL_ATTN, WGSL_SILUMUL };\n\n};\nMODS[\"midi_session\"] = function (module, exports, require) {\n'use strict';\n// midigenai 解碼器的「假 ORT session」：把 midi_decoder.js（CPU 參考＋WebGPU 的 MatMulNBits 投影）包成 midigen-web.mjs 的 cpuStep 看得懂的 session。\n// 契約（見 renderer/vendor/midigenai/midigen-web.mjs 的 cpuStep）：run({ ids int64[1,T], past_k0, past_v0, … 時間優先 [1,P,H,D] }) → { logits（最後位置，[1,V]）, new_k0, new_v0, … 新的 T 列 [1,T,H,D] }。\n// 內部自己留 KV 快取（decode 用 H×L×HD 佈局），只有在長度對不上（例如另一次生成從 P=0 開始，或外部重放）時才從 feeds 重建。\n// decodeFn(ids:number[], cache|null) → Promise<{ logits:Float32Array, cache:[{K,V,L}] }>：預設是 midi_decoder.decode(model, ids, cache, mm)；測試可注入。\n// 任何錯誤原樣丟出，由呼叫端（floating-assistant.js 的 _midigenEngine，開關 midiGpu）處理退回。\nfunction createSession(o) {\n  const ort = o.ort, H = o.nHeads || 12, D = o.headDim || 64, NL = o.nLayers || 12, ROW = H * D, V = o.vocab || 598, decodeFn = o.decodeFn;\n  const names = []; for (let i = 0; i < NL; i++) for (const c of 'kv') names.push([`past_${c}${i}`, `new_${c}${i}`, i, c]);\n  let