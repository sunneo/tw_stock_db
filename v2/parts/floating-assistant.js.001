ame:"aesenc",format:"",description:"AES 一輪加密"},{name:"aesenclast",format:"",description:"AES 最後一輪加密"},{name:"aesdec",format:"",description:"AES 一輪解密"},{name:"aesdeclast",format:"",description:"AES 最後一輪解密"},{name:"aeskeygenassist",format:"",description:"AES 金鑰擴展輔助"},{name:"aesimc",format:"",description:"AES 反向混合行"},{name:"pclmulqdq",format:"",description:"無進位乘法（GCM、CRC 用）"},{name:"sha1rnds4",format:"",description:"SHA-1 四輪"},{name:"sha256rnds2",format:"",description:"SHA-256 兩輪"},{name:"sha256msg1",format:"",description:"SHA-256 訊息排程 1"},{name:"sha256msg2",format:"",description:"SHA-256 訊息排程 2"},{name:"rdrand",format:"",description:"取硬體亂數"},{name:"rdseed",format:"",description:"取硬體種子亂數"}],concurrency:[{name:"xacquire",format:"",description:"硬體鎖省略（舊 TSX）"},{name:"xrelease",format:"",description:"硬體鎖省略釋放（舊 TSX）"},{name:"xbegin",format:"",description:"開始硬體交易（TSX）"},{name:"xend",format:"",description:"提交硬體交易（TSX）"},{name:"xabort",format:"",description:"中止硬體交易（TSX）"},{name:"monitor",format:"",description:"設定監看位址（配合 mwait）"},{name:"mwait",format:"",description:"等待監看位址被寫入"},{name:"umonitor",format:"",description:"使用者態監看位址"},{name:"umwait",format:"",description:"使用者態等待"},{name:"tpause",format:"",description:"計時暫停"}]},arm:{process_exec:[{name:"svc",format:"SVC #imm",description:"Supervisor Call - traps to EL1/kernel (AArch32's syscall instruction; also called SWI)."},{name:"swi",format:"SWI #imm",description:"Software Interrupt - pre-UAL name for SVC."}],low_level_hardware:[{name:"mcr",format:"MCR coproc, opc1, Rt, CRn, CRm, opc2",description:"Moves a register to a coprocessor register (e.g. CP15 system control)."},{name:"mrc",format:"MRC coproc, opc1, Rt, CRn, CRm, opc2",description:"Moves a coprocessor register to a general-purpose register."},{name:"mrrc",format:"MRRC coproc, opc1, Rt, Rt2, CRm",description:"Moves a 64-bit coprocessor register pair to two GP registers."},{name:"mcrr",format:"MCRR coproc, opc1, Rt, Rt2, CRm",description:"Moves two GP registers to a 64-bit coprocessor register pair."},{name:"mrs",format:"MRS Rd, <special_reg>",description:"Reads a special/status register (e.g. CPSR) into a GP register."},{name:"msr",format:"MSR <special_reg>, Rn",description:"Writes a GP register into a special/status register."},{name:"wfi",format:"WFI",description:"Wait For Interrupt - suspends execution until an interrupt/event."},{name:"wfe",format:"WFE",description:"Wait For Event - suspends execution until an event signal."},{name:"sev",format:"SEV",description:"Send Event - wakes up cores waiting via WFE."},{name:"dsb",format:"DSB <option>",description:"Data Synchronization Barrier - blocks until prior memory accesses complete."},{name:"dmb",format:"DMB <option>",description:"Data Memory Barrier - orders memory accesses across the barrier."},{name:"isb",format:"ISB <option>",description:"Instruction Synchronization Barrier - flushes the pipeline."},{name:"cps",format:"CPS #mode",description:"Change Processor State - masks/unmasks interrupts or changes mode (privileged)."},{name:"setend",format:"SETEND BE/LE",description:"Sets the endianness for data accesses."}],memory_management:[{name:"ldr",format:"LDR Rt, [Rn, #imm]",description:"Loads a 32-bit word from memory into a register."},{name:"str",format:"STR Rt, [Rn, #imm]",description:"Stores a 32-bit register value to memory."},{name:"ldm",format:"LDM Rn, {reglist}",description:"Loads multiple registers from consecutive memory."},{name:"stm",format:"STM Rn, {reglist}",description:"Stores multiple registers to consecutive memory."},{name:"ldrb",format:"LDRB Rt, [Rn, #imm]",description:"Loads an unsigned byte from memory."},{name:"strb",format:"STRB Rt, [Rn, #imm]",description:"Stores a byte to memory."},{name:"ldrh",format:"LDRH Rt, [Rn, #imm]",description:"Loads an unsigned halfword from memory."},{name:"strh",format:"STRH Rt, [Rn, #imm]",description:"Stores a halfword to memory."},{name:"ldrd",format:"LDRD Rt, Rt2, [Rn, #imm]",description:"Loads a register pair (64 bits) from memory."},{name:"strd",format:"STRD Rt, Rt2, [Rn, #imm]",description:"Stores a register pair (64 bits) to memory."},{name:"push",format:"PUSH {reglist}",description:"Pushes registers onto the stack (alias for STMDB sp!)."},{name:"pop",format:"POP {reglist}",description:"Pops registers off the stack (alias for LDMIA sp!)."},{name:"ldrsb",format:"LDRSB Rt, [Rn]",description:"Loads a byte and sign-extends it."},{name:"ldrsh",format:"LDRSH Rt, [Rn]",description:"Loads a halfword and sign-extends it."},{name:"ldrex",format:"LDREX Rt, [Rn]",description:"Load-exclusive - first half of an atomic RMW sequence."},{name:"strex",format:"STREX Rd, Rt, [Rn]",description:"Store-exclusive - second half of an atomic RMW sequence."},{name:"swp",format:"SWP Rt, Rt2, [Rn]",description:"Atomically swaps a register with memory (deprecated, pre-LDREX/STREX)."}],control_flow:[{name:"b",format:"B target",description:"Unconditional branch."},{name:"bl",format:"BL target",description:"Branch with link - saves return address in LR (function call)."},{name:"bx",format:"BX Rm",description:"Branch and exchange instruction set (ARM/Thumb) to address in Rm."},{name:"blx",format:"BLX target/Rm",description:"Branch with link and exchange instruction set."},{name:"cbz",format:"CBZ Rn, target",description:"Compare and branch if Rn is zero (Thumb-only)."},{name:"cbnz",format:"CBNZ Rn, target",description:"Compare and branch if Rn is nonzero (Thumb-only)."},{name:"beq",format:"BEQ target",description:"Branch if equal (Z=1)."},{name:"bne",format:"BNE target",description:"Branch if not equal (Z=0)."},{name:"bgt",format:"BGT target",description:"Branch if greater than (signed)."},{name:"blt",format:"BLT target",description:"Branch if less than (signed)."},{name:"bge",format:"BGE target",description:"Branch if greater or equal (signed)."},{name:"ble",format:"BLE target",description:"Branch if less or equal (signed)."},{name:"bls",format:"BLS target",description:"Branch if lower or same (unsigned <=)."},{name:"bhi",format:"BHI target",description:"Branch if higher (unsigned >)."},{name:"bpl",format:"BPL target",description:"Branch if plus (N=0)."},{name:"bmi",format:"BMI target",description:"Branch if minus/negative (N=1)."},{name:"bvs",format:"BVS target",description:"Branch if overflow set."},{name:"bvc",format:"BVC target",description:"Branch if no overflow."},{name:"bcs",format:"BCS target",description:"Branch if carry set (alias BHS, unsigned >=)."},{name:"bcc",format:"BCC target",description:"Branch if carry clear (alias BLO, unsigned <)."}],simd_vector:[{name:"vadd.i32",format:"VADD.I32 Dd, Dn, Dm",description:"NEON: add packed 32-bit integers."},{name:"vsub.i32",format:"VSUB.I32 Dd, Dn, Dm",description:"NEON: subtract packed 32-bit integers."},{name:"vmul.f32",format:"VMUL.F32 Dd, Dn, Dm",description:"NEON: multiply packed single-precision floats."},{name:"vld1.32",format:"VLD1.32 {Dd}, [Rn]",description:"NEON: load packed 32-bit elements from memory."},{name:"vst1.32",format:"VST1.32 {Dd}, [Rn]",description:"NEON: store packed 32-bit elements to memory."},{name:"vmov",format:"VMOV Dd, Dm",description:"NEON/VFP: move between vector/float registers (or GP<->float)."},{name:"vdup.32",format:"VDUP.32 Qd, Dm[x]",description:"NEON: duplicate one lane across all lanes of a vector register."},{name:"vmla.f32",format:"VMLA.F32 Dd, Dn, Dm",description:"NEON: multiply-accumulate packed single-precision floats."},{name:"vand",format:"VAND Dd, Dn, Dm",description:"NEON: bitwise AND of two vector registers."},{name:"veor",format:"VEOR Dd, Dn, Dm",description:"NEON: bitwise XOR of two vector registers."},{name:"vceq",format:"VCEQ Dd, Dn, Dm",description:"NEON: per-lane compare-equal, result is all-1s/all-0s mask."},{name:"vmax",format:"VMAX Dd, Dn, Dm",description:"NEON: per-lane maximum."}],arithmetic_logic:[{name:"add",format:"ADD Rd, Rn, Op2",description:"Rd = Rn + Op2."},{name:"adc",format:"ADC Rd, Rn, Op2",description:"Rd = Rn + Op2 + carry."},{name:"sub",format:"SUB Rd, Rn, Op2",description:"Rd = Rn - Op2."},{name:"sbc",format:"SBC Rd, Rn, Op2",description:"Rd = Rn - Op2 - NOT(carry)."},{name:"rsb",format:"RSB Rd, Rn, Op2",description:"Rd = Op2 - Rn (reverse subtract)."},{name:"mul",format:"MUL Rd, Rm, Rs",description:"Rd = Rm * Rs (low 32 bits)."},{name:"mla",format:"MLA Rd, Rm, Rs, Rn",description:"Rd = (Rm * Rs) + Rn (multiply-accumulate)."},{name:"umull",format:"UMULL RdLo, RdHi, Rm, Rs",description:"64-bit unsigned multiply: RdHi:RdLo = Rm * Rs."},{name:"smull",format:"SMULL RdLo, RdHi, Rm, Rs",description:"64-bit signed multiply: RdHi:RdLo = Rm * Rs."},{name:"and",format:"AND Rd, Rn, Op2",description:"Rd = Rn AND Op2 (bitwise)."},{name:"orr",format:"ORR Rd, Rn, Op2",description:"Rd = Rn OR Op2 (bitwise)."},{name:"eor",format:"EOR Rd, Rn, Op2",description:"Rd = Rn XOR Op2 (bitwise)."},{name:"bic",format:"BIC Rd, Rn, Op2",description:"Rd = Rn AND NOT(Op2) (bit clear)."},{name:"mvn",format:"MVN Rd, Op2",description:"Rd = NOT(Op2) (bitwise complement/move-negate)."},{name:"lsl",format:"LSL Rd, Rm, #imm",description:"Logical shift left."},{name:"lsr",format:"LSR Rd, Rm, #imm",description:"Logical shift right (zero-fill)."},{name:"asr",format:"ASR Rd, Rm, #imm",description:"Arithmetic shift right (sign-extending)."},{name:"ror",format:"ROR Rd, Rm, #imm",description:"Rotate right."},{name:"cmp",format:"CMP Rn, Op2",description:"Sets flags from Rn - Op2 (result discarded)."},{name:"cmn",format:"CMN Rn, Op2",description:"Sets flags from Rn + Op2 (result discarded)."},{name:"tst",format:"TST Rn, Op2",description:"Sets flags from Rn AND Op2 (result discarded)."},{name:"teq",format:"TEQ Rn, Op2",description:"Sets flags from Rn XOR Op2 (result discarded)."},{name:"clz",format:"CLZ Rd, Rm",description:"Counts leading zero bits in Rm."}]},aarch64:{process_exec:[{name:"svc",format:"SVC #imm",description:"Supervisor Call - AArch64's syscall trap to EL1 (Linux syscall entry)."},{name:"hvc",format:"HVC #imm",description:"Hypervisor Call - traps to EL2."},{name:"smc",format:"SMC #imm",description:"Secure Monitor Call - traps to EL3 (TrustZone)."}],low_level_hardware:[{name:"mrs",format:"MRS Xt, <system_reg>",description:"Reads a system register into a general-purpose register."},{name:"msr",format:"MSR <system_reg>, Xt",description:"Writes a general-purpose register into a system register."},{name:"wfi",format:"WFI",description:"Wait For Interrupt - suspends execution."},{name:"wfe",format:"WFE",description:"Wait For Event - suspends execution until an event."},{name:"sev",format:"SEV",description:"Send Event to all cores waiting via WFE."},{name:"sevl",format:"SEVL",description:"Send Event Local - sets the local event register."},{name:"dsb",format:"DSB <option>",description:"Data Synchronization Barrier."},{name:"dmb",format:"DMB <option>",description:"Data Memory Barrier."},{name:"isb",format:"ISB <option>",description:"Instruction Synchronization Barrier."},{name:"ic",format:"IC <op>, Xt",description:"Instruction Cache maintenance operation."},{name:"tlbi",format:"TLBI <op>, Xt",description:"TLB Invalidate operation."}],memory_management:[{name:"ldr",format:"LDR Xt, [Xn, #imm]",description:"Loads a register from memory."},{name:"str",format:"STR Xt, [Xn, #imm]",description:"Stores a register to memory."},{name:"ldp",format:"LDP Xt1, Xt2, [Xn, #imm]",description:"Loads a pair of registers from memory."},{name:"stp",format:"STP Xt1, Xt2, [Xn, #imm]",description:"Stores a pair of registers to memory."},{name:"ldrb",format:"LDRB Wt, [Xn, #imm]",description:"Loads an unsigned byte from memory."},{name:"strb",format:"STRB Wt, [Xn, #imm]",description:"Stores a byte to memory."},{name:"ldrh",format:"LDRH Wt, [Xn, #imm]",description:"Loads an unsigned halfword from memory."},{name:"strh",format:"STRH Wt, [Xn, #imm]",description:"Stores a halfword to memory."},{name:"ldur",format:"LDUR Xt, [Xn, #simm]",description:"Loads a register using an unscaled immediate offset."},{name:"stur",format:"STUR Xt, [Xn, #simm]",description:"Stores a register using an unscaled immediate offset."},{name:"ldxr",format:"LDXR Xt, [Xn]",description:"Load-exclusive - first half of an atomic RMW sequence."},{name:"stxr",format:"STXR Ws, Xt, [Xn]",description:"Store-exclusive - second half of an atomic RMW sequence."},{name:"ldar",format:"LDAR Xt, [Xn]",description:"Load-acquire - an atomic load with acquire ordering semantics."},{name:"stlr",format:"STLR Xt, [Xn]",description:"Store-release - an atomic store with release ordering semantics."},{name:"cas",format:"CAS Xs, Xt, [Xn]",description:"Compare-And-Swap (ARMv8.1 atomics) - single-instruction atomic RMW."},{name:"ldadd",format:"LDADD Xs, Xt, [Xn]",description:"Atomic add to memory, returns the old value (ARMv8.1 atomics)."}],control_flow:[{name:"b",format:"B target",description:"Unconditional branch."},{name:"bl",format:"BL target",description:"Branch with link (function call), saves return address in X30/LR."},{name:"br",format:"BR Xn",description:"Branch to address in register Xn."},{name:"blr",format:"BLR Xn",description:"Branch with link to address in register Xn."},{name:"ret",format:"RET {Xn}",description:"Return - branches to X30 (or Xn if given)."},{name:"cbz",format:"CBZ Xt, target",description:"Compare and branch if Xt is zero."},{name:"cbnz",format:"CBNZ Xt, target",description:"Compare and branch if Xt is nonzero."},{name:"beq",format:"B.EQ target",description:"Branch if equal (Z=1)."},{name:"bne",format:"B.NE target",description:"Branch if not equal (Z=0)."},{name:"tbz",format:"TBZ Xt, #bit, target",description:"Test bit and branch if zero."},{name:"tbnz",format:"TBNZ Xt, #bit, target",description:"Test bit and branch if nonzero."},{name:"b.gt",format:"B.GT target",description:"Branch if greater than (signed)."},{name:"b.lt",format:"B.LT target",description:"Branch if less than (signed)."},{name:"b.ge",format:"B.GE target",description:"Branch if greater or equal (signed)."},{name:"b.le",format:"B.LE target",description:"Branch if less or equal (signed)."},{name:"b.hi",format:"B.HI target",description:"Branch if higher (unsigned >)."},{name:"b.lo",format:"B.LO target",description:"Branch if lower (unsigned <)."},{name:"csel",format:"CSEL Xd, Xn, Xm, cond",description:"Conditional select: Xd = cond ? Xn : Xm (branchless)."},{name:"cset",format:"CSET Xd, cond",description:"Sets Xd to 1 if cond is true, else 0 (branchless)."}],simd_vector:[{name:"fadd",format:"FADD Vd, Vn, Vm",description:"Adds packed or scalar floating-point values."},{name:"fmul",format:"FMUL Vd, Vn, Vm",description:"Multiplies packed or scalar floating-point values."},{name:"fsub",format:"FSUB Vd, Vn, Vm",description:"Subtracts packed or scalar floating-point values."},{name:"fdiv",format:"FDIV Vd, Vn, Vm",description:"Divides packed or scalar floating-point values."},{name:"ld1",format:"LD1 {Vt.T}, [Xn]",description:"NEON: loads one or more vector registers from memory."},{name:"st1",format:"ST1 {Vt.T}, [Xn]",description:"NEON: stores one or more vector registers to memory."},{name:"dup",format:"DUP Vd.T, Vn.T[x]",description:"NEON: duplicates one lane across an entire vector register."},{name:"fmla",format:"FMLA Vd, Vn, Vm",description:"Floating-point fused multiply-accumulate."},{name:"fmov",format:"FMOV Vd, Vn",description:"Moves a value between floating-point/vector registers (or GP<->float)."},{name:"fcmp",format:"FCMP Sn, Sm",description:"Compares two floating-point values, sets flags."},{name:"fneg",format:"FNEG Vd, Vn",description:"Negates a floating-point value."},{name:"fabs",format:"FABS Vd, Vn",description:"Absolute value of a floating-point value."},{name:"fmax",format:"FMAX Vd, Vn, Vm",description:"Per-lane floating-point maximum."},{name:"fmin",format:"FMIN Vd, Vn, Vm",description:"Per-lane floating-point minimum."}],arithmetic_logic:[{name:"add",format:"ADD Xd, Xn, Xm",description:"Xd = Xn + Xm."},{name:"adds",format:"ADDS Xd, Xn, Xm",description:"Xd = Xn + Xm, updates NZCV flags."},{name:"sub",format:"SUB Xd, Xn, Xm",description:"Xd = Xn - Xm."},{name:"subs",format:"SUBS Xd, Xn, Xm",description:"Xd = Xn - Xm, updates NZCV flags (also CMP's underlying op)."},{name:"mul",format:"MUL Xd, Xn, Xm",description:"Xd = Xn * Xm (low bits)."},{name:"madd",format:"MADD Xd, Xn, Xm, Xa",description:"Xd = Xa + (Xn * Xm) (multiply-add)."},{name:"msub",format:"MSUB Xd, Xn, Xm, Xa",description:"Xd = Xa - (Xn * Xm) (multiply-subtract)."},{name:"sdiv",format:"SDIV Xd, Xn, Xm",description:"Signed division: Xd = Xn / Xm."},{name:"udiv",format:"UDIV Xd, Xn, Xm",description:"Unsigned division: Xd = Xn / Xm."},{name:"and",format:"AND Xd, Xn, Xm",description:"Xd = Xn AND Xm."},{name:"orr",format:"ORR Xd, Xn, Xm",description:"Xd = Xn OR Xm."},{name:"eor",format:"EOR Xd, Xn, Xm",description:"Xd = Xn XOR Xm."},{name:"bic",format:"BIC Xd, Xn, Xm",description:"Xd = Xn AND NOT(Xm)."},{name:"mvn",format:"MVN Xd, Xm",description:"Xd = NOT(Xm)."},{name:"lsl",format:"LSL Xd, Xn, #imm",description:"Logical shift left."},{name:"lsr",format:"LSR Xd, Xn, #imm",description:"Logical shift right."},{name:"asr",format:"ASR Xd, Xn, #imm",description:"Arithmetic shift right."},{name:"cmp",format:"CMP Xn, Xm",description:"Sets flags from Xn - Xm (alias of SUBS with discarded result)."},{name:"cmn",format:"CMN Xn, Xm",description:"Sets flags from Xn + Xm (alias of ADDS with discarded result)."},{name:"tst",format:"TST Xn, Xm",description:"Sets flags from Xn AND Xm (alias of ANDS with discarded result)."},{name:"neg",format:"NEG Xd, Xm",description:"Xd = -Xm (two's complement negate)."},{name:"clz",format:"CLZ Xd, Xn",description:"Counts leading zero bits."},{name:"rbit",format:"RBIT Xd, Xn",description:"Reverses the bit order."},{name:"rev",format:"REV Xd, Xn",description:"Reverses byte order (endianness swap)."}]},power:{process_exec:[{name:"sc",format:"SC",description:"System Call - traps to the kernel (PowerPC's syscall instruction)."}],low_level_hardware:[{name:"mtspr",format:"MTSPR spr, Rs",description:"Moves 