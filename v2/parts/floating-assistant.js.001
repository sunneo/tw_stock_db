y" | "xy" (rows draw only the left / top half), ops (<= 40, in order after the rows): {op: "rect", x, y, w, h, c, fill?} {op: "line", x1, y1, x2, y2, c} {op: "circle", cx, cy, r, c, fill?} {op: "ellipse", cx, cy, rx, ry, c, fill?} {op: "fill", x, y, c} {op: "dot", x, y, c} {op: "erase", x, y, w, h}, size [w, h] (4..64 each side; default from rows), shade true (automatic light on the top-left edges and shadow on the bottom-right: the pixel-art look), outline true or "#rrggbb" (1-pixel outline). Or give template (heart, sword, potion, coin, key, flower, mushroom, gem, chest) with recolor {"r": "#3366ff"} (palette key -> colour). Returns an "@imgN" handle: use it as a collage item { src: "@imgN", tx, ty, tw, pixel: true } (tw = width in map tiles; a tile is 16 pixels wide). If it reports errors, fix exactly the fields it names and call again.',r({palette:{type:"object"},rows:{type:"array",items:{type:"string"}},mirror:{type:"string",enum:["x","y","xy"]},ops:{type:"array",items:{type:"object"}},size:{type:"array",items:{type:"integer"}},shade:{type:"boolean"},outline:{description:"true or a colour #rrggbb"},template:{type:"string"},recolor:{type:"object"},name:{type:"string"}}),async function(e){return this._deckMakePixelArt(e||{})}),n("import_uploaded_image",'Bring a picture the user attached (or uploaded earlier) into the task: "file_id" = the id in the task text ("[附件：name（file_id=…）]") or from list_uploaded_files. Returns its "@imgN" handle for an image visual. Call it once per attached picture, in the order the user attached them.',r({file_id:{type:"string"}},["file_id"]),async function(e){const t=String(e.file_id||"").replace(/^client-file\//,"").trim(),n=t?await this.fileCache.get(t):null;return n&&n.blob?/^image\//.test(n.mimeType||n.blob.type||"")?this._deckImportImageBlob(n.blob.type?n.blob:new Blob([n.blob],{type:n.mimeType}),"upload: "+(n.filename||t),"import_uploaded_image"):{ok:!1,error:"that file is not a picture ("+(n.mimeType||"unknown type")+"): for a 