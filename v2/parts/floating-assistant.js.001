repo:"HuggingFaceTB/SmolLM2-360M-Instruct",tasks:["chat","rag"],toolCalling:null,contextTokens:2048,lang:"英文為主",license:"Apache-2.0",dtype:{gpu:"q4f16",cpu:"q8"},bytes:{gpu:260*e,cpu:348*e},gpuNeedsF16:!0,verified:!1,notes:"很小，能閒聊與依參考資料回答；中文弱、沒有工具呼叫格式。"},{id:"granite-4.0-350m",label:"Granite 4.0 350M（小型工具呼叫專長，未驗證）",task:"text-generation",arch:"causal-lm",repo:"onnx-community/granite-4.0-350m-ONNX-web",tasks:["chat","rag","tools"],toolCalling:"hermes",contextTokens:4096,lang:"英文為主（多語）",license:"Apache-2.0",dtype:{gpu:"q4f16",cpu:"q4"},bytes:{gpu:336*e,cpu:551*e},gpuNeedsF16:!0,verified:!1,notes:"IBM 的小模型，官方標榜工具呼叫與指令遵循；很小，適合當「工具階段」的模型，再交給別的模型寫回答。還沒實測。"},{id:"granite-4.0-1b",label:"Granite 4.0 1B（工具呼叫專長，較大）",task:"text-generation",arch:"causal-lm",repo:"onnx-community/granite-4.0-1b-ONNX-web",tasks:["chat","rag","tools"],toolCalling:"hermes",contextTokens:8192,lang:"英文為主（多語）",license:"Apache-2.0",dtype:{gpu:"q4f16",cpu:"q4"},bytes:{gpu:1192*e,cpu:1702*e},gpuNeedsF16:!0,verified:!1,notes:"IBM 的 1B 模型。redmine 那邊實測工具呼叫評分通過（本專案還沒在這邊測）；比 350M 穩，適合當工具階段模型。"},{id:"qwen2.5-1.5b",label:"Qwen2.5 1.5B（較大，建議用 GPU）",task:"text-generation",arch:"causal-lm",repo:"onnx-community/Qwen2.5-1.5B-Instruct",tasks:["chat","rag","tools"],toolCalling:"hermes",contextTokens:8192,lang:"中英文",license:"Apache-2.0",dtype:{gpu:"q4f16",cpu:"q8"},bytes:{gpu:1165*e,cpu:1506*e},gpuNeedsF16:!0,verified:!1,notes:"約 1.5B 參數；答得明顯比 0.5B 好，工具呼叫也更穩；CPU 上很慢。"},{id:"qwen3-1.7b",label:"Qwen3 1.7B（最大：約 1.62 GiB、速度約 0.6B 的 1/2.5～1/3、尚不支援 LoRA）",task:"text-generation",arch:"causal-lm",repo:"onnx-community/Qwen3-1.7B-ONNX",tasks:["chat","rag","tools"],toolCalling:"hermes",contextTokens:8192,lang:"中英文",license:"Apache-2.0",dtype:{gpu:"q4f16",cpu:"q8"},bytes:{gpu:1360*e,cpu:1662*e},gpuNeedsF16:!0,verified:!1,noLora:!0,notes:"約 1.7B 參數；這份清單裡品質最好，下載與記憶體需求也最大。桌面版：原生執行器（CPU，含 LoRA）只支援 0.6B，選這個會走 WebGPU 整段解碼（需先在設定的「GPU 記憶體上限」旁下載 q8 檔；受上限約束，放不下會分層串流）或 transformers.js 的 WebGPU／WASM；尚不支援 LoRA。"},{id:"depth-anything-v2-small",gpuNeedsF16:!0,label:"Depth Anything V2 Small（深度估計，/image-to-3d 用）",task:"depth-estimation",arch:"depth",repo:"onnx-community/depth-anything-v2-small",tasks:[],lang:"無（輸出深度圖）",license:"Apache-2.0",dtype:{gpu:"fp16",cpu:"fp32"},bytes:{gpu:50*e,cpu:99*e},verified:!1,notes:"單張圖估計相對深度（越亮越近），約 25M 參數。給 /image-to-3d 當基礎層。CPU 用 fp32（約 99MB）：2026-10-30 在瀏覽器實測 int8 版在 CPU（WebAssembly）跑不起來（缺 ConvInteger），fp32 在 CPU 實測成功（512×384 約 8～10 秒）；GPU 的 fp16 版還沒驗證。"},{id:"slimsam-77-uniform",gpuNeedsF16:!0,label:"SlimSAM 77（分割，/image-to-3d --segment 用）",task:"segmentation",arch:"sam",repo:"Xenova/slimsam-77-uniform",tasks:[],lang:"無（輸出物件遮罩）",license:"Apache-2.0",dtype:{gpu:"fp16",cpu:"q8"},bytes:{gpu:22*e,cpu:16*e},verified:!1,notes:"Segment Anything 的瘦身版（約 1000 萬參數）：在圖上撒一組點、每個點取最好的遮罩、去掉重複與太小的，當作「圖裡有哪些物件」。2026-10-30 在瀏覽器（CPU、q8）實測：載入約 6 秒、影像編碼約 16 秒、4×4 個點共約 28 秒，合成圖（蘋果＋盒子＋地面）分出 3 個物件；背景大遮罩（占圖 70% 以上）要丟掉，所以預設最大面積比例是 0.5。GPU 的 fp16 版還沒驗證。"},{id:"movenet-thunder",label:"MoveNet Thunder（姿態，/image-to-3d 找手臂用）",task:"pose-estimation",arch:"pose",repo:"Xenova/movenet-singlepose-thunder",tasks:[],lang:"無（輸出 17 個關鍵點）",license:"Apache-2.0",dtype:{gpu:"fp32",cpu:"fp32"},bytes:{gpu:25*e,cpu:25*e},verified:!0,verifiedOn:"cpu",measured:"瀏覽器 CPU：載入約 5 秒（含下載）、推論約 0.3 秒；兩張小孩的半身照上，頭部很準、肩與手臂大致對，被物品擋住的一側會偏（信心值低的點程式會丟掉）",notes:"單人姿態：鼻、眼、耳、肩、肘、腕、髖、膝、踝，沒有手指。給 /image-to-3d 把手臂分成各自的部分。只看單人、取最明顯的一個。授權欄位寫 Apache-2.0（第三方轉檔頁面），Kaggle 原頁的授權欄位未查證。"},{id:"whisper-base",label:"Whisper base（語音轉文字，transcribe_media 用）",task:"asr",arch:"whisper",repo:"onnx-community/whisper-base",tasks:[],bytes:{gpu:80*e,cpu:80*e},managedOnly:!0,verified:!0,notes:"影音轉逐字稿用，跟圖像轉文字共用快取與裝置設定。"}],n=e=>t.find(t=>t.id===e)||null,r=()=>t.filter(e=>"image-to-text"===e.task),a=()=>t.filter(e=>"text-generation"===e.task),i="florence-2-base-ft",s="qwen3-0.6b";function o(e,t,n,r){const a="cpu"!==t;return n&&!1===r&&e&&e.gpuNeedsF16?e.gpuOnly?{order:[],reason:"這個模型的 GPU 版本需要 fp16 著色器（shader-f16），這張顯示卡不支援，而且它不能用 CPU",error:"gpu_required"}:{order:["wasm"]