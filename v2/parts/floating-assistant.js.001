e:"data",meaning:"the literal text content of the node"}],return:{meaning:"the newly created, unattached Text node"}},addEventListener:{summary:"Registers a function to be called when the event fires on the target.",parameters:[{name:"type",meaning:'event name such as "click"'},{name:"listener",meaning:"the function"},{name:"options",meaning:"capture / once / passive"}],return:{meaning:"undefined"}},removeEventListener:{summary:"Unregisters a previously-registered event listener from {receiver} (must be the SAME function reference used to add it).",parameters:[{name:"type",meaning:"the event name it was registered for"},{name:"listener",meaning:"the exact callback reference originally passed to addEventListener"},{name:"options",meaning:"must match the options used when adding it, or removal silently fails"}]},dispatchEvent:{summary:"Manually fires an event on {receiver}, synchronously running every matching registered listener.",parameters:[{name:"event",meaning:"the Event (or CustomEvent) instance to dispatch"}]},appendChild:{summary:"Attaches a node as the last child of {receiver}, moving it out of its previous parent if it had one.",parameters:[{name:"child",meaning:"the node to attach"}],return:{meaning:"the appended node itself"}},removeChild:{summary:"Detaches a direct child node from {receiver}.",parameters:[{name:"child",meaning:"the direct child node to remove"}],return:{meaning:"the removed node (now detached)"}},setAttribute:{summary:"Sets an HTML attribute on {receiver} (creating it if absent, overwriting its value if present).",parameters:[{name:"name",meaning:"the attribute name"},{name:"value",meaning:"the attribute's new value (always coerced to a string)"}]},getAttribute:{summary:"Reads the current value of an HTML attribute on {receiver}.",parameters:[{name:"name",meaning:"the attribute name to read"}],return:{meaning:"the attribute's string value, or null if the attribute isn't set",rules:[{when:{op:"falsy"},meaning:"the attribute isn't set on this element"},{when:{op:"truthy"},meaning:"the attribute is set, with this value"}]}},removeAttribute:{summary:"Removes an HTML attribute from {receiver} entirely.",parameters:[{name:"name",meaning:"the attribute name to remove"}]},closest:{summary:"Walks up from {receiver} through its own ancestors (starting with itself) for the nearest one matching a CSS selector.",parameters:[{name:"selector",meaning:"a CSS selector to match an ancestor (or this element itself) against"}],return:{meaning:"the nearest matching element (possibly this one itself), or null if none of its ancestors match",rules:[{when:{op:"falsy"},meaning:"neither this element nor any ancestor matches that selector"},{when:{op:"truthy"},meaning:"a matching ancestor (or this element itself) was found"}]}},matches:{summary:"Tests whether {receiver} itself matches a CSS selector, without touching the DOM tree at all.",parameters:[{name:"selector",meaning:"a CSS selector to test this element against"}],return:{meaning:"true if this element matches the selector, false otherwise"}},"localStorage.getItem":{summary:"Reads a value from the browser's persistent localStorage (survives page reloads/browser restarts, scoped to this origin).",parameters:[{name:"key",meaning:"the storage key to read"}],return:{meaning:"the stored string value, or null if that key was never set",rules:[{when:{op:"falsy"},meaning:"no value is stored under that key"},{when:{op:"truthy"},meaning:"a value was found under that key"}]}},"localStorage.setItem":{summary:"Stores a string under a key in the browser's localStorage (synchronous, persists across sessions, ~5 MB).",parameters:[{name:"key",meaning:"the key"},{name:"value",meaning:"the string value"}],return:{meaning:"undefined; throws QuotaExceededError when full"}},"localStorage.removeItem":{summary:"Deletes one key from the browser's persistent localStorage.",parameters:[{name:"key",meaning:"the storage key to delete"}]},fetch:{summary:"Starts an HTTP request and resolves when the response HEADERS arrive — it does NOT reject on 4xx/5xx (check response.ok).",parameters:[{name:"input",meaning:"URL or Request"},{name:"init",meaning:"{method, headers, body, signal}"}],return:{meaning:"a Promise<Response>; rejects only on network failure/abort"}},"JSON.parse":{summary:"Parses a JSON string into a JavaScript value.",parameters:[{name:"text",meaning:"the JSON text"},{name:"reviver",meaning:"optional transform function"}],return:{meaning:"the parsed value; throws SyntaxError on malformed JSON"}},"JSON.stringify":{summary:"Converts a value to a JSON string (drops functions/undefined, throws on circular references and BigInt).",parameters:[{name:"value",meaning:"the value"},{name:"replacer",meaning:"optional filter"},{name:"space",meaning:"optional indent"}],return:{meaning:"the JSON string (undefined for unsupported top-level values)"}},push:{summary:"Appends one or more elements to the end of {receiver}, mutating it in place.",parameters:[{name:"items",meaning:"the element(s) to append, in order"}],return:{meaning:"the array's new length after appending"}},pop:{summary:"Removes and returns the last element of {receiver}, mutating it in place.",parameters:[],return:{meaning:"the removed last element, or undefined if the array was already empty"}},shift:{summary:"Removes and returns the first element of {receiver}, mutating it in place (every remaining element shifts down one index).",parameters:[],return:{meaning:"the removed first element, or undefined if the array was already empty"}},unshift:{summary:"Inserts one or more elements at the start of {receiver}, mutating it in place (every existing element shifts up).",parameters:[{name:"items",meaning:"the element(s) to insert at the front, in order"}],return:{meaning:"the array's new length after inserting"}},readFileSync:{summary:"Reads a whole file synchronously.",parameters:[{name:"path",meaning:"the file path"},{name:"options",meaning:"encoding (without it you get a Buffer)"}],return:{meaning:"the file contents (throws on failure)"}},writeFileSync:{summary:"Writes data to a file synchronously, replacing it.",parameters:[{name:"file",meaning:"the destination path"},{name:"data",meaning:"the contents"},{name:"options",meaning:"encoding / flags"}],return:{meaning:"undefined (throws on failure)"}},exec:{summary:"Runs a command line through a shell (shell injection risk with untrusted input).",parameters:[{name:"command",meaning:"the command line"},{name:"options",meaning:"cwd, env, timeout"}],return:{meaning:"the output (execSync) or a ChildProcess (exec)"}},execSync:{summary:"Runs a command line through a shell (shell injection risk with untrusted input).",parameters:[{name:"command",meaning:"the command line"},{name:"options",meaning:"cwd, env, timeout"}],return:{meaning:"the output (execSync) or a ChildProcess (exec)"}},spawn:{summary:"Starts a process WITHOUT a shell and returns immediately with streams.",parameters:[{name:"command",meaning:"the program"},{name:"args",meaning:"argument array"},{name:"options",meaning:"{cwd, env, stdio, shell}"}],return:{meaning:'a ChildProcess (events: "close", "error"; stdout/stderr streams)'}},spawnSync:{summary:"Starts a program with an explicit argument list (no shell unless shell:true).",parameters:[{name:"command",meaning:"the program"},{name:"args",meaning:"its arguments"},{name:"options",meaning:"cwd, env, stdio"}],return:{meaning:"a ChildProcess (spawn) or its result (spawnSync)"}},setTimeout:{summary:"Runs a function once after a delay (the delay is a minimum, not exact).",parameters:[{name:"callback",meaning:"the function"},{name:"delay",meaning:"milliseconds"}],return:{meaning:"a timer id (clearTimeout cancels it)"}},setInterval:{summary:"Runs a function repeatedly with a delay between calls until cleared.",parameters:[{name:"callback",meaning:"the function"},{name:"delay",meaning:"milliseconds"}],return:{meaning:"a timer id (clearInterval stops it)"}},eval:{summary:"Executes JavaScript from a string (dangerous with untrusted input).",parameters:[{name:"x",meaning:"the code text"}],return:{meaning:"the value of the last expression"}},"Math.random":{summary:"A pseudo-random number in [0,1) — NOT cryptographically secure.",parameters:[],return:{meaning:"the number"}},parseInt:{summary:"Parses the beginning of a string as an integer.",parameters:[{name:"string",meaning:"the text"},{name:"radix",meaning:"numeric base (always pass it)"}],return:{meaning:"the integer, or NaN when nothing could be parsed"}},"Array.isArray":{summary:"Tests whether a value is an array.",parameters:[{name:"value",meaning:"the value to test"}],return:{meaning:"true or false"}},postMessage:{summary:"Sends a message to another window, frame or worker.",parameters:[{name:"message",meaning:"the data (structured clone)"},{name:"targetOrigin",meaning:"the required origin of the receiver (use a specific origin, not '*')"}],return:{meaning:"undefined"}},"fs.readFileSync":{summary:"Reads a whole file SYNCHRONOUSLY (blocks the event loop).",parameters:[{name:"path",meaning:"file path"},{name:"options",meaning:'encoding such as "utf8" (without it you get a Buffer)'}],return:{meaning:"the contents (string or Buffer); throws ENOENT/EACCES/EISDIR on failure"}},"fs.readFile":{summary:"Reads a whole file asynchronously (callback style).",parameters:[{name:"path",meaning:"file path"},{name:"options",meaning:'encoding such as "utf8"'},{name:"callback",meaning:"(err, data) called when finished"}],return:{meaning:"nothing — the result arrives in the callback"}},"fs.writeFileSync":{summary:"Writes data to a file SYNCHRONOUSLY, creating or TRUNCATING it.",parameters:[{name:"file",meaning:"file path"},{name:"data",meaning:"string, Buffer or TypedArray"},{name:"options",meaning:'encoding / mode / flag (use flag "a" to append)'}],return:{meaning:"undefined; throws on failure"}},"fs.existsSync":{summary:"Tests whether a path exists (does not throw).",parameters:[{name:"path",meaning:"the path"}],return:{meaning:"true if it exists",rules:[{when:{op:"==",value:1},meaning:"it exists"},{when:{op:"==",value:0},meaning:"it does not exist (or is not accessible)"}]}},"fs.mkdirSync":{summary:"Creates a directory (add {recursive:true} to create parents and ignore an existing one).",parameters:[{name:"path",meaning:"directory"},{name:"options",meaning:"{recursive, mode}"}],return:{meaning:"the first directory created (with recursive) or undefined; throws EEXIST without recursive"}},"fs.rmSync":{summary:"Removes a file or directory (use {recursive:true, force:true} for rm -rf semantics).",parameters:[{name:"path",meaning:"path"},{name:"options",meaning:"{recursive, force}"}],return:{meaning:"undefined"}},"console.log":{summary:"Prints its arguments to standard output (the browser console in a page).",parameters:[{name:"data",meaning:"values to print"}],return:{meaning:"undefined"}},"console.error":{summary:"Prints its arguments to standard ERROR.",parameters:[{name:"data",meaning:"values to print"}],return:{meaning:"undefined"}},"child_process.execSync":{summary:"Runs a shell command and BLOCKS until it finishes.",parameters:[{name:"command",meaning:"the shell command line"},{name:"options",meaning:"{cwd, env, timeout, encoding}"}],return:{meaning:"its stdout (Buffer or string); throws when the exit code is non-zero (command injection risk with untrusted input)"}},"crypto.createHash":{summary:'Creates a hash object (e.g. "sha256").',parameters:[{name:"algorithm",meaning:"algorithm name"}],return:{meaning:'a Hash: update(data) then digest("hex")'}},"crypto.randomBytes":{summary:"Generates cryptographically secure random bytes.",parameters:[{name:"size",meaning:"number of bytes"}],return:{meaning:"a Buffer"}},"process.exit":{summary:"Terminates the Node.js process immediately (pending async work is dropped).",parameters:[{name:"code",meaning:"exit code, 0 = success"}],return:{meaning:"never returns"}},"Promise.all":{summary:"Waits for ALL promises; rejects immediately when any one rejects.",parameters:[{name:"iterable",meaning:"promises or values"}],return:{meaning:"a Promise of the array of results (in input order)"}}},python:{open:{summary:"Opens a file and returns a file object.",parameters:[{name:"file",meaning:"path of the file"},{name:"mode",meaning:'"r" read text, "w" truncate+write, "a" append, "x" create-only, add "b" for binary, "+" for update'},{name:"encoding",meaning:"text encoding (text mode only; defaults to the locale encoding)"}],return:{meaning:"a file object (raises FileNotFoundError / PermissionError / IsADirectoryError when it cannot be opened); use `with` so it is closed"}},"os.system":{summary:"Runs a command line in a subshell and waits for it.",parameters:[{name:"command",meaning:"the shell command line"}],return:{meaning:"the exit status (0 means success)",rules:[{when:{op:"==",value:0},meaning:"the command succeeded"},{when:{op:"!=",value:0},meaning:"the command failed"}]}},"subprocess.run":{summary:"Runs a command, waits for it, and returns a CompletedProcess.",parameters:[{name:"args",meaning:"the command: a list (preferred) or a string with shell=True"},{name:"capture_output",meaning:"True to capture stdout/stderr"},{name:"check",meaning:"True to raise CalledProcessError on a non-zero exit"},{name:"timeout",meaning:"seconds before TimeoutExpired is raised"}],return:{meaning:"a CompletedProcess with returncode, stdout, stderr (shell=True with untrusted input is a command-injection risk)"}},"subprocess.Popen":{summary:"Starts a process WITHOUT waiting for it.",parameters:[{name:"args",meaning:"the command"},{name:"stdout",meaning:"redirection (e.g. subprocess.PIPE)"},{name:"shell",meaning:"run through the shell"}],return:{meaning:"a Popen object: use communicate()/wait()/poll()"}},"subprocess.check_output":{summary:"Runs a command and raises CalledProcessError on a non-zero exit status.",parameters:[{name:"args",meaning:"the command and its arguments"}],return:{meaning:"the command's stdout bytes (check_output) or 0 (check_call)"}},"subprocess.check_call":{summary:"Runs a command and raises CalledProcessError on a non-zero exit status.",parameters:[{name:"args",meaning:"the command and its arguments"}],return:{meaning:"the command's stdout bytes (check_output) or 0 (check_call)"}},"os.remove":{summary:"Deletes a file (not a directory).",parameters:[{name:"path",meaning:"file path"}],return:{meaning:"None; raises FileNotFoundError / PermissionError / IsADirectoryError"}},"os.unlink":{summary:"Deletes a file.",parameters:[{name:"path",meaning:"the file to delete"}],return:{meaning:"None (raises OSError on failure)"}},"os.makedirs":{summary:"Creates a directory and all missing parents.",parameters:[{name:"name",meaning:"directory path"},{name:"exist_ok",meaning:"True to not raise when it already exists"}],return:{meaning:"None; raises FileExistsError when it exists and exist_ok is False"}},"shutil.rmtree":{summary:"Recursively deletes a directory tree — irreversible.",parameters:[{name:"path",meaning:"directory"},{name:"ignore_errors",meaning:"True to ignore failures"}],return:{meaning:"None"}},"shutil.copy":{summary:"Copies or moves files and directories.",parameters:[{name:"src",meaning:"source path"},{name:"dst",meaning:"destination path"}],return:{meaning:"the destination path"}},"shutil.copy2":{summary:"Copies or moves files and directories.",parameters:[{name:"src",meaning:"source path"},{name:"dst",meaning:"destination path"}],return:{meaning:"the destination path"}},"shutil.copyfile":{summary:"Copies or moves files and directories.",parameters:[{name:"src",meaning:"source path"},{name:"dst",meaning:"destination path"}],return:{meaning:"the destination path"}},"shutil.copytree":{summary:"Copies or moves files and directories.",parameters:[{name:"src",meaning:"source path"},{name:"dst",meaning:"destination path"}],return:{meaning:"the destination path"}},"shutil.move":{summary:"Copies or moves files and directories.",parameters:[{name:"src",meaning:"source path"},{name:"dst",meaning:"destination path"}],return:{meaning:"the destination path"}},"socket.socket":{summary:"Creates a socket object (TCP by default: AF_INET + SOCK_STREAM).",parameters:[{name:"family",meaning:"address family"},{name:"type",meaning:"socket type"}],return:{meaning:"a socket; call connect/bind/listen on it"}},"requests.get":{summary:"Sends an HTTP GET (blocking).",parameters:[{name:"url",meaning:"the URL"},{name:"params",meaning:"query string dict"},{name:"headers",meaning:"request headers"},{name:"timeout",meaning:"seconds (there is NO default timeout — always set one)"}],return:{meaning:"a Response (status_code, text, json(); call raise_for_status() to turn 4xx/5xx into exceptions)"}},"requests.post":{summary:"Sends an HTTP POST (blocking).",parameters:[{name:"url",meaning:"the URL"},{name:"data",meaning:"form data"},{name:"json",meaning:"a JSON body"},{name:"timeout",meaning:"seconds"}],return:{meaning:"a Response"}},"requests.put":{summary:"Performs an HTTP request.",parameters:[{name:"url",meaning:"the address"},{name:"data",meaning:"request body"},{name:"json",meaning:"object sent as a JSON body"},{name:"headers",meaning:"request headers"},{name:"timeout",meaning:"seconds to wait (none by default - may hang)"},{name:"verify",meaning:"check the server's TLS certificate (False disables validation)"}],return:{meaning:"a Response object (check status_code or call raise_for_status())"}},"requests.delete":{summary:"Performs an HTTP request.",parameters:[{name:"url",meaning:"the address"},{name:"data",meaning:"request body"},{name:"json",meaning:"object sent as a JSON body"},{name:"headers",meaning:"request headers"},{name:"timeout",meaning:"seconds to wait (none by default - may hang)"},{name:"verify",meaning:"check the server's TLS certificate (False disables validation)"}],return:{meaning:"a Response object (check status_code or call raise_for_status())"}},"requests.request":{summary:"Performs an HTTP request.",parameters:[{name:"url",meaning:"the address"},{name:"data",meaning:"request body"},{name:"json",meaning:"object sent as a JSON body"},{name:"headers",meaning:"request headers"},{name:"timeout",meaning:"seconds to wait (none by default - may hang)"},{name:"verify",meaning:"check the server's TLS certificate (False disables validation)"}],return:{meaning:"a Response object (check status_code or call raise_for_status())"}},"urllib.request.urlopen":{summary:"Opens a URL and returns a file-like response.",parameters:[{name:"url",meaning:"the address or Request"},{name:"data",meaning:"request body (makes it a POST)"},{name:"timeout",meaning:"seconds to wait"}],return:{meaning:"a response object (raises URLError/HTTPError on failure)"}},"json.loads":{summary:"Parses a JSON string into Python dicts/lists/values.",parameters:[{name:"s",meaning:"the JSON text"}],return:{meaning:"the parsed object; raises json.JSONDecodeError on malformed JSON"}},"json.load":{summary:"Parses JSON read from a file object.",parameters:[{name:"fp",meaning:"an open text file"}],return:{meaning:"the parsed object; raises json.JSONDecodeError on malformed JSON"}},"json.dumps":{summary:"Serializes a Python object to a JSON string.",parameters:[{name:"obj",meaning:"the object (dict/list/str/int/float/bool/None)"},{name:"indent",meaning:"optional pretty-print indent"},{name:"default",meaning:"optional function for unsupported types"}],return:{meaning:"the JSON string; raises TypeError for objects that are not JSON serializable"}},"json.dump":{summary:"Serializes a Python object to JSON.",parameters:[{name:"obj",meaning:"the object"},{name:"indent",meaning:"pretty-print indentation"}],return:{meaning:"the JSON text (or None when writing to a file)"}},"pickle.load":{summary:"Deserializes Python objects (UNSAFE with untrusted data: can run arbitrary code).",parameters:[{name:"file",meaning:"the file object or bytes"}],return:{meaning:"the reconstructed object"}},"pickle.loads":{summary:"Deserializes Python objects (UNSAFE with untrusted data: can run arbitrary code).",parameters:[{name:"file",meaning:"the file object or bytes"}],return:{meaning:"the reconstructed object"}},eval:{summary:"Evaluates a Python EXPRESSION from a string — never use it on untrusted input.",parameters:[{name:"expression",meaning:"the source text"}],return:{meaning:"the value of the expression"}},exec:{summary:"Executes Python code from a string (dangerous with untrusted input).",parameters:[{name:"source",meaning:"the code text"},{name:"globals",meaning:"global namespace"},{name:"locals",meaning:"local namespace"}],return:{meaning:"the expression value (eval) or None (exec)"}},"sqlite3.connect":{summary:"Opens (or creates) a SQLite database file.",parameters:[{name:"database",meaning:'file path or ":memory:"'}],return:{meaning:"a Connection; call commit() to persist changes, close() when done"}},"threading.Thread":{summary:"Creates a thread object; nothing runs until start() is called.",parameters:[{name:"target",meaning:"the function to run"},{name:"args",meaning:"its arguments"},{name:"daemon",meaning:"True so it does not keep the process alive"}],return:{meaning:"a Thread; call start() then join()"}},"time.sleep":{summary:"Blocks the current thread for the given time (in async code use asyncio.sleep).",parameters:[{name:"secs",meaning:"seconds, may be fractional"}],return:{meaning:"None"}},"os.environ.get":{summary:"Reads an environment variable.",parameters:[{name:"key",meaning:"variable name"},{name:"default",meaning:"value to return when it is not set"}],return:{meaning:"its value, or the default (None) when not set",rules:[{when:{op:"==",value:0},meaning:"not set"}]}},"os.getenv":{summary:"Reads an environment variable.",parameters:[{name:"key",meaning:"the variable name"},{name:"default",meaning:"value returned when it is not set"}],return:{meaning:"the value, or the default (None if omitted)"}},"time.time":{summary:"Reads the current wall-clock time (can jump when the clock is adjusted — use time.monotonic for durations).",parameters:[],return:{meaning:"seconds since the epoch as a float"}},"logging.info":{summary:"Logs a message at INFO level on the root logger (does nothing visible until logging.basicConfig or a handler is configured).",parameters:[{name:"msg",meaning:"message, may contain %-style placeholders"},{name:"args",meaning:"values for the placeholders"}],return:{meaning:"None"}},"os.listdir":{summary:"Lists the names in a directory (no recursion, arbitrary order).",parameters:[{name:"path",meaning:"directory, default the current one"}],return:{meaning:"a list of names (strings)"}},"hashlib.sha256":{summary:"Creates a SHA-256 hash object.",parameters:[{name:"data",meaning:"optional initial bytes"}],return:{meaning:"a hash object: update(), hexdigest()"}},"random.random":{summary:"A pseudo-random float in [0.0, 1.0) — NOT suitable for secrets (use the secrets module).",parameters:[],return:{meaning:"the float"}},"sys.exit":{summary:"Raises SystemExit — the interpreter exits after finally/atexit handlers run.",parameters:[{name:"arg",meaning:"0/None success; an int exit code; a string is printed to stderr and exits with 1"}],return:{meaning:"never returns"}},"logger.error":{summary:"Logs a message at ERROR level on this logger.",parameters:[{name:"msg",meaning:"message, may contain %-style placeholders"},{name:"exc_info",meaning:"True to attach the current traceback"}],return:{meaning:"None"}},"zipfile.ZipFile":{summary:'Opens a ZIP archive for reading ("r"), writing ("w") or appending ("a").',parameters:[{name:"file",meaning:"path or file object"},{name:"mode",meaning:'"r", "w", "a" or "x"'}],return:{meaning:"a ZipFile (use `with`); extractall() on untrusted archives can write outside the target folder (zip-slip)"}}},java:{readAllBytes:{summary:"Reads the whole file (or stream) into a byte array.",parameters:[{name:"path",meaning:"the file to read"}],return:{meaning:"the bytes (throws IOException on failure)"}},readAllLines:{summary:"Reads a whole text file as a list of lines.",parameters:[{name:"path",meaning:"the file to read"},{name:"cs",meaning:"the charset"}],return:{meaning:"the lines"}},write:{summary:"Writes bytes or text to a file, creating or truncating it unless options say otherwise.",parameters:[{name:"path",meaning:"the destination file"},{name:"bytes",meaning:"the data"},{name:"options",meaning:"OpenOption flags (APPEND, CREATE...)"}],return:{meaning:"the path"}},writeString:{summary:"Writes bytes or text to a file, creating or truncating it unless options say otherwise.",parameters:[{name:"path",meaning:"the destination file"},{name:"bytes",meaning:"the data"},{name:"options",meaning:"OpenOption flags (APPEND, CREATE...)"}],return:{meaning:"the path"}},exec:{summary:"Starts an external command in a new process.",parameters:[{name:"command",meaning:"the command line or array"},{name:"envp",meaning:"environment variables"},{name:"dir",meaning:"working directory"}],return:{meaning:"a Process object (check waitFor()/exitValue())"}},start:{summary:"Starts a new thread or an external process (depending on the receiver).",return:{meaning:"the started Process (ProcessBuilder) or nothing (Thread)"}},openConnection:{summary:"Creates a URL connection object (no network traffic yet).",return:{meaning:"a URLConnection (call connect/getInputStream to send)"}},getResponseCode:{summary:"Reads the HTTP status code of the response.",return:{meaning:"the status code (200, 404, 500...) or -1 when not valid",rules:[{when:{op:"<",value:0},meaning:"the response is not valid HTTP"},{when:{op:">=",value:0},meaning:"the HTTP status"}]}},forName:{summary:"Loads a class by name at run time (reflection or JDBC driver loading).",parameters:[{name:"className",meaning:"the fully qualified class name"}],return:{meaning:"the Class object (throws ClassNotFoundException)"}},getConnection:{summary:"Opens a database connection through JDBC.",parameters:[{name:"url",meaning:"the JDBC URL"},{name:"user",meaning:"database user"},{name:"password",meaning:"password"}],return:{meaning: