, give an address, or say "find a picture of …".',"AI 畫的":"Painted by the AI","圖片・":"Picture · ","圖片":"Picture","PNG 圖片":"PNG picture","JPEG 圖片":"JPEG picture","專案（JSON）":"Project (JSON)","合成中…":"Compositing…","補畫修復標記":"Add repair marks","修復":"Repair","用畫筆標出要修復的地方":"Mark the places to repair with the brush","移動 ":"Move ","🩹 修復畫筆":"🩹 Repair brush","畫筆大小（畫面上的單位）":"Brush size (units on the plane)","在畫面上塗出要修復的地方（會變成一個修復圖層）":"Paint the places to repair (it becomes a repair layer)","套用風格…":"Apply a style…","套用風格「":'Applied the style "',"改 ":"Change ","畫布（裁切與輸出的範圍框，不是邊界）":"Canvas (the frame that is cropped and exported, not a boundary)","畫布 ":"Canvas ","背景 ":"Background ","畫布貼合內容":"Canvas fitted to the content","對整張圖：":"For the whole picture: ","自動對比":"Auto contrast","去雜訊":"Denoise","去污點":"Remove specks","銳化":"Sharpen","混合":"Blend","水平翻轉":"Flip horizontally","垂直翻轉":"Flip vertically","出處：":"Source: ","提示詞：":"Prompt: ","對這張圖：":"For this picture: ","🩹 修復這張圖的中央":"🩹 Repair the middle of this picture","修復 ":"Repair ","強度":"Strength","整張圖":"The whole picture","作用在":"Acts on"," 作用在 ":" acts on ","刪掉 ":"Deleted "," 拿掉 ":" removed ","亮度":"Brightness","對比":"Contrast","飽和度":"Saturation","模糊":"Blur","黑白":"Black and white","油畫":"Oil painting","水彩":"Watercolor","素描":"Sketch","卡通":"Cartoon","降噪":"Denoise","數值":"Value","＋ 加一個處理":"+ Add a process"," 加 ":" add ","方法":"Method","補洞（從周圍填入）":"Fill the hole (from around it)","半徑":"Radius","標記 ":"Marks "," 處（用「🩹 修復畫筆」可以再塗）":' places (use the "🩹 repair brush" to paint more)',"清除標記":"Clear the marks","所有圖層與它們的設定（唯讀）。圖片的像素另外存在這個瀏覽器裡，這裡只有代號。":"All layers and their settings (read only). The pixels of the pictures are kept apart in this browser; only a reference is here."};e.FaEditPictureI18n=!0,n&&n.STYLES&&Object.keys(n.STYLES).forEach(function(e){var t=n.STYLES[e];t.label&&!r[t.label]&&(r[t.label]=String(t.en||e).replace(/^(an?|the) /,""))}),r["⬇ 下載 JPEG 圖片"]="⬇ Download JPEG picture",r["💬 放進對話 JPEG 圖片"]="💬 Put the JPEG picture into the conversation"