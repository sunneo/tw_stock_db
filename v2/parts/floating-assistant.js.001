TW",description:"Word-sized port output."},{name:"outl",format:"OUTL",description:"Doubleword-sized port output."},{name:"ins",format:"INS m8/m16/m32, DX",description:"String input from port DX into memory at [ES:(E)DI], auto-incrementing."},{name:"outs",format:"OUTS DX, m8/m16/m32",description:"String output from memory at [DS:(E)SI] to port DX, auto-incrementing."},{name:"insb",format:"INSB",description:"Byte-granularity form of INS."},{name:"outsb",format:"OUTSB",description:"Byte-granularity form of OUTS."},{name:"insw",format:"INSW",description:"Word-granularity form of INS."},{name:"outsw",format:"OUTSW",description:"Word-granularity form of OUTS."},{name:"insd",format:"INSD",description:"Doubleword-granularity form of INS."},{name:"outsd",format:"OUTSD",description:"Doubleword-granularity form of OUTS."},{name:"cli",format:"CLI",description:"Clears the interrupt flag (IF=0), disabling maskable interrupts."},{name:"sti",format:"STI",description:"Sets the interrupt flag (IF=1), enabling maskable interrupts."},{name:"hlt",format:"HLT",description:"Halts the CPU until the next external interrupt."},{name:"lock",format:"LOCK <instr>",description:"Prefix asserting the bus/cache lock for an atomic read-modify-write."},{name:"wbinvd",format:"WBINVD",description:"Writes back and invalidates the entire cache hierarchy."},{name:"invd",format:"INVD",description:"Invalidates the cache without writing back (data loss risk)."},{name:"clflush",format:"CLFLUSH m8",description:"Flushes a cache line for the given linear address."},{name:"rdmsr",format:"",description:"讀取模型特定暫存器"},{name:"wrmsr",format:"",description:"寫入模型特定暫存器"},{name:"rdtsc",format:"",description:"讀取時間戳計數器"},{name:"rdtscp",format:"",description:"讀取時間戳計數器並取得處理器 ID"},{name:"rdpmc",format:"",description:"讀取效能計數器"},{name:"cpuid",format:"",description:"查詢處理器功能"},{name:"lgdt",format:"",description:"載入全域描述元表"},{name:"lidt",format:"",description:"載入中斷描述元表"},{name:"lldt",format:"",description:"載入區域描述元表"},{name:"ltr",format:"",description:"載入工作暫存器"},{name:"sgdt",format:"",description:"儲存全域描述元表"},{name:"sidt",format:"",description:"儲存中斷描述元表"},{name:"invlpg",format:"",description:"使 TLB 項目失效"},{name:"swapgs",format:"",description:"交換 GS 基底（核心／使用者）"},{name:"sysret",format:"",description:"從系統呼叫返回使用者態"},{name:"sysexit",format:"",description:"快速返回使用者態"},{name:"sysenter",format:"",description:"快速進入核心"},{name:"vmcall",format:"",description:"虛擬機呼叫超管理器"},{name:"vmlaunch",format:"",description:"啟動虛擬機"},{name:"vmresume",format:"",description:"繼續虛擬機"},{name:"vmxon",format:"",description:"進入 VMX 操作"},{name:"vmxoff",format:"",description:"離開 VMX 操作"},{name:"xgetbv",format:"",description:"讀取擴充控制暫存器"},{name:"xsetbv",format:"",description:"寫入擴充控制暫存器"},{name:"xsave",format:"",description:"儲存處理器擴充狀態"},{name:"xrstor",format:"",description:"還原處理器擴充狀態"},{name:"fxsave",format:"",description:"儲存浮點與 SSE 狀態"},{name:"fxrstor",format:"",description:"還原浮點與 SSE 狀態"},{name:"rdfsbase",format:"",description:"讀取 FS 基底"},{name:"wrfsbase",format:"",description:"寫入 FS 基底"},{name:"rdgsbase",format:"",description:"讀取 GS 基底"},{name:"wrgsbase",format:"",description:"寫入 GS 基底"},{name:"smsw",format:"",description:"儲存機器狀態字"},{name:"lmsw",format:"",description:"載入機器狀態字"}],memory_management:[{name:"mov",format:"MOV dst, src",description:"Copies src into dst (register/memory/immediate)."},{name:"lea",format:"LEA r, m",description:"Loads the computed effective address of m into r (no memory read)."},{name:"push",format:"PUSH src",description:"Decrements the stack pointer and stores src at [SP]."},{name:"pop",format:"POP dst",description:"Loads dst from [SP] and increments the stack pointer."},{name:"movzx",format:"MOVZX dst, src",description:"Move with zero-extension to a wider register."},{name:"movsx",format:"MOVSX dst, src",description:"Move with sign-extension to a wider register."},{name:"movs",format:"MOVS m, m",description:"String move: copies [SI]->[DI], auto-incrementing/decrementing."},{name:"movsb",format:"MOVSB",description:"Byte-sized MOVS (explicit-size AT&T mnemonic - copies one byte [SI]->[DI])."},{name:"movsw",format:"MOVSW",description:"Word-sized MOVS."},{name:"movsd",format:"MOVSD",description:"Doubleword-sized MOVS (string-move sense - NOT the SSE2 scalar-double-move instruction of the same mnemonic; disambiguated by context, this table lists the string-instruction meaning since that's the one paired with REP.)"},{name:"movsq",format:"MOVSQ",description:"Quadword-sized MOVS (64-bit mode)."},{name:"stos",format:"STOS m",description:"Stores AL/AX/EAX to [DI], auto-incrementing/decrementing."},{name:"stosb",format:"STOSB",description:"Byte-sized STOS (explicit-size AT&T mnemonic - stores AL to [DI]; the core instruction of the classic `rep stosb` memset/bzero-to-zero idiom)."},{name:"stosw",format:"STOSW",description:"Word-sized STOS (stores AX to [DI])."},{name:"stosd",format:"STOSD",description:"Doubleword-sized STOS (stores EAX to [DI])."},{name:"stosq",format:"STOSQ",description:"Quadword-sized STOS (64-bit mode, stores RAX to [DI])."},{name:"lods",format:"LODS m",description:"Loads AL/AX/EAX from [SI], auto-incrementing/decrementing."},{name:"lodsb",format:"LODSB",description:"Byte-sized LODS (explicit-size AT&T mnemonic)."},{name:"lodsw",format:"LODSW",description:"Word-sized LODS."},{name:"lodsd",format:"LODSD",description:"Doubleword-sized LODS."},{name:"lodsq",format:"LODSQ",description:"Quadword-sized LODS (64-bit mode)."},{name:"cmps",format:"CMPS m, m",description:"Compares [SI] and [DI], auto-incrementing/decrementing."},{name:"cmpsb",format:"CMPSB",description:"Byte-sized CMPS (explicit-size AT&T mnemonic)."},{name:"cmpsw",format:"CMPSW",description:"Word-sized CMPS."},{name:"cmpsd",format:"CMPSD",description:"Doubleword-sized CMPS (string-compare sense - same disambiguation note as MOVSD above.)"},{name:"cmpsq",format:"CMPSQ",description:"Quadword-sized CMPS (64-bit mode)."},{name:"scas",format:"SCAS m",description:"Compares AL/AX/EAX against [DI], auto-incrementing/decrementing."},{name:"scasb",format:"SCASB",description:"Byte-sized SCAS (explicit-size AT&T mnemonic - the core instruction of a `rep(n)e scasb` strlen/memchr-style idiom)."},{name:"scasw",format:"SCASW",description:"Word-sized SCAS."},{name:"scasd",format:"SCASD",description:"Doubleword-sized SCAS."},{name:"scasq",format:"SCASQ",description:"Quadword-sized SCAS (64-bit mode)."},{name:"xchg",format:"XCHG dst, src",description:"Atomically swaps the contents of dst and src."},{name:"movnti",format:"",description:"非暫存式整數儲存（繞過快取）"},{name:"movntdq",format:"",description:"非暫存式 128 位元儲存"},{name:"movntps",format:"",description:"非暫存式單精度向量儲存"},{name:"prefetcht0",format:"",description:"預取到所有快取層"},{name:"prefetcht1",format:"",description:"預取到 L2 以後"},{name:"prefetcht2",format:"",description:"預取到 L3 以後"},{name:"prefetchnta",format:"",description:"預取且不污染快取"},{name:"prefetchw",format:"",description:"預取並準備寫入"},{name:"clflushopt",format:"",description:"最佳化版快取行回寫"},{name:"clwb",format:"",description:"把快取行寫回但保留"},{name:"sfence",format:"",description:"儲存屏障"},{name:"lfence",format:"",description:"載入屏障"},{name:"mfence",format:"",description:"完整記憶體屏障"},{name:"pushf",format:"",description:"推入旗標暫存器"},{name:"popf",format:"",description:"取出旗標暫存器"},{name:"enter",format:"",description:"建立堆疊框"},{name:"leave",format:"",description:"拆除堆疊框"},{name:"xlat",format:"",description:"查表"}],control_flow:[{name:"rep",format:"REP instr",description:"Repeat prefix: re-executes the following string instruction (MOVS/STOS/LODS/CMPS/SCAS) while (E)CX != 0, decrementing (E)CX each pass - the closest x86 has to an implicit loop with no visible branch instruction."},{name:"repe",format:"REPE instr",description:'Repeat-while-equal prefix (alias REPZ): like REP, but ALSO stops early if ZF becomes 0 - pairs with CMPS/SCAS for "compare/scan while matching" idioms.'},{name:"repz",format:"REPZ instr",description:"Alias for REPE."},{name:"repne",format:"REPNE instr",description:'Repeat-while-not-equal prefix (alias REPNZ): like REP, but ALSO stops early if ZF becomes 1 - pairs with CMPS/SCAS for "compare/scan until match" idioms (e.g. a REPNE SCASB-based strlen).'},{name:"repnz",format:"REPNZ instr",description:"Alias for REPNE."},{name:"jmp",format:"JMP target",description:"Unconditional jump."},{name:"je",format:"JE target",description:"Jump if equal (ZF=1)."},{name:"jne",format:"JNE target",description:"Jump if not equal (ZF=0)."},{name:"jz",format:"JZ target",description:"Jump if zero (ZF=1) - alias of JE."},{name:"jnz",format:"JNZ target",description:"Jump if not zero (ZF=0) - alias of JNE."},{name:"jg",format:"JG target",description:"Jump if greater (signed)."},{name:"jl",format:"JL target",description:"Jump if less (signed)."},{name:"jge",format:"JGE target",description:"Jump if greater or equal (signed)."},{name:"jle",format:"JLE target",description:"Jump if less or equal (signed)."},{name:"ja",format:"JA target",description:"Jump if above (unsigned)."},{name:"jb",format:"JB target",description:"Jump if below (unsigned)."},{name:"jae",format:"JAE target",description:"Jump if above or equal (unsigned)."},{name:"jbe",format:"JBE target",description:"Jump if below or equal (unsigned)."},{name:"jc",format:"JC target",description:"Jump if carry flag set."},{name:"jnc",format:"JNC target",description:"Jump if carry flag clear."},{name:"call",format:"CALL target",description:"Pushes the return address and jumps to target (function call)."},{name:"ret",format:"RET",description:"Pops the return address and jumps to it (function return)."},{name:"loop",format:"LOOP target",description:"Decrements (E)CX and jumps to target if (E)CX != 0."},{name:"loope",format:"LOOPE target",description:"Decrements (E)CX, jumps if (E)CX != 0 AND ZF=1."},{name:"loopne",format:"LOOPNE target",description:"Decrements (E)CX, jumps if (E)CX != 0 AND ZF=0."},{name:"js",format:"",description:"負數則跳"},{name:"jns",format:"",description:"非負則跳"},{name:"jo",format:"",description:"溢位則跳"},{name:"jno",format