                case 'u': { unsigned cp = hex4(); if (cp >= 0xD800 && cp < 0xDC00 && p + 1 < s.size() && s[p] == '\\' && s[p + 1] == 'u') { size_t save = p; p += 2; unsigned lo = hex4(); if (lo >= 0xDC00 && lo < 0xE000) cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00); else p = save; } fa_jv_utf8(out, cp); break; }
