s, n)}.\n  // Used by the MP4 export, which feeds it straight into the audio encoder.\n  // Sound cues of slide i (collage: pop / step / whoosh / speech and collage.sounds), on the slide clock. Recomputed when the slide is re-timed.\n  Session.prototype.sfxFor = function (i) {\n    var pr = this.preps[i], slide = this.deck.slides[i]; if (!pr || !slide || !slide.visual || slide.visual.kind !== 'collage') { return []; }\n    var key = pr.timing ? pr.timing.narrSec + '|' + (pr.timing.sentences || []).length : '';\n    if (pr._sfxKey !== key) { pr._sfxKey = key; pr._sfx = Core.sfxCues(slide, pr.timing || Core.timingFor(slide, 0, 0)); }\n    return pr._sfx || [];\n  };\n  var sfxCache = {};\n  // a cue may carry a voice (the blips of a character): the sound depends on its numbers and on the pitch step of the letter, so they are part of the cache key\n  function sfxSamples(name, sr, cue) {\n    var vc = cue && cue.voice, k = name + '@' + sr + (vc ? '|' + [vc.pitch, vc.wave, vc.jitter, vc.vibrato, vc.noise, vc.len].join(',') + '|' + (cue.step || 0) : '');\n    if (!sfxCache[k]) { sfxCache[k] = window.AiChatDeckSfx ? window.AiChatDeckSfx.render(name, sr, vc ? { voice: vc, step: cue.step || 0 } : undefined) : new Float32Array(0); } return sfxCache[k];\n  }\n\n  // 配樂(階段 6):deck.soundtrack({kind:'midi'|'audio', ...},見 renderer/src/music/soundtrack.js)由 soundtrackProvider(spec, seconds, sampleRate) 非同步鋪成整份簡報長度的床(循環、淡入淡出、音量都套好);\n  // 這裡轉成單聲道存起來,播放時從播放位置接著放,匯出 MP4 時混進旁白的音軌。沒有設定配樂或失敗就什麼都不做(旁白照常)。\n  Session.prototype.prepareSoundtrack = function () {\n    var self = this, spec = this.deck && this.deck.soundtrack, ctx = getAudioCtx();\n    if (!spec || !soundtrackProvider) { return Promise.resolve(null); }\n    var sr = ctx ? ctx.sampleRate : 32000, key = JSON.stringify([spec.kind, (spec.midiB64 || spec.fileId || '').length, spec.volume, spec.fadeIn, spec.fadeOut, spec.loop, spec.offset, Math.ceil(this.tl.total), sr]);\n    if (this._stKey === key && this._stP) { return this._stP