EXT, FORMAT: FORMAT, VERSION: VERSION, isPackFile: isPackFile, walkUrls: walkUrls, collectAssets: collectAssets, isFetchable: isFetchable, open: open };\n})(window);\n",deck_export:"// Exports of a prepared \"/media-presentation\" deck (see ai_chat_deck_player.js): MP4, PPTX, the original .deck.yaml,\n// subtitles (.srt/.vtt) and a bundle (.zip). Every export first waits until every slide is prepared (narration synthesised,\n// pictures loaded) -- it reuses what the player already prepared, nothing is made twice.\n//\n// MP4 reuses ai_chat_video_export.js (the same WebCodecs + mp4-muxer path the 2D/3D viewers use) and calls the SAME\n// renderFrame the player draws with, so the video is the playback. PPTX reuses the branded slide styles of\n// ai_chat_markdown.js (pptxKit); animation and transitions cannot live in a PPTX made this way, so each slide shows the\n// finished picture and the narration goes into the speaker notes.\n(function (window) {\n  'use strict';\n\n  var Core = window.AiChatDeckCore;\n\n  // narration kept as WAV is squeezed to mp3 only for the files that leave the app: one array of bytes per slide (null = no audio)\n  function withZipAudio(session) {\n    var D = window.AiChatDeck;\n    return Promise.all(session.preps.map(function (p) { if (!p.audio) { return Promise.resolve(null); } return (D && D.compressAudio ? D.compressAudio(p.audio.mp3) : Promise.resolve(p.audio.mp3)).catch(function () { return p.audio.mp3; }); })).then(function (au) { session.__zipAudio = au; });\n  }\n  function safeName(s) { return String(s || 'presentation').replace(/[\\\\/:*?\"<>|\\s]+/g, '_').slice(0, 60) || 'presentation'; }\n  function download(blob, name) {\n    var url = URL.createObjectURL(blob), a = document.createElement('a');\n    a.href = url; a.download = name; document.body.appendChild(a); a.click(); document.body.removeChild(a);\n    setTimeout(function () { URL.revokeObjectURL(url); }, 1500);\n  }\n\n  // ------------------------------------------------------------------ the progress panel\n  // Every export shows a card over the player: the steps it has (done / running / waiting), a bar for the whole export and for the running\n  // step, what is happening right now, the time left, and a Cancel button. P is also callable: P(text) just sets the detail line.\n  var STEPS = {\n    mp4: ['準備旁白與圖片', '渲染畫面並編碼影片(含旁白、字幕)', '封裝並存成檔案'],\n    pptx: ['準備旁白與圖片', '組合投影片(截圖與表格)', '產生 .pptx 檔'],\n    zip: ['準備旁白與圖片', '加入描述檔、字幕與旁白音檔', '壓縮成 .zip'],\n    pack: ['準備旁白與圖片', '收集簡報用到的圖片與檔案', '加入描述檔、旁白、字幕與作答紀錄', '壓縮成簡報封包'],\n    srt: ['準備旁白(取得每句的時間)', '產生字幕檔'],\n    vtt: ['準備旁白(取得每句的時間)', '產生字幕檔']\n  };\n  var TITLES = { mp4: '匯出 MP4 影片', pptx: '匯出 PPTX 投影片', zip: '匯出完整封包', pack: '匯出簡報封包(可再開啟播放)', srt: '匯出字幕 (.srt)', vtt: '匯出字幕 (.vtt)' };\n\n  function mk(tag, cls, text) { var e = document.createElement(tag); if (cls) { e.className = cls; } if (text != null) { e.textContent = text; } return e; }\n  function fmtTime(sec) { sec = Math.max(0, Math.round(sec)); var m = Math.floor(sec / 60), r = sec % 60; return m + ':' + (r < 10 ? '0' : '') + r; }\n\n  function makeProgress(box, title, labels, onText) {\n    var card = mk('div', 'ai-chat-deck-export-card'), head = mk('div', 'ai-chat-deck-export-title', title);\n    var overall = mk('div', 'ai-chat-deck-export-bar'), overallFill = mk('div', 'ai-chat-deck-export-bar-fill'); overall.appendChild(overallFill);\n    var overallText = mk('div', 'ai-chat-deck-export-overall', '');\n    var list = mk('ol', 'ai-chat-deck-export-steps'), items = labels.map(function (l) { var li = mk('li', 'waiting'); li.appendChild(mk('span', 'ai-chat-deck-export-icon', '○')); li.appendChild(mk('span', null, l)); list.appendChild(li); return li; });\n    var stepBar = mk('div', 'ai-chat-deck-export-bar small'), stepFill = mk('div', 'ai-chat-deck-export-bar-fill'); stepBar.appendChild(stepFill);\n    var detail = mk('div', 'ai-chat-deck-export-detail', '');\n    var actions = mk('div', 'ai-chat-deck-export-actions'), cancel = mk('button', 'ai-chat-deck-btn', '取消'), close = mk('button', 'ai-chat-deck-btn', '關閉');\n    cancel.type = close.type = 'button'; close.style.display = 'none'; actions.appendChild(cancel); actions.appendChild(close);\n    [head, overall, overallText, list, stepBar, detail, actions].forEach(function (n) { card.appendChild(n); });\n    box.appendChild(card);\n    var st = { i: 0, f: 0, t0: Date.now(), cancelled: false, over: false };\n    function render() {\n      var n = labels.length, frac = Math.min(1, (st.i + st.f) / n);\n      overallFill.style.width = (frac * 100) + '%'; stepFill.style.width = (st.f * 100) + '%';\n      overallText.textContent = st.over ? '' : '步驟 ' + Math.min(st.i + 1, n) + ' / ' + n + ' · 整體 ' + Math.round(frac * 100) + '%';\n      items.forEach(function (li, k) {\n        var state = k < st.i ? 'done' : (k === st.i && !st.over ? 'running' : 'waiting');\n        li.className = state; li.firstChild.textContent = state === 'done' ? '✓' : (state === 'running' ? '▶' : '○');\n      });\n    }\n    function P(text) { detail.textContent = text; if (onText) { onText(text); } }\n    P.step = function (i, text) { st.i = i; st.f = 0; st.t0 = Date.now(); render(); if (text) { P(text); } };\n    P.frac = function (f, text) {\n      st.f = Math.max(0, Math.min(1, f)); render();\n      var eta = st.f > 0.03 && st.f < 1 ? (Date.now() - st.t0) / 1000 / st.f * (1 - st.f) : null;\n      P((text || '') + (eta != null ? ' · 剩約 ' + fmtTime(eta) : ''));\n    };\n    P.isCancelled = function () { return st.cancelled; };\n    P.check = function () { if (st.cancelled) { throw new Error('已取消匯出'); } };\n    P.done = function (msg) { if (st.over) { return; } st.i = labels.length; st.f = 0; st.over = true; render(); overallText.textContent = '完成'; P(msg || ''); cancel.style.display = 'none'; close.style.display = ''; setTimeout(function () { if (card.parentNode) { card.remove(); } }, 8000); };\n    P.fail = function (msg) { if (st.over) { return; } st.over = true; render(); card.classList.add('failed'); overallText.textContent = st.cancelled ? '已取消' : '失敗'; P(msg || ''); cancel.style.display = 'none'; close.style.display = ''; };\n    // Cancel must not wait for a long step (preparing narration, a terminal that never answers) to finish: anything awaited through\n    // P.raceCancel(promise) is abandoned the moment Cancel is pressed (the work itself goes on in the background, e.g. the preheat).\n    var hooks = [];\n    P.raceCancel = function (promise) {\n      return Promise.race([promise, new Promise(function (_res, rej) { if (st.cancelled) { rej(new Error('已取消匯出')); } else { hooks.push(function () { rej(new Error('已取消匯出')); }); } })]);\n    };\n    // Safety net: whatever step is running, 3 seconds after Cancel the card is finished as cancelled (the work stops by itself later); the\n    // card can never sit on \"取消中…\".\n    var forcedReject = null;\n    P.forced = new Promise(function (_res, rej) { forcedReject = rej; });\n    P.forced.catch(function () { /* handled by run() */ });\n    cancel.addEventListener('click', function () {\n      if (st.cancelled) { return; }\n      st.cancelled = true; cancel.disabled = true; cancel.textContent = '取消中…'; hooks.splice(0).forEach(function (h) { h(); });\n      setTimeout(function () { if (!st.over && forcedReject) { forcedReject(new Error('已取消匯出(背景工作還在收尾)')); } }, 3000);\n    });\n    close.addEventListener('click', function () { card.remove(); });\n    P.step(0);\n    return P;\n  }\n\n  function prepareAll(session, P) {\n    var total = session.preps.length, ready = session.preps.filter(function (_p, i) { return session.isReady(i); }).length;\n    P.step(0, '正在準備旁白與圖片…(' + ready + ' / ' + total + ' 頁已預熱，已經好的會直接略過)');\n    // pages already prepared by the player's preheat resolve at once; only the remaining ones cost time (and each is shown as it finishes)\n    return P.raceCancel(session.whenAllReady(function (done, n) { P.frac(done / n, '旁白與圖片:第 ' + done + ' / ' + n + ' 頁'); })).then(function () {\n      P.check();\n      return session.settleTerminals ? P.raceCancel(Promise.resolve(session.settleTerminals(function (d, t) { P.frac(d / t, '終端機:執行第 ' + d + ' / ' + t + ' 個'); }))) : null;\n    }).then(function () { P.check(); });\n  }\n\n  // ------------------------------------------------------------------ MP4\n  // 匯出選項視窗用的樣式：這些 class 原本由 Redmine 那邊的 CSS 提供，這個專案裡沒有，視窗會變成沒樣式的表單掉在頁面最下面。\n  // 這裡自帶一份（只注入一次），視窗置中、蓋在所有東西上面。\n  function ensureDialogStyle() {\n    if (document.getElementById('dk-dialog-style')) { return; }\n    var s = document.createElement('style'); s.id = 'dk-dialog-style';\n    s.textContent = '.ai-chat-dialog-overlay{position:fixed;inset:0;z-index:2147483000;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;padding:16px;box-sizing:border-box}'\n      + '.ai-chat-dialog{width:min(420px,100%);max-height:90vh;overflow:auto;background:#fff;color:#222;border-radius:12px;padding:18px 20px;box-shadow:0 12px 40px rgba(0,0,0,.45);font:14px/1.5 sans-serif;box-sizing:border-box}'\n      + '.ai-chat-dialog h3{margin:0 0 12px;font-size:17px;color:#222}'\n      + '.ai-chat-dialog select,.ai-chat-dialog input[type=number]{padding:6px 8px;border:1px solid #bbb;border-radius:6px;background:#fff;color:#222;box-sizing:border-box;font:inherit}'\n      + '.ai-chat-dialog .block{display:block}'\n      + '.ai-chat-dialog-actions{display:flex;gap:8px;margin-top:14px}.ai-chat-dialog-actions-spacer{flex:1}'\n      + '.ai-chat-dialog-actions button{padding:6px 16px;border-radius:6px;border:1px solid #bbb;background:#f3f3f3;color:#222;cursor:pointer;font:inherit}'\n      + '.ai-chat-dialog-actions button:last-child{background:#76b900;border-color:#76b900;color:#fff;font-weight:bold}';\n    document.head.appendChild(s);\n  }\n  function askMp4Options() {\n    return new Promise(function (resolve) {\n      ensureDialogStyle();\n      var overlay = document.createElement('div'); overlay.className = 'ai-chat-dialog-overlay';\n      var dlg = document.createElement('div'); dlg.className = 'ai-chat-dialog';\n      dlg.innerHTML = '<h3>匯出 MP4 影片</h3>' +\n        '<div style=\"margin-bottom:0.8em;\"><label class=\"block\">解析度<br><select class=\"dk-res\" style=\"width:100%;\"><option value=\"1280\">720p (1280×720)</option><option value=\"1920\">1080p (1920×1080,較慢)</option></select></label></div>' +\n        '<div style=\"margin-bottom:0.8em;\"><label class=\"block\">每秒影格<br><select class=\"dk-fps\" style=\"width:100%;\"><option value=\"24\">24</option><option value=\"30\" selected>30</option></select></label></div>' +\n        '<div style=\"margin-bottom:0.8em;\"><label><input type=\"checkbox\" class=\"dk-sub\" checked> 把字幕燒進影片</label></div>' +\n        '<div class=\"ai-chat-dialog-actions\"><span class=\"ai-chat-dialog-actions-spacer\"></span><button type=\"button\" class=\"dk-cancel\">取消</button><button type=\"button\" class=\"dk-ok\">匯出</button></div>';\n      overlay.appendChild(dlg); document.body.appendChild(overlay);\n      function close(v) { document.body.removeChild(overlay); resolve(v); }\n      overlay.addEventListener('click', function (e) { if (e.target === overlay) { close(null); } });\n      dlg.querySelector('.dk-cancel').addEventListener('click', function () { close(null); });\n      dlg.querySelector('.dk-ok').addEventListener('click', function () {\n        close({ width: parseInt(dlg.querySelector('.dk-res').value, 10), fps: parseInt(dlg.querySelector('.dk-fps').value, 10), subtitles: dlg.querySelector('.dk-sub').checked });\n      });\n    });\n  }\n\n  function exportMp4(session, P) {\n    if (!window.AiChatVideoExport) { return Promise.reject(new Error('the video export script is not loaded')); }\n    return askMp4Options().then(function (opt) {\n      if (!opt) { throw new Error('已取消匯出'); }\n      return prepareAll(session, P).then(function () { if (session.deck && session.deck.soundtrack) { P.step(1, '正在準備配樂…'); return session.prepareSoundtrack(); } }).then(function () {\n        P.step(1, '正在設定編碼器與磁碟暫存…');\n        var deck = session.deck, tl = session.tl, w = opt.width, h = Math.round(w * 9 / 16), fps = opt.fps;\n        var canvas = document.createElement('canvas'); canvas.width = w; canvas.height = h;\n        var ctx = canvas.getContext('2d');\n        var info = session.info({ width: w, height: h, subtitles: opt.subtitles });\n        var frames = Math.max(1, Math.ceil(tl.total * fps));\n        var audio = session.audioSource();   // produced chunk by chunk while encoding -- never one big array\n        var started = Date.now();\n        // an export shows the stage's default camera, not wherever the viewer last dragged it\n        var stage = session.stage3d, savedView = stage ? Object.assign({}, stage.view) : null;\n        if (stage) { stage.resetView(); }\n        function restoreView() { if (stage && savedView) { Object.assign(stage.view, savedView); } }\n        // The file is written to the browser's private disk storage while it is encoded (a 30 minute video is ~1 GB, far too much to\n        // hold in memory); the bitrate is lower for 720p so a long deck stays a sane size.\n        var options = { stream: true, bitrate: w >= 1920 ? 5000000 : 2500000 };\n        if (audio) { options.audio = audio; }\n        return window.AiChatVideoExport.encodeCanvasFramesToMp4(canvas, frames, fps, function (i) {\n          P.check();\n          Core.renderFrame(ctx, deck, tl, i / fps, info);\n        }, function (done, total) {\n          var sec = done / fps;\n          P.frac(done / total, '編碼影格 ' + done + ' / ' + total + '(影片 ' + fmtTime(sec) + ' / ' + fmtTime(total / fps) + ')· 請保持此分頁開啟');\n        }, options).then(function (result) {\n          restoreView();\n          P.step(2, '正在存成檔案並下載…');\n          download(result.blob, safeName(deck.deck.title) + '.mp4');\n          if (result.cleanup) { setTimeout(result.cleanup, 20 * 60 * 1000); }\n          var silent = session.preps.filter(function (p) { return !p.audio && p.timing && !p.timing.silent; }).length;\n          return 'MP4 已匯出' + (result.streamed ? '' : '(此瀏覽器沒有磁碟暫存,影片是在記憶體中組成的;很長的簡報請改用 Chrome / Edge)') +\n            (!audio ? '(沒有旁白音軌:此環境沒有語音)' : (result.audioDropped ? '(此瀏覽器無法編碼音訊,影片沒有聲音)' : '')) + (silent && audio ? ';' + silent + ' 頁旁白失敗,該頁靜音' : '');\n        }, function (err) { restoreView(); throw err; });\n      });\n    });\n  }\n\n  // ------------------------------------------------------------------ PPTX\n  function canvasToDataUri(canvas) { return canvas.toDataURL('image/png'); }\n\n  function exportPptx(session, P) {\n    var kit = window.AiChatMarkdown && window.AiChatMarkdown.pptxKit;\n    if (!kit) { return Promise.reject(new Error('the PPTX kit is not available')); }\n    return prepareAll(session, P).then(function () { P.step(1, '正在載入 PPTX 元件…'); return kit.ensureLibs(); }).then(function () {\n      var deck = session.deck, pres = new window.PptxGenJS();\n      pres.defineLayout({ name: 'AI_CHAT_16X9', width: kit.slideW, height: kit.slideH });\n      pres.layout = 'AI_CHAT_16X9';\n      pres.title = deck.deck.title;\n      var k = kit.slideW / Core.W; // design px -> inches\n      var lastChapter = -1;\n      var stageInfo = session.info({ width: 1920, height: 1080, subtitles: false });\n      var stageSlides = 0;\n\n      // A slide on the 3D stage: the stage as it looks NOW (the viewer's current camera angle, the model at the end of its animation)\n      // is the slide background, the flat layer (tables, images, 2D overlays, group items) a transparent picture over it, and the\n      // title / bullets stay native, editable text.\n      function addStageSlide(slide) {\n        var bgCanvas = document.createElement('canvas'); bgCanvas.width = 1920; bgCanvas.height = 1080;\n        Core.renderStageSnapshot(bgCanvas.getContext('2d'), deck, slide, stageInfo, 1920, 1080);\n        var s = pres.addSlide();\n        s.background = { data: bgCanvas.toDataURL('image/jpeg', 0.92) };\n        var layer = document.createElement('canvas'); layer.width = 1920; layer.height = 1080;\n        Core.renderStageFlatLayer(layer.getContext('2d'), slide, stageInfo);\n        if (slide.visual) { s.addImage({ data: canvasToDataUri(layer), x: 0, y: 0, w: kit.slideW, h: kit.slideH }); }\n        var white = 'FFFFFF';\n        if (slide.layout === 'title' || slide.layout === 'topic') {\n          s.addText(slide.title, { x: 0.8, y: 2.4, w: kit.slideW - 1.6, h: 1.6, fontSize: 40, bold: true, color: white, fontFace: kit.font, align: 'center', valign: 'middle', shadow: { type: 'outer', color: '000000', blur: 6, offset: 2, angle: 45, opacity: 0.8 } });\n          if (slide.subtitle) { s.addText(slide.subtitle, { x: 0.8, y: 4.1, w: kit.slideW - 1.6, h: 0.6, fontSize: 20, bold: true, color: kit.colorAccent, fontFace: kit.font, align: 'center' }); }\n        } else {\n          s.addText(slide.title, { x: 0.3, y: 0.2, w: 9.5, h: 0.7, fontSize: 26, bold: true, color: white, fontFace: kit.font, valign: 'middle', fill: { color: '082238', transparency: 30 } });\n          if (slide.bullets.length) {\n            s.addText(slide.bullets.map(function (b) { return { text: b, options: { bullet: { code: '25CF', color: kit.colorAccent }, breakLine: true, paraSpaceAfter: 8 } }; }),\n              { x: 0.3, y: 1.15, w: slide.visual ? 3.9 : 8, h: Math.min(4.6, 0.55 * slide.bullets.length + 0.5), fontSize: 18, color: white, fontFace: kit.font, valign: 'top', fill: { color: '082238', transparency: 35 } });\n          }\n        }\n        stageSlides++;\n        return s;\n      }\n\n      deck.slides.forEach(function (slide) {\n        P.check();\n        P.frac(slide.index / deck.slides.length, '組合第 ' + (slide.index + 1) + ' / ' + deck.slides.length + ' 頁:' + slide.title);\n        var prep = session.preps[slide.index];\n        var before = pres.slides.length;\n        if (Core.stageSlide(deck, slide, stageInfo) && !Core.viewportSlide(slide)) {\n          if (slide.chapter !== lastChapter && deck.chapters[slide.chapter].first === slide.index && slide.layout !== 'title' && slide.layout !== 'topic') { kit.addTopicSlide(pres, slide.chapterTitle); before = pres.slides.length; }\n          try { addStageSlide(slide); } catch (e) { console.warn('[deck] pptx stage slide: ' + (e && e.message || e)); }\n        }\n        else if (slide.layout === 'title') { kit.addTitleSlide(pres, slide.title, slide.subtitle || (deck.deck.title !== slide.title ? deck.deck.title : ' ')); }\n        else if (slide.layout === 'topic') { kit.addTopicSlide(pres, slide.title); }\n        else {\n          // a chapter divider the first time a chapter starts (the deck's chapters become the template's topic slides)\n          if (slide.chapter !== lastChapter && deck.chapters[slide.chapter].first === slide.index) { kit.addTopicSlide(pres, slide.chapterTitle); }\n          var s = pres.addSlide(), bg = kit.assetSource('pptxContentBackground');\n          if (bg) { s.background = bg; }\n          s.addText(slide.title, { x: kit.contentHeader.x, y: kit.contentHeader.y, w: kit.contentHeader.w, h: kit.contentHeader.h, fontSize: 28, bold: true, color: kit.colorHeading, fontFace: kit.font, valign: 'middle' });\n          var a = Core.GEO.area, split = slide.layout === 'split';\n          if (slide.bullets.length) {\n            s.addText(slide.bullets.map(function (b) { return { text: b, options: { bullet: { code: '25CF', color: kit.colorAccent }, breakLine: true, paraSpaceAfter: 10 } }; }),\n              { x: a.x * k, y: a.y * k, w: (split ? 790 : a.w) * k, h: a.h * k, fontSize: 20, color: kit.colorBody, fontFace: kit.font, valign: 'top' });\n          }\n          var v = slide.visual;\n          if (v) {\n            var r = Core.visualRect(split ? 'split' : 'visual');\n            if (v.kind === 'table') {\n              var head = v.header.map(function (h) { return { text: String(h), options: { bold: true, color: 'FFFFFF', fill: { color: kit.colorHeading }, fontFace: kit.font, fontSize: 14 } }; });\n              var rows = v.rows.map(function (row) { return row.map(function (c) { return { text: String(c), options: { color: kit.colorBody, fontFace: kit.font, fontSize: 13 } }; }); });\n              s.addTable([head].concat(rows), { x: r.x * k, y: r.y * k, w: r.w * k, border: { type: 'solid', color: 'D0D0D0', pt: 0.5 }, autoPage: false });\n            } else if (v.kind === 'quiz' && window.AiChatDeckQuiz) {\n              // PPTX cannot interact: the card becomes plain text -- the question and options, and, if the viewer answered, \"你的回答\" and\n              // \"我們回應:\" (what the answer key or the AI grader said), so the answers travel with the file\n              var sm = window.AiChatDeckQuiz.summary(v, prep.visual && prep.visual.quiz && prep.visual.quiz.state), runs = [];\n              function line(text, o) { runs.push({ text: text, options: Object.assign({ breakLine: true, fontFace: kit.font, color: kit.colorBody, fontSize: 16 }, o || {}) }); }\n              line(sm.label, { color: kit.colorAccent, bold: true, fontSize: 14 });\n              line(sm.question, { color: kit.colorHeading, bold: true, fontSize: 22, paraSpaceAfter: 8 });\n              sm.options.forEach(function (o) { line(o, { fontSize: 18 }); });\n              if (sm.answered) {\n                line(' ', { fontSize: 8 });\n                line('你的回答', { bold: true, color: kit.colorHeading, fontSize: 16 });\n                line(sm.yours || '(沒有回答)', { fontSize: 16 });\n                line('我們回應:' + (sm.score ? '(' + sm.score + ')' : ''), { bold: true, color: kit.colorAccent, fontSize: 16 });\n                line(sm.reply || '', { fontSize: 16 });\n              }\n              s.addText(runs, { x: r.x * k, y: r.y * k, w: r.w * k, h: r.h * k, valign: 'top', fit: 'shrink' });\n            } else if (v.kind === 'widget') {\n              // an AI-written widget cannot run in PPTX: what it is (its fallback text) and what the viewer got out of it\n              var wst = prep.visual && prep.visual.widget && prep.visual.widget.state || {}, wr = [], res = wst.result;\n              function wline(text, o) { wr.push({ text: text, options: Object.assign({ breakLine: true, fontFace: kit.font, color: kit.colorBody, fontSize: 18 }, o || {}) }); }\n              wline('互動小工具' + (v.title ? ' · ' + v.title : ''), { color: kit.colorAccent, bold: true, fontSize: 14 });\n              wline(v.fallback || '', { fontSize: 20, paraSpaceAfter: 8 });\n              if (res || wst.summary) {\n                wline(' ', { fontSize: 8 });\n                wline('你的結果', { bold: true, color: kit.colorHeading });\n                wline((res ? res.got + ' / ' + res.points + ' 分' : '') + (wst.summary ? (res ? '\\n' : '') + wst.summary : ''));\n                if (res && res.feedback) { wline('我們回應:', { bold: true, color: kit.colorAccent }); wline(res.feedback); }\n              }\n              s.addText(wr, { x: r.x * k, y: r.y * k, w: r.w * k, h: r.h * k, valign: 'top', fit: 'shrink' });\n            } else {\n              var snap = document.createElement('canvas'); snap.width = Math.round(r.w); snap.height = Math.round(r.h);\n              var sctx = snap.getContext('2d');\n              sctx.setTransform(1, 0, 0, 1, -r.x, -r.y);\n              try {\n                Core.renderVisualSnapshot(sctx, slide, prep, r);\n                // a 3D model: the picture is the view through the viewport at the camera angle the viewer has now, over the flat items\n                if (Core.stageSlide(deck, slide, stageInfo)) {\n                  var vp = Core.viewportOf(slide, prep), vc = document.createElement('canvas'); vc.width = Math.round(vp.w); vc.height = Math.round(vp.h);\n                  Core.renderViewportSnapshot(vc.getContext('2d'), deck, slide, stageInfo, vc.width, vc.height);\n                  sctx.setTransform(1, 0, 0, 1, 0, 0); sctx.clearRect(0, 0, snap.width, snap.height);\n                  sctx.drawImage(vc, vp.x - r.x, vp.y - r.y, vp.w, vp.h);\n                  sctx.setTransform(1, 0, 0, 1, -r.x, -r.y);\n                  Core.renderStageFlatLayer(sctx, slide, stageInfo);\n                }\n                s.addImage({ data: canvasToDataUri(snap), x: r.x * k, y: r.y * k, w: r.w * k, h: r.h * k }); } catch (e) { console.warn('[deck] pptx visual: ' + e.message); }\n            }\n          }\n        }\n        // narration + notes of every slide kind go into the speaker notes of the slide just added\n        var added = pres.slides[pres.slides.length - 1];\n        if (added && pres.slides.length > before && (slide.narration || slide.notes) && added.addNotes) { added.addNotes([slide.narration, slide.notes].filter(Boolean).join('\\n\\n')); }\n        lastChapter = slide.chapter;\n      });\n      P.step(2, '正在產生 .pptx 檔並下載…');\n      return pres.writeFile({ fileName: safeName(deck.deck.title) + '.pptx' });\n    }).then(function () { return 'PPTX 已匯出(動畫與轉場不會保留;3D 舞台頁保留當下角度的截圖;旁白在備忘稿)'; });\n  }\n\n  // ------------------------------------------------------------------ yaml / subtitles / bundle\n  function exportYaml(session) {\n    download(new Blob([session.raw], { type: 'application/x-yaml' }), safeName(session.deck.deck.title) + '.deck.yaml');\n    return Promise.resolve('已下載原始描述檔');\n  }\n\n  function exportSubtitles(session, P, format) {\n    return prepareAll(session, P).then(function () {\n      P.step(1, '正在產生字幕…');\n      var text = Core.buildSubtitleFile(session.deck, session.tl, session.preps.map(function (p) { return p.timing; }), format);\n      download(new Blob([text], { type: 'text/plain;charset=utf-8' }), safeName(session.deck.deck.title) + '.' + format);\n      return '字幕已匯出(' + format + ')';\n    });\n  }\n\n  function exportZip(session, P) {\n    var kit = window.AiChatMarkdown && window.AiChatMarkdown.pptxKit;\n    if (!kit) { return Promise.reject(new Error('the zip library loader is not available')); }\n    return prepareAll(session, P).then(function () { P.step(1, '正在載入壓縮元件…'); return Promise.all([kit.ensureLibs(), withZipAudio(session)]); }).then(function () {\n      P.step(1, '正在加入描述檔、字幕與每頁旁白音檔…');\n      var zip = new window.JSZip(), name = safeName(session.deck.deck.title);\n      zip.file(name + '.deck.yaml', session.raw);\n      var timings = session.preps.map(function (p) { return p.timing; });\n      zip.file(name + '.srt', Core.buildSubtitleFile(session.deck, session.tl, timings, 'srt'));\n      zip.file(name + '.vtt', Core.buildSubtitleFile(session.deck, session.tl, timings, 'vtt'));\n      session.preps.forEach(function (p, i) { if (p.audio) { zip.file('audio/' + (i < 9 ? '0' : '') + (i + 1) + '-' + session.deck.slides[i].id + '.mp3', (session.__zipAudio && session.__zipAudio[i]) || p.audio.mp3); } });\n      zip.file('README.txt', 'media-presentation bundle\\n' + name + '.deck.yaml is the source description (open it again in the chat to replay / re-export).\\naudio/*.mp3 is the narration of each slide; the .srt/.vtt are the subtitles on the same timeline.\\n');\n      P.step(2, '正在壓縮…');\n      return zip.generateAsync({ type: 'blob' }, function (meta) { P.frac(meta.percent / 100, '壓縮 ' + Math.round(meta.percent) + '%'); });\n    }).then(function (blob) { download(blob, safeName(session.deck.deck.title) + '.deck.zip'); return '封包已匯出'; });\n  }\n\n  // The whole presentation as one file that opens again (ai_chat_deck_pack.js): description with relative asset paths, the assets, the\n  // narration, the subtitles, and the viewer's answers / scores.\n  function exportPack(session, P) {\n    var Pack = window.AiChatDeckPack, kit = window.AiChatMarkdown && window.AiChatMarkdown.pptxKit, Quiz = window.AiChatDeckQuiz;\n    if (!Pack || !kit) { return Promise.reject(new Error('the pack script is not loaded')); }\n    var name = safeName(session.deck.deck.title), collected;\n    return prepareAll(session, P).then(function () {\n      P.step(1, '正在收集簡報用到的圖片與檔案…');\n      return Promise.all([kit.ensureLibs(), window.AiChat2D.ensureJsYamlLoaded(), withZipAudio(session)]);\n    }).then(function () {\n      return Pack.collectAssets(window.jsyaml.load(session.raw), window.AiChatDeck._internal.fetchBlob, function (done, total) { P.frac(done / Math.max(total, 1), '檔案 ' + done + ' / ' + total); });\n    }).then(function (col) {\n      collected = col; P.step(2, '正在加入描述檔、旁白、字幕與作答紀錄…');\n      var zip = new window.JSZip(), timings = session.preps.map(function (p) { return p.timing; });\n      zip.file('deck.yaml', window.jsyaml.dump(col.doc, { lineWidth: -1 }));\n      col.files.forEach(function (f) { zip.file(f.path, f.blob); });\n      session.preps.forEach(function (p, i) { if (p.audio) { zip.file('audio/' + (i < 9 ? '0' : '') + (i + 1) + '-' + session.deck.slides[i].id + '.mp3', (session.__zipAudio && session.__zipAudio[i]) || p.audio.mp3); } });\n      zip.file('subtitles.srt', Core.buildSubtitleFile(session.deck, session.tl, timings, 'srt'));\n      zip.file('subtitles.vtt', Core.buildSubtitleFile(session.deck, session.tl, timings, 'vtt'));\n      // what the viewer answered: restored when the pack is opened, and readable as it is (\"你的回答\" / \"我們回應:\")\n      var items = {}, readable = [], per = {}, tot = { got: 0, max: 0 };\n      session.quizItems().forEach(function (it) {\n        var n = per[it.slide] || 0, id = session.deck.slides[it.slide].id; per[it.slide] = n + 1;\n        if (!it.pv) { return; }\n        var st = it.v.kind === 'quiz' ? it.pv.quiz.state : it.pv.widget.state, rec = {};\n        Object.keys(st).forEach(function (k) { if (k !== '_r' && k !== 'busy') { rec[k] = st[k]; } });\n        items[id + '#' + n] = rec;\n        if (Quiz) {\n          tot.max += Quiz.points(it.v); if (it.result) { tot.got += it.result.got; }\n          var sm = it.v.kind === 'quiz' ? Quiz.summary(it.v, st) : { label: '互動小工具', question: it.v.fallback, yours: st.summary || '', reply: it.result ? it.result.feedback : '', score: it.result ? it.result.got + ' / ' + it.result.points + ' 分' : '', answered: !!it.result };\n          readable.push({ slide: it.slide + 1, title: session.deck.slides[it.slide].title, label: sm.label, question: sm.question, answered: sm.answered, 你的回答: sm.yours, 我們回應: sm.reply, 得分: sm.score });\n        }\n      });\n      // the last screen of every terminal, with its colours (what MP4 / PPTX show; a reopened pack paints it back, like a refreshed terminal)\n      var terminals = {}, tper = {};\n      session.terminalItems().forEach(function (it) {\n        var n = tper[it.slide] || 0, id = session.deck.slides[it.slide].id; tper[it.slide] = n + 1;\n        var snap = it.tv.handle ? it.tv.handle.snapshot(true) : it.tv.saved;\n        if (snap) { terminals[id + '#' + n] = snap; }\n      });\n      zip.file('results.json', JSON.stringify({ version: 1, total: tot, items: items, terminals: terminals, readable: readable }, null, 1));\n      zip.file('manifest.json', JSON.stringify({ format: Pack.FORMAT, version: Pack.VERSION, title: session.deck.deck.title, slides: session.deck.slides.length, created: new Date().toISOString(), warnings: collected.warnings }, null, 1));\n      zip.file('README.txt', 'media-presentation pack (' + Pack.PACK_EXT + ')\\nOpen it again: drop this file into the AI chat (or attach it) and the presentation plays from the pack alone.\\ndeck.yaml = the description, assets/ = pictures and files it uses, audio/ = narration, results.json = answers and scores.\\n' + (collected.warnings.length ? '\\nNot included:\\n' + collected.warnings.join('\\n') + '\\n' : ''));\n      P.step(3, '正在壓縮…');\n      return zip.generateAsync({ type: 'blob', compression: 'DEFLATE' }, function (meta) { P.frac(meta.percent / 100, '壓縮 ' + Math.round(meta.percent) + '%'); });\n    }).then(function (blob) { download(blob, name + Pack.PACK_EXT); return '簡報封包已匯出' + (collected.warnings.length ? '(' + collected.warnings.length + ' 個檔案無法收進去,見封包內 README.txt)' : ''); });\n  }\n\n  // run(format, session, box, onText): shows the progress card inside `box` (the player), runs the export, resolves with the final message.\n  function run(format, session, box, onText) {\n    if (format === 'yaml') { return exportYaml(session); }\n    if (!STEPS[format]) { return Promise.reject(new Error('unknown export format ' + format)); }\n    var P = makeProgress(box, TITLES[format], STEPS[format], onText), job;\n    switch (format) {\n      case 'mp4': job = exportMp4(session, P); break;\n      case 'pptx': job = exportPptx(session, P); break;\n      case 'pack': job = exportPack(session, P); break;\n      case 'srt': case 'vtt': job = exportSubtitles(session, P, format); break;\n      default: job = exportZip(session, P);\n    }\n    return Promise.race([job, P.forced]).then(function (msg) { P.done(msg); return msg; }, function (err) { P.fail(P.isCancelled() ? '已取消匯出' : '失敗:' + (err && err.message || err)); throw err; });\n  }\n\n  window.AiChatDeckExport = { run: run, STEPS: STEPS, _internal: { safeName: safeName } };\n})(window);\n",css:"/* ---- /media-presentation: the animated slide deck player (ai_chat_deck_player.js) ---- */\n.ai-chat-deck { position: relative; display: block; width: 100%; max-width: 960px; margin: 0.6em 0; border: 1px solid #c8d2dc; border-radius: 8px; background: #0e2841; color: #fff; overflow: visible; outline: none; font-size: 13px; }\n.ai-chat-deck:focus-visible { box-shadow: 0 0 0 2px #77bd1d; }\n.ai-chat-deck-loading { padding: 1.2em; color: #cfd8e3; }\n.ai-chat-deck-error { padding: 1em; background: #fff3f0; color: #8a1f11; border-radius: 6px; }\n.ai-chat-deck-error pre { white-space: pre-wrap; margin: 0.4em 0 0; font-size: 12px; }\n.ai-chat-deck-bar { display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: #0e2841; border-radius: 8px 8px 0 0; position: relative; z-index: 30; cursor: default; }\n/* the bar (and so its export menu) stays above everything laid over the stage: widget frames / start buttons (z 5-6), hold banner and toast (6-7) */\n.ai-chat-deck.floating .ai-chat-deck-bar { cursor: move; touch-action: none; user-select: none; }\n.ai-chat-deck-title { flex: 1; min-width: 0; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.ai-chat-deck-chapters, .ai-chat-deck-speed { max-width: 190px; background: #16385a; color: #fff; border: 1px solid #2f567f; border-radius: 4px; padding: 2px 4px; font-size: 12px; height: auto; width: auto; }\n.ai-chat-deck-btn { background: #16385a; color: #fff; border: 1px solid #2f567f; border-radius: 4px; padding: 2px 8px; cursor: pointer; font-size: 13px; line-height: 1.5; height: auto; width: auto; margin: 0; }\n.ai-chat-deck-btn:hover { background: #1f4d7a; }\n.ai-chat-deck-btn.off { opacity: .45; text-decoration: line-through; }\n.ai-chat-deck-stage { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; }\n.ai-chat-deck-canvas { display: block; width: 100%; height: 100%; object-fit: contain; }\n.ai-chat-deck-zone { position: absolute; top: 0; bottom: 0; width: 12%; border: 0; background: transparent; color: #fff; font-size: 44px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity .15s, background .15s; margin: 0; padding: 0; height: auto; text-shadow: 0 0 6px #000, 0 0 2px #000; }\n.ai-chat-deck-zone-prev { left: 0; }\n.ai-chat-deck-zone-next { right: 0; }\n.ai-chat-deck-zone:hover { background: rgba(14,40,65,.14); }\n.ai-chat-deck-stage:hover .ai-chat-deck-zone { opacity: .85; }\n.ai-chat-deck-zone.disabled { opacity: 0 !important; cursor: default; }\n.ai-chat-deck-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; background: rgba(14,40,65,.72); color: #fff; font-size: 16px; }\n.ai-chat-deck-bigplay { width: 84px; height: 84px; border-radius: 50%; border: 3px solid #fff; background: #77bd1d; color: #fff; font-size: 38px; cursor: pointer; padding: 0 0 0 6px; margin: 0; }\n.ai-chat-deck-bigplay:hover { background: #8fd62a; }\n.ai-chat-deck-controls { display: flex; align-items: center; gap: 8px; padding: 6px 10px; background: #0e2841; }\n.ai-chat-deck-progress { position: relative; flex: 1; height: 8px; background: #2f567f; border-radius: 4px; cursor: pointer; }\n.ai-chat-deck-progress-fill { height: 100%; width: 0; background: #77bd1d; border-radius: 4px; }\n.ai-chat-deck-tick { position: absolute; top: -3px; width: 2px; height: 14px; background: #fff; opacity: .7; }\n.ai-chat-deck-time { font-variant-numeric: tabular-nums; white-space: nowrap; color: #cfd8e3; }\n.ai-chat-deck-dots { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 10px; background: #0e2841; }\n.ai-chat-deck-dot { width: 10px; height: 10px; border-radius: 50%; background: #2f567f; cursor: pointer; }\n.ai-chat-deck-dot.loading { background: #c9a227; animation: ai-chat-deck-pulse 1s infinite; }\n.ai-chat-deck-dot.ready { background: #77bd1d; }\n.ai-chat-deck-dot.warn { box-shadow: 0 0 0 2px #e8590c; }\n.ai-chat-deck-dot.current { transform: scale(1.5); outline: 2px solid #fff; }\n@keyframes ai-chat-deck-pulse { 50% { opacity: .4; } }\n.ai-chat-deck-status { padding: 4px 10px 8px; color: #9fb4c9; font-size: 12px; border-radius: 0 0 8px 8px; }\n.ai-chat-deck-menu { position: absolute; top: 100%; right: 8px; z-index: 31; display: flex; flex-direction: column; background: #fff; color: #222; border: 1px solid #c8d2dc; border-radius: 6px; box-shadow: 0 6px 20px rgba(0,0,0,.3); padding: 4px; }\n.ai-chat-deck-menu-item { text-align: left; background: transparent; border: 0; padding: 6px 12px; cursor: pointer; font-size: 13px; color: #222; white-space: nowrap; height: auto; width: auto; margin: 0; }\n.ai-chat-deck-menu-item:hover { background: #eaf2fa; }\n.ai-chat-deck-placeholder { margin: 0.6em 0; border: 1px dashed #9fb4c9; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #6a7f95; font-size: 13px; }\n/* floating window: draggable by its title bar, resizable horizontally (the stage keeps 16:9) */\n.ai-chat-deck.floating { position: fixed; z-index: 100000; width: 640px; min-width: 320px; max-width: 96vw; resize: horizontal; overflow: auto; box-shadow: 0 10px 40px rgba(0,0,0,.45); margin: 0; }\n.ai-chat-deck:fullscreen { max-width: none; width: 100vw; height: 100vh; border: 0; border-radius: 0; display: flex; flex-direction: column; background: #000; }\n.ai-chat-deck:fullscreen .ai-chat-deck-stage { flex: 1; aspect-ratio: auto; min-height: 0; }\n.ai-chat-deck:fullscreen .ai-chat-deck-dots, .ai-chat-deck:fullscreen .ai-chat-deck-status { display: none; }\n.ai-chat-deck-canvas.interactive { cursor: grab; touch-action: none; }\n.ai-chat-deck-canvas.interactive.dragging { cursor: grabbing; }\n.ai-chat-deck-canvas.dragging-ui { cursor: grabbing; }\n.ai-chat-deck-zone.narrow { width: 3%; }\n.ai-chat-deck-score { color: #fff; font-size: 12px; white-space: nowrap; padding: 0 6px; }\n/* real DOM laid over the canvas by design-unit rectangles: the shell of a terminal visual / card, the text box of a short or open answer */\n.ai-chat-deck-toast { position: absolute; z-index: 7; left: 50%; bottom: 14%; transform: translateX(-50%); max-width: 90%; padding: 8px 16px; border-radius: 10px; background: rgba(214, 69, 69, .95); color: #fff; font-size: 13px; pointer-events: none; box-shadow: 0 2px 10px rgba(0,0,0,.4); }\n.ai-chat-deck-hold { position: absolute; z-index: 6; left: 50%; top: 2%; transform: translateX(-50%); padding: 6px 16px; border-radius: 18px; background: rgba(232, 137, 12, .95); color: #fff; font-size: 14px; font-weight: 700; pointer-events: none; white-space: nowrap; box-shadow: 0 2px 10px rgba(0,0,0,.4); }\n.ai-chat-deck-host { position: absolute; z-index: 5; box-sizing: border-box; margin: 0; }\n.ai-chat-deck-host-term { background: #000; overflow: hidden; }\n.ai-chat-deck-widget-start { display: flex; align-items: center; justify-content: center; background: rgba(14, 40, 65, .62); border-radius: 8px; z-index: 6; }\n.ai-chat-deck-widget-start-btn { padding: 14px 34px; border: 3px solid #fff; border-radius: 40px; background: #77bd1d; color: #fff; font-size: 22px; font-weight: 700; cursor: pointer; margin: 0; height: auto; }\n.ai-chat-deck-widget-start-btn:hover { background: #8fd62a; }\n.ai-chat-deck-widget-start-count { border: 0; background: transparent; color: #fff; font-size: 96px; font-weight: 800; line-height: 1; margin: 0; padding: 0; height: auto; text-shadow: 0 4px 24px rgba(0,0,0,.6); cursor: default; }\n.ai-chat-deck-host-widget { border: 0; background: #fff; border-radius: 8px; }\n.ai-chat-deck-host-term .xterm-viewport { overflow-y: auto; }\n/* the terminal reuses the chat's .ai-chat-terminal-container (min-width 640px, height 520px, padding): inside a slide it is sized only by the slide's rectangle,\n   otherwise a narrow player would let it spill over the card and hide its buttons */\n.ai-chat-deck .ai-chat-deck-host.ai-chat-terminal-container { position: absolute; min-width: 0 !important; min-height: 0 !important; max-width: 100%; max-height: 100%; padding: 2px; border-radius: 0; overflow: hidden; }\n.ai-chat-deck .ai-chat-deck-host-term .xterm, .ai-chat-deck .ai-chat-deck-host-term .xterm-screen { max-width: 100%; max-height: 100%; }\n.ai-chat-deck-host-input { background: transparent; border: 0; outline: none; resize: none; padding: 0.5% 1%; font-family: inherit; color: #333; }\n\n/* export progress card (ai_chat_deck_export.js): steps, bars, what is happening, time left, Cancel */\n.ai-chat-deck-export-card { position: absolute; z-index: 20; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(520px, 92%); box-sizing: border-box; padding: 14px 16px; background: #0b2236; color: #fff; border: 1px solid #2f567f; border-radius: 10px; box-shadow: 0 10px 40px rgba(0,0,0,.55); }\n.ai-chat-deck-export-card.failed { border-color: #e8590c; }\n.ai-chat-deck-export-title { font-weight: 700; font-size: 15px; margin-bottom: 8px; }\n.ai-chat-deck-export-bar { height: 10px; background: #2f567f; border-radius: 5px; overflow: hidden; }\n.ai-chat-deck-export-bar.small { height: 6px; margin-top: 8px; opacity: .85; }\n.ai-chat-deck-export-bar-fill { height: 100%; width: 0; background: #77bd1d; transition: width .2s; }\n.ai-chat-deck-export-card.failed .ai-chat-deck-export-bar-fill { background: #e8590c; }\n.ai-chat-deck-export-overall { margin: 6px 0; font-size: 12px; color: #9fb4c9; }\n.ai-chat-deck-export-steps { list-style: none; margin: 4px 0; padding: 0; }\n.ai-chat-deck-export-steps li { padding: 3px 0; font-size: 13px; color: #9fb4c9; display: flex; gap: 8px; }\n.ai-chat-deck-export-steps li.running { color: #fff; font-weight: 600; }\n.ai-chat-deck-export-steps li.done { color: #77bd1d; }\n.ai-chat-deck-export-icon { width: 1.2em; text-align: center; }\n.ai-chat-deck-export-detail { margin-top: 6px; min-height: 1.4em; font-size: 12px; color: #cfd8e3; word-break: break-all; }\n.ai-chat-deck-export-actions { margin-top: 10px; text-align: right; }\n\n/* kind \"video\": the <video> with its own control bar (see makeVideoHost) */\n.ai-chat-deck-host-video { background: #000; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }\n.ai-chat-deck-host-video .ai-vd-video { flex: 1 1 auto; min-height: 0; width: 100%; background: #000; }\n.ai-vd-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 6px 8px; background: #101820; color: #E6EDF3; font-size: 13px; }\n.ai-vd-btn { padding: 3px 9px; border-radius: 6px; border: 1px solid #3a4756; background: #1b2633; color: #E6EDF3; cursor: pointer; font-size: 13px; }\n.ai-vd-btn:hover { background: #26364a; }\n.ai-vd-seek { flex: 1 1 140px; min-width: 100px; accent-color: #77BD1D; }\n.ai-vd-time { font-size: 12px; opacity: .85; white-space: nowrap; }\n.ai-vd-sel, .ai-vd-num { background: #1b2633; color: #E6EDF3; border: 1px solid #3a4756; border-radius: 6px; padding: 2px 4px; font-size: 13px; }\n.ai-vd-num { width: 46px; }\n.ai-vd-note { padding: 2px 10px 6px; font-size: 12px; color: #9FD34F; background: #101820; min-height: 16px; }\n",topics:{format:'A deck is YAML: {deck: {title, lang (zh-TW|en|...), voice?, captions? (original = default: when the app has to translate a slide\'s narration so that the voice can read it, the subtitles keep the text you wrote | spoken = subtitles follow what is spoken), bullets? (highlight = default: a point shows up just BEFORE it is read and is highlighted while it is read | preview = all points on screen from the start, dimmed, the one being read highlighted | legacy = a point appears when its sentence starts), speed? 0.5-2 = speaking speed, 1.5 = 1.5x faster (set it when the user asks for a faster/slower voice)}, chapters: [{title, slides: [slide...]}]}.\nslide: {id?, layout?, title, subtitle? (title slides), bullets? [<=6 short strings], narration? (what is SPOKEN; also the subtitles unless caption is given), caption? (the SUBTITLE text, when it must differ from what is spoken: Chinese subtitles under an English voice -- write narration in English and caption in Chinese, same number of sentences, in the same order),\nvisual?, cues? [..], transition? {type, ms}, duration? (seconds; only for silent slides), notes? (speaker notes, PPTX only)}.\nlayout (optional, inferred): title (opening slide: title + subtitle), topic (a big chapter-divider title), content (bullets),\nsplit (bullets left + visual right), visual (the visual fills the slide). Slide 1 is normally a title slide; start each chapter\nwith a topic slide only when the chapter is long.\ntransition.type: fade (default) | slide-left | slide-right | push | zoom | wipe | curtain | spin | fly | none; ms 100-3000 (default 500; 1400\nbetween 3D slides). It describes how THIS slide enters. Vary them a little; use one style for slides in the same chapter and a different\none at a chapter start. Between 3D slides fly (the camera flies to the next slide\'s shot; the default there) is the native one, spin\n(the model turns away and the next one turns in) also works, and curtain only closes real curtains in the opera environment;\nfade works everywhere.\n3D: deck.style: flat (default) | 3d sets the look of every slide, slide.stage overrides it for one slide, so flat and 3D slides can be\nmixed in one deck. deck.environment (3d only): template (default: follows the company slide template -- light floor on the white page, navy behind title\nslides) | studio (dark) | opera (a theatre with curtains and spotlights, only if the user asks) | space.\nRead get_presentation_topic("3d") before using 3D.\nSizes: <=150 slides, <=30 chapters, narration <=1200 characters, bullets <=220 characters, one deck plays for at most ~75 minutes\n(counted with the speaking speed). A long talk (30 minutes = 50-70 slides) is still ONE deck: write it chapter by chapter with\nbegin_presentation / add_chapters / finish_presentation instead of one huge render_presentation call.\ndeck.colors (optional): this deck\'s own page colours over the template, a mapping of any of heading (titles), body (text), accent (bars, bullets, subtitles), soft (frames), dark (title / chapter slide background), stripe (table row tint), contentBg (content slide background), titleText, subtitleBar, subtitleText -- values "#RRGGBB" or "rgba(r,g,b,a)". Use it whenever the user asks for a look (warm / cute / dark / company colours). Warm example: colors: {contentBg: "#FFF4E6", dark: "#8D4B2F", heading: "#8D4B2F", body: "#5B4636", accent: "#FF8A65", soft: "#FFE0B2", stripe: "#FFF0DA", subtitleBar: "rgba(141,75,47,0.85)"}. A deck with colors also hides the template\'s background pictures and logo. (The PPTX export keeps the template colours.) Optional first line `#!fa:deck` (a YAML comment, like a shebang) declares the file\'s purpose; the app adds it when saving. Never write a marker for another kind (#!fa:scene3d, #!fa:anim2d) in a deck.',layout:"Picking a layout: opening -> title. Chapter start -> topic (title only, short narration) or fold the chapter name into the\nfirst content slide. A list of points -> content (<=4 bullets is best; the viewer reveals them one by one with the narration).\nPoints + a picture/diagram/table -> split (bullets stay short: the visual carries the detail). A big diagram, a wide table or\na screenshot -> visual. Last slide: a summary/next-steps content slide.\nRhythm: 25-40 seconds of narration per slide (~2-5 short sentences, about 60-180 CJK characters); a 5-minute talk is ~8-12 slides.",visuals:'visual: {kind, mode? (loop|timed, default loop), period? (seconds of one loop), motion? (none|float|pulse|spin|kenburns), ...}\nEvery visual is ALWAYS in motion or revealed over time (this is an animated slide, never a dead picture):\n  shapes   {scene: {width, height, duration, background, shapes: [...]}} -- the same format as a 2D animation: circle/rect/polygon/\n           line/text/image shapes, each with an optional "id" and an "animation" (move/rotate/scale/fade/orbit/keyframes). Best for\n           explanatory diagrams you draw yourself (flows, layers, a signal moving along a path). Give shapes ids and reveal them\n           with cues (show: "shape:<id>"). Call get_2d_animation_topic-style details from the 2D animation vocabulary: "position":[x,y],\n           circle "radius", rect "width"/"height", line/polygon "points":[[x,y],...], text "content"/"font_size", "fill", "stroke",\n           "stroke_width", animation {type: move, from:[x,y], to:[x,y], duration:s, loop: true|pingpong} {type: rotate, speed: deg/s}\n           {type: orbit, center:[x,y]|parent:id, radius, speed} {type: scale, min, max, speed} {type: fade, from, to, duration, loop}\n           {type: keyframes, keyframes:[{t, position, rotation, scale, opacity}]}.\n  mermaid  {source: "flowchart LR; A[Start]--\x3eB[Next]"} -- flowcharts, sequence, state, class diagrams. Drawn once, gently floating; reveal with cue\n           show: visual. Keep labels short (<= 12 characters). Put every label that has a / \\ ( ) or other\n           punctuation in double quotes: A["/help"] --\x3e B["設定 (選填)"] (a bare [/help] is read as a shape and fails).\n  svg      {svg: "<svg viewBox=...>...</svg>"} inline markup (no scripts) or {src: url of an .svg}.\n  chart    {src: url returned by render_chart}.\n  table    {header: [..], rows: [[..],..]} (<=8 columns, <=12 rows, cells <=120 characters). Rows appear one by one (or cue "row:N").\n           Long tables: split over several slides ("... (1/2)", "... (2/2)"), or keep the 3-5 rows that matter and say so in the narration.\n  collage  A STAGE like a game scene or a children\'s picture book ("this is a spider, this is a monkey"): several pictures placed freely (they may overlap), each one POPS IN\n             when its sentence is read.  visual: {kind: collage, items: [...], camera?, scenes?, texts?, sounds?}   positions are fractions of the visual area (x, y = left / top edge, w = width).\n             item: {src: "@img1", x, y, w, rot? (tilt, degrees), z? (higher = in front), label? (name tag under it), ring? (circle | box: a coloured outline DRAWN around it),\n             swing? (true = 10 degrees, or 0..30: turns slowly left and right), bob? (it hops while it moves: a running animal), alpha? (0.45 = see-through house; card: false = no white sticker),\n             at? (seconds or {sentence: N, offset?}; default: the sentence with the same number as the picture), enter? (pop | fade | none),\n             scene? (the scene it belongs to), keys? [{at, sec?, x?, y?, alpha?, scale?, rot?}] (it moves / fades / scales to each keyframe, arriving at "at", the move lasting "sec"),\n             say? [{text, sentence | at, sec?}] (speech bubbles: dialogue), sfx? (false | {enter, move, say}: sound effect names)}.\n             camera: [{at, sec?, zoom (1..5), x, y}]  zoom INTO a place of the stage and back out (the pictures, bubbles, rings move with it).\n             scenes: [{scene}, {scene, at, effect (fade | zoom | cut), sec?}]  the first is the starting scene; the pictures with scene: <name> show only in their scene\n             (no scene = always), the switch cross-fades (zoom = the old scene grows and fades while the new one comes up from small: "going into the house").\n             texts: [{text, sentence | at, sec?, style (narrative = a storybook panel typed out | title | shout = big comic lettering such as "POW!"), pos (top | center | bottom)}]\n             sounds: [{sfx, sentence | at, offset?, vol?}] sound effects mixed with the narration (pop, boing, whoosh, thump, knock, step, wind, ding, sparkle, growl, bell, splat);\n             the pictures make their own: a pop when they pop in, footsteps while a bob picture moves, whoosh for moves with sfx.move: whoosh.\n             Example (three little pigs): a see-through house (alpha 0.45, keys: fade to 0 when we go in, back to 1 when we come out) with three pigs inside; camera zooms into the house while\n             each pig says its line (say), then zooms out, the house wall fades in and the wolf (x: -0.3, bob: 18, keys: move to x: 0.03) runs in from the left and says "I will blow your house down!".\n  image    {src: "@img3"} or {images: [{src, caption}], fit?: contain|cover, callouts?: [{x,y,w,h (fractions 0..1 of the picture), text}]}\n           -- a real picture from a source (see "sources"). Several images take turns every <period> seconds (a slideshow), or use\n           cue show: "image:N". callouts draw an orange box (+label) on the picture and appear with cue show: "callout:N" -- use them\n           to point at the part of a screenshot the narration is talking about. motion kenburns = a slow zoom.\n  anim2d   {ref: "client-file/<file_id>" of an uploaded .2danim.yaml}. (Normally draw with kind shapes instead.)\n  scene3d  a LIVE 3D model animation: {scene: {nodes: [...]} inline (vocabulary: get_3d_scene_topic), or ref: "client-file/<file_id>" of an uploaded .3dscene.yaml,\n           interactive?: true, orbit?: seconds}. The viewer can drag to orbit and wheel to zoom it. See get_presentation_topic("3d").\n  group    several visuals side by side in one slide: {items: [{box: [x, y, w, h] (fractions 0..1 of the visual area), kind: ..., ...}, ...]}\n           -- up to 4, e.g. a 3D model next to a table, or a screenshot next to a flowchart. Cues bullet:/row:/callout:/image:/shape: address\n           the first element of that kind in the slide.\n  code     {code: "<the text>" | src: url of a text attachment, lang?: c|python|js|bash|json|yaml|sql|diff..., filename?, patch?: true|false,\n           size?: 14..44, start_line?, highlight?: [12, [20,25]], autoscroll?: true|seconds} -- a LONG listing or a patch/diff in a\n           scrollable window with line numbers, syntax highlighting and a scrollbar (the viewer scrolls it; MP4 shows it scrolling by itself\n           when autoscroll is on; PPTX gets a picture of the current view). A git patch / unified diff is recognised by itself (green/red\n           lines, hunk headers, each file highlighted in its own language). USE THIS whenever the material is code, a log or a patch longer\n           than ~12 lines: do not cut it into bullets or screenshots. Give the text with define_snippet(kind: "code", content: ...) and write code: "@c1" (a patch: define_snippet(kind: "patch") -> code: "@p1"; no yaml escaping). Put the part you talk about on screen with start_line / highlight.\n  terminal {commands?: ["ls", "echo hi"], title?, interactive?: true|false} -- a REAL shell (busybox ash in the browser) in the slide:\n           the commands are typed and run when the slide is first shown, then the viewer can type. MP4 / PPTX show its current screen.\n           The deck WAITS at the end of the slide until the viewer has typed a command (they were asked to): for a terminal that only\n           demonstrates (nobody types) set wait: false, or interactive: false. Ask in the narration what to type.\n  quiz     an interactive answer card (Q&A, scored): see get_presentation_topic("interactive").\n  widget   YOUR OWN interactive piece (a game, a simulator, a drag-and-drop exercise) as one HTML document in a sandbox:\n           see get_presentation_topic("interactive").\n  video    an embedded video the viewer controls: play / pause, replay, fast-forward (seek bar, +-5 s), playback speed, and an A-B loop that\n           repeats one part N times. src is a client-file/<id> (an attached mp4), an https url or a wiki attachment url. Fields:\n           start / end (seconds: play only that part), speed (initial, default 1) and speeds (the speed menu, default [0.5,0.75,1,1.25,1.5,2]),\n           loop: {from, to, times} (starts looping that part: times rounds, then it plays on; times 0 = until the viewer clears it; the viewer can\n           also set A / B with buttons while watching), autoplay, muted, controls (false hides the bar), title, poster (an image; default is a frame\n           of the video), fallback (1-2 sentences: what the video shows; PPTX / MP4 cannot play it), wait (default true: the deck holds at the end\n           of the slide until the video was watched -- ended once or its loop finished -- or the viewer pages on), transcript (what is said in it).\n           YOU CANNOT HEAR THE VIDEO: never invent what is said or shown. For "watch this, then answer" slides use TWO slides: the video slide\n           (narration = a short setup: "watch carefully, what is he shouting?"), then a quiz slide (type short / open) whose reference / rubric\n           comes from the transcript the user gave you or from the user\'s own answer to your question. If you have neither, ask the user.\n  overlay  on ANY visual (also on a 3D model): overlay: {scene: {width, height, shapes: [...]}} -- a 2D layer (same shapes format as kind\n           "shapes") drawn over it: labels, arrows, circles and highlights that appear with cues (show: "shape:<id>"). This is how 2D annotation\n           is mixed with 3D.',"3d":'2D and 3D mix in the SAME format; 3D is a look you give a slide, not a different kind of deck.\n- A 3D model: visual {kind: scene3d, scene: {duration, background, camera, nodes: [...]}} written inline (call get_3d_scene_topic for\n  the vocabulary; it is a declarative node list: box/sphere/cylinder/cone/torus/polygon/particles..., each with\n  position, material and an animation spin/bounce/orbit), or ref: "client-file/<file_id>" of an uploaded .3dscene.yaml. Keep it to ~5-25 nodes. It animates with the slide clock and the viewer can\n  drag to orbit / wheel to zoom it.\n- A 3D SLIDE: deck.style: 3d (all slides) or stage: 3d on single slides, with a scene3d visual. The slide is the SAME company-template page as a flat\n  slide (title, chapter label, green-dot bullets, subtitle bar); the model is shown in a VIEWPORT (a rounded window) where a flat slide has\n  its visual, and the slide\'s CAMERA looks into the 3D scene through it. The slide says where the camera is:\n    camera: front | three-quarter (default) | left | right | back | top | wide | closeup        one shot, by name\n    camera: {preset?, azimuth: -360..360 (deg, 0 = in front, + = to its right), elevation: 0..89 (deg), distance: 0.1..6 (x the distance that\n             frames the whole model; < 1 closer), focus: <id of a node of the model>, fov: 20..80, at?: "sentence:N" | "sec:S"}\n    camera: [shot, shot, ...]    up to 8 shots: the camera moves (about 1.2 s, eased) from one to the next while the narration goes on; a\n             shot with at: starts then, the others share the narration evenly, the first starts the slide.\n  The relation between camera and model is the point of a 3D slide: name the part you are talking about (focus: <node id>, e.g. the id of\n  the fan node in the scene you made) and put it in the shot at the sentence that mentions it (at: "sentence:2"); show the whole thing\n  first (wide / three-quarter), then close in (closeup + focus), then pull back for the next idea. closeup without a focus just comes closer.\n  Between two 3D slides the camera flies (transition fly). The viewer can still drag / wheel on top of the shot; it snaps back when the slide\n  changes. Title / topic slides with a model are full-bleed 3D on the template\'s navy.\n  Everything else keeps working in a 3D slide (title, bullets, subtitles, tables, images, 2D shapes, group items are drawn flat):\n    a 3D slide:   {stage: 3d, title, bullets (short: the viewport is on the right), visual: {kind: scene3d, scene: {...}}, camera, narration, cues}\n    3D + 2D:      visual: {kind: scene3d, scene: {...}, overlay: {scene: {width: 977, height: 690, shapes: [{id: tag1, type: text, content: "CPU", position: [480, 300], ...}]}}}\n                  with cues [{at: "sentence:2", show: "shape:tag1"}] -- 2D labels that appear over the viewport (the overlay is fixed to the\n                  window, it does not follow the 3D part when the camera moves; keep overlay labels for shots that stay still).\n    side by side: visual: {kind: group, items: [{box: [0.0, 0, 0.6, 1], kind: scene3d, scene: {...}}, {box: [0.62, 0.1, 0.38, 0.8], kind: table, header, rows}]}\n                  (the 3D item\'s box is the viewport; the other items are flat panels at their boxes).\n- In a flat slide (no stage) a scene3d visual is a live 3D view inside the usual visual area, slowly orbiting (orbit: false stops it).\n- Choose 3D when the subject IS a thing in space (hardware, a board, a mechanism, a topology, an architecture as blocks) -- not for\n  text-only slides. A deck can open flat, show 3D slides for the physical parts and return to flat for tables and summaries.\n- Without WebGL (or when the 3D view cannot start) a deck still plays: 3D slides fall back to the flat look and a 3D model is drawn by a\n  software renderer.',cues:'cues sync the picture with the narration: [{at: "sentence:N" | "sec:S", show|emphasize: TARGET, effect?: fade|rise|pop|wipe|pulse, ms?}].\nat: sentence:N is the START of the Nth sentence of the narration (1-based; sentences end at 。！？.!?；). TARGET: title | visual | bullet:N\n(0-based) | row:N | callout:N | image:N | shape:<id>. "show" makes the element appear at that moment (hidden before); "emphasize"\npulses an element that is already there.\nBullets with no cue are revealed one per sentence automatically (skipping an introductory first sentence), table rows one after\nanother -- write cues only when you want something else. Write the narration so that its sentences line up with what appears:\nsentence 1 introduces, sentence 2 -> bullet 0, sentence 3 -> bullet 1 ...',interactive:'Interactive pieces: the viewer DOES something on the slide. Three kinds -- all work with narration, cues and layouts like any visual,\nand in PPTX / MP4 they turn into static text / a picture (the PPTX gets the question, "你的回答" and "我們回應:" when the viewer answered).\n\nTHE WHOLE DECK HAS THIS SHAPE (copy it; a deck with slides at the top level, or without deck: and chapters:, is refused):\n  deck: {title: 互動示範, lang: zh-TW, speed: 1.2}\n  chapters:\n    - title: 內容\n      slides:\n        - title: 開場\n          narration: 一到三句短句。\n        - title: 這一頁的重點\n          narration: 旁白。\n          visual: {kind: code, lang: c, code: "@c1"}\nLeave out layout, cues and transition unless you need them (a transition is a mapping {type: fade, ms: 500}, never a bare word; types:\nfade slide-left slide-right push zoom wipe curtain spin fly none). Fewer fields = fewer errors.\n\n1) quiz -- an answer card with a score.\n  {kind: quiz, type: choice|multi|short|open|terminal, question, options?: [2-6], answer?, accept?: [..], explain?, points?: 10,\n   grading?: static|ai, reference?, rubric?, check?, terminal?, wait?: true}\n  - choice: options + answer: 1 (0-based index or the option text). multi: answer: [0, 2] (partial credit, wrong picks subtract).\n  - short: answer: "text" (also accept: ["alt", "/regex/i"]); typed answers match ignoring case, spaces and punctuation.\n  - open: free text, graded by an AI against reference (the model answer) and rubric (what earns points).\n  - terminal: a task done in a real shell inside the card: terminal: {commands: [setup lines]}, check: {output: "/regex over the screen/",\n    cmd: "/regex over what was typed/"} (each check is an equal share of the points), or grading: ai.\n  - grading: static (default when there is an answer key: instant, offline) | ai (default for open; a model scores 0..1 with feedback).\n  - explain: shown after grading. An answer card always makes the deck WAIT at the end of its slide until the viewer submits (or pages on with ›); wait: false lets the deck run past it. A widget does not wait unless you set wait: true.\n  One card per slide (or one item of a group). Put the question on the slide, ask it in the narration, and say what happens next.\n  THE VIEWER MUST SEE WHAT THE QUESTION IS ABOUT. A question about code, a patch, a log, a diagram or a table is put on the SAME slide as\n  that material -- never "in the patch above" on a slide that shows only the options. Use a group: code (or image/table) on the left, the\n  card on the right, e.g.\n    visual: {kind: group, items: [{box: [0, 0, 0.56, 1], kind: code, patch: true, code: "..."},\n                                   {box: [0.58, 0, 0.42, 1], kind: quiz, question: "...", options: [...], answer: 1}]}\n  (quote only the few lines the question needs, so the card stays readable.) A card alone on a slide gets the whole area.\n  The wrong options of a code / patch question must differ CLEARLY from the right one -- never the same line with one identifier changed\n  ("Node *new = f(v);" vs "Node *new_node = f(v);" confuses everybody: if the patch renames it, ask about something else), and never a line the\n  patch also adds or changes somewhere else. A patch with an identical line removed and added is refused.\n  Write questions with exactly ONE right answer that can be worked out from what is on screen, and make `explain` agree with `answer`\n  (re-read both before you finish: the answer index is 0-based, the first option is 0). For "which line was added?" make exactly one option\n  an added line and the others unchanged or removed lines.\n  A patch you write (kind code) must be a real unified diff: "diff --git a/f b/f", "--- a/f", "+++ b/f", hunk headers "@@ -12,6 +12,8 @@",\n  context lines start with ONE SPACE, removed lines with "-", added lines with "+". Never remove and re-add the identical line.\n  A quiz deck: 1 explanation slide, then 1 card slide, repeat; end with a summary slide (the viewer sees the running score in the player).\n\n2) terminal -- {kind: terminal, commands: [...]} a real shell the viewer can type into (see "visuals").\n\n3) widget -- you write the interactive piece yourself, like making a small game.\n  FIRST call define_snippet(kind: "widget", content: <the full html>) -- the html is its own tool argument, NOT inside the yaml (a game\n  inside a yaml string means escaping every quote and backslash twice, and it fails again and again). It checks the html at once and\n  returns a handle "@w1". THEN in the deck yaml:\n  {kind: widget, html: "@w1", fallback: "what it is and what the viewer does (1-3 sentences)",\n   title?, points?: 100, wait?: false, start?: countdown|click|auto, grade?: {question, reference|rubric}}\n  START: the viewer sees a "點一下開始" button first (over the card that shows your fallback text), clicks, a 3-2-1 countdown runs, and only\n  THEN is your html loaded -- so the game\'s clock and first frame start at that moment (start: click = no countdown, auto = at once). Do not\n  write your own start screen or timer for this; just start the game when your script runs.\n  THE CAGE: the html runs in a sandboxed iframe. NO network (no fetch / XMLHttpRequest / WebSocket, no <script src>, no <link>, no http(s)\n  url, no @import), no localStorage / cookies / parent page, no nested frames. Everything is inline: <style>, <script>, <canvas>/SVG/DOM;\n  images only as data: uris (or draw with canvas). Max 120000 characters. The validator refuses anything else and tells you which.\n  Fill the iframe: use width/height 100% (canvas sized from window.innerWidth/innerHeight, redraw on resize). Support mouse AND touch\n  AND keyboard (arrow keys, space) because the viewer may use any. Give a visible score and a restart button. The page is white by\n  default; style it (dark game backgrounds are fine). Text in the viewer\'s language (deck.lang).\n  THE BRIDGE: a global `deck` exists:\n    deck.points          the points the widget is worth (the slide\'s "points", default 10) -- the score it can reach\n    deck.score(got, max?, feedback?)  report the CURRENT score (0..points; if max is given it is rescaled to points); call it every\n                         time the score changes, not only at the end. Reaching `points` counts as a win.\n    deck.done()          the viewer finished (won, lost or gave up)\n    deck.summary(text)   one line shown on the slide card / in PPTX ("通關!用了 42 秒")\n    deck.save(obj) / deck.onInit(function(saved){...})   keep a small JSON state (restored when the pack is opened again)\n    deck.grade(answerText) -> Promise<{score 0..1, feedback}>  ask the AI grader to judge free text (needs the "grade" setting;\n                         at most 20 per widget) -- for exercises like "explain this in your own words" inside your own UI.\n  Ideas: a game that must reach N points to win (breakout / space shooter / invaders; each hit scores a random 5-15), a sorting or\n  matching game, a circuit / state-machine simulator the viewer pokes, a timeline to drag events into order, a parameter slider that\n  shows a result live, a flash-card round. Make it tied to the talk\'s subject, playable in 30-90 seconds, forgiving (no instant\n  game over without a restart button).\n  Example -- "win 100 points at breakout, each brick gives a random 5-15" (compact; adapt, do not shrink the feedback and restart).\n  Step 1, define_snippet(kind: "widget", content: the html between the two marker lines):\n  --- widget html begin ---\n    <canvas id=c style="display:block;width:100%;height:100%;background:#0b1626"></canvas>\n    <script>\n    var c=document.getElementById(\'c\'),x=c.getContext(\'2d\'),W,H,pad,ball,bricks,score,over;\n    function reset(){W=c.width=innerWidth;H=c.height=innerHeight;pad={x:W/2,w:W*0.18,y:H-30};\n      ball={x:W/2,y:H-60,vx:3.2,vy:-4.2,r:8};bricks=[];score=0;over=false;var cols=8,rows=5,bw=W/cols;\n      for(var i=0;i<cols;i++)for(var j=0;j<rows;j++)bricks.push({x:i*bw+2,y:50+j*26,w:bw-4,h:22,alive:true,pts:5+Math.floor(Math.random()*11)});\n      deck.score(0);}\n    function step(){if(!over){ball.x+=ball.vx;ball.y+=ball.vy;\n      if(ball.x<ball.r||ball.x>W-ball.r)ball.vx*=-1; if(ball.y<ball.r)ball.vy*=-1;\n      if(ball.y>pad.y-ball.r&&ball.y<pad.y+10&&Math.abs(ball.x-pad.x)<pad.w/2){ball.vy=-Math.abs(ball.vy);ball.vx+=(ball.x-pad.x)*0.03;}\n      bricks.forEach(function(b){if(b.alive&&ball.x>b.x&&ball.x<b.x+b.w&&ball.y>b.y&&ball.y<b.y+b.h){b.alive=false;ball.vy*=-1;\n        score=Math.min(deck.points,score+b.pts);deck.score(score);}});\n      if(score>=deck.points){over=true;deck.done();deck.summary(\'通關!\');}\n      if(ball.y>H){over=true;deck.done();deck.summary(\'差一點,得 \'+score+\' 分,按空白鍵再來\');}}\n      x.clearRect(0,0,W,H);bricks.forEach(function(b){if(b.alive){x.fillStyle=\'#77BD1D\';x.fillRect(b.x,b.y,b.w,b.h);}});\n      x.fillStyle=\'#fff\';x.fillRect(pad.x-pad.w/2,pad.y,pad.w,8);x.beginPath();x.arc(ball.x,ball.y,ball.r,0,7);x.fill();\n      x.font=\'20px sans-serif\';x.fillText(\'分數 \'+score+\' / \'+deck.points+(over?\'  (空白鍵重來)\':\'\'),12,28);requestAnimationFrame(step);}\n    addEventListener(\'mousemove\',function(e){pad.x=e.clientX;});addEventListener(\'touchmove\',function(e){pad.x=e.touches[0].clientX;});\n    addEventListener(\'keydown\',function(e){if(e.key===\'ArrowLeft\')pad.x-=30;if(e.key===\'ArrowRight\')pad.x+=30;if(e.key===\' \'&&over)reset();});\n    addEventListener(\'resize\',reset);reset();step();\n    <\/script>\n  --- widget html end ---\n  Step 2, the slide in the deck yaml (title, points, fallback, html = the handle):\n    visual:\n      kind: widget\n      title: 打磚塊 100 分挑戰\n      points: 100\n      fallback: 打磚塊小遊戲:用滑鼠或左右鍵移動擋板,打掉磚塊累積到 100 分就過關,每個磚塊的分數隨機。\n      html: "@w1"\n  Narration for such a slide: say the goal and the controls ("用滑鼠或左右鍵移動擋板,打到 100 分就過關"), then let the viewer play; set\n  wait: true only when the deck must not go on before they try. The score appears in the player\'s score chip and in the pack.\n  If you are unsure a piece works, make it smaller: a simple correct widget beats an ambitious broken one (there is no way to debug it\n  once delivered). Never put secrets or personal data in html.',ai_features:"This AI assistant itself: its shipped features, slash commands and built-in skills (built when you ask).",sources:'Material comes from anywhere; you digest it into slides, you do not paste it:\n- Files the user uploaded to the chat (file_id): list_uploaded_files, parse_uploaded_file give text (pdf / office / text). A picture the user uploaded is already usable: its handle is "client-file/<file_id>".\n- The user\'s own folders (File Access Points): list_file_access_points, fap_list_files, fap_find_file, fap_read_file read documents and source code. For a whole code base use repo_ask / repo_sql / repo_read_doc (project index). A picture file in a folder is brought in with import_fap_image(ref).\n- A website: read the page with the browser tools (browser_get_page_text, browser_screenshot; a screenshot result has a short "client_file_url") and keep the text; a picture whose address is in that text is brought in with import_image_url(url).\n- Pictures: every picture seen so far is listed by list_source_images as "@img1", "@img2" ... (tool results are scanned for pictures automatically); use the handle as an image "src". A chart: render_chart.\n- SOURCES ARE HINTS, NOT LIMITS. What the user names is where to START; it is never the whole of what you may use. When nothing is named, or a named source has too little, do not stop and do not ask: (1) look in the places above with the topic\'s keywords; (2) for a subject about THIS AI ("how to use this AI", "what can it do", "all the features") call get_presentation_topic("ai_features"), which lists the real features, slash commands and skills; (3) fill every remaining gap from your own knowledge of the subject, organised into a sensible storyline. Facts you took from a source are stated as such; general knowledge is stated as general explanation. Never invent a figure, a picture or a quote that no tool returned. Always finish with a deck.\n- A table in the source -> a table visual (header + rows), NOT a screenshot of a table and NOT bullets, unless it is wider than 8 columns (then pick the columns that matter). A diagram or screenshot in the source -> an image visual with callouts for the parts you explain. Never invent a picture or a number that the source does not contain; if the source lacks something the topic needs, say so in the narration or leave it out.',style:'House style (the deck template, editable in settings): white content slides with a dark title, an accent colour, a dark subtitle bar at the bottom,\ndark title/topic slides. The renderer lays everything out; you provide words and structure.\nWriting: one idea per slide; the title states the point ("Signature is verified before flashing") not the topic ("Verification");\nbullets are fragments of <= 12 words, never the narration repeated word for word; the narration is natural speech, short sentences,\nno markdown, no URLs, no emoji; never the user\'s instructions to you (speaking speed, requested length, tool or field names such as deck.speed / wait: true -- speed goes into deck.speed only); numbers spoken the way they are said. Language: the user\'s language (deck.lang: zh-TW for Traditional\nChinese, zh-CN, en ...). Keep chapters balanced (3-6 slides each) and finish with a summary slide.'}},FaDeckHost=function(){"use strict";const 