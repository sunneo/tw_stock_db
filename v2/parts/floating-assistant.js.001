mat:"ADD dst, src",description:"dst = dst + src."},{name:"sub",format:"SUB dst, src",description:"dst = dst - src."},{name:"adc",format:"ADC dst, src",description:"dst = dst + src + carry."},{name:"sbb",format:"SBB dst, src",description:"dst = dst - src - carry."},{name:"mul",format:"MUL src",description:"Unsigned multiply: RDX:RAX = RAX * src."},{name:"imul",format:"IMUL dst, src",description:"Signed multiply."},{name:"div",format:"DIV src",description:"Unsigned divide."},{name:"idiv",format:"IDIV src",description:"Signed divide."},{name:"and",format:"AND dst, src",description:"dst = dst AND src."},{name:"or",format:"OR dst, src",description:"dst = dst OR src."},{name:"xor",format:"XOR dst, src",description:"dst = dst XOR src (also the classic xor reg,reg zeroing idiom)."},{name:"not",format:"NOT dst",description:"dst = bitwise complement of dst."},{name:"neg",format:"NEG dst",description:"dst = two's-complement negate of dst."},{name:"shl",format:"SHL dst, count",description:"Shift left (alias SAL)."},{name:"shr",format:"SHR dst, count",description:"Logical shift right."},{name:"sar",format:"SAR dst, count",description:"Arithmetic shift right."},{name:"inc",format:"INC dst",description:"dst = dst + 1."},{name:"dec",format:"DEC dst",description:"dst = dst - 1."},{name:"cmp",format:"CMP a, b",description:"Sets flags from a - b (result discarded)."},{name:"test",format:"TEST a, b",description:"Sets flags from a AND b (result discarded)."},{name:"cbw",format:"",description:"把 AL 符號擴展到 AX"},{name:"cwde",format:"",description:"把 AX 符號擴展到 EAX"},{name:"cdqe",format:"",description:"把 EAX 符號擴展到 RAX"},{name:"cdq",format:"",description:"把 EAX 符號擴展到 EDX:EAX（除法前置）"},{name:"cqo",format:"",description:"把 RAX 符號擴展到 RDX:RAX"},{name:"bt",format:"",description:"測試某一位元"},{name:"bts",format:"",description:"測試並設定位元"},{name:"btr",format:"",description:"測試並清除位元"},{name:"btc",format:"",description:"測試並反轉位元"},{name:"bsf",format:"",description:"找最低位元為 1 的位置"},{name:"bsr",format:"",descriptio