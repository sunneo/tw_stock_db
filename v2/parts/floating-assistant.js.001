function (id) { var r = new Array(ROW).fill(pad); r[0] = id; rows.push(r); };\n    t(cfg.im_start_token_id); tpl.user_prompt_prefix_token_ids.forEach(t);\n    if (promptCodes && promptCodes.length) {\n      t(cfg.audio_start_token_id);\n      promptCodes.forEach(function (c) { rows.push([cfg.audio_user_slot_token_id].concat(Array.prototype.slice.call(c, 0, NQ))); });\n      t(cfg.audio_end_token_id);\n    }\n    tpl.user_prompt_after_reference_token_ids.forEach(t); textIds.forEach(t); tpl.assistant_prompt_prefix_token_ids.forEach(t); t(cfg.audio_start_token_id);\n    var flat = new Int32Array(rows.length * ROW); for (var i = 0; i < rows.length; i++) for (var k = 0; k < ROW; k++) flat[i * ROW + k] = rows[i][k];\n    return { ids: flat, rows: rows.length };\n  }\n\n  // ───────────────────────── 生成迴圈 ─────────────────────────\n  // 可重現的亂數（同一個 seed 同一串）\n  function rng(seed) { var a = (Number(seed) >>> 0) || 1; return function () { a |= 0; a = a + 0x6D2B79F5 | 0; var t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }\n  // runners：{ prefill(ids Int32Array, rows) → Promise<{hidden: Float32Array(768), past}>, decode(row Int32Array(17), pastLength, past) → Promise<{hidden, past}>,\n  //            sample(hidden, seen Int32Array(16*1024), u1 Float32Array(1), u2 Float32Array(16)) → Promise<{cont:boolean, frame: Int32Array(16)}> }\n  // opts：{ maxFrames=375, seed, onFrame(n), isCancelled() }。回 { frames: Int32Array[T*16], count, stopped:'end'|'max'|'cancel' }\n  async function generate(runners, cfg, prompt, opts) {\n    opts = opts || {}; var maxFrames = opts.maxFrames || 375, rnd = opts.seed === undefined || opts.seed === null ? Math.random : rng(opts.seed);\n    var pre = await runners.prefill(prompt.ids, prompt.rows), hidden = pre.hidden, past = pre.past, length = prompt.rows;\n    var seen = new Int32Array(NQ * CODEBOOK), frames = [], stopped = 'max';\n    for (var step = 0; step < maxFrames; step++) {\n      if (opts.isCancelled && opts.isCancelled()) { stopped = 'cancel'; break; }\n      var u2 = new Float32Array(NQ); for (var q = 0; q < NQ; q++) u2[q] = rnd();\n      var s = await runners.sample(hidden, seen, new Float32Array([rnd()]), u2);\n      if (!s.cont) { stopped = 'end'; break; }\n      var f = Int32Array.from(s.frame); frames.push(f); for (var k = 0; k < NQ; k++) seen[k * CODEBOOK + f[k]] = 1;\n      if (opts.onFrame) opts.onFrame(frames.length);\n      if (step === maxFrames - 1) break;\n      var row = new Int32Array(ROW); row[0] = cfg.audio_assistant_slot_token_id; row.set(f, 1);\n      var d = await runners.decode(row, length, past); hidden = d.hidden; past = d.past; length++;\n    }\n    var flat = new Int32Array(frames.length * NQ); for (var i = 0; i < frames.length; i++) flat.set(frames[i], i * NQ);\n    return { frames: flat, count: frames.length, stopped: stopped };\n  }\n\n  // ───────────────────────── 文字切段 ─────────────────────────\n  // 一次最多念約 30 秒（375 幀），長文字依句子切成幾段：中文一段約 70 字以內，英文一段約 220 字元以內；盡量在句尾標點斷開\n  function splitText(text, maxLatin, maxCjk) {\n    var t = String(text || '').replace(/\\r\\n/g, '\\n').trim(); if (!t) return [];\n    var sents = t.split(/(?<=[。！？!?；;…\\n]|[.]\\s)/).map(function (x) { return x.trim(); }).filter(Boolean), out = [], cur = '';\n    var limit = function (s) { var cjk = (s.match(/[㐀-鿿぀-ヿ가-힯]/g) || []).length; return cjk > s.length * 0.3 ? (maxCjk || 70) : (maxLatin || 220); };\n    sents.forEach(function (s) {\n      while (s.length > limit(s)) { var cut = limit(s), k = s.lastIndexOf(' ', cut); if (k < cut * 0.5) k = s.search(/[，,、]/) > 0 ? s.slice(0, cut).search(/[，,、][^，,、]*$/) : -1; if (k < cut * 0.4) k = cut; if (cur) { out.push(cur); cur = ''; } out.push(s.slice(0, k + (s[k] === ' ' ? 0 : 1)).trim()); s = s.slice(k + (s[k] === ' ' ? 1 : 1)).trim(); if (!s) break; }\n      if (!s) return; if (cur && (cur + s).length + 1 > limit(cur + s)) { out.push(cur); cur = s; } else cur = cur ? cur + (/[　-〿＀-￯㐀-鿿]$/.test(cur) ? '' : ' ') + s : s;\n    });\n    if (cur) out.push(cur); return out.filter(Boolean);\n  }\n\n  // ───────────────────────── 波形處理 ─────────────────────────\n  // 加窗 sinc（Lanczos，a=8）重採樣：參考音檔 24kHz → 48kHz 與輸出 48kHz → 24kHz 都用這個，比線性內插乾淨（編碼器對高頻很敏感）\n  function resample(a, from, to) {\n    if (from === to) return a; var ratio = to / from, n = Math.max(1, Math.round(a.length * ratio)), out = new Float32Array(n), A = 8, scale = Math.min(1, ratio), len = a.length;\n    for (var i = 0; i < n; i++) {\n      var c = i / ratio, i0 = Math.floor(c), s = 0, ws = 0;\n      for (var k = i0 - Math.ceil(A / scale) + 1; k <= i0 + Math.ceil(A / scale); k++) { var x = (c - k) * scale; if (x <= -A || x >= A) continue; var w = x === 0 ? 1 : (Math.sin(Math.PI * x) / (Math.PI * x)) * (Math.sin(Math.PI * x / A) / (Math.PI * x / A)); var v = k < 0 ? a[0] : k >= len ? a[len - 1] : a[k]; s += v * w; ws += w; }\n      out[i] = ws ? s / ws : 0;\n    }\n    return out;\n  }\n  // 參考音檔 → 編碼器要的 [1,2,L]（48kHz 立體聲，單聲道複製成兩個聲道）\n  function toCodecInput(mono, rate) { var m = resample(mono, rate, OUT_RATE), w = new Float32Array(2 * m.length); w.set(m, 0); w.set(m, m.length); return { data: w, length: m.length }; }\n  // 解碼器輸出 [2,L] 48kHz → 單聲道，再轉成要的取樣率\n  function fromCodecOutput(stereo, L, toRate) { var m = new Float32Array(L); for (var i = 0; i < L; i++) m[i] = (stereo[i] + stereo[L + i]) / 2; return toRate && toRate !== OUT_RATE ? resample(m, OUT_RATE, toRate) : m; }\n  // 參考聲碼的長度上限：每幀 80 毫秒，提示越長越慢；超過 20 秒的樣本只取前面 20 秒（250 幀）\n  function trimPromptCodes(codes, maxFrames) { var max = maxFrames || 250; return codes.length > max ? codes.slice(0, max) : codes; }\n\n  return { NQ: NQ, ROW: ROW, CODEBOOK: CODEBOOK, HIDDEN: HIDDEN, LAYERS: LAYERS, OUT_RATE: OUT_RATE, FRAME_RATE: FRAME_RATE,\n    parseModel: parseModel, normalize: normalize, encode: encode, buildPrompt: buildPrompt, rng: rng, generate: generate, splitText: splitText,\n    resample: resample, toCodecInput: toCodecInput, fromCodecOutput: fromCodecOutput, trimPromptCodes: trimPromptCodes };\n}));\n\n// MOSS-TTS-Nano 的推論 worker（module worker；執行時會在最前面接上 moss_core.js 的內容，所以這裡直接用全域的 FaMossTts）。\n// 訊息：\n//   { type:'init', jobId, ortUrl, wasmBase, threads, files:{ 檔名: blob 網址 }, manifestText, tokenizerBytes, gpu?:{ src, coreSrc } }（gpu：選用 WebGPU 管線，設定 mossGpu；失敗退回 ORT wasm，結果的 gpu 欄位寫診斷）\n//   { type:'generate', jobId, text, codes|null, seed, maxFrames }   → progress {frames}… → result { audio: Float32Array（單聲道 48kHz）, frames, stopped }\n//   { type:'encode', jobId, mono, rate }                             → result { codes: Int32Array(T*16), frames }\n//   { type:'cancel', jobId }、{ type:'dispose', jobId }\n// 回：{ jobId, type:'progress', message } 多次，最後 { jobId, type:'result', ok, ... } 或 { ok:false, error }。\nlet ort = null, M = self.FaMossTts, manifest = null, tokModel = null, files = null, ttsMeta = null, codecMeta = null;\nconst sessions = {}; let cancelled = new Set(); const timing = { prefill: 0, decode: 0, sample: 0, codec: 0 }; const now = () => (typeof performance !== 'undefined' ? performance.now() : Date.now());\nconst post = (jobId, type, extra) => self.postMessage(Object.assign({ jobId, type }, extra || {}));\n\n// 逐幀的小運算（decode_step、取樣）用多執行緒反而更慢（量過：92 幀 21 秒 → 27 秒，執行緒同步的成本比運算還大）；預填與解碼器是大運算，多執行緒快 1.4～2.4 倍。所以執行緒池開 N 個，小模型的 session 只用 1 個\nconst SMALL = { decode: 1, sample: 1 };\nasync function getSession(key, graph, externals) {\n  if (sessions[key]) return sessions[key];\n  const url = files[graph]; if (!url) throw new Error('缺少模型檔 ' + graph);\n  const opts = { executionProviders: ['wasm'], graphOptimizationLevel: 'all' }; if (SMALL[key]) opts.intraOpNumThreads = SMALL[key];\n  if (externals && externals.length) opts.externalData = externals.map((p) => ({ path: p, data: files[p] }));\n  sessions[key] = await ort.InferenceSession.create(url, opts);\n  return sessions[key];\n}\nconst ttsExt = (g) => (ttsMeta.external_data_files && ttsMeta.external_data_files[g]) || [];\nconst codecExt = (g) => (codecMeta.external_data_files && codecMeta.external_data_files[g]) || [];\nconst T = (type, data, dims) => new ort.Tensor(type, data, dims);\n\nasync function loadMeta(d) {\n  manifest = JSON.parse(d.manifestText); tokModel = M.parseModel(new Uint8Array(d.tokenizerBytes));\n  ttsMeta = JSON.parse(d.ttsMetaText); codecMeta = JSON.parse(d.codecMetaText);\n}\n// ── 選用 WebGPU 管線（mossGpu，預設關；細節見 moss_gpu_runners.js）。載入或生成失敗都退回 ORT wasm，診斷寫在 result.gpu ──\nlet gpuCfg = null, gpuMod = null, gpuState = null;\nasync function gpuPrepare() {\n  if (gpuState) return gpuState;\n  if (!gpuMod) { if (!self.FaGpuCore) (new Function(gpuCfg.coreSrc))(); gpuMod = (new Function(gpuCfg.src))(); }\n  const fetchBytes = async (name) => { const u = files[name]; if (!u) throw new Error('缺少模型檔 ' + name); return new Uint8Array(await (await fetch(u)).arrayBuffer()); };\n  const f = ttsMeta.files;\n  gpuState = await gpuMod.load({ navigator: self.navigator, fetchBytes, tts: { global: f.decode_step, globalData: ttsExt(f.decode_step)[0], local: 'moss_tts_local_decoder.onnx', localData: 'moss_tts_local_shared.data' } });\n  return gpuState;\n}\nasync function codecDecode(frames, count, jobId) {\n  const s = await getSession('codecDecode', codecMeta.files.decode_full || 'moss_audio_tokenizer_decode_full.onnx', codecExt(codecMeta.files.decode_full || 'moss_audio_tokenizer_decode_full.onnx'));\n  const tc = now(); const out = await s.run({ audio_codes: T('int32', frames, [1, count, M.NQ]), audio_code_lengths: T('int32', new Int32Array([count]), [1]) }); timing.codec += now() - tc;\n  const a = out.audio, dims = a.dims, L = Number(out.audio_lengths.data[0]) || dims[2], ch = dims[1], data = a.data;\n  const mono = new Float32Array(L); // [1, ch, Ltotal]：多聲道平均成單聲道\n  for (let i = 0; i < L; i++) { let sum = 0; for (let c = 0; c < ch; c++) sum += data[c * dims[2] + i]; mono[i] = sum / ch; }\n  return mono;\n}\nasync function codecEncode(mono, rate) {\n  const s = await getSession('codecEncode', codecMeta.files.encode || 'moss_audio_tokenizer_encode.onnx', codecExt(codecMeta.files.encode || 'moss_audio_tokenizer_encode.onnx'));\n  const w = M.toCodecInput(mono, rate), out = await s.run({ waveform: T('float32', w.data, [1, 2, w.length]), input_lengths: T('int32', new Int32Array([w.length]), [1]) });\n  const n = Number(out.audio_code_lengths.data[0]) || out.audio_codes.dims[1], all = out.audio_codes.data, codes = new Int32Array(n * M.NQ); codes.set(all.subarray(0, n * M.NQ));\n  return { codes, frames: n };\n}\nfunction makeRunners(prefillS, decodeS, sampleS) {\n  const pn = ttsMeta.onnx.prefill_output_names, dn = ttsMeta.onnx.decode_output_names;\n  const lastHidden = (t) => { const d = t.data, rows = t.dims[1], h = t.dims[2]; return Float32Array.from(d.subarray((rows - 1) * h, rows * h)); };\n  return {\n    prefill: async (ids, rows) => {\n      const t0 = now(); const o = await prefillS.run({ input_ids: T('int32', ids, [1, rows, M.ROW]), attention_mask: T('int32', new Int32Array(rows).fill(1), [1, rows]) }); timing.prefill += now() - t0;\n      const past = []; for (let i = 0; i < M.LAYERS; i++) { past.push(o['present_key_' + i], o['present_value_' + i]); }\n      return { hidden: lastHidden(o[pn[0]]), past };\n    },\n    decode: async (row, len, past) => {\n      const feeds = { input_ids: T('int32', row, [1, 1, M.ROW]), past_valid_lengths: T('int32', new Int32Array([len]), [1]) };\n      for (let i = 0; i < M.LAYERS; i++) { feeds['past_key_' + i] = past[2 * i]; feeds['past_value_' + i] = past[2 * i + 1]; }\n      const t0 = now(); const o = await decodeS.run(feeds), next = []; timing.decode += now() - t0; for (let i = 0; i < M.LAYERS; i++) { next.push(o['present_key_' + i], o['present_value_' + i]); }\n      return { hidden: lastHidden(o[dn[0]]), past: next };\n    },\n    sample: async (hidden, seen, u1, u2) => {\n      const t0 = now(); const o = await sampleS.run({ global_hidden: T('float32', hidden, [1, M.HIDDEN]), repetition_seen_mask: T('