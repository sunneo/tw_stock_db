","navigator.storage.persisted","navigator.storage.estimate"],html:[]}},browser_dialog:{label:"Native browser modal dialog",description:"Pops a blocking, native (non-DOM, non-stylable) browser dialog - alert/confirm/prompt - kept separate from dom_manipulation/logging_output since a blocking modal that halts script execution until the user responds is a distinct UX/behavior concern from either passively writing to the tree or the console.",languages:{c:[],java:[],python:[],javascript:["alert","confirm","prompt"],html:[]}},data_structures_algorithms:{label:"Collections / algorithms",description:"Container operations and generic algorithms (C++ STL containers/<algorithm>, Rust Vec/HashMap/iterator adapters, Go slices/maps/sort/container packages). Pure in-memory data manipulation - no I/O, no side effects outside the data structure.",languages:{cpp:["push_back","emplace_back","push_front","emplace_front","pop_back","pop_front","emplace","insert_or_assign","try_emplace","extract","merge_node","erase_if","resize","assign","clear","lower_bound","upper_bound","equal_range","binary_search","sort","stable_sort","partial_sort","partial_sort_copy","nth_element","is_sorted","is_sorted_until","sort_heap","make_heap","push_heap","pop_heap","is_heap","stable_partition","partition","partition_copy","partition_point","accumulate","reduce","transform_reduce","inner_product","partial_sum","inclusive_scan","exclusive_scan","transform_inclusive_scan","adjacent_difference","adjacent_find","iota","min","max","minmax","min_element","max_element","minmax_element","for_each","for_each_n","transform","copy","copy_if","copy_n","copy_backward","move_backward","fill","fill_n","generate","generate_n","remove_if","remove_copy","remove_copy_if","replace","replace_if","replace_copy","unique","unique_copy","reverse","reverse_copy","rotate","rotate_copy","shuffle","sample","next_permutation","prev_permutation","is_permutation","find_if","find_if_not","find_end","find_first_of","search","search_n","al