)[0]||MTYPES[0]||null}\nfunction mtSet(id){lsSet(MT_KEY,id);var t=MTYPES.filter(function(x){return x.id===id})[0];if(t&&!t.outputs.some(function(x){return x.id===mtOut()&&x.available})){var a=t.outputs.filter(function(x){return x.available})[0];if(a)mtOutSet(a.id)}}\nfunction mtOut(){return lsGet(MT_OUT_KEY,'lora')}\nfunction mtOutSet(o){lsSet(MT_OUT_KEY,o)}\nfunction mtGuard(t){var g=GUARDS[t.id]||{};var o=mtOut();var r=t.outputs.some(function(x){return x.id===o})?g[o]:null;return r||g._default||{level:'blocked',ok:false,message:'模型類型登錄表沒有接上，無法判斷這個類型能不能訓練。請重新整理工作室。'}}\nfunction mtWarn(t){var g=mtGuard(t);return h('div',{'class':g.level==='run'?'todo':'warn',text:(g.level==='run'?'✅ ':'⚠️ ')+g.message})}\n/* 半成品與只有設計：按「開始」不會訓練，而是把目前能做到哪一步、還缺什麼寫清楚（不悄悄失敗） */\nfunction mtStartBtn(t){var b=h('button',{'class':'pri',text:'▶ 開始訓練'});var msg=h('div');b.onclick=function(){msg.textContent='';msg.appendChild(h('div',{'class':'warn',text:'還沒有開始訓練。'+mtGuard(t).message}))};return h('div',{},[b,msg])}\n/* 外部訓練作業（六種型別的命令列核心）：按開始呼叫 /api/ext/start，每 2 秒讀 /api/ext/status；寫清楚預估時間與限制，失敗給原因。\n * 欄位由 EXT_RUN 描述（步數、路徑、可留空的 Python）。路徑與格式的檢查在主行程做（studio_ext_check），這裡只顯示它的錯誤。 */\nvar EXT_RUN={\n music:{est:'處理器（CPU）約 1 分鐘（1500 步，實測 55 秒）。',steps:1500,paths:[]},\n speech_recognition:{est:'處理器（CPU）40 步約 30 秒（實測 29 秒）。',steps:40,paths:[{k:'base',t:'dir',label:'基底模型資料夾（小型語音辨識基底）'},{k:'data',t:'file',label:'語音資料檔（data.jsonl）'}]},\n speech:{est:'處理器（CPU）約 2 秒／步（實測 30 步 51 秒；以你的電腦為準）。',steps:30,paths:[{k:'model',t:'dir',label:'Kokoro-82M 模型資料夾（config.json、kokoro-v1_0.pth）'},{k:'voice',t:'file',label:'基底語音包（.pt）'},{k:'data',t:'dir',label:'配對資料夾（train.jsonl、heldout.jsonl）'}]},\n audio_to_notes:{est:'處理器（CPU）300 步約 25 秒（實測 24 秒；以你的電腦為準）。只用合成資料。',steps:300,paths:[{k:'base',t:'file',label:'基底轉譜模型（nmp.onnx）'}]},\n vision:{est:'處理器（CPU）約 1 秒／步（實測 300 步 264 秒）。只用合成的顏色與形狀圖。',steps:300,paths:[{k:'base',t:'dir',label:'基底看圖模型資料夾（SmolVLM 格式）'}]},\n context_extend:{est:'處理器（CPU）：一步約 1 段長窗＋2 段短窗的前後向（實測時間見設計文件第 16 節，以你的電腦為準）；另加合併、匯出與核對。',steps:40,paths:[{k:'base',t:'dir',label:'基底模型資料夾（Qwen3-0.6B：config.json、model.safetensors）'},{k:'q8',t:'file',label:'基底 ONNX q8 圖（model_quantized.onnx，結構要與應用程式內的相同）'}],fields:[{k:'factor',label:'加寬倍數（2 或 4）',value:'2'},{k:'longLen',label:'長窗長度（1024 到 16384）',value:'8192'},{k:'shortLen',label:'短窗長度（256 到 4096）',value:'1024'}]},\n llm_scratch:{est:'處理器（CPU）迷你模型：預訓練每 1000 個 token 約 26 秒、指令微調每步約 3 秒（實測，負載很高的機器；閒置時預期較快，未量測）。預設全流程約 1 小時，結果只是示範等級。專家混合約慢 1.1 倍；推理另加算術微調與強化學習（實驗用 tiny：強化學習每步約 12 秒）。步數欄位＝預訓練步數。',steps:300,paths:[{k:'corpus',t:'file',label:'語料（文字檔或資料夾；留空＝內建小語料，只夠示範）'}],fields:[{k:'arch',label:'架構（dense＝密集、moe＝專家混合、reasoning＝推理：思考＋答案再強化學習）',value:'dense'},{k:'preset',label:'模型大小（mini＝約 1 千 3 百萬參數、small＝約 2 千萬、tiny＝4 層實驗用）',value:'mini'},{k:'kvHeads',label:'鍵值頭數（8＝可給原生執行環境；其他值只輸出標準格式；留空＝8）',value:''},{k:'layers',label:'層數（1 到 28，留空＝依大小）',value:''},{k:'experts',label:'專家數（只對 moe）',value:'8'},{k:'topK',label:'每個詞元挑幾個專家（只對 moe）',value:'2'},{k:'vocab',label:'分詞器詞彙表大小',value:'4096'},{k:'batch',label:'預訓練批次',value:'4'},{k:'seq',label:'序列長度',value:'128'},{k:'sftSteps',label:'指令微調步數',value:'40'}]},\n image:{est:'處理器（CPU）約 1 秒／步（512 解析度，實測 40 步訓練 35 秒）；只用合成圖文配對。',steps:40,paths:[{k:'base',t:'dir',label:'SDXS 基底模型資料夾（unet、vae、text_encoder、tokenizer）'}]}\n};\nvar STAGE_TXT={llm_scratch:'語料清理與切分 → 訓練分詞器 → 預訓練 → 指令微調 → 匯出 ONNX（q8）→ 重新載入核對',context_extend:'長文 LoRA 微調 → 替換旋轉表與線性層、寫 ONNX q8 → 與 HF 比對'};\nfunction extRunPanel(t){\n var cfg=EXT_RUN[t.id]||{est:'',steps:100,paths:[]},box=h('div',{}),st={jobId:null,timer:null},inp={};\n var nm=h('input',{type:'text',placeholder:'輸出名稱（英數、中文、底線、連字號）',style:'width:100%'});\n var steps=h('input',{type:'number',min:'1',value:String(cfg.steps),style:'width:140px'});\n var py=h('input',{type:'text',placeholder:'訓練用 Python 路徑（留空＝自動）',style:'width:100%'});\n var msg=h('div',{style:'font-size:12px;margin-top:6px'}),prog=h('div',{style:'font-size:12px;color:var(--mut);margin-top:4px;white-space:pre-line'});\n var bGo=h('button',{'class':'pri',text:'▶ 開始訓練'}),bStop=h('button',{text:'停止',disabled:true});\n box.appendChild(h('div',{style:'font-size:12px;margin-top:6px',text:'預估時間：'+cfg.est}));\n if(STAGE_TXT[t.id])box.appendChild(h('div',{style:'font-size:12px;margin-top:4px',text:'流程：'+STAGE_TXT[t.id]}));\n box.appendChild(h('div',{style:'margin-top:6px'},[h('button',{text:'← 改回一般訓練（語言模型）',onclick:function(){mtSet('llm');refresh('train')}})]));\n box.appendChild(h('label',{text:'輸出名稱'}));box.appendChild(nm);\n box.appendChild(h('label',{text:'訓練步數'}));box.appendChild(steps);\n cfg.paths.forEach(function(pd){var i=h('input',{type:'text',placeholder:pd.t==='dir'?'資料夾完整路徑':'檔案完整路徑',style:'width:100%'});inp[pd.k]=i;box.appendChild(h('label',{text:pd.label}));box.appendChild(i)});\n var fld={};(cfg.fields||[]).forEach(function(fd){var i=h('input',{type:'text',value:fd.value,style:'width:100%'});fld[fd.k]=i;box.appendChild(h('label',{text:fd.label}));box.appendChild(i)});\n box.appendChild(h('label',{text:'Python（進階，留空＝自動）'}));box.appendChild(py);\n box.appendChild(h('div',{'class':'row',style:'gap:6px;margin-top:6px'},[bGo,bStop]));\n box.appendChild(msg);box.appendChild(prog);\n function stopPoll(){if(st.timer){clearInterval(st.timer);st.timer=null}}\n async function poll(){\n  var s=await api('GET','/api/ext/status?jobId='+encodeURIComponent(st.jobId||''));\n  if(!s||s.ok===false){stopPoll();msg.textContent='讀取狀態失敗：'+((s&&s.error)||'');bGo.disabled=false;bStop.disabled=true;return}\n  if(s.state==='running'){var cur=(s.steps||[]).filter(function(x){return x.state==='running'})[0];prog.textContent=(s.steps||[]).map(function(x){return (x.state==='done'?'✓ ':x.state==='running'?'▶ ':'○ ')+x.label}).join(' → ')+'\\n執行中：'+(cur?cur.label:'')+'；步數 '+(s.step||0)+'；損失 '+(s.loss==null?'—':Number(s.loss).toFixed(4))+'；已跑 '+Math.round((s.elapsedMs||0)/1000)+' 秒';return}\n  stopPoll();bGo.disabled=false;bStop.disabled=true;prog.textContent='';\n  if(s.state==='finished')msg.textContent='完成。輸出在：'+(s.outDir||'')+'（還沒收進工作室資產）';\n  else if(s.state==='stopped')msg.textContent='已停止：'+(s.message||'');\n  else msg.textContent='失敗：'+(s.message||'未知原因');\n }\n bGo.onclick=async function(){try{\n  msg.textContent='';var gd=mtGuard(t);if(gd&&gd.ok===false){msg.textContent='目前選的輸出不能用：'+(gd.message||'請改選其他輸出。');return}\n  var paths={};cfg.paths.forEach(function(pd){var v=inp[pd.k].value.trim();if(v||!pd.optional)paths[pd.k]=v;if(!v&&pd.k==='corpus')delete paths[pd.k]});\n  var prm={steps:Number(steps.value)};Object.keys(fld).forEach(function(k){var v=fld[k].value.trim();if(v==='')return;prm[k]=(k==='preset'||k==='arch')?v:Number(v)});\n  var body={type:t.id,output:mtOut(),name:nm.value.trim(),params:prm,paths:paths};if(py.value.trim())body.python=py.value.trim();\n  var x=await api('POST','/api/ext/start',body);if(x.ok===false){msg.textContent=String(x.error||'沒有啟動');return}\n  st.jobId=x.jobId;bGo.disabled=true;bStop.disabled=false;msg.textContent='已開始。'+(x.limitsNote||'');st.timer=setInterval(poll,2000)}catch(e){msg.textContent='開始失敗（'+t.id+'）：'+((e&&e.message)||e)+'（請確認工作室的桌面版橋接可用）'}};\n bStop.onclick=async function(){await api('POST','/api/ext/stop',{jobId:st.jobId});msg.textContent='要求停止中…'};\n return box}\nfunction modelTypePanel(onChange){\n var box=h('div',{'class':'card',style:'margin-bottom:8px'});\n if(MT_MISSING||!MTYPES.length){box.appendChild(h('div',{'class':'warn',text:'模型類型登錄表沒有接上，下面只能用既有的訓練。請重新整理工作室。'}));return box}\n var cur=mtGet();\n var sel=h('select',{style:'width:100%'},MTYPES.map(function(t){return h('option',{value:t.id,text:t.label})}));if(cur)sel.value=cur.id;\n sel.onchange=function(){mtSet(sel.value);onChange()};\n box.appendChild(h('label',{text:'模型類型（先選你要做哪一種模型）'}));box.appendChild(sel);\n if(!cur)return box;\n var head=h('div',{style:'margin-top:8px'},[h('b',{text:cur.name}),h('span',{'class':'badge '+(cur.status==='done'?'ok':'wn'),text:cur.status==='done'?'已完成可用':cur.badge}) ]);box.appendChild(head);\n box.appendChild(h('div',{style:'font-size:12px;color:var(--mut);margin-top:2px',text:cur.summary}));\n box.appendChild(h('div',{style:'font-size:12px;margin-top:6px',text:'資料來源：'+(cur.sources.length?cur.sources.join('；'):'這一種目前沒有可用的資料來源。')}));\n box.appendChild(h('div',{style:'font-size:12px;margin-top:2px',text:'後端：'+(cur.backends.length?cur.backends.map(function(b){return b.label}).join('；'):'目前沒有可用的後端（還沒有訓練核心）。')}));\n var outs=h('div',{style:'margin-top:6px'});outs.appendChild(h('div',{style:'font-size:12px;color:var(--mut)',text:'輸出（LoRA 小檔可以疊在基底上；完整模型是併回基底後匯出）：'}));\n var row=h('div',{'class':'row',style:'gap:6px'});\n cur.outputs.forEach(function(o){var on=mtOut()===o.id&&o.available;\n  if(cur.outputs.length<2){row.appendChild(h('span',{'class':'badge ok',text:o.label}));return}\n  row.appendChild(h('button',{'class':on?'pri':'',text:(on?'✅ ':'')+o.label,disabled:!o.available,title:o.available?'':o.reason,onclick:function(){mtOutSet(o.id);onChange()}}))});\n outs.appendChild(row);\n cur.outputs.forEach(function(o){if(!o.available)outs.appendChild(h('div',{style:'font-size:12px;color:var(--mut)',text:'• '+o.label+'：'+o.reason}));else if(o.note&&cur.outputs.length>1)outs.appendChild(h('div',{style:'font-size:12px;color:var(--mut)',text:'• '+o.label+'：'+o.note}))});\n box.appendChild(outs);\n if(cur.gap)box.appendChild(h('div',{'class':'todo',style:'margin-top:6px;font-size:12px',text:cur.gap}));\n box.appendChild(mtWarn(cur));\n return box}\nfunction trainWizard(host){\n var GOALS=[\n  ['lora','🧠 訓練語言模型（LoRA）','讓內建的小模型學會你的資料。需要一個 .jsonl 資料集。','需要資料集'],\n  ['blockly','🧩 積木課程','用題目資產窮舉＋判題，收成一套課。','需要題目資產'],\n  ['matrix','🔢 矩陣層','用題目資產擬合矩陣運算的範式。','需要題目資產'],\n  ['uml','📐 UML 設計','用「情境→設計」配對補強決策表與詞彙。','需要情境配對資產'],\n  ['colu','🎯 CoLU 排名','用目前的「採用／退回」回饋重訓排名模型。','不用挑資料'],\n  ['trainer','🎓 離線訓練器','把重複成功的做法升格成技能。','不用挑資料']];\n var W=host._w||(host._w={step:0,intent:'',kind:'lora',data:'',name:'',files:null,src:'asset'});\n function wantFile(k){return k==='uml'?'data/pairs.jsonl':(k==='lora'?null:'data/ta