        if (c == '[') { p++; JV r = JV::array(); ws(); if (p < s.size() && s[p] == ']') { p++; return r; } for (;;) { r.a.push_back(value(depth + 1)); ws(); if (p < s.size() && s[p] == ',') { p++; continue; } if (p < s.size() && s[p] == ']') { p++; break; } fail("expected , or ]"); } return r; }
