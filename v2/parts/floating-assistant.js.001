ion (M extension)."},{name:"divu",format:"DIVU rd, rs1, rs2",description:"Unsigned division (M extension)."},{name:"rem",format:"REM rd, rs1, rs2",description:"Signed remainder (M extension)."},{name:"remu",format:"REMU rd, rs1, rs2",description:"Unsigned remainder (M extension)."}]},ptx:{process_exec:[{name:"bra",format:"bra target;",description:"Unconditional branch within a PTX kernel."},{name:"call",format:"call fn, (args);",description:"Calls a PTX function."},{name:"ret",format:"ret;",description:"Returns from a PTX function."},{name:"exit",format:"exit;",description:"Terminates the current thread."},{name:"trap",format:"trap;",description:"Aborts execution and triggers an interrupt to the host."}],concurrency:[{name:"bar.sync",format:"bar.sync barrier{, count};",description:"Synchronizes all threads in a CTA (block) at a barrier - PTX form of CUDA's __syncthreads()."},{name:"membar",format:"membar.level;",description:"Memory barrier - orders memory operations at the given scope (cta/gl/sys)."},{name:"atom",format:"atom.space.op.type d, [a], b;",description:"Atomic read-modify-write on global/shared memory (add/min/max/cas/...)."},{name:"red",format:"red.space.op.type [a], b;",description:"Atomic reduction to memory without returning the old value."},{name:"bar",format:"",description:"區塊內同步屏障（bar.sync＝__syncthreads）"},{name:"barrier",format:"",description:"區塊內同步屏障"},{name:"shfl",format:"",description:"warp 內執行緒之間交換暫存器"},{name:"vote",format:"",description:"warp 內投票"},{name:"activemask",format:"",description:"取得 warp 內活躍執行緒遮罩"},{name:"bar.arrive",format:"",description:"抵達屏障但不等待"},{name:"bar.red",format:"",description:"屏障並歸約"},{name:"barrier.cluster.arrive",format:"",description:"叢集屏障抵達"},{name:"barrier.cluster.wait",format:"",description:"叢集屏障等待"},{name:"atom.add",format:"",description:"原子相加"},{name:"atom.cas",format:"",description:"原子比較並交換"},{name:"atom.exch",format:"",description:"原子交換"},{name:"atom.min",format:"",description:"原子取最小"},{name:"atom.max",format:"