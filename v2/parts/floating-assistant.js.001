"item"===e.rule?(t.value=e.inner&&"assign"===e.inner.rule?"":String(e.value).slice(0,140),e.inner&&"assign"===e.inner.rule&&(t.inner={key:e.inner.key,op:e.inner.op,value:r(e.inner.key,e.inner.value).slice(0,140)})):"keyword"===e.rule||"directive"===e.rule?Object.assign(t,{kw:e.kw,sigil:e.sigil,value:String(e.value).slice(0,140)}):"func"===e.rule?Object.assign(t,{name:e.name,lang:e.lang,bodyLines:e.body?e.body.length:0}):"section"===e.rule?t.name=e.name:"block"===e.rule?t.head=e.head:t.value=String(e.value||"").slice(0,140),t}),l=Array.from(new Set(i.filter(e=>"assign"===e.rule).map(e=>e.key))).filter(e=>e.length>=4&&/^[\w.$@\-\/]+$/.test(e)).slice(0,40),c=e=>e.replace(/[.*+?^${}()|[\]\\\/]/g,"\\$&"),d=a.ops.length?a.ops.slice().sort((e,t)=>t.length-e.length).map(c).join("|"):"=";return{id:s,type:l.length?"regex":"semantic",expr:l.length?"^\\s*(?:"+l.map(c).join("|")+")(?::[\\w.-]+)*\\s*(?:"+d+")\\s*\\S?.*$":void 0,examples:i.filter(e=>"assign"===e.rule).slice(0,5).map(e=>e.key+" "+e.op+" "+r(e.key,e.value).slice(0,60)),intent:"已學過的格式「"+t+"」（自己找出的文法："+a.ops.length+" 種運算子、"+a.keywords.length+" 個關鍵字）",description:j(e).slice(0,3).join("；"),tool:"log_ask",args:{format:t,question:"這一行是什麼意思",text:"{problem_text}"},confidence:.75,risk:"safe",source:"learned",enabled:!0,hits:0,log_model:{v:1,kind:"grammar",name:t,learnedAt:Date.now(),source:n.source||"",grammar:a,lines:e.lines,statements:e.statements,coverage:e.coverage,comments:e.comments,nodes:o}}},fromSlim:function(e){const t=(e.nodes||[]).map(e=>Object.assign({},e,{refs:[],quals:e.quals||[]}));return{ok:!0,kind:"grammar",grammar:e.grammar,nodes:t,lines:e.lines||0,statements:e.statements||t.length,coverage:e.coverage||0,unparsed:[],unparsedCount:0,comments:e.comments||0,blanks:0}},valueType:a,flat:C,fmtNode:T}})}.call(null,void 0,e),e.FaGram}(),FA_CATALOG_PROBE_PY="# 單元目錄的探測執行（只用標準庫；在 Pyodide 或一般 CPython 裡都能跑）。設計見 DESIGN.unit-catalog.md 第四、五節。\n# 只對「純函式」（模組白名單、沒有副作用）執行，並且：\n#   - 用稽核掛鉤（sys.addaudithook）擋下檔案、網路、子行程、程式碼執行這類事件，碰到就中止那一次呼叫、記成 blocked；\n#   - 每個案例執行兩次，結果不同就標非決定性；結果與輸出都截短；\n#   - 逾時由呼叫端（JS）終止整個 Worker，這裡只負責不讓單次結果太大。\n# 用法：JS 端把 PROBE_REQ 那一行的占位符換成請求（JSON 字串的字面值）再執行；輸出一行 \"FA_PROBE_RESULT:\" + JSON。\n#   請求：{\"jobs\":[{\"id\",\"module\",\"name\",\"cases\":[{\"args\":[...],\"kwargs\":{...}}]}], \"max_repr\":200}\n#   參數值的特殊編碼：{\"$bytes\": \"<base64>\"}→ bytes；{\"$tuple\": [...]}→ tuple。\nimport sys, json, importlib, base64, math, re\n\nREQ = json.loads(__FA_PROBE_REQ__)\nMAX_REPR = int(REQ.get('max_repr', 200))\nMAX_JSON = int(REQ.get('max_json', 2000))  # 正式執行時結果可以大一點\nBLOCKED_EVENTS = {'open', 'os.system', 'os.exec', 'os.posix_spawn', 'os.spawn', 'os.fork', 'os.forkpty', 'subprocess.Popen', 'os.remove', 'os.rename', 'os.rmdir', 'os.mkdir',\n                  'os.chmod', 'os.chown', 'os.truncate', 'os.symlink', 'os.link', 'os.putenv', 'os.unsetenv', 'shutil.rmtree', 'shutil.copyfile', 'shutil.move', 'shutil.copytree',\n                  'ctypes.dlopen', 'ctypes.dlsym', 'exec', 'compile', 'import.__main__', 'webbrowser.open', 'tempfile.mkstemp', 'tempfile.mkdtemp', 'urllib.Request', 'http.client.connect'}\n_state = {'armed': False}\n\n\ndef _hook(event, args):\n    if not _state['armed']:\n        return\n    if event in BLOCKED_EVENTS or event.startswith('socket.') or event.startswith('subprocess.'):\n        raise RuntimeError('blocked:' + event)\n\n\ntry:\n    sys.addaudithook(_hook)\n    AUDIT = True\nexcept Exception:  # 沒有稽核掛鉤（很舊的版本）：不執行任何探測，直接回報\n    AUDIT = False\n\n\ndef decode(v):\n    if isinstance(v, dict):\n        if '$bytes' in v and len(v) == 1:\n            return base64.b64decode(v['$bytes'])\n        if '$tuple' in v and len(v) == 1:\n            return tuple(decode(x) for x in v['$tuple'])\n        return {k: decode(x) for k, x in v.items()}\n    if isinstance(v, list):\n        return [decode(x) for x in v]\n    return v\n\n\ndef tname(v, depth=0):\n    # 結果值 → 我們的型別詞彙（對不上的一律 any，不猜）\n    if v is None:\n        return 'null'\n    if isinstance(v, bool):\n        return 'bool'\n    if isinstance(v, int):\n        return 'int'\n    if isinstance(v, (float, complex)):\n        return 'number'\n    if type(v).__name__ in ('Fraction', 'Decimal'):\n        return 'number'\n    if isinstance(v, str):\n        return 'text'\n    if isinstance(v, (bytes, bytearray)):\n        return 'bytes'\n    if isinstance(v, dict):\n        return 'dict'\n    if isinstance(v, (list, tuple, set, frozenset)):\n        if depth >= 2:\n            return 'list<any>'\n        items = list(v)[:20]\n        if not items:\n            return 'list<any>'\n        ts = sorted(set(tname(x, depth + 1) for x in items))\n        if 'number' in ts and 'int' in ts:\n            ts.remove('int')\n        return 'list<' + (ts[0] if len(ts) == 1 else 'union<' + '|'.join(ts) + '>') + '>'\n    return 'any'\n\n\ndef srepr(v):\n    # 物件的預設 repr 帶記憶體位址（每次不同），比較與記錄時去掉，不然會被誤判成非決定性\n    return re.sub(r' (at|@) 0x[0-9a-fA-F]+', '', repr(v))\n\n\ndef jsonable(v):\n    try:\n        s = json.dumps(v, allow_nan=False)\n        return json.loads(s) if len(s) <= MAX_JSON else None\n    except Exception:\n        return None\n\n\ndef one_call(fn, case):\n    args = [decode(a) for a in case.get('args', [])]\n    kwargs = {k: decode(v) for k, v in (case.get('kwargs') or {}).items()}\n    _state['armed'] = True\n    try:\n        return fn(*args, **kwargs)\n    finally:\n        _state['armed'] = False\n\n\ndef run_case(fn, case):\n    positional = False\n    try:\n        try:\n            r1 = one_call(fn, case)\n        except TypeError as e:\n            # 存根寫成關鍵字參數、實際是僅位置參數（例如 math.log）：改用位置參數重試一次，並記下來\n            if 'keyword argument' in str(e) and case.get('kwargs'):\n                r1 = one_call(fn, {'args': list(case.get('args', [])) + list(case['kwargs'].values()), 'kwargs': {}})\n                positional = True\n            else:\n                raise\n    except RuntimeError as e:\n        if str(e).startswith('blocked:'):\n            return {'ok': False, 'exc': 'Blocked', 'msg': str(e)[:120], 'blocked': True}\n        return {'ok': False, 'exc': 'RuntimeError', 'msg': str(e)[:120]}\n    except BaseException as e:  # 包含 SystemExit：探測不能讓整個程序結束\n        return {'ok': False, 'exc': type(e).__name__, 'msg': str(e)[:120], 'bases': [c.__name__ for c in type(e).__mro__[1:4]]}\n    if REQ.get('once'):  # 正式執行（不是探測）：只呼叫一次，不做「兩次結果相同」的檢查\n        det = True\n    else:\n        try:\n            r2 = one_call(fn, {'args': list(case.get('args', [])) + list(case['kwargs'].values()), 'kwargs': {}} if positional else case)\n            det = srepr(r1) == srepr(r2)\n        except BaseException:\n            det = False\n    j = jsonable(r1)\n    out = {'ok': True, 'type': tname(r1), 'repr': srepr(r1)[:MAX_REPR], 'det': det, 'jsonable': j is not None or r1 is None}\n    if positional:\n        out['positional'] = True\n    if out['jsonable']:\n        out['json'] = j\n    if isinstance(r1, float) and (math.isnan(r1) or math.isinf(r1)):\n        out['jsonable'] = False\n        out.pop('json', None)\n    return out\n\n\nres = {'ok': True, 'python': sys.version.split()[0], 'audit': AUDIT, 'jobs': []}\nfor job in REQ.get('jobs', []):\n    item = {'id': job['id'], 'cases': [], 'import_error': None}\n    if not AUDIT:\n        item['import_error'] = 'no audit hook'\n        res['jobs'].append(item)\n        continue\n    try:\n        mod = importlib.import_module(job['module'])\n        fn = mod\n        for part in job['name'].split('.'):\n            fn = getattr(fn, part)\n        if not callable(fn):\n            raise TypeError('not callable')\n    except BaseException as e:\n        item['import_error'] = type(e).__name__ + ': ' + str(e)[:120]\n        res['jobs'].append(item)\n        continue\n    for case in job.get('cases', []):\n        item['cases'].append(run_case(fn, case))\n    res['jobs'].append(item)\nprint('FA_PROBE_RESULT:' + json.dumps(res, ensure_ascii=False))\n",FA_CATALOG_EVAL_SET_JSON='{\n  "version": 1,\n  "note": "單元選擇評測集：需求 → 標準答案單元（可多個等價的）。neg＝清單裡不該有任何適合的（該回 0）。python 單元需要先 /unit-catalog onboard 這些模組。作者手寫，答案由人判斷；有爭議的題目已盡量改成沒有歧義的說法。",\n  "modules": ["statistics", "math", "json", "string", "textwrap", "base64", "hashlib", "zlib", "html", "urllib.parse", "operator", "fnmatch", "shlex", "difflib", "posixpath"],\n  "cases": [\n    { "id": "p01", "query": "算這一串數字的平均值", "truth": ["py:statistics.mean"] },\n    { "id": "p02", "query": "找出一組數字的中位數", "truth": ["py:statistics.median"] },\n    { "id": "p03", "query": "計算這些數值的樣本標準差", "truth": ["py:statistics.stdev"] },\n    { "id": "p04", "query": "哪個數字在清單裡出現最多次", "truth": ["py:statistics.mode"] },\n    { "id": "p05", "query": "求 144 的平方根", "truth": ["py:math.sqrt"] },\n    { "id": "p06", "query": "計算 10 的階乘", "truth": ["py:math.factorial"] },\n    { "id": "p07", "query": "兩個整數的最大公因數", "truth": ["py:math.gcd"] },\n    { "id": "p08", "query": "把小數無條件進位成整數", "truth": ["py:math.ceil"] },\n    { "id": "p09", "query": "把小數無條件捨去成整數", "truth": ["py:math.floor"] },\n    { "id": "p10", "query": "算以 10 為底的對數", "truth": ["py:math.log10"] },\n    { "id": "p11", "query": "把 JSON 字串轉成資料結構", "truth": ["py:json.loads"] },\n    { "id": "p12", "query": "把資料結構轉成 JSON 文字", "truth": ["py:json.dumps"] },\n    { "id": "p13", "query": "把資料做 base64 編碼", "truth": ["py:base64.b64encode"] },\n    { "id": "p14", "query": "把 base64 字串解回原始資料", "truth": ["py:base64.b64decode"] },\n    { "id": "p15", "query": "算一段文字的 SHA-256 雜湊值", "truth": ["py:hashlib.sha256"] },\n    { "id": "p16", "query": "算一段資料的 MD5 雜湊值", "truth": ["py:hashlib.md5"] },\n    { "id": "p17", "query": "用 zlib 壓縮一段位元組資料", "truth": ["py:zlib.compress"] },\n    { "id": "p18", "query": "解壓縮 zlib 壓縮過的資料", "truth": ["py:zlib.decompress"] },\n    { "id": "p19", "query": "把文字做 URL 編碼（百分比編碼）", "truth": ["py:urllib.parse.quote"] },\n    { "id": "p20", "query": "把 URL 編碼過的文字還原", "truth": ["py:urllib.parse.unquote"] },\n    { "id": "p21", "query": "把網址拆成協定、主機、路徑這些部分", "truth": ["py:urllib.parse.urlparse"] },\n    { "id": "p22", "query": "把一段長文字依指定寬度自動換行", "truth": ["py:textwrap.fill"] },\n    { "id": "p23", "query": "移除多行文字共同的縮排", "truth": ["py:textwrap.dedent"] },\n    { "id": "p24", "query": "把字串裡的 HTML 特殊字元跳脫", "truth": ["py:html.escape"] },\n    { "id": "p25", "query": "把 &amp; 這類 HTML 實體還原成原本的字元", "truth": ["py:html.unescape"] },\n    { "id": "p26", "query": "把命令列字串切成參數清單", "truth": ["py:shlex.split"] },\n    { "id": "p27", "query": "把每個單字的第一個字母大寫", "truth": ["py:string.capwords"] },\n    { "id": "p28", "query": "檢查檔名是不是符合 *.txt 這種萬用字元樣式", "truth": ["py:fnmatch.fnmatch"] },\n    { "id": "p29", "query": "從一份清單裡找出跟輸入最接近的字串", "truth": ["py:difflib.get_close_matches"] },\n    { "id": "p30", "query": "把幾段路徑片段接成一個路徑", "truth": ["py:posixpath.join"] },\n    { "id": "p31", "query": "取出路徑最後面的檔名", "truth": ["py:posixpath.basename"] },\n    { "id": "p32", "query": "把檔名跟副檔名分開", "truth": ["py:posixpath.splitext"] },\n    { "id": "p33", "query": "取出路徑裡資料夾的部分", "truth": ["py:posixpath.dirname"] },\n    { "id": "t01", "query": "把這幾張圖片合成一個 PDF", "truth": ["tool:images_to_pdf"] },\n    { "id": "t02", "query": "把兩份 PDF 合併成一份", "truth": ["tool:merge_pdfs"] },\n    { "id": "t03", "query": "只取出 PDF 的第 3 到第 5 頁", "truth": ["tool:extract_pdf_pages"] },\n    { "id": "t04", "query": "刪掉 PDF 的第一頁", "truth": ["tool:remove_pdf_pages"] },\n    { "id": "t05", "query": "把影片裡的聲音抽成 MP3", "truth": ["tool:extract_audio"] },\n    { "id": "t06", "query": "把這段錄音轉成逐字稿", "truth": ["tool:transcribe_media"] },\n    { "id": "t07", "query": "把字幕燒進影片裡", "truth": ["tool:burn_subtitles"] },\n    { "id": "t08", "query": "把影片轉成動態 GIF", "truth": ["tool:convert_to_animated_gif"] },\n    { "id": "t09", "query": "把這段文字念成語音", "truth": ["tool:text_to_speech"] },\n    { "id": "t10", "query": "把這個網址的網頁內容抓下來", "truth": ["tool:fetch_web_page"] },\n    { "id": "t11", "query": "上網搜尋最新的 AI 新聞", "truth": ["tool:browser_search"] },\n    { "id": "t12", "query": "看這張圖片，告訴我裡面有什麼", "truth": ["tool:interpret_image"] },\n    { "id": "t13", "query": "比較兩張圖片有什麼不同", "truth": ["tool:compare_images"] },\n    { "id": "t14", "query": "讀取我電腦上某個檔案的內容", "truth": ["tool:fs_read_file"] },\n    { "id": "t15", "query": "列出某個資料夾裡有哪些檔案", "truth": ["tool:fs_list_files"] },\n    { "id": "t16", "query": "用 Python 寫一小段程式跑起來算結果", "truth": ["tool:python_execute"] },\n    { "id": "t17", "query": "把這份資料畫成長條圖", "truth": ["tool:render_chart"] },\n    { "id": "t18", "query": "把這篇很長的文章摘要成幾句話", "truth": ["tool:summarize_large_text"] },\n    { "id": "t19", "query": "下載這支 YouTube 影片", "truth": ["tool:youtube_download"] },\n    { "id": "t20", "query": "看目前 git 倉庫有哪些檔案被改動", "truth": ["tool:git_status"] },\n    { "id": "t21", "query": "擷取影片第 10 秒的畫面存成圖片", "truth": ["tool:extract_video_frames"] },\n    { "id": "n01", "kind": "neg", "query": "幫我訂明天到台北的高鐵票", "truth": [] },\n    { "id": "n02", "kind": "neg", "query": "今天台北的天氣怎麼樣", "truth": [] },\n    { "id": "n03", "kind": "neg", "query": "幫我寄一封電子郵件給我的主管", "truth": [] },\n    { "id": "n04", "kind": "neg", "query": "把客廳的冷氣調到 26 度", "truth": [] },\n    { "id": "n05", "kind": "neg", "query": "播放周杰倫的歌", "truth": [] },\n    { "id": "n06", "kind": "neg", "query": "幫我叫一輛計程車到機場", "truth": [] },\n    { "id": "n07", "kind": "neg", "query": "預約下週三下午的牙醫門診", "truth": [] },\n    { "id": "n08", "kind": "neg", "query": "幫我轉帳五千元給小明", "truth": [] }\n  ],\n  "args": [\n    { "unit": "py:statistics.mean", "query": "算 3、5、8、10 的平均值", "expected": { "data": [3, 5, 8, 10] } },\n    { "unit": "py:math.sqrt", "query": "求 144 的平方根", "expected": { "x": 144 } },\n    { "unit": "py:math.log10", "query": "算 1000 以 10 為底的對數", "expected": { "x": 1000 } },\n    { "unit": "py:math.gcd", "query": "求 12 和 18 的最大公因數", "expected": { "args": [12, 18] }, "skipIfNoParams": true },\n    { "unit": "py:base64.b64encode", "query": "把 hello 做 base64 編碼", "expected": { "s": "hello" } },\n    { "unit": "py:hashlib.sha256", "query": "算字串 abc 的 SHA-256", "expected": { "string": "abc" } },\n    { "unit": "py:urllib.parse.quote", "query": "把「你好 世界」做 URL 編碼", "expected": { "string": "你好 世界" } },\n    { "unit": "py:textwrap.fill", "query": "把「The quick brown fox jumps over the lazy dog」每行寬度 20 換行", "expected": { "text": "The quick brown fox jumps over the lazy dog", "width": 20 } },\n    { "unit": "py:html.escape", "query": "把 <b>hi</b> 跳脫成 HTML 安全的文字", "expected": { "s": "<b>hi</b>" } },\n    { "unit": "py:posixpath.basename", "query": "取出 /home/user/notes/todo.txt 的檔名", "expected": { "p": "/home/user/notes/todo.txt" } },\n    { "unit": "py:string.capwords", "query": "把「hello big world」每個字首字母大寫", "expected": { "s": "hello big world" } },\n    { "unit": "py:math.factorial", "query": "算 7 的階乘", "expected": { "x": 7 } },\n    { "unit": "tool:fetch_web_page", "query": "抓 https://example.com/news 的內容", "expected": { "url": "https://example.com/news" } },\n    { "unit": "tool:text_to_speech", "query": "把「你好，歡迎使用」念成語音", "expected": { "text": "你好，歡迎使用" } },\n    { "unit": "tool:browser_search", "query": "搜尋「最新 AI 新聞」", "expected": { "query": "最新 AI 新聞" } },\n    { "unit": "tool:fs_read_file", "query": "讀取 C:/notes/todo.txt", "expected": { "path": "C:/notes/todo.txt" } },\n    { "unit": "tool:fs_list_files", "query": "列出 D:/projects 資料夾裡的檔案", "expected": { "path": "D:/projects" } },\n    { "unit": "tool:interpret_image", "query": "描述 file_id 是 abc123 的這張圖", "expected": { "file_id": "abc123" } }\n  ],\n  "intents": {\n    "py:statistics.mean": "計算平均值",\n    "py:statistics.median": "計算中位數",\n    "py:statistics.stdev": "計算樣本標準差",\n    "py:statistics.mode": "找出出現最多次的值（眾數）",\n    "py:math.sqrt": "計算平方根",\n    "py:math.factorial": "計算階乘",\n    "py:math.gcd": "計算最大公因數",\n    "py:math.ceil": "無條件進位",\n    "py:math.floor": "無條件捨去",\n    "py:math.log10": "計算以 10 為底的對數",\n    "py:json.loads": "JSON 字串轉成資料結構",\n    "py:json.dumps": "資料結構轉成 JSON 文字",\n    "py:base64.b64encode": "base64 編碼",\n    "py:base64.b64decode": "base64 解碼",\n    "py:hashlib.sha256": "計算 SHA-256 雜湊",\n    "py:hashlib.md5": "計算 MD5 雜湊",\n    "py:zlib.compress": "zlib 壓縮",\n    "py:zlib.decompress": "zlib 解壓縮",\n    "py:urllib.parse.quote": "URL 編碼（百分比編碼）",\n    "py:urllib.parse.unquote": "URL 解碼",\n    "py:urllib.parse.urlparse": "把網址拆成各部分",\n    "py:textwrap.fill": "依寬度自動換行",\n    "py:textwrap.dedent": "移除共同縮排",\n    "py:html.escape": "HTML 跳脫",\n    "py:html.unescape": "HTML 實體還原",\n    "py:shlex.split": "切分命令列字串",\n    "py:string.capwords": "每個單字首字母大寫",\n    "py:fnmatch.fnmatch": "檔名萬用字元比對",\n    "py:difflib.get_close_matches": "找最接近的字串",\n    "py:posixpath.join": "接合路徑",\n    "py:posixpath.basename": "取路徑的檔名",\n    "py:posixpath.splitext": "分離檔名與副檔名",\n    "py:posixpath.dirname": "取路徑的資料夾部分"\n  }\n}\n',FA_CATALOG_INTENTS_JSON='{\n "py:statistics.mean": "計算平均值",\n "py:statistics.median": "計算中位數",\n "py:statistics.stdev": "計算樣本標準差",\n "py:statistics.mode": "找出出現最多次的值（眾數）",\n "py:math.sqrt": "計算平方根",\n "py:math.factorial": "計算階乘",\n "py:math.gcd": "計算最大公因數",\n "py:math.ceil": "無條件進位",\n "py:math.floor": "無條件捨去",\n "py:math.log10": "計算以 10 為底的對數",\n "py:json.loads": "JSON 字串轉成資料結構",\n "py:json.dumps": "資料結構轉成 JSON 文字",\n "py:base64.b64encode": "base64 編碼",\n "py:base64.b64decode": "base64 解碼",\n "py:hashlib.sha256": "計算 SHA-256 雜湊",\n "py:hashlib.md5": "計算 MD5 雜湊",\n "py:zlib.compress": "zlib 壓縮",\n "py:zlib.decompress": "zlib 解壓縮",\n "py:urllib.parse.quote": "URL 編碼（百分比編碼）",\n "py:urllib.parse.unquote": "URL 解碼",\n "py:urllib.parse.urlparse": "把網址拆成各部分",\n "py:textwrap.fill": "依寬度自動換行",\n "py:textwrap.dedent": "移除共同縮排",\n "py:html.escape": "HTML 跳脫",\n "py:html.unescape": "HTML 實體還原",\n "py:shlex.split": "切分命令列字串",\n "py:string.capwords": "每個單字首字母大寫",\n "py:fnmatch.fnmatch": "檔名萬用字元比對",\n "py:difflib.get_close_matches": "找最接近的字串",\n "py:posixpath.join": "接合路徑",\n "py:posixpath.basename": "取路徑的檔名",\n "py:posixpath.splitext": "分離檔名與副檔名",\n "py:posixpath.dirname": "取路徑的資料夾部分",\n "tool:add_chapters": "簡報分批寫：把一批章節加進草稿",\n "tool:begin_presentation": "開始做一份很長的簡報（分好幾批寫、最後合成一份）",\n "tool:define_snippet": "存一段很長的文字給簡報用，換成短代號，不用塞進 YAML",\n "tool:finish_presentation": "把簡報草稿的每一批合成一份完整簡報、檢查並存檔",\n "tool:get_presentation_topic": "查簡報格式的規則：版型、投影片欄位、轉場、視覺",\n "tool:get_presentation_yaml": "取得已存的簡報 YAML 內容（用檔案代號或網址）",\n "tool:import_fap_image": "把使用者授權資料夾裡的圖片檔帶進這個任務",\n "tool:import_image_url": "從網頁下載一張圖片帶進任務",\n "tool:list_source_images": "列出這個任務裡看過的所有圖片（上傳的、截圖、網頁下載的）",\n "tool:open_existing_presentation": "打開之前存好的簡報來看或修改",\n "tool:pptx_to_deck": "把使用者上傳的 PowerPoint 檔轉成簡報描述",\n "tool:render_chart": "畫圖表：長條圖、折線圖、圓餅圖，把資料畫成圖片",\n "tool:render_presentation": "檢查簡報描述（YAML）並存成簡報檔、算簡報",\n "py:statistics.correlation": "算兩組數字的相關係數 皮爾森相關",\n "py:statistics.covariance": "算兩組數字的共變異數",\n "py:statistics.fmean": "算平均值（浮點數，比較快）",\n "py:statistics.geometric_mean": "算幾何平均數 成長率平均",\n "py:statistics.harmonic_mean": "算調和平均數",\n "py:statistics.median_grouped": "算分組資料的中位數",\n "py:statistics.median_high": "取偏高的中位數（偶數個時取較大那個）",\n "py:statistics.median_low": "取偏低的中位數（偶數個時取較小那個）",\n "py:statistics.multimode": "找出出現最多次的值（可能有好幾個）眾數",\n "py:statistics.pstdev": "算母體標準差",\n "py:statistics.pvariance": "算母體變異數",\n "py:statistics.quantiles": "把資料切成相同機率的區間 分位數 四分位數",\n "py:statistics.variance": "算樣本變異數",\n "py:math.acos": "反餘弦 算角度（弧度）",\n "py:math.acosh": "反雙曲餘弦",\n "py:math.asin": "反正弦 算角度（弧度）",\n "py:math.asinh": "反雙曲正弦",\n "py:math.atan": "反正切 算角度（弧度）",\n "py:math.atan2": "由 y 和 x 算角度（弧度） 方位角",\n "py:math.atanh": "反雙曲正切",\n "py:math.cbrt": "算立方根 開三次方",\n "py:math.comb": "算組合數 從 n 個選 k 個有幾種選法",\n "py:math.copysign": "取一個數的大小、配上另一個數的正負號",\n "py:math.cos": "算餘弦",\n "py:math.cosh": "雙曲餘弦",\n "py:math.degrees": "弧度轉角度",\n "py:math.dist": "算兩點之間的歐氏距離",\n "py:math.erf": "誤差函數",\n "py:math.erfc": "互補誤差函數",\n "py:math.exp": "算 e 的 x 次方 指數",\n "py:math.exp2": "算 2 的 x 次方",\n "py:math.expm1": "算 e 的 x 次方減 1（小數字比較準）",\n "py:math.fabs": "取絕對值（浮點數）",\n "py:math.fma": "乘加合併運算 x 乘 y 再加 z",\n "py:math.fmod": "取餘數（浮點數，依 C 語言規則）",\n "py:math.frexp": "把數字拆成尾數和指數",\n "py:math.fsum": "精確加總一串浮點數 加總",\n "py:math.gamma": "伽瑪函數 階乘的推廣",\n "py:math.hypot": "算多維的歐氏長度 斜邊長 向量長度",\n "py:math.isclose": "判斷兩個浮點數是不是差不多相等",\n "py:math.isfinite": "判斷數字是不是有限（不是無限大也不是 NaN）",\n "py:math.isinf": "判斷是不是正負無限大",\n "py:math.isnan": "判斷是不是 NaN（不是數字）",\n "py:math.isqrt": "算整數平方根（只取整數部分）",\n "py:math.lcm": "算最小公倍數",\n "py:math.ldexp": "算 x 乘 2 的 i 次方",\n "py:math.lgamma": "伽瑪函數絕對值的自然對數",\n "py:math.log1p": "算 1 加 x 的自然對數（小數字比較準）",\n "py:math.log2": "算以 2 為底的對數",\n "py:math.modf": "把數字拆成小數部分和整數部分",\n "py:math.nextafter": "取下一個浮點數（往指定方向）",\n "py:math.perm": "算排列數 從 n 個排 k 個有幾種排法",\n "py:math.pow": "算次方 x 的 y 次方",\n "py:math.prod": "把一串數字全部相乘 連乘",\n "py:math.radians": "角度轉弧度",\n "py:math.remainder": "算 IEEE 規則的餘數（與 y 最近倍數的差）",\n "py:math.sin": "算正弦",\n "py:math.sinh": "雙曲正弦",\n "py:math.sumprod": "兩組數字對應相乘再加總 內積",\n "py:math.tan": "算正切",\n "py:math.tanh": "雙曲正切",\n "py:math.ulp": "取浮點數最小的位元單位 精度",\n "py:textwrap.wrap": "把一段長文字依寬度折成多行 自動換行",\n "py:textwrap.shorten": "把文字縮短到指定寬度（太長就截斷加省略）",\n "py:base64.encodebytes": "把位元組編成多行 base64 文字",\n "py:base64.b32encode": "base32 編碼",\n "py:base64.b32hexencode": "base32hex 編碼",\n "py:base64.b16encode": "base16 編碼 轉十六進位文字",\n "py:base64.b85encode": "base85 編碼",\n "py:base64.b85decode": "base85 解碼",\n "py:base64.a85encode": "Ascii85 編碼",\n "py:base64.a85decode": "Ascii85 解碼",\n "py:base64.z85encode": "z85 編碼",\n "py:base64.z85decode": "z85 解碼",\n "py:base64.standard_b64encode": "標準 base64 編碼",\n "py:base64.urlsafe_b64encode": "網址安全的 base64 編碼",\n "py:zlib.adler32": "算 Adler-32 校驗碼",\n "py:zlib.crc32": "算 CRC-32 校驗碼 檢查資料有沒有壞",\n "py:urllib.parse.urljoin": "把基底網址和相對網址組成完整網址 網址相加",\n "py:urllib.parse.urldefrag": "移除網址最後的 # 片段",\n "py:urllib.parse.urlsplit": "把網址拆成協定、主機、路徑、查詢、片段 解析網址",\n "py:urllib.parse.parse_qs": "解析網址查詢字串 取出參數（每個參數是清單）",\n "py:urllib.parse.parse_qsl": "解析網址查詢字串 取出參數（成對的清單）",\n "py:urllib.parse.quote_plus": "網址編碼（空白變加號）",\n "py:urllib.parse.quote_from_bytes": "把位元組做網址編碼",\n "py:urllib.parse.unquote_plus": "網址解碼（加號變空白）",\n "py:urllib.parse.unquote_to_bytes": "網址解碼成位元組",\n "py:operator.abs": "取絕對值",\n "py:operator.concat": "把兩個序列接在一起 串接",\n "py:operator.index": "轉成整數索引",\n "py:fnmatch.fnmatchcase": "判斷檔名符不符合萬用字元樣式（分大小寫）",\n "py:fnmatch.translate": "把萬用字元樣式轉成正規表示式",\n "py:shlex.quote": "把字串變成 shell 安全的字串 加跳脫引號",\n "py:shlex.join": "把一串參數組成 shell 命令字串",\n "py:difflib.restore": "從差異結果還原出其中一份原始內容",\n "py:difflib.IS_CHARACTER_JUNK": "判斷字元是不是可忽略的（空白或 tab）",\n "py:posixpath.isabs": "判斷路徑是不是絕對路徑",\n "py:posixpath.commonprefix": "找出多個路徑最長的共同開頭",\n "py:posixpath.islink": "判斷路徑是不是符號連結",\n "py:posixpath.exists": "判斷路徑存不存在",\n "py:posixpath.lexists": "判斷路徑存不存在（符號連結本身也算）",\n "py:posixpath.isfile": "判斷路徑是不是一般檔案",\n "py:posixpath.ismount": "判斷路徑是不是掛載點",\n "py:posixpath.expanduser": "展開路徑裡的 ~ 家目錄",\n "py:posixpath.expandvars": "展開路徑裡的環境變數",\n "py:posixpath.normpath": "整理路徑 去掉多餘的斜線和 ..",\n "py:posixpath.abspath": "把路徑變成絕對路徑",\n "py:posixpath.sameopenfile": "判斷兩個打開的檔案是不是同一個檔案",\n "py:posixpath.realpath": "取得路徑的真實位置（解開符號連結）",\n "py:posixpath.isjunction": "判斷路徑是不是 Windows 連接點",\n "py:posixpath.isdevdrive": "判斷路徑是不是在 Windows 開發磁碟機上"\n}\n',FA_CATALOG_EXTRACT_PY="# 單元目錄的 Python 抽取器（只用標準庫；在 Pyodide 或一般 CPython 裡都能跑）。設計見 DESIGN.unit-catalog.md 第三、四、五節。\n# 用法：JS 端把 REQ 那一行的占位符換成請求（JSON 字串的字面值）再執行；輸出一行 \"FA_EXTRACT_RESULT:\" + JSON。\n#   請求：{\"modules\": [\"statistics\", ...], \"max_per_module\": 400, \"doctest\": true}\n# 這個腳本只「讀」：不呼叫任何被抽取的函式（doctest 範例只當文字存起來，之後在沙盒裡驗證才會執行）。\nimport sys, json, inspect, importlib, re, ast\n\nREQ = json.loads(__FA_REQ__)\nfor _p in REQ.get('sys_path', []):  # 測試用：把暫存資料夾加進搜尋路徑\n    sys.path.insert(0, _p)\n\n# 匯入不明的模組會執行它的程式碼：匯入期間用稽核掛鉤擋下網路、子行程、開瀏覽器、系統呼叫（不擋 open：匯入系統自己要讀檔）。\n_BLOCK_IMPORT = {'os.system', 'os.exec', 'os.posix_spawn', 'os.spawn', 'os.fork', 'os.forkpty', 'webbrowser.open', 'ctypes.dlopen'}\n_imp = {'armed': False}\n\n\ndef _import_hook(event, args):\n    if _imp['armed'] and (event in _BLOCK_IMPORT or event.startswith('socket.') or event.startswith('subprocess.')):\n        raise RuntimeError('blocked-at-import:' + event)\n\n\ntry:\n    sys.addaudithook(_import_hook)\nexcept Exception:\n    pass\n\n# 副作用：整個模組的規則（不執行任何東西）。沒有列出的模組一律 unknown（保守）。\nPURE_MODULES = set('json re math cmath statistics string textwrap base64 binascii hashlib hmac zlib html operator itertools functools collections urllib.parse difflib fractions decimal bisect heapq copy unicodedata struct csv shlex pprint numbers keyword token fnmatch posixpath ntpath colorsys calendar'.split())\nEFFECT_MODULES = {\n    'os': ['fs.read', 'fs.write', 'env', 'proc'], 'shutil': ['fs.read', 'fs.write'], 'subprocess': ['proc'], 'socket': ['net'], 'ssl': ['net'], 'urllib.request': ['net'],\n    'http.client': ['net'], 'ftplib': ['net'], 'smtplib': ['net'], 'random': ['random'], 'secrets': ['random'], 'time': ['time'], 'tempfile': ['fs.write'], 'glob': ['fs.read'],\n    'pathlib': ['fs.read', 'fs.write'], 'sqlite3': ['fs.write'], 'webbrowser': ['proc', 'ui'], 'ctypes': ['proc'], 'multiprocessing': ['proc'], 'threading': ['proc'], 'sys': ['env'],\n    'datetime': ['time'], 'logging': ['ui'], 'pickle': ['fs.read', 'fs.write'], 'shelve': ['fs.write'], 'zipfile': ['fs.read', 'fs.write'], 'tarfile': ['fs.read', 'fs.write'],\n}\nFS_READ_NAMES = re.compile(r'^(exists|lexists|isfile|isdir|islink|ismount|getsize|getmtime|getatime|getctime|realpath|samefile|samestat|sameopenfile)$')\n\n\ndef type_name(a):\n    if a is inspect.Parameter.empty or a is inspect.Signature.empty:\n        return None\n    if isinstance(a, str):\n        return a\n    n = getattr(a, '__name__', None)\n    if n and not getattr(a, '__args__', None):\n        return n\n    return str(a).replace('typing.', '')\n\n\ndef first_para(doc):\n    doc = (doc or '').strip()\n    if not doc:\n        return ''\n    para = re.split(r'\\n\\s*\\n', doc, maxsplit=1)[0]\n    return re.sub(r'\\s+', ' ', para)[:300]\n\n\ndef sig_from_doc(name, doc):\n    # C 實作的函式 inspect 拿不到簽名時，試著解析文件字串第一行 name(a, b, /, *, c=1)\n    first = (doc or '').strip().split('\\n', 1)[0]\n    m = re.match(r'^' + re.escape(name) + r'\\((.*)\\)\\s*(?:->.*)?$', first)\n    if not m:\n        return None\n    params, seen_star = [], False\n    for part in [x.strip() for x in m.group(1).split(',') if x.strip()]:\n        if part == '/':\n            for p in params:\n                if p['kind'] == 'POSITIONAL_OR_KEYWORD':\n                    p['kind'] = 'POSITIONAL_ONLY'\n            continue\n        if part == '*':\n            seen_star = True\n            continue\n        default = None\n        if '=' in part:\n            part, default = [x.strip() for x in part.split('=', 1)]\n        kind = 'VAR_POSITIONAL' if part.startswith('**') is False and part.startswith('*') else ('VAR_KEYWORD' if part.startswith('**') else ('KEYWORD_ONLY' if seen_star else 'POSITIONAL_OR_KEYWORD'))\n        params.append({'name': part.lstrip('*'), 'kind': kind, 'default': default, 'annotation': None})\n    return params\n\n\ndef doctests(doc, limit=3):\n    out, lines = [], (doc or '').split('\\n')\n    i = 0\n    while i < len(lines) and len(out) < limit:\n        s = lines[i].strip()\n        if s.startswith('>>> '):\n            expr = s[4:].strip()\n            exp, j = [], i + 1\n            while j < len(lines) and lines[j].strip() and not lines[j].strip().startswith('>>>') and not lines[j].strip().startswith('...'):\n                exp.append(lines[j].strip())\n                j += 1\n            try:\n                ast.parse(expr, mode='eval')\n                ok = True\n            except SyntaxError:\n                ok = False\n            e = ' '.join(exp)\n            if ok and e and '<' not in e and 'Traceback' not in e and len(expr) < 200 and len(e) < 200:\n                out.append({'expr': expr, 'expect': e, 'src': 'doctest'})\n            i = j\n        else:\n            i += 1\n    return out\n\n\nRISKY_IMPORTS = set('os shutil subprocess socket ssl urllib.request http.client http.server ftplib smtplib poplib imaplib telnetlib tempfile glob pathlib sqlite3 webbrowser ctypes multiprocessing threading pickle shelve zipfile tarfile requests urllib3 httpx aiohttp asyncio selectors signal pty fcntl mmap'.split())\nRISKY_CALLS = {'open', 'eval', 'exec', 'compile', '__import__', 'input', 'breakpoint', 'system', 'popen'}\n\n\nSYS_PURE_CALLS = {'getsizeof', 'getrecursionlimit', 'intern', 'getdefaultencoding', 'getfilesystemencoding', 'is_finalizing', 'exc_info', 'getrefcount'}\nDANGER_METHODS = {  # 接收者不明的方法呼叫：名稱幾乎只會做這件事的才算（read／write／remove 太常見，在 list、檔案物件、參數上都有，不算）\n    'connect': 'net', 'send': 'net', 'sendall': 'net', 'recv': 'net', 'sendto': 'net', 'recvfrom': 'net', 'urlopen': 'net', 'getaddrinfo': 'net',\n    'popen': 'proc', 'system': 'proc', 'communicate': 'proc', 'unlink': 'fs.write', 'rmdir': 'fs.write', 'mkdir': 'fs.write', 'makedirs': 'fs.write',\n    'write_text': 'fs.write', 'write_bytes': 'fs.write', 'read_text': 'fs.read', 'read_bytes': 'fs.read', 'touch': 'fs.write', 'rename': 'fs.write',\n    'iterdir': 'fs.read', 'listdir': 'fs.read', 'rglob': 'fs.read', 'glob': 'fs.read', 'exists': 'fs.read', 'is_file': 'fs.read', 'is_dir': 'fs.read', 'stat': 'fs.read',\n}\nMUTATORS = {'append', 'extend', 'update', 'add', 'pop', 'clear', 'setdefault', 'insert', 'remove', 'discard', 'popitem', 'sort', 'reverse'}\nBUILTIN_UI = {'print', 'input'}\nBUILTIN_UNKNOWN = {'eval', 'exec', 'compile', '__import__'}\nNET_LIBS = {'requests', 'httpx', 'urllib3', 'aiohttp', 'websockets', 'websocket', 'paramiko', 'boto3', 'botocore', 'grpc', 'pymysql', 'psycopg2', 'redis', 'pymongo'}  # 常見的第三方網路函式庫：呼叫它們就是 net\nSUMMARIES = {}  # 這次抽取裡已經分析過的第三方模組：{模組: {名稱: (效果集合, 證據)}}，後面的模組呼叫它們時用\n\n\ndef open_effects(call):\n    mode = None\n    if len(call.args) >= 2 and isinstance(call.args[1], ast.Constant) and isinstance(call.args[1].value, str):\n        mode = call.args[1].value\n    elif len(call.args) >= 2:\n        return {'fs.read', 'fs.write'}  # 模式不是常數字串：兩種都算\n    for k in call.keywords:\n        if k.arg == 'mode':\n            if isinstance(k.value, ast.Constant) and isinstance(k.value.value, str):\n                mode = k.value.value\n            else:\n                return {'fs.read', 'fs.write'}\n    if mode is None or not any(c in mode for c in 'wax+'):\n        return {'fs.read'}\n    return {'fs.write', 'fs.read'} if ('+' in mode) else {'fs.write'}\n\n\nOS_FUNCS = {}\nfor _n in 'listdir scandir stat lstat walk getcwd getcwdb readlink access fwalk statvfs path_exists'.split():\n    OS_FUNCS[_n] = {'fs.read'}\nfor _n in 'remove unlink rename renames replace rmdir removedirs mkdir makedirs chmod chown lchown truncate symlink link utime mkfifo mknod chdir chroot sync'.split():\n    OS_FUNCS[_n] = {'fs.write'}\nfor _n in 'getenv getenvb putenv unsetenv getlogin uname environ_get'.split():\n    OS_FUNCS[_n] = {'env'}\nfor _n in 'system popen execv execve execl execle execlp execlpe execvp execvpe spawnl spawnle spawnv spawnve spawnvp spawnlp fork forkpty kill killpg startfile abort _exit wait waitpid'.split():\n    OS_FUNCS[_n] = {'proc'}\nOS_FUNCS['urandom'] = {'random'}\nOS_PURE = set('fsencode fsdecode fspath cpu_count getpid getppid strerror get_terminal_size fdopen_none sep getuid getgid get_exec_path'.split())\nPATHLIB_PURE = {'Path', 'PurePath', 'PurePosixPath', 'PureWindowsPath', 'PosixPath', 'WindowsPath'}\nTHREAD_PURE = {'Lock', 'RLock', 'Event', 'local', 'Semaphore', 'BoundedSemaphore', 'Condition', 'Barrier', 'current_thread', 'get_ident', 'active_count'}\n\n\ndef module_call_effects(modname, fname):\n    \"\"\"呼叫「某個已匯入的模組」的函式：回傳 (效果集合, 說明)。標準庫查規則表；第三方先查這次抽取已分析過的模組；都沒有就是 unknown。\"\"\"\n    if modname == 'sys':\n        return (set(), '') if fname in SYS_PURE_CALLS else ({'env'}, 'sys.' + fname)\n    if modname in PURE_MODULES or modname.split('.')[0] in PURE_MODULES and modname.split('.')[0] not in ('os',):\n        if modname.startswith('os.path') or modname in ('posixpath', 'ntpath'):\n            return ({'fs.read'}, modname + '.' + fname) if FS_READ_NAMES.match(fname) else (set(), '')\n        return set(), ''\n    if modname in ('os.path', 'posixpath', 'ntpath'):\n        return ({'fs.read'}, modname + '.' + fname) if FS_READ_NAMES.match(fname) else (set(), '')\n    if modname == 'os':  # os 整個模組太粗：依函式名稱分；沒列到的保守當 unknown\n        if fname in OS_PURE:\n            return set(), ''\n        if fname in OS_FUNCS:\n            return set(OS_FUNCS[fname]), 'os.' + fname\n        return {'unknown'}, 'unclassified os.' + fname\n    if modname == 'pathlib' and fname in PATHLIB_PURE:\n        return set(), ''\n    if modname == 'threading' and fname in THREAD_PURE:\n        return set(), ''\n    if modname == 'datetime':\n        return ({'time'}, 'datetime.' + fname) if re.match(r'^(now|today|utcnow|fromtimestamp)$', fname) else (set(), '')\n    for key in (modname, modname.split('.')[0]):\n        if key in EFFECT_MODULES:\n            return set(EFFECT_MODULES[key]), key + '.' + fname\n    if modname.split('.')[0] in NET_LIBS:\n        return {'net'}, modname + '.' + fname\n    if modname in SUMMARIES:\n        s = SUMMARIES[modname].get(fname)\n        if s is not None:\n            return set(s[0]), 'calls ' + modname + '.' + fname\n    if stdlib(modname):\n        return set(), ''  # 其他標準庫（沒列在規則表的）當成沒有副作用——這是假設，不是證明；探測時稽核掛鉤會擋\n    return {'unknown'}, 'unresolved ' + modname + '.' + fname\n\n\ndef analyze_module(mod):\n    \"\"\"第三方模組的函式層級靜態副作用分析：對每個模組層級的函式（和類別的建構／方法），找出它直接做的事、呼叫了什麼，再沿著模組內的呼叫鏈合併。\n    回傳 {名稱: (效果集合, 證據清單)}。看不到原始碼或解析不了的模組回傳 {}（全部 unknown，保守）。\"\"\"\n    try:\n        import inspect as _i\n        src = _i.getsource(mod)\n        tree = ast.parse(src)\n    except Exception:\n        return {}\n    imports = {}  # 本地名稱 -> ('mod', 模組) 或 ('from', 模組, 名稱)\n    defs, classes = {}, {}\n    for n in ast.walk(tree):\n        if isinstance(n, ast.Import):\n            for a in n.names:\n                imports[(a.asname or a.name.split('.')[0])] = ('mod', a.name if a.asname else a.name.split('.')[0])\n        elif isinstance(n, ast.ImportFrom) and n.module and not n.level:\n            for a in n.names:\n                imports[a.asname or a.name] = ('from', n.module, a.name)\n    for n in tree.body:\n        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):\n            defs[n.name] = n\n        elif isinstance(n, ast.ClassDef):\n            classes[n.name] = n\n    globals_assigned = set()\n    for n in tree.body:\n        if isinstance(n, ast.Assign):\n            for t in n.targets:\n                if isinstance(t, ast.Name):\n                    globals_assigned.add(t.id)\n    direct, edges = {}, {}\n\n    def local_names(fn):\n        names = {a.arg for a in fn.args.args + fn.args.posonlyargs + fn.args.kwonlyargs}\n        if fn.args.vararg:\n            names.add(fn.args.vararg.arg)\n        if fn.args.kwarg:\n            names.add(fn.args.kwarg.arg)\n        for x in ast.walk(fn):\n            if isinstance(x, ast.Name) and isinstance(x.ctx, ast.Store):\n                names.add(x.id)\n        return names\n\n    def scan(fn, key):\n        eff, evid, calls = set(), [], set()\n        loc = local_names(fn)\n        for x in ast.walk(fn):\n            if isinstance(x, ast.Global):\n                eff.add('state.write'); evid.append('global ' + ','.join(x.names))\n            elif isinstance(x, (ast.Import, ast.ImportFrom)) and x is not fn:\n                for a in x.names:  # 函式裡的匯入\n                    if isinstance(x, ast.Import):\n                        imports.setdefault(a.asname or a.name.split('.')[0], ('mod', a.name if a.asname else a.name.split('.')[0]))\n                    elif x.module and not x.level:\n                        imports.setdefault(a.asname or a.name, ('from', x.module, a.name))\n            elif isinstance(x, ast.Attribute) and isinstance(x.ctx, ast.Store):\n                base = x.value\n                while isinstance(base, ast.Attribute):\n                    base = base.value\n                if isinstance(base, ast.Name) and (base.id in imports or (base.id in globals_assigned and base.id not in loc)):\n                    eff.add('state.write'); evid.append('assigns ' + base.id + '.' + x.attr)\n            elif isinstance(x, ast.Call):\n                f = x.func\n                if isinstance(f, ast.Name):\n                    nm = f.id\n                    if nm == 'open' and nm not in loc and nm not in defs:\n                        e = open_effects(x); eff |= e; evid.append('open()')\n                    elif nm in BUILTIN_UI and nm not in loc:\n                        eff.add('ui'); evid.append(nm + '()')\n                    elif nm in BUILTIN_UNKNOWN and nm not in loc:\n                        eff.add('unknown'); evid.append(nm + '()')\n                    elif nm in loc:\n                        pass  # 呼叫參數或區域變數（回呼）：效果屬於傳進來的函式\n                    elif nm in defs or nm in classes:\n                        calls.add(nm)\n                    elif nm in imports:\n                        imp = imports[nm]\n                        if imp[0] == 'from':\n                            e, why = module_call_effects(imp[1], imp[2])\n                            if e:\n                                eff |= e; evid.append(why)\n                        # ('mod', …) 被直接呼叫（模組不能呼叫）：忽略\n                elif isinstance(f, ast.Attribute):\n                    chain, base = [f.attr], f.value\n                    while isinstance(base, ast.Attribute):\n                        chain.append(base.attr)\n                        base = base.value\n                    chain.reverse()\n                    if isinstance(base, ast.Name):\n                        b = base.id\n                        if b in loc and b not in imports:\n                            if f.attr in DANGER_METHODS:\n                                eff.add(DANGER_METHODS[f.attr]); evid.append('.' + f.attr + '()')\n                        elif b in imports:\n                            imp = imports[b]\n                            if imp[0] == 'mod':\n                   