sis:"javac [選項] 原始檔...",options:[{flag:"-d",arg:"目錄",desc:"指定 .class 輸出目錄（會依套件建立子資料夾）"},{flag:"-cp",arg:"路徑",desc:"類別搜尋路徑（資料夾與 jar，分隔字元 Linux 用 : ，Windows 用 ;）"},{flag:"-classpath",arg:"路徑",desc:"同 -cp"},{flag:"--class-path",arg:"路徑",desc:"同 -cp"},{flag:"-sourcepath",arg:"路徑",desc:"原始碼搜尋路徑"},{flag:"--source-path",arg:"路徑",desc:"同 -sourcepath"},{flag:"-encoding",arg:"編碼",desc:"原始檔編碼（例如 UTF-8）；編碼不對會出現亂碼或「unmappable character」"},{flag:"-source",arg:"版本",desc:"原始碼相容的語言版本"},{flag:"-target",arg:"版本",desc:"產生適用該 JVM 版本的位元組碼"},{flag:"--release",arg:"版本",desc:"同時指定 source、target 並使用對應版本的標準函式庫 API（建議取代 -source/-target）"},{flag:"-g",arg:"",desc:"產生全部除錯資訊"},{flag:"-g:*",arg:"",desc:"指定除錯資訊 {v}（none、lines、vars、source）"},{flag:"-nowarn",arg:"",desc:"關閉警告"},{flag:"-Xlint",arg:"",desc:"啟用所有建議的警告"},{flag:"-Xlint:*",arg:"",desc:"啟用特定警告 {v}（unchecked、deprecation、rawtypes …）"},{flag:"-Werror",arg:"",desc:"警告當錯誤"},{flag:"-deprecation",arg:"",desc:"顯示已棄用 API 的細節"},{flag:"-verbose",arg:"",desc:"顯示編譯器正在做什麼"},{flag:"-processor",arg:"類別",desc:"指定註解處理器"},{flag:"-processorpath",arg:"路徑",desc:"註解處理器的搜尋路徑"},{flag:"-proc:*",arg:"",desc:"註解處理方式 {v}（none 不處理、only 只處理）"},{flag:"-parameters",arg:"",desc:"在 .class 保留方法參數名稱（反射、Spring 等用）"},{flag:"-p",arg:"路徑",desc:"模組路徑（Java 9+）"},{flag:"--module-path",arg:"路徑",desc:"模組路徑"},{flag:"--add-modules",arg:"模組",desc:"額外加入的模組"},{flag:"--add-exports",arg:"設定",desc:"把模組內的套件匯出給其他模組"},{flag:"--enable-preview",arg:"",desc:"啟用預覽語言功能"},{flag:"-version",arg:"",desc:"顯示版本"},{flag:"-J*",arg:"",desc:"把選項 {v} 傳給底層 JVM（例如 -J-Xmx2g）"},{flag:"-h",arg:"目錄",desc:"產生 JNI 原生標頭檔（.h）的輸出目錄"},{flag:"-s",arg:"目錄",desc:"指定產生的原始檔輸出目錄"},{flag:"-XDrawDiagnostics",arg:"",desc:"以原始格式輸出診斷（測試用）"}],subs:{},lists:{}},java:{name:"java",aliases:["java.exe"],summary:"Java 虛擬機：執行 .class、jar 或單一原始檔",synopsis:"java [選項] 主類別|-jar 檔案.jar [引數...]",options:[{flag:"-jar",arg:"檔案",desc:"執行 jar（主類別由 MANIFEST.MF 的 Main-Class 指定）"},{flag:"-cp",arg:"路徑",desc:"類別搜尋路徑"},{flag:"-classpath",arg:"路徑",desc:"同 -cp"},{flag:"--class-path",arg:"路徑",desc:"同 -cp"},{flag:"-D*",arg:"",desc:"設定系統屬性 {v}（key=value），程式用 System.getProperty 讀取"},{flag:"-Xmx*",arg:"",desc:"設定堆積上限為 {v}（例如 -Xmx2g）"},{flag:"-Xms*",arg:"",desc:"設定初始堆積大小為 {v}"},{flag:"-Xss*",arg:"",desc:"設定每個執行緒堆疊大小為 {v}"},{flag:"-XX:*",arg:"",desc:"進階 JVM 選項 {v}（例如 +UseG1GC、MaxMetaspaceSize=256m、+HeapDumpOnOutOfMemoryError）"},{flag:"-verbose:*",arg:"",desc:"輸出詳細資訊 {v}（class 載入類別、gc 垃圾回收）"},{flag:"-ea",arg:"",desc:"啟用 assert 斷言"},{flag:"-enableassertions",arg:"",desc:"啟用 assert 斷言"},{flag:"-da",arg:"",desc:"停用 assert 斷言"},{flag:"-agentlib:*",arg:"",desc:"載入原生代理程式 {v}（例如 jdwp 遠端除錯）"},{flag:"-agentpath:*",arg:"",desc:"以路徑載入原生代理程式 {v}"},{flag:"-javaagent:*",arg:"",desc:"載入 Java 代理程式 {v}（位元組碼插樁）"},{flag:"-server",arg:"",desc:"使用 Server VM（現今預設）"},{flag:"-version",arg:"",desc:"印出版本後結束"},{flag:"--version",arg:"",desc:"印出版本後結束"},{flag:"-p",arg:"路徑",desc:"模組路徑"},{flag:"--module-path",arg:"路徑",desc:"模組路徑"},{flag:"-m",arg:"模組/主類別",desc:"執行模組中的主類別"},{flag:"--add-modules",arg:"模組",desc:"額外加入的模組"},{flag:"--add-opens",arg:"設定",desc:"開放模組內部套件給反射使用（Java 9+ 常見的「Illegal reflective access」解法）"},{flag:"--enable-preview",arg:"",desc:"啟用預覽功能"},{flag:"-Dfile.encoding=*",arg:"",desc:"指定預設字元編碼 {v}"},{flag:"-Djava.library.path=*",arg:"",desc:"指定 JNI 原生函式庫搜尋路徑 {v}"},{flag:"-Xdebug",arg:"",desc:"啟用除錯（舊式）"},{flag:"-Xrunjdwp:*",arg:"",desc:"舊式遠端除錯設定 {v}"},{flag:"-Xshare:*",arg:"",desc:"類別資料共享 {v}"},{flag:"-Xint",arg:"",desc:"只用直譯器（不 JIT）"},{flag:"-Xcomp",arg:"",desc:"強制先編譯"},{flag:"-XX:+HeapDumpOnOutOfMemoryError",arg:"",desc:"發生 OutOfMemoryError 時傾印堆積到檔案"},{flag:"-XX:+UseG1GC",arg:"",desc:"使用 G1 垃圾回收器"},{flag:"-XX:+UseZGC",arg:"",desc:"使用 ZGC 低延遲垃圾回收器"}],subs:{},lists:{}},python:{name:"python",aliases:["python3","python2","python.exe","py","python3.8","python3.9","python3.10","python3.11","python3.12","python3.13"],summary:"Python 直譯器：執行腳本、模組或互動模式",synopsis:"python [選項] [-c 指令",options:[{flag:"-c",arg:"程式碼",desc:"執行一段字串形式的程式碼"},{flag:"-m",arg:"模組",desc:"以模組方式執行（例如 -m venv、-m pip、-m http.server、-m unittest、-m pytest、-m json.tool）"},{flag:"-i",arg:"",desc:"執行完腳本後進入互動模式"},{flag:"-u",arg:"",desc:"不緩衝標準輸出與錯誤（日誌即時輸出，管線與容器常用）"},{flag:"-O",arg:"",desc:"最佳化：移除 assert 與 __debug__ 程式碼"},{flag:"-OO",arg:"",desc:"再移除 docstring"},{flag:"-B",arg:"",desc:"不寫 .pyc 位元組碼檔"},{flag:"-E",arg:"",desc:"忽略 PYTHON* 環境變數"},{flag:"-I",arg:"",desc:"隔離模式：忽略環境變數與使用者站台目錄"},{flag:"-s",arg:"",desc:"不加入使用者站台目錄"},{flag:"-S",arg:"",desc:"不匯入 site 模組"},{flag:"-W",arg:"動作",desc:"控制警告（例如 -W error 把警告當錯誤、-W ignore）"},{flag:"-X",arg:"選項",desc:"實作特定選項（例如 -X utf8、-X dev、-X importtime、-X faulthandler）"},{flag:"-q",arg:"",desc:"互動模式不印版本與版權"},{flag:"-v",arg:"",desc:"詳細輸出（顯示每次匯入）"},{flag:"-V",arg:"",desc:"印出版本後結束"},{flag:"--version",arg:"",desc:"印出版本後結束"},{flag:"-h",arg:"",desc:"顯示說明"},{flag:"-b",arg:"",desc:"對 bytes 與 str 混用發出警告"},{flag:"-d",arg:"",desc:"除錯解析器"},{flag:"-x",arg:"",desc:"跳過第一行（非 Unix 的 #! 用）"},{flag:"-P",arg:"",desc:"不把腳本所在目錄或目前目錄放進 sys.path（3.11+）"},{flag:"-R",arg:"",desc:"啟用雜湊隨機化"}],subs:{},lists:{}},node:{name:"node",aliases:["nodejs","node.exe"],summary:"Node.js：用 V8 引擎在伺服端執行 JavaScript",synopsis:"node [選項] [腳本.js",options:[{flag:"-e",arg:"程式碼",desc:"執行一段字串形式的 JavaScript"},{flag:"--eval",arg:"程式碼",desc:"同 -e"},{flag:"-p",arg:"程式碼",desc:"執行並印出結果"},{flag:"--print",arg:"程式碼",desc:"同 -p"},{flag:"-r",arg:"模組",desc:"啟動前預先載入模組（例如 -r ts-node/register、-r dotenv/config）"},{flag:"--require",arg:"模組",desc:"同 -r"},{flag:"--import",arg:"模組",desc:"預先載入 ES 模組"},{flag:"-i",arg:"",desc:"互動模式（REPL）"},{flag:"--inspect",arg:"",desc:"開啟除錯器（預設 127.0.0.1:9229），讓 Chrome DevTools 或 VS Code 連線"},{flag:"--inspect-brk",arg:"",desc:"開啟除錯器並在第一行暫停"},{flag:"--inspect-brk=*",arg:"",desc:"開啟除錯器於 {v} 並在第一行暫停"},{flag:"--inspect=*",arg:"",desc:"開啟除錯器於 {v}"},{flag:"--max-old-space-size=*",arg:"",desc:"老年代堆積上限 {v} MB（處理大資料或 OOM 時調高）"},{flag:"--max-semi-space-size=*",arg:"",desc:"新生代半空間大小 {v} MB"},{flag:"--stack-size=*",arg:"",desc:"V8 堆疊大小 {v}"},{flag:"--expose-gc",arg:"",desc:"提供全域 g