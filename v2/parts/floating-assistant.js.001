卡通…」會加一個風格濾鏡，並請視覺模型看過、不像就加強；說「用 AI 重畫成…」則用生圖模型（線上或本機，同 /image）依這張圖的內容重新畫一張。「修復畫筆」可以在畫面上塗出要修的地方。可以貼圖、給網址、或說「找一張…的圖」。",objectIcon:function(e){return"shape"===e.type?c[e.shape]||"◻":l[e.type]||"◻"},objectInfo:function(e){return"adjust"===e.type?e.ops.map(function(e){return e.op}).slice(0,3).join("+"):"heal"===e.type?e.method:"detail"===e.type?e.result?"preview"===e.state?"預覽中":"已細化":"待細化":"image"===e.type?e.prompt?"AI 畫的":e.credit?"圖片・"+e.credit.split("—")[0].trim().slice(0,12):"圖片":"shape"===e.type?e.shape:"svg"},parseCommands:function(t,n){return e.parseCommands(t,n,{styleToHost:!0})},promptOf:e.specToPrompt,exports:[{id:"png",label:"PNG 圖片"},{id:"jpg",label:"JPEG 圖片"},{id:"json",label:"專案（JSON）",chat:!1}],runExport:async function(e,t){var n,r=(n=t.title,String(n||"picture").replace(/[\\/:*?"<>|\u0000-\u001f]+/g," ").replace(/\s+/g,"_").replace(/^_+|_+$/g,"").slice(0,50)||"picture");if("json"===e)return{blob:new Blob([JSON.stringify(t,null,1)],{type:"application/json"}),name:r+".json",mime:"application/json"};var a=await g(t,{store:s,resolve:i,frameOnly:!0,maxSide:8192});if(!a)return null;if("jpg"===e){var o=document.createElement("canvas");o.width=a.canvas.width,o.height=a.canvas.height;var l=o.getContext("2d");return l.fillStyle="#fff",l.fillRect(0,0,o.width,o.height),l.drawImage(a.canvas,0,0),{blob:await y(o,"image/jpeg",.92),name:r+".jpg",mime:"image/jpeg"}}return{blob:await y(a.canvas,"image/png"),name:r+".png",mime:"image/png"}},build:function(t){var n=null,l=null,c=null,d=null,p=0,u=null,m=!1,f=12,h=null,y=null,b=!1,v=null,_=null,w=o("div"),x=o("div");w.style.cssText="display:flex;flex:1;min-height:0;min-width:0",x.style.cssText="display:flex;flex-direction:column;gap:6px;flex:1";var k=o("canvas"),S=k.getContext("2d");k.style.cssText="display:block;width:100%;height:100%;touch-action:none";var E=function(){var e=o("canvas");e.width=e.height=16;var t=e.getContext("2d");return t.fillStyle="#e9ebef",t.fillRect(0,0,16,16),t.fillStyle="#dfe2e7",t.fillRect(0,0,8,8),