.",languages:{c:["i2c_smbus_read_byte","i2c_smbus_write_byte","i2c_smbus_read_byte_data","i2c_smbus_write_byte_data","i2c_smbus_read_word_data","i2c_smbus_write_word_data","i2c_smbus_read_i2c_block_data","i2c_smbus_write_i2c_block_data","i2c_smbus_xfer","i2c_smbus_access","i2c_transfer","i2c_master_send","i2c_master_recv","devm_regmap_init_i2c"],java:[],python:[],javascript:[],html:[]}},peci_bus:{label:"PECI (Platform Environment Control Interface)",description:"Intel PECI - the sideband bus a BMC uses to query CPU temperature/config registers directly, without going through the host OS. Directly relevant to this project's BMC/IPMI domain (ipmitool's sensor-reading code is PECI's userspace-visible sibling).",languages:{c:["peci_Ping","peci_GetDIB","peci_GetTemp","peci_RdPkgConfig","peci_WrPkgConfig","peci_RdIAMSR","peci_RdPCIConfig","peci_WrPCIConfig","peci_Lock","peci_Unlock","peci_GetCPUID","peci_request_alloc","peci_request_free","peci_command"],java:[],python:[],javascript:[],html:[]}},kernel_mailbox:{label:"Linux kernel mailbox framework (BMC<->host IPC)",description:"The kernel mailbox subsystem used for BMC<->host or SoC<->coprocessor message passing (e.g. ASPEED/Nuvoton BMC mailbox controllers) - a hardware-backed IPC channel, distinct from the OS-level `ipc` category.",languages:{c:["mbox_request_channel","mbox_request_channel_byname","mbox_send_message","mbox_client_register","mbox_client_unregister","mbox_free_channel","mbox_client_txdone","mbox_flush"],java:[],python:[],javascript:[],html:[]}},usb_hid:{label:"USB / HID device access (libusb, hidapi, WinUSB)",description:"Cross-platform USB bulk/control/interrupt transfers and HID report I/O - libusb + hidapi on Linux, WinUSB + the hid.dll HidD_* API + SetupAPI device enumeration on Windows. Kept as one category since it's the same conceptual operation (talk to a USB device) regardless of OS.",languages:{c:["libusb_init","libusb_exit","libusb_open","libusb_close","libusb_open_device_with_vid_pid","libusb_