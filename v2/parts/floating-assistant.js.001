&& p.paths) || {}); if (p && p.base && !out.base) out.base = p.base; if (p && p.data && !out.data) out.data = p.data; return out; }\n  const extFsx = { exists: (f) => exists(f), isDir: (f) => { try { return fs.statSync(f).isDirectory(); } catch (e) { return false; } }, readLines: (f, n) => { try { return fs.readFileSync(f, 'utf8').split(/\\r?\\n/).filter((l) => l.trim()).slice(0, n); } catch (e) { return []; } } };\n  // 逐個模組檢查 import（回傳缺的套件與原因；不跑訓練）\n  async function extModules(py, mods) {\n    const missing = [];\n    for (const m of mods) { const r = await runAsync(py, ['-c', 'import ' + m], { timeout: 60000 }); if (r.error || r.status !== 0) missing.push(m); }\n    return missing;\n  }\n  async function extCheck(p) {\n    const type = String((p && p.type) || ''), spec = ExtJob.specOf(type);\n    if (!spec) return { ok: false, error: '不認得的型別：' + type };\n    if (!spec.wired) return { ok: false, wired: false, error: spec.name + '：' + spec.reason };\n    const n = ExtJob.normalizeParams(type, (p && p.params) || {});\n    const paths = extPaths(p), py = await extPython(p, type), scripts = extScriptsDir(spec);\n    const out = { ok: false, wired: true, type, params: n.params, errors: n.errors.slice(), python: py, scriptsDir: scripts, estimate: spec.estimate, limitsNote: spec.limitsNote || '', paths };\n    if (!py) out.errors.push('找不到訓練用的 Python（請在「運算後端」設定，或指定這個型別的 Python 路徑）');\n    if (py && /[\\\\/]/.test(py) && !exists(py)) out.errors.push('找不到訓練用的 Python：' + py + '（路徑不存在，請改指定正確的 Python）');\n    if (!scripts) out.errors.push('找不到訓練腳本 ' + spec.script + '（主行程沒有接上腳本資料夾）');\n    out.errors = out.errors.concat(ExtJob.checkPaths(type, paths, extFsx));\n    if (py && scripts && !(/[\\\\/]/.test(py) && !exists(py))) { out.missing = await extModules(py, spec.python); if (out.missing.length) out.errors.push('訓練環境缺套件：' + out.missing.join('、')); }\n    out.ok = out.errors.length === 0;\n    return out;\n  }\n  async function extStart(p) {\n    if (activeExt && activeExt.job.state === 'running') return { ok: false, error: '已有外部訓練在執行（' + activeExt.id + '）' };\n    if (activeTrain && activeTrain.state === 'running') return { ok: false, error: '內建訓練進行中，請先等它結束或停止' };\n    const type = String((p && p.type) || ''), name = String((p && p.name) || '');\n    if (!/^[A-Za-z0-9\\u4e00-\\u9fff][A-Za-z0-9._\\-\\u4e00-\\u9fff]{0,63}$/.test(name)) return { ok: false, error: '名稱不合法（英數、中文、點、底線、連字號，最長 64 字）' };\n    const chk = await extCheck(p); if (!chk.ok) return { ok: false, error: (chk.errors || [chk.error || '檢查沒有通過']).join('；'), check: chk };\n    const spec = ExtJob.specOf(type), outDir = P.join(extRoot, type, name);\n    if (exists(outDir) && fs.readdirSync(outDir).length) return { ok: false, error: '輸出資料夾已有內容（換一個名稱，不覆寫）：' + outDir };\n    const plan = ExtJob.planFor(type, p.params || {}, { outDir, scriptsDir: chk.scriptsDir, python: chk.python, nodeExec: process.execPath, paths: chk.paths, nativeRuntimeDir: (typeof d.nativeRuntimeDir === 'function' ? d.nativeRuntimeDir() : null) });\n    if (!plan.ok) return { ok: false, error: plan.errors.join('；') };\n    fs.mkdirSync(outDir, { recursive: true });\n    writeJson(P.join(outDir, 'ext_request.json'), { type, name, params: plan.params, python: chk.python, paths: chk.paths, startedAt: now() });\n    const id = newId('ext');\n    const job = ExtJob.runJob(plan, {\n      spawn: (c, a, o) => cp.spawn(c, a, { cwd: o.cwd, env: Object.assign({}, process.env, o.env || {}), windowsHide: true, detached: process.platform !== 'win32', stdio: ['ignore', 'pipe', 'pipe'] }),\n      kill: extKill, exists: (f) => exists(f), join: (a, b) => P.join(a, b), readJson: (f) => JSON.parse(fs.readFileSync(f, 'utf8')),\n    });\n    const rec = { id, type, name, job, startedAt: now(), endedAt: 0, outDir };\n    extJobsMap.set(id, rec); activeExt = rec;\n    job.done.then((j) => { rec.endedAt = now(); writeJson(P.join(outDir, 'ext_job.json'), Object.assign({ type, name, startedAt: rec.startedAt, endedAt: rec.endedAt }, ExtJob.publicJob(j))); });\n    return { ok: true, jobId: id, outDir, steps: plan.steps.map((s) => ({ id: s.id, label: s.label })), estimate: spec.estimate, limitsNote: spec.limitsNote || '' };\n  }\n  function extStatus(p) {\n    const rec = extJobsMap.get(p && p.jobId) || activeExt; if (!rec) return { ok: true, state: 'idle' };\n    return Object.assign({ ok: true, jobId: rec.id, type: rec.type, name: rec.name, outDir: rec.outDir, elapsedMs: (rec.endedAt || now()) - rec.startedAt }, ExtJob.publicJob(rec.job));\n  }\n  function extStop(p) { const rec = extJobsMap.get(p && p.jobId) || activeExt; if (!rec || rec.job.state !== 'running') return { ok: true, already: true }; return rec.job.stop(); }\n\n  const ops = {\n    // 狀態：硬體、設定、各後端是否可用與原因\n    async studio_probe(p) {\n      const kind = (p && p.kind) || 'lora', list = await registry.listFor(kind, Object.assign(ctxOf(p), { fast: true }));   // 畫面用：不等慢的探測\n      const sym = BackendCore.isSymbolicKind(kind);\n      return { ok: true, kind, symbolic: sym, hw, config, backends: sym ? [{ id: 'cpu-js', available: true, reason: '', note: '只需處理器' }] : list.map((x) => ({ id: x.id, available: x.available, reason: x.reason, probing: x.reason === '探測中…' || !!(x.probe && x.probe.probing), device: x.probe && x.probe.device, planned: !!(registry.get(x.id) || {}).planned })), loraDir: loraDirOf(), threads: SC.resolveThreads(config, hw.cores, 'train') };\n    },\n    async studio_probe_wait() { try { await (probeSt.running || Promise.resolve()); } catch (e) {} return { ok: true, done: !probeSt.running }; },\n    async studio_config_get() { return { ok: true, config, schema: SC.SCHEMA, hw }; },\n    async studio_config_set(p) {\n      const r = SC.normalize(Object.assign({}, config, (p && p.patch) || {}), hw.cores);\n      config = r.config; writeJson(jf('studio-config.json'), config);\n      return { ok: true, config, errors: r.errors, warnings: r.warnings };\n    },\n    // 基準測試：對所有可用後端依序跑，一次一個；回 jobId，用 studio_bench_status 輪詢，studio_bench_stop 中斷\n    async studio_bench_start(p) {\n      if (activeBench && activeBench.state === 'running') return { ok: false, error: '基準測試正在執行（job ' + activeBench.id + '）' };\n      if (activeTrain && activeTrain.state === 'running') return { ok: false, error: '訓練進行中：為了讓電腦保持可用，訓練結束或暫停後才能跑基準測試' };\n      const kind = (p && p.kind) || 'lora', ids = registry.supportedFor(kind);\n      const job = { id: newId('bench'), kind, state: 'running', rows: [], log: [], startedAt: now(), ac: { aborted: false, listeners: [], addEventListener(t, f) { this.listeners.push(f); }, removeEventListener() {} } };\n      job.signal = job.ac; activeBench = job; jobs.set(job.id, job);\n      (async () => {\n        try {\n          for (const id of ids) {\n            if (job.ac.aborted) break;\n            const b = registry.get(id), pr = await BackendCore.safeProbe(b, ctxOf(p));\n            const fp = Object.assign({}, pr.fingerprint, { model_sha256: (p && p.modelSha256) || null, backend: id });\n            const row = { id, available: pr.available, reason: pr.reason || '', state: 'pending', fingerprint: fp };\n            job.rows.push(row);\n            if (!pr.available) { row.state = 'skipped'; continue; }\n            row.state = 'running';\n            let r; try { r = await b.benchmark(benchCfg(id, p), { signal: job.signal, deadlineMs: (p && p.deadlineMs) || benchDeadline(id) }); } catch (e) { r = { ok: false, error: String(e && e.message || e), reason: String(e && e.message || e) }; }\n            if (r && r.aborted) { row.state = 'aborted'; row.reason = '使用者中斷'; break; }\n            row.result = { ok: !!r.ok, tokPerSec: r.tokPerSec, peakMemBytes: r.peakMemBytes, stepMsP50: r.stepMsP50, stepMsP95: r.stepMsP95, numericCheck: r.numericCheck, reason: r.reason, elapsedMs: r.elapsedMs };\n            row.passed = BC.benchPassed(r); row.state = row.passed ? 'passed' : 'failed'; row.at = now();\n            if (r && r.ok) await benchCache.store(id, fp, r);\n          }\n          job.state = job.ac.aborted ? 'aborted' : 'done';\n        } catch (e) { job.state = 'error'; job.error = String(e && e.message || e); }\n        job.endedAt = now();\n      })();\n      return { ok: true, jobId: job.id };\n    },\n    async studio_bench_status(p) { const j = jobs.get(p && p.jobId) || activeBench; if (!j) return { ok: false, error: '沒有這個基準測試工作' }; return { ok: true, jobId: j.id, state: j.state, rows: j.rows, error: j.error || null, elapsedMs: (j.endedAt || now()) - j.startedAt }; },\n    async studio_bench_stop(p) {\n      const j = jobs.get(p && p.jobId) || activeBench; if (!j || j.state !== 'running') return { ok: true, already: true };\n      j.ac.aborted = true; j.ac.listeners.forEach((f) => { try { f(); } catch (e) {} }); return { ok: true };\n    },\n    // 自動選擇：只用快取（不跑基準，避免意外吃資源）；沒有快取結果就回 needsRebench\n    async studio_select(p) {\n      const r = await BC.autoSelect({ kind: (p && p.kind) || 'lora', registry, cache: benchCache, ctx: Object.assign(ctxOf(p), { fast: true }), pin: p && p.pin, skipBench: true });\n      return Object.assign({ ok: !!r.chosen }, r);\n    },\n    // 訓練：目前只有 lora（cpu-py）有真的子行程訓練；符號式五類由主程式端的 sym_train_core 執行（設計 §15.3）\n    async studio_train_start(p) {\n      p = p || {}; const kind = p.kind || 'lora';\n      if (kind !== 'lora') return { ok: false, error: kind + ' 是符號式訓練，由主程式的 studio_server（sym_train_core）執行，不經主行程子行程；這裡只處理 lora' };\n      if (p.backend && p.backend !== 'cpu-py') return { ok: false, error: '後端 ' + p.backend + ' 目前只有 cpu-py 能實際訓練' };\n      if (activeTrain && (activeTrain.state === 'running' || activeTrain.state === 'pausing')) return { ok: false, error: '已有訓練在執行（' + activeTrain.id + '）' };\n      if (activeBench && activeBench.state === 'running') return { ok: false, error: '基準測試進行中，請先等它結束或按停止' };\n      const cfg = p.cfg || {};\n      // 從資產挑的資料集：伺服器把檔案內容放在 cfg.trainText，這裡寫成輸出資料夾下的 train.jsonl 再當訓練檔（使用者不必自己找路徑）\n      if (cfg.trainText && cfg.outputDir) { try { fs.mkdirSync(cfg.outputDir, { recursive: true }); cfg.trainFile = P.join(cfg.outputDir, 'train.jsonl'); fs.writeFileSync(cfg.trainFile, String(cfg.trainText)); delete cfg.trainText; } catch (e) { return { ok: false, error: '寫入訓練資料失敗：' + String(e && e.message || e) }; } }\n      if (!cfg.trainFile || !cfg.outputDir) return { ok: false, error: '缺少 trainFile／outputDir' };\n      const pr = await BackendCore.safeProbe(cpuPy, ctxOf(p)); if (!pr.available) return { ok: false, error: 'cpu-py 不可用：' + pr.reason };\n      const job = { id: newId('train'), kind, state: 'running', events: [], lastStep: 0, lastLoss: null, startedAt: now(), cfg };\n      const hooks = { onEvent: (e) => { job.events.push(e); if (job.events.length > 400) job.events.shift(); if (e.step) job.lastStep = e.step; if (e.type === 'log') job.lastLoss = e.loss; } };\n      try { job.run = p.resume ? await cpuPy.resumeRun(cfg, hooks) : await cpuPy.startRun(cfg, hooks); } catch (e) { return { ok: false, error: String(e && e.message || e) }; }\n      activeTrain = job; jobs.set(job.id, job);\n      job.run.done.then((r) => { job.state = (job.run && job.run.state) || 'finished'; job.result = r && { state: r.state }; job.endedAt = now(); });\n      return { ok: true, jobId: job.id };\n    },\n    // 流程總覽讀真實紀錄（DESIGN §19）：<runDir>/train.log 尾端 2MB；run.pid 對應的子行程 VmRSS（Linux 才有 /proc；其他系統說明未取樣）；主行程 RSS 另附\n    async studio_run_info(p) {\n      const dir = String((p && p.runDir) || ''); if (!dir) return { ok: false, error: '缺 runDir' };\n      let log = null; try { const t = fs.readFileSync(P.join(dir, 'train.log'), 'utf8'); log = t.length > 2000000 ? t.slice(t.length - 2000000) : t; } catch (e) { log = null; }\n      let pid = null; try { pid = parseInt(fs.readFileSync(P.join(dir, 'run.pid'), 'utf8'), 10) || null; } catch (e) { pid = null; }\n      let rssBytes = null, rssReason = '';\n      if (!pid) rssReason = '沒有 run.pid（子行程 pid 未記錄）';\n      else if (process.platform === 'win32') {\n        try { const r = cp.spawnSync('tasklist', ['/FI', 'PID eq ' + pid, '/FO', 'CSV', '/NH'], { encoding: 'utf8', windowsHide: true, timeout: 5000 }); const bytes = parseTasklistMemory(r.stdout || ''); if (bytes !== null) rssBytes = bytes; else rssReason = 'tasklist 查不到子行程 ' + pid + '（可能已結束）'; }\n        catch (e) { rssReason = 'tasklist 執行失敗：' + String((e && e.message) || e); }\n      }\n      else if (process.platform !== 'linux') rssReason = '這個系統（' + process.platform + '）還沒有子行程記憶體取樣（尚未實作）';\n      else { try { const st = fs.readFileSync('/proc/' + pid + '/status', 'utf8'); const m = /VmRSS:\\s+(\\d+)\\s+kB/.exec(st); if (m) rssBytes = +m[1] * 1024; else rssReason = '/proc 沒有 VmRSS 欄位'; } catch (e) { rssReason = '子行程已結束，或讀不到 /proc/' + pid + '/status'; } }\n      let hostRssBytes = null; try { hostRssBytes = process.memoryUsage().rss; } catch (e) { hostRssBytes = null; }\n      const events = log ? log.split(/\\r?\\n/).map((l) => CpuPy.parseProgressLine(l)).filter(Boolean).slice(-5000) : [];\n      return { ok: true, runDir: dir, log, events, pid, rssBytes, rssReason: rssBytes === null ? rssReason : '', hostRssBytes };\n    },\n    // LLM 匯出工具偵測（DESIGN §20.3 第 2 項）：只在 PATH 上找可執行檔；onnxruntime 要查 python 模組，這版還沒做，照實回報\n    async studio_export_tools() {\n        const pr = await probeLlmTools();\n        return { ok: true, tools: LlmExport.probeExportTools((n) => pr.tools[n]), paths: pr.paths, checkedAt: now() };\n    },\n    // LLM 匯出（DESIGN §25）：背景執行；每一步的 JSON 結果由 llm_export_core.runExportSteps 整理\n    async studio_llm_export(p) { return startLlmExport(p || {}); },\n    async studio_llm_export_pause(p) { return stopLlmExport(p || {}, 'paused'); },\n    async studio_llm_export_bundle(p) { return llmBundle(p || {}); },\n    async studio_llm_register(p) { return llmRegister(p || {}); },\n    async studio_llm_use(p) { return llmUse(p || {}); },\n    async studio_llm_use_clear() { return llmUseClear(); },\n    async studio_llm_use_current() { return llmUseCurrent(); },\n    async studio_llm_export_cancel(p) { return stopLlmExport(p || {}, 'cancelled'); },\n    async studio_llm_export_resume(p) { return resumeLlmExport(p || {}); },\n    async studio_llm_export_status(p) {\n        const j = exportJobs.get(p && p.jobId) || activeExport; if (!j) return { ok: true, state: 'idle' };\n        return { ok: true, jobId: j.id, format: j.format, state: j.state, events: j.events.slice(-100), steps: j.result ? j.result.steps : null, failedAt: j.result ? j.result.failedAt : null, workDir: j.workDir, outDir: j.outDir, elapsedMs: (j.endedAt || now()) - j.startedAt };\n    },\n    async studio_run_current() { const j = activeTrain || Array.from(jobs.values()).pop(); return { ok: true, runDir: j && j.cfg && j.cfg.outputDir ? j.cfg.outputDir : null }; },\n    async studio_train_status(p) {\n      const j = jobs.get(p && p.jobId) || activeTrain; if (!j || j.kind === undefined || !j.run) return { ok: true, running: false, state: 'idle' };\n      const r = j.run; return { ok: true, jobId: j.id, running: r.state === 'running' || r.state === 'pausing', state: r.state, step: r.lastStep, loss: r.lastLoss, errors: r.errors.slice(-5), events: j.events.slice(-(Number(p && p.tail) || 50)), exitCode: r.exitCode, elapsedMs: (j.endedAt || now()) - j.startedAt };\n    },\n    async studio_train_pause(p) { const j = jobs.get(p && p.jobId) || activeTrain; if (!j || !j.run || j.run.state !== 'running') return { ok: false, error: '沒有執行中的訓練可暫停' }; const r = await j.run.pause(p && p.timeoutMs); return Object.assign({ ok: r.ok }, r); },\n    async studio_train_stop(p) { const j = jobs.get(p && p.jobId) || activeTrain; if (!j || !j.run || !(j.run.state === 'running' || j.run.state === 'pausing')) return { ok: true, already: true }; await j.run.stop(); return { ok: true }; },\n    async studio_ext_check(p) { return extCheck(p || {}); },\n    async studio_ext_start(p) { return extStart(p || {}); },\n    async studio_ext_status(p) { return extStatus(p || {}); },\n    async studio_ext_stop(p) { return extStop(p || {}); },\n    async studio_dispose() { try { if (activeExt && activeExt.job.state === 'running') activeExt.job.stop(); } catch (e) {} try { if (activeBench) { activeBench.ac.aborted = true; activeBench.ac.listeners.forEach((f) => f()); } if (activeTrain && activeTrain.run && activeTrain.run.state === 'running') await activeTrain.run.stop(); } catch (e) {} return { ok: true }; },\n  };\n  return { ops, registry, handle: async (op, payload) => { const f = ops[op]; if (!f) return { ok: false, code: 'bad_op', message: '未知的 Studio 操作：' + op }; try { return await f(payload || {}); } catch (e) { return { ok: false, code: 'internal', message: String((e && e.message) || e) }; } } };\n}\n\n// tasklist /FO CSV 的記憶體欄（例如 \"1,234,567 K\"）→ 位元組；查不到回 null。純函式，測試用\nfunction parseTasklistMemory(text) {\n  const m = /\"([\\d,]+)\\s*K\"\\s*$/m.exec(String(text || '')); if (!m) return null;\n  const kb = Number(m[1].replace(/,/g, '')); return Number.isFinite(kb) ? kb * 1024 : null;\n}\nmodule.exports = { createStudioHost, parseTasklistMemory };\n","lora-train/train_lora.py":'#!/usr/bin/env python\n"""LoRA SFT fine-tuning of Qwen3-0.6B on the unified dataset produced by gen/merge_dataset.js.\n\nCPU-only by design (see requirements.txt): this machine has no CUDA GPU, and the Intel\nAI Boost NPU here is inference-only, so this script never touches accelerators other\nthan the CPU. Run it from the project\'s isolated venv:\n\n    lora-train/.venv/Scripts/python lora-train/train_lora.py --train_file lora-train/data/train.jsonl ...\n\nEach training example comes from lora-train/schema.md\'s unified format:\n    {"messages": [...], "completion": "...", "domain": "...", "stage": "...", "meta": {...}}\n"messages" is the exact production prompt (already produced by the real recipe_core.js /\nthink_stack.js / uml_core.js / ... formatters -- see gen/*.js). "completion" is the single\nprogram-verified correct assistant reply. We apply the tokenizer\'s own chat template so the\ntrained model sees exactly the token sequence production will feed it at inference time,\nthen mask the loss to the completion tokens only (standard SFT: don\'t waste gradient on\nlearning to reproduce the prompt).\n\nOnly "meta.thinking": true examples get enable_thinking=True in the chat template; everything\nelse defaults to False, matching the native runner\'s hardcoded enable_thinking:false path\n(DESIGN.offline-text.md / DESIGN.TODO.native-runner.md).\n"""\nimport argparse\nimport hashlib\nimport json\nimport os\nimport random\nimport sys\nfrom dataclasses import dataclass\n\nimport torch\nfrom torch.utils.data import Dataset\nfrom transformers import (\n    AutoModelForCausalLM,\n    AutoTokenizer,\n    Trainer,\n    TrainerCallback,\n    TrainingArguments,\n)\nfrom peft import LoraConfig, get_peft_model, TaskType\nfrom lora_common import normalize, encode\n\n\nclass StopFileCallback(TrainerCallback):\n    """Pause support: after any optimizer step, if stop_file exists, force a checkpoint save and end training."""\n\n    def __init__(self, path):\n        self.path = path\n\n    def on_step_end(self, args, state, control, **kwargs):\n        if self.path and os.path.exists(self.path):\n            control.should_save = True\n            control.should_training_stop = True\n            print(f"[paused] step={state.global_step}", flush=True)\n        return control\n\n\ndef read_jsonl(path):\n    rows = []\n    with open(path, "r", encoding="utf-8") as f:\n        for line_no, line in enumerate(f, 1):\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                rows.append(json.loads(line))\n            except json.JSONDecodeError as e:\n                raise ValueError(f"{path}:{line_no}: bad JSON ({e})") from e\n    return rows\n\n\nclass ChatSFTDataset(Dataset):\n    """Builds (input_ids, labels) with the prompt masked out (-100) and only the\n    completion contributing to the loss. One example at a time; the data collator\n    pads/batches."""\n\n    def __init__(self, rows, tokenizer, max_seq_len):\n        self.tokenizer = tokenizer\n        self.max_seq_len = max_seq_len\n        self.examples = []\n        for row in rows:\n            x = normalize(row)\n            if not x.get("messages") or x["chosen"] is None:\n                continue\n            # same encode as eval and DPO (lora_common.encode): chat template (+tools) + prefill,\n            # loss only on chosen + <|im_end|>, left-truncated to max_seq_len\n            ids, labels = encode(tokenizer, x, seq=max_seq_len)\n            self.examples.append({"input_ids": ids, "labels": labels, "attention_mask": [1] * len(ids)})\n\n    def __len__(self):\n        return len(self.examples)\n\n    def __getitem__(self, idx):\n        return self.examples[idx]\n\n\n@dataclass\nclass PadCollator:\n    pad_token_id: int\n\n    def __call__(self, batch):\n        max_len = max(len(b["input_ids"]) for b in batch)\n        if os.environ.get("LORA_TRACE_FILE"):   # 測試用：記錄每個 micro-batch 的內容雜湊，驗證續訓不重複／不漏資料\n            h = hashlib.sha256(json.dumps([b["input_ids"] for b in batch]).encode()).hexdigest()[:16]\n            with open(os.environ["LORA_TRACE_FILE"], "a", encoding="utf-8") as f:\n                f.write(h + "\\n")\n        input_ids, labels, attn = [], [], []\n        for b in batch:\n            pad_len = max_len - len(b["input_ids"])\n            input_ids.append(b["input_ids"] + [self.pad_token_id] * pad_len)\n            labels.append(b["labels"] + [-100] * pad_len)\n            attn.append(b["attention_mask"] + [0] * pad_len)\n        return {\n            "input_ids": torch.tensor(input_ids, dtype=torch.long),\n            "labels": torch.tensor(labels, dtype=torch.long),\n            "attention_mask": torch.tensor(attn, dtype=torch.long),\n        }\n\n\nclass FaCkptCallback(TrainerCallback):\n    """每次存檢查點時，在 checkpoint-N/fa-ckpt.json 寫一份與 DESIGN.TODO.offline-training-studio.md §3.1 對照的描述。\n    權重與優化器仍是 HF Trainer 原生格式（adapter_model.safetensors、optimizer.pt、scheduler.pt、rng_state.pth）；\n    differences 欄位列出與 §3.1 不同之處，工作室續訓時要先讀它。"""\n\n    def __init__(self, meta):\n        self.meta = meta\n\n    def on_save(self, args, state, control, **kwargs):\n        ck = os.path.join(args.output_dir, f"checkpoint-{state.global_step}")\n        losses = [h["loss"] for h in state.log_history if "loss" in h]\n        doc = {\n            "format": "fa-ckpt", "version": 1, "producer": "lora-train/train_lora.py", "step": state.global_step, "epoch": state.epoch,\n            "cursor": {"order_seed": args.seed, "micro_batches_per_step": args.gradient_accumulation_steps,\n                       "consumed_micro_batches": state.global_step * args.gradient_accumulation_steps,\n                       "method": "seeded RandomSampler + skip_first_batches on resume"},\n            "rng": {"seed": args.seed, "algo": "hf-rng_state.pth (torch/numpy/python)"},\n            "optimizer": {"kind": "adamw", "lr": args.learning_rate, "schedule": {"type": "linear", "warmup": 10, "total": state.max_steps}},\n            "data_sha256": self.meta["data_sha256"],\n            "compat": {"base": self.meta["base"], "rank": self.meta["rank"], "alpha": self.meta["alpha"],\n                       "target_modules": self.meta["target_modules"], "prompt_format_version": self.meta.get("prompt_format_version", ""),\n                       "tool_catalog_sha256": self.meta.get("tool_catalog_sha256", "")},\n            "produced_by": {"backend": "cpu-py", "precision": "float32", "torch": __import__("torch").__version__},\n            "loss_tail": losses[-20:],\n            "differences": ["權重與優化器不是 lora_A/B.f32、opt_m/opt_v，而是 HF 原生檔", "rng 不是 PCG32，是 HF rng_state.pth",\n                            "資料游標以 seed 重現洗牌並跳過已看的 micro-batch，沒有 shard/offset 欄位"],\n        }\n        os.makedirs(ck, exist_ok=True)\n        with open(os.path.join(ck, "fa-ckpt.json"), "w", encoding="utf-8") as f:\n            json.dump(doc, f, ensure_ascii=False, indent=1)\n\n\ndef split_train_val(rows, val_fraction, seed):\n    """Carve a validation slice out of the TRAIN split (never the frozen heldout\n    files -- those are merged separately by gen/merge_dataset.js and must only be\n    used for final eval, per schema.md\'s holdout discipline)."""\n    rng = random.Random(seed)\n    rows = rows[:]\n    rng.shuffle(rows)\n    n_val = 0 if val_fraction <= 0 else (max(1, int(len(rows) * val_fraction)) if len(rows) > 10 else 0)\n    return rows[n_val:], rows[:n_val]\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument("--model_name_or_path", default="Qwen/Qwen3-0.6B")\n    ap.add_argument("--train_file", required=True, help="unified JSONL, split=train only")\n    ap.add_argument("--output_dir", default="lora-train/out/adapter")\n    ap.add_argument("--val_fraction", type=float, default=0.1)\n    ap.add_argument("--max_seq_len", type=int, default=int(os.environ.get("LORA_SEQ", 1024)))\n    ap.add_argument("--num_train_epochs", type=float, default=3.0)\n    ap.add_argument("--per_device_train_batch_size", type=int, default=int(os.environ.get("LORA_BATCH", 2)))\n    ap.add_argument("--gradient_accumulation_steps", type=int, default=8)\n    ap.add_argument("--learning_rate", type=float, default=1e-4)\n    ap.add_argument("--lora_r", type=int, default=16)\n    ap.add_argument("--lora_alpha", type=int, default=32)\n    ap.add_argument("--lora_dropout", type=float, default=0.05)\n    ap.add_argument(\n        "--lora_target_modules",\n        default="q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj",\n    )\n    ap.add_argument("--logging_steps", type=int, default=10)\n    ap.add_argument("--save_steps", type=int, default=200)\n    ap.add_argument("--max_steps", type=int, default=-1, help="set >0 for a quick smoke test")\n    ap.add_argument("--seed", type=int, default=42)\n    ap.add_argument("--domains", default="", help="comma list to filter training to specific domains; empty = all")\n    # Studio（renderer/src/studio/backend_cpu_py.js）用：暫停＝建立 stop_file，存檢查點後停；續訓＝從 checkpoint-N 繼續\n    ap.add_argument("--resume_from_checkpoint", default="", help="path of an HF Trainer checkpoint-N dir to resume from (optimizer, scheduler, rng restored)")\n    ap.add_argument("--stop_file", default="", help="when this file exists after a step: save a checkpoint and stop (pause)")\n    args = ap.parse_args()\n\n    torch.manual_seed(args.seed)\n    torch.set_num_threads(int(os.environ.get("LORA_THREADS", torch.get_num_threads())))\n\n    rows = read_jsonl(args.train_file)\n    bad_split = [r for r in rows if r.get("split") != "train"]\n    if bad_split:\n        raise SystemExit(\n            f"--train_file contains {len(bad_split)} row(s) with split != \'train\' "\n            f"(e.g. id={bad_split[0].get(\'id\')!r}) -- heldout data must never be trained on. "\n            f"Re-run gen/merge_dataset.js or filter the file first."\n        )\n    if args.domains:\n        wanted = set(d.strip() for d in args.domains.split(",") if d.strip())\n        rows = [r for r in rows if r.get("domain") in wanted]\n        print(f"[data] filtered to domains={sorted(wanted)}: {len(rows)} rows")\n\n    if not rows:\n        raise SystemExit("no training rows after filtering -- nothing to train on")\n\n    by_domain = {}\n    for r in rows:\n        by_domain.setdefault(r.get("domain", "?"), 0)\n        by_domain[r.get("domain", "?")] += 1\n    print("[data] rows per domain:", by_domain)\n\n    train_rows, val_rows = split_train_val(rows, args.val_fraction, args.seed)\n    print(f"[data] train={len(train_rows)} val={len(val_rows)}")\n\n    print(f"[model] loading {args.model_name_or_path} (CPU, fp32)")\n    tokenizer = AutoTokenizer.from_pretrained(args.model_name_or_path)\n    if tokenizer.pad_token_id is None:\n        tokenizer.pad_token = tokenizer.eos_token\n    model = AutoModelForCausalLM.from_pretrained(\n        args.model_name_or_path, torch_dtype=torch.float32\n    )\n    model.config.use_cache = False  # required for gradient checkpointing / training\n\n    lora_config = LoraConfig(\n        task_type=TaskType.CAUSAL_LM,\n        r=args.lora_r,\n        lora_alpha=args.lora_alpha,\n        lora_dropout=args.lora_dropout,\n        target_modules=[m.strip() for m in args.lora_target_modules.split(",") if m.strip()],\n        bias="none",\n    )\n    model = get_peft_model(model, lora_config)\n    model.print_trainable_parameters()\n\n    train_ds = ChatSFTDataset(train_rows, tokenizer, args.max_seq_len)\n    val_ds = ChatSFTDataset(val_rows, tokenizer, args.max_seq_len) if val_rows else None\n    collator = PadCollator(pad_token_id=tokenizer.pad_token_id)\n\n    training_args = TrainingArguments(\n        output_dir=args.output_dir,\n        num_train_epochs=args.num_train_epochs,\n        per_device_train_batch_size=args.per_device_train_batch_size,\n        gradient_accumulation_steps=args.gradient_accumulation_steps,\n        learning_rate=args.learning_rate,\n        logging_steps=args.logging_steps,\n        save_steps=args.save_steps,\n        save_total_limit=2,\n        warmup_steps=10,\n        lr_scheduler_type="linear",\n        eval_strategy="steps" if val_ds else "no",\n        eval_steps=args.save_steps if val_ds else None,\n        max_steps=args.max_steps,\n        report_to=[],\n        use_cpu=True,\n        bf16=False,\n        fp16=False,\n        dataloader_num_workers=0,\n        remove_unused_columns=False,\n        seed=args.seed,\n    )\n\n    ckpt_meta = {"data_sha256": hashlib.sha256(open(args.train_file, "rb").read()).hexdigest(), "base": args.model_name_or_path,\n                 "rank": args.lora_r, "alpha": args.lora_alpha, "target_modules": sorted(lora_config.target_modules),\n                 "tool_catalog_sha256": None}\n    trainer = Trainer(\n        model=model,\n        args=training_args,\n        train_dataset=train_ds,\n        eval_dataset=val_ds,\n        data_collator=collator,\n        callbacks=([StopFileCallback(args.stop_file)] if args.stop_file else []) + [FaCkptCallback(ckpt_meta)],\n    )\n    trainer.train(resume_from_checkpoint=args.resume_from_checkpoint or None)\n\n    os.makedirs(args.output_dir, exist_ok=True)\n    model.save_pretrained(args.output_dir)\n    tokenizer.save_pretrained(args.output_dir)\n    print(f"[done] adapter saved to {args.output_dir}")\n\n\nif __name__ == "__main__":\n    main()\n',"lora-train/lora_common.py":'"""Shared row normalisation + encoding used by training, DPO and eval (one encoding everywhere).\n\nReference row format: {task, kind, messages, tools, prefill, chosen, rejected}.\nOur unified rows (schema.md) carry id/domain/stage/split/meta and `completion` instead of `chosen`; this module maps\nthem so both formats train/eval identically:\n    chosen  = row.chosen  or row.completion\n    task    = row.task    or row.domain          kind = row.kind or row.stage\n    tools   = row.tools (may be None)            prefill = row.prefill or \'\'\nEncoding (same as the reference): apply_chat_template(messages, tools=tools, add_generation_prompt=True,\nenable_thinking=False, tokenize=False) + prefill, then loss only on  chosen + \'<|im_end|>\'.\n(meta.thinking=True rows keep enable_thinking=True.)\n"""\nimport json, os\n\n\ndef read_jsonl(path):\n    return [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]\n\n\ndef normalize(row):\n    r = dict(row)\n    r["chosen"] = row.get("chosen") if row.get("chosen") is not None else row.get("completion")\n    r["task"] = row.get("task") or row.get("domain") or "?"\n    r["kind"] = row.get("kind") or row.get("stage") or "?"\n    r["tools"] = row.get("tools") or None\n    r["prefill"] = row.get("prefill") or ""\n    r["rejected"] = row.get("rejected")\n    return r\n\n\ndef prompt_text(tok, x):\n    thinking = bool((x.get("meta") or {}).get("thinking", False))\n    return tok.apply_chat_template(x["messages"], tools=x["tools"], add_generation_prompt=True,\n                                   enable_thinking=thinking, tokenize=False) + x["prefill"]\n\n\ndef encode(tok, x, tail=None, seq=None):\n    """-> (ids, labels). labels are -100 over the prompt(+prefill); loss on tail + <|im_end|> (tail defaults to chosen)."""\n    seq = seq or int(os.environ.get("LORA_SEQ", 1024))\n    a = tok(prompt_text(tok, x), add_special_tokens=False)["input_ids"]\n    b = tok((x["chosen"] if tail is None else tail) + "<|im_end|>", add_special_tokens=False)["input_ids"]\n    return (a + b)[-seq:], ([-100] * len(a) + b)[-seq:]\n',"lora-train/requirements.txt":"# CPU-only LoRA fine-tuning stack for Qwen3-0.6B.\n#\n# IMPORTANT: install this into its own virtualenv (lora-train/.venv), never into the\n# shared/global Python environment. This repo's global env has `docling` pinned to\n# transformers<5.0.0,huggingface_hub<1 for other skills (pdf/docx processing) -- a\n# plain `pip install datasets` there drags transformers to the 5.x line and breaks it.\n#\n# Requires Python 3.11 or newer (transformers 5.x does not install on 3.10).\n#\n#   py -3.13 -m venv lora-train/.venv\n#   lora-train/.venv/Scripts/python.exe -m pip install torch --extra-index-url https://download.pytorch.org/whl/cpu\n#   lora-train/.venv/Scripts/python.exe -m pip install -r lora-train/requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu\n#\n# This machine has no CUDA GPU; the Intel AI Boost NPU here is inference-only\n# (no backprop/training support), so the torch wheel above is explicitly the CPU build.\ntransformers>=5.22.0\npeft>=0.21.0\naccelerate>=1.15.0\ndatasets>=5.2.0\nsafetensors>=0.4.3\nsentencepiece>=0.2.0\n","lora-train/train_full.py":'#!/usr/bin/env python\n"""完整參數微調（全部權重可訓練）的 SFT 腳本，DESIGN.lora-training.md §25（路徑 B）。\n\n與 train_lora.py 用同一份資料與編碼（ChatSFTDataset／PadCollator／StopFileCallback 直接沿用），差別只有：\n  - 不包 PEFT：整個 Qwen3-0.6B 都訓練，優化器是 HF Trainer 預設的 AdamW（記憶體：權重＋梯度＋Adam 兩份狀態，fp32 約 10 GB）。\n  - 存檔是完整 HF 資料夾（safetensors＋config＋tokenizer），可直接餵 merge 之後的匯出流程：\n    export_onnx.py --model <本腳本的輸出> 與 export_gguf.py --model <本腳本的輸出>（不需要 merge）。\n  - 暫停／續訓與 train_lora.py 相同：--stop_file 存在就存檢查點並停；--resume_from_checkpoint 接續 checkpoint-N。\n  - 存檔時也把 config.json 換回基底的（transformers 5.x 存的 rope 欄位格式 4.x 讀不到，見 merge_and_export.py）。\n\nCPU only（這台沒有 GPU）。用 lora-train/.venv（transformers 5.x）執行：\n    lora-train/.venv/bin/python lora-train/train_full.py --train_file <train.jsonl> --output_dir <新空目錄> \\\n        --max_steps 4 --per_device_train_batch_size 1 --gradient_accumulation_steps 1 --max_seq_len 512\n\n注意：\n  - 完整微調的輸出 **不是** 1 MB 級的 adapter，而是約 2.4 GB 的權重；每個 checkpoint 另加約 4.8 GB 的優化器狀態。\n    `save_total_limit=2`，磁碟要先確認。\n  - 沒有足夠資料與時間的完整訓練不在本次範圍；本腳本只保證「能跑、能暫停續訓、輸出能匯出」。\n"""\nimport argparse\nimport hashlib\nimport json\nimport os\nimport resource\nimport shutil\nimport sys\nimport time\n\nimport torch\nfrom transformers import AutoModelForCausalLM, AutoTokenizer, Trainer, TrainerCallback, TrainingArguments\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom train_lora import ChatSFTDataset, PadCollator, StopFileCallback, read_jsonl, split_train_val  # noqa: E402\n\n\nclass FullCkptCallback(TrainerCallback):\n    """每次存檔寫 checkpoint-N/fa-ckpt.json（描述與 train_lora.py 的 fa-ckpt 相同格式，但 producer／權重格式不同）。"""\n\n    def __init__(self, meta):\n        self.meta = meta\n\n    def on_save(self, args, state, control, **kwargs):\n        ck = os.path.join(args.output_dir, f"checkpoint-{state.global_step}")\n        os.makedirs(ck, exist_ok=True)\n        doc = {\n            "format": "fa-ckpt", "version": 1, "producer": "lora-train/train_full.py",\n            "step": state.global_step, "epoch": state.epoch,\n            "cursor": {"order_seed": args.seed, "micro_batches_per_step": args.gradient_accumulation_steps,\n                       "consumed_micro_batches": state.global_step * args.gradient_accumulation_steps,\n                       "method": "seeded RandomSampler + skip_first_batches on resume"},\n            "optimizer": {"kind": "adamw", "lr": args.learning_rate, "schedule": {"type": "linear", "warmup": 10, "total": state.max_steps}},\n            "data_sha256": self.meta["data_sha256"], "compat": {"base": self.meta["base"], "full_finetune": True},\n            "produced_by": {"backend": "cpu-py", "precision": "float32", "torch": torch.__version__},\n            "differences": ["權重是完整 HF safetensors（不是 LoRA），優化器狀態 HF 原生檔（optimizer.pt）"],\n        }\n        with open(os.path.join(ck, "fa-ckpt.json"), "w", encoding="utf-8") as f:\n            json.dump(doc, f, ensure_ascii=False, indent=1)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument("--model_name_or_path", default="lora-train/models/Qwen3-0.6B")\n    ap.add_argument("--train_file", required=True, help="unified JSONL（split=train）")\n    ap.add_argument("--output_dir", required=True)\n    ap.add_argument("--val_fraction", type=float, default=0.0)\n    ap.add_argument("--max_seq_len", type=int, default=512)\n    ap.add_argument("--num_train_epochs", type=float, default=1.0)\n    ap.add_argument("--per_device_train_batch_size", type=int, default=1)\n    ap.add_argument("--gradient_accumulation_steps", type=int, default=1)\n    ap.add_argument("--learning_rate", type=float, default=1e-5)\n    ap.add_argument("--logging_steps", type=int, default=1)\n    ap.add_argument("--save_steps", type=int, default=200)\n    ap.add_argument("--max_steps", type=int, default=-1)\n    ap.add_argument("--seed", type=int, default=42)\n    ap.add_argument("--resume_from_checkpoint", default="")\n    ap.add_argument("--stop_file", default="")\n    args = ap.parse_args()\n\n    torch.manual_seed(args.seed)\n    torch.set_num_threads(int(os.environ.get("LORA_THREADS", torch.get_num_threads())))\n    t0 = time.time()\n\n    rows = read_jsonl(args.train_file)\n    bad = [r for r in rows if r.get("split") != "train"]\n    if bad:\n        raise SystemExit(f"--train_file 有 {len(bad)} 列 split != \'train\'（heldout 不得拿來訓練）")\n    if not rows:\n        raise SystemExit("沒有訓練資料")\n    train_rows, val_rows = split_train_val(rows, args.val_fraction, args.seed)\n\n    tokenizer = AutoTokenizer.from_pretrained(args.model_name_or_path)\n    if tokenizer.pad_token_id is None:\n        tokenizer.pad_token = tokenizer.eos_token\n    model = AutoModelForCausalLM.from_pretrained(args.model_name_or_path, dtype=torch.float32)\n    model.config.use_cache = False\n    n_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    print(f"[model] {args.model_name_or_path} fp32，可訓練參數 {n_params}", flush=True)\n\n    train_ds = ChatSFTDataset(train_rows, tokenizer, args.max_seq_len)\n    print(f"[data] train examples={len(train_ds)}", flush=True)\n    if len(train_ds) == 0:\n        raise SystemExit("編碼後沒有任何樣本")\n\n    targs = TrainingArguments(\n        output_dir=args.output_dir, num_train_epochs=args.num_train_epochs,\n        per_device_train_batch_size=args.per_device_train_batch_size,\n        gradient_accumulation_steps=args.gradient_accumulation_steps, learning_rate=args.learning_rate,\n        logging_steps=args.logging_steps, save_steps=args.save_steps, save_total_limit=2, warmup_steps=10,\n        lr_scheduler_type="linear", max_steps=args.max_steps, report_to=[], use_cpu=True, bf16=False, fp16=False,\n        dataloader_num_workers=0, remove_unused_columns=False, seed=args.seed,\n    )\n    meta = {"data_sha256": hashlib.sha256(open(args.train_file, "rb").read()).hexdigest(), "base": args.model_name_or_path}\n    trainer = Trainer(model=model, args=targs, train_dataset=train_ds, data_collator=PadCollator(tokenizer.pad_token_id),\n                      callbacks=([StopFileCallback(args.stop_file)] if args.stop_file else []) + [FullCkptCallback(meta)])\n    t_train = time.time()\n    trainer.train(resume_from_checkpoint=args.resume_from_checkpoint or None)\n    train_secs = time.time() - t_train\n\n    os.makedirs(args.output_dir, exist_ok=True)\n    trainer.model.save_pretrained(args.output_dir, safe_serialization=True)\n    tokenizer.save_pretrained(args.output_dir)\n    base_cfg = os.path.join(args.model_name_or_path, "config.json")\n    if os.path.exists(base_cfg):\n        shutil.copyfile(base_cfg, os.path.join(args.output_dir, "config.json"))\n    peak_mb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0\n    summary = {"global_step": trainer.state.global_step, "train_seconds": round(train_secs, 1),\n               "total_seconds": round(time.time() - t0, 1), "peak_rss_mb": round(peak_mb, 1),\n               "losses": [h["loss"] for h in trainer.state.log_history if "loss" in h]}\n    with open(os.path.join(args.output_dir, "train_full_summary.json"), "w", encoding="utf-8") as f:\n        json.dump(summary, f, ensure_ascii=False, indent=1)\n    print(f"[done] full model saved to {args.output_dir} steps={summary[\'global_step\']} "\n          f"train_seconds={summary[\'train_seconds\']} peak_rss_mb={summary[\'peak_rss_mb\']}", flush=True)\n\n\nif __name__ == "__main__":\n    main()\n',"lora-train/merge_and_export.py":'#!/usr/bin/env python3\n"""把 LoRA adapter（PEFT 格式）併回基底權重，存成一般 HF 資料夾（safetensors），供後續匯出用。\nDESIGN.lora-training.md §25。\n\n    python3 merge_and_export.py --base_dir models/Qwen3-0.6B \\\n        --adapter_dir <含 adapter_config.json 與 adapter_model.safetensors 的資料夾> \\\n        --output_dir <新的空目錄>\n\n注意：\n- tokenizer 一律取自基底資料夾（adapter 資料夾通常沒有 tokenizer 檔）。\n- 輸出的 config.json 與 tokenizer 與基底相同；權重為 fp32。\n- 合併前後各算一次首步 logits，最大絕對差寫進 merge_info.json。\n- 只做合併與存檔，不匯出 ONNX／GGUF。\n- config.json 會換成基底的（見程式內註解：5.x 的 rope 欄位格式 4.x 讀不到）。\n"""\nimport argparse\nimport json\nimport os\nimport shutil\nimport sys\n\nimport torch\nfrom peft import PeftModel\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument("--base_dir", required=True, help="基底 HF 資料夾（例如 models/Qwen3-0.6B）")\n    ap.add_argument("--adapter_dir", required=True)\n    ap.add_argument("--output_dir", required=True)\n    ap.add_argument("--probe", default="台北在哪個國家？", help="合併前後各算一次首步 logits 做一致性檢查")\n    a = ap.parse_args()\n\n    if os.path.exists(a.output_dir) and os.listdir(a.output_dir):\n        sys.exit(f"[error] output_dir 不是空目錄：{a.output_dir}")\n    os.makedirs(a.output_dir, exist_ok=True)\n\n    print(f"[load] base {a.base_dir}", flush=True)\n    tok = AutoTokenizer.from_pretrained(a.base_dir)\n    base = AutoModelForCausalLM.from_pretrained(a.base_dir, dtype=torch.float32).eval()\n\n    print(f"[load] adapter {a.adapter_dir}", flush=True)\n    peft_model = PeftModel.from_pretrained(base, a.adapter_dir).eval()\n    ids = tok(a.probe, return_tensors="pt")["input_ids"]\n    with torch.no_grad():\n        ref = peft_model(ids).logits[0, -1].clone()\n\n    print("[merge] merge_and_unload", flush=True)\n    merged = peft_model.merge_and_unload().eval()\n    with torch.no_grad():\n        got = merged(ids).logits[0, -1]\n    diff = float((ref - got).abs().max())\n    print(f"[check] PEFT vs merged 首步 logits 最大絕對差 = {diff:.3e}", flush=True)\n\n    print(f"[save] {a.output_dir}", flush=True)\n    merged.save_pretrained(a.output_dir, safe_serialization=True)\n    tok.save_pretrained(a.output_dir)\n    # transformers 5.x 存的 config 把 rope_theta 改放進 rope_parameters，4.x 讀不到會退回預設 10000，\n    # 實測 4.57 讀 5.x 存的合併權重首步 logprob 偏掉 ~0.2（llama.cpp 與 5.x 一致）。所以改回基底的 config.json\n    # （架構相同，只差 dtype 欄位，載入時會轉 fp32）。\n    shutil.copyfile(os.path.join(a.base_dir, "config.json"), os.path.join(a.output_dir, "config.json"))\n    info = {"base_dir": a.base_dir, "adapter_dir": a.adapter_dir,\n            "merge_max_abs_logit_diff": diff, "dtype": "float32", "config_source": "base（覆寫 5.x 存的 config）",\n            "adapter_config": json.load(open(os.path.join(a.adapter_dir, "adapter_config.json")))}\n    with open(os.path.join(a.output_dir, "merge_info.json"), "w", encoding="utf-8") as f:\n        json.dump(info, f, ensure_ascii=False, indent=1)\n    print("[done]", flush=True)\n    print(json.dumps({"step": "merge", "ok": True, "output_dir": a.output_dir, "merge_max_abs_logit_diff": diff},\n                     ensure_ascii=False), flush=True)\n\n\nif __name__ == "__main__":\n    try:\n        main()\n    except SystemExit as e:  # 空目錄檢查等明確錯誤：照樣回報 JSON，讓執行器拿得到原因\n        if e.code not in (0, None):\n            print(json.dumps({"step": "merge", "ok": False, "error": str(e.code)[:500]}, ensure_ascii=False), flush=True)\n        raise\n    except Exception as e:\n        print(json.dumps({"step": "merge", "ok": False, "error": f"{type(e).__name__}: {str(e)[:500]}"}, ensure_ascii=False), flush=True)\n        sys.exit(1)\n',"lora-train/export_onnx.py":'#!/usr/bin/env python3\n"""合併後的 HF 資料夾 → ONNX（fp32）→ 動態 q8 → 核對 → 寫資產 manifest。DESIGN.lora-training.md §25。\n\n分四步，每步可單獨跑（工作室的執行器一步一步呼叫）；全部在 <out> 資料夾內：\n  convert   optimum-cli export onnx（fp32，text-generation-with-past，圖的輸入輸出與 app 的 q8 圖相同）→ <out>/fp32/\n  quantize  onnxruntime quantize_dynamic（per_channel、QUInt8 權重）→ <out>/q8/model_quantized.onnx\n            recipe=full：所有 MatMul 都量化（與官方 q8 同結構，可接 lora-slot-build.js 的 LoRA 槽）\n            recipe=mixed：down_proj 保留 fp32（其他照舊）；品質明顯較好，但不能再套 LoRA 槽（槽轉換器要求 196 個 MatMulInteger）\n  verify    與 HF（PyTorch fp32）比對：每個提示首步 logits 的餘弦與 top-1、貪婪 N 個 token（用 KV cache 跑 ONNX）→ <out>/check.json\n  pack      寫 <out>/manifest.json：每個產物的檔名、大小、sha256、來源與 recipe\n\n用法（一定要用 .venv-export：transformers 4.57.x；訓練用的 .venv 是 5.x，tokenizer 會壞）：\n    .venv-export/bin/python export_onnx.py --step convert   --model <merged_dir> --out <out> --tokenizer <base_dir>\n    .venv-export/bin/python export_onnx.py --step quantize  --out <out> --recipe mixed\n    .venv-export/bin/python export_onnx.py --step verify    --model <merged_dir> --out <out> --tokenizer <base_dir>\n    .venv-export/bin/python export_onnx.py --step pack      --out <out>\n每一步成功會在 stdout 印一行 JSON（{"step":…,"ok":true,…}），失敗印 {"step":…,"ok":false,"error":…} 並以非零碼結束。\n"""\nimport argparse\nimport hashlib\nimport json\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport time\n\nPROMPTS = [\n    "台北在哪個國家？",\n    "def add(a, b):",\n    "Choose the best tool: A. search B. calc\\nAnswer:",\n    "請把這個任務拆成三個子步驟：整理資料、計算平均、輸出報表。",\n    \'{"name": "get_weather", "arguments": {"city": "Taipei"}}\',\n    "The quick brown fox jumps over",\n]\nGREEDY_N = 16\n\n\ndef emit(step, ok, **kw):\n    print(json.dumps(dict(step=step, ok=ok, **kw), ensure_ascii=False), flush=True)\n\n\ndef sha256(path):\n    h = hashlib.sha256()\n    with open(path, "rb") as f:\n        for chunk in iter(lambda: f.read(1 << 20), b""):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef size_of(path):\n    """ONNX 外部資料檔一起算"""\n    total = os.path.getsize(path)\n    if os.path.exists(path + "_data"):\n        total += os.path.getsize(path + "_data")\n    return total\n\n\ndef find_optimum_cli():\n    cand = os.path.join(os.path.dirname(sys.executable), "optimum-cli")\n    if os.path.exists(cand):\n        return cand\n    found = shutil.which("optimum-cli")\n    if not found:\n        raise RuntimeError("找不到 optimum-cli（請用 .venv-export 的 python 執行）")\n    return found\n\n\ndef step_convert(a):\n    fp = os.path.join(a.out, "fp32")\n    if os.path.exists(os.path.join(fp, "model.onnx")):\n        return {"skipped": "已存在 " + fp}\n    os.makedirs(a.out, exist_ok=True)\n    cmd = [find_optimum_cli(), "export", "onnx", "--model", a.model, "--task", "text-generation-with-past",\n           "--dtype", "fp32", "--no-post-process", fp]\n    t0 = time.time()\n    subprocess.check_call(cmd)\n    return {"model": os.path.join(fp, "model.onnx"), "bytes": size_of(os.path.join(fp, "model.onnx")),\n            "seconds": round(time.time() - t0, 1)}\n\n\ndef step_quantize(a):\n    from onnxruntime.quantization import QuantType, quantize_dynamic\n    import onnx\n    src = os.path.join(a.out, "fp32", "model.onnx")\n    if not os.path.exists(src):\n        raise RuntimeError("沒有 fp32 圖：先跑 --step convert")\n    excl = []\n    if a.recipe == "mixed":\n        m = onnx.load(src, load_external_data=False)\n        excl = [n.name for n in m.graph.node if n.op_type == "MatMul" and "down_proj" in n.name]\n        if not excl:\n            raise RuntimeError("mixed 找不到 down_proj 節點，圖結構不符")\n    elif a.recipe != "full":\n        raise RuntimeError("recipe 必須是 full 或 mixed")\n    os.makedirs(os.path.join(a.out, "q8"), exist_ok=True)\n    dst = os.path.join(a.out, "q8", "model_quantized.onnx")\n    t0 = time.time()\n    quantize_dynamic(src, dst, weight_type=QuantType.QUInt8, per_channel=True, nodes_to_exclude=excl,\n                     use_external_data_format=False)\n    return {"model": dst, "recipe": a.recipe, "fp32_kept_nodes": len(excl), "bytes": size_of(dst),\n            "seconds": round(time.time() - t0, 1)}\n\n\ndef cosine(x, y):\n    import numpy as np\n    return float(x @ y / (np.linalg.norm(x) * np.linalg.norm(y)))\n\n\ndef onnx_greedy(sess, ids_list, n_new, cfg_layers, kv_heads, head_dim):\n    """KV cache 貪婪解碼；回傳 (首步 logits, 生成的 token)"""\n    import numpy as np\n    past = {f"past_key_values.{l}.{k}": np.zeros((1, kv_heads, 0, head_dim), dtype=np.float32)\n            for l in range(cfg_layers) for k in ("key", "value")}\n    ids = list(ids_list)\n    first = None\n    out = []\n    plen = 0\n    feed_ids = ids\n    for _ in range(n_new):\n        L = plen + len(feed_ids)\n        feed = dict(past)\n        feed["input_ids"] = np.array([feed_ids], dtype=np.int64)\n        feed["attention_mask"] = np.ones((1, L), dtype=np.int64)\n        feed["position_ids"] = np.arange(plen, L, dtype=np.int64)[None]\n        names = [o.name for o in sess.get_outputs()]\n        res = dict(zip(names, sess.run(None, feed)))\n        lg = res["logits"][0, -1]\n        if first is None:\n            first = lg.copy()\n        nxt = int(lg.argmax())\n        out.append(nxt)\n        past = {f"past_key_values.{l}.{k}": res[f"present.{l}.{k}"] for l in range(cfg_layers) for k in ("key", "value")}\n        plen = L\n        feed_ids = [nxt]\n    return first, out\n\n\ndef hf_greedy(hf, ids_list, n_new):\n    import torch\n    import numpy as np\n    ids = list(ids_list)\n    first = None\n    out = []\n    with torch.no_grad():\n        for _ in range(n_new):\n            lg = hf(torch.tensor([ids])).logits[0, -1].numpy()\n            if first is None:\n                first = lg.copy()\n            nxt = int(lg.argmax())\n            out.append(nxt)\n            ids.append(nxt)\n    return first, out\n\n\ndef step_verify(a):\n    import numpy as np\n    import onnxruntime as ort\n    import torch\n    from transformers import AutoModelForCausalLM, AutoTokenizer\n    tok = AutoTokenizer.from_pretrained(a.tokenizer)\n    hf = AutoModelForCausalLM.from_pretrained(a.model, dtype=torch.float32).eval()\n    cfg = hf.config\n    layers, kv_heads = cfg.num_hidden_layers, cfg.num_key_value_heads\n    head_dim = getattr(cfg, "head_dim", cfg.hidden_size // cfg.num_attention_heads)\n    models = {"fp32": os.path.join(a.out, "fp32", "model.onnx")}\n    q8 = os.path.join(a.out, "q8", "model_quantized.onnx")\n    if os.path.exists(q8):\n        models["q8"] = q8\n    sessions = {k: ort.InferenceSession(p, providers=["CPUExecutionProvider"]) for k, p in models.items()}\n    rows = []\n    summary = {}\n    refs = {}\n    for p in PROMPTS:\n        ids = tok(p)["input_ids"]\n        refs[p] = hf_greedy(hf, ids, GREEDY_N)\n    for name, sess in sessions.items():\n        cos, top1, gmatch, gfull = [], 0, 0, 0\n        for p in PROMPTS:\n            ids = tok(p)["input_ids"]\n            ref_first, ref_tokens = refs[p]\n            first, toks = onnx_greedy(sess, ids, GREEDY_N, layers, kv_heads, head_dim)\n            c = cosine(first.astype(np.float64), ref_first.astype(np.float64))\n            cos.append(c)\n            top1 += int(first.argmax()) == int(ref_first.argmax())\n            k = 0\n            while k < len(toks) and toks[k] == ref_tokens[k]:\n                k += 1\n            gmatch += k\n            gfull += int(toks == ref_tokens)\n            rows.append({"variant": name, "prompt": p, "cos": round(c, 6), "top1": int(first.argmax()) == int(ref_first.argmax()),\n                         "greedy_prefix_match": k, "greedy_total": GREEDY_N, "onnx_tokens": toks, "hf_tokens": ref_tokens})\n        summary[name] = {"cos_min": round(min(cos), 6), "cos_mean": round(sum(cos) / len(cos), 6),\n                         "top1": f"{top1}/{len(PROMPTS)}", "greedy_prefix_match": f"{gmatch}/{GREEDY_N * len(PROMPTS)}",\n                         "greedy_full_match": f"{gfull}/{len(PROMPTS)}", "bytes": size_of(models[name])}\n    check = {"reference": "HF（PyTorch fp32，合併後模型）", "prompts": PROMPTS, "greedy_n": GREEDY_N,\n             "summary": summary, "rows": rows}\n    with open(os.path.join(a.out, "check.json"), "w", encoding="utf-8") as f:\n        json.dump(check, f, ensure_ascii=False, indent=1)\n    return {"summary": summary, "check": os.path.join(a.out, "check.json")}\n\n\nTOKENIZER_FILES = ["tokenizer.json", "tokenizer_config.json", "vocab.json", "merges.txt"]\n\n\ndef step_pack(a):\n    # 桌面版 nr-engine 要 modelPath＋tokenizerPath：把基底 tokenizer 檔放進匯出資料夾（與 app 的 q8 資料夾結構一致）\n    if a.tokenizer and os.path.isdir(a.tokenizer):\n        for f in TOKENIZER_FILES:\n            src = os.path.join(a.tokenizer, f)\n            if os.path.exists(src):\n                shutil.copyfile(src, os.path.join(a.out, f))\n    files = []\n    for rel in [os.path.join("fp32", "model.onnx"), os.path.join("fp32", "model.onnx_data"),\n                os.path.join("q8", "model_quantized.onnx"), "check.json"] + TOKENIZER_FILES:\n        p = os.path.join(a.out, rel)\n        if os.path.exists(p):\n            files.append({"path": rel.replace(os.sep, "/"), "bytes": os.path.getsize(p), "sha256": sha256(p)})\n    cfg_src = os.path.join(a.out, "fp32", "config.json")\n    if os.path.exists(cfg_src):\n        files.append({"path": "fp32/config.json", "bytes": os.path.getsize(cfg_src), "sha256": sha256(cfg_src)})\n    man = {"kind": "llm", "format": "onnx", "source": a.model or None, "recipe": a.recipe, "files": files,\n           "note": "fp32/ 是未量化圖；q8/model_quantized.onnx 是 quantize_dynamic 的結果（recipe=mixed 時 down_proj 保留 fp32，不能再套 lora-slot-build 的 LoRA 槽）",\n           "io": "input_ids/attention_mask/position_ids/past_key_values.*（與 app 的 q8 圖相同）"}\n    with open(os.path.join(a.out, "manifest.json"), "w", encoding="utf-8") as f:\n        json.dump(man, f, ensure_ascii=False, indent=1)\n    return {"manifest": os.path.join(a.out, "manifest.json"), "files": len(files)}\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument("--step", required=True, choices=["convert", "quantize", "verify", "pack"])\n    ap.add_argument("--model", help="合併後的 HF 資料夾（convert／verify）")\n    ap.add_argument("--tokenizer", help="tokenizer 資料夾（預設同 --model；合併後資料夾的 tokenizer 若由 transformers 5 存的，4.x 讀不了，請指向基底）")\n    ap.add_argument("--out", required=True)\n    ap.add_argument("--recipe", default="full", choices=["full", "mixed"])\n    a = ap.parse_args()\n    a.tokenizer = a.tokenizer or a.model\n    fn = {"convert": step_convert, "quantize": step_quantize, "verify": step_verify, "pack": step_pack}[a.step]\n    try:\n        res = fn(a)\n        emit(a.step, True, **res)\n    except Exception as e:  # 讓執行器拿到明確錯誤\n        emit(a.step, False, error=f"{type(e).__name__}: {str(e)[:500]}")\n        sys.exit(1)\n\n\nif __name__ == "__main__":\n    main()\n',"lora-train/export_gguf.py":'#!/usr/bin/env python3\n"""合併後的 HF 資料夾 → GGUF（f16）→ Q8_0 → 用 llama.cpp 的 llama-server 實際推論核對 → 寫資產 manifest。\nDESIGN.lora-training.md §25。工具來自 llama.cpp（實測版本 b12286）：convert_hf_to_gguf.py、llama-quantize、llama-server。\n\n分四步（與 export_onnx.py 同樣格式：每步在 stdout 印一行 JSON）：\n  convert   convert_hf_to_gguf.py --outtype f16 → <out>/model-f16.gguf\n            轉換器會讀 tokenizer；transformers 5 存的 tokenizer_config.json 在 4.x 讀不了，所以本步會先在\n            <out>/hf-input/ 建一個「合併後權重＋基底 tokenizer」的符號連結資料夾，只給轉換器用。\n  quantize  llama-quantize <f16> Q8_0 → <out>/model-q8_0.gguf\n  verify    起 llama-server（-c 512、--port 隨機空閒埠），對每個提示用 /completion（temperature 0、top_k 1、\n            return_tokens）取貪婪 N 個 token，與 HF（PyTorch fp32，合併後模型）的貪婪 token 逐一比對 → <out>/check_gguf.json\n  pack      寫 <out>/manifest_gguf.json（檔名、大小、sha256、來源、recipe）\n\n用法（用 .venv-export 的 python；llama.cpp 的工具路徑用 --llama_dir 指向含 llama-quantize／llama-server 的 bin 資料夾，\nconvert_hf_to_gguf.py 用 --llama_src 指向 llama.cpp 原始碼根目錄）：\n    .venv-export/bin/python export_gguf.py --step convert  --model <merged> --tokenizer <base> --out <out> \\\n        --llama_src <llama.cpp 根> --llama_dir <llama.cpp>/build/bin\n    .venv-export/bin/python export_gguf.py --step quantize --out <out> --llama_dir <llama.cpp>/build/bin\n    .venv-export/bin/python export_gguf.py --step verify   --model <merged> --tokenizer <base> --out <out> --llama_dir <llama.cpp>/build/bin\n    .venv-export/bin/python export_gguf.py --step pack     --out <out>\n\n注意：verify 只比對貪婪 token（llama-server 不回傳完整 logits），所以不宣稱首步 logits 餘弦；這一點寫在 check_gguf.json。\n"""\nimport argparse\nimport hashlib\nimport json\nimport os\nimport shutil\nimport socket\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\nGREEDY_N = 16\nPROMPTS = [\n    "台北在哪個國家？",\n    "def add(a, b):",\n    "Choose the best tool: A. search B. calc\\nAnswer:",\n    "請把這個任務拆成三個子步驟：整理資料、計算平均、輸出報表。",\n    \'{"name": "get_weather", "arguments": {"city": "Taipei"}}\',\n    "The quick brown fox jumps over",\n]\nBASE_TOK_FILES = ["tokenizer.json", "tokenizer_config.json", "vocab.json", "merges.txt", "generation_config.json"]\n\n\ndef emit(step, ok, **kw):\n    print(json.dumps(dict(step=step, ok=ok, **kw), ensure_ascii=False), flush=True)\n\n\ndef sha256(path):\n    h = hashlib.sha256()\n    with open(path, "rb") as f:\n        for chunk in iter(lambda: f.read(1 << 20), b""):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef tool(a, name):\n    if a.llama_dir:\n        p = os.path.join(a.llama_dir, name)\n        if os.path.exists(p):\n            return p\n        raise RuntimeError(f"找不到 {p}")\n    found = shutil.which(name)\n    if not found:\n        raise RuntimeError(f"找不到 {name}（請用 --llama_dir 指定）")\n    return found\n\n\ndef step_convert(a):\n    if not a.llama_src:\n        raise RuntimeError("convert 需要 --llama_src（llama.cpp 原始碼根目錄，內含 convert_hf_to_gguf.py）")\n    inp = os.path.join(a.out, "hf-input")\n    os.makedirs(inp, exist_ok=True)\n    for f in ["model.safetensors", "config.json"]:\n        dst = os.path.join(inp, f)\n        if not os.path.exists(dst):\n            os.symlink(os.path.abspath(os.path.join(a.model, f)), dst)\n    for f in BASE_TOK_FILES:\n        src = os.path.join(a.tokenizer, f)\n        dst = os.path.join(inp, f)\n        if os.path.exists(src) and not os.path.exists(dst):\n            os.symlink(os.path.abspath(src), dst)\n    outp = os.path.join(a.out, "model-f16.gguf")\n    env = dict(os.environ)\n    env["PYTHONPATH"] = os.pathsep.join([a.llama_src, os.path.join(a.llama_src, "gguf-py")])\n    t0 = time.time()\n    subprocess.check_call([sys.executable, os.path.join(a.llama_src, "convert_hf_to_gguf.py"), inp,\n                           "--outtype", "f16", "--outfile", outp], env=env, stdout=subprocess.DEVNULL)\n    return {"model": outp, "bytes": os.path.getsize(outp), "seconds": round(time.time() - t0, 1)}\n\n\ndef step_quantize(a):\n    src = os.path.join(a.out, "model-f16.gguf")\n    if not os.path.exists(src):\n        raise RuntimeError("沒有 f16 GGUF：先跑 --step convert")\n    dst = os.path.join(a.out, "model-q8_0.gguf")\n    t0 = time.time()\n    subprocess.check_call([tool(a, "llama-quantize"), src, dst, "Q8_0"], stdout=subprocess.DEVNULL)\n    return {"model": dst, "bytes": os.path.getsize(dst), "seconds": round(time.time() - t0, 1)}\n\n\ndef free_port():\n    s = socket.socket()\n    s.bind(("127.0.0.1", 0))\n    p = s.getsockname()[1]\n    s.close()\n    return p\n\n\ndef post(port, payload, timeout=120):\n    req = urllib.request.Request(f"http://127.0.0.1:{port}/completion", data=json.dumps(payload).encode(),\n                                 headers={"Content-Type": "application/json"})\n    with urllib.request.urlopen(req, timeout=timeout) as r:\n        return json.loads(r.read().decode("utf-8"))\n\n\ndef step_verify(a):\n    import torch\n    from transformers import AutoModelForCausalLM, AutoTokenizer\n    gguf = os.path.join(a.out, "model-q8_0.gguf")\n    if not os.path.exists(gguf):\n        raise RuntimeError("沒有 q8_0 GGUF：先跑 --step quantize")\n    tok = AutoTokenizer.from_pretrained(a.tokenizer)\n    hf = AutoModelForCausalLM.from_pretrained(a.model, dtype=torch.float32).eval()\n    ref = {}\n    with torch.no_grad():\n        for p in PROMPTS:\n            ids = tok(p)["input_ids"]\n            seq = list(ids)\n            out = []\n            for _ in range(GREEDY_N):\n                nxt = int(hf(torch.tensor([seq])).logits[0, -1].argmax())\n                out.append(nxt)\n                seq.append(nxt)\n            ref[p] = (ids, out)\n    del hf\n    port = free_port()\n    log = os.path.join(a.out, "llama-server.log")\n    with open(log, "w") as lf:\n        srv = subprocess.Popen([tool(a, "llama-server"), "-m", gguf, "--port", str(port), "-c", "512", "-t", "8",\n                                "--no-webui"], stdout=lf, stderr=subprocess.STDOUT)\n    rows, pref, full, top1 = [], 0, 0, 0\n    try:\n        for _ in range(120):\n            try:\n                urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=2)\n                break\n            except Exception:\n                time.sleep(1)\n        else:\n            raise RuntimeError("llama-server 沒有在 120 秒內就緒，見 llama-server.log")\n        for p in PROMPTS:\n            ids, ref_out = ref[p]\n            res = post(port, {"prompt": p, "n_predict": GREEDY_N, "temperature": 0, "top_k": 1, "return_tokens": True,\n                              "cache_prompt": False})\n            toks = res.get("tokens", [])\n            k = 0\n            while k < min(len(toks), len(ref_out)) and toks[k] == ref_out[k]:\n                k += 1\n            pref += k\n            full += int(toks == ref_out)\n            rows.append({"prompt": p, "prompt_ids_match_hf": None, "llama_tokens": toks, "hf_tokens": ref_out,\n                         "greedy_prefix_match": k, "greedy_total": GREEDY_N})\n    finally:\n        srv.terminate()\n        try:\n            srv.wait(timeout=20)\n        except subprocess.TimeoutExpired:\n            srv.kill()\n    summary = {"greedy_prefix_match": f"{pref}/{GREEDY_N * len(PROMPTS)}", "greedy_full_match": f"{full}/{len(PROMPTS)}",\n               "bytes": os.path.getsize(gguf)}\n    check = {"reference": "HF（PyTorch fp32，合併後模型，貪婪）", "runtime": "llama-server（llama.cpp b12286，/completion，temperature 0，top_k 1）",\n             "note": "只比貪婪 token；llama-server 不回傳完整 logits，因此不含首步 logits 餘弦", "summary": summary, "rows": rows}\n    with open(os.path.join(a.out, "check_gguf.json"), "w", encoding="utf-8") as f:\n        json.dump(check, f, ensure_ascii=False, indent=1)\n    return {"summary": summary, "check": os.path.join(a.out, "check_gguf.json")}\n\n\ndef step_pack(a):\n    files = []\n    for rel in ["model-q8_0.gguf", "check_gguf.json"]:\n        p = os.path.join(a.out, rel)\n        if os.path.exists(p):\n            files.append({"path": rel, "bytes": os.path.getsize(p), "sha256": sha256(p)})\n    man = {"kind": "llm", "format": "gguf", "quant": "Q8_0", "source": a.model, "files": files,\n           "runtime_check": "llama-server（b12286）貪婪 token 對 HF 參考"}\n    with open(os.path.join(a.out, "manifest_gguf.json"), "w", encoding="utf-8") as f:\n        json.dump(man, f, ensure_ascii=False, indent=1)\n    return {"manifest": os.path.join(a.out, "manifest_gguf.json"), "files": len(files)}\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument("--step", required=True, choices=["convert", "quantize", "verify", "pack"])\n    ap.add_argument("--model", help="合併後的 HF 資料夾（convert／verify）")\n    ap.add_argument("--tokenizer", help="tokenizer 資料夾（預設同 --model；建議指向基底）")\n    ap.add_argument("--out", required=True)\n    ap.add_argument("--llama_src", help="llama.cpp 原始碼根目錄（convert）")\n    ap.add_argument("--llama_dir", help="含 llama-quantize／llama-server 的資料夾（預設用 PATH）")\n    a = ap.parse_args()\n    a.tokenizer = a.tokenizer or a.model\n    os.makedirs(a.out, exist_ok=True)\n    fn = {"convert": step_convert, "quantize": step_quantize, "verify": step_verify, "pack": step_pack}[a.step]\n    try:\n        emit(a.step, True, **fn(a))\n    except Exception as e:\n        emit(a.step, False, error=f"{type(e).__name__}: {str(e)[:500]}")\n        sys.exit(1)\n\n\nif __name__ == "__main__":\n    main()\n'},FA_STUDIO_VIEWER_HTML="<!doctype html>\n<html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>離線訓練工作室</title>\n<style>\n:root{--bg:#fff;--fg:#1f2328;--mut:#656d76;--bd:#d0d7de;--ac:#0969da;--sf:#f6f8fa;--ok:#1a7f37;--er:#cf222e;--wn:#9a6700;--hl:#ddf4ff}\n@media (prefers-color-scheme:dark){:root:not([data-theme]){--bg:#0d1117;--fg:#e6edf3;--mut:#8b949e;--bd:#30363d;--ac:#58a6ff;--sf:#161b22;--ok:#3fb950;--er:#f85149;--wn:#d29922;--hl:#0c2d4a}}\n:root[data-theme=\"dark\"]{--bg:#0d1117;--fg:#e6edf3;--mut:#8b949e;--bd:#30363d;--ac:#58a6ff;--sf:#161b22;--ok:#3fb950;--er:#f85149;--wn:#d29922;--hl:#0c2d4a}\n*{box-sizing:border-box}html,body{height:100%}body{margin:0;background:var(--bg);color:var(--fg);font:13px/1.5 -apple-system,\"Segoe UI\",\"Noto Sans TC\",sans-serif;display:flex;flex-direction:column}\nheader{display:flex;align-items:center;gap:8px;padding:5px 10px;border-bottom:1px solid var(--bd);background:var(--sf);flex-wrap:wrap}\nheader b{font-size:14px}.sp{flex:1}\nbutton,select,input{font:inherit;color:inherit;background:var(--bg);border:1px solid var(--bd);border-radius:5px;padding:2px 8px}\nbutton{cursor:pointer}button:hover:not(:disabled){border-color:var(--ac)}button:disabled{opacity:.5;cursor:not-allowed}\nbutton.pri{background:var(--ac);border-color:var(--ac);color:#fff}button.dng{color:var(--er)}\n#main{flex:1;display:flex;min-height:0}#main.stack{flex-direction:column}\n.pane{display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden}\n.pane.hid{display:none}\n.bar{display:flex;align-items:stretch;border-bottom:1px solid var(--bd);background:var(--sf);flex:none;user-select:none}\n.tabs{display:flex;flex:1;overflow-x:auto;min-width:0}\n.tab{padding:5px 10px;cursor:pointer;border-right:1px solid var(--bd);white-space:nowrap;color:var(--mut)}\n.tab .x{margin-left:6px;opacity:.6}.tab .x:hover{opacity:1;color:#c00}\n.tab.act{background:var(--bg);color:var(--fg);box-shadow:inset 0 -2px 0 var(--ac)}.tab.over{background:var(--hl)}\n.bar button{border:none;border-radius:0;background:none;padding:0 8px}\n.body{flex:1;overflow:auto;padding:10px;min-height:0}\n#split{flex:none;width:6px;background:var(--bd);cursor:col-resize}#main.stack #split{width:auto;height:6px;cursor:row-resize}#split:hover{background:var(--ac)}\n.badge{display:inline-block;padding:0 7px;border-radius:9px;border:1px solid var(--bd);font-size:11px;color:var(--mut);margin-left:4px}\n.badge.ok{color:var(--ok);border-color:var(--ok)}.badge.er{color:var(--er);border-color:var(--er)}.badge.wn{color:var(--wn);border-color:var(--wn)}\n.warn{border:1px solid var(--wn);color:var(--wn);padding:6px 10px;border-radius:6px;margin-bottom:8px}\n.todo{border:1px dashed var(--bd);padding:10px;border-radius:6px;color:var(--mut)}\n.grp{margin:10px 0 4px;font-weight:600}.row{display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px solid var(--bd);flex-wrap:wrap}.row .n{flex:1;min-width:120px;word-break:break-all}\n.card{border:1px solid var(--bd);border-radius:6px;padding:8px;margin:8px 0;background:var(--sf)}\ntable{border-collapse:collapse;width:100%;font-size:12px}td,th{border:1px solid var(--bd);padding:3px 6px;text-align:left}th{background:var(--sf)}\npre{background:var(--sf);border:1px solid var(--bd);border-radius:5px;padding:6px;overflow:auto;max-height:200px;margin:4px 0;font-size:12px}\nlabel{display:block;margin:4px 0 0;color:var(--mut);font-size:12px}input[type=text],select{width:100%}\n#menu{position:fixed;z-index:9;background:var(--bg);border:1px solid var(--bd);border-radius:6px;box-shadow:0 4px 14px #0004;display:none;min-width:130px}\n#menu div{padding:5px 12px;cursor:pointer}#menu div:hover{background:var(--hl)}\ncanvas{width:100%;height:60px;border:1px solid var(--bd);border-radius:4px;background:var(--sf)}\n</style></head><body>\n__SHIM__\n<header><b>🏭 離線訓練工作室</b><span class=\"badge\" id=\"mode\">載入中…</span><span class=\"sp\"></span>\n<button id=\"bReset\" title=\"把分頁位置、分隔線、最大化都還原成預設\">還原版面</button></header>\n<div id=\"main\"><div class=\"pane\" id=\"pL\"></div><div id=\"split\" title=\"拖曳調整寬度；雙擊還原\"></div><div class=\"pane\" id=\"pR\"></div></div>\n<div id=\"menu\"></div>\n<script>__LAYOUT__<\/script>\n<script>__LORA_MANAGE__<\/script>\n<script>__PIPELINE_VIEW__<\/script>\n<script>\n(function(){\nvar CFG=__CFG__;function applyTheme(t){if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}applyTheme(CFG.theme);window.addEventListener('message',function(e){var d=e.data;if(d&&d.__fa_theme)applyTheme(d.__fa_theme);if(d&&d.__fa_modeltypes){MTYPES=d.__fa_modeltypes.list||[];GUARDS=d.__fa_modeltypes.guards||{};MT_MISSING=!!d.__fa_modeltypes.missing;if(typeof refresh==='function')refresh('train')}});\nvar STZH={running:'訓練中',paused:'已暫停',finishing:'收尾中',finished:'已完成',error:'出錯',stopped:'已停止',idle:'待命'};var BASE='http://mock.local',Lay=FaStudioLayout,$=function(s){return document.querySelector(s)};\nvar L=Lay.defaults(),INFO={},TITLE={};Lay.TABS.forEach(function(t){TITLE[t.id]=t.icon+' '+t.title});\nfunction h(tag,a,kids){var e=document.createElement(tag);if(a)for(var k in a){if(k==='text')e.textContent=a[k];else if(k.slice(0,2)==='on')e.addEventListener(k.slice(2),a[k]);else if(a[k]!==false&&a[k]!=null)e.setAttribute(k,a[k]===true?'':a[k])}\n (kids||[]).forEach(function(c){if(c!=null)e.appendChild(typeof c==='string'?document.createTextNode(c):c)});return e}\nasync function api(m,p,b){var r=await fetch(BASE+p,{method:m,headers:{'content-type':'application/json'},body:b?JSON.stringify(b):undefined});var j=await r.json();if(!r.ok&&j&&j.ok===undefined)j.ok=false;return j}\nfunction fmtB(n){return n>1048576?(n/1048576).toFixed(1)+' MB':n>1024?(n/1024).toFixed(1)+' KB':n+' B'}\nfunction reason(t){return h('div',{'class':'todo',text:t})}\n// ===== 版面 =====\nvar saveT;function save(){clearTimeout(saveT);saveT=setTimeout(function(){api('POST','/api/prefs',{layout:L}).catch(function(){})},250)}\nfunction setL(n){L=Lay.normalize(n);save();render()}\nfunction applySize(){var main=$('#main'),stack=Lay.orientation(main.clientWidth)==='stack';main.classList.toggle('stack',stack);var a=$('#pL'),b=$('#pR'),sp=$('#split');\n var maxed=L.max;a.classList.toggle('hid',maxed==='right');b.classList.toggle('hid',maxed==='left');sp.style.display=maxed?'none':'';\n var p=(L.split*100)+'%';if(maxed){a.style.flex=b.style.flex='1 1 0'}else{a.style.flex='0 0 calc('+p+' - 3px)';b.style.flex='1 1 0'}}\nfunction menu(x,y,items){var m=$('#menu');m.textContent='';items.forEach(function(it){m.appendChild(h('div',{text:it[0],onclick:function(){m.style.display='none';it[1]()}}))});m.style.left=Math.min(x,innerWidth-150)+'px';m.style.top=Math.min(y,innerHeight-30*items.length-8)+'px';m.style.display='block'}\ndocument.addEventListener('click',function(){$('#menu').style.display='none'});\nvar dragId=null;\n// 詳情／瀏覽資料：開在「資產清單的另一側」的可關閉分頁（不佔資產清單的版面）；暫時的，不存進版面偏好\nvar DT=[],dtAct=null;\nfunction detSide(){return L.panes.left.indexOf('assets')>=0?'right':'left'}\nfunction openDetail(kind,name){var id=kind+'/'+name;if(!DT.some(function(d){return d.id===id}))DT.push({id:id,kind:kind,name:name,hist:[{t:'asset'}],i:0});dtAct=id;if(L.max&&L.max!==detSide())L=Lay.toggleMax(L,L.max);render([detSide()])}\n// 每個詳情分頁有自己的瀏覽歷史（上一頁／下一頁）：資產詳情 → 點檔案 → 檔案內容；上一頁回到詳情\n// 統一規則（使用者 2026-11-12：「左邊需要展開的，都統一開在右邊」）：會在左邊清單底下展開的內容（資料集預覽／逐筆編輯、語料塊預覽、家族題目預覽、評量結果…）一律開成右邊的可關閉分頁，\n// 跟資產詳情同一套（關閉、右鍵選單、上一頁／下一頁、不會讓左邊捲回開頭）。render(body) 負責把內容畫進分頁；同一個 id 再點一次＝切到已開的那一頁並重畫。\nfunction outPane(id,title,icon,el){var out=el||h('div');var busy=false;new MutationObserver(function(){if(busy||!out.firstChild)return;busy=true;try{openView(id,title,function(b){b.textContent='';b.appendChild(out);out.style.display=''},icon)}finally{busy=false}}).observe(out,{childList:true});return out}\nfunction openView(id,title,render,icon){var d=DT.filter(function(x){return x.id===id})[0];if(!d){d={id:id,kind:'view',name:title,icon:icon||'📄',hist:[{t:'custom',fn:render}],i:0};DT.push(d)}else{d.name=title;d.hist=d.hist.slice(0,d.i+1);d.hist[d.i]={t:'custom',fn:render}}dtAct=id;if(L.max&&L.max!==detSide())L=Lay.toggleMax(L,L.max);render([detSide()])}\nfunction pushView(d,v){d.hist=d.hist.slice(0,d.i+1);d.hist.push(v);d.i=d.hist.length-1;render([detSide()])}\nfunction navDetail(d,dir){var n=d.i+dir;if(n<0||n>=d.hist.length)return;d.i=n;render([detSide()])}\nasync function renderDetail(d,body){var v=d.hist[d.i]||{t:'asset'};\n var bk=h('button',{text:'◀ 上一頁',title:'上一頁（Alt+←）',disabled:d.i<=0,onclick:function(){navDetail(d,-1)}}),fw=h('button',{text:'下一頁 ▶',title:'下一頁（Alt+→）',disabled:d.i>=d.hist.length-1,onclick:function(){navDetail(d,1)}});\n body.appendChild(h('div',{'class':'row'},[bk,fw,h('span',{style:'color:var(--mut);font-size:12px',text:(d.kind==='view'?d.name:d.kind+'/'+d.name)+(v.t==='file'?' › '+v.path:'')+'（第 '+(d.i+1)+'／'+d.hist.length+' 步）'})]));\n if(v.t==='custom'){await v.fn(body);return}\n if(v.t==='file'){var x=await api('GET','/api/asset-file?kind='+encodeURIComponent(d.kind)+'&name='+encodeURIComponent(d.name)+'&path='+encodeURIComponent(v.path));\n  body.appendChild(h('pre',{text:x.ok===false?x.error:x.text+(x.truncated?'\\n…（只顯示前 6000 字元，共 '+x.bytes+' 位元組）':'')}));return}\n await detail(d.kind,d.name,body,d)}\ndocument.addEventListener('keydown',function(e){if(!e.altKey||!dtAct)return;var d=DT.filter(function(x){return x.id===dtAct})[0];if(!d)return;if(e.key==='ArrowLeft'){e.preventDefault();navDetail(d,-1)}else if(e.key==='ArrowRight'){e.preventDefault();navDetail(d,1)}});\nfunction dtMenu(x,y,d){var idx=DT.indexOf(d);menu(x,y,[\n ['關閉 Close',function(){closeDetail(d.id)}],\n ['關閉全部 Close All',function(){closeDetailMany(function(){return false})}],\n ['關閉其他 Close Others',function(){closeDetailMany(function(o){return o===d})}],\n ['關閉左側 Close Left',function(){closeDetailMany(function(o){return DT.indexOf(o)>=idx})}],\n ['關閉右側 Close Right',function(){closeDetailMany(function(o){return DT.indexOf(o)<=idx})}],\n ['複製名稱（'+d.kind+'/'+d.name+'）',function(){try{navigator.clipboard.writeText(d.kind+'/'+d.name)}catch(_){}}]])}\nfunction closeDetail(id){DT=DT.filter(function(d){return d.id!==id});if(dtAct===id)dtAct=DT.length?DT[DT.length-1].id:null;render([detSide()])}\nfunction closeDetailMany(keep){DT=DT.filter(function(d){return keep(d)});if(!DT.some(function(d){return d.id===dtAct}))dtAct=DT.length?DT[DT.length-1].id:null;render([detSide()])}\nfunction paneEl(side){\n var el=side==='left'?$('#pL'):$('#pR'),tabs=h('div',{'class':'tabs'});\n L.panes[side].forEach(function(id){var t=h('div',{'class':'tab'+(L.active[side]===id&&!(side===detSide()&&dtAct)?' act':''),draggable:'true',text:TITLE[id],title:'拖到另一側的分頁列可搬移；右鍵有更多選項'});\n  t.addEventListener('click',function(){dtAct=null;setL(Lay.activate(L,id))});\n  t.addEventListener('dragstart',function(e){dragId=id;try{e.dataTransfer.setData('text/plain',id)}catch(_){}});\n  t.addEventListener('contextmenu',function(e){e.preventDefault();var o=side==='left'?'right':'left';menu(e.clientX,e.clientY,[['移到'+(o==='left'?'左':'右')+'區',function(){mv(id,o)}],['關閉',function(){var r=Lay.closeTab(L,id);if(r.ok)setL(r.layout);else alert(r.error)}]])});\n  tabs.appendChild(t)});\n if(side===detSide())DT.forEach(function(d){var t=h('div',{'class':'tab'+(dtAct===d.id?' act':''),title:d.kind+'/'+d.name+'（可關閉的詳情分頁）'},[h('span',{text:(d.icon||'📄')+' '+d.name}),h('span',{'class':'x',text:'✕',title:'關閉這個分頁',onclick:function(e){e.stopPropagation();closeDetail(d.id)}})]);t.addEventListener('click',function(){dtAct=d.id;render([detSide()])});t.addEventListener('contextmenu',function(e){e.preventDefault();dtMenu(e.clientX,e.clientY,d)});tabs.appendChild(t)});\n var plus=h('button',{text:'＋',title:'開啟已關閉的分頁',onclick:function(e){e.stopPropagation();var cl=L.closed;var r=e.currentTarget.getBoundingClientRect();menu(r.left,r.bottom,cl.length?cl.map(function(id){return[TITLE[id],function(){var r2=Lay.openTab(L,id,side);if(r2.ok)setL(r2.layout)}]}):[['（沒有已關閉的分頁）',function(){}]])}});\n var mx=h('button',{text:L.max===side?'🗗':'🗖',title:L.max===side?'還原':'最大化這一區（雙擊分頁列空白處同效）',onclick:function(){setL(Lay.toggleMax(L,side))}});\n var bar=h('div',{'class':'bar'},[tabs,plus,mx]);\n bar.addEventListener('dblclick',function(e){if(e.target===bar||e.target===tabs)setL(Lay.toggleMax(L,side))});\n bar.addEventListener('dragover',function(e){if(dragId){e.preventDefault();bar.classList.add('over')}});bar.addEventListener('dragleave',function(){bar.classList.remove('over')});\n bar.addEventListener('drop',function(e){e.preventDefault();bar.classList.remove('over');if(dragId){mv(dragId,side);dragId=null}});\n var body=h('div',{'class':'body'});el.textContent='';el.appendChild(bar);el.appendChild(body);return body}\nfunction mv(id,side){var r=Lay.moveTab(L,id,side);if(r.ok)setL(r.layout);else alert(r.error)}\nvar cur={left:null,right:null};\n// 只重畫需要的那一側，並保留捲動位置：以前每開一個詳情分頁，兩側都重畫，左邊的清單就跳回開頭\nfunction render(sides){applySize();(sides||['left','right']).forEach(function(s){var el=s==='left'?$('#pL'):$('#pR'),oldB=el.querySelector('.body'),keep=oldB&&oldB.scrollTop||0,wasCur=cur[s];var body=paneEl(s),id=L.active[s],pr=null;\n  if(s===detSide()&&dtAct){var d=DT.filter(function(x){return x.id===dtAct})[0];if(d){cur[s]='detail:'+d.id;pr=renderDetail(d,body)}else dtAct=null}\n  if(!pr){cur[s]=id;if(id)pr=show(id,body)}\n  var back=function(){if(cur[s]===wasCur&&keep)body.scrollTop=keep};back();Promise.resolve(pr).then(back,back);setTimeout(back,150)})}\n$('#bReset').onclick=async function(){var r=await api('POST','/api/prefs',{reset:true});L=Lay.normalize(r.layout);render()};\n(function(){var sp=$('#split'),down=false;sp.addEventListener('pointerdown',function(e){down=true;sp.setPointerCapture(e.pointerId)});\n sp.addEventListener('pointermove',function(e){if(!down)return;var m=$('#main').getBoundingClientRect(),stack=$('#main').classList.contains('stack');L=Lay.setSplit(L,stack?Lay.ratioFromPointer(e.clientY,m.top,m.height):Lay.ratioFromPointer(e.clientX,m.left,m.width));applySize()});\n sp.addEventListener('pointerup',function(){if(down){down=false;save()}});sp.addEventListener('dblclick',function(){L=Lay.resetSplit(L);save();applySize()});\n window.addEventListener('resize',applySize)})();\n// ===== 分頁內容 =====\nvar T={};\nfunction show(id,body){body.textContent='';var t0=Date.now(),fn=T[id]||function(b){b.appendChild(reason('尚未實作'))},p;\n try{p=fn(body)}catch(e){p=Promise.reject(e)}\n return Promise.resolve(p).catch(function(e){body.appendChild(reason('「'+id+'」分頁出錯：'+((e&&e.message)||e)+'（耗時 '+(Date.now()-t0)+' 毫秒）'))})}\nfunction refresh(id){['left','right'].forEach(function(s){if(cur[s]===id){var b=(s==='left'?$('#pL'):$('#pR')).querySelector('.body');if(b)show(id,b)}})}\nT.assets=async function(body){\n var r=await api('GET','/api/assets');if(r.ok===false){body.appendChild(reason('讀取資產失敗：'+r.error));return}\n if(r.storage&&!r.storage.ok)body.appendChild(h('div',{'class':'warn',text:'⚠️ '+r.storage.message}));\n var tb=h('div',{'class':'row'},[h('button',{'class':'pri',text:'匯入 .fatrain…',onclick:doImport}),h('button',{text:'把目前的離線訓練器存成資產',onclick:async function(){var n=prompt('資產名稱','trainer-'+new Date().toISOString().slice(0,10));if(!n)return;var x=await api('POST','/api/trainer/snapshot',{name:n});if(x.ok===false)alert(x.error);refresh('assets')}}),h('button',{text:'重新整理',onclick:function(){refresh('assets')}})]);body.appendChild(tb);\n var imp=h('div',{id:'impBox'});body.appendChild(imp);\n var ORG={builtin:'內建',mine:'我的',imported:'匯入'};\n /* 計數鍵的中文名（使用者看得懂；沒有列出的鍵照原樣顯示） */\n var ZHK={tasks:'題目',units:'單元',models:'模型',self:'自我檢查',weights:'權重',trained:'已訓練',records:'紀錄',rows:'列',positives:'正例',negatives:'負例',groups:'組',lessons:'課',algos:'演算法',verified_tasks:'已驗證題',packs:'領域包',paradigms:'範式',skeletons:'骨架',seeds:'種子題',train:'訓練題',holdout:'留出題',ops:'操作',synthesizers:'合成器'};\n var tot={builtin:0,mine:0,imported:0};r.groups.forEach(function(g){var c=g.counts||{};tot.builtin+=c.builtin||0;tot.mine+=c.mine||0;tot.imported+=c.imported||0});\n body.appendChild(h('div',{'class':'card'},[h('b',{text:'全部：內建 '+tot.builtin+'／我的 '+tot.mine+'／匯入 '+tot.imported}),h('div',{style:'color:var(--mut);font-size:12px',text:'「內建」是程式本身已經做好的內容（唯讀，不能刪；可瀏覽資料集、可匯出成 .fatrain）。「我的」是你自己訓練或存下的；「匯入」是從 .fatrain 匯入的。數字每個種類各自列在下面。'})]));\n r.groups.forEach(function(g){var gc=g.counts||{builtin:0,mine:0,imported:0};body.appendChild(h('div',{'class':'grp',text:g.label+'（'+g.kind+'）　內建 '+(gc.builtin||0)+'／我的 '+(gc.mine||0)+'／匯入 '+(gc.imported||0)}));\n  if(g.kind==='uml')body.appendChild(h('div',{'class':'row',style:'color:var(--mut)',text:'UML 的詞彙表、模板與決策表寫在程式裡，不是使用者可訓練的資料：這裡只能唯讀檢視，要改請改原始碼。'}));\n  if(!g.items.length)body.appendChild(h('div',{'class':'row',style:'color:var(--mut)',text:g.kind==='lora'?'還沒有 LoRA 資產。訓練完成後會出現在這裡，也可以到「LoRA 登錄」分頁查看