,lang:{type:"string"},name:{type:"string"},names:{type:"array",items:{type:"string"}},summary:{type:"string"},note:{type:"string"},category:{type:"string"},label:{type:"string"},description:{type:"string"},arch:{type:"string"},pattern:{type:"array",items:{type:"string"}},template:{type:"string"},parameters:{type:"array",items:{type:"object"}},return:{type:"object"},kind:{type:"string"},data:{}},required:["action"],additionalProperties:!1}),e("lookup_error_code",'查錯誤碼的意思（離線可用）：Linux errno（EACCES、13、-ENOMEM）、訊號（SIGSEGV、11）、shell 退出碼（139、127）、Windows Win32 錯誤（ERROR_ACCESS_DENIED、5、GetLastError）、HRESULT（0x80070005）與解碼、NTSTATUS（0xC0000005，也吃帶號整數 -1073741819）、Winsock（10061）。回傳名稱、原文訊息、白話原因與常見處理。查不到時提示可請 AI 查官方文件後用 ref_define 補。參數：{"query":"errno 13"}',a(function(e){return this._refLookupError(e)}),{type:"object",properties:{query:{type:"string",description:'錯誤碼、名稱或描述，例如 "errno 13"、"0xC0000005"、"ERROR_ACCESS_DENIED"、"exit code 139"、"connection refused"'},system:{type:"string",description:"可選：限定 linux／windows"}},required:["query"],additionalProperties:!1}),e("explain_command_line",'逐項解釋一行命令（離線可用）：gcc／g++／javac／java／python／node／gdb／qemu-system-arm／qemu-system-aarch64／qemu-system-x86_64（含 -M 機型、-cpu、-drive／-device／-netdev 的子選項、-append 核心命令列）以及常用的 Linux 命令（grep、find、tar、curl、ssh、rsync、systemctl、git、docker、cmake、make…，內容來自 man 手冊重點）。回傳整體在做什麼與每個選項的意義。參數：{"command":"qemu-system-aarch64 -M virt -cpu cortex-a53 -kernel Image -nographic"}',a(function(e){return this._refExplainCmd(e)}),{type:"object",properties:{command:{type:"string",description:"完整命令列"}},required:["command"],additionalProperties:!1}),e("diagnose_log",'診斷一段日誌，說明「發生了什麼事」（離線可用，規則比對，不需要 AI）：建置失敗（make、CMake、BitBake／Yocto、ninja、Meson、autotools、Kbuild、gcc／g++／clang 編譯錯誤、ld 連結錯誤、Maven、Gradle、npm、Cargo、pip、Go）、gdb 訊息、Linux 核心日誌（dmesg）、kernel panic／Oops、systemd／journal、執行期錯誤。回傳：判斷是哪個系統、根本原因（附白話說明、常見原因、怎麼處理）、連帶結果（例如 make 的 Error 1 只是結果）、傳遞路徑（編譯器錯誤→make→BitBake 任務失敗）、還沒有規則的錯誤行（會進待學習清單，之後 AI 可補規則）。整段日誌貼進去效果最好。參數：{"log":"日誌文字"}',a(function(e){return this._refDiagnose(e)}),{type:"object",properties:{log:{type:"string",description:"日誌或錯誤輸出（整段貼上最好，不要只貼最後一行）"},system:{type:"string",description:"可選：已知的系統（bitbake、cmake、make、kernel、journal、gdb…）"}},required:["log"],additionalProperties:!1}),e("explain_build_error",'說明建置錯誤（diagnose_log 的別名，專給 make／CMake／BitBake／gcc／ld 的建置輸出）：找出根本原因、連帶結果與傳遞路徑，並說明常見原因與處理方式。離線可用。參數：{"log":"建置輸出"}',a(function(e){return this._refDiagnose(e)}),{type:"object",properties:{log:{type:"string",description:"建置輸出（整段貼上最好）"}},required:["log"],additionalProperties:!1}),e("ref_lookup",'查參考知識（離線可用）：錯誤碼、命令與單一選項（gcc -fPIC、gdb 的 x 命令）、#pragma（omp parallel for reduction…、GCC diagnostic）、以及使用者與 AI 補的語意／文法／分詞／組合語言／建置系統知識。查不到時回報並提示用 ref_define 補。參數：{"query":"omp parallel for"}',a(function(e){return this._refLookupAny(e)}),{type:"object",properties:{query:{type:"string",description:"要查的東西"}},required:["query"],additionalProperties:!1}),e("ref_define","補充或管理參考知識（持久保存在本機，離線訓練器與程式行為分析都立刻用到；可匯出給開發者升級成內建）。action:add（預設）時要給 kind 與 source（官方文件網址或文件名稱，沒有來源不收）。kind：error_code{system,code,name,message,note}、command{name,aliases,summary,synopsis,options[]}、option{command,flag,arg,desc}、pragma／clause{key,desc}、api{name,lang,summary,parameters,return}、note{name,note}、signature{category,names}、mnemonic{arch,category,name,description}、idiom{arch,pattern,name,template}、semantics／grammar_pattern／tokenizer／assembly／build_system{key,text,tags,rules}。其他 action：list、remove、export、export_builtin（輸出內建來源檔格式）、import、stats。",a(function(e){return this._refDefine(e)}),{type:"object",properties:{action:{type:"string"},kind:{type:"string"},type_kind:{type:"string",description:'kind:"knowledge_type" 註冊類型時：新類型的 kind（小寫英文＋底線）'},label:{type:"string"},schema:{type:"object",description:"註冊類型：{欄位名: {type,required,range,values,of,kind,extends,...}}"},version:{type:"number"},entry_kind:{type:"string"},text:{type:"string"},tags:{type:"array",items:{type:"string"}},customize:{type:"object",description:"帶 customize 的條目：結構由該 kind 註冊的類型 schema 決定"},force:{type:"boolean"},source:{type:"string",description:"來源：官方文件網址或文件名稱；使用者自己補的寫 user"},system:{type:"string"},code:{type:"string"},name:{type:"string"},message:{type:"string"},note:{type:"string"},aliases:{type:"array",items:{type:"string"}},summary:{type:"string"},synopsis:{type:"string"},options:{type:"array",items:{type:"object"}},command:{type:"string"},flag:{type:"string"},arg:{type:"string"},desc:{type:"string"},key:{type:"string"},text:{type:"string"},tags:{type:"array",items:{type:"string"}},rules:{type:"array",items:{type:"object"}},lang:{type:"string"},parameters:{type:"array",items:{type:"object"}},return:{type:"object"},category:{type:"string"},names:{type:"array",items:{type:"string"}},arch:{type:"string"},description:{type:"string"},pattern:{type:"array",items:{type:"string"}},template:{type:"string"},data:{}},additionalProperties:!0}),e("ref_types","列出已註冊的知識類型（內建與使用者／AI 註冊的）：kind、版本、欄位、條目數，以及知識資料格式版本。類型決定條目的 customize 欄位長什麼樣子（例如 visual_part、skeleton、motion、machine）。無參數。",a(function(){return this._refTypesList()}),{type:"object",properties:{},additionalProperties:!1}),e("ref_resolve",'遞迴展開一個知識條目：把它引用的其他條目（ref 欄位）換成實際內容，繼承（extends）先合併父條目，ref 可帶 as／set 覆寫；有深度上限與循環偵測。用來取得「完整的」定義（例如把 human-face 展開成含眼鼻嘴的完整樹）。參數：{"kind":"visual_part","key":"human-face","depth":8}',a(function(e){return this._refResolve(e)}),{type:"object",properties:{kind:{type:"string"},key:{type:"string"},depth:{type:"number",description:"展開深度上限（預設 8）"}},required:["kind","key"],additionalProperties:!1}),e("ref_validate","檢查整個知識庫的註冊類型與條目：類型定義是否合法、每個條目的 customize 是否符合類型的 schema、引用的條目是否存在、有沒有循環引用。無參數。",a(function(){return this._refValidateAll()}),{type:"object",properties:{},additionalProperties:!1}),e("ref_expand",'讓 AI 自己找資料擴充知識庫：委派給專用領域子代理（離線訓練器知識擴充，或 domain 含 aidoc 時用 AIDoc 行為說明擴充）：上網查官方文件、補錯誤碼／命令選項／API 語意／pragma／組合語言／文法／分詞／建置系統，每筆附來源，補完驗證並回報。參數：{"topic":"要擴充的主題"}',a(function(e){return this._refExpand(e)}),{type:"object",properties:{topic:{type:"string",description:"要擴充的主