yle="position:relative; width:28px; height:15px; border-radius:999px; background:#4b5563; display:inline-block; transition:background .15s;"><span id="ai-offline-knob" style="position:absolute; top:2px; left:2px; width:11px; height:11px; border-radius:50%; background:#fff; transition:left .15s;"></span></span><span id="ai-offline-label">線上</span></label><span id="ai-btn-clear-chat" title="清除對話" style="cursor:pointer; margin-right: 10px;">🗑️</span>\n                    <span id="ai-btn-config" style="cursor:pointer; margin-right: 10px;">⚙️</span>\n                    <span id="ai-btn-close" style="cursor:pointer;">❌</span>\n                </div>\n            </div>\n            <div id="ai-chat-body" style="flex:1; padding:15px; overflow-y:auto; background: ${a.chatBg}; color: ${a.chatText}; font-size: 14px;"></div>\n            <div id="ai-autocomplete-bar" style="background:${a.detailBg}; color:${a.detailText}; font-size:11px; padding:4px 12px; display:none; border-top:1px solid ${a.windowBorder};">\n                💡 按 <kbd style="background:#fff;padding:1px 3px;border:1px solid #ccc;border-radius:3px;">Tab</kbd> 自動補全: <span id="ai-suggest-text"></span>\n            </div>\n            <div id="ai-input-wrap" style="padding:10px; background:${a.windowBg}; border-top:1px solid ${a.windowBorder}; position:relative;">\n                <div id="ai-history-panel" style="display:none; position:absolute; left:10px; right:10px; bottom:100%; margin-bottom:6px; max-height:45vh; overflow-y:auto; background:${a.windowBg}; border:1px solid ${a.inputBorder}; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,0.25); z-index:20;"></div>\n                <div id="ai-slash-menu" style="display:none; position:absolute; left:10px; right:10px; bottom:100%; margin-bottom:6px; max-height:30vh; overflow-y:auto; background:${a.windowBg}; border:1px solid ${a.inputBorder}; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,0.25); z-index:21;"></div>\n                <div id="ai-pending-attachments" style="display:none; flex-wrap:wrap; gap:6px; margin-bottom:6px;"></div>\n                <input type="file" id="ai-attach-input" multiple style="display:none;">\n                <div style="display:flex; align-items:stretch; gap:6px;">\n                    <button id="ai-history-btn" type="button" title="歷史訊息（手機沒有上下鍵時可以用這個瀏覽/挑選之前輸入過的內容）" style="flex:0 0 auto; padding:0 10px; border:1px solid ${a.inputBorder}; border-radius:6px; background:${a.detailBg}; color:${a.detailText}; font-size:15px; cursor:pointer;">🕘</button>\n                    <button id="ai-attach-btn" type="button" title="附加檔案（AI 可以叫用檔案解讀能力讀取內容）" style="flex:0 0 auto; padding:0 10px; border:1px solid ${a.inputBorder}; border-radius:6px; background:${a.detailBg}; color:${a.detailText}; font-size:15px; cursor:pointer;">📎</button>\n                    <textarea id="ai-input-text" rows="2" placeholder="輸入訊息... (上下鍵選歷史, Tab補全)" style="flex:1; min-width:0; box-sizing:border-box; padding:8px; border:1px solid ${a.inputBorder}; border-radius:6px; resize:none; font-size:13px; font-family:inherit; background:${a.inputBg}; color:${a.inputText};"></textarea>\n                    <button id="ai-mic-btn" type="button" title="語音輸入（點一下開始錄音，再點一下停止並辨識）" style="display:none; flex:0 0 auto; padding:0 10px; border:1px solid ${a.inputBorder}; border-radius:6px; background:${a.detailBg}; color:${a.detailText}; font-size:15px; cursor:pointer;">🎤</button>\n                    <button id="ai-send-btn" type="button" title="送出 (Enter)" style="flex:0 0 auto; padding:0 14px; border:none; border-radius:6px; background:#76b900; color:#fff; font-size:13px; font-weight:bold; cursor:pointer;">送出</button>\n                </div>\n                <div style="margin-top:6px; display:flex; align-items:center; gap:8px;">\n                    <button id="ai-stop-response-btn" type="button" style="padding:2px 8px; border:1px solid ${a.inputBorder}; border-radius:999px; background:${a.detailBg}; color:${a.detailText}; font-size:11px; line-height:1.4;">⏹ Stop</button>\n                    <div id="ai-response-indicator" style="font-size:11px; color:${a.detailText};">✅ 已完成</div>\n                </div>\n            </div>\n            <div id="ai-status-log" style="background:${a.statusBg}; color:${a.statusText}; font-size:10px; padding:3px 10px; max-height:20px; overflow:auto;">系統就緒</div>\n            <div id="ai-advanced-modal" class="ai-advanced-overlay">\n                <div class="ai-advanced-dialog">\n                    <div class="ai-advanced-row">\n                        <h3 style="margin:0; color:#76b900;">Advance 設定</h3>\n                        <button type="button" id="ai-advanced-close" class="ai-advanced-btn">關閉</button>\n                    </div>\n                    <div class="ai-advanced-body">\n                        <div class="ai-advanced-sidebar" id="ai-advanced-sidebar">${this._buildAdvancedSettingsSidebarHtml()}</div>\n                        <div class="ai-advanced-splitter" id="ai-advanced-splitter" title="拖曳調整左邊欄的寬度（連點兩下回到預設）"></div>\n                        <div class="ai-advanced-content">\n                            <div class="ai-advanced-pane" data-pane="llm-basic">\n                                <div class="ai-advanced-stack">\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-hermes-evolve-chk" ${o?"checked":""} style="cursor:pointer;">\n                                        <label for="ai-hermes-evolve-chk" class="ai-advanced-label" style="margin:0; color:#8b5cf6; cursor:pointer;">開啟 RAG 本地條件圖譜自我演化</label>\n                                    </div>\n                                    <div style="margin-top:6px; display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-slash-menu-chk" ${!1!==this.advancedSettings.slashCommandMenuEnabled?"checked":""} style="cursor:pointer;">\n                                        <label for="ai-slash-menu-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">輸入框打「/」時顯示可用指令選單</label>\n                                    </div>\n                                    <div style="margin-top:6px; display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-dragdrop-skip-confirm-chk" ${!1!==this.advancedSettings.dragDropAttachSkipConfirm?"checked":""} style="cursor:pointer;">\n                                        <label for="ai-dragdrop-skip-confirm-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">拖曳檔案到畫面上直接加為附件，不再詢問確認</label>\n                                    </div>\n                                    <p class="ai-advanced-hint">關掉的話，拖曳檔案時會先跳出確認對話框（對話框裡也可以勾選「之後都不再詢問」，效果等同這裡）。拖到 /run-terminal 終端機視窗裡一律直接複製進沙盒檔案系統，不受這個開關影響。</p>\n                                    <div style="margin-top:6px; display:flex; align-items:center; gap:6px; flex-wrap:wrap;">\n                                        <input type="checkbox" id="ai-festival-chk" ${!1!==this.advancedSettings.festivalThemeEnabled?"checked":""} style="cursor:pointer;">\n                                        <label for="ai-festival-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">啟用台灣節慶套版（春節、元宵、端午、中秋、國慶、聖誕…依台灣行事曆自動換裝，連假期間都算同一個節慶）</label>\n                                        <span id="ai-festival-status" class="ai-advanced-hint" style="margin:0;"></span>\n                                    </div>\n                                    <p class="ai-advanced-hint">套版從 GitHub 的 festival-themes 分支下載（每個套版不超過 1MB，一天只抓一次，離線用本機快取）；越接近節日畫面越豐富（例如中秋前月亮從新月漸盈到滿月、春節前逐漸高掛鞭炮）。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-rules-input">RULES.md</label>\n                                    <textarea id="ai-rules-input" class="ai-advanced-textarea" placeholder="如果有內容，會附加到 system prompt 的開頭。"></textarea>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="llm-sampling">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-legacy-fallback-url">全域預設 API 網址（所有row的API URL留空時套用這個值）</label>\n                                    <div style="display:flex; gap:6px; align-items:center;">\n                                        <input type="text" id="ai-legacy-fallback-url" class="ai-advanced-input" style="flex:1; min-width:0;" placeholder="（未設定，退回內建預設 ${DEFAULT_LLM_API_URL}）">\n                                        <button type="button" id="ai-legacy-fallback-url-clear-btn" class="ai-advanced-btn danger" style="flex:0 0 auto; padding:2px 10px;">清除</button>\n                                    </div>\n                                    <p class="ai-advanced-hint">這是舊版單一組設定留下來的全域退回值（跟下面每一筆row各自的API URL欄位不同——row自己填了API URL就完全不會用到這個，只有row的API URL留空時才會退回這裡）。<b>如果匯入設定檔之後模型突然全部打不通，先來這裡檢查</b>：這個值有沒有被改成不該出現在目前環境的網址（例如桌面版本地proxy專用、開頭是127.0.0.1的暫時網址——那種網址離開產生它的那個桌面app就完全連不通）；發現不對就按「清除」，之後所有API URL留空的row會退回上面說的內建預設。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <label class="ai-advanced-label" style="margin:0;">Model 清單（拖曳⠿調整fallback順序）</label>\n                                        <button type="button" id="ai-model-row-add-btn" class="ai-advanced-btn primary">+ 新增 Model</button>\n                                    </div>\n                                    <p class="ai-advanced-hint">每一筆代表一個獨立的model/llm，由上到下就是自動fallback的嘗試順序（拖曳⠿把手調整；同一輪對話一開始一律先試第一筆，遇到該模型404才依序往下換）。<b>API URL／API Key留空＝走我們預設的網址／金鑰</b>，只有Model Name是必填；溫度/懲罰參數/max tokens留空＝套用下面「全域預設」。Model Name以「openrouter/」開頭時，會改經Cloudflare Worker的/openrouter路由轉去OpenRouter（不是直接從瀏覽器打openrouter.ai），需要該Worker已部署/openrouter路由並設定OPENROUTER_API_KEY（或OPENROUTER_API_KEY_DEFAULT）密鑰才能真正運作，路由實作細節見你自己部署的Cloudflare Worker原始碼。</p>\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-model-grouping-enabled-chk" style="cursor:pointer;">\n                                        <label for="ai-model-grouping-enabled-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">啟用自動分群（相同API URL+Model Name、不同API Key的row自動round-robin輪流用）</label>\n                                    </div>\n                                    <p class="ai-advanced-hint">關掉後每一筆row一律各自獨立，即使API URL+Model Name完全相同也不會被合併分組。開啟時符合的row會在下面各自顯示「🔗 群組N」標記；「API URL」比對時結尾的斜線差異會被忽略，但其餘字元（含大小寫）必須完全一致才會被視為同一組。</p>\n                                    <div id="ai-model-rows-list"></div>\n                                    <datalist id="ai-model-datalist">\n                                        ${this._modelDatalistOptionsHtml()}\n                                    </datalist>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-gen-context-window">模型上下文視窗（tokens，僅供參考顯示；實際壓縮時機由伺服器400/413回應觸發，不是靠這個數字主動估算）</label>\n                                    <input type="number" min="512" step="512" id="ai-gen-context-window" class="ai-advanced-input">\n                                    <p class="ai-advanced-hint">全域預設取樣參數（上面的model row本身留空的欄位會套用這裡；留空＝不送這個欄位；若被伺服器拒絕會自動排除並在對話中記錄）：</p>\n                                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px 8px;">\n                                        ${SAMPLING_PARAM_KEYS.map(e=>`\n                                            <div>\n                                                <label style="display:block; font-size:10px; margin-bottom:2px;" for="ai-param-${e}">${e}</label>\n                                                <input type="number" step="${"reasoning_budget"===e?"1":"0.1"}" id="ai-param-${e}" class="ai-advanced-input">\n                                            </div>\n                                        `).join("")}\n                                        ${STRING_SAMPLING_PARAM_KEYS.map(e=>`\n                                            <div>\n                                                <label style="display:block; font-size:10px; margin-bottom:2px;" for="ai-param-${e}">${e}</label>\n                                                <select id="ai-param-${e}" class="ai-advanced-input">\n                                                    ${REASONING_EFFORT_OPTIONS.map(e=>`<option value="${e}">${e||"（不送）"}</option>`).join("")}\n                                                </select>\n                                            </div>\n                                        `).join("")}\n                                    </div>\n                                    <div id="ai-param-disabled-note" style="font-size:10px; color:#dd6b20; margin-top:6px;"></div>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="llm-debug">\n                                <div class="ai-advanced-stack">\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-show-trace-chk" ${!0===this.advancedSettings.showInternalTrace?"checked":""} style="cursor:pointer;">\n                                        <label for="ai-show-trace-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">顯示工具呼叫追蹤與思考過程</label>\n                                    </div>\n                                    <p class="ai-advanced-hint">預設隱藏，圖片結果不受影響。開啟後，除了主對話的工具呼叫/思考過程，委派給子Agent（delegate_to_subagent，不管是明確指定domain、自動路由、還是兩層領域路由）執行期間也會多顯示一張即時更新的進度卡片（判斷委派給哪個領域、每一輪呼叫了哪個工具、有沒有中途申請追加工具），方便觀察子Agent在忙什麼；關閉時子Agent一律維持完全靜默，跟這個設定新增前的行為一致。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <div style="display:flex; align-items:center; justify-content:space-between; gap:6px;">\n                                        <label class="ai-advanced-label" style="margin:0;">🌐 網路請求診斷記錄</label>\n                                        <button type="button" id="ai-network-debug-clear-btn" class="ai-advanced-btn">清除記錄</button>\n                                    </div>\n                                    <p class="ai-advanced-hint">每一輪送出的請求實際觀察到的事實（HTTP狀態／finish_reason／耗時／收到的字數／是不是完全空白／連線例外訊息），即時更新，最多保留最近50筆。遇到「端點完全沒有回應任何內容」時可以直接來這裡看最後幾筆的實際狀況，不用只憑那句警告文字猜。</p>\n                                    <div id="ai-network-debug-list" style="max-height:220px; overflow-y:auto; font-family:monospace; font-size:11px; background:${a.detailBg}; color:${a.detailText}; border:1px solid ${a.inputBorder}; border-radius:6px; padding:6px 8px;"></div>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="input">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">語音輸入（麥克風）</label>\n                                    <p class="ai-advanced-hint">在輸入框旁邊加一個🎤按鈕，按一下開始錄音、再按一下停止並轉成文字填回輸入框（不會自動送出，你可以先看過再修改）。用瀏覽器端的Whisper模型辨識，跟 transcribe_media 共用同一份模型/快取，第一次使用會下載約77MB（之後不用重複下載），會另外跳出確認框說明；需要瀏覽器的麥克風權限。</p>\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-voice-input-enabled-chk" style="cursor:pointer;">\n                                        <label for="ai-voice-input-enabled-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">啟用語音輸入</label>\n                                    </div>\n                                    <label class="ai-advanced-label" for="ai-voice-input-lang" style="font-weight:normal; margin-top:8px;">說話語言</label>\n                                    <select id="ai-voice-input-lang" class="ai-advanced-input">\n                                        <option value="zh">中文</option>\n                                        <option value="en">English</option>\n                                        <option value="auto">自動偵測</option>\n                                    </select>\n                                    <p class="ai-advanced-hint">告訴Whisper模型你講的是哪種語言，幫助辨識準確度——不是翻譯，辨識出來的文字語言會跟你實際講的語言一致（選中文、講中文，辨識結果就是中文；選English、講英文，結果就是英文原文，不會被翻譯成中文）。「自動偵測」讓模型自己判斷，通常準確度會比明確指定語言稍低。</p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="functions">\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <label class="ai-advanced-label" for="ai-custom-functions-input" style="margin:0;">Customize Functions (JavaScript, private for AI)</label>\n                                        <button type="button" id="ai-custom-functions-example-btn" class="ai-advanced-btn">範例</button>\n                                    </div>\n                                    ${this._buildCodeEditorHtml("ai-custom-functions-input",240)}\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <div class="ai-advanced-label" style="margin:0;">AI自製函式 (FromAI)</div>\n                                        <button type="button" id="ai-fn-manage-btn" class="ai-advanced-btn primary">管理AI自製函式</button>\n                                    </div>\n                                    <p class="ai-advanced-hint">由AI透過 add_ai_function 工具建立、或你自己手動新增的函式，儲存於 FloatingAssistant.FromAI，可被 call_ai_function 工具呼叫。</p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="skills">\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <div class="ai-advanced-label" style="margin:0;">🏛️ 內建 Domain：程式設計（評估／設計／實作／測試／發佈）</div>\n                                        <label style="display:inline-flex; align-items:center; gap:6px; font-size:13px; cursor:pointer;">\n                                            <input type="checkbox" id="ai-coding-domain-enabled">啟用\n                                        </label>\n                                    </div>\n                                    <p class="ai-advanced-hint">跟Skill Bundle是不同機制（這是app內建、有固定流程狀態機的coding domain，不是靠這裡的技能包/自訂工具堆出來），放在這裡是方便你統一管理啟用/停用。停用後AI不會再把程式設計任務委派給這個domain。</p>\n                                    <label class="ai-advanced-label" for="ai-coding-publish-mode">發佈偏好（測試通過、commit完成後）</label>\n                                    <select id="ai-coding-publish-mode" class="ai-advanced-input">\n                                        <option value="ask">先問我要不要push（預設，較安全）</option>\n                                        <option value="auto">自動push，不用每次問</option>\n                                    </select>\n                                    <p class="ai-advanced-hint">不論這裡選哪個，會把東西發佈到正式環境/外部服務的deploy類指令一律會先列出內容等你確認，不受這個設定影響——只有「commit完成後要不要接著push」這一步會照這裡的偏好走。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <div class="ai-advanced-label" style="margin:0;">技能包（Skill Bundle）</div>\n                                        <button type="button" id="ai-skill-bundle-add-btn" class="ai-advanced-btn primary">+ 新增技能包</button>\n                                    </div>\n                                    <p class="ai-advanced-hint">把蒸餾出來的模型知識/風格（例如「GPT Codex風格的coding skill」）寫成一段知識/人設文字，委派給這個技能包時，子agent會真正「扮演」具備這份知識的角色回答，不只是掛幾個工具。每個技能包各自是一個獨立的委派領域（domain），AI可以自動判斷該用哪一個、或你在對話裡明確指定。下面「Skill（自訂工具）」清單裡的每個工具都可以指定歸屬到某個技能包（編輯工具時選擇），沒有指定的工具維持「未分類」，用同一套委派機制但不帶任何知識/人設。</p>\n                                    <div id="ai-skill-bundle-list" class="ai-tool-list"></div>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <div class="ai-advanced-label" style="margin:0;">Skill（自訂工具 / Custom Tools）</div>\n                                        <div style="display:flex; gap:8px; flex-wrap:wrap;">\n                                            <button type="button" id="ai-tool-add-btn" class="ai-advanced-btn primary">新增 Skill</button>\n                                            <button type="button" id="ai-skill-export-btn" class="ai-advanced-btn">匯出 .skill</button>\n                                            <label class="ai-advanced-btn" style="cursor:pointer; display:inline-flex; align-items:center;">匯入 .skill<input type="file" id="ai-skill-import-input" accept=".skill,.zip" style="display:none;"></label>\n                                            <button type="button" id="ai-skill-import-folder-btn" class="ai-advanced-btn">從資料夾匯入</button>\n                                        </div>\n                                    </div>\n                                    <p class="ai-advanced-hint">每個Skill會自動註冊成同名的slash指令（例如Skill叫「my_skill」，輸入框直接打「/my_skill 參數」即可跳過AI判斷、直接本地執行，也會出現在「/」自動完成選單裡）——如果名稱撞到既有指令，既有的優先，這個Skill仍然只能靠AI自己判斷呼叫。這些Skill不會直接出現在主對話的工具清單裡，AI需要用到時會透過委派機制交給專門的子Agent查詢/呼叫——這樣Skill累積再多也不會拖慢/污染主對話。</p>\n                                    <div id="ai-custom-tool-list" class="ai-tool-list"></div>\n                                </div>\n                            </div>\n                            <div id="ai-skill-bundle-editor-modal" class="ai-advanced-overlay">\n                                <div class="ai-advanced-dialog" style="width:min(860px, 94vw);">\n                                    <div class="ai-advanced-row">\n                                        <h3 style="margin:0; color:#76b900;">編輯技能包知識/人設</h3>\n                                        <button type="button" id="ai-skill-bundle-editor-close" class="ai-advanced-btn">關閉</button>\n                                    </div>\n                                    <div class="ai-advanced-stack">\n                                        <label class="ai-advanced-label" for="ai-skill-bundle-name-input">名稱</label>\n                                        <input id="ai-skill-bundle-name-input" class="ai-advanced-input" type="text">\n                                    </div>\n                                    <div class="ai-advanced-stack">\n                                        <label class="ai-advanced-label" for="ai-skill-bundle-persona-input">知識 / 人設（子agent會被要求完全依照這份內容扮演回答）</label>\n                                        <textarea id="ai-skill-bundle-persona-input" class="ai-advanced-textarea" style="min-height:260px; font-family:monospace;" placeholder="例如：你精通Python/TypeScript，寫程式風格參考GPT Codex：偏好簡潔、有型別註記、附上單元測試範例……"></textarea>\n                                    </div>\n                                    <div class="ai-advanced-footer">\n                                        <span style="font-size:12px; color:#94a3b8;">留空的話，這個技能包只靠掛載的工具運作，不會有額外的知識/人設。</span>\n                                        <div style="display:flex; gap:8px; flex-wrap:wrap;">\n                                            <button type="button" id="ai-skill-bundle-editor-cancel" class="ai-advanced-btn">取消</button>\n                                            <button type="button" id="ai-skill-bundle-editor-save" class="ai-advanced-btn primary">儲存</button>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="rag">\n                                <div class="ai-advanced-stack">\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-rag-enabled-chk" style="cursor:pointer;">\n                                        <label for="ai-rag-enabled-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">啟用 RAG（只當離線訓練器的養分）</label>\n                                    </div>\n                                    <p class="ai-advanced-hint">2026-10-15 起，RAG 不再插進 AI 的思考（不會每一輪自動「喚醒」記憶，也沒有 rag_lookup 領域可以讓 AI 查），避免舊的、不相關的內容誤導 AI。這裡的知識只當「離線訓練器」的養分：離線模式（沒有 AI 時）回答、挑做法時會把 RAG 當作參考資料。勾選＝讓離線訓練器可以用這份知識；不勾＝不用。</p>\n                                    <p class="ai-advanced-hint">語意檢索預設用內建的TF-IDF近似算法（免費、免設定，純字面詞頻比對）。如果在「LLM Model 管理」分頁把某一筆model標記成🧬 Embedding，這裡的檢索會改成優先呼叫那個模型的/embeddings端點取得真正的語意向量，理解同義詞/相近語意的能力會好上不少；沒標記、或呼叫當下失敗，會自動退回TF-IDF，不影響RAG照常運作。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-label" style="margin:0;">RAG 條件與依賴關係知識庫</div>\n                                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">\n                                        <input id="ai-rag-search-input" class="ai-advanced-input" type="text" placeholder="關鍵字搜尋或節點 ID..." style="flex:1; min-width:160px;">\n                                        <button type="button" id="ai-rag-search-btn" class="ai-advanced-btn">搜尋</button>\n                                        <button type="button" id="ai-rag-query-btn" class="ai-advanced-btn">圖譜語意檢索</button>\n                                        <button type="button" id="ai-rag-add-btn" class="ai-advanced-btn primary">新增節點</button>\n                                    </div>\n                                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">\n                                        <label style="font-size:12px; color:#94a3b8; display:flex; align-items:center; gap:4px; cursor:pointer;">\n                                            <input type="checkbox" id="ai-rag-select-all"> 全選\n                                        </label>\n                                        <button type="button" id="ai-rag-delete-selected-btn" class="ai-advanced-btn danger">刪除選取</button>\n                                        <button type="button" id="ai-rag-export-btn" class="ai-advanced-btn">匯出資料</button>\n                                        <label class="ai-advanced-btn" style="cursor:pointer; display:inline-flex; align-items:center;">\n                                            匯入資料<input type="file" id="ai-rag-import-input" accept=".json" style="display:none;">\n                                        </label>\n                                        <span id="ai-rag-status" style="font-size:11px; color:#94a3b8; margin-left:4px;"></span>\n                                    </div>\n                                    <div class="ai-rag-table-wrap">\n                                        <table class="ai-rag-table">\n                                            <thead>\n                                                <tr>\n                                                    <th style="width:32px;"></th>\n                                                    <th style="width:120px;">節點 ID</th>\n                                                    <th>內文 (含自動依賴與先決條件標記)</th>\n                                                    <th style="width:70px;">相關度</th>\n                                                    <th style="width:90px;">來源</th>\n                                                    <th style="width:150px;">時間</th>\n                                                </tr>\n                                            </thead>\n                                            <tbody id="ai-rag-table-body"></tbody>\n                                        </table>\n                                    </div>\n                                    <p class="ai-advanced-hint">雙擊節點內文行可編輯其依賴與先決條件。設定格式：<code>tags; deps:node_a,node_b; conds:環境==WebGPU</code></p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="file-access">\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <div class="ai-advanced-label" style="margin:0;">檔案存取管理（File Access Point）</div>\n                                        <button type="button" id="ai-fap-add-btn" class="ai-advanced-btn primary">+ 新增資料夾</button>\n                                    </div>\n                                    <p class="ai-advanced-hint">把電腦上一個真實資料夾的讀寫權限授權給AI（File System Access API）。AI可以用<code>list_file_access_points</code>/<code>fap_list_files</code>/<code>fap_read_file</code>/<code>fap_write_file</code>/<code>fap_find_file</code>這幾個工具操作純文字內容，你自己也可以用 <code>/fap-list</code> <code>/fap-read</code> <code>/fap-find</code> 斜線指令直接瀏覽——這是跟AI產生/你透過📎上傳的檔案（persistentStorage）完全獨立的另一套系統，兩邊不會混在一起、也不會互相看到彼此。**任何格式的二進位檔案**（MP3/MP4/xlsx/pdf/pptx/圖片等）可以用<code>fap_copy_from_storage</code>／<code>fap_copy_to_storage</code>在兩套系統之間搬動（複製或移動），或用<code>fap_download_url</code>直接把一個網址的內容下載進來（受目標網站CORS限制，不是每個網址都抓得到）。授權會存在瀏覽器本機、盡量記住，但瀏覽器可能因為太久沒用而要求重新授權——不用特地跑來這裡點，AI下次要用到時會直接在畫面上跳一個小視窗讓你當場點擊同意；這裡的「重新授權」按鈕留著給你想主動先授權好、不想等AI用到時才處理的情況。⚠️目前只有 Chrome/Edge 支援這個功能；寫入是真正的磁碟寫入，請只授權你信任AI去動的資料夾。</p>\n                                    <div id="ai-fap-list" class="ai-tool-list"></div>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="git">\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <div class="ai-advanced-label" style="margin:0;">git版本控制（clone / pull / commit / push）</div>\n                                    </div>\n                                    <p class="ai-advanced-hint">AI可以用<code>git_clone</code>/<code>git_pull</code>/<code>git_status</code>/<code>git_log</code>/<code>git_commit</code>/<code>git_push</code>對上面已授權的File Access Point資料夾做git操作（純瀏覽器JS實作，不需要安裝git）。因為瀏覽器直接對GitHub發請求會被CORS擋下，一定要透過一個部署了<code>/git-proxy</code>路由的Cloudflare Worker中繼——留空會沿用你AI端點目前的網址，如果那個端點背後沒有部署這條路由，git操作會連線失敗。公開repo唯讀clone/pull不需要token；私有repo、以及任何repo的push，都需要下面填入你自己的GitHub Personal Access Token（只存在你自己瀏覽器本機，不會被上傳）。</p>\n                                    <label class="ai-advanced-label" for="ai-git-cors-proxy-url">git corsProxy網址（留空＝沿用目前AI端點網址）</label>\n                                    <input type="text" id="ai-git-cors-proxy-url" class="ai-advanced-input" placeholder="https://your-worker.workers.dev">\n                                    <label class="ai-advanced-label" for="ai-git-token">GitHub Personal Access Token（私有repo/push才需要）</label>\n                                    <input type="password" id="ai-git-token" class="ai-advanced-input" placeholder="ghp_...">\n                                    <label class="ai-advanced-label" for="ai-git-author-name">commit作者名稱</label>\n                                    <input type="text" id="ai-git-author-name" class="ai-advanced-input" placeholder="例如：sunneo">\n                                    <label class="ai-advanced-label" for="ai-git-author-email">commit作者信箱</label>\n                                    <input type="text" id="ai-git-author-email" class="ai-advanced-input" placeholder="例如：you@example.com">\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="image-gen">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">圖像生成（generate_image／/image）</label>\n                                    <button type="button" id="ai-imggen-open" class="ai-advanced-btn">⚙ 開啟圖像生成設定</button>\n                                    <p class="ai-advanced-hint">線上金鑰與模型、本機小模型（下載／刪除）、提示詞範本（自己的畫風、品質詞、負面詞）都在這個設定視窗裡；在對話裡打 /image 也有同一個 ⚙ 按鈕。</p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="office">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">文件撰寫（/user-guide、/design-guide）</label>\n                                    <button type="button" id="ai-docgen-open" class="ai-advanced-btn">⚙ 開啟文件撰寫設定</button>\n                                    <p class="ai-advanced-hint">預設輸出格式與語言、內建範本一覽、自己的範本（章節順序、自訂章節）都在這個設定視窗裡；在對話裡打 /user-guide 或 /design-guide 也有同一個 ⚙ 按鈕。</p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="youtube">\n                                <div class="ai-advanced-stack">\n                                    <div class="ai-advanced-tools-header">\n                                        <div class="ai-advanced-label" style="margin:0;">YouTube下載（youtube_download工具）</div>\n                                    </div>\n                                    <p class="ai-advanced-hint">AI可以用<code>youtube_download</code>（或直接打<code>/media-youtube-download</code>）解析貼上的文字裡的YouTube連結並下載。**這兩個欄位是選填**——留空可以直接下載任何影片；填了才會啟用範圍限制：**只允許下載你自己頻道的影片，或YouTube授權欄位標示為Creative Commons的影片**，其餘一律跳過並說明原因。金鑰請到<a href="https://console.cloud.google.com/apis/library/youtube.googleapis.com" target="_blank" rel="noopener">Google Cloud Console</a>免費申請YouTube Data API v3金鑰；頻道ID是你自己YouTube頻道的ID（在YouTube工作室的「設定→頻道→進階設定」可以查到，用來比對影片上傳者是不是你本人）。⚠️已知限制：YouTube目前對多數影片會要求PO Token（另一套反機器人驗證，這個app還沒實作），實測很多影片會下載失敗、只剩縮圖格式可用。</p>\n                                    <label class="ai-advanced-label" for="ai-youtube-api-key">YouTube Data API金鑰</label>\n                                    <input type="password" id="ai-youtube-api-key" class="ai-advanced-input" placeholder="AIza...">\n                                    <label class="ai-advanced-label" for="ai-youtube-channel-id">我的YouTube頻道ID</label>\n                                    <input type="text" id="ai-youtube-channel-id" class="ai-advanced-input" placeholder="UC...">\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="subagent">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-multi-subagent-mode">多重子Agent模式</label>\n                                    <select id="ai-multi-subagent-mode" class="ai-advanced-input">\n                                        <option value="router">1. Orchestrator + 多領域子Agent（兩層委派）</option>\n                                        <option value="full">2. Orchestrator + 認識全部工具的子Agent + 多領域子Agent（預設）</option>\n                                        <option value="off">3. 不使用子Agent（全部內建工具直接掛在根層級）</option>\n                                        <option value="hierarchical">4. Orchestrator + 兩層領域路由（先選類別、再選細分domain）</option>\n                                        <option value="intent">5. Orchestrator + 意圖過濾 + 多領域子Agent（只送跟這句話有關的工具，自我調整、不打擾使用者）</option>\n                                    </select>\n                                    <p class="ai-advanced-hint">\n                                        <b>模式1（router）</b>：根層級對話只看得到自己註冊的工具＋委派入口，不知道有哪些領域可選；不確定要委派給誰時，系統會先問一個「認識全部工具」的路由子Agent該開放哪些領域，再把任務交給真正執行的子Agent——每次委派多一輪內部LLM往返，但根層級system prompt/tools每輪對話都精簡。<br>\n                                        <b>模式2（full）</b>：根層級直接看得到全部領域代號+說明，可以自己判斷、直接指定領域委派（省掉路由子Agent那一輪往返）；代價是根層級system prompt/tools每輪對話都多背一份領域清單。<br>\n                                        <b>模式3（off）</b>：完全不透過子Agent委派，全部內建工具（AI自製函式/RAG/檔案解讀/3D場景/繪圖/互動viewer/2D動畫/網路搜尋）直接掛在根層級對話——最簡單、沒有委派往返，但根層級system prompt/tools會攤開全部工具的完整說明，工具越多越容易稀釋模型注意力。<br>\n                                        <b>模式4（hierarchical）</b>：委派時先問「這個任務屬於哪個大類別」，選中的類別再各自問一次「該用哪個細分領域」，比模式1多一輪網路往返——<b>domain數量不多時不建議用</b>（用真實測試量到的數字：45個domain時比模式1省58%路由token、但延遲多6-7秒，是拿延遲換規模化時的token效率跟準確度）；只有像大量曲風/風格這種domain數上百時才划算。domain完全沒有被分類別時會自動退回跟模式1一樣的行為，不會多花這次往返。<br>\n                                        <b>模式5（intent）</b>：每一輪先用程式（不呼叫模型）比對這句話的意圖，根層級只送「跟這句話有關的工具」的完整說明，其他工具只留名稱清單；委派時留空domain，也是先用本地意圖比對挑出最多3個領域（橫跨多個就一起開放），沒把握才交給路由模型。<b>自己會修正、不會回頭問你</b>：模型直接叫了沒列出的工具就當場補進來並記住這種說法；查工具細節、說「沒有這個工具」、子Agent缺工具或領域選錯，都靜默放寬再做一次，不會用提問打斷你。適合工具很多、每輪常駐說明太肥的情況。<br>\n                                        五種模式可以隨時切換，立即生效，不用重新整理頁面。\n                                    </p>\n                                </div>\n                                <div class="ai-advanced-stack" id="ai-agent-model-config"></div>\n                                <div class="ai-advanced-stack">\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-browser-search-enabled-chk" style="cursor:pointer;">\n                                        <label for="ai-browser-search-enabled-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">啟用「網路搜尋」子Agent（browser_search）</label>\n                                    </div>\n                                    <p class="ai-advanced-hint">查詢Wikipedia／StackOverflow／GitHub／一般網頁／SourceForge／CodeProject／DeepWiki，結果透過下面設定的Cloudflare Worker端點取得並正規化，快取1天（跟檔案快取一樣是IndexedDB持久化＋LRU容量淘汰，額外疊加1天有效期限）。預設關閉——需要Worker有部署支援/browser-search路由（見你自己部署的Cloudflare Worker原始碼）才能真正運作。</p>\n                                    <label class="ai-advanced-label" for="ai-browser-search-proxy-url">Cloudflare Worker 端點網址</label>\n                                    <input type="text" id="ai-browser-search-proxy-url" class="ai-advanced-input" placeholder="留空＝沿用上面的API URL">\n                                    <p class="ai-advanced-hint">留空時會直接沿用目前設定的LLM API URL（如果那個Worker本身也有部署/browser-search路由的話，不需要另外填）；只有想用「跟LLM不同的另一個」Worker端點時才需要在這裡明確指定。</p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="domains">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-primary-domain-preference">主Domain偏好</label>\n                                    <select id="ai-primary-domain-preference" class="ai-advanced-input"></select>\n                                    <p class="ai-advanced-hint">設定後同時影響兩件事：(1) 委派時的路由權重——任務同時符合多個領域、界線不明確時優先偏向這個領域；(2) 回應風格——跟這個領域相關的任務，AI會優先寫檔案/實際操作，不會只把程式碼或結果貼在對話文字裡當作答案。留空＝沒有偏好（預設，不影響任何行為）。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <div style="display:flex; align-items:center; justify-content:space-between;">\n                                        <label class="ai-advanced-label" style="margin:0;">目前的Domain（委派/路由的專家領域）</label>\n                                        <button type="button" id="ai-domain-add-btn" class="ai-advanced-btn">+ 新增Domain</button>\n                                    </div>\n                                    <p class="ai-advanced-hint">內建domain（含host自己註冊的，例如桌面版的desktop_ops）不提供修改/刪除，只能檢視描述/工具清單、或關閉啟用；使用者自建的domain可以自由編輯/刪除。</p>\n                                    <div id="ai-domain-list"></div>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">AI Dry Run：模擬路由結果</label>\n                                    <p class="ai-advanced-hint">輸入一個假設性的任務描述，看看目前這個LLM model會路由到哪個/哪些domain、理由是什麼——不會真的執行任何工具，純粹模擬路由判斷。</p>\n                                    <textarea id="ai-domain-dryrun-input" class="ai-advanced-textarea" style="min-height:60px;" placeholder="例如：幫我讀取D槽的一份Excel報表並整理成摘要"></textarea>\n                                    <button type="button" id="ai-domain-dryrun-btn" class="ai-advanced-btn">🔬 模擬路由</button>\n                                    <div id="ai-domain-dryrun-result" class="ai-advanced-hint" style="white-space:pre-wrap; margin-top:6px;"></div>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="multimedia">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">影音處理子Agent（transcribe_media／extract_audio）</label>\n                                    <p class="ai-advanced-hint">影片/音檔的語音轉文字、擷取聲音，全部在瀏覽器端執行、不上傳。Whisper 模型（約 77MB）首次使用時從 HuggingFace 下載、瀏覽器自動快取。</p>\n                                    <label class="ai-advanced-label" for="ai-extract-audio-format" style="font-weight:normal;">擷取聲音：輸出格式</label>\n                                    <select id="ai-extract-audio-format" class="ai-advanced-input">\n                                        <option value="mp3">MP3（預設，省空間，約是WAV的1/5~1/6）</option>\n                                        <option value="wav">WAV（無損，檔案較大）</option>\n                                    </select>\n                                    <label class="ai-advanced-label" for="ai-whisper-device" style="font-weight:normal; margin-top:8px;">運算裝置（跟「離線模型管理」是同一個設定）</label>\n                                    <select id="ai-whisper-device" class="ai-advanced-input">\n                                        <option value="auto">偏好 GPU（有 WebGPU 先用，不支援或失敗自動降級 CPU）</option>\n                                        <option value="cpu">只用 CPU</option>\n                                    </select>\n                                    <label class="ai-advanced-label" for="ai-whisper-threads" style="font-weight:normal; margin-top:8px;">CPU 核心上限（跟「離線模型管理」是同一個設定；Whisper、離線圖像轉文字共用）</label>\n                                    <input type="number" id="ai-whisper-threads" class="ai-advanced-input" min="1" max="64" step="1">\n                                    <p class="ai-advanced-hint">CPU 路徑請求的執行緒數。要真的多執行緒，頁面必須是 cross-origin isolated（SharedArrayBuffer）；目前不是的話只會用 1 個，「離線模型管理」分頁會顯示實際值。</p>\n                                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:4px;">\n                                        <span class="ai-advanced-hint" style="margin:0;">模型快取占用：<b id="ai-whisper-cache-size">—</b></span>\n                                        <button type="button" id="ai-whisper-cache-refresh" class="ai-advanced-btn" style="padding:2px 8px;">重新整理</button>\n                                        <button type="button" id="ai-whisper-cache-clear" class="ai-advanced-btn danger" style="padding:2px 8px;">清除模型快取</button>\n                                    </div>\n                                    <label class="ai-advanced-label" for="ai-subtitle-size" style="font-weight:normal; margin-top:8px;">燒錄字幕：字級（占影片高度比例）</label>\n                                    <input type="number" id="ai-subtitle-size" class="ai-advanced-input" min="0.02" max="0.15" step="0.005">\n                                    <label class="ai-advanced-label" for="ai-subtitle-position" style="font-weight:normal; margin-top:4px;">燒錄字幕：位置</label>\n                                    <select id="ai-subtitle-position" class="ai-advanced-input">\n                                        <option value="bottom">畫面下方</option>\n                                        <option value="top">畫面上方</option>\n                                    </select>\n                                    <p class="ai-advanced-hint">字級 0.052 大約是常見影片字幕的大小；1080p 影片就是約 56px。其餘外觀（白字黑邊、半透明底、置中換行）用內建預設。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-perf-max-mesh-triangles">匯入3D模型三角形數量上限</label>\n                                    <input type="number" id="ai-perf-max-mesh-triangles" class="ai-advanced-input" min="0" step="1">\n                                    <p class="ai-advanced-hint">STL/OBJ/3MF/FBX匯入時的三角形數量上限，超過會被拒絕；填 0 代表不限制（掃描級/CAD高面數模型也會嘗試匯入，可能拖慢畫面）。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-perf-mp4-duration">匯出MP4影片預設秒數</label>\n                                    <input type="number" id="ai-perf-mp4-duration" class="ai-advanced-input" min="1" step="1">\n                                    <p class="ai-advanced-hint">3D場景/2D動畫匯出MP4時的預設總秒數（沒有上限，數字越大匯出越慢、檔案也越大），匯出當下仍會跳出視窗讓你臨時調整這次要匯出多長。</p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="voice">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">語音合成子Agent（text_to_speech）—— 本地英文語音</label>\n                                    <p class="ai-advanced-hint">Kokoro TTS 模型，瀏覽器端執行、不上傳文字，只支援英文。模型本體（約90MB）首次使用時下載；選好預設語音後，第一次實際使用 text_to_speech 時會自動下載該語音（約522KB），不用另外手動安裝——下面直接點「試聽」就會下載並播放。</p>\n                                    <label class="ai-advanced-label" for="ai-tts-default-voice" style="font-weight:normal;">預設語音</label>\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <select id="ai-tts-default-voice" class="ai-advanced-input" style="flex:1; min-width:0;"></select>\n                                        <button type="button" id="ai-tts-preview-btn" class="ai-advanced-btn" style="padding:4px 10px; flex:0 0 auto; white-space:nowrap;">🔊 試聽</button>\n                                    </div>\n                                    <div id="ai-tts-preview-player-slot"></div>\n                                    <label class="ai-advanced-label" for="ai-tts-default-speed" style="font-weight:normal; margin-top:8px;">語速</label>\n                                    <div style="display:flex; align-items:center; gap:8px;">\n                                        <input type="range" id="ai-tts-default-speed" min="0.5" max="2" step="0.05" style="flex:1;">\n                                        <span id="ai-tts-default-speed-label" style="font-size:12px; min-width:42px; text-align:right;">1.00x</span>\n                                    </div>\n                                    <p class="ai-advanced-hint">1.0＝正常速度。套用在下面的試聽，也是AI呼叫text_to_speech沒指定speed參數時的預設語速。</p>\n                                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:8px;">\n                                        <span class="ai-advanced-hint" style="margin:0;">語音合成模型占用：<b id="ai-tts-model-cache-size">—</b></span>\n                                        <button type="button" id="ai-tts-model-cache-refresh" class="ai-advanced-btn" style="padding:2px 8px;">重新整理</button>\n                                        <button type="button" id="ai-tts-model-cache-clear" class="ai-advanced-btn danger" style="padding:2px 8px;">清除模型快取</button>\n                                    </div>\n                                    <div id="ai-tts-voice-list" class="ai-advanced-hint" style="margin-top:6px; display:flex; flex-direction:column; gap:4px;"></div>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">語音合成子Agent —— 中文語音（API 轉接）</label>\n                                    <p class="ai-advanced-hint">中文/粵語/日文/韓文語音走 Microsoft Edge 免費神經網路語音，透過你部署的 Cloudflare Worker 的 /edge-tts 路由轉接（見你自己部署的Cloudflare Worker原始碼的README說明）。⚠️跟上面的本地英文語音不同——啟用後，text_to_speech 念中文時文字會離開瀏覽器、送到你設定的 Worker（再送到 Microsoft），不是純本機處理。</p>\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-tts-zh-fallback-chk" style="cursor:pointer;">\n                                        <label for="ai-tts-zh-fallback-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">當線上語音失效改用Kokoro Chinese本地模型</label>\n                                    </div>\n                                    <p class="ai-advanced-hint">下面的中文／其他語言語音（線上轉接）失敗或被關掉時，改用 Kokoro 自己的國語聲音（曉曉、雲希…）在這台電腦的瀏覽器裡念——繁體、簡體文字都可以，文字不會離開這台電腦。第一次用要下載語音模型（約 90MB）與一個約 0.5MB 的語音包。</p>\n                                    <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">\n                                        <label class="ai-advanced-label" for="ai-tts-zh-local-voice" style="margin:0; font-weight:normal; white-space:nowrap;">本地國語聲音</label>\n                                        <select id="ai-tts-zh-local-voice" class="ai-advanced-input" style="flex:1; min-width:0;"></select>\n                                    </div>\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <input type="checkbox" id="ai-tts-api-enabled-chk" style="cursor:pointer;">\n                                        <label for="ai-tts-api-enabled-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">啟用中文語音API</label>\n                                    </div>\n                                    <label class="ai-advanced-label" for="ai-tts-api-proxy-url" style="font-weight:normal; margin-top:4px;">Cloudflare Worker 端點網址</label>\n                                    <input type="text" id="ai-tts-api-proxy-url" class="ai-advanced-input" placeholder="留空＝沿用 browser_search 或 LLM 的 Worker 網址">\n                                    <label class="ai-advanced-label" for="ai-tts-default-api-voice" style="font-weight:normal; margin-top:4px;">預設中文/其他語言語音</label>\n                                    <div style="display:flex; align-items:center; gap:6px;">\n                                        <select id="ai-tts-default-api-voice" class="ai-advanced-input" style="flex:1; min-width:0;"></select>\n                                        <button type="button" id="ai-tts-api-preview-btn" class="ai-advanced-btn" style="padding:4px 10px; flex:0 0 auto; white-space:nowrap;">🔊 試聽</button>\n                                    </div>\n                                    <div id="ai-tts-api-preview-player-slot"></div>\n                                    <p class="ai-advanced-hint">API語音不用「安裝」，每次呼叫都是即時打API，不占用 persistentStorage；試聽共用上面設定的語速。</p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="limits">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-perf-file-cache-mb">檔案快取容量上限 (MB)</label>\n                                    <input type="number" id="ai-perf-file-cache-mb" class="ai-advanced-input" min="1" max="2048">\n                                    <p class="ai-advanced-hint">上傳/RAG檔案的persistent快取（IndexedDB），超過上限時自動刪掉最久沒被存取的檔案，範圍1~2048。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-perf-batch-concurrency">批次併發數</label>\n                                    <input type="number" id="ai-perf-batch-concurrency" class="ai-advanced-input" min="1" max="20">\n                                    <p class="ai-advanced-hint">批次工具呼叫（例如一次分析多檔股票、或桌面版的batch_process_items）同時進行的併發數量，太大可能一次炸出過多併發請求。</p>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label" for="ai-perf-batch-rpm">批次每分鐘請求數上限</label>\n                                    <input type="number" id="ai-perf-batch-rpm" class="ai-advanced-input" min="0" max="1000">\n                                    <p class="ai-advanced-hint">批次工具呼叫每分鐘最多對API端點發出幾個新請求，留空或0＝不限制。併發數只控制「同時有幾個在跑」，不等於「每分鐘打幾個請求」——如果你的端點/金鑰有明確的rate limit（例如免費OpenRouter額度常見20/分鐘、每日50個），把這裡設成略低於那個數字，可以避免一開始就整批撞上429，而不是每個都靠重試機制事後收拾。這是所有model row共用的全域預設值；如果不同model row（不同端點）各自的rate limit不一樣，可以到上面「LLM Model 管理」分頁對個別row單獨填「批次每分鐘請求數上限」，該row有填時優先套用那個數字，不受這裡影響。</p>\n                                </div>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="browser-control">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">Chrome 瀏覽器控制</label>\n                                    <p class="ai-advanced-hint">安裝擴充功能「Floating AI Assitant(Chrome Extension)」後，AI 可以在你的 Chrome 建立分頁群組與分頁、捲動、截圖、控制滑鼠與鍵盤輸入。AI 只能操作它自己開的分頁，看不到也碰不到你原本開著的其他分頁。</p>\n                                    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-top:6px;">\n                                        <button type="button" id="ai-bc-test-btn" class="ai-advanced-btn primary">在瀏覽器測試連線</button>\n                                        <button type="button" id="ai-bc-get-btn" class="ai-advanced-btn">[get extension] 下載擴充功能</button>\n                                    </div>\n                                    <div style="display:flex; align-items:center; gap:6px; margin-top:10px;">\n                                        <input type="checkbox" id="ai-bc-enabled-chk" style="cursor:pointer;">\n                                        <label for="ai-bc-enabled-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">啟用瀏覽器控制（所有子 agent：程式設計、研究、網路搜尋…都會認識並可使用 browser_* 工具）</label>\n                                    </div>\n                                    <div id="ai-bc-test-result" class="ai-advanced-hint" style="margin-top:8px;"></div>\n                                </div>\n                                <div class="ai-advanced-stack" id="ai-bc-cap-box">\n                                    <label class="ai-advanced-label">擷取下載的上限</label>\n                                    <p class="ai-advanced-hint">瀏覽器自動化點到下載時，檔案會先被攔在擴充功能的記憶體（不讓 Chrome 存檔、不跳另存新檔），再一段一段傳回來驗證後寫出去。位元組放在瀏覽器記憶體裡，調太大瀏覽器會變慢；超過上限會回報錯誤，不會悄悄丟掉。</p>\n                                    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">\n                                        <label title="單一檔案最大多少 MB（1–2000）">單檔 <input type="number" id="ai-bc-cap-file" class="ai-advanced-input" min="1" max="2000" step="10" style="width:90px;"> MB</label>\n                                        <label title="同時留在記憶體裡的擷取合計最大多少 MB（1–4000）">合計 <input type="number" id="ai-bc-cap-total" class="ai-advanced-input" min="1" max="4000" step="50" style="width:90px;"> MB</label>\n                                        <label title="擷取到的檔案在擴充功能裡最多保存幾分鐘（1–240），超過會自動清掉">保存 <input type="number" id="ai-bc-cap-keep" class="ai-advanced-input" min="1" max="240" step="5" style="width:80px;"> 分鐘</label>\n                                    </div>\n                                </div>\n                                <div class="ai-advanced-stack" id="ai-bc-desktop-box" style="display:none;">\n                                    <label class="ai-advanced-label">桌面版連線（配對碼）</label>\n                                    <p class="ai-advanced-hint">把下面的配對碼貼到擴充功能彈出視窗的「配對碼」欄位並儲存，擴充功能就會連上這個桌面版（本機 127.0.0.1，只有知道配對碼的擴充功能能連）。</p>\n                                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">\n                                        <input type="text" id="ai-bc-token" class="ai-advanced-input" readonly style="max-width:300px; font-family:monospace;">\n                                        <button type="button" id="ai-bc-token-copy" class="ai-advanced-btn">複製</button>\n                                        <button type="button" id="ai-bc-token-regen" class="ai-advanced-btn">重新產生</button>\n                                    </div>\n                                    <p class="ai-advanced-hint" id="ai-bc-desktop-status"></p>\n                                </div>\n                                <details class="ai-advanced-stack" id="ai-bc-install-guide">\n                                    <summary class="ai-advanced-label" style="cursor:pointer;">安裝教學</summary>\n                                    <ol class="ai-advanced-hint" style="padding-left:20px; line-height:1.7;">\n                                        <li>按上面的「[get extension]」，瀏覽器會下載一個 zip；解壓縮成一個資料夾（裡面有 manifest.json），請放在不會被刪掉的位置。</li>\n                                        <li>在 Chrome 網址列輸入 <code>chrome://extensions</code>，右上角打開「開發人員模式」。</li>\n                                        <li>按「載入未封裝項目」，選剛剛解壓縮出來的資料夾。工具列的拼圖圖示裡可以把它釘選起來。</li>\n                                        <li><b>網頁版</b>：回到這個網頁重新整理，點擴充功能圖示，按「允許目前網站」。<br><b>桌面版</b>：複製上面的配對碼，貼到擴充功能彈出視窗的「配對碼」並儲存。</li>\n                                        <li>回到這裡按「在瀏覽器測試連線」，看到綠色的「連線成功」就完成了。之後對 AI 說「幫我開一個分頁群組搜尋…」即可。</li>\n                                    </ol>\n                                    <p class="ai-advanced-hint">滑鼠/鍵盤/截圖使用 Chrome 的偵錯功能，操作時瀏覽器會顯示「正在偵錯此瀏覽器」提示列，這是正常的。</p>\n                                </details>\n                            </div>\n                            <div class="ai-advanced-pane hidden" data-pane="terminal">\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">/run-terminal 外觀</label>\n                                    <p class="ai-advanced-hint">下面的設定預設只套用在「下一次開啟」的/run-terminal終端機（避免正在互動時畫面突然重排）。要讓已經開著的終端機也套用，按下面的「套用到全部已開啟的終端機」，或在任一個終端機上按右鍵→「套用主題與字型設定」。</p>\n                                    <label class="ai-advanced-label" for="ai-terminal-font-family" style="font-weight:normal;">字體</label>\n                                    <input type="text" id="ai-terminal-font-family" class="ai-advanced-input" placeholder="monospace, monospace">\n                                    <label class="ai-advanced-label" for="ai-terminal-font-size" style="font-weight:normal; margin-top:8px;">字體大小 (px)</label>\n                                    <input type="number" id="ai-terminal-font-size" class="ai-advanced-input" min="8" max="32" step="1">\n                                    <label class="ai-advanced-label" for="ai-terminal-cols" style="font-weight:normal; margin-top:8px;">欄數 (columns)</label>\n                                    <input type="number" id="ai-terminal-cols" class="ai-advanced-input" min="0" step="1" placeholder="0＝使用xterm.js預設值（80）">\n                                    <label class="ai-advanced-label" for="ai-terminal-scrollback" style="font-weight:normal; margin-top:8px;">可回捲行數 (scrollback)</label>\n                                    <input type="number" id="ai-terminal-scrollback" class="ai-advanced-input" min="0" step="1">\n                                    <div style="display:flex; align-items:center; gap:6px; margin-top:8px;">\n                                        <input type="checkbox" id="ai-terminal-scroll-to-output-chk" style="cursor:pointer;">\n                                        <label for="ai-terminal-scroll-to-output-chk" class="ai-advanced-label" style="margin:0; cursor:pointer;">有新輸出時自動捲到最底部</label>\n                                    </div>\n                                    <p class="ai-advanced-hint">關掉的話，正在往上捲看歷史輸出時不會被新輸出打斷、強制拉回底部。</p>\n                                    <label class="ai-advanced-label" for="ai-terminal-theme" style="font-weight:normal; margin-top:8px;">佈景主題</label>\n                                    <select id="ai-terminal-theme" class="ai-advanced-input">\n                                        <option value="system">system（跟隨目前App的亮/暗模式）</option>\n                                        <option value="ubuntu">ubuntu（Ubuntu終端機經典紫）</option>\n                                        <option value="powershell">powershell（PowerShell經典藍）</option>\n                                        <option value="black-white">黑底白字</option>\n                                        <option value="white-black">白底黑字</option>\n                                    </select>\n                                    <div style="display:flex; align-items:center; gap:10px; margin-top:12px;">\n                                        <button type="button" id="ai-terminal-apply-all-btn" class="ai-advanced-btn primary">🎨 套用到全部已開啟的終端機</button>\n                                        <span id="ai-terminal-apply-all-status" class="ai-advanced-hint" style="margin:0;"></span>\n                                    </div>\n                                </div>\n                                <div class="ai-advanced-stack">\n                                    <label class="ai-advanced-label">終端機資源管理</label>\n                                    <p class="ai-advanced-hint">一次對話裡可能同時存在多個/run-terminal終端機（每個都是一個活的xterm.js instance），這裡控制哪些session維持正常背景重繪頻率（例如top指令的每秒刷新）、哪些自動放慢頻率省資源——不影響手動輸入指令，只影響「沒有你操作時，畫面自己在背景更新」的頻率。</p>\n                                    <label class="ai-advanced-label" for="ai-terminal-resource-policy" style="font-weight:normal;">政策</label>\n                                    <select id="ai-terminal-resource-policy" class="ai-advanced-input">\n                                        <option value="focus">only on focus（預設，只有目前有鍵盤焦點的終端機維持正常頻率）</option>\n                                        <option value="viewport">viewport內（只有目前捲動到可視範圍內的終端機維持正常頻率）</option>\n                                        <option value="count">數量上限（只有最近互動過的N個維持正常頻率）</option>\n                                        <option value="unlimited">不限制（全部終端機都維持正常頻率）</option>\n                                    </select>\n                                    <label class="ai-advanced-label" for="ai-terminal-resource-count-limit" style="font-weight:normal; margin-top:8px;">數量上限政策的N</label>\n                                    <input type="number" id="ai-terminal-resource-count-limit" class="ai-advanced-input" min="1" step="1">\n                                    <p class="ai-advanced-hint">只有選「數量上限」政策時才有作用。</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="ai-advanced-footer">\n                        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">\n                            <label title="打勾才顯示全部設定頁：RAG 知識庫、LLM Model 管理、LLM Debug、子Agent、語音、多媒體、YouTube、離線訓練器、離線模型管理、Domain、自訂函式、終端機、效能與限制" style="display:inline-flex; align-items:center; gap:4px; cursor:pointer; font-size:12px; font-weight:bold; margin-right:6px;"><input type="checkbox" id="ai-engineering-mode-chk" style="cursor:pointer;">工程模式</label>\n                            <span class="ai-advanced-hint" style="font-size:12px;">全部內容以 JSON 格式儲存在 persistent localStorage。</span>\n                            <button type="button" id="ai-settings-export-btn" class="ai-advanced-btn">匯出設定</button>\n                            <label class="ai-advanced-btn" style="cursor:pointer; display:inline-flex; align-items:center;">匯入設定<input type="file" id="ai-settings-import-input" accept=".json" style="display:none;"></label>\n                            <button type="button" id="ai-conversation-export-json-btn" class="ai-advanced-btn">匯出對話(JSON)</button>\n                            <button type="button" id="ai-conversation-export-md-btn" class="ai-advanced-btn">匯出對話(Markdown)</button>\n                            <button type="button" id="ai-conversation-export-json-tr-btn" class="ai-advanced-btn" title="含子代理的思考、工具呼叫與結果（偵錯用）">匯出對話含 transcript(JSON)</button>\n                            <button type="button" id="ai-conversation-export-md-tr-btn" class="ai-advanced-btn" title="含子代理的思考、工具呼叫與結果（偵錯用）">匯出對話含 transcript(Markdown)</button>\n                        </div>\n                        <button type="button" id="ai-advanced-done" class="ai-advanced-btn primary">完成</button>\n                    </div>\n                </div>\n            </div>\n            <div id="ai-tool-editor-modal" class="ai-advanced-overlay">\n                <div class="ai-advanced-dialog" style="width:min(860px, 94vw);">\n                    <div class="ai-advanced-row">\n                        <h3 style="margin:0; color:#76b900;">編輯 Skill（Custom Tool）</h3>\n                        <button type="button" id="ai-tool-editor-close" class="ai-advanced-btn">關閉</button>\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <label class="ai-advanced-label" for="ai-tool-name-input">Name</label>\n                        <input id="ai-tool-name-input" class="ai-advanced-input" type="text">\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <label class="ai-advanced-label" for="ai-tool-desc-input">Description</label>\n                        <textarea id="ai-tool-desc-input" class="ai-advanced-textarea" style="min-height:100px;"></textarea>\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <label class="ai-advanced-label" for="ai-tool-skill-bundle-select">所屬技能包（Skill Bundle）</label>\n                        <select id="ai-tool-skill-bundle-select" class="ai-advanced-input"></select>\n                        <p class="ai-advanced-hint">選「未分類」的話，這個工具會跟其他未分類工具共用同一個委派領域；選一個技能包的話，委派給那個技能包時，子agent會連同該技能包的知識/人設一起看到（見「Skill」分頁上方的技能包清單）。</p>\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <label class="ai-advanced-label" for="ai-tool-script-input">Handler Script (JavaScript)</label>\n                        ${this._buildCodeEditorHtml("ai-tool-script-input",280)}\n                    </div>\n                    <div class="ai-advanced-footer">\n                        <span style="font-size:12px; color:#94a3b8;">Handler 會以 async function body 執行，參數為 <code>args</code> 與 <code>rawArgs</code>。</span>\n                        <div style="display:flex; gap:8px; flex-wrap:wrap;">\n                            <button type="button" id="ai-tool-editor-cancel" class="ai-advanced-btn">取消</button>\n                            <button type="button" id="ai-tool-editor-save" class="ai-advanced-btn primary">儲存</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div id="ai-domain-editor-modal" class="ai-advanced-overlay">\n                <div class="ai-advanced-dialog" style="width:min(860px, 94vw);">\n                    <div class="ai-advanced-row">\n                        <h3 id="ai-domain-editor-title" style="margin:0; color:#76b900;">編輯 Domain</h3>\n                        <button type="button" id="ai-domain-editor-close" class="ai-advanced-btn">關閉</button>\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <label class="ai-advanced-label" for="ai-domain-key-input">代號（key，委派時用這個識別，建立後不能修改）</label>\n                        <input id="ai-domain-key-input" class="ai-advanced-input" type="text" placeholder="例如：my_custom_domain">\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <label class="ai-advanced-label" for="ai-domain-label-input">顯示名稱（label）</label>\n                        <input id="ai-domain-label-input" class="ai-advanced-input" type="text">\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <label class="ai-advanced-label" for="ai-domain-category-input">類別（選填，兩層路由用，留空＝獨立領域）</label>\n                        <input id="ai-domain-category-input" class="ai-advanced-input" type="text">\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <label class="ai-advanced-label" for="ai-domain-tools-input">工具名稱清單（一行一個，必須是已經註冊過的工具名稱）</label>\n                        <textarea id="ai-domain-tools-input" class="ai-advanced-textarea" style="min-height:80px; font-family:monospace;" placeholder="render_drawing&#10;render_uml_diagram"></textarea>\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <div style="display:flex; align-items:center; justify-content:space-between;">\n                            <label class="ai-advanced-label" for="ai-domain-prompt-input" style="margin:0;">描述／System Prompt（委派給這個domain時，子agent會看到這段內容）</label>\n                            <button type="button" id="ai-domain-ai-revise-btn" class="ai-advanced-btn" style="padding:2px 8px; white-space:nowrap;">🤖 AI revise</button>\n                        </div>\n                        <textarea id="ai-domain-prompt-input" class="ai-advanced-textarea" style="min-height:140px;"></textarea>\n                        <div id="ai-domain-ai-revise-result" class="ai-advanced-hint" style="white-space:pre-wrap;"></div>\n                    </div>\n                    <div class="ai-advanced-stack">\n                        <div style="display: