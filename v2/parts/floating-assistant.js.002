tyle="display:flex; gap:6px; align-items:center; flex-wrap:wrap; margin-top:4px;"><span>${n?"✅ 已下載 "+FaVlm.fmtBytes(t.bytes)+"（"+t.files+" 個檔案）":"⬜ 未下載"}</span>\n                    ${e.managedOnly?"":`<button style="${d}" data-om="preload" data-id="${l(e.id)}" ${s?"disabled":""}>下載</button><button style="${d}" data-om="default" data-id="${l(e.id)}" ${e.id===("text-generation"===e.task?r.textModel:r.model)?"disabled":""}>設為預設</button>`}\n                    ${n?`<button style="${d} color:#fca5a5;" data-om="delete" data-id="${l(e.id)}">刪除</button>`:""}<span data-om-status="${l(e.id)}" style="color:#7dd3fc;"></span></div>${u(e)}</div>`},u=e=>{if("text-generation"!==e.task)return"";const t=FaVlm.roleConfig(e,r.roles,r.textModel),n=r.bench[e.id],s=r.roles[e.id]&&r.roles[e.id].device||"auto",a=(n,r,s)=>`<label style="margin-right:8px;"><input type="checkbox" data-om-role="${n}" data-id="${l(e.id)}" ${t[n]?"checked":""} ${s?"disabled":""}> ${r}</label>`,i=n?`<b style="color:${"good"===n.rating?"#34d399":"fair"===n.rating?"#fbbf24":"#f87171"}">工具呼叫 ${n.passed}/${n.total}（${l(n.label)}）</b>`:e.toolCalling?'<span style="color:#94a3b8">工具呼叫：還沒測試</span>':'<span style="color:#94a3b8">這個模型沒有工具呼叫格式，只能聊天</span>';return`<div style="margin-top:4px; font-size:12px;">角色：${a("tools","呼叫工具",!e.toolCalling)}${a("answer","寫回答")}${a("summarize","摘要")}　優先順序 <input type="number" data-om-prio data-id="${l(e.id)}" value="${t.priority}" style="${c} width:64px;">　運算 <select data-om-dev data-id="${l(e.id)}" style="${c}"><option value="auto" ${"auto"===s?"selected":""}>跟全域設定</option><option value="gpu" ${"gpu"===s?"selected":""}>GPU</option><option value="cpu" ${"cpu"===s?"selected":""}>CPU</option></select></div>\n                <div style="margin-top:4px; font-size:12px;">${i}　${e.toolCalling?`<button style="${d}" data-om="toolbench" data-id="${l(e.id)}">測試工具呼叫</button>`:""}${n?`<span style="color:#64748b;"> ${n.details.filter(e=>!e.ok).map(e=>l(e.id+"："+e.reason)).join("；")}</span>`:""}</div>`},m=FaVlm.textModels().map(p).join(""),f=FaVlm.imageModels().map(p).join(""),h=FaVlm.MODELS.filter(e=>e.managedOnly||"depth-estimation"===e.task||"segmentation"===e.task||"pose-estimation"===e.task).map(p).join(""),g=await this._omMusicSection(d,l),y=o.other.files?`<div style="margin-top:4px;">其他快取：${o.other.files} 個檔案、${FaVlm.fmtBytes(o.other.bytes)}${o.other.repos.length?"（"+o.other.repos.map(l).join("、")+"）":""} ${o.other.repos.map(e=>`<button style="${d} color:#fca5a5;" data-om="delrepo" data-repo="${l(e)}">刪除 ${l(e)}</button>`).join(" ")}</div>`:"";e.innerHTML=`<div style="color:#94a3b8; margin-bottom:8px;">離線模型在你的電腦上執行（瀏覽器內的 WebAssembly／WebGPU），圖片不會上傳；推論在背景執行緒，不會卡住畫面。模型第一次使用時才下載，存在瀏覽器快取。</div>\n            <div style="border:1px solid #334155; border-radius:8px; padding:8px; margin-bottom:10px;">\n              <div style="font-weight:600; margin-bottom:4px;">運算裝置</div>\n              <label>偏好 <select data-om-set="device" style="${c}"><option value="gpu" ${"gpu"===r.device?"selected":""}>GPU（不支援時自動降級成 CPU）</option><option value="cpu" ${"cpu"===r.device?"selected":""}>CPU</option></select></label>\n              <div style="color:${a.available?"#34d399":"#fbbf24"}; margin:4px 0;">${a.available?"✅ 偵測到 WebGPU："+l(a.name)+(a.f16?"（支援 fp16）":"（不支援 fp16 著色器；部分模型可能退回 CPU）"):"⚠️ 沒有 WebGPU："+l(a.reason)+"。所有模型一律用 CPU；只能用 GPU 的模型不能用。"}</div>\n              <label>CPU 核心上限 <input type="number" min="0" max="${s.hardware}" step="1" value="${r.maxCores||""}" placeholder="不限制" data-om-set="cores" style="${c} width:90px;"> <span style="color:#94a3b8;">（偵測到 ${s.hardware} 個邏輯核心；留空＝不限制）</span></label>\n              <div style="color:#94a3b8; margin-top:4px;">CPU 路徑會請求 ${i.requested} 個執行緒；實際 ${i.effective} 個。${s.isolated?"（SharedArrayBuffer 可用"+(s.coi?"，頁面是 cross-origin isolated":"，頁面不是 cross-origin isolated 但仍可多執行緒")+"）":""}${l(i.note)}　Whisper 語音轉文字也用同一組設定。</div>\n            </div>\n            <div style="border:1px solid #334155; border-radius:8px; padding:8px; margin-bottom:10px;">\n              <div style="font-weight:600; margin-bottom:4px;">儲存空間</div>\n              <div>模型快取共 <b>${FaVlm.fmtBytes(o.total.bytes)}</b>（${o.total.files} 個檔案）　<button style="${d}" data-om="refresh">重新整理</button> <button style="${d} color:#fca5a5;" data-om="clearall">全部清除</button></div>${y}\n              <div style="margin-top:6px;"><label><input type="checkbox" data-om-set="silentDl" ${this._omSilent()?"checked":""}> 靜默下載：離線模型用到才載入，需要而還沒下載時直接在背景下載、不跳確認視窗（取消勾選＝每次下載前先問）</label></div>\n              <div style="margin-top:6px;">看圖（vision）的優先順序：<select data-om-set="policy" style="${c}">${Object.entries(FaVlm.VISION_POLICIES).map(([e,t])=>`<option value="${e}" ${this._visionPolicy()===e?"selected":""}>${l(t.label)}</option>`).join("")}</select><div style="color:#94a3b8;">Python 腳本的圖片訊息、interpret_image、離線路由都依這個順序；沒有可用的線上視覺模型或全部失敗時，離線模型已下載才會當備援（不會偷偷下載）。提示詞格式（OCR／描述／問答、各模型自己的格式）由這一層處理。</div></div>\n            </div>\n            ${this._omNativeBoxHtml()}\n            <div style="border:1px solid #334155; border-radius:8px; padding:8px; margin-bottom:10px;">\n              <div style="font-weight:600; margin-bottom:4px;">文字生成（離線聊天）設定</div>\n              <div><label><input type="checkbox" data-om-set="llmFallback" ${r.llmFallback?"checked":""}> 離線訓練器信心不足時，交給離線文字模型回答</label></div>\n              <div><label><input type="checkbox" data-om-set="llmTools" ${r.llmTools?"checked":""}> 允許離線文字模型呼叫工具（沒通過基準測試、評為不可靠的模型不會被選去呼叫工具；有副作用的工具一律先問你）</label></div>\n              <div><label><input type="checkbox" data-om-set="recipes" ${r.recipes?"checked":""}> 食譜模式：離線小模型用「路由→填欄位→執行→措辭」一步一步做工具型的服務（程式能決定的就程式決定，模型只做選擇題與填空題；開著時不跑自由工具迴圈）</label></div>\n              <div><label><input type="checkbox" data-om-set="plans" ${r.plans?"checked":""}> 多步驟計畫：有明確目標（影片做摘要、網頁摘要、上網查資料並整理、文件念出來…）時，程式把目標展開成 phase → step → substep 的計畫，用狀態機＋決策樹執行與維護（失敗會重試、換路、問你，不會無窮迴圈）</label></div>\n              <div style="color:#94a3b8; margin:4px 0;">離線訓練器（Configure → AI →「離線訓練器」）就是線上 AI 養成離線 AI 的地方；離線文字模型、食譜與多步驟計畫都直接用它養出來的規則、做法、問答記憶與 RAG 當參考，離線做成功的也會養回去。</div>\n              <div><label><input type="checkbox" data-om-set="recipePhrase" ${r.recipePhrase?"checked":""}> 食譜：資訊類結果讓模型用 1～2 句話說明（會被檢查，有編造的數字就丟掉）</label>　<button style="${d}" data-om="exporttrace">匯出決策記錄</button> <button style="${d} color:#fca5a5;" data-om="cleartrace">清除</button> <span style="color:#94a3b8;">（最近 ${this._recipeTraces().length} 筆）</span></div>\n              <div><label><input type="checkbox" data-om-set="mixRewrite" ${r.mixRewrite?"checked":""}> 混用時，工具模型沒用到工具也交給「寫回答」的模型重寫</label></div>\n              <div><label>回答長度上限 <input type="number" min="64" max="2048" step="32" value="${r.llmMax}" data-om-set="llmMax" style="${c} width:80px;"> tokens</label>　<label>離線訓練器信心門檻 <input type="range" min="0.1" max="1" step="0.01" value="${null!=this.advancedSettings.offlineThreshold?this.advancedSettings.offlineThreshold:.45}" data-om-set="threshold" style="vertical-align:middle;"> <b>${null!=this.advancedSettings.offlineThreshold?this.advancedSettings.offlineThreshold:.45}</b></label></div>\n              <div style="color:#94a3b8; margin-top:4px;">信心門檻拉到 1.0＝只有「完全一樣的問題」才由離線訓練器處理，其餘幾乎都交給離線文字模型。<b>混用</b>：每個模型勾自己的角色並給優先順序——例如小模型專門呼叫工具、大模型專門寫回答；一張 GPU 放不下就把其中一個設成 CPU（GPU 與 CPU 各有自己的背景執行緒，可以同時駐留）；同一個裝置上的兩個模型則是依階段輪流載入。</div>\n              <div style="margin-top:6px;"><input type="text" placeholder="試聊一句（會走上面的路由：工具模型→寫回答模型）" data-om-set="chattext" style="${c} width:320px;"> <button style="${d}" data-om="chattest">送出</button>\n              <pre data-om-chatout style="white-space:pre-wrap; background:#0f172a; border-radius:6px; padding:6px; margin:6px 0 0; min-height:20px;">${l(n)}</pre></div>\n            </div>\n            <div style="font-weight:600; margin-bottom:4px;">文字生成（聊天）模型　<span style="font-weight:400; color:#94a3b8;">預設：${l(r.textModel)}</span></div>${m}\n            <div style="font-weight:600; margin:10px 0 4px;">圖像（VLM）模型　<span style="font-weight:400; color:#94a3b8;">預設：${l(r.model)}</span></div>${f}\n            <div style="font-weight:600; margin:10px 0 4px;">其他（只管理快取）</div>${h}\n            ${g}\n            <div style="font-weight:600; margin:10px 0 4px;">UniK3D（景物照片的度量深度，選用、自備）</div>\n            <div style="border:1px solid #334155; border-radius:8px; padding:8px; color:#94a3b8; line-height:1.6;">UniK3D 的授權是 CC BY-NC 4.0（非商業），所以<b>不內建、不下載、不散布</b>；官方也只發 PyTorch 權重，沒有現成的 .onnx。想用的話要自己匯出：<br>1. 取得官方程式碼與權重（github.com/lpiccinelli-eth/UniK3D，模型 vits）。<br>2. 在專案根目錄執行官方的 unik3d/models/export.py，輸入解析度固定為 462×630，得到 .onnx 檔。<br>3. 把檔案放在這台電腦上；目前<b>這個版本還沒有接上推論</b>（沒有驗證過它能不能在瀏覽器跑，也不知道匯出檔的輸入輸出名稱），所以 /image-to-3d 一律用上面的 Depth Anything V2 Small。</div>\n            <div style="border:1px solid #334155; border-radius:8px; padding:8px; margin-top:10px;">\n              <div style="font-weight:600; margin-bottom:4px;">試跑（用預設模型）</div>\n              <input type="file" accept="image/*" data-om="testfile" style="${c}"> <select data-om-set="testtask" style="${c}">${Object.entries(FaVlm.TASKS).map(([e,t])=>`<option value="${e}">${l(t)}</option>`).join("")}</select> <input type="text" placeholder="提示詞（選填，問問題用）" data-om-set="testprompt" style="${c} width:220px;"> <button style="${d}" data-om="test">執行</button>\n              <pre data-om-out style="white-space:pre-wrap; background:#0f172a; border-radius:6px; padding:6px; margin:6px 0 0; min-height:20px;">${l(t)}</pre>\n            </div>`}_nrAvailable(){return!!("undefined"!=typeof window&&window.desktopAPI&&window.desktopAPI.rawfs&&window.desktopAPI.diag&&window.desktopAPI.diag.mainExt)}async _nrBox(){const e=await window.desktopAPI.diag.mainExt(),t=e&&e.logFile;if(!t)return null;const n=String.fromCharCode(92),r=t.indexOf(n)>=0?n:"/",s=t.split(r);return s.pop(),s.pop(),s.join(r)+r+"native-runner-box"}async _nrCall(e,t,n,r){if(!this._nrAvailable())return{ok:!1,code:"no_bridge",message:"這個環境沒有桌面版橋接"};const s=await this._nrBox();if(!s)return{ok:!1,code:"no_box",message:"找不到使用者資料夾"};const a=s.indexOf(String.fromCharCode(92))>=0?Str