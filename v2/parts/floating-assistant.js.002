nModel(e,n.alt?`這張圖片的alt文字是「${n.alt}」，請描述圖片實際內容（如果圖片裡有文字，也請列出來）。`:void 0);n.description=t.description}catch(e){n.description_error=String(e.message||e)}}return JSON.stringify(t)},{type:"object",properties:Object.assign({tab_id:o},l,{interpret_images:{type:"boolean",description:"選填：true時對前幾張圖片自動呼叫vision model補上description（見上方工具說明）"},interpret_images_count:{type:"integer",description:"選填：搭配interpret_images，要解讀前幾張圖片，預設5、最多10"}}),required:[],additionalProperties:!1}),i("browser_get_elements","get_elements","列出分頁上可互動的元素（連結、按鈕、輸入框…）與其中心座標x,y，用來決定browser_mouse要點哪裡。預設只列目前可視區內的元素，viewport_only:false列全頁。",{tab_id:o,max:{type:"integer"},viewport_only:{type:"boolean"}},[]),i("browser_mouse","mouse","控制滑鼠（真實輸入事件）。action: click/double_click/right_click/move/wheel/drag/down/up。x,y是分頁可視區的像素座標（來自browser_get_elements）。drag需要to_x,to_y；wheel用delta_y。",{tab_id:o,action:{type:"string",enum:["click","double_click","right_click","move","wheel","drag","down","up"]},x:{type:"number"},y:{type:"number"},to_x:{type:"number"},to_y:{type:"number"},delta_x:{type:"number"},delta_y:{type:"number"},button:{type:"string",enum:["left","right","middle"]},modifiers:{type:"array",items:{type:"string"}}},["x","y"]),i("browser_type_text","type_text","在目前有焦點的輸入框輸入文字（先用browser_mouse點一下輸入框，或給selector自動聚焦）。clear:true先清空；submit:true輸入後按Enter。",{tab_id:o,text:{type:"string"},selector:{type:"string"},clear:{type:"boolean"},submit:{type:"boolean"}},["text"]),i("browser_press_key","press_key","按一個鍵。key例如Enter、Tab、Escape、Backspace、ArrowDown、PageDown、a；modifiers可放ctrl/shift/alt/meta（例如ctrl+a全選）。",{tab_id:o,key:{type:"string"},modifiers:{type:"array",items:{type:"string"}}},["key"]),i("browser_click","click",'用CSS selector或文字內容找到元素並點擊（真實滑鼠事件），不用先截圖算座標——**同一個網站的很多個頁面結構相同時（例如逐一走訪多個網址各下載一次），同一個selector可以在每個頁面重複使用，比每次screenshot+browser_get_elements快很多**。selector與text至少給一個（可以只給text，例如text:"免費下載"會在常見可點擊元素裡找innerText/value包含這段文字的）；兩者都給時先用selector篩選、再用text篩選。index選填，同時符合多個時選第幾個（0起算，預設0）。**如果這次點擊預期會觸發檔案下載，一定要加wait_download:true**，回傳的download會有實際存檔路徑(path)、檔名可以從path取得——沒有這個flag點了下載也不知道有沒有成功、存在哪裡。找不到元素時回報的visible_count/matched_by_selector等數字要拿來判斷selector對不對，不要瞎猜著重試。',{tab_id:o,selector:{type:"string",description:"選填，CSS selector"},text:{type:"string",description:"選填，元素可見文字/value/aria-label要包含這段（不分大小寫）"},index:{type:"integer",description:"選填，同時符合多個時選第幾個，0起算，預設0"},wait_download:{type:"boolean",description:"選填，點擊後等待這次觸發的檔案下載完成，回傳存檔路徑"},download_timeout_ms:{type:"integer",description:"選填，等下載的逾時時間(毫秒)，預設20000"},download_behavior:{type:"string",enum:["capture","allow","deny","default"],description:"選填，這次點擊前先設定這個分頁的下載行為：capture=（wait_download:true時的預設，建議）攔下下載、不讓Chrome存檔，位元組串流給FAP並驗證大小與crc32、回傳抓到了什麼（檔名、大小、sha256），再寫進FAP的下載卡片（帶save_path還會寫進該資料夾）；allow=直接存到download_path、不跳「另存新檔」對話框（會一直生效到改成default或分頁關掉）；deny=擋掉下載、只回報有下載想發生（denied:true）；default=還給Chrome自己處理。預期會跳另存新檔對話框時用allow"},save_path:{type:"string",description:"選填，capture擷取到的檔案要同時寫進哪個資料夾（絕對路徑，桌面版才能寫；不給就只進FAP的下載卡片）"},deliver:{type:"boolean",description:"選填，capture的檔案是否交給FAP下載卡片，預設true"},download_path:{type:"string",description:"download_behavior為allow時必填：存檔資料夾的絕對路徑（例如C:\\Users\\你\\Downloads\\ai 或 /home/你/Downloads/ai）"}},[],3e4),i("browser_wait_download","wait_download","等待一個新的檔案下載完成，回傳存檔路徑(path)、網址、mime、大小。用在下載不是由browser_click直接觸發的情況（例如按Enter觸發、或頁面延遲幾秒後才自動下載）；如果是點擊按鈕觸發下載，優先在browser_click直接帶wait_download:true，不用另外呼叫這個。since_ms選填，不給就只等「這次呼叫之後」才新出現的下載。",{since_ms:{type:"number",description:"選填，只算這個時間戳記(ms)之後才建立的下載為新下載；不給就用呼叫當下的時間"},timeout_ms:{type:"integer",description:"選填，逾時時間(毫秒)，預設20000"},tab_id:o,save_path:{type:"string",description:"選填，capture擷取到的檔案要同時寫進哪個資料夾（絕對路徑，桌面版）"},deliver:{type:"boolean",description:"選填，是否交給FAP下載卡片，預設true"}},[],19e4),i("browser_set_download_behavior","set_download_behavior","預先設定一個分頁的下載行為（之後這個分頁觸發的下載都照它處理，直到改回default或分頁關掉）。behavior=allow要附path（存檔資料夾的絕對路徑）：下載直接存進去、不跳「另存新檔」對話框（擴充功能碰不到系統對話框，所以要靠這個避開）；capture=攔下下載交給FAP（建議，抓到什麼都看得到、驗得到）；deny=擋掉下載、只回報有下載想發生；default=還給Chrome。通常直接在browser_click帶download_behavior（或wait_download:true，預設capture）就好，這個用在下載不是點擊觸發的情況。",{tab_id:o,behavior:{type:"string",enum:["capture","allow","deny","default"]},path:{type:"string",description:"behavior為allow時必填，存檔資料夾的絕對路徑"}},["behavior"],15e3),e("browser_upload",'把檔案放進網頁的上傳欄位（不會跳系統的檔案選擇對話框）。檔案來源（files，可多個）：聊天附件或 FAP 產生過的檔案，用檔名（或 file_id）指定，例如 {"name":"報告.pdf"}；桌面版也可以用本機絕對路徑 {"path":"C:\\Users\\你\\a.pdf"}。放進哪裡：(1) selector＝檔案欄位 input type=file 的 CSS selector（欄位被藏起來也可以），直接填入；(2) click_selector／click_text＝點下去會開檔案選擇對話框的按鈕（自訂的「選擇檔案」按鈕），會先捲到畫面中央、點擊、攔下對話框、填入。檔案位元組會分段傳給擴充功能並核對（crc32、放進欄位後的大小），回傳每個檔案的大小與 sha256、網頁實際收到的檔名。填入後網頁會收到 input／change 事件，但不會自動按「送出」，要送出請另外 browser_click。拖放區（沒有 input type=file、要真實拖放事件的）這個工具做不到。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._bcUpload(t))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{tab_id:o,files:{type:"array",items:{type:"object",properties:{name:{type:"string",description:"聊天附件或 FAP 檔案的檔名（可以只寫一部分）"},file_id:{type:"string"},path:{type:"string",description:"桌面版：本機檔案絕對路徑"}}},description:"要上傳的檔案（一個或多個）"},selector:{type:"string",description:"檔案欄位（input type=file）的 CSS selector；給了就直接填入"},index:{type:"integer",description:"selector 符合多個欄位時選第幾個（0 起算）"},click_selector:{type:"string",description:"沒有 selector 時：點這個 CSS selector 的元素（會開檔案選擇對話框）"},click_text:{type:"string",description:"沒有 selector 時：點可見文字包含這段的元素（例如「選擇檔案」）"},click_index:{type:"integer"},timeout_ms:{type:"integer",description:"點擊後等對話框出現的逾時（毫秒），預設 8000"}},required:["files"],additionalProperties:!1}),i("browser_list_downloads","list_downloads","列出這次擴充功能執行期間記得的最近幾筆下載（除錯用，不是完整下載歷史，重新啟動瀏覽器/擴充功能就會清空）。",{max:{type:"integer",description:"選填，最多列幾筆，預設10"}},[],1e4),e("git_push",'把一個File Access Point資料夾（git repo）本機已經commit的內容推上遠端(origin)。一定需要使用者已填入有寫入權限的GitHub Personal Access Token（不論公開或私有repo，push都需要驗證身分），沒有的話會直接回報錯誤而不是嘗試匿名push。參數: {"ref":"fap:我的專案", "branch":"main"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.ref||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少ref參數"});try{return JSON.stringify(await this._gitPush(n,{branch:t.branch}))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{ref:{type:"string",description:"File Access Point資料夾，格式：fap:<名稱或id>[/<子路徑>]"},branch:{type:"string",description:"要push的分支（留空＝目前所在分支）"}},required:["ref"],additionalProperties:!1}),e("list_uploaded_files","列出使用者透過📎附件按鈕上傳、目前還在快取中的檔案清單（不含AI自己產生的匯出檔）。無參數。",async function(){try{const e=(await this.fileCache.getAll()).filter(e=>"uploaded"===e.kind).map(e=>({file_id:e.id,filename:e.filename,sizeBytes:e.sizeBytes,uploadedAt:e.createdAt}));return JSON.stringify({ok:!0,files:e})}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{},additionalProperties:!1}),e("parse_uploaded_file",'解析一個已上傳檔案的內容，依副檔名自動判斷格式（csv/xlsx/js/json/txt/markdown/yaml/docx/pptx/pdf/toon/cfg/inf/ini/log都支援，壓縮檔支援zip/jar/7z/rar/tar/tar.gz/tgz/gzip/bzip2/tar.bz2/xz/tar.xz/iso，用檔頭判斷格式，副檔名不對也認得出來）。壓縮檔預設只回傳內含項目清單與摘要（jar會附MANIFEST重點、類別與套件），要看特定項目的實際內容再帶entry_path指定（二進位項目不會顯示；有加密要帶password）。pdf會逐頁擷取文字內容接成fullText（只回傳前12000字元，超長文件需要完整全文請改用summarize_large_text）；純掃描/圖片PDF沒有文字層，擷取不到內容屬於正常情況（不支援OCR），回應裡的note欄位會說明。**PDF文字跟圖片是分開解析的**：預設只解析文字（速度快），如果PDF裡有圖表/圖片需要理解內容，帶interpret_images:true重新呼叫——有圖片的頁面會被整頁截圖（不是逐一還原內嵌圖片，比較可靠），截圖先以「[圖片區塊：第N頁截圖｜file_id=...]」佔位標籤插入該頁文字，interpret_images:true時才會真的呼叫vision model描述內容並附加在佔位標籤後面（interpret_images_count控制最多對幾頁截圖做vision描述，避免每頁都跑vision太慢，預設3）；回應的pageImages欄位列出每張截圖的file_id/是否已描述，之後也可以直接拿file_id呼叫interpret_image單獨補問。**有密碼保護的PDF**：呼叫這個工具時如果偵測到需要密碼，會在畫面上自動跳出密碼輸入框讓使用者當場輸入（跟File Access Point權限不足時的行為一致），這次工具呼叫會停在那裡等使用者輸入完成，不需要事先知道密碼或另外處理，使用者輸入錯誤會再跳一次、取消輸入則工具回報明確錯誤。參數: {"file_id":"...", "entry_path":"（選填，僅壓縮檔用）"}**分頁讀取**：純文字、壓縮檔項目、PDF文字如果回傳has_more:true，用offset/start_line/max_chars/max_lines繼續讀到完整份；精準編修（程式碼、字幕）不要用summarize_large_text，要分頁把整份讀完。要「改」附件內容請用bash_execute/python_execute的attachment_files參數。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file_id||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file_id參數（用list_uploaded_files查詢可用的file_id）"});const r=await this.fileCache.get(n);if(!r||"uploaded"!==r.kind)return JSON.stringify({ok:!1,error:`找不到上傳檔案 file_id=${n}（可能已被淘汰或這不是使用者上傳的檔案）`});const s=await this._parseUploadedFileContent(r,{entryPath:t.entry_path,offset:t.offset,maxChars:t.max_chars,startLine:t.start_line,maxLines:t.max_lines,interpretImages:t.interpret_images,interpretImagesCount:t.interpret_images_count,password:t.password});return JSON.stringify(Object.assign({filename:r.filename},s))},{type:"object",properties:{file_id:{type:"string",description:"要解析的檔案id，用list_uploaded_files取得"},entry_path:{type:"string",description:"（選填）壓縮檔內要抽取內容的項目路徑"},password:{type:"string",description:"（選填）加密壓縮檔（zip／7z／rar）的密碼；使用者沒給就不要猜"},offset:{type:"integer",description:"選填：純文字/壓縮檔項目/PDF文字從第幾個字元開始讀（分頁用，預設0）"},max_chars:{type:"integer",description:"選填：這次最多讀幾個字元（預設依模型內容窗口自適應）"},start_line:{type:"integer",description:"選填：從第幾行開始讀（1起算，優先於offset）"},max_lines:{type:"integer",description:"選填：這次最多讀幾行"},interpret_images:{type:"boolean",description:"（選填，僅PDF）true時對含圖片的頁面截圖並交給vision model描述內容，預設false只解析文字"},interpret_images_count:{type:"integer",description:"（選填，僅PDF且interpret_images:true時）最多對幾頁截圖做vision描述，預設3"}},required:["file_id"],additionalProperties:!1}),e("interpret_image",'請AI實際「看」一張圖片並用文字描述/回答關於這張圖片的問題（附件圖片、File Access Point裡的圖片、或圖片URL都支援）。內部會自動從目前設定的LLM Models清單挑一個支援讀圖(vision)的model來解讀，呼叫端不用（也不需要）自己判斷哪個model支援讀圖。三種輸入來源三選一：file_id（📎附件或AI產生的圖片，用list_uploaded_files查）、fap_ref搭配需要先呼叫fap_copy_to_storage複製成file_id（File Access Point本身不支援直接讀二進位圖片內容）、image_url（http(s)網址或data:image/...開頭的data URL，遠端URL可能受目標網站CORS限制而失敗）。question選填，不給的話預設請model詳細描述圖片內容（含圖片裡的文字）；想確認特定細節時直接問具體問題（例如「這張圖表股價的最高點在哪一天」「這是什麼型態的K線圖」）比只說「描述這張圖」更準確。參數: {"file_id":"..."} 或 {"image_url":"https://..."}，可加 {"question":"..."}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file_id||"").trim(),r=String(t.image_url||"").trim();if(!n&&!r)return JSON.stringify({ok:!1,error:"需要提供file_id或image_url其中之一"});try{const{dataUrl:e,label:s}=await this._resolveImageInputForInterpretation({fileId:n||null,imageUrl:r||null});if("jsonl"===t.output||"text"!==t.output&&/拆解|分解|所有物件|每個物件|全部物件|物件清單|物件列表|列出.{0,8}(?:物件|元素|部件|零件)|bounding\s*box|\bbbox\b|segment/i.test(String(t.question||""))){const n=await this._visionJsonlStream(e,String(t.question||"").trim()||"列出圖片裡所有看得到的物件",{step:e=>{try{this._log("🖼️ 看圖（逐行）："+e)}catch(e){}}}),r={ok:!0,source:s,backend:"online",model_used:n.modelUsed,mode:"jsonl",complete:n.complete,stop_reason:n.stop_reason,rounds:n.rounds,bad_lines:n.bad,duplicates_dropped:n.dup,last_error:n.errors.length?n.errors[n.errors.length-1].error:void 0,note:n.complete?void 0:"沒有全部輸出完（原因："+n.stop_reason+"），下面只是已拿到的部分；請如實告訴使用者只拿到部分，不要說成全部。"},a=this._bigStashRecords(n.lines,r,"interpret_image"),i=this._bigPage(a,null);return i&&i.ok?i.text:JSON.stringify(Object.assign({},r,{records:n.lines.length}))}const a=await this._visionDescribe({images:[e],prompt:t.question,runLlm:()=>this._interpretImageOnline(e,t.question)});return a.ok?"llm"===a.backend?JSON.stringify({ok:!0,source:s,backend:"llm",model_used:a.llm.modelUsed,vision_confirmed:a.llm.visionConfirmed,description:a.llm.description,policy:a.policy}):JSON.stringify({ok:!0,source:s,backend:"offline",model_used:a.model,vision_confirmed:!1,description:a.text,note:(a.attempts.some(e=>"llm"===e.backend&&!e.ok)?"線上視覺模型沒有可用或全部失敗（"+a.attempts.filter(e=>"llm"===e.backend).map(e=>e.error).join("；").slice(0,160)+"），已改用離線模型。":"")+"離線模型的描述主要是英文。"+(a.note?" "+a.note:""),policy:a.policy,attempts:a.attempts}):JSON.stringify({ok:!1,error:a.error,attempts:a.attempts,policy:a.policy,hint:"離線模型要先在 Configure →「離線模型管理」下載；也可以直接用 image_to_text"})}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file_id:{type:"string",description:"要解讀的圖片file_id（用list_uploaded_files取得；FAP裡的圖片請先用fap_copy_to_storage複製成file_id）"},image_url:{type:"string",description:"要解讀的圖片網址（http(s)開頭），跟file_id擇一提供"},question:{type:"string",description:"選填：想問關於這張圖片的具體問題，不給的話預設要求詳細描述圖片內容"},output:{type:"string",enum:["text","jsonl"],description:"選填：jsonl＝逐行輸出每個物件（拆解、列出所有物件這類可能幾千筆的問題，會自動接著寫到說完，結果一頁頁讀：用 big_content 的 page 動作帶 next_cursor，complete 為 true 且 has_more 為 false 才算讀完）；text＝一般文字描述。問題裡有「拆解」「所有物件」等字會自動用 jsonl"}},required:[],additionalProperties:!1}),e("extract_pptx_images",'把已上傳的pptx投影片裡「嵌入的圖片」逐張抽出來，存成圖片檔案（回傳每張的slide投影片編號、順序、file_id），之後可以用interpret_image/compare_images讀圖或比較。**只抽得出嵌入的圖片（png/jpg/gif/webp/svg），抽不出「整張投影片的渲染畫面」**（文字/圖形/表格不會變成圖片）；emf/wmf/tif等瀏覽器不支援的格式會列在skipped。參數: {"file":"pptx的file_id或檔名，留空用最近上傳的","slides":"（選填）投影片範圍例如"2-5"或"3"，預設全部","max_images":"（選填）最多抽幾張，預設30，最高80"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file||t.file_id||"").trim(),r=await this._resolveUploadedFileRecord(n);if(!r)return JSON.stringify({ok:!1,error:n?`找不到符合「${n}」的檔案`:"沒有可用的pptx（請先上傳）"});if("pptx"!==this._detectFileFormat(r.filename))return JSON.stringify({ok:!1,error:`「${r.filename}」不是pptx檔案`});try{return JSON.stringify(await this._extractPptxImages(r,t))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file:{type:"string",description:"pptx的file_id或檔名；留空＝最近上傳的"},slides:{type:"string",description:'（選填）投影片範圍，例如"3"或"2-5"，預設全部'},max_images:{type:"integer",description:"（選填）最多抽幾張，預設30，最高80"}},additionalProperties:!1}),e("merge_pdfs",'把多個檔案依指定順序合併成一份PDF：PDF、各種圖片（jpg／png／gif／webp／bmp／avif／tiff／heic／svg…）、文字檔（txt／md／csv／log／json／程式碼…）、docx、xlsx 都可以，也能混在一起；副檔名不重要，用內容判斷。純本地、不經過AI。PDF＝直接複製原始頁面（文字仍可選取）；圖片＝等比例縮放置中到頁面（預設A4；page_size／orientation／fit／margin／zoom／background 同 images_to_pdf，要逐張旋轉或影像處理請改用 images_to_pdf）；文字檔＝排版後畫成頁面（中文OK）；docx／xlsx／pptx／doc／xls／rtf／odt＝桌面版用 Word／Excel／PowerPoint（Windows）或 LibreOffice 轉成PDF（版面、圖片、字型都保留；第一次會跳出「允許執行程式」確認），都沒有時 docx／xlsx 退回簡化版（只有文字、標題、表格內容，會在 warnings 說明），其他格式就明說需要 Office。files＝file_id或檔名（照這個順序）；folder＝整個資料夾（fap:名稱/路徑 或桌面版絕對路徑，依檔名自然排序，pattern可篩如"*.docx"）；沒給＝這個對話附加的全部檔案（依檔名自然排序）；sort：none／name／name_desc／modified／reverse。filename、output_path（fap:名稱/資料夾 或桌面版絕對路徑）；office_engine：auto（預設）／office／libreoffice／simple（不叫外部程式、強制簡化版）；on_error：fail（預設，有一個壞就整份不做並說是哪一個）／skip。⚠️PDF有密碼保護不支援。回傳{ok,pdf_file_id,filename,sizeBytes,pageCount,fileCount,files:[{filename,kind,pages,method}],warnings?,saved_to?}，成功時會自動產生下載附件。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._mergeDocsToPdf(t,e=>this._log("📄 "+e));return await this._deliverToolResultFile(e,"pdf_file_id",e=>`📎 已合併 ${e.fileCount} 個檔案成PDF（共${e.pageCount}頁）：${e.filename}（${(e.sizeBytes/1024/1024).toFixed(1)}MB）${e.saved_to?"，已存到 "+e.saved_to:""}`,"merge_pdfs"),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{files:{type:"array",items:{type:"string"},description:"（選填）要依序合併的檔案 file_id或檔名（也可以是 fap:名稱/路徑、桌面版絕對路徑）；留空＝這個對話附加的全部檔案"},folder:{type:"string",description:"（選填）整個資料夾：fap:名稱/路徑 或桌面版絕對路徑，依檔名自然排序"},pattern:{type:"string",description:'（選填）folder 的檔名篩選，例如 "*.docx"'},sort:{type:"string",enum:["none","name","name_desc","modified","reverse"],description:"（選填）預設：有給 files＝照給的順序，folder／附件＝依檔名自然排序"},page_size:{type:"string",description:'（選填）圖片與文字頁的頁面大小：a4（預設）／a3／a5／b5／letter／legal／"210x297mm"'},orientation:{type:"string",enum:["auto","portrait","landscape"],description:"（選填）預設 auto（圖片依寬高、文字直式）"},fit:{type:"string",enum:["contain","cover","stretch","actual"],description:"（選填）圖片：contain（預設，等比置中）／cover（填滿裁切）／stretch／actual"},margin:{type:"number",description:"（選填）圖片頁的邊界 pt，預設 0"},margin_mm:{type:"number",description:"（選填）文字頁的邊界 mm，預設 15"},zoom:{type:"number"},background:{type:"string"},jpeg_quality:{type:"number"},office_engine:{type:"string",enum:["auto","office","libreoffice","simple"],description:"（選填）docx／xlsx 等怎麼轉：auto（預設，先 Word／Excel 再 LibreOffice 再簡化版）"},filename:{type:"string",description:"（選填）輸出檔名"},output_path:{type:"string",description:"（選填）把PDF存到：fap:名稱/資料夾 或桌面版絕對路徑"},on_error:{type:"string",enum:["fail","skip"],description:"（選填）有檔案壞掉時：fail（預設）／skip"}},additionalProperties:!1}),e("uml_to_code",'把 UML 轉成程式碼骨架（Python／TypeScript／Java），純程式、秒完成、不經過 AI。你（或離線小模型）只要寫「一行一件事」的 UML 文字，格式：model: 名稱／actor: A, B／class Name extends Base implements I { +id:int; items:List<Item>; +total():decimal; add(item:Item):void }／interface Name { op(x:int):bool }／enum Name { A, B }／Order *-- Item（組成）Cart o-- Item（聚合）A --\x3e B : 標籤 1..*（關聯）A ..> B（依賴）／usecase 名稱: Actor -> Cls.op(args):ret -> Cls2.op2()（呼叫順序）。型別：int float str bool date datetime decimal any、List<T> Map<K,V> Optional<T> 或已定義的類別。類別名稱英文 PascalCase，屬性與操作 camelCase。格式或內容有錯會精確回報哪一行、為什麼，改好再呼叫一次。架構與 library 由程式依 scenario 的關鍵字推薦（也可用 constraints 指定，例如 {"persistence":"sqlite"}）；要先看有哪些選項與推薦用 design_choices。產生 zip（下載附件）並回傳檔案清單、設計決策、Mermaid 類別圖。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlToCode(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{uml:{type:"string",description:"UML 文字（格式見工具說明）"},language:{type:"string",enum:["python","typescript","java"],default:"python",description:"目標語言"},package:{type:"string",description:"（選填）套件／專案名稱，小寫英文"},scenario:{type:"string",description:"（選填）原始情境文字；用來推薦架構與 library（網站、命令列、資料庫、登入、排程…）"},constraints:{type:"object",description:'（選填）指定抉擇，例如 {"architecture":"layered","interface":"rest","persistence":"sqlite"}；選項見 design_choices'},remember:{type:"boolean",description:"（選填）true＝把 constraints 記成使用者偏好，以後推薦優先採用"}},required:["uml"],additionalProperties:!1}),e("glue_list","列出「膠水」——骨架之後把設計接到真正 library 的寫法（ORM 模型、repository 實作、Pydantic schema、依賴注入、FastAPI 路由與啟動、Typer 指令、JWT、HTTP 客戶端、排程、記錄、設定、冒煙測試…）：每一塊的適用條件、占的位置（slot）、驗證過的版本、經驗（成功／失敗、最近環境）、來源（內建／AI 登記／使用者）。uml_to_code 會依設計自動挑選並套用；你可以用 glue_define 登記自己接通的寫法，用 glue_report 回報某塊膠水在你的環境跑測試的結果。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=this.advancedSettings.glueExperience||{},r=FaGlue.GLUE.concat(this.advancedSettings.userGlue||[]).filter(e=>!t.lang||e.lang===t.lang);return JSON.stringify({ok:!0,glue:r.map(e=>({id:e.id,lang:e.lang,slot:e.slot,label:e.label,source:e.source,requires:e.requires,verified:e.verified,experience:n[e.id]||{ok:0,fail:0},score:Math.round(100*FaGlue.score(e,n))/100,files:e.files.map(e=>e.path)}))})},{type:"object",properties:{lang:{type:"string",enum:["python","typescript","java"],description:"（選填）只列這個語言"}},additionalProperties:!1}),e("glue_define","登記一塊「膠水」：你（AI）把某個 library 組合手動接通、測試通過之後，把那些檔案整理成 template 登記起來，之後離線小模型與其他 AI 產生專案時直接重用，不用重新摸索。template 用 {{名稱}} 取代會變的部分，可用的變數：pkg（套件名）、src（原始碼目錄）、title（系統名稱）；每個實體／使用案例一個檔案時 per 填 entity 或 usecase，變數是 name、snake、plural、table、fields（每個有 name、py、mapped、col）／className、path、steps；迴圈 {{#each entities}}…{{/each}}、條件 {{#if x}}…{{else}}…{{/if}}、過濾 |snake |camel |pascal |upper。登記後標為「未驗證」，要累積 glue_report 的成功經驗才會贏過內建且已驗證的膠水（同一個 slot 只留分數最高的一塊）。路徑必須是專案內的相對路徑。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaGlue.validateGlue(Object.assign({},t,{source:"ai"}));if(!n.ok)return JSON.stringify({ok:!1,error:"膠水格式不合格",errors:n.errors});const r=(this.advancedSettings.userGlue||[]).filter(e=>e.id!==n.glue.id).concat([n.glue]).slice(-60);return this.advancedSettings.userGlue=r,this._saveAdvancedSettings(),JSON.stringify({ok:!0,id:n.glue.id,slot:n.glue.slot,note:"已登記為未驗證；用它產生專案、測試通過後請呼叫 glue_report 回報"})},{type:"object",properties:{id:{type:"string",description:"小寫英數與連字號，例如 py-fastapi-jwt-auth"},lang:{type:"string",enum:["python","typescript","java"]},slot:{type:"string",description:"占的位置，例如 api、persistence、auth、cli、services；同一個位置只留分數最高的一塊"},label:{type:"string"},requires:{type:"object",description:'（選填）適用條件，例如 {"interface":["rest"],"persistence":["orm"],"libs":["fastapi"]}'},files:{type:"array",items:{type:"object"},description:'[{path, template, per:"project"|"entity"|"usecase"}]'},notes:{type:"string"}},required:["id","lang","slot","files"],additionalProperties:!1}),e("glue_report","回報一塊膠水在真實環境的結果：用 uml_to_code／uml_design 產生的專案，裝好依賴、跑過測試之後，成功或失敗都回報（ok、環境版本、備註）。經驗會累積，決定同一個位置有多塊膠水時挑哪一塊，也讓使用者知道哪些組合真的驗證過。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.glue_id||"");return FaGlue.GLUE.concat(this.advancedSettings.userGlue||[]).some(e=>e.id===n)?(this.advancedSettings.glueExperience=FaGlue.report(this.advancedSettings.glueExperience||{},n,!0===t.ok,t.env,t.note),this._saveAdvancedSettings(),JSON.stringify({ok:!0,glue_id:n,experience:this.advancedSettings.glueExperience[n]})):JSON.stringify({ok:!1,error:"沒有這塊膠水："+n+"（用 glue_list 看有哪些）"})},{type:"object",properties:{glue_id:{type:"string"},ok:{type:"boolean",description:"測試是否通過"},env:{type:"object",description:'（選填）環境，例如 {"python":"3.11","fastapi":"0.110.0"}'},note:{type:"string",description:"（選填）備註，失敗時寫原因"}},required:["glue_id","ok"],additionalProperties:!1}),e("design_choices","列出「UML 確定之後」的設計抉擇：架構風格（分層、六角、命令列、函式庫、事件驅動）與各關注點（對外介面、資料儲存、驗證、測試、記錄、呼叫外部服務、認證、排程、訊息）的選項、各語言對應的 library 與取捨；依 scenario 推薦（程式依關鍵字決定，平手才列成選擇題），並列出符合的常見設計片段（購物車、登入、Repository、Observer、Strategy、狀態機、庫存、排程…）。純查表，不經過 AI。選好後把選擇放進 uml_to_code 的 constraints。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=["python","typescript","java"].includes(t.language)?t.language:"python",r=FaDesign.recommend(String(t.scenario||""),n,{prefs:this.advancedSettings.designPrefs||{},constraints:t.constraints||{}});return JSON.stringify({ok:!0,language:n,tags:r.tags,architecture:r.architecture,architectures:FaDesign.ARCH.map(e=>({id:e.id,label:e.label,notes:e.notes,tradeoff:e.tradeoff})),choices:r.choices.map(e=>({concern:e.concern,label:e.label,chosen:e.option,lib:e.lib,by:e.by,reason:e.reason,options:FaDesign.CONCERNS[e.concern].options.map(e=>({id:e.id,label:e.label,lib:e.libs[n],tradeoff:e.tradeoff}))})),ambiguous:r.ambiguous,fragments:FaDesign.matchFragments(String(t.scenario||"")).slice(0,4).map(e=>({id:e.fragment.id,label:e.fragment.label,hits:e.hits,uml:e.fragment.dsl}))})},{type:"object",properties:{scenario:{type:"string",description:"（選填）情境文字，用來推薦"},language:{type:"string",enum:["python","typescript","java"],default:"python"},constraints:{type:"object",description:"（選填）已經指定的抉擇"}},additionalProperties:!1}),e("mix_understand","讀一份「混合內容」的輸入：英文敘述夾著各種語言的程式、設定、錯誤輸出（PHP、HTML、JavaScript、WebGL 著色器 GLSL、TOML、INI、Python、CSS、JSON、YAML、shell、SQL…，不用事先標記），並推出使用者的意圖。做法：①切成區段並認出每一段的語言（明確的記號——圍欄、<?php?>、<script type=x-shader>——信心最高；其餘逐行評分並用前後文平滑，單獨一行沒把握會沿用前後文，整段分數太低標「不確定」）②英文句子做詞類標註、片語切分，用 LALR 子句文法解析，抽出「動作＋對象＋修飾」框架（祈使句、問句、請求、「我想要…」；解析不了的句子保留原句、標低信心）③把「this shader」「the query below」「the error above」這類說法對回最近的、類型相符的區段④對上離線訓練器的意圖目錄（每個領域規則的意圖說明與例句），每個意圖附證據。全是程式計算，不呼叫模型；只做英文，語意只到「做什麼、對什麼」。來源三選一：text、file_id、path（桌面版）。回傳 {blocks, sentences, asks, intents, summary}。用這個工具決定要把問題交給哪個領域／工具，不要自己從頭猜。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._mixUnderstand(t);if(!e.ok)return JSON.stringify(e);const n=e.r;return JSON.stringify({ok:!0,source:e.source,languages:n.languages,blocks:n.mix.blocks.map(e=>({id:e.id,lang:e.lang,name:e.name,kind:e.kind,confidence:e.confidence,explicit:e.explicit,uncertain:e.uncertain||void 0,lines:[e.fromLine,e.toLine],evidence:e.evidence[0]})),sentences:n.sentences.slice(0,40).map(e=>({text:e.text.slice(0,160),type:e.frame.type,act:e.frame.act&&e.frame.act.lemma,object:e.frame.obj&&e.frame.obj.text,wh:e.frame.wh||void 0,kind:e.frame.intentKind||void 0,pps:e.frame.pps.map(e=>e.prep+" "+(e.np&&e.np.text)),parsed:e.frame.parsed,confidence:e.frame.confidence,refs:e.refs.map(e=>({block:e.block,lang:e.lang,why:e.reason})),intent:e.intents[0]?{id:e.intents[0].id,score:e.intents[0].score}:void 0})),asks:n.asks.slice(0,12),intents:n.intents,summary:n.summary})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{text:{type:"string",description:"混合內容的文字"},file_id:{type:"string"},path:{type:"string"}},additionalProperties:!1}),e("mix_highlight","把一份混合內容（英文敘述夾著 PHP、HTML、JavaScript、GLSL 著色器、TOML、INI、Python、CSS、JSON、YAML、shell、SQL、錯誤輸出…）自動切段、認出每段的語言並逐詞著色，不用事先標記。每一段有語言、信心度與依據（明確記號或逐行評分）；不確定的段落標「不確定」。區段裡專有的識別字會被學成該語言的詞（存起來，下次更準）。回傳區段清單，並產生一份 HTML 下載附件（暗色主題、每段有語言標籤與行號）；附件卡片上有「🪟 檢視器」按鈕，開一個跳出的浮動視窗檢視（open:true 會直接開）。來源三選一：text、file_id、path。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._mixAnalyze(t);if(!e.ok)return JSON.stringify(e);const n='<!doctype html><meta charset="utf-8"><title>混合內容語法高亮</title><body style="background:#1e1e1e;margin:12px">'+FaMix.toHtml(e.r)+"</body>",r=new Blob([n],{type:"text/html"}),s=await this.fileCache.put("mixed-highlight.html","text/html",r,"uploaded"),a={ok:!0,source:e.source,languages:e.r.languages,blocks:FaMix.describe(e.r),html_file_id:s,filename:"mixed-highlight.html"};return await this._deliverToolResultFile(a,"html_file_id",e=>"📎 混合內容語法高亮："+e.filename),!0===t.open&&this._openHtmlViewer(a.filename,n,s),JSON.stringify(a)}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{text:{type:"string",description:"混合內容的文字"},file_id:{type:"string"},path:{type:"string"},open:{type:"boolean",description:"true＝直接開檢視器視窗（預設只放下載卡片，卡片上有「檢視器」按鈕）"}},additionalProperties:!1}),e("log_learn",NaN,async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._logLearn(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{text:{type:"string",description:"貼上的日誌文字"},file_id:{type:"string",description:"上傳檔案的 file_id"},path:{type:"string",description:"（桌面版）日誌檔的絕對路徑"},name:{type:"string",description:"（選填）格式名稱，之後用它指定"},confirm:{type:"boolean",description:"預設 true：放卡片讓使用者確認；false 直接存"},kind:{type:"string",enum:["log","config","grammar"],description:"（選填）強制當日誌、章節式設定檔或自己長文法；省略＝自動判斷"},extend:{type:"string",description:"（選填）已存的文法名稱：讀這份新樣本，讓那份文法繼續長"},max_lines:{type:"integer",description:"最多分析幾行（預設 50000）"}},additionalProperties:!1}),e("log_triage",'把貼上的一段文字逐行分成三種：A＝使用者自己說的話、B＝程式印出來的 log、C＝堆疊的一層。含中文的句子也可能是 log，所以不看有沒有中文：堆疊由解析器判定，log 由專案索引核對（要跟索引記錄的 log 格式字串對得上），都不是的行才算「認不出」。action:triage（預設）回傳每行的分類與「認不出」的行，每個認不出的行附一題選擇題（A／B／C）；你回答後用 action:answer（answers 填 {"行號":"字母"}）交給程式核對——你說 B 但索引沒有這個訊息，程式會改回 A。root 是專案資料夾（要有資料庫索引，沒有索引就只做堆疊判斷）。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._repoTriage(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{root:{type:"string",description:"專案資料夾：fap:<名稱>，或桌面版的絕對路徑"},text:{type:"string",description:"貼上的全文"},action:{type:"string",enum:["triage","answer"]},answers:{type:"object",description:'answer：{"行號":"A|B|C"}'}},required:["text"],additionalProperties:!1}),e("log_ask",'對學過（或剛 log_learn 過）的日誌做摘要與問答，全是程式查詢：「摘要」「哪個錯誤最多」「錯誤什麼時候第一次出現」「有幾筆錯誤」「欄位 xxx 的值分布」「最忙的時段」「模板有哪些」「找 「xxx」在哪些行」。text 只給一行日誌＝問「這一行是什麼意思」（比對到哪個模板、欄位值、這種紀錄的統計）。開放式問題（原因、建議）程式不亂答，會回傳 kind:"open" 與精簡的模板統計脈絡（不是整份日誌），請你根據脈絡回答。要指定日誌：format（學過的格式名稱，省略＝最近一份）或直接帶 text／file_id／path 現學現問。找某個值需要原始行：同一個對話裡剛 log_learn 過的有，只存在訓練器裡的沒有（會明說需要檔案）。**設定檔**（INI／TOML／EDK2）的問法：「[database] 有哪些設定」「workers 設成多少」「哪些是布林／GUID／路徑」「有沒有重複的鍵」「Sources 有哪些原始檔」；text 給一行 key = value＝查這個鍵現在的值與型別；帶 other_text／other_file_id／other_path（另一份設定檔）＝比較兩份差在哪（改值、新增、移除）。機密欄位的值一律顯示為已遮蔽。**自己長出文法的格式**（YAML、BitBake、nginx…）：「SRC_URI 被怎麼設定」（列出所有操作與修飾，依順序）、「services.web.image 是什麼」（用路徑）、「services.web 有哪些設定」、「哪些用了 += 」、「有哪些 inherit」「有哪些函式」、「文法」（EBNF）、「antlr」（ANTLR 風格）、「bison」（遞迴的產生式，bison 風格）、「分析表」（LALR 狀態與 shift／reduce／goto）、「衝突」（shift/reduce、reduce/reduce）、「斷點」（哪幾行合成一個陳述、為什麼、續行符號與終結符號）；text 給一行＝同時回答 LALR 分析表接不接受它、卡在哪個 token、這裡本來可以接受什麼。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._logAsk(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{question:{type:"string",description:"問題；省略＝摘要"},format:{type:"string",description:"學過的格式名稱（省略＝最近一份）"},text:{type:"string",description:"一行日誌或一行 key = value（問這一行是什麼）、或整份日誌／設定檔文字"},file_id:{type:"string"},path:{type:"string"},other_text:{type:"string",description:"（設定檔比較）另一份設定檔的文字"},other_file_id:{type:"string"},other_path:{type:"string"},kind:{type:"string",enum:["log","config","grammar"]}},additionalProperties:!1}),e("webedit_open",'在對話裡放一個「網頁編輯器」（適用：網站、網頁編輯、HTML 頁面）（AI 輔助的小網站編輯器）：預覽、程式碼（HTML／CSS／JS 多個檔）、模擬後端（JS 的 Node 風格或 Python Flask／FastAPI；全部在頁面內執行、不佔埠，fetch／WebSocket／EventSource 都由它回應，資料持久，可匯出 Node／Cloudflare 部署檔），右邊用對話修改（頁面直接改；後端會交給程式設計專家並先在沙盒測過）、附圖、復原／重做、摘要成 prompt，進度會保留。參數：starter（起手式：blank、todo、chat、form、python_api）、或 request（一句話描述要做的網站，AI 先做出第一版）、或 spec（整份描述，格式見 webedit_topic）、或 id（重新打開之前的專案）。做完編輯器就在對話裡了，不要再把程式碼貼到對話。PHP 目前不能在瀏覽器裡執行。參數: {"starter":"todo","request":"（選填）","spec":{},"id":"（選填）"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._webeditOpen(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{starter:{type:"string",description:"起手式：blank、todo、chat、form、python_api"},request:{type:"string",description:"一句話描述要做的網站"},spec:{type:"object",description:"整份專案描述"},id:{type:"string",description:"重新打開之前的專案"},title:{type:"string"}},additionalProperties:!1}),e("webedit_topic",'查網頁編輯器的說明：topic=format（專案描述格式）、edits（編輯動作）、backend（模擬後端怎麼寫、語言限制）、starters（起手式清單）。參數: {"topic":"backend"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaWebEdit.TOPICS,r=String(t.topic||"");return JSON.stringify(n[r]?{ok:!0,topic:r,text:n[r]}:{ok:!0,topics:Object.keys(n)})},{type:"object",properties:{topic:{type:"string",enum:["format","edits","backend","starters"]}},additionalProperties:!1}),e("worksheet_make",'做一份學習單／練習卷（教育文書）：程式讀請求 → 排版成 SVG/HTML → 輸出 PDF（向量）＋預覽圖 PNG＋可再微調的 HTML，三個檔案都會變成下載卡片。現成的有：串珠「10又幾」（金色珠加幾顆彩色珠、右邊橫線填數字）、數的組成（二元樹：每格一直排積木、紅圈樹根、藍圈兒子寫數字）、數一數、十格框、數線、加減法算式；現成的做不到就用 draw（自由繪圖區塊，圓／方框／線／多邊形／文字，座標是百分比，見 worksheet_topic）自己畫，不要回答「模板不支援」。request＝使用者的原話（不要改寫）；有參考圖片就帶 reference_file_id（視覺模型只被問一小段 JSON：每串顆數與顏色，程式檢查後才採用）。也可以直接給 spec（描述格式見 worksheet_topic）。回傳 worksheet_id、notes（程式用了哪些預設）、questions（有歧義、已先用預設的地方）。參數: {"request":"使用者的原話","reference_file_id":"（選填）參考圖片","spec":{"（選填）整份學習單描述"}}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._worksheetMake(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{request:{type:"string",description:"使用者要的學習單（原話）"},template:{type:"string",description:"（選填）範本 id：blank、draw_area、bead_rows、number_bond、count_rows、ten_frames、number_line、equations，或使用者存的 user_…；見 worksheet_topic(templates)"},reference_file_id:{type:"string",description:"（選填）參考圖片的 file_id"},spec:{type:"object",description:"（選填）整份學習單描述，格式見 worksheet_topic"}},additionalProperties:!0}),e("worksheet_adjust",'調整剛做好的學習單（人工調整，不是重新生成）：edits 是一組封閉的編輯動作，例如改標題、改某一串的顏色、改串數、教師版附答案、換橫式、加減區塊。改完重新輸出 PDF／預覽圖／HTML。動作清單見 worksheet_topic({"topic":"edits"})。參數: {"edits":[{"op":"set_color","count":3,"color":"#F2D4CF"}],"worksheet_id":"（選填，預設最近一份）"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._worksheetAdjust(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{edits:{type:"array",items:{type:"object"},description:'編輯動作，例如 {"op":"set_title","text":"…"}'},worksheet_id:{type:"string"}},required:["edits"],additionalProperties:!1}),e("worksheet_open",'在對話裡放一個「學習單編輯器」（適用：學習單、教材、練習題、習作、考卷）小工具（可以直接在裡面用對話或屬性面板改、附圖、復原／重做、把編輯過程摘要成 prompt；進度會保留，之後可以接著改）。worksheet_make 做完會自動放一個；用這個工具來：重新打開某一份（worksheet_id）、接著最近一份、或開一份空白的讓使用者自己從對話開始做。參數: {"worksheet_id":"（選填，預設最近一份）","blank":false}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{let e=!0===t.blank?null:await this._wsLoadSpec(t.worksheet_id);if(!e){if(t.worksheet_id&&!0!==t.blank)return JSON.stringify({ok:!1,error:"找不到這份學習單："+t.worksheet_id});e={id:this._wsStoreSpec(FaWorksheet.validate({title:"學習單",blocks:[]}).spec)}}return this._wsPushEditor(e.id),JSON.stringify({ok:!0,worksheet_id:e.id,note:"編輯器已經放在對話裡了；告訴使用者可以直接在裡面改，不要再重複描述裡面的內容。"})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{worksheet_id:{type:"string"},blank:{type:"boolean",description:"true＝開一份空白的"}},additionalProperties:!1}),e("midi_play","在對話裡放一個「MIDI 播放卡片」:可以播放、暫停、拖進度、每軌靜音／獨奏／調音量、下載 MIDI、轉成 mp3。三種來源擇一:file_id(使用者上傳的 .mid／.midi 檔)、song_id(對話裡已有的曲子)、song(自己組一首:{title,tempo,timesig:[4,4],tracks:[{name,program(GM 音色編號 0–127),drum(true=鼓組),notes:[[第幾拍(從 0 起),幾拍長,音高(MIDI 60=中央 C),力度 1–127]]}]})。音色一律是 GS 音色庫的 GM 128 音色與鼓組。音樂知識(音階、和弦、音域、配器、風格)用 music_topic 查。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._midiSongFromArgs(t);if(e.error)return JSON.stringify({ok:!1,error:e.error});const n=this._midiPushCard(e.song,t.title||e.title);return JSON.stringify({ok:!0,song_id:n,summary:FaMidi.summary(e.song)})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{file_id:{type:"string",description:"使用者上傳的 MIDI 檔"},song_id:{type:"string"},song:{type:"object",description:"{title,tempo,timesig,tracks:[{name,program,drum,notes:[[拍,拍長,音高,力度]]}]}"},title:{type:"string"}},additionalProperties:!1}),e("midi_edit_open","在對話裡開「MIDI 編輯器」卡片（適用：音樂、曲子、歌曲、旋律、配樂、樂譜、鋼琴）(鋼琴捲簾、多音軌、只能選 GS 音色、復原重做、底下可用說的改)。來源同 midi_play:file_id、song_id 或 song;三者都沒有就開一首空白新曲。使用者說「編輯／修改這首 MIDI」時用。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{let e;if(t.file_id||t.song_id||t.song)e=await this._midiSongFromArgs(t);else{let t=FaMidi.emptySong();t=FaMidi.addTrack(t,"鋼琴",0),e={song:t}}if(e.error)return JSON.stringify({ok:!1,error:e.error});const n=this._midiPushEditor(e.song,t.title||e.title);return JSON.stringify({ok:!0,song_id:n,note:"編輯器已放進對話,使用者直接在卡片上改"})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{file_id:{type:"string"},song_id:{type:"string"},song:{type:"object"},title:{type:"string"}},additionalProperties:!1}),e("midi_song_jsonl","MIDI 曲子的「多層 JSONL」讀寫，讓任何窗口大小的模型都能讀完或寫完一首曲子（不必把整首塞進上下文）。action=read：給 song_id／file_id，levels=0 只回曲子與每軌一行、1 加每軌每小節一行（音域與音符數）、2（預設）全部音符；track（0 起算）與 bar 可只取某軌或某小節的音符。回傳第一頁 JSONL，其餘用 big_content page 讀。action=write：lines（字串陣列）或 text（一行一筆）是 read 產出的格式（song 行、track 行、note 行，音符只看 t／d／n／v），還原成曲子並開編輯器；回傳 missing 表示哪些軌的音符還沒給完。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{if("write"===String(t.action||"read")){const e=Array.isArray(t.lines)?t.lines:String(t.text||"").split(/\r?\n/).filter(e=>e.trim()),n=FaMidi.fromJsonl(e);if(!n.ok)return JSON.stringify({ok:!1,error:n.error});const r=this._midiPushEditor(FaMidi.validate(n.song),t.title||n.song.title||"");return JSON.stringify({ok:!0,song_id:r,tracks:n.song.tracks.length,missing:n.missing,errors:n.errors.length?n.errors.slice(0,5):void 0,note:n.missing.length?"有些軌的音符還沒給完（missing）；把缺的音符行補齊再 write 一次":"編輯器已放進對話"})}const e=await this._midiSongFromArgs(t);if(e.error)return JSON.stringify({ok:!1,error:e.error});let n;if(null!=t.track){const r=FaMidi.expandNotes(e.song,Number(t.track),null==t.bar?null:Number(t.bar));if(!r.ok)return JSON.stringify({ok:!1,error:r.error});n=r.lines}else n=FaMidi.toJsonl(e.song,{levels:null==t.levels?2:Number(t.levels)}).lines;const r={ok:!0,layer:"midi",title:e.song.title||void 0,how_to_read:'三層：song／track 行（第 0 層）→ bar 行（第 1 層，音域與音符數）→ note 行（第 2 層，t＝tick、d＝長度、n＝音高、v＝力度；bar／beat／name 是方便讀的）。要某軌某小節的音符用 midi_song_jsonl({"song_id":…,"track":0,"bar":3})。'},s=this._bigStashRecords(n,r,"midi_jsonl"),a=this._bigPage(s,null);return a&&a.ok?a.text:JSON.stringify(Object.assign({records:n.length},r))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{action:{type:"string",enum:["read","write"]},song_id:{type:"string"},file_id:{type:"string"},levels:{type:"number",description:"read：0／1／2"},track:{type:"number"},bar:{type:"number"},lines:{type:"array",items:{type:"string"}},text:{type:"string"},title:{type:"string"}},additionalProperties:!1}),e("midi_compose","依描述「作曲」並開 MIDI 編輯器(跟斜線指令 /media-compose-midi 走同一條路:有 AI 時由 AI 用選擇題理解風格範本、情緒、速度、調式、主奏樂器、長度與用途,程式逐欄核對,答錯只退回那一欄的預設;沒有 AI 才用範本規則,結果卡片會寫每個欄位是誰決定的):程式依風格範本產生(前奏／主歌／副歌結構、和弦進行、旋律、貝斯、和弦伴奏、鼓),旋律音域與跳進由程式檢查,失敗自動重來;你只需要選風格、調、速度、小節數、和弦進行編號(都可省略)。風格:pop 流行、rock 搖滾、jazz 爵士、blues 藍調、waltz 圓舞曲(3/4)、folk 民謠、lofi 低傳真、edm 電子舞曲、classical 古典;沒有專屬範本的風格或作曲家(貝多芬、重金屬、森巴…)會自動挑最接近的範本,結果裡有 style_note,要照實轉述、不要說成真的是那位作曲家的作品;結果是編輯器卡片,不要自己寫 Python／mido 腳本或把 .mid 寫到資料夾。也可以只給 description(中文描述,程式會讀出風格／調／速度／小節數)。遇到你不熟的作品、遊戲、電影或作曲家名字(例如某款遊戲的配樂),先用 browser_search 查它的調、調式、速度、樂器、和弦進行這類事實,再把查到的事實寫進 description 或 style／key／tempo 參數,不要憑印象猜,也不要照搬旋律;查到了就呼叫 music_work_learn 記進離線目錄(要附出處網址),下次同名的作品程式直接查表、不必再上網;查不到才照實說不確定。同樣的 seed 產生同樣的曲子,想換一首就換 seed。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=this._currentTurnUserText||"",n=this._midiComposeTurn&&this._midiComposeTurn.turn===e?this._midiComposeTurn:this._midiComposeTurn={turn:e,done:[]},r=e?FaComposePlan.repeatGuard(e,n.done.length):"";if(r)return JSON.stringify({ok:!0,duplicate:!0,song_id:n.done[n.done.length-1],note:r});const s={};t.style&&(s.style=t.style),t.key&&(s.key=t.key),t.tempo&&(s.tempo=t.tempo),t.bars&&(s.bars=t.bars);const a=a