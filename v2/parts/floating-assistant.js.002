f(Array.isArray(e))t=e.map(e=>[null,e]);else{if("object"!=typeof e)throw new Error("attachment_files必須是「工作目錄相對檔名」→「附件file_id或檔名」的物件（或file_id陣列）");t=Object.entries(e)}const n={};let r=0;for(const[e,s]of t){const t=String(s||"").trim();let a=null;try{a=await this.fileCache.get(t)}catch(e){}if(a||(a=await this._resolveUploadedFileRecord(t,{kindFilter:null})),!a||!a.blob)throw new Error(`找不到附件「${t}」（用list_uploaded_files查詢目前可用的file_id/檔名）`);if(r+=a.blob.size,r>104857600)throw new Error("attachment_files總大小超過100MB");n[String(e||a.filename).replace(/^\/+/,"")]=new Uint8Array(await a.blob.arrayBuffer())}return n},f=function(e){const t={};for(const[n,r]of Object.entries(e))t[n.replace(/^\/+/,"")]=this._fnv1a("string"==typeof r?(new TextEncoder).encode(r):r);return t},h=function(e,t){return e.filter(e=>t[e.relPath]!==this._fnv1a(e.bytes))},g=async function(e){let t=0;if(e&&"persistent_storage"===e.destination)for(const n of e.files.slice(0,5))try{await this._deliverExistingCacheFile(n.file_id,`📎 產出檔案：${n.path}（${(n.sizeBytes/1024).toFixed(n.sizeBytes<102400?1:0)}KB）`),t++}catch(e){}return t},y={type:"object",properties:{script:{type:"string",description:"要執行的腳本內容"},input_files:{type:"object",description:'選填，{"相對路徑":"檔案內容"}，執行前寫進工作目錄，腳本可以直接讀取'},attachment_files:{type:"object",description:'選填：{"工作目錄相對檔名":"📎附件的file_id或檔名"}（也可給file_id陣列），執行前把附件的原始內容（二進位檔也行）放進工作目錄讓腳本編修；產出的新檔案/修改過的檔案會存回persistentStorage並直接顯示下載卡片給使用者'},isolated:{type:"boolean",description:"選填（只有 python_execute 用）：true＝在獨立的 Worker 裡跑，不卡住畫面（長時間的純計算用，例如影像處理）；Worker 裡沒有轉接層，不能用 subprocess、連網、openai／anthropic 轉接、檔案存取點。預設 false"},real_input_files:{type:"object",description:'選填：{"工作目錄相對檔名":"真實絕對路徑，或\'fap:<名稱或id>[/<路徑>]\'參照使用者已授權的File Access Point"}，執行前會先讀取這些真實檔案的目前內容再寫進工作目錄（跟input_files合併，鍵名衝突時以這裡為準）。兩種格式各自需要對應的能力才能用，只有兩者都用不上時才會得到明確錯誤。'},output_ref:{type:"string",description:'選填，"fap:<名稱>[/<子路徑>]"存進File Access Point；如果目前環境已經提供對應能力，也可以直接給一個真實磁碟絕對路徑；留空存進persistentStorage（回傳file_id）'}},required:["script"],additionalProperties:!1};e("bash_execute",'在瀏覽器沙盒內執行一段bash/sh腳本（busybox ash+coreutils：ls/cat/grep/sed/awk/find/mkdir/echo/管線|/重導向>/>>/&&/||都支援）。腳本執行過程本身是完全隔離的沙盒，不會碰到使用者電腦真正的檔案系統，也沒有對外網路連線能力（需要外部資料請先用browser_search/fetch_web_page等工具取得，不要在腳本裡wget/curl）；但輸入/輸出兩端（見input_files/real_input_files/output_ref參數）如果目前環境已經提供對應能力，可以直接對接真實磁碟路徑。**這個shell額外認得幾個按需下載的指令**（第一次用到才會下載對應的執行環境，不會拖慢沒用到這些指令的呼叫）：`python`/`python3`（Pyodide，可以直接寫`python script.py | jq .`這類管線；這個路徑跑的python**不支援top-level await、也不支援subprocess**（呼叫subprocess.run會直接失敗），需要這兩個能力請改用python_execute工具，那邊的python完整支援subprocess.run(["python3","x.py"])／subprocess.run(["sh","-c","..."])回頭呼叫shell/其他python腳本）、`jq`（真正的jq，支援`-r`/`-c`/`-s`旗標）、`xq`（XML轉JSON再套用jq filter）、`column -t`/`split -l N`（busybox這個build沒有內建這兩個，補了同步JS版本）。⚠️**`time`關鍵字不支援**（shell語法層特殊處理，這個沙盒的host builtin機制補不了），需要量測耗時請改用python的`time.perf_counter()`或自己在腳本裡記錄。腳本的工作目錄是/work，input_files/real_input_files會先寫進這裡，執行後/work底下所有檔案（含輸入檔案原本的內容跟腳本新增/修改的）都會依output_ref規則處理（見output_ref參數說明）。**任務裡如果提到一個真實檔案（絕對路徑如"/home/user/xxx.py"，或使用者提過的File Access Point裡的檔案），尤其使用者說「我改過了」這種暗示要讀取最新內容的情境，用real_input_files直接把它讀進來，不要因為「我沒辦法存取你的檔案系統」就放棄或叫使用者貼上程式碼——兩種參照格式各自需要對應的能力，只有兩者都用不上時才會得到明確錯誤，如實告知使用者即可**。⚠️沒有逾時中斷機制，避免寫真正的無窮迴圈。參數: {"script":"echo hello; ls /work", "input_files":{"data.txt":"..."}, "real_input_files":{"compute_pi.py":"/home/user/AI-Workspace/compute_pi.py"}, "output_ref":"fap:我的專案/build"}**編修使用者的📎附件**：用attachment_files參數（{"工作目錄相對檔名":"附件file_id或檔名"}，二進位檔也行，file_id用list_uploaded_files查）把附件放進工作目錄，腳本讀取、修改後寫回同名檔案（或寫成新檔案）即可；執行完畢後，「新增或內容有變」的檔案會存回persistentStorage並直接在對話裡顯示下載卡片給使用者（原封不動的輸入檔不會重複產出），你只需要用一兩句話說明改了什麼、不要把整份檔案內容貼回對話。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=this._terminalRewriteBuiltinPaths(String(t.script||t.code||t.source||t.python||t.bash||""));if(!n.trim())return JSON.stringify({ok:!1,error:"缺少script參數"});if(n.indexOf(String.fromCharCode(0))>=0)return JSON.stringify({ok:!1,error:"腳本裡有 NUL 字元（U+0000），shell 無法處理，會在那裡截斷。如果你要的是「反斜線加 00」這幾個字（例如 LLVM IR 的字串結尾），表示產生腳本的程式把它當跳脫序列解開了，請把反斜線寫成兩個，或改用 input_files 寫檔案。"});let r;try{r=p(t.input_files),Object.assign(r,await u.call(this,t.real_input_files)),Object.assign(r,await m.call(this,t.attachment_files))}catch(e){return JSON.stringify({ok:!1,error:e.message})}const s=f.call(this,r);let a;try{a=await this._ensureBashWasmLoaded()}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}const i={};for(const[e,t]of Object.entries(r))i["/work/"+e.replace(/^\/+/,"")]=t;const o=a.memoryFs(i);try{o.mkdirSync("/work",{uid:0,gid:0,mode:493})}catch(e){}const l=Object.keys(SANDBOX_COMMAND_REGISTRY).filter(e=>new RegExp(`(^|[\\s;|&()\`])${e}(?=[\\s;|&()\`]|$)`).test(n)),c={};for(const e of l){const t=SANDBOX_COMMAND_REGISTRY[e].kind;try{"pyodide"!==t||c.pyodide||(c.pyodide=await this._ensurePyodideLoaded()),"jq"!==t||c.jq||(c.jq=await this._ensureJqLoaded()),"xq"===t&&(c.jq||(c.jq=await this._ensureJqLoaded()),c.xmlParser||(c.xmlParser=await this._ensureXqXmlParserLoaded()))}catch(t){return JSON.stringify({ok:!1,error:`指令「${e}」需要的執行環境載入失敗：${String(t.message||t)}`})}}const d={};for(const e of l)d[e]=t=>this._runSandboxBuiltinCommand(SANDBOX_COMMAND_REGISTRY[e].kind,t,c);const y=this._activeSandboxFsStack||(this._activeSandboxFsStack=[]);let b;y.push(o);try{b=await a.run({command:n,fs:o,wasm:a.wasmBytes.slice(0),inline:!0,builtins:d})}catch(e){return JSON.stringify({ok:!1,error:`執行失敗：${String(e.message||e)}`})}finally{y.pop()}const v=h.call(this,this._walkMemoryFsDir(o,"/work"),s);let _;try{_=await this._persistExecutionOutputFiles(v,t.output_ref)}catch(e){return JSON.stringify({ok:!1,error:`執行成功但輸出檔案儲存失敗：${String(e.message||e)}`,stdout:b.stdout,stderr:b.stderr,exit_code:b.exitCode})}const w=await g.call(this,_);return JSON.stringify({ok:!0,stdout:b.stdout,stderr:b.stderr,exit_code:b.exitCode,output_destination:_.destination,output_files:_.files,download_cards_shown:w})},y),e("catalog_onboard",'認識一個新的 Python 函式庫：（PyPI 套件要使用者同意）安裝→抽取每個函式的簽名、型別、副作用→在沙盒裡探測純函式、驗證型別→登記成可用的「單元」並存檔。回傳：單元數、可信任的數量、沒晉升的原因。參數：{"modules":["要抽取的模組（匯入名稱）"],"packages":["PyPI 套件名稱，可加==版本；標準庫不用填"],"probe":true}。只接受 PyPI 套件名稱，不接受網址或 git。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=this._createProgressWidget("🧩 認識新函式庫："+(Array.isArray(t.modules)?t.modules.join("、"):String(t.modules||""))),r=await this._unitCatalogOnboard(t,n);return r.ok?n.finish("完成："+r.units+" 個單元，可信任 "+r.trusted):n.fail(r.error),JSON.stringify(r)},{type:"object",properties:{modules:{type:"array",items:{type:"string"},description:"要抽取的模組（匯入名稱，例如 statistics、yaml）"},packages:{type:"array",items:{type:"string"},description:"要安裝的 PyPI 套件（可加 ==版本）；標準庫不用填"},probe:{type:"boolean",description:"是否探測純函式（預設 true）"}},required:["modules"],additionalProperties:!1}),e("catalog_query","查詢單元目錄（已認識的函式、工具）。action：search（text 關鍵字；可加 takes／returns 型別、trusted、runtime、limit）、show（id）、path（from、to 型別字串，找出幾步接得起來的接線；cast=true 允許不明型別強制轉型）、plan（同 path，但直接產生可以交給 catalog_run 的程式骨架）、stats。trusted＝型別已知且有測試或探測驗證過；沒 trusted 的要先告知風險。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return await this._unitCatalogStoreLoad(),JSON.stringify(this._unitCatalogQuery(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{action:{type:"string",enum:["search","show","path","plan","stats"]},text:{type:"string"},id:{type:"string"},from:{type:"string"},to:{type:"string"},takes:{type:"string"},returns:{type:"string"},trusted:{type:"boolean"},runtime:{type:"string"},limit:{type:"number"},cast:{type:"boolean"}},additionalProperties:!1}),e("catalog_run",'執行一個「呼叫格式」程式（把幾個單元接起來）。先靜態檢查（單元存在、參數齊全、型別接得上、副作用彙整），有風險的副作用會先請使用者同意整個程式。格式：{"inputs":{"名稱":{"type":"url"}},"steps":[{"id":"s1","call":"單元id","args":{"參數":{"$in":"名稱"}|字面值|{"$ref":"前一步id.欄位"}}},{"id":"s2","each":{"$ref":"s1.items"},"max":10,"do":[…]},{"id":"s3","if":{"$ref":"s1.ok"},"then":[…],"else":[…]}],"return":{"$ref":"s2"}}。另外給 args（輸入值）。dry_run=true 只檢查與模擬、不呼叫。要先用 catalog_query 的 plan 取得骨架。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}if(!t.program||"object"!=typeof t.program)return JSON.stringify({ok:!1,error:"缺少 program（物件）"});try{await this._unitCatalogStoreLoad();const e=await this._unitCatalogRunProgram(t.program,t.args||{},{dryRun:!0===t.dry_run});return JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{program:{type:"object",description:"呼叫格式程式（inputs、steps、return）"},args:{type:"object",description:"輸入值（對應 program.inputs）"},dry_run:{type:"boolean"}},required:["program"],additionalProperties:!1}),e("catalog_bind","把 UML 使用案例接到單元目錄的單元（需求 → 活動 → 單元），純程式、0 次模型呼叫。給 UML 文字（一行一件事，格式同 uml_to_code：actor: User／class PdfService { +download(url:Url):FileId; +countPages(pdf:PdfFile):int }／usecase 名稱: User -> PdfService.download(url) -> PdfService.countPages(pdf):int），回傳每個使用案例每一步挑到的單元（檢索＋型別合約打分）、資料流怎麼接（同名優先，其次型別接得上；接不上用型別接線矩陣找橋接單元）、可以直接交給 catalog_run 的呼叫程式與檢查結果。沒有單元對得上的步驟會列在 issues，不會亂猜。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{await this._unitCatalogStoreLoad(),await this._unitCatalogShapeLoad();const e=await this._unitCatalogBindAsync(String(t.uml||""));return e.ok?JSON.stringify({ok:!0,model:e.model,summary:e.summary,semantic:e.semantic,semantic_note:e.semantic_note,usecases:e.results.map(e=>({usecase:e.usecase,valid:e.valid,errors:e.errors,bound:e.bound+"/"+e.total,steps:e.steps.map(e=>({step:e.step,unit:e.unit||e.units||null,by:e.by,score:e.score})),issues:e.issues,effects:e.effects,program:e.program}))}):JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{uml:{type:"string",description:"UML 文字（格式見工具說明）"}},required:["uml"],additionalProperties:!1}),e("catalog_intent",'管理單元目錄的「中文用途說明」——一句中文，讓中文需求找得到名稱與說明都是英文的單元（實測：加了用途說明，找單元前 5 名命中率 60.5% → 92.1%）。action:"missing" 列出還沒有中文說明的單元（id、英文說明、必填參數）；action:"set" 一次補多個，items 是 {單元id: "一句中文說明"}（2～80 字、要有中文、單元要存在；寫「做什麼」加幾個同義說法，例如「算母體標準差」「把一段長文字依寬度折成多行 自動換行」，不要寫實作細節）；action:"list" 看目前全部。補完後語意檢索的單元向量會在下次 /unit-catalog embed build 重算。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{await this._unitCatalogStoreLoad(),await this._unitCatalogIntentsLoad();const e=String(t.action||"missing");if("set"===e){if(!t.items||"object"!=typeof t.items)return JSON.stringify({ok:!1,error:"items 要是 {單元id: 中文說明}"});const e=await this._unitCatalogIntentSet(t.items);return JSON.stringify(Object.assign({ok:!0},e))}if("list"===e)return JSON.stringify({ok:!0,intents:this._unitCatalogIntents()});const n=this._unitCatalogIntentMissing(),r=Math.max(1,Math.min(60,Number(t.limit)||30));return JSON.stringify({ok:!0,missing_total:n.length,units:n.slice(0,r).map(e=>({id:e.id,summary:e.summary,params:e.params.filter(e=>e.required).map(e=>e.name)}))})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{action:{type:"string",enum:["missing","set","list"],default:"missing"},items:{type:"object",description:'action:"set" 用：{單元id: "一句中文說明"}'},limit:{type:"number",description:'action:"missing" 最多列幾個（預設 30，最多 60）'}},additionalProperties:!1}),e("catalog_card","讀一份很長的說明文件（GitHub 倉庫的 README、使用手冊、設計文件、維基、StackOverflow 問答），整理成「能力卡片」：一句說明、語言、執行環境（瀏覽器／Node／Python）、安裝指令或 CDN 網址、主要函式、能力描述（動詞＋受詞）、需要的條件（相機、WebGL、模型檔、API 金鑰…）、授權、是否停止維護，每個欄位附信心。長文用「地圖縮放」：先切成章節樹，依重要性（安裝、用法、功能、API）在字數預算內由大到小放大讀，每片段各自抽事實再投票融合——不是整份塞給模型。給 url（GitHub 倉庫網址會自動抓 README）或 text；kind 可選 readme／qa／wiki／guide／design。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._unitCatalogCard(t);return JSON.stringify({ok:!0,kind:e.kind,chars:e.chars,card:e.card})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{url:{type:"string",description:"說明文件的網址（GitHub 倉庫網址會自動取 README）"},text:{type:"string",description:"直接給文字（跟 url 二選一）"},kind:{type:"string",enum:["readme","qa","wiki","guide","design"],description:"文件種類，影響章節的重要性判斷（預設 readme）"},name:{type:"string"},description:{type:"string",description:"搜尋結果給的一句話描述（有的話優先當說明）"},budget_chars:{type:"number",description:"最多讀幾個字（預設 12000）"},context_tokens:{type:"number",description:"模型的上下文長度，用來決定每片大小"}},additionalProperties:!1}),e("catalog_js","把一份 JavaScript 原始碼（未壓縮的 .js 檔網址，或直接給文字）抽成單元登記進單元目錄：找出對外提供的函式與類別方法（ES module export、CommonJS、UMD 工廠函式、瀏覽器全域函式、prototype 方法），參數與回傳型別來自 JSDoc、預設值、參數名稱，副作用（網路、DOM、相機、檔案、計時…）靜態分析並順著呼叫鏈合併。不執行任何程式碼；信任等級一律 0，規劃時才會被用到。壓縮過的檔案函式名稱已被縮短，抽出來沒什麼用。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._unitCatalogJsOnboard(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{url:{type:"string"},text:{type:"string"},pkg:{type:"string",description:"單元名稱的前綴（預設取檔名）"},version:{type:"string"}},additionalProperties:!1}),e("catalog_discover","缺口驅動的探索：給 UML 使用案例（uml）或需要的能力清單（needs），先用單元目錄接線，沒有單元可用的步驟就是「缺口」；為每個缺口產生英文搜尋關鍵字、用 browser_search 找（github、wiki、stackoverflow、codeproject…）、讀 README（長文地圖縮放＋多片段投票，見 catalog_card）、整理成能力卡片、依缺口排名（說明相符、執行環境相容、有沒有停止維護、需不需要金鑰或伺服器），輸出計畫：每個缺口建議用哪個專案、怎麼安裝、主要函式、需要什麼、備選是誰；找不到的明講。extract 不是 false 時，如果卡片有未壓縮的 CDN 檔會順手抽成單元再接一次線看缺口有沒有補上。這個工具只規劃，不安裝也不執行。計畫出來後，只有真的有分歧的地方（幾個候選分數差不多、推薦的需要金鑰或伺服器而備選不需要、只勉強過門檻、找不到）才會跳選擇題問使用者，沒有分歧的直接用推薦的；使用者不點選項、直接打字，就當成補充（內容在 user_notes，裡面的網址在 user_urls，可以拿去 catalog_card 讀）。decisions 是使用者做的決定，照它做，不要再問一次。找不到或只勉強過門檻的缺口，會先反思：可能打錯字（問使用者要不要改成猜的那個、或讓他直接打自己的說法，改正後再找一次）、可能是新的需求（reflections 裡 kind 是 novel、novel 列出缺口）——這種不是「找不到」，是「還沒有」：照 novel_next 改用 UML 拆成極小的單元、現有的用 catalog_bind 接線、沒有的才新寫，寫好用 catalog_onboard 回填目錄。reflect:false 可以關掉反思。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._unitCatalogDiscover(t);return JSON.stringify({ok:e.ok,plan_id:e.plan_id,feedback_hint:"使用者採用或退回、或你試跑之後，用 catalog_feedback 記下來（plan_id＋gap＋verdict）",gaps:e.gaps_initial,resolved:e.resolved,rounds:e.rounds,candidates:(e.candidates||[]).map(e=>{const{card:t,features:n,need:r,...s}=e;return Object.assign(s,{alternatives:(s.alternatives||[]).map(e=>({name:e.name,url:e.url,score:e.score}))})}),references:e.references,unresolved:e.unresolved,decisions:e.decisions,user_notes:e.user_notes,user_urls:e.user_urls,reflections:e.reflections,novel:e.novel,novel_next:(e.novel||[]).length?FaCatalogReflect.NOVEL_NEXT:void 0,text:e.text,error:e.error})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{reflect:{type:"boolean",description:"false＝不做反思（預設：找不到或只勉強過門檻的缺口，先想想是不是打錯字、或是新的需求）"},ask:{type:"boolean",description:"false＝遇到分歧也不問使用者，全部用推薦的（預設：只有真的有分歧才問，一次最多3題）"},max_questions:{type:"number",description:"一次最多問幾題，預設3"},uml:{type:"string",description:"UML 文字（格式同 catalog_bind）"},needs:{type:"array",items:{type:"string"},description:"沒有 UML 時，直接列需要的能力（中英文都可以）"},runtime:{type:"string",enum:["browser","node","python"],default:"browser"},extract:{type:"boolean",description:"false＝不要抽單元，只規劃"},use_learned:{type:"boolean",description:"true＝用 catalog_feedback train 存下來的排名模型（資料夠才有意義）"},use_embed:{type:"boolean",description:"false＝不用嵌入模型排名（語意檢索有啟用才會用）"},use_model:{type:"boolean",description:"true＝用離線小模型把需求改寫成英文搜尋關鍵字（實測這一步它比詞庫好）；預設不用"},max_gaps:{type:"number"},per_gap:{type:"number"},context_tokens:{type:"number"}},additionalProperties:!1}),e("catalog_feedback",'把 catalog_discover 計畫的結果記成標註，累積成排名模型的訓練資料。verdict：adopt（使用者採用了推薦的專案）、reject（使用者退回，可附 reason）、run_ok（拿它在沙盒試跑成功）、run_fail（試跑失敗，附 error 原文——權限、網路、資源、逾時這類環境問題不會算成專案不好，API 用錯、缺套件、沒定義算輕的負例）。gap 是缺口編號（例如 need/1），不給就是計畫裡全部；url 可以指定備選專案；plan_id 不給就用最近一次的計畫。使用者明講採用或退回時、你在沙盒試過它之後，都要呼叫。另外 action:"stats" 看累積多少、夠不夠訓練；"train" 做留一組交叉驗證（save:true 才存模型）；"export" 匯出 JSON；"clear" 清掉。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._unitCatalogFeedback(t);return e.json&&delete e.json,JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{verdict:{type:"string",enum:["adopt","reject","run_ok","run_fail"]},gap:{type:"string",description:"缺口編號，例如 need/1 或 使用案例/類別.操作"},url:{type:"string",description:"要評的候選網址（不給就是推薦的那個；可以給備選的）"},plan_id:{type:"string"},reason:{type:"string"},error:{type:"string",description:"run_fail 的錯誤訊息原文"},action:{type:"string",enum:["stats","train","export","clear"]},save:{type:"boolean"},force:{type:"boolean"},dense:{type:"boolean",description:"false＝訓練時不用嵌入特徵"}},additionalProperties:!1}),e("mcp_servers","列出已安裝的 MCP 伺服器：名稱、連線方式（stdio／http／sse）、狀態（stopped／starting／ready／error／disabled）、工具數、錯誤訊息。呼叫 MCP 工具之前先用這個確認有哪些伺服器可以用。",async function(){try{return await this._mcpLoad(),JSON.stringify({ok:!0,desktop:!!this._mcpBridge(),servers:this._mcpStore.servers.map(e=>this._mcpPublic(e))})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{},additionalProperties:!1}),e("mcp_tools","列出某個 MCP 伺服器提供的工具（必要時會先啟動它）：每個工具的名稱、說明、必填參數；加 tool 參數會回傳那個工具完整的輸入格式（JSON Schema）。不要猜工具名稱與參數，先用這個查。query 可以用關鍵字篩選。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=String(t.server||"");if(!e)return JSON.stringify({ok:!1,error:"要給 server（用 mcp_servers 查名稱）"});const n=await this._mcpStart(e);if(t.tool){const e=n.tools.find(e=>e.name===t.tool);return JSON.stringify(e?{ok:!0,tool:e}:{ok:!1,error:"沒有工具 "+t.tool,tools:n.tools.map(e=>e.name).slice(0,30)})}const r=String(t.query||"").toLowerCase().trim(),s=n.tools.filter(e=>!r||(e.name+" "+(e.description||"")).toLowerCase().includes(r));return JSON.stringify({ok:!0,server:e,instructions:n.instructions?String(n.instructions).slice(0,600):void 0,total:n.tools.length,tools:s.slice(0,60).map(e=>({name:e.name,description:String(e.description||"").slice(0,240),required:e.inputSchema&&e.inputSchema.required||[],params:Object.keys(