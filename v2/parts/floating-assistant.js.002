aHarnessExp.makeRecord({template:"media-compose-midi",task:"作品特徵:"+e.work.name,verdict:"ok",steps:[{id:"work",kind:"choice",by:"program",tries:1,ok:!0}],slots:{work:e.work.name,style:e.work.style,key:e.work.key,mode:e.work.mode,tempo:String(e.work.tempo)},missing:[]}),n=FaHarnessExp.gate(t);r=n.accept?"已送進 harness 經驗":"經驗閘門沒收:"+n.reason}catch(e){r="經驗閘門略過:"+String(e&&e.message||e)}return JSON.stringify({ok:!0,saved:e.work.name,count:n.length,harness:r,note:"已記進離線目錄,之後作曲遇到「"+e.work.keys.join("、")+"」會直接套用這些特徵"})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{name:{type:"string"},aliases:{type:"array",items:{type:"string"},description:"別名、英文名、系列簡稱"},key:{type:"string",description:"主音,如 D、Eb、F#"},mode:{type:"string",enum:["major","minor"]},tempo:{type:"number",description:"40 到 220 拍/分"},style:{type:"string",enum:["pop","rock","jazz","blues","waltz","folk","lofi","edm","classical"],description:"最接近的風格範本"},hint:{type:"string",description:"一句話事實:樂器、和弦進行、氛圍,不要寫旋律"},source_url:{type:"string",description:"查到這些事實的網頁網址"}},required:["name","key","mode","tempo","style","hint","source_url"],additionalProperties:!1}),e("midi_to_mp3","把 MIDI 用 GS 音色庫離線渲染並編成 mp3 檔(變成下載卡片)。來源同 midi_play:file_id、song_id 或 song。第一次要下載瘦身版音色庫(大小會顯示在下載進度);長曲子會花一些時間。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._midiSongFromArgs(t);if(e.error)return JSON.stringify({ok:!1,error:e.error});const n=Date.now(),r=await this._midiToMp3(e.song),s=String(t.title||e.title||e.song.title||"song").replace(/[\\/:*?"<>|]/g,"_")+".mp3";return await this.generateAndDeliverFile(r,s,"audio/mpeg"),JSON.stringify({ok:!0,filename:s,size_kb:Math.round(r.size/1024),seconds:Math.round(FaMidi.durationSec(e.song)),render_ms:Date.now()-n})}catch(e){return JSON.stringify({ok:!1,error:"轉 mp3 失敗:"+String(e&&e.message||e)})}},{type:"object",properties:{file_id:{type:"string"},song_id:{type:"string"},song:{type:"object"},title:{type:"string"}},additionalProperties:!1}),e("soundtrack_make","把一首 MIDI 或一個 mp3／wav 做成「配樂」,可以用在簡報(edit-media-presentation)、2D／3D 遊戲(edit-game-2d、edit-game-3d)、影片剪輯(edit-video)。來源擇一:file_id(使用者上傳的 .mid／mp3／wav)、song_id(對話裡的 MIDI)、song。可設音量 volume 0–1(預設 0.35)、loop(預設循環)、fade_in／fade_out 秒、offset 從第幾秒開始。回傳 soundtrack_id;使用者在各編輯器裡按「🎼 配樂」就能挑「對話裡剛做好的配樂」套用。MIDI 要第一次下載音色庫才聽得到,其實是用到才下載。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._soundtrackSpecFromArgs(t);if(e.error)return JSON.stringify({ok:!1,error:e.error});const n=this._soundtrackRemember(e.spec);return JSON.stringify({ok:!0,soundtrack_id:n,kind:e.spec.kind,title:e.spec.title,volume:e.spec.volume,loop:e.spec.loop,fade_in:e.spec.fadeIn,fade_out:e.spec.fadeOut,note:"請使用者在簡報／遊戲／影片編輯器按「🎼 配樂」,選「對話裡剛做好的」套用"})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{file_id:{type:"string"},song_id:{type:"string"},song:{type:"object"},soundtrack_id:{type:"string"},title:{type:"string"},volume:{type:"number"},loop:{type:"boolean"},fade_in:{type:"number"},fade_out:{type:"number"},offset:{type:"number"}},additionalProperties:!1}),e("audio_to_midi",'把使用者上傳的 mp3／wav 音訊轉成 MIDI 並開編輯器(離線,小模型在這台電腦跑:Basic Pitch 多音轉譜＋YAMNet 挑音色;stems=true 時再用 Demucs 分成鼓／貝斯／人聲／吉他／鋼琴／其他,要多下載約 136 MB 而且很慢)。第一次要下載模型(約 16 MB,存在本機)。結果不保證準確,拆樂器只到分軌模型給的幾軌;回覆使用者時要把工具結果裡 skipped 列的沒做到的部分講清楚。參數: {"file_id":"…","stems":false}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._audioToMidi(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{file_id:{type:"string",description:"使用者上傳的音訊檔"},stems:{type:"boolean",description:"true＝先用 Demucs 分軌(下載約 136 MB、很慢)"},title:{type:"string"}},required:["file_id"],additionalProperties:!1}),e("music_topic","查音樂知識:basics(音高與記號、速度、tick)、scales(音階與調性)、chords(和弦與常見進行)、rhythm(拍號與鼓型)、ranges(各樂器音域與鼓組編號)、instrumentation(GM 音色編號與配器)、structure(曲式)、styles(各風格典型)。不帶 topic 回傳全部主題名稱。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaMusicKnowledge,r=String(t.topic||"");return JSON.stringify(n.TOPICS[r]?{ok:!0,topic:r,text:n.TOPICS[r]}:{ok:!0,topics:n.ORDER})},{type:"object",properties:{topic:{type:"string",enum:["basics","scales","chords","rhythm","ranges","instrumentation","structure","styles"]}},additionalProperties:!1}),e("worksheet_topic",'查學習單的進階說明：topic=format（描述格式與每種區塊的欄位）、templates（範本清單）、draw（自由繪圖區塊）、number_bond（數的組成）、edits（調整動作清單）、reference（用參考圖片的做法）、colors（串珠標準色）。參數: {"topic":"format"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaWorksheet.TOPICS,r=String(t.topic||"");return"templates"===r?JSON.stringify({ok:!0,topic:r,text:n.templates,templates:FaWorksheet.listTemplates(this._wsUserTemplates()).map(e=>({id:e.id,name:e.label,about:e.desc,group:e.group}))}):JSON.stringify(n[r]?{ok:!0,topic:r,text:n[r]}:{ok:!0,topics:Object.keys(n),note:'用 {"topic":"format"} 等查看'})},{type:"object",properties:{topic:{type:"string",enum:["format","templates","draw","number_bond","edits","reference","colors"]}},additionalProperties:!1}),e("ask_user_card",'在對話裡放一張「互動卡片」讓使用者填（表單或多步驟 wizard），等使用者送出後把回應交給你。用在「需要使用者從幾個選項裡決定、或補幾個欄位」而你不該替他猜的時候，比用文字一題一題問快。使用者看到的是勾選／單選／下拉／文字框，送出後卡片變唯讀；回應只回傳給這個工具，不會變成使用者訊息。規格 spec：{title, description, questions:[…]}（單張表單）或 {title, steps:[{id,title,questions,next:[{when:{q,eq|in|has|nonEmpty},goto:步驟id|"done"}]}]}（wizard，next 沒寫就依序）。題目 {id, type, label, hint, required, default, showIf:{q,eq|in|has|nonEmpty}, media:{text,image(https或data:image),html(可互動的 widget，在沙盒 iframe，用 window.faCard.answer(值) 回傳；type 要是 widget),height}}。type：single（單選）、multi（多選，minSelect／maxSelect）、dropdown、text、textarea、number（min／max）、color、widget、info（只顯示）。single／multi 的選項 {id,label,desc,image,color(#rrggbb 色塊),extra:{kind:"text"|"select",options,required}}：extra 是選項後面的文字框或下拉（選到那個選項才能填）；題目還可以有 after:[{id,kind:"text"|"select",label,options}] 固定接在選項後面。id 一律英文字母開頭。回傳 {ok,confirmed,status,answers:{題目id:值,"題目id.選項id":後面欄位的值},summary:[…]}；confirmed=false 是使用者取消；如果回傳 skipped:true 與 supplement，代表使用者沒點選項、直接打字回答，那段文字就是他的回答與補充條件，照它做。只在計畫真的有分歧（幾條做法差很多、缺必要資訊又沒有合理預設、動作不可逆）時才問，每題要標出建議的選項，一次最多問2到3題，其餘用預設值並在計畫裡註明。需要依回應決定下一張卡片：用這個工具兩次，第二次的規格依第一次的回應來寫。',async function(e){if(this._subchatIsChild())return JSON.stringify({ok:!1,error:"這個對話是子對話，提問由根對話負責；需要使用者決定的事請直接用文字寫在回覆裡，系統會顯示在根對話的連結卡片上"});let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=t.spec&&"object"==typeof t.spec?t.spec:t,r=await this.askCard(n);return r.ok?r.useRecommended?JSON.stringify({ok:!0,confirmed:!1,skipped:!0,use_defaults:!0,answers_so_far:r.flat,note:"使用者說之後都不要再問、統一用建議的：這題不用他回答，請用你認為最合理的預設做，並在回覆裡簡短說你用了什麼；之後同類的分歧也直接用建議的，不要再用這個工具問。"}):r.supplement?JSON.stringify({ok:!0,confirmed:!1,skipped:!0,status:r.status,supplement:r.supplement,answers_so_far:r.flat,note:"使用者沒有用卡片作答，改成直接打字回答（內容在 supplement，也已顯示在對話裡）。請把它當成使用者對這個問題的回答與補充條件，照它調整做法；不要當成使用者取消，也不要把同一題再問一次。"}):JSON.stringify({ok:!0,confirmed:r.confirmed,status:r.status,answers:r.flat,summary:r.summary,steps:r.steps}):JSON.stringify({ok:!1,error:r.error,hint:"修正規格後再呼叫一次"})},{type:"object",properties:{spec:{type:"object",description:"卡片規格：{title,description,questions} 或 {title,steps:[…]}，欄位見工具說明"}},required:["spec"],additionalProperties:!0}),this.register_openai_tool("chat_list_children","列出目前對話的子對話（id、標題、狀態、摘要）。只在已經有子對話時有用。",async function(){const e=this._faHost||this,t=this._ctx&&this._ctx.id,n=e._chatTreeMod().childrenOf(e._chatIndex&&e._chatIndex.chats||[],t);return JSON.stringify({ok:!0,children:n.map(e=>({chat_id:e.id,title:e.title,status:e.status||null,summary:String(e.summary||"").slice(0,200)}))})},{type:"object",properties:{}}),this.register_openai_tool("chat_send_to_child","把訊息送進目前對話的某個子對話（等同連結卡片的「傳給子對話」），回傳該子對話的狀態。只在已經有子對話時有用。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=this._faHost||this,r=this._ctx&&this._ctx.id,s=n._subchatToolTarget(r,t.chat_id);if(!s.ok)return JSON.stringify(s);const a=await n._subchatSend(t.chat_id,String(t.message||""));return a.ok?JSON.stringify({ok:!0,mode:a.mode,status:(n._chatEntry(t.chat_id)||{}).status||null}):JSON.stringify({ok:!1,error:a.error})},{type:"object",properties:{chat_id:{type:"string",description:"子對話 id（chat_list_children 取得）"},message:{type:"string",description:"要傳給子對話的訊息"}},required:["chat_id","message"]}),this.register_openai_tool("chat_get_child_summary","取得目前對話某個子對話的摘要與最後一則助理回覆（前 500 字）。只在已經有子對話時有用。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=this._faHost||this,r=this._ctx&&this._ctx.id,s=n._subchatToolTarget(r,t.chat_id);if(!s.ok)return JSON.stringify(s);const a=n._chatEntry(t.chat_id)||{};let i="";try{const e=((await n._chatCtxLoad(t.chat_id)).messages||[]).filter(e=>e&&"assistant"===e.role&&"string"==typeof e.content);i=e.length?e[e.length-1].content.slice(0,500):""}catch(e){}return JSON.stringify({ok:!0,chat_id:t.chat_id,title:a.title||"",status:a.status||null,summary:String(a.summary||""),last_reply:i})},{type:"object",properties:{chat_id:{type:"string",description:"子對話 id"}},required:["chat_id"]}),this.register_openai_tool("chat_delete_children","批次刪除子對話（連同子孫，無法復原）。會先跳出確認，使用者按確認才刪；dry_run=true 只回傳預覽。只在已經有子對話時有用。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=this._faHost||this,r=this._ctx&&this._ctx.id,s=t.parent_id?String(t.parent_id):r;return JSON.stringify(await n._chatDeleteChildrenTool({pid:s,cur:r,filter:t.filter,ids:t.ids,includeRunning:!0===t.include_running,dryRun:!0===t.dry_run}))},{type:"object",properties:{parent_id:{type:"string",description:"父對話 id（省略＝目前對話）"},filter:{type:"string",enum:["done","failed","done_or_failed","all","ids"],description:"條件；ids 時用 ids"},ids:{type:"array",items:{type:"string"},description:"filter 為 ids 時的子對話 id"},include_running:{type:"boolean",description:"也刪除進行中的（預設否）"},dry_run:{type:"boolean",description:"只回傳預覽，不刪"}},required:["filter"]}),e("uml_guide","用互動卡片一步一步引導使用者把「情境」設計成 UML 與程式骨架：程式先讀情境（參與者、使用案例、類別），再用卡片問使用者真正需要決定的事——語言與套件、要實作哪些使用案例（可以勾掉或補一句）、架構風格，接著依這些回應產生第二張卡片（平手的設計抉擇必須使用者選，其餘有帶程式的建議值），最後確認，才依答案產生設計、專案 zip 與設計檢視器。全程不需要 AI 或模型生成 UML，弱的 AI／離線模型也能用；使用者的回應只回傳給這個工具。情境要用「<參與者>可以<動作><名詞>」的句型（例如「顧客可以加入購物車並結帳付款」）；讀不出來會回報，不會編造。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlGuide(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{scenario:{type:"string",description:"情境（使用者故事、需求文字）"},language:{type:"string",enum:["python","typescript","java"],default:"python"},package:{type:"string"},constraints:{type:"object",description:"（選填）已經決定的抉擇，卡片會用它當預設值"}},required:["scenario"],additionalProperties:!1}),e("write_code","用「這台電腦上的離線小模型（或線上模型）」依需求一步一步寫出程式：程式把需求切成小函式（模型每次只回答一個封閉的小問題）、由被呼叫的往上逐一寫、組成完整程式後**真的編譯並執行測試來驗收**，沒過就帶著失敗訊息用選擇題挑出有問題的函式重寫；編譯失敗先由程式自動修語法、不花模型。**使用者只管把需求丟進來，不需要也不應該自己決定要不要先做 UML**：程式依需求規模自己判斷（單純的函式／演算法就直接切成函式寫；有多個實體與功能的系統，先自動設計 UML、再逐類別實作並合成一個檔案做編譯檢查），模糊時才讓模型選，設計不出來或語言不支援就退回直接寫，回傳的 route 與 report 會說明走了哪條路與原因。「驗證到哪裡」一定看回傳的 verified：verified=true 才表示附的 tests（含看不到的隱藏測試）都通過；沒給 tests 只能確認「能編譯／語法正確」（verdict=CHECKED、verified=false），**不代表行為正確**；走了 UML 的大需求目前只做編譯檢查（沒有進入點程式碼，給的 tests 不會被執行，gaps 會說明）。回傳 report 是給使用者看的中文摘要（含 gaps＝沒做到或沒驗證的地方，一定要轉達）。語言：python、nodejs、c、cpp、java、ruby、perl、bash、asm-x64、asm-x86、csharp（要先設計 UML 的大需求不含 c、bash、asm，會退回直接寫）；沒指定就從需求文字判斷。驗收在本機編譯並執行程式（需要「允許AI執行程式」，第一次會跳確認框）；**判題器不是安全沙盒**（沒有記憶體上限、沒有檔案與網路隔離），網頁版沒有本機工具鏈所以完全無法驗證。比較強的線上模型直接自己寫程式更快；這個工具是給離線小模型補救、以及需要「真的跑過測試」的情況。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._codeAgent(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{task:{type:"string",description:"要寫什麼（需求文字；有範例輸入輸出最好一起寫在裡面）"},language:{type:"string",enum:["python","nodejs","c","cpp","java","ruby","perl","bash","asm-x64","asm-x86","csharp"],description:"（選填）不給就從 task 判斷，判斷不出來用 python"},tests:{type:"array",items:{type:"object",properties:{in:{type:"string",description:"標準輸入"},out:{type:"string",description:"期望的標準輸出"}},required:["in","out"]},description:"（選填）範例測試（stdin→stdout，最多 20 筆）；有給才會真的執行驗收"},model:{type:"string",enum:["offline","online"],description:"（選填）用離線小模型或線上模型；不指定就自動選"},max_rethink:{type:"integer",description:"（選填）驗收沒過最多重寫幾次，預設 3、最多 5"}},required:["task"],additionalProperties:!1}),e("fix_code","修一份「任意拿到的程式碼」（不需要知道它怎麼來的）：先修語法——從編譯器／直譯器的錯誤訊息找到出錯的語法單元，在錯誤位置產生極小的 token 修法（補括號、分號、冒號、end、引號…），每個候選都交給真的編譯器驗證，並列時用選擇題讓模型挑；只改必要的 token，其餘格式原樣保留。有給 tests 時再修行為：判題不過就挑出有問題的函式、讓模型只重寫那個函式、拼回去再驗。回傳 diff 與 edits。「驗證到哪裡」看 verified：verified=true 才表示 tests 都通過；沒給 tests 只確認能編譯（verdict=CHECKED、verified=false）。語法修正只處理「缺／多一個標點或關鍵字」這類單一 token 的錯，**能編譯不代表語意對**（例如缺括號的位置猜錯，程式仍然能過編譯卻算錯）——有 tests 時才會在「都能過語法」的候選裡用測試挑。支援 python、nodejs、c、cpp、java、csharp、ruby、perl、bash 的語法修正；組語沒有。需要「允許AI執行程式」（編譯與執行都在本機），**判題器不是安全沙盒**；網頁版沒有本機工具鏈、無法使用。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}if("string"!=typeof t.source||!t.source.trim())return JSON.stringify({ok:!1,error:"缺少 source（要修的程式碼）"});try{return JSON.stringify(await this._codeAgent(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{source:{type:"string",description:"要修的程式碼（整份）"},language:{type:"string",enum:["python","nodejs","c","cpp","java","ruby","perl","bash","csharp"],description:"（選填）不給就從程式碼判斷"},tests:{type:"array",items:{type:"object",properties:{in:{type:"string"},out:{type:"string"}},required:["in","out"]},description:"（選填）範例測試（stdin→stdout）；有給才會修行為"},goal:{type:"string",description:"（選填）這份程式應該做什麼（修行為時給模型看）"},model:{type:"string",enum:["offline","online"],description:"（選填）需要重寫函式時用的模型"},max_rethink:{type:"integer",description:"（選填）行為驗收沒過最多重寫幾次，預設 3、最多 5"}},required:["source"],additionalProperties:!1}),e("optimize_code","把一份「已經能跑、答案正確」的 Python 程式換成「功能一樣但更有效率」的寫法：先從程式看出慢的寫法（list 當集合用、list.pop(0) 當佇列、重複計算的遞迴、迴圈裡反覆 list.count／in／sum 切片、迴圈裡 lst = lst + [x]、sorted 只為了取極值、字串 += 一直接），再依優化對照表換成 set／deque／lru_cache／Counter／前綴和／max／min／append／join；**每一條都要在 tests（含隱藏測試）上輸出與原程式相同才收，有給 perf（一組大輸入與它的正確輸出）還會量時間，變慢就退回**。回傳 applied（換了什麼、複雜度前後、記憶體、實測毫秒）、skipped（認得但沒換的原因）、source（優化後的程式）。「輸出一致」只在給的測資上驗證，不是等價證明；沒給 tests 就不會改。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}if("string"!=typeof t.source||!t.source.trim())return JSON.stringify({ok:!1,error:"缺少 source（要優化的 Python 程式碼）"});try{return JSON.stringify(await this._codeOptimize(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{source:{type:"string",description:"要優化的 Python 程式（整份，要能直接執行、從標準輸入讀資料）"},tests:{type:"array",description:"[{in,out}]：可見測資（必給；輸出就是要保持一致的標準）",items:{type:"object",properties:{in:{type:"string"},out:{type:"string"}}}},hidden:{type:"array",description:"[{in,out}]：隱藏測資（選填，一樣要保持一致）",items:{type:"object",properties:{in:{type:"string"},out:{type:"string"}}}},perf:{type:"object",description:"選填：{in,out} 一組「夠大、會顯出差別」的輸入與正確輸出，用來量時間",properties:{in:{type:"string"},out:{type:"string"}}}},required:["source","tests"]}),e("uml_design","用「這台電腦上的離線小模型」把情境一步一步設計成 UML 再產生程式骨架：程式把設計拆成封閉的小問題（參與者與使用案例 → 類別 → 每個類別的屬性與操作 → 關係 → 呼叫順序），模型一次只回答一個、每個回覆都被驗證，之後只重做有問題的那一區（top-down rework），再用 design_choices 的規則選架構與 library。比較強的線上 AI 不需要這個：自己寫 UML 文字直接呼叫 uml_to_code 更快更準。這是線上模型的補救能力：大問題自己一次做不完時用它。大問題會先由程式切成小塊（依句子，每塊一個領域），每塊各自一次一小題拆完，再合併成一份。預設用目前的線上模型（體檢結果是「程式先讀情境」的除外，那種改用離線模型或 uml_guide）；model 可以指定 offline（離線小模型，第一次要下載）或 online。回傳的 model_used 說明這次用了哪個。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlDesign(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{scenario:{type:"string",description:"情境（使用者故事、需求文字）"},language:{type:"string",enum:["python","typescript","java"],default:"python"},package:{type:"string"},constraints:{type:"object",description:"（選填）指定抉擇"},model:{type:"string",enum:["offline","online"],description:"（選填）用離線小模型或線上模型；不指定就自動選"}},required:["scenario"],additionalProperties:!1}),e("browser_task","穩定地操作瀏覽器完成一件事（比一個一個呼叫 browser_* 工具穩，離線小模型、會亂來的模型一律用這個）：先把每個動作計畫好，再由程式檢查（動作要真的存在、型別對、狀態接得上——沒開分頁不能點、沒觀察過元素不能按座標、換頁或點擊後要重新看元素、不接受 javascript:／file: 網址、不替使用者輸入密碼或卡號），通過才執行；每做到一次觀察（讀頁面、列元素）就依看到的內容重新計畫下一批；失敗會重新觀察再計畫。goal＝要做什麼（含網址最好）。可以自己給 steps（強模型的計畫也會被同樣檢查）：每步 {do, ...}，do 只能是 open(url)／goto(url)／back／reload／read／look／click(x,y，座標來自剛做的 look)／click_text(text 或 selector)／type(text，要先 click 輸入框或給 selector，submit:true 會按送出)／key(key)／scroll(direction)／wait_download／close／finish。手動模式（預設）會先把計畫給使用者看、同意才連線；有副作用的步驟（送出、付款、刪除、發佈、登入…）兩種模式都一定先問使用者。擴充功能還沒連上會等一下（有逾時），連不上通常是瀏覽器停在「誰在使用 Chrome？」設定檔選擇器——要請使用者自己選，不要替他選帳號。回傳做了哪些動作、最後的頁面文字與可點的元素。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._bcPlanRun(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{goal:{type:"string",description:"要做什麼（原話，含網址）"},steps:{type:"array",items:{type:"object"},description:"選填：自己排好的步驟（會被檢查）"},mode:{type:"string",enum:["manual","auto"]},max_rounds:{type:"integer"},wait_ms:{type:"integer",description:"等擴充功能連上的毫秒數，預設 25000"},once:{type:"boolean",description:"只做第一批就回傳"},use_model:{type:"boolean"}},required:["goal"]}),e("plan_route","找不到工具時用這個，不要猜也不要說做不到：把需求排成一條可以走的路線。程式判斷需求是哪一類——要對外部世界做事（寄信、發文、付款：問使用者提供 API、或用瀏覽器控制操作網頁版、或寫好範本由使用者自己送）、用現成模型（翻譯、語音、辨識：Hugging Face／離線模型）、寫程式（桌面版 Python／JavaScript／bash；網頁版 Python（Pyodide）／JavaScript／bash（busybox 模擬））、或先用 UML design 拆的大系統。回傳路線、步驟與閘門：手動模式（預設）先把計畫送給使用者、問要不要；自動模式直接做；有副作用的步驟（寄出、發佈、付款、刪除）兩種模式都一定先問使用者。message 是可以直接給使用者看的計畫文字；uml_issue 可以餵給 uml_edit 的 issues，把缺的能力補進 UML。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._routePlan(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{need:{type:"string",description:"要做的事（原話）"},mode:{type:"string",enum:["manual","auto"],description:"不給就用 /route 的設定"},api_provided:{type:"boolean",description:"使用者已經提供了 API"}},required:["need"]}),e("register_designed_tool",'把「UML design 設計、再用程式實現」的功能登記成工具（runtime 設計的工具）。登記後它跟內建工具一樣：有名稱、說明、參數結構，食譜（CoLU 的選擇題＋程式填欄位）挑得到、工具反思搜得到、離線模式也能呼叫；到 Advance Settings「設計出來的工具」可以管理。name＝英文字母數字底線；description＝一句話說明（搜尋與路由都靠它，寫使用者平常會怎麼說）；parameters＝JSON Schema（{type:"object",properties:{…},required:[…]}，欄位要有 description，食譜才補得對）；handler＝JavaScript 處理程式的本體（參數在 args，可以 await，回傳值就是結果；只能用瀏覽器內的功能）；uml 與 scenario 選填，留著以後修改設計用。同名會更新。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(this._designedRegister(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{name:{type:"string"},description:{type:"string"},parameters:{type:"object",description:"JSON Schema"},handler:{type:"string",description:"JavaScript 處理程式本體（args 是參數物件）"},uml:{type:"string",description:"設計用的 UML（文字 DSL）"},scenario:{type:"string"},enabled:{type:"boolean"}},required:["name","description","handler"]}),e("intent_parse","從文字描述（議題追蹤 ITS 的描述、使用者的話、測試需求）讀出「意圖」：做了什麼行為（動詞＋物件）、實際看到什麼、期待什麼、怎麼驗證；明確寫的與隱含的分開標（implicit:true＋依據）——壞掉的現象反過來就是隱含的期待（「無法開機」→「應該能開機」），沒有驗證步驟就補一個隱含的（照重現步驟再做一次）。缺什麼（重現步驟、預期結果、環境）不猜，列成封閉的小問題。uml:true 順便產生 UML（重現與驗證的使用案例，可接 uml_to_code）；testcase:true 產生測試案例（前置、步驟、預期、迴歸案例）；match:true 用雙語的意象去配現有工具（例如配 testcase writer／testcase design 這類工具）。離線模式下會用中英互譯讀懂程式認不得的句子。這是 intent-to-bugfix、intent-to-testcase 的第一步，下一步照 uml_design／食譜／工具做。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._intentParse(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{text:{type:"string",description:"描述原文（不要改寫）"},kind:{type:"string",enum:["bugfix","testcase","feature"],description:"不填＝程式判斷"},uml:{type:"boolean"},testcase:{type:"boolean"},match:{type:"boolean"},translate:{type:"boolean",description:"讀不出的句子先中英互譯（離線模式預設開）"}},required:["text"]}),e("skill_compile","把技能（內建的或匯入的 SKILL）讀成「食譜」：程式讀 SKILL.md 抽出步驟與用到的工具、依欄位名稱與型別綁到手上有的東西（附件、網址、使用者的話、聲音／語速／語言），編成可重複執行的食譜；最後一步交給呼叫端執行。對不上的步驟（沒指名工具、工具不存在、要跑腳本、必填欄位綁不到）不猜，列成「缺口」，附相近的現有工具或給 uml_design 的情境。design＝true：缺的能力直接用 uml_design 設計、登記成「待實作」的設計工具（草稿）；處理程式補上並啟用後再編一次，缺口就對上它。有缺口的是草稿（不會自動使用）。skill＝技能名稱（省略＝全部啟用中的技能）；save＝true 才存下來。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._skillCompile(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{skill:{type:"string",description:"技能名稱（省略＝全部）"},save:{type:"boolean",description:"true＝存成食譜（草稿或已編好）"},design:{type:"boolean",description:"true＝缺口用 UML design 設計並登記成待實作的設計工具（手動模式會先問你）"}}}),e("list_designed_tools","列出 runtime 設計出來的工具（名稱、說明、參數、是否啟用、執行次數、最近的錯誤）。",async function(){return JSON.stringify({ok:!0,tools:this._designedList()})},{type:"object",properties:{}}),e("remove_designed_tool","刪除一個 runtime 設計出來的工具（只刪登記，不影響內建工具）。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}return JSON.stringify(this._designedRemove(String(t.name||"")))},{type:"object",properties:{name:{type:"string"}},required:["name"]}),e("llvm_execute",'LLVM IR 的執行環境（跟 python_execute、bash_execute 一樣是程式開發工具）：給一份 LLVM IR 文字，在這裡編成 WebAssembly 並執行，回傳 stdout／stderr／結束碼；IR 有錯會指出行號。不需要 clang 或 llc。用途：驗證手寫或模型產生的 IR、教學、把 UML 產生的 IR（uml_to_wasm）改過再跑、做小型的底層實驗。emit：run（預設，編譯並執行）、check（只檢查）、wasm（編成 .wasm 並交付檔案）。支援範圍（第一版）：i1／i8／i32／i64／double、指標（ptr 或 T*）、struct、陣列、字串常數（c"..."）、全域變數、br／if／迴圈、直接呼叫、記憶體讀寫、整數與浮點運算、型別轉換；進入點是 @_start（void）或 @main（回傳結束碼）。內建的 libc：puts、putchar、getchar、malloc、calloc、free、strlen、memcpy、memset、memcmp、strcmp、abs、exit（宣告了就自動連結；printf 這類可變參數函式不支援，用 puts／putchar）；WASI：fd_write、fd_read、args_get、environ_get、clock_time_get、random_get、proc_exit。不支援：phi、例外、函式指標、可變參數、float（只有 double）、有號的 i8／i1 比較（先 sext）。預設有步數上限（一億次區塊轉換），無窮迴圈會被中止並說明；fuel 給 0＝不設上限。終端機裡也有同樣的指令：lli（執行）、llc（編譯；-c 產生物件檔）、llcheck（檢查）、llink（連結多個檔案）、wasmrun（執行 .wasm）；物件檔放在 /mnt 底下就是存進 File Access Point。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._llvmExecute(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{ir:{type:"string",description:"LLVM IR 文字"},emit:{type:"string",enum:["run","check","wasm"]},args:{type:"array",items:{type:"string"},description:"程式的命令列參數"},stdin:{type:"string"},env:{type:"object"},fuel:{type:"integer",description:"步數上限（區塊轉換次數），0＝不限"},name:{type:"string"},modules:{type:"array",items:{type:"object"},description:"選填：要一起連結的其他檔案 [{name, ir}]（ir 可以是 .ll 文字，也可以是 llc -c 產生的物件檔文字）；連結器會解決符號、擋重複定義與簽名衝突"}},required:["ir"]}),e("uml_to_wasm","把 UML 設計編成 LLVM IR 再編成 WebAssembly（wasm32-wasi），在這裡真的跑一次並驗證：類別→struct、操作→函式、使用案例→會依序呼叫操作的函式；執行輸出必須跟 UML 預期的呼叫軌跡一致才算通過。產出 model.ll（LLVM IR 文字）、model.wasm、run.js（用 node 跑）。第一版範圍：整數、浮點、布林、字串、類別的欄位與方法、使用案例的呼叫順序；不含繼承的虛擬呼叫、例外、容器（List／Map 用空指標代替並警告）。不需要 clang 或 llc。uml 是文字 DSL（跟 uml_to_code 一樣）；不給 uml 就用最近一次 uml_design／uml_guide 的設計。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlToWasm(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{uml:{type:"string",description:"UML 文字 DSL（選填）"},session:{type:"string"},run:{type:"boolean",description:"false＝只編譯不執行"}}}),e("uml_edit",'編修進行中的 UML 設計（uml_design／uml_guide 產生的那一份）：反思或決策的結論要對應到「補哪裡、刪哪裡」，這個工具就是把它套上去並重建專案。ops＝編修指令陣列（每個都被程式驗證，會讓設計出錯的會被退回並說明原因）：add_actor／remove_actor（name）、add_class（name、kind、members:["pay(amount:float):bool","total:float"]）、remove_class（name；相關關係與呼叫步驟程式一併收拾）、rename_class（from、to）、add_member（cls、member）、remove_member（cls、name）、add_relation（from、to、kind: assoc/inherit/implement/compose/aggregate/depend）、remove_relation（from、to）、add_usecase（name、actor、steps:["Cart.add(item)","Order.pay(x)"]）、remove_usecase（name）、add_step（usecase、step、at）、remove_step（usecase、to、msg 或 at）。auto_fix＝true 會讓程式找出問題（沒人用的類別、空類別、太短的呼叫順序），每個問題列出候選編修給小模型挑編號（挑不出來用程式的預設）。【窗口很小的模型】next＝true 只回程式算出的「下一格」（先參與者與使用案例、再類別、再每個空類別的成員、再每個太短的使用案例、最後沒接上的類別；附焦點標頭、兄弟已用的命名、答法範例），你只回這一格的 ops；queue＝true 讓每次套完 ops 自動附上下一格（next_unit），直到 done。回傳改了什麼（changes）、被退回的原因、剩下的問題、編修後的 UML。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlEdit(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{session:{type:"string",description:"工作階段 id（不給就用最近一個）"},ops:{type:"array",items:{type:"object"},description:"編修指令"},model_jsonl_read:{type:"boolean",description:"把模型攤平成 JSONL 讀（levels 只攤前幾層、path 往下鑽某個節點）"},levels:{type:"number"},path:{type:"string",description:"model_jsonl_read：要往下鑽的節點（JSON Pointer，例如 /classes）"},model_jsonl:{type:"array",items:{type:"string"},description:"整份模型的 JSONL 行（必須全部展開）；還原後取代目前的模型"},next:{type:"boolean",description:"小窗口分段寫：只回程式算出的下一格（焦點標頭、兄弟的命名、答法範例）；一次只做這一格"},queue:{type:"boolean",description:"套完 ops 後自動附上下一格（next_unit）；每次只回這一格的 ops，直到 done"},auto_fix:{type:"boolean",description:"讓程式找問題、小模型挑修法"},use_model:{type:"boolean",description:"false＝不問模型，全用程式的預設修法"}}}),e("images_to_pdf",'把圖片合成一份PDF：可以指定順序，每一頁可以縮放、旋轉、做影像處理（灰階、影像強化、色調強化、減少色彩、高斯模糊、馬賽克…）。純本地、不經過AI、幾秒完成。使用者說「圖片轉PDF／合併成PDF／縮放到A4／旋轉／灰階／影像強化／減色／模糊／馬賽克」就直接用這個，不要自己寫Python（沙盒裡沒有Pillow，裝不起來）、也不要用ImageMagick。\n【最簡單】不給任何參數＝這個對話附加的全部圖片，依檔名的數字順序（1_、2_…10_，不是上傳順序）一張一頁。\n【格式】副檔名不重要，用檔案內容判斷：jpg／jpeg／jfif／png／gif／webp／bmp／ico／avif／svg／tiff（第一頁）／heic／heif 都可以（沒有副檔名、副檔名亂寫也行）；tga／psd／raw 這類不支援，請使用者先轉成 jpg 或 png。folder 沒給pattern時只收看起來像圖片的副檔名；給 pattern（例如 "*"）就全收、用內容判斷。\n【來源】files＝file_id或檔名（照你給的順序）；pages＝每頁一個物件（順序就是頁序）；folder＝整個資料夾（fap:名稱/路徑，或桌面版的絕對路徑，依檔名自然排序，pattern可篩例如"*.jpg"）；sort：none／name／name_desc／modified／reverse。\n【頁面】page_size：fit（頁面＝圖片大小，預設）、a3／a4／a5／b5／letter／legal，或"210x297mm"；orientation：auto（寬圖用橫的，預設）／portrait／landscape（使用者說「都是直式A4」用portrait）；fit：contain（整張放進頁面、等比、置中＝「Zoom／縮放置中」，預設）／cover（填滿、超出的裁掉）／stretch（拉伸變形）／actual（原始大小，太大才縮）；zoom：在fit結果上再縮放的百分比（80＝留邊）；margin：pt（預設0）；background：頁面底色（預設白）。\n【處理 ops】依序執行，放在頂層＝所有頁面共用，放在pages[i].ops＝只作用那一頁。每個是{"op":名稱,…}：grayscale（灰階）、enhance（影像強化：自動對比＋銳化＋飽和度）、tone（色調強化：自動白平衡＋對比＋飽和度；可帶contrast／saturation／warmth／white_balance）、reduce_colors（減少色彩，colors 2～256，dither:true抖色）、blur（高斯模糊，radius＝標準差像素）、mosaic（馬賽克，block＝格子像素；region:{x,y,w,h}百分比只蓋一塊，不給＝整張）、sharpen、auto_contrast、brightness／contrast／saturation（amount -100～100）、gamma（value）、threshold（黑白二值，預設Otsu）、posterize、invert、rotate（degrees順時針，任意角度）、scale（改圖片像素：percent／width／height／max_side）、crop（x,y,w,h百分比，unit:"px"用像素）、flip（direction）。pages[i].rotate、pages[i].scale是縮寫（最先做）。注意：scale改的是圖片像素，zoom改的是它在頁面上的大小。\n【輸出】filename；output_path（fap:名稱/資料夾，或桌面版的絕對路徑，把PDF存到那裡）；不給output_path＝只產生下載附件。on_error：fail（預設，有一張壞就整份不做並說是哪一張）／skip。參數有錯會整份不處理，訊息說是哪一頁哪個參數。回傳{ok,pdf_file_id,filename,pageCount,pages:[{source,input,output,ops,page_mm}],saved_to?,warnings?}。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._imagesToPdfAdvanced(t,e=>this._log("🖼️→📄 "+e));return await this._deliverToolResultFile(e,"pdf_file_id",e=>`📎 已把 ${e.pageCount} 張圖片合成PDF：${e.filename}（${(e.sizeBytes/1024).toFixed(0)}KB）${e.saved_to?"，已存到 "+e.saved_to:""}`,"images_to_pdf"),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{files:{type:"array",items:{type:"string"},description:"（選填）圖片 file_id或檔名，照這個順序一張一頁；留空＝這個對話附加的全部圖片（依檔名數字順序）"},pages:{type:"array",description:"（選填）每頁一個物件，順序＝頁序；要逐頁不同的旋轉／縮放／處理時用",items:{type:"object",properties:{file:{type:"string",description:"file_id、檔名、fap:名稱/路徑 或 桌面版絕對路徑"},rotate:{type:"number",description:"順時針角度（90、-90、180、15…）"},scale:{type:"number",description:"圖片像素縮放百分比（50＝縮成一半）"},ops:{type:"array",items:{type:"object"},description:"只作用這一頁的處理（接在全部頁面共用的ops後面）"},zoom:{type:"number"},fit:{type:"string"},page_size:{type:"string"},orientation:{type:"string"},margin:{type:"number"},background:{type:"string"}},required:["file"]}},folder:{type:"string",description:"（選填）整個資料夾的圖片：fap:名稱/路徑，或桌面版絕對路徑，依檔名自然排序"},pattern:{type:"string",description:'（選填）folder的檔名篩選，例如 "*.jpg"'},sort:{type:"string",enum:["none","name","name_desc","modified","reverse"],description:"（選填）排序：預設——有給files/pages＝照給的順序，folder／附件＝依檔名自然排序"},ops:{type:"array",items:{type:"object",properties:{op:{type:"string",enum:["grayscale","enhance","tone","reduce_colors","blur","mosaic","sharpen","auto_contrast","brightness","contrast","saturation","gamma","threshold","posterize","invert","rotate","scale","crop","flip"]}},required:["op"],additionalProperties:!0},description:'（選填）所有頁面共用的處理，依序執行，例如 [{"op":"enhance"},{"op":"grayscale"}]'},page_size:{type:"string",description:'（選填）fit（預設）／a3／a4／a5／b5／letter／legal／"210x297mm"'},orientation:{type:"string",enum:["auto","portrait","landscape"],description:"（選填）預設 auto"},fit:{type:"string",enum:["contain","cover","stretch","actual"],description:"（選填）contain（預設，等比置中）／cover（填滿裁切）／stretch／actual"},zoom:{type:"number",description:"（選填）頁面上再縮放的百分比，80＝留邊"},margin:{type:"number",description:"（選填）頁面邊界 pt，預設 0"},background:{type:"string",description:'（選填）頁面底色，例如 "#ffffff"（預設白）'},dpi:{type:"number",description:"（選填）fit／actual 用：像素換成實際大小的解析度（預設 96）"},format:{type:"string",enum:["auto","jpeg","png"],description:"（選填）嵌進PDF的格式：auto（預設；減色／二值化用png，其餘jpeg）"},jpeg_quality:{type:"number",description:"（選填）0.3～1，預設 0.92"},filename:{type:"string",description:"（選填）輸出檔名"},output_path:{type:"string",description:"（選填）把PDF存到：fap:名稱/資料夾 或桌面版絕對路徑（資料夾或完整 .pdf 路徑）"},on_error:{type:"string",enum:["fail","skip"],description:"（選填）有圖壞掉時：fail（預設）／skip"},max_pixels:{type:"number",description:"（選填）單張處理前的像素上限（預設約 6000 萬，超過先縮小）"}},additionalProperties:!1}),e("remove_pdf_pages",'移除PDF指定頁面，回傳移除後的新PDF（複製剩餘頁面的原始物件，不重新渲染，文字仍可選取/搜尋）。pages用頁碼範圍語法：逗號分隔、可以用"start-end"區間、順序不重要、重複頁碼會自動忽略、結尾多餘逗號沒關係，例如"1-5,6"或"6,2,2,1-3,"都合法。回傳{ok, pdf_file_id, filename, sizeBytes, originalPageCount, removedPages, remainingPageCount}，成功時會自動產生下載附件。⚠️不支援有密碼保護的PDF；移除後如果會變成0頁會直接報錯，不會產生空白PDF。參數: {"file":"PDF的file_id或檔名","pages":"要移除的頁碼範圍，例如\\"1-5,6\\""}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file||t.file_id||"").trim(),r=String(t.pages||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file參數（PDF的file_id或檔名）"});if(!r)return JSON.stringify({ok:!1,error:'缺少pages參數（要移除的頁碼範圍，例如"1-5,6"）'});try{const e=await this._removePdfPages(n,r,e=>this._log("📄 "+e));return await this._deliverToolResultFile(e,"pdf_file_id",e=>`📎 已移除${e.removedPages.length}頁（剩${e.remainingPageCount}頁）：${e.filename}（${(e.sizeBytes/1024/1024).toFixed(1)}MB）`),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file:{type:"string",description:"PDF的file_id或檔名"},pages:{type:"string",description:'要移除的頁碼範圍，例如"1-5,6"'}},required:["file","pages"],additionalProperties:!1}),e("extract_pdf_pages",'把PDF指定頁面取出、變成一份新的PDF（複製原始頁面物件，不重新渲染，文字仍可選取/搜尋，輸出固定依頁碼由小到大排序，跟輸入範圍的先後順序無關）。pages用頁碼範圍語法：逗號分隔、可以用"start-end"區間、順序不重要、重複頁碼會自動忽略、結尾多餘逗號沒關係，例如"1-5,6"或"6,2,2,1-3,"都合法。回傳{ok, pdf_file_id, filename, sizeBytes, originalPageCount, extractedPages}，成功時會自動產生下載附件。⚠️不支援有密碼保護的PDF。參數: {"file":"PDF的file_id或檔名","pages":"要取出的頁碼範圍，例如\\"1-5,6\\""}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file||t.file_id||"").trim(),r=String(t.pages||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file參數（PDF的file_id或檔名）"});if(!r)return JSON.stringify({ok:!1,error:'缺少pages參數（要取出的頁碼範圍，例如"1-5,6"）'});try{const e=await this._extractPdfPages(n,r,e=>this._log("📄 "+e));return await this._deliverToolResultFile(e,"pdf_file_id",e=>`📎 已取出${e.extractedPages.length}頁：${e.filename}（${(e.sizeBytes/1024/1024).toFixed(1)}MB）`),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file:{type:"string",description:"PDF的file_id或檔名"},pages:{type:"string",description:'要取出的頁碼範圍，例如"1-5,6"'}},required:["file","pages"],additionalProperties:!1}),e("extract_pdf_images",'把PDF指定頁面整頁渲染成PNG圖片（是「該頁畫面長什麼樣子」的截圖，不是抽取頁面內容流裡個別的內嵌圖片物件——即使該頁是純文字/向量圖形也能正常輸出一張圖）。pages用頁碼範圍語法：逗號分隔、可以用"start-end"區間、順序不重要、重複頁碼會自動忽略、結尾多餘逗號沒關係，例如"1-5,6"。只指定1頁時直接回傳一張PNG；指定多頁時自動打包成一份zip（裡面每張圖檔名是pdf_image_{頁碼}.png），成功時會自動產生下載附件。回傳單頁時{ok, image_file_id, filename, sizeBytes, page, originalPageCount}；多頁時{ok, zip_file_id, filename, sizeBytes, originalPageCount, pages:[{page,filename,sizeBytes}]}。支援有密碼保護的PDF（會跳密碼輸入框）。參數: {"file":"PDF的file_id或檔名","pages":"要輸出成圖片的頁碼範圍，例如\\"1-5,6\\"","scale":"（選填）渲染解析度倍率，預設2，最高6，數字越大圖越清楚但檔案也越大"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file||t.file_id||"").trim(),r=String(t.pages||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file參數（PDF的file_id或檔名）"});if(!r)return JSON.stringify({ok:!1,error:'缺少pages參數（要輸出成圖片的頁碼範圍，例如"1-5,6"）'});try{const e=await this._extractPdfPageImages(n,r,{scale:t.scale},e=>this._log("🖼️ "+e));return e.ok&&e.image_file_id?await this._deliverToolResultFile(e,"image_file_id",e=>`📎 已輸出第${e.page}頁：${e.filename}（${(e.sizeBytes/1024).toFixed(0)}KB）`):e.ok&&e.zip_file_id&&await this._deliverToolResultFile(e,"zip_file_id",e=>`📎 已輸出${e.pages.length}張圖片並打包：${e.filename}（${(e.sizeBytes/1024/1024).toFixed(1)}MB）`),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file:{type:"string",description:"PDF的file_id或檔名"},pages:{type:"string",description:'要輸出成圖片的頁碼範圍，例如"1-5,6"'},scale:{type:"number",description:"（選填）渲染解析度倍率，預設2，最高6"}},required:["file","pages"],additionalProperties:!1}),e("compare_images",'把2~6張圖片「一起」交給支援讀圖(vision)的model比較（相同點/差異、哪一張符合某個描述、哪一張對應哪一張），比分別呼叫interpret_image再自己對照準確。圖片來源：file_id（📎附件、extract_pptx_images/extract_video_frames/browser_screenshot產生的圖片）或http(s)圖片網址，混用也可以。典型用途：拿投影片裡抽出的圖，跟影片幾個時間點的畫面比對，找出投影片圖片出現在影片的哪個時間，再用extract_clip_range剪那一段。參數: {"images":["file_id或網址",...],"question":"（選填）想比較什麼，例如"圖1（投影片）跟哪一張影格畫面最像？""}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=Array.isArray(t.images)?t.images.map(e=>String(e||"").trim()).filter(Boolean):[];if(n.length<2)return JSON.stringify({ok:!1,error:"images至少要給2張（file_id或圖片網址）"});if(n.length>6)return JSON.stringify({ok:!1,error:"images最多6張，太多張請分批比較（例如先各自縮小候選範圍）"});try{const e=[],r=[];for(const t of n){const n=/^(https?:\/\/|data:image\/)/i.test(t),s=await this._resolveImageInputForInterpretation(n?{imageUrl:t}:{fileId:t});e.push(s.dataUrl),r.push(s.label&&s.label.length>60?s.label.slice(0,57)+"…":s.label)}const s=await this._interpretImageWithVisionModel(e,t.question,r);return JSON.stringify({ok:!0,images:n.map((e,t)=>({label:`圖${t+1}`,source:r[t],ref:e})),model_used:s.modelUsed,vision_confirmed:s.visionConfirmed,comparison:s.description})}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{images:{type:"array",items:{type:"string"},description:"2~6個圖片來源：file_id或http(s)圖片網址；回答會用「圖1、圖2…」（照這個順序）稱呼它們"},question:{type:"string",description:"（選填）想比較什麼；不給就做一般的相同點/差異比較"}},required:["images"],additionalProperties:!1}),e("extract_video_frames",'擷取已上傳影片在「指定時間點」的畫面，每個時間點存成一張JPEG圖片（回傳每張的時間與file_id），之後可以用interpret_image看內容、或用compare_images跟其他圖片（例如投影片裡的圖）比對，找出內容對應的時間範圍。用關鍵影格查詢，長影片取幾個點也很快。參數: {"video":"影片file_id或檔名，留空用最近上傳的","times":[10,"1:20",95.5],"max_width":"（選填）輸出寬度px，預設640，範圍160~1280","quality":"（選填）JPEG品質0.3~0.95，預設0.8"}。times最多24個；不確定內容在哪時，先每隔一段時間（例如每30秒）取樣，比對後再對候選附近加密取樣縮小範圍。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.video||t.file||t.file_id||"").trim(),r=await this._resolveUploadedFileRecord(n);if(!r)return JSON.stringify({ok:!1,error:n?`找不到符合「${n}」的影片`:"沒有可用的影片"});const s=(Array.isArray(t.times)?t.times:[t.times]).map(e=>this._parseTimeValue(e)).filter(e=>null!=e&&e>=0);if(!s.length)return JSON.stringify({ok:!1,error:'缺少times（秒數或"1:20"這種寫法的陣列）'});if(s.length>24)return JSON.stringify({ok:!1,error:"times最多24個，請分批取樣"});try{return JSON.stringify(await this._extractVideoFrames(r,s,t))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{video:{type:"string",description:"影片的file_id或檔名；留空＝最近上傳的"},times:{type:"array",items:{},description:'要擷取畫面的時間點陣列，秒數或"1:20"/"0:01:20"字串，最多24個'},max_width:{type:"integer",description:"（選填）輸出寬度px，預設640，範圍160~1280"},quality:{type:"number",description:"（選填）JPEG品質0.3~0.95，預設0.8"}},required:["times"],additionalProperties:!1}),e("fetch_web_page",'抓取一個網頁的完整內容，轉成方便閱讀的Markdown文字後存進persistentStorage（跟使用者上傳檔案一樣會出現在list_uploaded_files清單裡）。browser_search只回傳標題+極短摘要，想深入了解某篇特定文章/頁面的完整內容時用這個工具抓下來，再視需要用parse_uploaded_file看細節、或內容很長時用summarize_large_text分段摘要。需要目前環境已經提供CORS代理能力才能運作，若回傳「找不到可用的CORS代理」錯誤，如實告知使用者這個限制，不要假裝抓取成功。只支援伺服器端直接回傳HTML的網頁，抓不到內容通常代表目標網頁完全靠JS動態渲染（例如SPA），這種情況也如實告知使用者，不要編造內容。參數: {"url":"https://..."}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.url||"").trim();if(!/^https?:\/\//i.test(n))return JSON.stringify({ok:!1,error:"url必須是http(s)開頭的完整網址"});let r;try{r=this._resolveWebFetchProxyUrl()}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}try{const e=await fetch(r+n,{headers:{Accept:"text/html"}});if(!e.ok)return JSON.stringify({ok:!1,error:`抓取失敗：HTTP ${e.status}`});const s=e.headers.get("content-type")||"";if(s&&!/text\/html|application\/xhtml/i.test(s))return JSON.stringify({ok:!1,error:`這個網址回傳的不是HTML網頁（content-type: ${s}），這個工具只處理網頁內容`});const a=await e.text(),{title:i,markdown:o}=this._extractReadableContentFromHtml(a);if(!o.trim())return JSON.stringify({ok:!1,error:"這個網頁沒有擷取到任何可讀文字內容——可能是完全靠JavaScript動態渲染的頁面（例如SPA），伺服器端回傳的原始HTML本身沒有實際內容"});const l=new Blob([o],{type:"text/markdown"}),c=(i||new URL(n).hostname).replace(/[\\/:*?"<>|]/g,"_").slice(0,80),d=await this.fileCache.put(`${c}.md`,"text/markdown",l,"uploaded");if("text"!==t.output&&("jsonl"===t.output||o.length>this._pagerBudgetChars())){const e=this._webPageLayers(o,{title:i||n,url:n,file_id:d});if(e)return e}return JSON.stringify({ok:!0,file_id:d,title:i||n,url:n,sizeChars:o.length,preview:o.slice(0,500)+(o.length>500?"…（完整內容請用parse_uploaded_file或summarize_large_text搭配這個file_id查看）":"")})}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{url:{type:"string",description:"要抓取的網頁完整網址，須以http(s)://開頭"},output:{type:"string",enum:["auto","jsonl","text"],description:"內文很長時預設回章節索引（JSONL，三層：索引→區塊→原文）；text＝一律只回預覽"}},required:["url"],additionalProperties:!1});const c={fap:{type:"string",description:"專案資料夾：已授權資料夾的參照 fap:<名稱>[/子路徑]（用 list_file_access_points 查），桌面版也可以是絕對路徑。不給就用使用者 📎 上傳的檔案（zip 會展開）"},wiki:{type:"array",items:{type:"string"},description:"選填，說明文件的網址（會抓下來當背景資料；沒有 README 時拿第一頁當簡介）"},format:{type:"array",items:{type:"string",enum:["md","mediawiki","html","pdf","docx"]},description:"輸出格式，可多個；不給就用 ⚙ 設定裡的預設"},template:{type:"string",description:"選填，範本代號（用 docgen_list_templates 查）；不給由程式依架構比對挑"},lang:{type:"string",enum:["zh-TW","en"],description:"文件語言，預設繁體中文"},level:{type:"string",enum:["brief","standard","detailed"],description:"詳細程度（表格列數）"},analysis:{type:"boolean",description:"文件最後附上分析附錄（架構比對的所有訊號與分數）"},noai:{type:"boolean",description:"true＝全部由程式寫成，不呼叫模型潤飾"},version:{type:"string",description:"文件版本，例如 1.0"},request:{type:"string",description:"使用者對這份文件的補充要求或讀者（會寫在副標題）"}},d=e=>async function(t){let n={};try{n=await this.repairJsonPayload(String(t||"{}"))}catch(e){}try{return JSON.stringify(await this._docgenRun(e,this._docgenArgsFromTool(n)))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}};e("docgen_design_guide","為一個專案寫「設計文件」：程式掃描原始檔取出建置、進入點、命令列、設定、路由、資料模型、硬體存取等事實（每筆都附檔案:行號），加權比對架構（OpenBMC、RTOS、BIOS、核心驅動、Web 服務、CGI、系統服務、GUI、分散式、外掛式命令列）、挑範本、組成文件並驗證所有引用，輸出成檔案卡片（md／mediawiki／html／pdf／docx）。找不到的東西不編，寫進「待確認與風險」。來源用 fap 資料夾或使用者上傳的程式碼。",d("design"),{type:"object",properties:c,additionalProperties:!1}),e("docgen_user_guide","為一個專案寫「使用手冊」：同樣先掃描取事實，再依專案類型（命令列、GUI、Web API、系統服務、驅動、BMC…）選範本，寫簡介、安裝、啟動、命令列選項、API、設定、疑難排解；內容只來自 README 與原始檔，附檔案:行號。輸出成檔案卡片。",d("user"),{type:"object",properties:c,additionalProperties:!1}),e("docgen_list_templates","列出文件範本（內建與使用者在 ⚙ 設定裡自訂的）：代號、類型（design／user）、適用架構、章節。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaDocgen.listTemplates(this._docgenSettings().templates).filter(e=>!t.kind||e.kind===t.kind);return JSON.stringify({ok:!0,templates:n.map(e=>({id:e.id,kind:e.kind,label:e.label,arch:e.arch,builtin:!!e.builtin,sections:e.sections}))})},{type:"object",properties:{kind:{type:"string",enum:["design","user"]}},additionalProperties:!1}),this._imageRegisterUnits(e),e("generate_image","畫圖的唯一入口（程式會先分流，不用你自己挑路線）：【工程圖／CAD 風格的尺寸圖（零件長寬厚、尺寸線、明細表、組裝步驟）也直接用這個工具：程式依零件表照尺寸畫，數字與比例都精準，不要自己手寫 SVG 座標；對話裡有零件表就用它，沒有就請它自己列】；使用者要「純 SVG」時，結果會附一個 .svg 檔下載。單純形狀的組合圖（流程圖、架構圖、圖表、幾何圖形、圖示…）由程式要求寫成 SVG／Mermaid 純文字再畫出來；要畫面的圖（照片、插畫、人物、風景、畫風…）由程式把需求拆成欄位（主體、動作、場景、畫風、光線、鏡頭、氣氛、色調）、依模型的吃法（SD／SDXS 逗號關鍵詞、FLUX 自然語句、SD3 混合）組成提示詞，再交給擴散模型（線上 NVIDIA 或本機小模型）。所以 prompt 直接給使用者的需求（中文也可以），不要自己改寫成英文咒語。可選參數：image（使用者貼的圖的 file_id：會先用視覺模型看懂，轉成描述當依據）、base_request（要先用純文字畫出一張工程圖／示意圖當基底，視覺模型看懂它之後再生成）、route（auto｜shapes｜diffusion，預設 auto）、style（畫風：photo｜cinematic｜anime｜watercolor｜oil｜sketch｜ink｜render3d｜pixel｜flat｜cyberpunk｜fantasy｜lowpoly｜clay｜illustration）、where（local｜remote：remote＝交給遠端群組裡的機器畫，圖會取回本機使用）、machine（where=remote 時的機器名稱或 auto）、provider（auto｜online｜local）、model、seed。回傳 file_id 與 client_file_url（可以直接用在簡報等地方）；圖已顯示在對話裡。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._imageMake(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{draft:{type:"boolean",description:"選填：false＝不畫構圖草稿（預設：場景類的圖會先用通用繪圖畫草稿、給視覺模型看）"},check:{type:"boolean",description:"選填：false＝不請視覺模型檢查成品缺不缺元素"},retouch:{type:"boolean",description:"選填：false＝不做成品後製（自動對比、亮度、飽和度、銳化）"},reflect:{type:"boolean",description:"選填：畫之前先「構想」——查場景素材目錄、請模型想要準備哪些主體與素材、各放哪裡（預設：場景類或不熟的概念才會想；false＝不想）"},prompt:{type:"string",description:"要畫什麼（使用者的需求，中文英文都可以）"},image:{type:"string",description:"選填：使用者貼的圖片的 file_id（會先看懂再生成）"},base_request:{type:"string",description:"選填：要先用純文字畫出的工程圖／示意圖基底的描述"},route:{type:"string",enum:["auto","shapes","diffusion"],description:"選填：auto（預設）、shapes（強制用 SVG／Mermaid 純文字畫）、diffusion（強制用擴散模型）"},style:{type:"string",enum:["photo","cinematic","anime","watercolor","oil","sketch","ink","render3d","pixel","flat","cyberpunk","fantasy","lowpoly","clay","illustration"],description:"選填：畫風"},where:{type:"string",enum:["local","remote"],description:"選填：remote＝交給遠端群組的機器畫，圖取回本機"},machine:{type:"string",description:"where=remote 時的機器名稱，或 auto"},provider:{type:"string",enum:["auto","online","local"],description:"選填：擴散模型用線上、本機小模型，或自動"},model:{type:"string",description:"選填：線上模型 廠商/模型名"},width:{type:"integer"},height:{type:"integer"},steps:{type:"integer"},seed:{type:"integer"},cfg_scale:{type:"number"}},required:["prompt"],additionalProperties:!1});{const t={url:{type:"string",description:"網頁的完整網址（wiki、新聞、小說章節頁…），會自動抓下來轉成文字"},file_id:{type:"string",description:"已上傳的檔案或 fetch_web_page 回傳的 file_id（txt、md、docx、pdf…都可以）"},text:{type:"string",description:"直接給文章文字"}},n=async(e,t)=>{e._articleCache=e._articleCache||new Map;const n=t.file_id?"f:"+t.file_id:t.url?"u:"+String(t.url).trim():t.text?"t:"+String(t.text).length+":"+String(t.text).slice(0,40):"";if(!n)return{error:"要給 url、file_id 或 text 其中一個"};const r=e._articleCache.get(n);if(r)return r;let s="",a="",i=t.file_id?String(t.file_id):"";if(t.text)s=String(t.text);else{if(t.url){const n=e.tools.fetch_web_page;if(!n)return{error:"這個環境沒有 fetch_web_page，改用 file_id 或 text"};let r;try{r=JSON.parse(await n.callback.call(e,JSON.stringify({url:String(t.url).trim()})))}catch(e){return{error:"抓取網頁失敗："+String(e&&e.message||e)}}if(!r||!1===r.ok)return{error:String(r&&r.error||"抓取網頁失敗")};i=r.file_id,a=r.title||""}const n=await e.fileCache.get(i);if(!n)return{error:"找不到檔案 file_id="+i};a||(a=n.filename||"");for(let t=0,r=0;r<40;r++){const r=await e._parseUploadedFileContent(n,{offset:t,maxChars:2e5});if(!r||!1===r.ok)return{error:String(r&&r.error||"讀不出這個檔案")};if("string"!=typeof r.content)return{error:"這種檔案沒有可以分章節的連續文字（格式："+(r.format||"?")+"）；表格或圖片請改用對應的工具"};if(s+=r.content,!r.has_more||null==r.next_offset||s.length>4e6)break;t=r.next_offset}}if(!s.trim())return{error:"文章是空的"};const o={key:n,file_id:i||null,title:a,text:s,outline:FaArticleOutline.outline(s)};return e._articleCache.size>8&&e._articleCache.delete(e._articleCache.keys().next().value),e._articleCache.set(n,o),o};e("article_outline","看一篇長文章的目錄（章節標題、層級、每節字數、開頭幾個字），之後用 article_section 挑要讀的章節——外面的 wiki、新聞、一整本小說、上傳的文件都適用，文章很長時一定先看目錄，不要從頭翻頁讀。標題的認法：Markdown、MediaWiki、HTML、編號標題、小說的「第一章／第十二回／Chapter 3／楔子／尾聲」；都沒有就依段落切成幾份。來源給 url（網頁，自動抓）、file_id（上傳的檔案或 fetch_web_page 抓回來的）或 text 其中一個。max_depth 只看上面幾層。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await n(this,t);if(e.error)return JSON.stringify({ok:!1,error:e.error});const r=t.max_depth?FaArticleOutline.outline(e.text,{max_depth:t.max_depth}):e.outline;return JSON.stringify({ok:!0,title:e.title,file_id:e.file_id,style:r.style,total_chars:r.total_chars,sections:r.sections.map(e=>({n:e.n,level:e.level,title:e.title,chars:e.chars,preview:e.preview})),next:"article_section 用 n（章節編號）、標題的一部分或 {from, to} 讀內容，長章節會分頁（has_more / next_offset）；來源用同一個 url／file_id"})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:Object.assign({max_depth:{type:"integer",description:"只列到第幾層標題（1 最上層）"}},t),additionalProperties:!1}),e("article_section","讀一篇長文章的某一章節（先用 article_outline 看目錄）。section＝目錄裡的編號 n，或標題的一部分（例如「第十二回」「分類」），或 {from, to} 連續幾節。長章節每次最多 max_chars 字（預設 12000），has_more 為 true 時用 offset=next_offset 接著讀。來源跟 article_outline 同一個（url／file_id／text）。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await n(this,t);if(e.error)return JSON.stringify({ok:!1,error:e.error});const r=FaArticleOutline.sectionText(e.text,e.outline,t.section,{offset:t.offset,maxChars:t.max_chars});return r.error?JSON.stringify({ok:!1,error:r.error}):JSON.stringify(Object.assign({ok:!0,title:e.title},r))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:Object.assign({section:{description:"章節編號（數字）、標題的一部分（字串），或 {from, to}"},offset:{type:"integer",description:"這一節裡從第幾個字元開始（接續上一次的 next_offset）"},max_chars:{type:"integer",description:"這次最多讀幾個字元，預設 12000"}},t),required:["section"],additionalProperties:!1})}e("summarize_large_text",'把一個已存進persistentStorage的大型文字內容（使用者上傳的檔案，或AI自己透過fetch_web_page等工具抓回來存進去的網頁內容——這類內容一樣會出現在list_uploaded_files清單裡）分段摘要——不論原始內容多長，都會自動切成多個區塊各自摘要、再彙整成一份涵蓋全文重點的最終摘要，不像parse_uploaded_file遇到超長純文字內容時會直接截斷丟棄後面的部分。壓縮檔（zip/tar/tgz）必須指定entry_path指定要摘要哪個內部檔案，不能對整個壓縮檔本身摘要；xlsx/docx/pptx這類二進位格式請改用parse_uploaded_file取得結構化內容。pdf視為長文字文件支援：會逐頁擷取文字、完整涵蓋全文不截斷（比parse_uploaded_file固定只看前12000字元更適合長文件），純掃描/圖片PDF因為沒有文字層（不支援OCR）擷取不到內容。內容越長，處理時間越久（每個區塊都是一次LLM往返），不是瞬間完成。參數: {"file_id":"...", "entry_path":"（選填，壓縮檔用）", "focus":"（選填）你想特別關注的重點方向，會用來引導每個區塊的摘要方向"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file_id||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file_id參數（用list_uploaded_files查詢可用的file_id）"});const r=await this.fileCache.get(n);if(!r||"uploaded"!==r.kind)return JSON.stringify({ok:!1,error:`找