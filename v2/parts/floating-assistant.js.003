= function () {\n    var self = this, ctx = getAudioCtx(); this.stopBed(); if (!ctx || !this.s.deck.soundtrack) { return; } var tok = this._bedTok;\n    this.s.prepareSoundtrack().then(function (mono) {\n      if (self._bedTok !== tok || !self.playing || !self.alive || !mono) { return; } var buf = ctx.createBuffer(1, mono.length, ctx.sampleRate); buf.getChannelData(0).set(mono);\n      var src = ctx.createBufferSource(); src.buffer = buf; src.connect(self.gain || ctx.destination); src.start(0, Math.max(0, Math.min(self.T || 0, buf.duration - 0.05))); self.bedSrc = src;\n    });\n  };\n  Player.prototype.stopBed = function () { this._bedTok = (this._bedTok || 0) + 1; if (this.bedSrc) { try { this.bedSrc.stop(); } catch (e) { /* 已停 */ } this.bedSrc = null; } };\n  Player.prototype.pause = function () { this.playing = false; this.stopAudio(); this.stopBed(); this.updateUi(); };\n  Player.prototype.toggle = function () { if (this.playing) { this.pause(); } else { this.play(); } };\n  Player.prototype.setSpeed = function (v) { this.speed = v; if (this.src) { try { this.src.playbackRate.value = v; } catch (e) { /* ended */ } } };\n  Player.prototype.setMuted = function (m) {\n    this.muted = m; this.muteBtn.textContent = m ? '🔇' : '🔊';\n    if (this.gain) { this.gain.gain.value = m ? 0 : 1; }\n  };\n\n  Player.prototype.stopAudio = function () {\n    if (this.src) { try { this.src.onended = null; this.src.stop(); } catch (e) { /* not started */ } this.src = null; }\n    this.audioFor = -1;\n  };\n  // Starts slide i's narration so it lines up with the playhead (a slide starts its narration LEAD seconds in). The decoded audio comes\n  // from the session's small LRU; if it is not there yet the start waits for the decode (a few ms) and re-reads the playhead.\n  // Sound effects (collage) while playing: fire every cue the playhead passed since the last frame; after a seek nothing behind the playhead is fired.\n  Player.prototype.syncSfx = function (loc) {\n    if (!this.playing || loc.phase !== 'body') { this.sfxLast = null; return; }\n    var cues = this.s.sfxFor(loc.i), last = this.sfxLast && this.sfxLast.i === loc.i ? this.sfxLast.t : loc.t;\n    if (loc.t < last || loc.t - last > 0.6) { last = loc.t; }\n    var self = this; cues.forEach(function (c) { if (c.t > last && c.t <= loc.t) { self.playSfx(c); } });\n    this.sfxLast = { i: loc.i, t: loc.t };\n  };\n  Player.prototype.playSfx = function (c) {\n    var ctx = getAudioCtx(); if (!ctx || this.muted) { return; }\n    var smp = sfxSamples(c.name, ctx.sampleRate, c); if (!smp.length) { return; }\n    var buf = ctx.createBuffer(1, smp.length, ctx.sampleRate); buf.copyToChannel(smp, 0);\n    var src = ctx.createBufferSource(), g = ctx.createGain(); src.buffer = buf; src.playbackRate.value = this.speed; g.gain.value = c.vol == null ? 0.8 : c.vol;\n    src.connect(g); g.connect(ctx.destination); src.start();\n  };\n  Player.prototype.syncAudio = function (loc) {\n    if (this.voicePanel && this.voicePanel._i !== loc.i) { this.closeVoicePanel(); }\n    if (!this.playing || loc.phase !== 'body') { if (loc.phase !== 'body') { this.stopAudio(); } return; }\n    if (this.audioFor === loc.i && this.audioObj === this.s.preps[loc.i].audio) { return; } // a redone narration starts over\n    this.stopAudio();\n    var self = this, idx = loc.i;\n    this.audioFor = idx;\n    var pr = this.s.preps[idx], ctx = getAudioCtx(); this.audioObj = pr.audio;\n    if (!pr.audio || !ctx) { return; }\n    this.s.audioBuffer(idx).then(function (buffer) {\n      if (!buffer || self.audioFor !== idx || !self.playing) { return; }\n      var now = self.loc();\n      if (now.i !== idx || now.phase !== 'body') { return; }\n      var narrStart = pr.timing.narrStart, dur = buffer.duration, offset = Math.max(0, now.t - narrStart);\n      if (offset >= dur) { return; }\n      var src = ctx.createBufferSource();\n      src.buffer = buffer; src.playbackRate.value = self.speed;\n      if (!self.gain) { self.gain = ctx.cr