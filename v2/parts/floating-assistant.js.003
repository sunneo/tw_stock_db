工作區（網頁版）。action: open（source=使用者專案資料夾的File Access Point參照 fap:名稱/子路徑，可選subpath只複製子資料夾；把專案複製一份到瀏覽器內部儲存OPFS並git init，回傳workspace_path=fap:ws-...與要告訴使用者的tell_user；已存在就接續）、status（cwd_abs=workspace_path，列出還沒轉移的新增/修改/刪除）、deploy（cwd_abs=workspace_path；dry_run:true只預覽；轉移回使用者資料夾，逐檔備份、寫入、讀回比對；使用者原檔在這段期間被改過會列為conflicts不覆蓋，force:true才強制）、discard（cwd_abs=workspace_path，刪除暫存區）。",a(async function(e){const t=String(e.cwd_abs||e.workspace_path||"").trim();return"open"===e.action?this._codingWsOpen({source:e.source||e.source_path,subpath:e.subpath}):"status"===e.action?this._codingWsStatus(t):"deploy"===e.action?this._codingWsDeploy(t,{dryRun:!!e.dry_run,force:!!e.force}):"discard"===e.action?this._codingWsDiscard(t):{ok:!1,error:"action必須是open/status/deploy/discard"}}),{type:"object",properties:{action:{type:"string",enum:["open","status","deploy","discard"]},source:{type:"string",description:"open：使用者專案資料夾，格式fap:<名稱或id>[/<子路徑>]"},subpath:{type:"string",description:"open：選填，只複製這個子資料夾（專案太大時用）"},cwd_abs:{type:"string",description:"status/deploy/discard：workspace_path（fap:ws-...）"},dry_run:{type:"boolean"},force:{type:"boolean"}},required:["action"],additionalProperties:!1});const i=e=>async function(t){let n={};try{n=await this.repairJsonPayload(String(t||"{}"))}catch(e){}try{return JSON.stringify(await e.call(this,n))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}};e("skill_create",'建立（或用overwrite:true更新）一個Claude格式的skill：SKILL.md（自動組出name/description frontmatter）＋選填的scripts/references/assets檔案。建立後立刻出現在Advance Settings的Skill分頁、可當domain使用。dry_run:true只驗證並回傳產生的SKILL.md不儲存。download:true會下載.skill壓縮檔（可放進Claude的skills資料夾）；save_to填File Access Point資料夾（fap:名稱/子路徑）會把整個skill資料夾寫進去。**files參數是合併、不是整包覆蓋**：overwrite:true更新既有skill時，這次files裡提到的路徑會被這次的新內容取代，先前已經存過、這次沒提到的路徑會維持原樣不會被清掉——依賴檔案很多、內容加起來很長時，直接分成好幾次呼叫、每次只帶幾個檔案即可，不用、也不要為了「一次到位」把所有檔案硬塞進同一次呼叫（單次呼叫的參數太長時，容易讓子任務生不出完整的工具呼叫而卡住重試）。參數: {"name":"pdf-form-filler","description":"做什麼＋什麼時候該用","body":"SKILL.md的Markdown內容(不含frontmatter)","files":[{"path":"references/api.md","content":"..."},{"path":"scripts/fill.py","content":"..."}],"overwrite":false,"dry_run":false,"download":false,"save_to":"fap:我的技能"}',i(function(e){return this._skillCreate(e)}),{type:"object",properties:{name:{type:"string",description:"小寫英文/數字/連字號，最長64字元，不可含anthropic/claude"},description:{type:"string",description:"最長1024字元：這個skill做什麼、什麼情境/關鍵字該觸發它（第三人稱）"},body:{type:"string",description:"SKILL.md主體(Markdown)，不要自己寫frontmatter，建議500行內"},files:{type:"array",items:{type:"object",properties:{path:{type:"string"},content:{type:"string"}},required:["path","content"]}},overwrite:{type:"boolean"},dry_run:{type:"boolean"},download:{type:"boolean"},save_to:{type:"string",description:"File Access Point資料夾，格式fap:<名稱或id>[/<子路徑>]"}},required:["name","description","body"],additionalProperties:!1}),e("skill_list","列出目前app內所有skill（名稱、description、附帶檔案清單、是否啟用）。",i(async function(){return{ok:!0,skills:this._skillList()}}),{type:"object",properties:{},additionalProperties:!1}),e("explain_code",'解釋原始碼／組合語言在做什麼（內建的程式行為分析，不需要 AI 讀程式碼）：由下而上、沿正向路徑產生可折疊的說明——函式／檔案自己的註解優先，程式碼區塊上的註解部分採用（文字重排後取最相關的句子），aidoc 裡 AI 或使用者補的說明比自動產生的優先；沒有註解就用「呼叫了什麼」的事實（引數與回傳值語意、行為分類、組合語言 idiom）。支援 C／C++（含 C++ 標準函式庫 STL 的名稱表）、Rust、Go、Java、JavaScript、Python、Shell、PowerShell、Batch、GLSL、x86／ARM 組合語言、LLVM IR、PTX、WASM 文字格式。參數: {"path":"檔案路徑","root":"aidoc 專案資料夾（選填，帶了就會用該專案索引裡的說明）","function":"只看這個函式（選填）","lang":"強制指定語言（選填）","text":"直接給原始碼文字（選填，跟 path 擇一）"}。回傳的 unclassified_calls 是還不認得的呼叫——讀過確認後用 behavior_define 補定義。',i(function(e){return this._behExplain(e)}),{type:"object",properties:{path:{type:"string"},root:{type:"string"},function:{type:"string"},lang:{type:"string"},text:{type:"string"},max_functions:{type:"integer"}},additionalProperties:!1}),e("behavior_define",'補充或管理「程式行為分析」的定義（持久保存在本機、和內建定義合併、可匯出匯入）：讓 explain_code 下次認得新的函式／行為／組合語言 idiom。從對話、RAG、aidoc 互動中讀過原始碼或文件、確認了某個呼叫做什麼，就補進來。action: add_api（{lang,name,summary,parameters:[{name,meaning}],return:{meaning,rules:[{when:{op,value},meaning}]}}）、add_note（{lang,name,note}，一句話說明）、add_signature（{category,lang,names:[…],label?,description?}，把呼叫名稱歸進行為分類）、add_idiom（{arch,pattern:["rep","stosb"],name,template}）、import（{data:JSON或YAML文字，可以是匯出檔，也可以是 Domain Resolver 的 behavior_patterns.yml／api_semantics.yml}）、export、list、remove（{kind:"api|note|category",lang,name}）。只補確認過的事實，不要猜。',i(function(e){return this._behDefine(e)}),{type:"object",properties:{action:{type:"string"},lang:{type:"string"},name:{type:"string"},names:{type:"array",items:{type:"string"}},summary:{type:"string"},note:{type:"string"},category:{type:"string"},label:{type:"string"},description:{type:"string"},arch:{type:"string"},pattern:{type:"array",items:{type:"string"}},template:{type:"string"},parameters:{type:"array",items:{type:"object"}},return:{type:"object"},kind:{type:"string"},data:{}},required:["action"],additionalProperties:!1}),e("lookup_error_code",'查錯誤碼的意思（離線可用）：Linux errno（EACCES、13、-ENOMEM）、訊號（SIGSEGV、11）、shell 退出碼（139、127）、Windows Win32 錯誤（ERROR_ACCESS_DENIED、5、GetLastError）、HRESULT（0x80070005）與解碼、NTSTATUS（0xC0000005，也吃帶號整數 -1073741819）、Winsock（10061）。回傳名稱、原文訊息、白話原因與常見處理。查不到時提示可請 AI 查官方文件後用 ref_define 補。參數：{"query":"errno 13"}',i(function(e){return this._refLookupError(e)}),{type:"object",properties:{query:{type:"string",description:'錯誤碼、名稱或描述，例如 "errno 13"、"0xC0000005"、"ERROR_ACCESS_DENIED"、"exit code 139"、"connection refused"'},system:{type:"string",description:"可選：限定 linux／windows"}},required:["query"],additionalProperties:!1}),e("explain_command_line",'逐項解釋一行命令（離線可用）：gcc／g++／javac／java／python／node／gdb／qemu-system-arm／qemu-system-aarch64／qemu-system-x86_64（含 -M 機型、-cpu、-drive／-device／-netdev 的子選項、-append 核心命令列）以及常用的 Linux 命令（grep、find、tar、curl、ssh、rsync、systemctl、git、docker、cmake、make…，內容來自 man 手冊重點）。回傳整體在做什麼與每個選項的意義。參數：{"command":"qemu-system-aarch64 -M virt -cpu cortex-a53 -kernel Image -nographic"}',i(function(e){return this._refExplainCmd(e)}),{type:"object",properties:{command:{type:"string",description:"完整命令列"}},required:["command"],additionalProperties:!1}),e("diagnose_log",'診斷一段日誌，說明「發生了什麼事」（離線可用，規則比對，不需要 AI）：建置失敗（make、CMake、BitBake／Yocto、ninja、Meson、autotools、Kbuild、gcc／g++／clang 編譯錯誤、ld 連結錯誤、Maven、Gradle、npm、Cargo、pip、Go）、gdb 訊息、Linux 核心日誌（dmesg）、kernel panic／Oops、systemd／journal、執行期錯誤。回傳：判斷是哪個系統、根本原因（附白話說明、常見原因、怎麼處理）、連帶結果（例如 make 的 Error 1 只是結果）、傳遞路徑（編譯器錯誤→make→BitBake 任務失敗）、還沒有規則的錯誤行（會進待學習清單，之後 AI 可補規則）。整段日誌貼進去效果最好。參數：{"log":"日誌文字"}',i(function(e){return this._refDiagnose(e)}),{type:"object",properties:{log:{type:"string",description:"日誌或錯誤輸出（整段貼上最好，不要只貼最後一行）"},system:{type:"string",description:"可選：已知的系統（bitbake、cmake、make、kernel、journal、gdb…）"}},required:["log"],additionalProperties:!1}),e("explain_build_error",'說明建置錯誤（diagnose_log 的別名，專給 make／CMake／BitBake／gcc／ld 的建置輸出）：找出根本原因、連帶結果與傳遞路徑，並說明常見原因與處理方式。離線可用。參數：{"log":"建置輸出"}',i(function(e){return this._refDiagnose(e)}),{type:"object",properties:{log:{type:"string",description:"建置輸出（整段貼上最好）"}},required:["log"],additionalProperties:!1}),e("ref_lookup",'查參考知識（離線可用）：錯誤碼、命令與單一選項（gcc -fPIC、gdb 的 x 命令）、#pragma（omp parallel for reduction…、GCC diagnostic）、以及使用者與 AI 補的語意／文法／分詞／組合語言／建置系統知識。查不到時回報並提示用 ref_define 補。參數：{"query":"omp parallel for"}',i(function(e){return this._refLookupAny(e)}),{type:"object",properties:{query:{type:"string",description:"要查的東西"}},required:["query"],additionalProperties:!1}),e("ref_define","補充或管理參考知識（持久保存在本機，離線訓練器與程式行為分析都立刻用到；可匯出給開發者升級成內建）。action:add（預設）時要給 kind 與 source（官方文件網址或文件名稱，沒有來源不收）。kind：error_code{system,code,name,message,note}、command{name,aliases,summary,synopsis,options[]}、option{command,flag,arg,desc}、pragma／clause{key,desc}、api{name,lang,summary,parameters,return}、note{name,note}、signature{category,names}、mnemonic{arch,category,name,description}、idiom{arch,pattern,name,template}、semantics／grammar_pattern／tokenizer／assembly／build_system{key,text,tags,rules}。其他 action：list、remove、export、export_builtin（輸出內建來源檔格式）、import、stats。",i(function(e){return this._refDefine(e)}),{type:"object",proper