, piece = Math.min(256 * MiB, need.maxBufferSize);\n    const scratch = new Uint8Array(16 * MiB);\n    const release = () => { while (bufs.length) { try { bufs.pop().destroy(); } catch (_) { /* 已釋放 */ } } };\n    const settle = async () => { if (dev.queue.onSubmittedWorkDone) await dev.queue.onSubmittedWorkDone(); };\n    // 配置到累計 target 位元組；回 { ok, mbps }\n    const alloc = async (target) => {\n      dev.pushErrorScope('out-of-memory'); dev.pushErrorScope('validation');\n      let have = bufs.reduce((a, b) => a + b.size, 0), last = null, ms = 0;\n      try {\n        while (have < target) {\n          const n = Math.min(piece, target - have); const b = dev.createBuffer({ size: n, usage: USAGE.STORAGE | USAGE.COPY_DST }); bufs.push(b); have += n; last = b;\n          dev.queue.writeBuffer(b, 0, scratch, 0, 256);   // 觸碰：逼驅動真的提交這塊記憶體\n        }\n        await settle();\n        if (last) { const t = nowF(); const w = Math.min(scratch.length, last.size & ~3); dev.queue.writeBuffer(last, 0, scratch, 0, w); await settle(); ms = Math.max(0.001, nowF() - t); }\n      } catch (e) { /* 下面看錯誤範圍 */ }\n      const e1 = await dev.popErrorScope(), e2 = await dev.popErrorScope();\n      const err = e1 || e2;\n      return { ok: !err && !lost, mbps: ms ? (Math.min(scratch.length, last.size) / MiB) / (ms / 1000) : 0 };\n    };\n    try {\n      if (o.bench) { try { R.gflops = await o.bench(dev); } catch (_) { /* 基準失敗不影響探測 */ } }\n      // 階段一：倍增（256 MiB 起）\n      let okB = 0, failB = 0, t = 256 * MiB;\n      while (t <= cap) {\n        if (nowF() > deadline) { R.truncated = true; break; }\n        const r = await alloc(t); R.steps.push({ bytes: t, ok: r.ok, mbps: +r.mbps.toFixed(0) }); log('探測 ' + fmt(t) + '：' + (r.ok ? '成功 ' + r.mbps.toFixed(0) + ' MB/s' : '失敗'));\n        if (!r.ok) { failB = t; break; }\n        okB = t; if (lost) break; t *= 2;\n      }\n      // 階段二：在 (okB, failB) 之間二分三次（解析度到 1/8 區間）\n      for (let i = 0; i < 3 && failB && !lost && okB; i++) {\n        if (nowF() > deadline) { R.truncated = true; break; }\n        const mid = Math.floor((okB + failB) / 2 / (64 * MiB)) * 64 * MiB; if (mid <= okB || mid >= failB) break;\n        release(); const r = await alloc(mid); R.steps.push({ bytes: mid, ok: r.ok, mbps: +r.mbps.toFixed(0) });\n        log('二分 ' + fmt(mid) + '：' + (r.ok ? '成功' : '失敗')); if (r.ok) okB = mid; else failB = mid;\n      }\n      R.lost = lost;\n      const a = analyze(R.steps.slice().sort((x, y) => x.bytes - y.bytes), cap);\n      Object.assign(R, a); R.writeMBps = (R.steps.find((s) => s.ok && s.mbps > 0) || {}).mbps || 0;\n      R.ok = a.suggestBytes > 0;\n      R.reason = lost ? 'GPU 裝置在探測中遺失（' + lost + '），結果不可信' : !R.ok ? '連 256 MiB 都配置失敗'\n        : '實測可用約 ' + fmt(a.usableBytes) + (a.spillSuspected ? '（再往上寫入頻寬掉到 ' + Math.round(SPILL_RATIO * 100) + '% 以下，疑似溢出到系統記憶體）' : a.hitCap ? '（到探測上限仍成功，實際可能更多）' : '') + '，建議上限 ' + fmt(a.suggestBytes) + '（×' + SAFETY + '）';\n      if (lost) R.ok = false;\n    } finally {\n      release(); try { dev.destroy && dev.destroy(); } catch (_) { /* */ }\n    }\n    return R;\n  }\n\n  return { probe, analyze, resolveBudget, parseMB, fmt, DEFAULT_AUTO_BYTES, SAFETY, SPILL_RATIO, MiB, GiB };\n});\n\n};\nMODS[\"qwen_models\"] = function (module, exports, require) {\n'use strict';\n// qwen_models.js — Qwen3 q8 GPU 解碼可用的模型表、本機路徑、下載（分段、可續傳、核對大小與 sha256）與讀入（DESIGN.webgpu-cuda.md §7.30）。\n// 只放純邏輯，依賴（rawfs、fetch、sha256）都由呼叫端注入，node 可用假物件測試。\n// 為什麼在 renderer 下載：主程序檔（native-slot-model.js）不能熱更新；rawfs（fa:rawfs:*）已在白名單，所以用 Range 請求分段取回、每段寫成獨立檔（續傳＝略過大小相符的段）。\n// 儲存：<userData>/native-models/<dir>/（0.6B 是主程序流程下載的單一檔 onnx/model_quantized.onnx；1.7B 是 parts/p00000.bin… ＋ manifest.json）。\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) module.exports = factory();\n  else root.FaQwenModels = factory();\n})(typeof self !== 'undefined' ? self : this, function () {\n  const MiB = 1048576, GiB = 1073741824;\n  const TOK = { rel: 'tokenizer.json', bytes: 9117040, sha256: 'e7a95fce95bf5b0946d0ddb3f9d7caa030b7e850bbe92b0edb26bcf563e9f3d5' };   // Qwen3 全系列共用同一份\n  const MODELS = {\n    'qwen3-0.6b': { id: 'qwen3-0.6b', dir: 'qwen3-0.6b-q8', repo: 'onnx-community/Qwen3-0.6B-ONNX', label: 'Qwen3 0.6B', family: 'qwen3', downloadHere: false,\n      file: { rel: 'onnx/model_quantized.onnx', bytes: 617687575, sha256: 'ccf8734e59fdf7475b2dc0c117005e267a3a08342c1d951e0a79f0bce57bf62a' }, tokenizer: TOK, slowdown: 1, lora: true, q4: { rel: 'onnx/model_q4f16.onnx', bytes: 569789750 }, shape: { D: 1024, H: 16, Hkv: 8, I: 3072, L: 28, V: 151936 } },\n    'qwen3-1.7b': { id: 'qwen3-1.7b', dir: 'qwen3-1.7b-q8', repo: 'onnx-community/Qwen3-1.7B-ONNX', label: 'Qwen3 1.7B', family: 'qwen3', downloadHere: true, partBytes: 16 * MiB,\n      file: { rel: 'onnx/model_quantized.onnx', bytes: 1742387852, sha256: '202ed81928b7f34c31505b46479c310e131fec307a045eab2537e7c494feb427' }, tokenizer: TOK, slowdown: 2.5, lora: false, q4: { rel: 'onnx/model_q4f16.onnx', bytes: 1426069098 }, shape: { D: 2048, H: 16, Hkv: 8, I: 6144, L: 28, V: 151936 } },\n  };\n  // 模型族＋模型清單（O12d）。MODELS 仍只放 Qwen3（它是 GPU 解碼的既有路徑，get／getQ4 的行為不變）；\n  // 其他族的模型放在 EXTRA_MODELS：可以列出、判斷族、算大小，但 get() 不回它們，所以既有的 Qwen GPU 判斷（_qwenGpuModelOk 等）不會誤認。\n  const LLAMA_TOK = { rel: 'tokenizer.json', bytes: 11574638, sha256: '3a223ade375cc1d13b04e897ce1d36a04f50140e1ba3d107021ea68d4b5e614c' };\n  const EXTRA_MODELS = {\n    'llama-3.2-1b': { id: 'llama-3.2-1b', dir: 'llama-3.2-1b-q8', repo: 'onnx-community/Llama-3.2-1B-Instruct-ONNX', label: 'Llama 3.2 1B', family: 'llama', downloadHere: true, partBytes: 16 * MiB,\n      file: { rel: 'onnx/model_quantized.onnx', bytes: 1236653951, sha256: 'ad53ed44994c27ab60e8024e83fcd83ce38db4d4ad3a28549b432480eb84d180' }, tokenizer: LLAMA_TOK,\n      verifiedSha: false,   // 2026-11-18 只讀 HF 標頭（X-Linked-Size／X-Linked-ETag）：model_quantized.onnx 的大小與 sha256、tokenizer.json 的大小與 sha256 都與表一致；但位元組還沒下載，所以 verifiedSha 仍為 false。下載完成時 download() 會核對並寫進 manifest\n      shape: { D: 2048, H: 32, Hkv: 8, I: 8192, L: 16, V: 128256, hd: 64 },\n      note: '只在模型清單：Qwen GPU 路徑不認得它（get() 不回它）；通用骨架的 GPU 路徑尚未接上 app，所以 app 目前仍走 ONNX' },\n  };\n  const FAMILY_MODELS = { qwen3: ['qwen3-0.6b', 'qwen3-1.7b'], llama: ['llama-3.2-1b'] };\n  const get = (id) => MODELS[id] || null;\n  const modelOf = (id) => MODELS[id] || EXTRA_MODELS[id] || null;   // 所有族的模型（不含只給 GPU 判斷用的資訊）\n  const familyModels = (fam) => (FAMILY_MODELS[fam] || []).map((id) => modelOf(id)).filter(Boolean);\n  const getQ4 = (id) => (MODELS[id] && MODELS[id].q4 ? MODELS[id] : null);   // 有 q4f16 檔（transformers.js 預設的 GPU 格式）的模型\n  // 載入描述表（llm_arch.js）：node 用 require；瀏覽器用 self.FaLlmArch。找不到就回 null，改用舊的 qwen3 判斷（不讓載入失敗）。\n  function archMod() {\n    try { if (typeof require === 'function') return require('./llm_arch.js'); } catch (_) { /* 嵌入的模組載入器可能沒有這個檔 */ }\n    try { return (typeof self !== 'undefined' && self.FaLlmArch) || null; } catch (_) { return null; }\n  }\n  // 依描述表判斷：模型表有的，或描述表（supported）認得的族。\n  const isFamily = (id) => {\n    if (MODELS[id] || EXTRA_MODELS[id]) return true;\n    const A = archMod();\n    if (A && typeof A.familyFor === 'function') return !!A.familyFor(id);\n    return /^qwen3-/.test(String(id || ''));\n  };\n  const urlOf = (m, rel) => 'https://huggingface.co/' + m.repo + '/resolve/main/' + rel;\n  const pad = (i) => String(i).padStart(5, '0');\n  const nParts = (m) => Math.ceil(m.file.bytes / m.partBytes);\n  const partLen = (m, i) => Math.min(m.partBytes, m.file.bytes - i * m.partBytes);\n  const sizeOfStat = (st) => (st && (st.size != null ? st.size : st.sizeBytes));\n  const fmt = (b) => (b >= GiB ? (b / GiB).toFixed(2) + ' GiB' : Math.round(b / MiB) + ' MiB');\n\n  // userDataDir（例如 st.box 的上一層）→ 各路徑；sep 由呼叫端依平台給\n  function paths(m, userData, sep) {\n    const dir = userData + sep + 'native-models' + sep + m.dir;\n    return { dir, model: dir + sep + 'onnx' + sep + 'model_quantized.onnx', onnxDir: dir + sep + 'onnx', tok: dir + sep + 'tokenizer.json', parts: dir + sep + 'parts', manifest: dir + sep + 'parts' + sep + 'manifest.json', part: (i) => dir + sep + 'parts' + sep + 'p' + pad(i) + '.bin', sep };\n  }\n  const statOr = async (raw, p) => { try { return sizeOfStat(await raw.stat(p)); } catch (_) { return -1; } };\n\n  // 本機狀態：single（整檔大小相符）｜parts（分段齊全且 manifest.ok）｜partial（有一部分，可續傳）｜none\n  async function status(raw, m, P) {\n    if ((await statOr(raw, P.model)) === m.file.bytes && (await statOr(raw, P.tok)) > 0) return { state: 'single', have: m.file.bytes, total: m.file.bytes };\n    let have = 0, ok = 0; const n = m.partBytes ? nParts(m) : 0;\n    for (let i = 0; i < n; i++) { const s = await statOr(raw, P.part(i)); if (s === partLen(m, i)) { have += s; ok++; } }\n    const tokOk = (await statOr(raw, P.tok)) > 0;\n    let man = null; try { const r = await raw.readFile(P.manifest, 'utf8'); man = JSON.parse(r.text != null ? r.text : r.content); } catch (_) { /* 還沒有 */ }\n    if (n && ok === n && tokOk && man && man.ok && man.bytes === m.file.bytes) return { state: 'parts', have, total: m.file.bytes, manifest: man };\n    return { state: have > 0 ? 'partial' : 'none', have, total: m.file.bytes, parts: ok, nParts: n };\n  }\n\n  // 下載（只在使用者按下載後呼叫）。deps：raw、fetch、toBase64(u8)、sha256Hex(u8)→Promise<string>（可省略＝只驗大小）、onProgress({done,total,part,nParts})、isStopped()\n  async function download(m, userData, sep, deps) {\n    if (!m.downloadHere) throw new Error(m.label + ' 由桌面版的原生模型流程下載，這裡不處理');\n    const raw = deps.raw, P = paths(m, userData, sep), stop = () => { if (deps.isStopped && deps.isStopped()) { const e = new Error('使用者已停止'); e.isStopped = true; throw e; } };\n    await raw.mkdir(P.parts); await raw.mkdir(P.onnxDir);\n    const get1 = async (url, range) => {\n      const r = await deps.fetch(url, range ? { headers: { Range: 'bytes=' + range[0] + '-' + range[1] } } : {});\n      if (!r.ok && r.status !== 206) throw new Error('下載失敗：HTTP ' + r.status + ' ' + url);\n      return new Uint8Array(await r.arrayBuffer());\n    };\n    // tokenizer（小檔，核對大小與 sha256）\n    if ((await statOr(raw, P.tok)) !== m.tokenizer.bytes) {\n      const t = await get1(urlOf(m, m.tokenizer.rel)); if (t.length !== m.tokenizer.bytes) throw new Error('tokenizer 大小不符（' + t.length + '／' + m.tokenizer.bytes + '）');\n      if (deps.sha256Hex && m.tokenizer.sha256 && (await deps.sha256Hex(t)) !== m.tokenizer.sha256) throw new Error('tokenizer sha256 不符');\n      await raw.writeFile(P.tok, { base64: deps.toBase64(t) });\n    }\n    const n = nParts(m); let done = 0;\n    for (let i = 0; i < n; i++) { if ((await statOr(raw, P.part(i))) === partLen(m, i)) done += partLen(m, i); }   // 續傳：大小相符的段略過\n    if (deps.onProgress) deps.onProgress({ done, total: m.file.bytes, part: 0, nParts: n, resumed: done > 0 });\n    for (let i = 0; i < n; i++) {\n      stop(); const len = partLen(m, i);\n      if ((await statOr(raw, P.part(i))) === len) continue;\n      let u8 = null, lastErr = null;\n      for (let tr = 0; tr < 3 && !u8; tr++) { try { u8 = await get1(urlOf(m, m.file.rel), [i * m.partBytes, i * m.partBytes + len - 1]); if (u8.length !== len) { lastErr = new Error('第 ' + i + ' 段大小不符（' + u8.length + '／' + len + '）'); u8 = null; } } catch (e) { lastErr = e; } }\n      if (!u8) throw lastErr || new Error('下載失敗');\n      await raw.writeFile(P.part(i), { base64: deps.toBase64(u8) });\n      if ((await statOr(raw, P.part(i))) !== len) throw new Error('第 ' + i + ' 段寫入後大小不符（磁碟空間不足？）');\n      done += len; if (deps.onProgress) deps.onProgress({ done, total: m.file.bytes, part: i + 1, nParts: n });\n    }\n    // 整檔核對：讀回、驗大小與 sha256（記憶體吃緊時 digest 可能失敗：那就只驗大小並在 manifest 註明）\n    stop(); const bytes = await readBytes(m, userData, sep, { raw, isStopped: deps.isStopped, partsOnly: true });\n    let verified = false, note = '';\n    if (bytes.length !== m.file.bytes) throw new Error('整檔大小不符（' + bytes.length + '／' + m.file.bytes + '）');\n    if (deps.sha256Hex && m.file.sha256) { try { const h = await deps.sha256Hex(bytes); if (h !== m.file.sha256) { await raw.remove(P.parts, true); throw new Error('sha256 不符（' + h.slice(0, 12) + '… ≠ ' + m.file.sha256.slice(0, 12) + '…），已刪除分段，請重新下載'); } verified = true; } catch (e) { if (/sha256 不符/.test(e.message)) throw e; note = 'sha256 沒有核對（' + String((e && e.message) || e).slice(0, 80) + '），只驗了大小'; } }\n    await raw.writeFile(P.manifest, { text: JSON.stringify({ ok: true, bytes: m.file.bytes, sha256: m.file.sha256, verifiedSha: verified, note, at: Date.now() }) });\n    return { ok: true, verifiedSha: verified, note, bytes: bytes.length };\n  }\n\n  // 讀入模型位元組：整檔（0.6B，用注入的 readLarge 分段複製讀入）或 parts（1.7B）\n  async function readBytes(m, userData, sep, deps) {\n    const raw = deps.raw, P = paths(m, userData, sep), stop = () => { if (deps.isStopped && deps.isStopped()) { const e = new Error('使用者已停止'); e.isStopped = true; throw e; } };\n    if (!deps.partsOnly && (await statOr(raw, P.model)) === m.file.bytes) { if (!deps.readLarge) throw new Error('缺少 readLarge'); return deps.readLarge(P.model, P.dir + sep + '_gpu_parts'); }\n    const out = new Uint8Array(m.file.bytes); let off = 0; const n = nParts(m);\n    for (let i = 0; i < n; i++) {\n      stop(); const r = await raw.readFile(P.part(i), 'base64'); const bin = atob(r.base64);\n      if (bin.length !== partLen(m, i) || off + bin.length > out.length) throw new Error('第 ' + i + ' 段大小不符（' + bin.length + '）');\n      for (let k = 0; k < bin.length; k++) out[off + k] = bin.charCodeAt(k);\n      off += bin.length;\n    }\n    if (off !== m.file.bytes) throw new Error('讀入的大小不符（' + off + '／' + m.file.bytes + '）');\n    return out;\n  }\n  async function remove(m, userData, sep, raw) { const P = paths(m, userData, sep); await raw.remove(P.dir, true); }\n\n  // 只有形狀、沒有權重內容的 W（長度正確），給 estimateEngineBytes／planLayers 在不載入模型時估算用（介面顯示「需要多少、放不放得下」）\n  function shapeW(shape, fmt) {\n    const q4 = fmt === 'q4', hd = shape.hd || 128, mk = (K, N) => (q4 ? { W: { length: N * (K / 32) * 16 }, S: { length: N * (K / 32) * 2 }, K, N } : { W: { length: K * N } }), { D, H, Hkv, I, L, V } = shape;\n    return { fmt: q4 ? 'q4' : undefined, D, H, Hkv, hd, I, V, L, finalNorm: { byteLength: D * 4 }, emb: { W: { length: V * D * (q4 ? 2 : 1) } }, layers: Array.from({ length: L }, () => ({ q: mk(D, H * hd), k: mk(D, Hkv * hd), v: mk(D, Hkv * hd), o: mk(H * hd, D), g: mk(D, I), u: mk(D, I), d: mk(I, D), inNorm: { byteLength: D * 4 }, postNorm: { byteLength: D * 4 } })) };\n  }\n  const CFGS = [{ maxT: 2048, maxM: 256 }, { maxT: 1024, maxM: 128 }, { maxT: 512, maxM: 64 }];\n  // 依 GPU 記憶體上限挑配置（G＝FaQwenGpu）：先找「全常駐」的最大序列上限（快），找不到再允許分層（序列上限由大到小、1024 起，常駐層盡量多）；都放不下回 ok:false（minNeed＝最小分層配置的需求）\n  function choosePlan(G, W, budgetBytes) {\n    for (const c of CFGS) { const p = G.planLayers(W, { maxT: c.maxT, maxM: c.maxM, budgetBytes, allowStream: false }); if (p.ok) return { ok: true, cfg: c, plan: p, mode: 'full' }; }\n    for (const c of CFGS.slice(1)) { const p = G.planLayers(W, { maxT: c.maxT, maxM: c.maxM, budgetBytes }); if (p.ok) return { ok: true, cfg: c, plan: p, mode: 'streamed' }; }\n    const c = CFGS[CFGS.length - 1], p = G.planLayers(W, { maxT: c.maxT, maxM: c.maxM, budgetBytes });\n    return { ok: false, cfg: c, plan: p, mode: 'none' };\n  }\n  // 一行說明（介面用）：「需要約 X MB、上限 Y MB → 全常駐／分層（常駐 N／L 層）／放不下」\n  function describe(G, m, budgetBytes, fmt) {\n    const q4 = fmt === 'q4', W = shapeW(m.shape, fmt), tag = q4 ? ' q4f16' : ' q8', r = choosePlan(G, W, budgetBytes), mb = (b) => Math.round(b / MiB) + ' MB', fullNeed = G.estimateEngineBytes(W, { maxT: 2048, maxM: 256 }).total;\n    if (r.mode === 'full') return { mode: 'full', text: m.label + tag + '：全部放進 GPU 約需 ' + mb(r.plan.need.total) + '（序列上限 ' + r.cfg.maxT + '），上限 ' + mb(budgetBytes) + ' → 全常駐' };\n    if (r.mode === 'streamed') return { mode: 'streamed', resident: r.plan.resident, text: m.label + tag + '：全部放進 GPU 約需 ' + mb(fullNeed) + '，上限 ' + mb(budgetBytes) + ' → 分層（常駐 ' + r.plan.resident + '／' + W.L + ' 層，其餘每步串流，較慢；序列上限 ' + r.cfg.maxT + '）' };\n    return { mode: 'none', text: m.label + tag + '：全部約需 ' + mb(fullNeed) + '，最小分層配置也要 ' + mb(r.plan.need.total) + '，上限 ' + mb(budgetBytes) + ' → 放不下（GPU 解碼不用，改走其他路徑）' };\n  }\n  return { shapeW, choosePlan, describe, MODELS, EXTRA_MODELS, FAMILY_MODELS, get, modelOf, familyModels, getQ4, isFamily, paths, status, download, readBytes, remove, urlOf, nParts, partLen, fmt, TOK };\n});\n\n};\nMODS[\"conv_ops\"] = function (module, exports, require) {\n'use strict';\n// 共用卷積核心（MOSS codec、Basic Pitch、Whisper 編碼器共用，不要各模型各寫一份）。\n// 介面（全部 NCL / NCHW 佈局，列主序）：\n//   conv1dRef(x, N, C, L, w, M, Cg, K, b, p) → Float32Array(N×M×Lout)\n//   conv2dRef(x, N, C, H, W, w, M, Cg, KH, KW, b, p) → Float32Array(N×M×Hout×Wout)\n//   conv1d(x, N, C, L, w, M, Cg, K, b, p, ops) → Promise<Float32Array>   （T1 WGSL → cpu-js 退路）\n//   conv2d(x, N, C, H, W, w, M, Cg, KH, KW, b, p, ops) → Promise<Float32Array>   （同上，二維）\n// p = { stride, pads:[左,右] (1D) 或 [上,左,下,右] (2D), dilation, groups }\n// 權重 w 佈局 [M, Cg, K]（1D）或 [M, Cg, KH, KW]（2D）；Cg = C / groups。\n// 轉置卷積：MOSS codec 圖中沒有 ConvTranspose（已確認算子清單），暫不實作。\n// Basic Pitch（核 3×3 等 2D）與 Whisper 編碼器（Conv1d，核 3、stride 1／2）的參數都在這兩個函式涵蓋內。\nconst nn = require('./nn_ops.js');\n// R5：im2col＋平鋪矩陣乘（conv2d 的 groups=1、N=1 路徑）；載入失敗就退回直接卷積（不會選到不存在的核心）\nlet IM2COL = null, MM_TILED_WGSL = null;\ntry { IM2COL = require('./conv_im2col.js'); } catch (_) { IM2COL = null; }\ntry { MM_TILED_WGSL = require('./gpu_core.js').mmTileWgsl({ marker: 'matmul_tiled', dtype: 'f32' }); } catch (_) { MM_TILED_WGSL = null; }\n\nfunction norm1(p) {\n  const o = p || {};\n  return { stride: o.stride || 1, pad0: o.pads ? o.pads[0] : 0, pad1: o.pads ? o.pads[1] : 0, dil: o.dilation || 1, groups: o.groups || 1 };\n}\nfunction norm2(p) {\n  const o = p || {};\n  const pd = o.pads || [0, 0, 0, 0];\n  return { sh: (o.strides || [1, 1])[0], sw: (o.strides || [1, 1])[1], pt: pd[0], pl: pd[1], pb: pd[2], pr: pd[3], dh: (o.dilations || [1, 1])[0], dw: (o.dilations || [1, 1])[1], groups: o.groups || 1 };\n}\n\n// ---------- CPU 參考（逐元素，雙精度累加）----------\nfunction conv1dRef(x, N, C, L, w, M, Cg, K, b, p) {\n  const q = norm1(p), G = q.groups, Mg = M / G;\n  const Lout = Math.floor((L + q.pad0 + q.pad1 - q.dil * (K - 1) - 1) / q.stride) + 1;\n  if (Cg * G !== C) throw new Error('conv1d：C 與 Cg×groups 不符');\n  const y = new Float32Array(N * M * Lout);\n  for (let n = 0; n < N; n++) for (let m = 0; m < M; m++) {\n    const g = Math.floor(m / Mg);\n    for (let t = 0; t < Lout; t++) {\n      let acc = b ? b[m] : 0;\n      for (let c = 0; c < Cg; c++) {\n        const ic = g * Cg + c;\n        for (let k = 0; k < K; k++) {\n          const pos = t * q.stride - q.pad0 + k * q.dil;\n          if (pos < 0 || pos >= L) continue;\n          acc += x[(n * C + ic) * L + pos] * w[(m * Cg + c) * K + k];\n        }\n      }\n      y[(n * M + m) * Lout + t] = acc;\n    }\n  }\n  return y;\n}\n\nfunction conv2dRef(x, N, C, H, W, w, M, Cg, KH, KW, b, p) {\n  const q = norm2(p), G = q.groups, Mg = M / G;\n  const Hout = Math.floor((H + q.pt + q.pb - q.dh * (KH - 1) - 1) / q.sh) + 1;\n  const Wout = Math.floor((W + q.pl + q.pr - q.dw * (KW - 1) - 1) / q.sw) + 1;\n  if (Cg * G !== C) throw new Error('conv2d：C 與 Cg×groups 不符');\n  const y = new Float32Array(N * M * Hout * Wout);\n  for (let n = 0; n < N; n++) for (let m = 0; m < M; m++) {\n    const g = Math.floor(m / Mg);\n    for (let i = 0; i < Hout; i++) for (let j = 0; j < Wout; j++) {\n      let acc = b ? b[m] : 0;\n      for (let c = 0; c < Cg; c++) {\n        const ic = g * Cg + c;\n        for (let kh = 0; kh < KH; kh++) {\n          const ih = i * q.sh - q.pt + kh * q.dh;\n          if (ih < 0 || ih >= H) continue;\n          for (let kw = 0; kw < KW; kw++) {\n            const iw = j * q.sw - q.pl + kw * q.dw;\n            if (iw < 0 || iw >= W) continue;\n            acc += x[((n * C + ic) * H + ih) * W + iw] * w[((m * Cg + c) * KH + kh) * KW + kw];\n          }\n        }\n      }\n      y[((n * M + m) * Hout + i) * Wout + j] = acc;\n    }\n  }\n  return y;\n}\n\n// ---------- WGSL（T1）：一個 invocation 算一個輸出格；一維派發（扁平索引）----------\nconst WGSL_CONV1D = `\nstruct P { N: u32, C: u32, L: u32, M: u32, Cg: u32, K: u32, Lout: u32, stride: u32, pad0: u32, dil: u32, groups: u32, hasB: u32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read> w: array<f32>;\n@group(0) @binding(2) var<storage, read> b: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let total = p.N * p.M * p.Lout;\n  let idx = gid.x + gid.y * 4194240u;\n  if (idx >= total) { return; }\n  let t = idx % p.Lout;\n  let m = (idx / p.Lout) % p.M;\n  let n = idx / (p.Lout * p.M);\n  let Mg = p.M / p.groups;\n  let g = m / Mg;\n  var acc: f32 = 0.0;\n  if (p.hasB == 1u) { acc = b[m]; }\n  for (var c: u32 = 0u; c < p.Cg; c = c + 1u) {\n    let ic = g * p.Cg + c;\n    for (var k: u32 = 0u; k < p.K; k = k + 1u) {\n      let pos = i32(t * p.stride) - i32(p.pad0) + i32(k * p.dil);\n      if (pos >= 0 && u32(pos) < p.L) {\n        acc = acc + x[(n * p.C + ic) * p.L + u32(pos)] * w[(m * p.Cg + c) * p.K + k];\n      }\n    }\n  }\n  y[idx] = acc;\n}`;\n\n// 二維版（Basic Pitch 等）：同樣一個 invocation 一個輸出格；扁平索引（N×M×Hout×Wout）\nconst WGSL_CONV2D = `\nstruct P { N: u32, C: u32, H: u32, W: u32, M: u32, Cg: u32, KH: u32, KW: u32, Hout: u32, Wout: u32, sh: u32, sw: u32, pt: u32, pl: u32, dh: u32, dw: u32, groups: u32, hasB: u32, p0: u32, p1: u32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read> w: array<f32>;\n@group(0) @binding(2) var<storage, read> b: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let total = p.N * p.M * p.Hout * p.Wout;\n  let idx = gid.x + gid.y * 4194240u;\n  if (idx >= total) { return; }\n  let j = idx % p.Wout;\n  let i = (idx / p.Wout) % p.Hout;\n  let m = (idx / (p.Wout * p.Hout)) % p.M;\n  let n = idx / (p.Wout * p.Hout * p.M);\n  let g = m / (p.M / p.groups);\n  var acc: f32 = 0.0;\n  if (p.hasB == 1u) { acc = b[m]; }\n  for (var c: u32 = 0u; c < p.Cg; c = c + 1u) {\n    let ic = g * p.Cg + c;\n    for (var kh: u32 = 0u; kh < p.KH; kh = kh + 1u) {\n      let ih = i32(i * p.sh) - i32(p.pt) + i32(kh * p.dh);\n      if (ih < 0 || u32(ih) >= p.H) { continue; }\n      for (var kw: u32 = 0u; kw < p.KW; kw = kw + 1u) {\n        let iw = i32(j * p.sw) - i32(p.pl) + i32(kw * p.dw);\n        if (iw < 0 || u32(iw) >= p.W) { continue; }\n        acc = acc + x[((n * p.C + ic) * p.H + u32(ih)) * p.W + u32(iw)] * w[((m * p.Cg + c) * p.KH + kh) * p.KW + kw];\n      }\n    }\n  }\n  y[idx] = acc;\n}`;\n\nconst MAX_BUF = 134217728; // WebGPU 預設 maxStorageBufferBindingSize\nfunction checkFit() { for (const n of arguments) if (n * 4 > MAX_BUF) throw new Error('張量 ' + n + ' 個 float 超過單一儲存緩衝區上限（128 MB），退 CPU'); }\n\n// 純 JS 退路（cpu-js）與 T1 失敗時使用\nasync function conv1d(x, N, C, L, w, M, Cg, K, b, p, ops) {\n  const o = ops || {};\n  const q = norm1(p);\n  const Lout = Math.floor((L + q.pad0 + q.pad1 - q.dil * (K - 1) - 1) / q.stride) + 1;\n  if (o.gpu === false) return conv1dRef(x, N, C, L, w, M, Cg, K, b, p);\n  return nn.tryLayers('conv1d', { navigator: o.navigator }, async (dev) => {\n    const total = N * M * Lout;\n    checkFit(total, x.length, w.length);\n    const u = new Uint32Array([N, C, L, M, Cg, K, Lout, q.stride, q.pad0, q.dil, q.groups, b ? 1 : 0]);\n    const bArr = b ? Float32Array.from(b) : new Float32Array(1);\n    const outs = await nn.runWgsl(dev, WGSL_CONV1D,\n      [{ data: Float32Array.from(x) }, { data: Float32Array.from(w) }, { data: bArr }, { data: new Float32Array(total), out: true }],\n      new Uint8Array(u.buffer), Math.ceil(total / 64));\n    return outs[0];\n  }, null, () => conv1dRef(x, N, C, L, w, M, Cg, K, b, p)).then((r) => { o.lastInfo = r.info; return r.result; });\n}\n\n// 二維卷積：T1 WGSL → cpu-js（conv2dRef）；ops.gpu === false 強制 CPU；ops.lastInfo 回報層級。派發數上限 65535×64 個輸出格（一維派發），超過直接退 CPU 並寫明原因。\nasync function conv2d(x, N, C, H, W, w, M, Cg, KH, KW, b, p, ops) {\n  const o = ops || {};\n  const q = norm2(p);\n  const Hout = Math.floor((H + q.pt + q.pb - q.dh * (KH - 1) - 1) / q.sh) + 1, Wout = Math.floor((W + q.pl + q.pr - q.dw * (KW - 1) - 1) / q.sw) + 1;\n  if (o.gpu === false) return conv2dRef(x, N, C, H, W, w, M, Cg, KH, KW, b, p);\n  const total = N * M * Hout * Wout;\n  return nn.tryLayers('conv2d', { navigator: o.navigator }, async (dev) => {\n    checkFit(total, x.length, w.length);\n    // R5：groups = 1、單一批次時用 im2col＋平鋪矩陣乘（實測 1.9 → 0.37 ms，2.7–5.3 倍，兩者對參考相對誤差都 ≤1e-6）；ops.conv === 'direct' 強制舊的直接卷積\n    if (o.conv !== 'direct' && q.groups === 1 && N === 1 && IM2COL && MM_TILED_WGSL) {\n      const K = C * KH * KW, P = Hout * Wout;\n      const bt = nn.createBatch(dev);\n      const hx = bt.upload(Float32Array.from(x)), hw = bt.upload(Float32Array.from(w));\n      const hcol = bt.alloc(K * P), hy = bt.alloc(M * P);\n      const uI = new Uint32Array([C, H, W, KH, KW, Hout, Wout, q.sh, q.sw, q.pt, q.pl, q.dh, q.dw, K * P, 0, 0]);\n      const uM = new Int32Array([1, M, K, P, 0, 0, 0, 0]);\n      bt.dispatchRaw(IM2COL.WGSL_IM2COL, [hx.buf, hcol.buf], new Uint8Array(uI.buffer), [Math.ceil(K * P / 64), 1, 1]);\n      bt.dispatchRaw(MM_TILED_WGSL, [hw.buf, hcol.buf, hy.buf], new Uint8Array(uM.buffer), [Math.ceil(P / 64), Math.ceil(M / 64), 1]);\n      const got = (await bt.read([[hy, M * P]]))[0];\n      if (b) for (let m = 0; m < M; m++) for (let j = 0; j < P; j++) got[m * P + j] = Math.fround(got[m * P + j] + b[m]);\n      return got;\n    }\n    const u = new Uint32Array([N, C, H, W, M, Cg, KH, KW, Hout, Wout, q.sh, q.sw, q.pt, q.pl, q.dh, q.dw, q.groups, b ? 1 : 0, 0, 0]);\n    const outs = await nn.runWgsl(dev, WGSL_CONV2D,\n      [{ data: Float32Array.from(x) }, { data: Float32Array.from(w) }, { data: b ? Float32Array.from(b) : new Float32Array(1) }, { data: new Float32Array(total), out: true }],\n      new Uint8Array(u.buffer), Math.ceil(total / 64));\n    return outs[0];\n  }, null, () => conv2dRef(x, N, C, H, W, w, M, Cg, KH, KW, b, p)).then((r) => { o.lastInfo = r.info; return r.result; });\n}\n\n// ---------- 轉置卷積（ONNX ConvTranspose；Demucs 解碼器、Kokoro 聲碼器）----------\n// x [N,C,H,W]；w [C, M/groups, KH, KW]；p = { strides, pads:[上,左,下,右], dilations, groups, outputPadding:[h,w] }。一維請以 H=1、KH=1 傳入（pads 的上下為 0）。\n// 輸出 [N, M, Hout, Wout]，Hout = (H-1)·sh − pt − pb + dh·(KH−1) + oph + 1。\nfunction normT(p) {\n  const o = p || {}, pd = o.pads || [0, 0, 0, 0], op = o.outputPadding || [0, 0];\n  return { sh: (o.strides || [1, 1])[0], sw: (o.strides || [1, 1])[1], pt: pd[0], pl: pd[1], pb: pd[2], pr: pd[3], dh: (o.dilations || [1, 1])[0], dw: (o.dilations || [1, 1])[1], groups: o.groups || 1, oph: op[0], opw: op[1] };\n}\nfunction convT2dDims(H, W, KH, KW, p) {\n  const q = normT(p);\n  return { Hout: (H - 1) * q.sh - q.pt - q.pb + q.dh * (KH - 1) + q.oph + 1, Wout: (W - 1) * q.sw - q.pl - q.pr + q.dw * (KW - 1) + q.opw + 1 };\n}\nfunction convT2dRef(x, N, C, H, W, w, Mg_total, KH, KW, b, p) {\n  const q = normT(p), G = q.groups, M = Mg_total, Mg = M / G, Cg = C / G;\n  const { Hout, Wout } = convT2dDims(H, W, KH, KW, p);\n  const y = new Float64Array(N * M * Hout * Wout);\n  for (let n = 0; n < N; n++) for (let ic = 0; ic < C; ic++) {\n    const g = Math.floor(ic / Cg);\n    for (let mm = 0; mm < Mg; mm++) {\n      const m = g * Mg + mm;\n      for (let ih = 0; ih < H; ih++) for (let iw = 0; iw < W; iw++) {\n        const xv = x[((n * C + ic) * H + ih) * W + iw];\n        for (let kh = 0; kh < KH; kh++) {\n          const oh = ih * q.sh - q.pt + kh * q.dh; if (oh < 0 || oh >= Hout) continue;\n          for (let kw = 0; kw < KW; kw++) {\n            const ow = iw * q.sw - q.pl + kw * q.dw; if (ow < 0 || ow >= Wout) continue;\n            y[((n * M + m) * Hout + oh) * Wout + ow] += xv * w[((ic * Mg + mm) * KH + kh) * KW + kw];\n          }\n        }\n      }\n    }\n  }\n  const out = new Float32Array(y.length);\n  for (let n = 0; n < N; n++) for (let m = 0; m < M; m++) for (let i = 0; i < Hout * Wout; i++) { const k = (n * M + m) * Hout * Wout + i; out[k] = y[k] + (b ? b[m] : 0); }\n  return out;\n}\n// GPU 用「聚集」形式：一個 invocation 一個輸出格，枚舉 (kh,kw) 並檢查 (o+pad−k·dil) 能被步幅整除。\nconst WGSL_CONVT2D = `\nstruct P { N: u32, C: u32, H: u32, W: u32, M: u32, KH: u32, KW: u32, Hout: u32, Wout: u32, sh: u32, sw: u32, pt: u32, pl: u32, dh: u32, dw: u32, groups: u32, hasB: u32, p0: u32, p1: u32, p2: u32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read> w: array<f32>;\n@group(0) @binding(2) var<storage, read> b: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let total = p.N * p.M * p.Hout * p.Wout;\n  let idx = gid.x + gid.y * 4194240u;\n  if (idx >= total) { return; }\n  let ow = idx % p.Wout;\n  let oh = (idx / p.Wout) % p.Hout;\n  let m = (idx / (p.Wout * p.Hout)) % p.M;\n  let n = idx / (p.Wout * p.Hout * p.M);\n  let Mg = p.M / p.groups;\n  let Cg = p.C / p.groups;\n  let g = m / Mg;\n  let mm = m % Mg;\n  var acc: f32 = 0.0;\n  if (p.hasB == 1u) { acc = b[m]; }\n  for (var kh: u32 = 0u; kh < p.KH; kh = kh + 1u) {\n    let th = i32(oh) + i32(p.pt) - i32(kh * p.dh);\n    if (th < 0 || (u32(th) % p.sh) != 0u) { continue; }\n    let ih = u32(th) / p.sh;\n    if (ih >= p.H) { continue; }\n    for (var kw: u32 = 0u; kw < p.KW; kw = kw + 1u) {\n      let tw = i32(ow) + i32(p.pl) - i32(kw * p.dw);\n      if (tw < 0 || (u32(tw) % p.sw) != 0u) { continue; }\n      let iw = u32(tw) / p.sw;\n      if (iw >= p.W) { continue; }\n      for (var c: u32 = 0u; c < Cg; c = c + 1u) {\n        let ic = g * Cg + c;\n        acc = acc + x[((n * p.C + ic) * p.H + ih) * p.W + iw] * w[((ic * Mg + mm) * p.KH + kh) * p.KW + kw];\n      }\n    }\n  }\n  y[idx] = acc;\n}`;\nasync function convT2d(x, N, C, H, W, w, M, KH, KW, b, p, ops) {\n  const o = ops || {}, q = normT(p), { Hout, Wout } = convT2dDims(H, W, KH, KW, p);\n  if (o.gpu === false) return convT2dRef(x, N, C, H, W, w, M, KH, KW, b, p);\n  const total = N * M * Hout * Wout;\n  return nn.tryLayers('convT2d', { navigator: o.navigator }, async (dev) => {\n    checkFit(total, x.length, w.length);\n    const u = new Uint32Array([N, C, H, W, M, KH, KW, Hout, Wout, q.sh, q.sw, q.pt, q.pl, q.dh, q.dw, q.groups, b ? 1 : 0, 0, 0, 0]);\n    const outs = await nn.runWgsl(dev, WGSL_CONVT2D,\n      [{ data: Float32Array.from(x) }, { data: Float32Array.from(w) }, { data: b ? Float32Array.from(b) : new Float32Array(1) }, { data: new Float32Array(total), out: true }],\n      new Uint8Array(u.buffer), Math.ceil(total / 64));\n    return outs[0];\n  }, null, () => convT2dRef(x, N, C, H, W, w, M, KH, KW, b, p)).then((r) => { o.lastInfo = r.info; return r.result; });\n}\n\n// ---------- 整數一維卷積（ONNX ConvInteger；Kokoro q8 圖）----------\n// x uint8／int8 [N,C,L]、w uint8／int8 [M,Cg,K]、零點為純量 → int32 [N,M,Lout]；補零位置不貢獻（等於補上 x 的零點）。精確整數，GPU 結果必須與參考逐位相同。\nfunction convInt1dRef(x, N, C, L, w, M, Cg, K, xzp, wzp, p) {\n  const q = norm1(p), G = q.groups, Mg = M / G, Lout = Math.floor((L + q.pad0 + q.pad1 - q.dil * (K - 1) - 1) / q.stride) + 1;\n  const y = new Int32Array(N * M * Lout);\n  for (let n = 0; n < N; n++) for (let m = 0; m < M; m++) { const g = Math.floor(m / Mg);\n    for (let t = 0; t < Lout; t++) { let acc = 0;\n      for (let c = 0; c < Cg; c++) { const ic = g * Cg + c;\n        for (let k = 0; k < K; k++) { const pos = t * q.stride - q.pad0 + k * q.dil; if (pos < 0 || pos >= L) continue;\n          acc += (x[(n * C + ic) * L + pos] - xzp) * (w[(m * Cg + c) * K + k] - wzp); } }\n      y[(n * M + m) * Lout + t] = acc; } }\n  return y;\n}\nconst WGSL_CONVINT1D = `\nstruct P { N: u32, C: u32, L: u32, M: u32, Cg: u32, K: u32, Lout: u32, stride: u32, pad0: u32, dil: u32, groups: u32, xzp: i32, wzp: i32, p0: u32, p1: u32, p2: u32 }\n@group(0) @binding(0) var<storage, read> x: array<i32>;\n@group(0) @binding(1) var<storage, read> w: array<i32>;\n@group(0) @binding(2) var<storage, read_write> y: array<i32>;\n@group(0) @binding(3) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let idx = gid.x + gid.y * 4194240u;\n  if (idx >= p.N * p.M * p.Lout) { return; }\n  let t = idx % p.Lout;\n  let m = (idx / p.Lout) % p.M;\n  let n = idx / (p.Lout * p.M);\n  let g = m / (p.M / p.groups);\n  var acc: i32 = 0;\n  for (var c: u32 = 0u; c < p.Cg; c = c + 1u) {\n    let ic = g * p.Cg + c;\n    for (var k: u32 = 0u; k < p.K; k = k + 1u) {\n      let pos = i32(t * p.stride) - i32(p.pad0) + i32(k * p.dil);\n      if (pos >= 0 && u32(pos) < p.L) {\n        acc = acc + (x[(n * p.C + ic) * p.L + u32(pos)] - p.xzp) * (w[(m * p.Cg + c) * p.K + k] - p.wzp);\n      }\n    }\n  }\n  y[idx] = acc;\n}`;\nasync function convInt1d(x, N, C, L, w, M, Cg, K, xzp, wzp, p, ops) {\n  const o = ops || {}, q = norm1(p), Lout = Math.floor((L + q.pad0 + q.pad1 - q.dil * (K - 1) - 1) / q.stride) + 1, total = N * M * Lout;\n  if (o.gpu === false) return convInt1dRef(x, N, C, L, w, M, Cg, K, xzp, wzp, p);\n  return nn.tryLayers('convInt1d', { navigator: o.navigator }, async (dev) => {\n    checkFit(total, x.length, w.length);\n    const u = new Int32Array([N, C, L, M, Cg, K, Lout, q.stride, q.pad0, q.dil, q.groups, xzp, wzp, 0, 0, 0]);\n    const outs = await nn.runWgsl(dev, WGSL_CONVINT1D,\n      [{ data: Int32Array.from(x) }, { data: Int32Array.from(w) }, { data: new Int32Array(total), out: true }],\n      new Uint8Array(u.buffer), Math.ceil(total / 64));\n    return outs[0];\n  }, null, () => convInt1dRef(x, N, C, L, w, M, Cg, K, xzp, wzp, p)).then((r) => { o.lastInfo = r.info; return r.result; });\n}\n\nmodule.exports = { conv1dRef, conv2dRef, conv1d, conv2d, convT2dRef, convT2d, convT2dDims, convInt1dRef, convInt1d, WGSL_CONVINT1D, WGSL_CONV1D, WGSL_CONV2D, WGSL_CONVT2D, norm1, norm2, normT };\n\n};\nMODS[\"whisper_enc\"] = function (module, exports, require) {\n'use strict';\n// Whisper 編碼器（onnx-community/whisper-base 的 q8 動態量化版，encoder_model_quantized.onnx）的手寫參考實作。\n// 圖的結構（已逐節點確認）：DynamicQuantizeLinear → ConvInteger(k3,s1,p1) → +bias → GELU(erf) → DynamicQuantizeLinear → ConvInteger(k3,s2,p1) → +bias → GELU\n//   → 轉置 [1500,512] + embed_positions → 6 層（LN → q/k/v MatMulInteger（k 無 bias）→ q·0.125 → 8 頭全注意力（fp32 MatMul/Softmax）→ DQL → out_proj → 殘差\n//   → LN → DQL → fc1 → GELU → DQL → fc2 → 殘差）→ 最後 LN。LN：(x-mean)/sqrt(mean((x-mean)²)+1e-5)·w+b。\n// 整數運算：uint8 權重與（DQL 後 uint8）激活各自減零點後做整數乘加（與 ConvInteger／MatMulInteger 同），再 ×(sx·sw)＋bias。\n// ops（可選，GPU 版由 whisper_gpu.js 給）：conv(xs,C,L,ws,M,K,stride,pad,scale,bias)、mm(xs,T,K,ws,N,scale,bias)、attn(q,k,v,T)、ln(x,T,w,b)、gelu(x)；缺的用 CPU 參考。\nconst lite = require('./onnx_lite.js');\nconst CONV = require('./conv_ops.js');\nconst D = 512, NH = 8, HD = 64, T = 1500, NL = 6, EPS = 1e-5;\nconst f = Math.fround;\nconst f32 = (b) => { const o = new Float32Array(b.length / 4); new Uint8Array(o.buffer).set(b); return o; };\n\n// 讀圖：所有權重（uint8 權重轉成「減零點後」的 Float32，整數值精確）\nfunction loadEncoder(buf) {\n  const m = lite.parseModel(buf);\n  const byOut = {}; m.nodes.forEach((n) => n.outputs.forEach((o) => { byOut[o] = n; }));\n  const initF = (n) => f32(lite.tensorBytes(m, n));\n  const scalarF = (n) => lite.scalar(m, n);\n  const q = (wName, zpName) => {\n    const raw = lite.tensorBytes(m, wName), zp = lite.scalar(m, zpName), out = new Float32Array(raw.length);\n    for (let i = 0; i < raw.length; i++) out[i] = raw[i] - zp;\n    return out;\n  };\n  const lin = (nodeOut, biasName) => { // MatMulInteger 節點：inputs = [x_q, w_q, x_zp, w_zp]\n    const n = byOut[nodeOut]; if (!n || n.op !== 'MatMulInteger') throw new Error('找不到 MatMulInteger ' + nodeOut);\n    const w = n.inputs[1], dims = m.inits[w].dims;\n    return { K: dims[0], N: dims[1], W: q(w, n.inputs[3]), sw: scalarF(w.replace(/_quantized$/, '_scale')), bias: biasName ? initF(biasName) : null };\n  };\n  const conv = (nm) => ({ W: q(nm + '.weight_quantized', nm + '.weight_zero_point'), sw: scalarF(nm + '.weight_scale'), bias: initF(nm + '.bias'), dims: m.inits[nm + '.weight_quantized'].dims });\n  const layers = [];\n  for (let i = 0; i < NL; i++) {\n    const p = '/layers.' + i + '/', w = 'layers.' + i + '.';\n    layers.push({\n      ln1: { w: initF(w + 'self_attn_layer_norm.weight'), b: initF(w + 'self_attn_layer_norm.bias') },\n      ln2: { w: initF(w + 'final_layer_norm.weight'), b: initF(w + 'final_layer_norm.bias') },\n      q: lin(p + 'self_attn/q_proj/MatMul_output_0_output_quantized', w + 'self_attn.q_proj.bias'),\n      k: lin(p + 'self_attn/k_proj/MatMul_output_0_output_quantized', null),\n      v: lin(p + 'self_attn/v_proj/MatMul_output_0_output_quantized', w + 'self_attn.v_proj.bias'),\n      o: lin(p + 'self_attn/out_proj/MatMul_output_0_output_quantized', w + 'self_attn.out_proj.bias'),\n      fc1: lin(p + 'fc1/MatMul_output_0_output_quantized', w + 'fc1.bias'),\n      fc2: lin(p + 'fc2/MatMul_output_0_output_quantized', w + 'fc2.bias'),\n    });\n  }\n  return { conv1: conv('conv1'), conv2: conv('conv2'), pos: initF('embed_positions.weight'), layers, lnF: { w: initF('layer_norm.weight'), b: initF('layer_norm.bias') } };\n}\n\n// DynamicQuantizeLinear（ONNX 規格）：回傳 { xs: (q−zp)，Float32 整數值, scale }\nfunction dql(x) {\n  let mn = 0, mx = 0; for (let i = 0; i < x.length; i++) { if (x[i] < mn) mn = x[i]; if (x[i] > mx) mx = x[i]; }\n  const scale = f(f(mx - mn) / 255);\n  const rint = (v) => { const r = Math.round(v); return (Math.abs(v % 1) === 0.5 && r % 2 !== 0) ? r - 1 : r; };\n  const zp = scale === 0 ? 0 : Math.min(255, Math.max(0, rint(f(-mn / scale))));\n  const xs = new Float32Array(x.length);\n  if (scale === 0) return { xs, scale };\n  for (let i = 0; i < x.length; i++) xs[i] = Math.min(255, Math.max(0, rint(f(x[i] / scale)) + zp)) - zp;\n  return { xs, scale };\n}\n\n// --- CPU 參考運算 ---\nfunction mmRef(xs, Tn, K, ws, N, scale, bias) {\n  const y = new Float32Array(Tn * N), acc = new Float64Array(N);\n  for (let t = 0; t < Tn; t++) {\n    acc.fill(0);\n    for (let k = 0; k < K; k++) { const a = xs[t * K + k]; if (a === 0) continue; const wo = k * N; for (let n = 0; n < N; n++) acc[n] += a * ws[wo + n]; }\n    for (let n = 0; n < N; n++) y[t * N + n] = f(f(acc[n]) * scale) + (bias ? bias[n] : 0);\n  }\n  return y;\n}\nfunction lnRef(x, Tn, w, b) {\n  const y = new Float32Array(Tn * D);\n  for (let t = 0; t < Tn; t++) {\n    let mean = 0; for (let i = 0; i < D; i++) mean += x[t * D + i]; mean /= D;\n    let v = 0; for (let i = 0; i < D; i++) { const d = x[t * D + i] - mean; v += d * d; } v /= D;\n    const r = 1 / Math.sqrt(v + EPS);\n    for (let i = 0; i < D; i++) y[t * D + i] = (x[t * D + i] - mean) * r * w[i] + b[i];\n  }\n  return y;\n}\nfunction erf(x) { // 高精度 erf（Numerical Recipes erfc 的 Chebyshev 擬合，相對誤差 < 1.2e-7）\n  const z = Math.abs(x), t = 1 / (1 + 0.5 * z);\n  const r = t * Math.exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 + t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 + t * (-0.82215223 + t * 0.17087277)))))))));\n  return x >= 0 ? 1 - r : r - 1;\n}\nfunction geluRef(x) { const y = new Float32Array(x.length); for (let i = 0; i < x.length; i++) y[i] = x[i] * (erf(x[i] / Math.SQRT2) + 1) * 0.5; return y; }\nfunction attnRef(q, k, v, Tn) { // q 已乘 0.125；[T,512]，頭 h 為列 h·64..h·64+63；全注意力\n  const o = new Float32Array(Tn * D), sc = new Float64Array(Tn);\n  for (let h = 0; h < NH; h++) for (let i = 0; i < Tn; i++) {\n    let mx = -Infinity;\n    for (let j = 0; j < Tn; j++) { let d = 0; for (let e = 0; e < HD; e++) d += q[i * D + h * HD + e] * k[j * D + h * HD + e]; sc[j] = d; if (d > mx) mx = d; }\n    let s = 0; for (let j = 0; j < Tn; j++) { sc[j] = Math.exp(sc[j] - mx); s += sc[j]; }\n    for (let j = 0; j < Tn; j++) { const p = sc[j] / s; for (let e = 0; e < HD; e++) o[i * D + h * HD + e] += p * v[j * D + h * HD + e]; }\n  }\n  return o;\n}\n\n// 單一層：x [1500,512] → 下一層輸入（逐層教師強迫對拍用：每層餵 ORT 的上一層輸出，隔離動態量化的混沌放大）\nasync function runLayer(W, li, x, ops) {\n  const o = ops || {};\n  const mmF = o.mm || (async (...a) => mmRef(...a)), lnF = o.ln || (async (...a) => lnRef(...a)), geluF = o.gelu || (async (xx) => geluRef(xx)), attnF = o.attn || (async (...a) => attnRef(...a));\n  const lin = async (xx, P, Tn) => { const { xs, scale } = dql(xx); return mmF(xs, Tn, P.K, P.W, P.N, f(scale * P.sw), P.bias); };\n  const L = W.layers[li];\n  const h = await lnF(x, T, L.ln1.w, L.ln1.b);\n  const q = await lin(h, L.q, T), k = await lin(h, L.k, T), v = await lin(h, L.v, T);\n  for (let i = 0; i < q.length; i++) q[i] = f(q[i] * 0.125);\n  const a = await attnF(q, k, v, T);\n  const ao = await lin(a, L.o, T);\n  const x2 = new Float32Array(T * D); for (let i = 0; i < x2.length; i++) x2[i] = x[i] + ao[i];\n  const h2 = await lnF(x2, T, L.ln2.w, L.ln2.b);\n  const mid = await geluF(await lin(h2, L.fc1, T));\n  const dn = await lin(mid, L.fc2, T);\n  const out = new Float32Array(T * D); for (let i = 0; i < out.length; i++) out[i] = x2[i] + dn[i];\n  return out;\n}\n\n// x：input_features [80,3000]（列主序）→ last_hidden_state [1500,512]。progress(label, tensor) 可選（conv1、conv2、pos、layer0…5 各階段的中間張量，除錯對拍用）。\nasync function encode(W, feats, ops, progress) {\n  const o = ops || {}, say = progress || (() => {});\n  const convF = o.conv || (async (xs, C, L, ws, M, K, stride, pad, scale, bias) => {\n    const y = CONV.conv1dRef(xs, 1, C, L, ws, M, C, K, null, { stride, pads: [pad, pad] });\n    const Lo = y.length / M; for (let m = 0; m < M; m++) for (let l = 0; l < Lo; l++) y[m * Lo + l] = f(f(y[m * Lo + l]) * scale) + bias[m];\n    return y;\n  });\n  const mmF = o.mm || (async (...a) => mmRef(...a)), lnF = o.ln || (async (...a) => lnRef(...a)), geluF = o.gelu || (async (x) => geluRef(x)), attnF = o.attn || (async (...a) => attnRef(...a));\n  const lin = async (x, P, Tn) => { const { xs, scale } = dql(x); return mmF(xs, Tn, P.K, P.W, P.N, f(scale * P.sw), P.bias); };\n  // 卷積：卷積核心用 conv_ops（[C,L] 佈局），ConvInteger 的整數累加對 float32 精確度見 DESIGN\n  let d = dql(feats);\n  let y = await geluF(await convF(d.xs, 80, 3000, W.conv1.W, 512, 3, 1, 1, f(d.scale * W.conv1.sw), W.conv1.bias));\n  say('conv1', y);\n  d = dql(y);\n  y = await geluF(await convF(d.xs, 512, 3000, W.conv2.W, 512, 3, 2, 1, f(d.scale * W.conv2.sw), W.conv2.bias)); // [512,1500]\n  say('conv2', y);\n  let x = new Float32Array(T * D);\n  for (let c = 0; c < D; c++) for (let t = 0; t < T; t++) x[t * D + c] = y[c * T + t] + W.pos[t * D + c];\n  say('pos', x);\n  for (let li = 0; li < NL; li++) { x = await runLayer(W, li, x, o); say('layer' + li, x); }\n  return lnF(x, T, W.lnF.w, W.lnF.b);\n}\nmodule.exports = { loadEncoder, encode, runLayer, dql, mmRef, lnRef, geluRef, attnRef, erf, D, NH, HD, T, NL, EPS };\n\n};\nMODS[\"whisper_gpu\"] = function (module, exports, require) {\n'use strict';\n// Whisper 編碼器（whisper_enc.js）的 WebGPU 運算：一維卷積走共用 conv_ops.conv1d（T1），整數矩陣乘（MatMulInteger，i32 累加，精確）、全注意力（線上 softmax）、LayerNorm、GELU(erf) 為本檔 WGSL。\n// 介面：makeWhisperOps(opts) → { conv, mm, attn, ln, gelu, tiers }，傳給 whisper_enc.encode 的第三個參數。每個運算失敗／沒有 WebGPU 時由 nn.tryLayers 退 cpu-js（whisper_enc 的同一份參考），tiers 記層級與原因。\n// 資料皆經 nn.runWgsl（pipeline 以 WGSL 字串快取）；DynamicQuantizeLinear（O(n) 的最小／最大歸約）與殘差相加留在 CPU（whisper_enc.js）。\nconst nn = require('./nn_ops.js');\nconst CONV = require('./conv_ops.js');\nconst WE = require('./whisper_enc.js');\nconst f = Math.fround;\n\nconst WGSL_MM = `\nstruct P { T: u32, K: u32, N: u32, hasBias: u32, scale: f32, p0: u32, p1: u32, p2: u32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read> w: array<f32>;\n@group(0) @binding(2) var<storage, read> b: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let i = gid.x;\n  if (i >= p.T * p.N) { return; }\n  let t = i / p.N;\n  let n = i % p.N;\n  var acc: i32 = 0;\n  for (var k: u32 = 0u; k < p.K; k = k + 1u) { acc = acc + i32(x[t * p.K + k]) * i32(w[k * p.N + n]); }\n  var r = f32(acc) * p.scale;\n  if (p.hasBias != 0u) { r = r + b[n]; }\n  y[i] = r;\n}\n`;\nconst WGSL_ATTN = `\nstruct P { T: u32, p0: u32, p1: u32, p2: u32 }\n@group(0) @binding(0) var<storage, read> q: array<f32>;\n@group(0) @binding(1) var<storage, read> k: array<f32>;\n@group(0) @binding(2) var<storage, read> v: array<f32>;\n@group(0) @binding(3) var<storage, read_write> o: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let ih = gid.x;\n  if (ih >= p.T * 8u) { return; }\n  let i = ih / 8u;\n  let h = ih % 8u;\n  var acc: array<f32, 64>;\n  for (var e: u32 = 0u; e < 64u; e = e + 1u) { acc[e] = 0.0; }\n  var m: f32 = -3.0e38;\n  var l: f32 = 0.0;\n  let qo = i * 512u + h * 64u;\n  for (var j: u32 = 0u; j < p.T; j = j + 1u) {\n    let ko = j * 512u + h * 64u;\n    var d: f32 = 0.0;\n    for (var e: u32 = 0u; e < 64u; e = e + 1u) { d = d + q[qo + e] * k[ko + e]; }\n    let mn = max(m, d);\n    let c = exp(m - mn);\n    let pj = exp(d - mn);\n    l = l * c + pj;\n    for (var e: u32 = 0u; e < 64u; e = e + 1u) { acc[e] = acc[e] * c + pj * v[ko + e]; }\n    m = mn;\n  }\n  for (var e: u32 = 0u; e < 64u; e = e + 1u) { o[qo + e] = acc[e] / l; }\n}\n`;\nconst WGSL_LN = `\nstruct P { T: u32, p0: u32, p1: u32, p2: u32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read> w: array<f32>;\n@group(0) @binding(2) var<storage, read> b: array<f32>;\n@group(0) @binding(3) var<storage, read_write> y: array<f32>;\n@group(0) @binding(4) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let t = gid.x;\n  if (t >= p.T) { return; }\n  var mean: f32 = 0.0;\n  for (var i: u32 = 0u; i < 512u; i = i + 1u) { mean = mean + x[t * 512u + i]; }\n  mean = mean / 512.0;\n  var v: f32 = 0.0;\n  for (var i: u32 = 0u; i < 512u; i = i + 1u) { let d = x[t * 512u + i] - mean; v = v + d * d; }\n  v = v / 512.0;\n  let r = 1.0 / sqrt(v + 0.00001);\n  for (var i: u32 = 0u; i < 512u; i = i + 1u) { y[t * 512u + i] = (x[t * 512u + i] - mean) * r * w[i] + b[i]; }\n}\n`;\nconst WGSL_GELU = `\nstruct P { n: u32, p0: u32, p1: u32, p2: u32 }\n@group(0) @binding(0) var<storage, read> x: array<f32>;\n@group(0) @binding(1) var<storage, read_write> y: array<f32>;\n@group(0) @binding(2) var<uniform> p: P;\nfn erf_(a: f32) -> f32 {\n  let z = abs(a);\n  let t = 1.0 / (1.0 + 0.5 * z);\n  let r = t * exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 + t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 + t * (-0.82215223 + t * 0.17087277)))))))));\n  if (a >= 0.0) { return 1.0 - r; }\n  return r - 1.0;\n}\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let i = gid.x;\n  if (i >= p.n) { return; }\n  y[i] = x[i] * (erf_(x[i] * 0.70710678118) + 1.0) * 0.5;\n}\n`;\nconst U = (a) => { const b = new ArrayBuffer(Math.max(16, Math.ceil(a.length * 4 / 16) * 16)), v = new DataView(b); a.forEach((x, i) => { if (x && x.f !== undefined) v.setFloat32(i * 4, x.f, true); else v.setUint32(i * 4, x, true); }); return new Uint8Array(b); };\n\nfunction makeWhisperOps(opts) {\n  const o = opts || {}, tiers = {};\n  const wrap = (name, gpuFn, refFn) => async (...a) => {\n    const r = await nn.tryLayers(name, o, (dev) => gpuFn(dev, ...a), null, () => refFn(...a));\n    tiers[name] = r.info.layer + (r.info.reason ? '（' + r.info.reason + '）' : ''); return r.result;\n  };\n  const run = async (dev, code, ins, n, uni, groups) => (await nn.runWgsl(dev, code, ins.map((d) => ({ data: d })).concat([{ data: new Float32Array(n), out: true }]), U(uni), groups))[0];\n  const mm = wrap('whisper_mm', (dev, xs, T, K, ws, N, scale, bias) => run(dev, WGSL_MM, [xs, ws, bias || new Float32Array(1)], T * N, [T, K, N, bias ? 1 : 0, { f: scale }, 0, 0, 0], Math.ceil(T * N / 64)),\n    (xs, T, K, ws, N, scale, bias) => WE.mmRef(xs, T, K, ws, N, scale, bias));\n  const attn = wrap('whisper_attn', (dev, q, k, v, T) => run(dev, WGSL_ATTN, [q, k, v], T * 512, [T, 0, 0, 0], Math.ceil(T * 8 / 64)), (q, k, v, T) => WE.attnRef(q, k, v, T));\n  const ln = wrap('whisper_ln', (dev, x, T, w, b) => run(dev, WGSL_LN, [x, w, b], T * 512, [T, 0, 0, 0], Math.ceil(T / 64)), (x, T, w, b) => WE.lnRef(x, T, w, b));\n  const gelu = wrap('whisper_gelu', (dev, x) => run(dev, WGSL_GELU, [x], x.length, [x.length, 0, 0, 0], Math.ceil(x.length / 64)), (x) => WE.geluRef(x));\n  // 卷積：conv_ops.conv1d（T1 WGSL → cpu-js），整數值以 float32 累加（|累加| 通常遠小於 2^24；超過時的捨入誤差見 DESIGN），之後 ×scale＋bias\n  const conv = async (xs, C, L, ws, M, K, stride, pad, scale, bias) => {\n    const co = { navigator: o.navigator }, y = await CONV.conv1d(xs, 1, C, L, ws, M, C, K, null, { stride, pads: [pad, pad] }, co);\n    tiers['whisper_conv' + C] = co.lastInfo ? co.lastInfo.layer + (co.lastInfo.reason ? '（' + co.lastInfo.reason + '）' : '') : '?';\n    const Lo = y.length / M; for (let m = 0; m < M; m++) for (let l = 0; l < Lo; l++) y[m * Lo + l] = f(f(y[m * Lo + l]) * scale) + bias[m];\n    return y;\n  };\n  return { conv, mm, attn, ln, gelu, tiers };\n}\nmodule.exports = { makeWhisperOps };\n\n};\nMODS[\"whisper_attach\"] = function (module, exports, require) {\n// 把 Whisper 編碼器的 GPU 版接到 transformers.js 的編碼器 session（transcribe_media；DESIGN.webgpu-cuda.md §7.24）。純邏輯、依賴注入，node 可測。\n// attach({ sess, enc, WE, ops, say }) → { get gpu(), stat }：sess.run 被換成 GPU 版（解碼器、特徵擷取不動）；\n// 輸入不是 [1,80,3000]、任何運算沒跑在 T1、輸出形狀不對／含 NaN 或無限大、或丟錯，永久改回原 run（結果格式不變），原因寫進 stat.fellBack 並呼叫 say。\n(function (root, factory) { if (typeof module === 'object' && module.exports) module.exports = factory(); else root.FaWhisperAttach = factory(); })(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n  function attach(o) {\n    const sess = o.sess, say = o.say || (() => {}), origRun = sess.run.bind(sess);\n    let gpu = true; const stat = { runs: 0, ms: 0, tiers: null, fellBack: '' };\n    sess.run = async (feeds) => {\n      if (gpu) {\n        try {\n          const names = Object.keys(feeds), t = feeds.input_features;\n          if (!t || !t.dims || t.dims.length !== 3 || t.dims[0] !== 1 || t.dims[1] !== 80 || t.dims[2] !== 3000 || names.length !== 1) throw new Error('輸入不是預期的 [1,80,3000] input_features');\n          const t1 = Date.now();\n          const out = await o.WE.encode(o.enc, Float32Array.from(t.data), o.ops);\n          stat.runs++; stat.ms += Date.now() - t1; stat.tiers = Object.assign({}, o.ops.tiers);\n          const bad = Object.keys(o.ops.tiers).filter((k) => !/^T1/.test(o.ops.tiers[k]));\n          if (bad.length) throw new Error('運算沒有跑在 GPU：' + bad.map((k) => k + '＝' + o.ops.tiers[k]).join('、'));\n          if (out.length !== 1500 * 512) throw new Error('輸出長度 ' + out.length);\n          for (let i = 0; i < out.length; i += 97) if (!Number.isFinite(out[i])) throw new Error('輸出含 NaN／無限大');\n          return { last_hidden_state: new t.constructor('float32', out, [1, 1500, 512]) };   // 還給 transformers.js 的必須是它自己的 ort Tensor\n        } catch (e) { gpu = false; stat.fellBack = String((e && e.message) || e).slice(0, 200); say('Whisper 編碼器 GPU 失敗，已退回原編碼器：' + stat.fellBack); }\n      }\n      return origRun(feeds);\n    };\n    const h = { get gpu() { return gpu; }, stat }; sess.__faGpu = h; return h;\n  }\n  return { attach };\n});\n\n};\nMODS[\"mm_ops\"] = function (module, exports, require) {\n'use strict';\n// 通用矩陣乘（ONNX MatMul／MatMulInteger），給 Demucs、YAMNet、SDXS、Kokoro 等圖逐節點對拍用。\n//   matmulRef(a, aDims, b, bDims) → { y: Float32Array, dims }       （雙精度累加）\n//   matmul(a, aDims, b, bDims, ops) → Promise<{ y, dims }>          （T1 WGSL → cpu-js；ops.lastInfo 回報層級）\n//   matmulIntRef(a, aDims, b, bDims, azp, bzp) → { y: Int32Array, dims }   （精確整數）\n//   matmulInt(...ops)                                                 （T1 WGSL i32 → cpu-js；結果必須與參考逐位相同）\n// 批次維：a 的批次 = 前導維乘積；b 的批次必須是 1（共用，一般權重）或與 a 相同（注意力）。\nconst nn = require('./nn_ops.js');\nconst MM_TILE = require('./gpu_core.js');\nconst KS = require('./kernel_select.js');\n// 子群組核心（mm_subgroup.js）：載入失敗（例如嵌入的模組載入器沒有這個檔）就不提供，規則表不會選到它\nlet SG = null;\ntry { SG = require('./mm_subgroup.js'); } catch (_) { SG = null; }\n// split-K（mm_splitk.js，R3）：同樣是可選的載入；沒有就規則不會走到它（mm_ops 退回 simple）\nlet SK = null;\ntry { SK = require('./mm_splitk.js'); } catch (_) { SK = null; }\nconst MAX_BUF = 134217728;\n\n// ---------- 變體選擇（G4 接線）：規則＋已存的競賽勝者（kernel_select.pickWithCache）----------\n// WINNERS：key（KS.cacheKey）→ { id, median, timings }，由 variant_race 的勝者快取（kernel_select.createWinnerCache，localStorage）在啟動時整批載入（setMatmulWinners）。\n// 同步查表：派發路徑是同步查表（啟動時已把快取載入記憶體）；載入前就是規則結果。\nconst WINNERS = new Map();\nlet CAPS = null;                 // KS.probeCaps 的結果（瀏覽器端啟動時設定；沒設就用保守預設）\nlet ADAPTER = 'unknown';         // adapter 描述＋驅動／瀏覽器版本（快取鍵的一部分）\nfunction setMatmulCaps(caps, adapterDesc) { CAPS = caps || null; ADAPTER = adapterDesc || 'unknown'; }\nfunction setMatmulWinners(entries) { WINNERS.clear(); (entries || []).forEach((e) => { if (e && e.key && e.value) WINNERS.set(e.key, e.value); }); }\nconst WINNER_STORE = { get: (key) => (WINNERS.has(key) ? WINNERS.get(key) : null) };\n// pickMatmulKernel(M, K, N, o) → { id, source, reason }；o.kernel 強制指定（同 kernel_select 的 overrides）\nfunction pickMatmulKernel(M, K, N, o) {\n  const opts = o || {};\n  const overrides = opts.kernel ? { matmul: opts.kernel } : (opts.overrides || null);\n  return KS.pickWithCache('matmul', { M: M, K: K, N: N }, CAPS, overrides, WINNER_STORE, ADAPTER);\n}\n\n// 接到 runtime 矩陣乘（O14b）：只有真的有競賽勝者（pickWithCache 的 source 為 'tuned'）才回傳變體 id；否則 null，gpu_core 走規則預設。\nfunction runtimeWinnerFor(M, K, N) {\n  const r = KS.pickWithCache('matmul', { M: M, K: K, N: N }, CAPS, null, WINNER_STORE, ADAPTER);\n  return r && r.source === 'tuned' ? r.id : null;\n}\nMM_TILE.setMatmulWinnerSource(runtimeWinnerFor);\n\nfunction plan(aDims, bDims) {\n  const ra = aDims.length, rb = bDims.length;\n  if (ra < 2 || rb < 2) throw new Error('matmul：只支援 2 維以上');\n  const M = aDims[ra - 2], K = aDims[ra - 1], N = bDims[rb - 1];\n  if (bDims[rb - 2] !== K) throw new Error('matmul：K 不符');\n  const lead = aDims.slice(0, ra - 2), bl = bDims.slice(0, rb - 2);\n  const B = lead.reduce((p, v) => p * v, 1), Bb = bl.reduce((p, v) => p * v, 1);\n  if (Bb !== 1 && Bb !== B) throw new Error('matmul：不支援的批次廣播');\n  return { M, K, N, B, Bb, dims: lead.concat([M, N]) };\n}\nfunction matmulRef(a, aDims, b, bDims) {\n  const { M, K, N, B, Bb, dims } = plan(aDims, bDims), y = new Float32Array(B * M * N);\n  for (let n = 0; n < B; n++) { const ao = n * M * K, bo = (Bb === 1 ? 0 : n) * K * N;\n    for (let i = 0; i < M; i++) for (let j = 0; j < N; j++) { let acc = 0; for (let k = 0; k < K; k++) acc += a[ao + i * K + k] * b[bo + k * N + j]; y[(n * M + i) * N + j] = acc; } }\n  return { y, dims };\n}\nfunction matmulIntRef(a, aDims, b, bDims, azp, bzp) {\n  const { M, K, N, B, Bb, dims } = plan(aDims, bDims), y = new Int32Array(B * M * N);\n  for (let n = 0; n < B; n++) { const ao = n * M * K, bo = (Bb === 1 ? 0 : n) * K * N;\n    for (let i = 0; i < M; i++) for (let j = 0; j < N; j++) { let acc = 0; for (let k = 0; k < K; k++) acc += (a[ao + i * K + k] - (azp || 0)) * (b[bo + k * N + j] - (bzp || 0)); y[(n * M + i) * N + j] = acc; } }\n  return { y, dims };\n}\nconst HEAD = (t) => `\nstruct P { B: u32, M: u32, K: u32, N: u32, Bb: u32, azp: i32, bzp: i32, p0: u32 }\n@group(0) @binding(0) var<storage, read> a: array<${t}>;\n@group(0) @binding(1) var<storage, read> b: array<${t}>;\n@group(0) @binding(2) var<storage, read_write> y: array<${t}>;\n@group(0) @binding(3) var<uniform> p: P;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let idx = gid.x + gid.y * 4194240u;\n  if (idx >= p.B * p.M * p.N) { return; }\n  let j = idx % p.N;\n  let i = (idx / p.N) % p.M;\n  let n = idx / (p.N * p.M);\n  let ao = (n * p.M + i) * p.K;\n  var bo = 0u;\n  if (p.Bb != 1u) { bo = n * p.K * p.N; }\n`;\nconst WGSL_MM_F32 = HEAD('f32') + `\n  var acc: f32 = 0.0;\n  for (var k: u32 = 0u; k < p.K; k = k + 1u) { acc = acc + a[ao + k] * b[bo + k * p.N + j]; }\n  y[idx] = acc;\n}`;\n// 平鋪版（f32）：一個工作群組 16×16 個執行緒算 64×64 的輸出，每個執行緒在暫存器裡累加 4×4；A、B 各分 16 層一塊塊搬進共用記憶體再算。\n// 原本的版本一個執行緒算一格、每格迴圈 K 次、每次都讀全域記憶體（沒有任何重用），在 14 W 的舊顯示卡上比 ORT 慢一個數量級。\n// 共用記憶體 2×64×16×4 B = 8 KiB（規格預設上限 16 KiB 以內）。批次在 z 方向；邊界逐元素檢查，任意形狀都對。\n// 平鋪版改用共用的核心（renderer/src/gpu/mm_tile.js，與 gpu_core.js 的 WGSL.matmul 同一份；轉置旗標在 p0，這裡不用）。\nconst WGSL_MM_F32_TILED = MM_TILE.mmTileWgsl({ marker: 'matmul_tiled', dtype: 'f32' });\n// vec4 版：同一幾何、同一組綁定（位元組相同），只讀取改成 vec4；呼叫端要保證 K%4==0、N%4==0（KS 的 applies）。\nconst WGSL_MM_F32_VEC4 = MM_TILE.mmTileWgslVec4({ marker: 'matmul_vec4_mm' });\nconst WGSL_MM_I32 = HEAD('i32') + `\n  var acc: i32 = 0;\n  for (var k: u32 = 0u; k < p.K; k = k + 1u) { acc = acc + (a[ao + k] - p.azp) * (b[bo + k * p.N + j] - p.bzp); }\n  y[idx] = acc;\n}`;\n\nasync function run(kind, a, aDims, b, bDims, azp, bzp, ops) {\n  const o = ops || {}, pl = plan(aDims, bDims), total = pl.B * pl.M * pl.N, isInt = kind === 'int';\n  // 轉置旗標（transA：a 以 K×M 儲存；transB：b 以 N×K 儲存）：送進同一份平鋪核心的 p0；只支援單一批次\n  const fl = isInt ? 0 : MM_TILE.mmTileFlags(o);\n  if (fl && pl.B !== 1) throw new Error('mm_ops：轉置版目前只支援單一批次（收到 B=' + pl.B + '）');\n  const ref = () => (isInt ? matmulIntRef(a, aDims, b, bDims, azp, bzp) : (fl ? { y: MM_TILE.matmulTRef(a, b, pl.M, pl.K, pl.N, fl) } : matmulRef(a, aDims, b, bDims))).y;\n  if (o.gpu === false) return { y: ref(), dims: pl.dims };\n  // 純 CPU 池（沒有 WebGPU、裝置遺失、GPU 各層都失敗時的退路）：f32、單一批次、不轉置 A 才走 cpu_share.runCpuOnly；\n  // 其餘（整數、轉置 A、多批次）與無法取得池時，仍用同步的參考實作。cores=0（預設）時 runCpuOnly 在主執行緒算，結果相同。\n  const cpuPoolRef = async () => {\n    if (isInt || o.transA || pl.B !== 1 || !CPU_SHARE) return ref();\n    const sh = CPU_SHARE.getShared();\n    const af = a instanceof Float32Array ? a : Float32Array.from(a), bf = b instanceof Float32Array ? b : Float32Array.from(b);\n    const rr = await sh.runCpuOnly(af, bf, pl.M, pl.K, pl.N, { transB: !!o.transB, bKey: o.cacheB ? b : null });\n    return rr.y;\n  };\n  // 轉置時只有平鋪版讀 p0（簡單版與 vec4 版不讀），所以強制用平鋪版\n  // 轉置版（訓練）：M=1、K≥1024、單一批次時改走 split-K（支援 transA／transB 旗標；同機 intel xe-lpg 快 22–60%），其餘仍用平鋪\n  const flSplitK = !!fl && !!SK && pl.B === 1 && pl.M === 1 && pl.K >= 1024 && !isInt;\n  const kernelId = isInt ? 'mm_simple_f32' : (fl ? (flSplitK ? 'mm_splitk_f32' : 'mm_tiled_f32') : pickMatmulKernel(pl.M, pl.K, pl.N, o).id);\n  const r = await nn.tryLayers(isInt ? 'matmulInt' : 'matmul', { navigator: o.navigator }, async (dev) => {\n    // 啟動接線：第一次拿到 GPU 裝置時，背景載入勝者；缺勝者的形狀再背景競賽（本次派發仍用規則，下次才換）\n    if (!TUNE.started) {\n      TUNE.started = true;\n      initMatmulTuning({ device: dev, shapes: AUTO_SHAPES }).then((info) => {\n        if (info.missing.length && o.navigator) startMatmulRace(info.missing, { navigator: o.navigator, budgetMs: 2000, background: true }).catch(() => {});\n      }).catch(() => {});\n    }\n    for (const n of [total, a.length, b.length]) if (n * 4 > MAX_BUF) throw new Error('張量 ' + n + ' 個元素超過單一儲存緩衝區上限（128 MB），退 CPU');\n    const u = new Int32Array([pl.B, pl.M, pl.K, pl.N, pl.Bb, azp || 0, bzp || 0, fl]);\n    // 已經是對的型別就不再複製一份（大矩陣的複製本身就是可觀的時間）；o.cacheB：B 是常駐權重時，同一個陣列物件只上傳一次\n    const mk = (src) => (isInt ? (src instanceof Int32Array ? src : Int32Array.from(src)) : (src instanceof Float32Array ? src : Float32Array.from(src)));\n    // 變體：f32 才有平鋪／vec4 可選（kernel_select 的 applies 會排除太窄的形狀）；整數與太窄的維持簡單版\n    // 子群組版（mm_subgroup.js）：只在單一批次、不轉置、有載入模組時用；否則退回簡單版\n    const kid0 = isInt ? 'mm_simple_f32' : kernelId;\n    const sub = kid0 === 'mm_subgroup_f32' && !!SG && pl.B === 1 && !fl;\n    // split-K（R3）：單一批次、不轉置、有載入模組、形狀在規則的適用範圍內；兩段核心（部分和＋歸約）在同一個批次、一次 submit 送出\n    const sk = kid0 === 'mm_splitk_f32' && !!SK && pl.B === 1 && !isInt && (fl ? pl.M === 1 : SK.splitkApplies(pl.M, pl.K, pl.N));\n    const kid = sk ? 'mm_splitk_f32' : (sub ? 'mm_subgroup_f32' : ((kid0 === 'mm_subgroup_f32' || kid0 === 'mm_splitk_f32') ? 'mm_simple_f32' : kid0));\n    const tiled = kid !== 'mm_simple_f32' && kid !== 'mm_subgroup_f32' && kid !== 'mm_splitk_f32';\n    o.lastKernel = kid;\n    if (sk) {\n      const S = SK.pickSplits(pl.K);\n      const bt = nn.createBatch(dev);\n      const hA = bt.upload(mk(a)), hB = bt.upload(mk(b));\n      const hP = bt.alloc(S * pl.M * pl.N), hY = bt.alloc(pl.M * pl.N);\n      const uni = new Uint32Array([pl.M, pl.K, pl.N, S, fl, 0, 0, 0]);\n      bt.dispatchRaw(SK.WGSL_SPLITK_PARTIAL, [hA.buf, hB.buf, hP.buf], uni, SK.dispatchPartial(pl.M, pl.N, S));\n      bt.dispatchRaw(SK.WGSL_SPLITK_REDUCE, [hP.buf, hY.buf], uni, SK.dispatchReduce(pl.M, pl.N));\n      const got = await bt.read([[hY, pl.M * pl.N]]);\n      return got[0];\n    }\n    const code = isInt ? WGSL_MM_I32 : (sub ? SG.WGSL_MM_SUBGROUP : (kid === 'mm_vec4_f32' ? WGSL_MM_F32_VEC4 : (tiled ? WGSL_MM_F32_TILED : WGSL_MM_F32)));\n    const groups = sub ? SG.dispatchFor(pl.M, pl.N, 4096) : (tiled ? [Math.ceil(pl.N / 64), Math.ceil(pl.M / 64), pl.B] : Math.ceil(total / 64));\n    const outs = await nn.runWgsl(dev, code,\n      [{ data: mk(a) }, { data: mk(b), cache: !!o.cacheB }, { data: isInt ? new Int32Array(total) : new Float32Array(total), out: true }],\n      new Uint8Array(u.buffer), groups);\n    return outs[0];\n  }, null, cpuPoolRef);\n  o.lastInfo = r.info;\n  return { y: r.result, dims: pl.dims };\n}\n// 異質運算（plus）：CPU 核心數為 0（預設）時 CPU_SHARE.run 立刻回 shared:false，完全走原本的 GPU 路徑，行為與沒有這段時相同。\n// 只在單一批次、不轉置 A、f32、Float32Array 輸入時分工；任何一邊出錯也退回原路徑（整個運算重算一次，結果仍正確）。\nlet CPU_SHARE = null, CPU_SHARE_LOAD_ERROR = null;\ntry { CPU_SHARE = require('./cpu_share.js'); } catch (e) { CPU_SHARE = null; CPU_SHARE_LOAD_ERROR = String((e && e.message) || e); }\n// 整個運算卸載給 CPU（小形狀）：卸載交界點來自 Profile 的實測（faProfilePlan 的 crossoverFlops，存在 localStorage fa_gpu_profile）。\n// 沒有實測值（null）就不卸載，維持原本的 GPU 路徑；不寫死任何門檻。\nlet OFFLOAD = null, OFFLOAD_LOAD_ERROR = null;\ntry { OFFLOAD = require('./cpu_gemm_offload.js'); } catch (e) { OFFLOAD = null; OFFLOAD_LOAD_ERROR = String((e && e.message) || e); }   // 載入失敗要看得到（getOffloadStatus），不能靜默\nfunction getOffloadStatus() { return { loaded: !!OFFLOAD, error: OFFLOAD_LOAD_ERROR, crossover: crossoverNow(), cpuShareLoaded: !!CPU_SHARE, cpuShareError: CPU_SHARE_LOAD_ERROR }; }\nlet OFFLOAD_CROSSOVER = undefined;   // undefined＝還沒讀；null＝沒有實測；數字＝實測交界點（flops）\nfunction setOffloadCrossover(v) { OFFLOAD_CROSSOVER = (v === null || v === undefined || !Number.isFinite(Number(v))) ? (v === Infinity ? Infinity : null) : Number(v); }\nfunction crossoverNow() {\n  if (OFFLOAD_CROSSOVER !== undefined) return OFFLOAD_CROSSOVER;\n  try {\n    if (typeof localStorage !== 'undefined') {\n      const rec = JSON.parse(localStorage.getItem('fa_gpu_profile') || 'null');\n      const x = rec && rec.crossoverFlops;\n      OFFLOAD_CROSSOVER = rec && rec.crossoverAllCpu ? Infinity : (x === null || x === undefined ? null : Number(x));\n      return OFFLOAD_CROSSOVER;\n    }\n  } catch (_) { /* 讀不到就當沒有實測 */ }\n  OFFLOAD_CROSSOVER = null;\n  return null;\n}\nconst matmul = async (a, aD, b, bD, ops) => {\n  const o = ops || {};\n  if (OFFLOAD && CPU_SHARE && o.gpu !== false && !o.transA && a instanceof Float32Array && b instanceof Float32Array) {\n    const p0 = plan(aD, bD);\n    if (p0.B === 1 && p0.Bb === 1) {\n      const dec = OFFLOAD.offloadDecision({ m: p0.M, k: p0.K, n: p0.N, gpuReady: true, crossoverFlops: crossoverNow() });\n      if (dec.route === 'cpu') {\n        const rr = await CPU_SHARE.getShared().runCpuOnly(a, b, p0.M, p0.K, p0.N, { transB: !!o.transB, bKey: o.cacheB ? b : null });\n        o.lastInfo = { layer: 'cpu-simd', reason: dec.reason, share: rr.info };\n        o.lastKernel = 'offload-cpu';\n        return { y: rr.y, dims: p0.dims };\n      }\n    }\n  }\n  const sh = CPU_SHARE && !o._noShare && o.gpu !== false && !o.transA ? CPU_SHARE.getShared() : null;\n  if (sh && sh.cores() > 0 && a instanceof Float32Array && b instanceof Float32Array) {\n    const pl = plan(aD, bD);\n    if (pl.B === 1 && pl.Bb === 1) {\n      let gpuInfo = null;\n      const r = await sh.run(async (aRows, mG) => {\n        const io = Object.assign({}, o, { _noShare: true });\n        const g = await run('f32', aRows, [mG, pl.K], b, bD, 0, 0, io);\n        gpuInfo = io.lastInfo; return g.y;\n      }, a, b, pl.M, pl.K, pl.N, { transB: !!o.transB, bKey: o.cacheB ? b : null, cpuSegment: o.cpuSegment });\n      if (r.shared) { o.lastInfo = { layer: ((gpuInfo && gpuInfo.layer) || 'T1') + '+cpu', reason: null, share: r.info }; o.lastKernel = 'hetero'; return { y: r.y, dims: pl.dims }; }\n    }\n  }\n  return run('f32', a, aD, b, bD, 0, 0, ops);\n};\nconst matmulInt = (a, aD, b, bD, azp, bzp, ops) => run('int', a, aD, b, bD, azp, bzp, ops);\n\n// ---------- 競賽（G4）：對一個形狀，所有適用的 f32 變體先驗證（對 CPU 參考）再計時 ----------\n// opts：{ navigator, store（variant_race.createStore，勝者寫入）, budgetMs, runs, K, cancel, now }\n// 沒有真 GPU（退 cpu-js）就不競賽、回傳 { noGpu: true }，免得拿 CPU 的時間當結果。\n// 計時包含上傳與回讀（與派發路徑的實際成本一致），同一組輸入、先暖機一次。\n// 單次派發超過這個預估時間（毫秒）的候選，在該形狀不參賽。這台 GT 720 的數字：64×1024×1024 的 simple 約 65 ms（會跑），\n// 512×1024×1024 的 tiled 約 215 ms（不跑，維持現行保護）。更強的機器算出來的時間短，會跑全部形狀。\nconst SAFE_DISPATCH_MS = 150;\n// 相對 simple 的速度（本機實測：tiled 4.99 ÷ simple 2.06 GFLOP/s ≈ 2.42）；沒量過的候選一律當 1（最保守）。\nconst REL_SPEED = { mm_simple_f32: 1, mm_tiled_f32: 2.42 };\nconst flopsOf = (sh) => 2 * sh.M * sh.K * sh.N;\n// GFLOP/s = flops ÷ (ms × 1e6)；所以 ms = flops ÷ (GFLOP/s × 1e6)\nfunction estimateMs(sh, id, gSimple) { return flopsOf(sh) / (gSimple * (REL_SPEED[id] || 1) * 1e6); }\n// 逐候選判斷：預估單次派發超過 safeMs 的不參賽。回傳 { run: [id], skipped: [{ id, estMs, reason }] }\nfunction gateCandidates(sh, ids, gSimple, safeMs) {\n  const run = [], skipped = [];\n  for (const id of ids) {\n    const est = estimateMs(sh, id, gSimple);\n    if (est > safeMs) skipped.push({ id: id, estMs: est, reason: '略過：預估逾時（約 ' + Math.round(est) + ' ms，上限 ' + safeMs + ' ms）' });\n    else run.push(id);\n  }\n  return { run: run, skipped: skipped };\n}\n// 單次派發的 GPU 失敗：run() 會退回 CPU（layer cpu-js）。競賽要把它當失敗，不能拿 CPU 的結果當成該變體通過。\nfunction dispatchOk(info) {\n  if (/cpu-js/.test((info || {}).layer || '')) throw new Error('GPU 派發失敗，退回 CPU：' + String((info || {}).reason || '原因不明').slice(0, 200));\n}\nfunction isLostText(t) { return /lost|遺失/i.test(String(t || '')); }\n\n// ---------- 核心時間、編譯時間、屋頂（R0）：不含上傳與回讀；一次提交多次派發，等 GPU 完成才停表 ----------\nconst BUF = { STORAGE: 0x80, UNIFORM: 0x40, COPY_DST: 0x8, COPY_SRC: 0x4 };\nconst CORE_SAMPLE_MS = 100;      // 每個樣本的目標時間：夠多次派發，讓提交延遲不主導計時\nconst CORE_MAX_BATCH = 64;\nfunction nowMsCore() { return (typeof performance !== 'undefined' ? performance : Date).now(); }\n// 一個樣本要派發幾次：單次約 estMs，一批目標 budgetMs；至少 1、至多 CORE_MAX_BATCH\n// 把 n 次派發拆成多個提交：每個提交依校準時間估的總時間不超過 limitMs（估計超過就拆）。回傳每個提交的派發數。\nconst CORE_SPLIT_MS = 100, ROOF_SPLIT_MS = 100;\nfunction splitRuns(n, estMs, limitMs) {\n  const per = Math.max(estMs, 1e-6), cap = Math.max(1, Math.floor(limitMs / per));\n  const out = []; let left = Math.max(0, Math.floor(n));\n  while (left > 0) { const c = Math.min(cap, left); out.push(c); left -= c; }\n  return out;\n}\nfunction pickBatch(estMs, budgetMs) { return Math.max(1, Math.min(CORE_MAX_BATCH, Math.floor(budgetMs / Math.max(estMs, 0.01)))); }\n// 編譯時間 ＝ 第一次（含編譯與第一次派發）的總時間 － 穩定時間的中位數；不小於 0；沒有樣本就 null\nfunction compileFromSamples(firstTotalMs, samples) {\n  const xs = (samples || []).filter((x) => isFinite(x) && x >= 0).slice().sort((p, q) => p - q);\n  if (!xs.length || !isFinite(firstTotalMs)) return null;\n  return Math.max(0, Math.round((firstTotalMs - xs[xs.length >> 1]) * 100) / 100);\n}\n// 用兩個迭代數的單次時間線性估出固定開銷 a 與每次迭代 b，再挑單次派發約 targetMs 的迭代數（限 64 ～ 65536）\nfunction pickRooflineIters(t1, iters1, t2, iters2, targetMs) {\n  const b = (t2 - t1) / (iters2 - iters1);\n  if (!(b > 0)) return Math.max(64, Math.min(1 << 16, iters2));\n  const a = t1 - b * iters1;\n  return Math.max(64, Math.min(1 << 16, Math.floor((targetMs - a) / b)));\n}\n// GFLOP/s ＝ flops ÷ (ms × 1e6)\nfunction gflopsFrom(flops, ms) { return ms > 0 ? flops / (ms * 1e6) : null; }\n// 峰值：從快取找這張卡（同 adapter、同能力簽名）的實測屋頂；沒有就 null，呼叫端改用內建表或顯示原因\nfunction peakFromEntries(entries, sig, adapterDesc) {\n  const hit = (entries || []).find((e) => { const p = String(e.key).split('|'); return p[0] === 'ROOF' && p[2] === sig && (!adapterDesc || p[1] === adapterDesc) && e.value && e.value.gflops > 0; });\n  return hit ? { gflops: hit.value.gflops, basis: '本機實測（純 FMA 核心，' + hit.value.iters + ' 次迭代、' + hit.value.batch + ' 次一批）', measured: true } : null;\n}\nfunction gpuBuf(dev, src, bytes) {\n  const b = dev.createBuffer({ size: Math.max(4, bytes), usage: BUF.STORAGE | BUF.COPY_DST | BUF.COPY_SRC });\n  if (src) dev.queue.writeBuffer(b, 0, src);\n  return b;\n}\n// 核心工作：編譯（含第一次派發）只做一次；reps(n) 把 n 次派發塞進同一次提交，等 GPU 完成才返回\nasync function coreJob(dev, code, bufs, uniform, groups) {\n  const t0 = nowMsCore();\n  const pipe = dev.createComputePipeline({ layout: 'auto', compute: { module: dev.createShaderModule({ code: code }), entryPoint: 'main' } });\n  const ub = dev.createBuffer({ size: 32, usage: BUF.UNIFORM | BUF.COPY_DST });\n  dev.queue.writeBuffer(ub, 0, uniform);\n  const ents = bufs.map((b, i) => ({ binding: i, resource: { buffer: b } }));\n  ents.push({ binding: bufs.length, resource: { buffer: ub } });\n  const bg = dev.createBindGroup({ layout: pipe.getBindGroupLayout(0), entries: ents });\n  const reps = async (n) => {\n    const enc = dev.createCommandEncoder();\n    for (let r = 0; r < n; r++) { const pass = enc.beginComputePass(); pass.setPipeline(pipe); pass.setBindGroup(0, bg); pass.dispatchWorkgroups(groups[0], groups[1] || 1, groups[2] || 1); pass.end(); }\n    dev.queue.submit([enc.finish()]);\n    await dev.queue.onSubmittedWorkDone();\n  };\n  await reps(1);\n  return { reps: reps, compileTotal: nowMsCore() - t0, destroy: () => ub.destroy() };\n}\n// 屋頂（R0）用的純 FMA 核心：每執行緒 4 條獨立的 fma 依賴鏈，迭代數由 P.x 決定\nconst ROOF_WGSL = `\n@group(0) @binding(0) var<storage, read_write> OUT: array<f32>;\n@group(0) @binding(1) var<uniform> P: vec4<u32>;\n@compute @workgroup_size(256)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  // 16 條獨立的依賴鏈（4 個 vec4）：單條鏈受延遲限制，鏈不夠多時量到的不是峰值\n  let s: f32 = f32(gid.x & 1023u) * 0.000001 + 0.5;\n  var x0: vec4<f32> = vec4<f32>(s, s + 0.25, s + 0.125, s + 0.0625);\n  var x1: vec4<f32> = x0 + vec4<f32>(0.03125);\n  var x2: vec4<f32> = x0 + vec4<f32>(0.015625);\n  var x3: vec4<f32> = x0 + vec4<f32>(0.0078125);\n  let m: vec4<f32> = vec4<f32>(0.9999);\n  let c: vec4<f32> = vec4<f32>(0.0001);\n  for (var i: u32 = 0u; i < P.x; i = i + 1u) {\n    x0 = fma(x0, m, c); x1 = fma(x1, m, c); x2 = fma(x2, m, c); x3 = fma(x3, m, c);\n  }\n  let t: vec4<f32> = x0 + x1 + x2 + x3;\n  if (t.x + t.y + t.z + t.w == -1.0) { OUT[gid.x] = t.x; }\n}`;\n// 屋頂（R0）：安全校準（管理者指示，2026-11-18）。大迭代數的量測已移除（第二次實測單次 786 ms，會逼近 GPU 逾時）。\n// 流程：1) 暖機（編譯）；2) 兩個極小派發（8、32 次迭代）計時，線性外推出「單次約 ROOF_TARGET_MS」的迭代數，硬上限 ROOF_MAX_ITERS；\n// 3) 用外推的迭代數派發一次確認；4) 每次提交的總時間約 ROOF_TARGET_MS，取 ROOF_SAMPLES 個樣本的中位數。\n// 任何一次派發或提交超過 ROOF_ABORT_MS 就中止，標「屋頂量測不可信」，之後不再派發更大的（絕不放大重試）。整體也有時間上限。\n// rooflineCalibrate 是純函式：派發由呼叫端注入（真裝置或測試用的假裝置），所以外推、上限、中止都能用 node 測。\nconst ROOF_TARGET_MS = 30, ROOF_ABORT_MS = 150, ROOF_MAX_ITERS = 4096, ROOF_MAX_TOTAL_MS = 1500, ROOF_SAMPLES = 3;\nconst ROOF_CAL_LO = 8, ROOF_CAL_HI = 32;\n// dispatch(iters, n)：提交 n 次派發（每次 iters 次迭代），回傳這次提交的耗時（毫秒，Promise）。now()：取時間（測試可注入）。\nasync function rooflineCalibrate(opts) {\n  const dispatch = opts.dispatch, now = opts.now || nowMsCore;\n  const VR = require('./variant_race.js');\n  const t0 = now();\n  const untrusted = (why) => ({ ok: false, untrusted: true, reason: '屋頂量測不可信：' + why + '（已中止，不再放大迭代數）' });\n  await dispatch(ROOF_CAL_LO, 1);                           // 暖機（編譯），不計時\n  const tA = await dispatch(ROOF_CAL_LO, 1);\n  if (!(tA <= ROOF_ABORT_MS)) return untrusted('極小派發 ' + tA + ' ms');\n  const tB = await dispatch(ROOF_CAL_HI, 1);\n  if (!(tB <= ROOF_ABORT_MS)) return untrusted('32 次迭代的派發 ' + tB + ' ms');\n  const b = Math.max((tB - tA) / (ROOF_CAL_HI - ROOF_CAL_LO), 1e-6);   // 每次迭代的時間\n  const a = Math.max(tA - ROOF_CAL_LO * b, 0);                         // 固定開銷\n  const iters = Math.max(1, Math.min(ROOF_MAX_ITERS, Math.floor((ROOF_TARGET_MS - a) / b)));\n  const predicted = a + b * iters;\n  const tS = await dispatch(iters, 1);                                 // 確認：外推的迭代數只派發一次\n  if (!(tS <= ROOF_ABORT_MS)) return untrusted('外推的 ' + iters + ' 次迭代派發 ' + tS + ' ms，預估 ' + predicted.toFixed(1) + ' ms');\n  const single = Math.max(tS, 0.01);\n  const batch = Math.max(1, Math.min(64, Math.floor(ROOF_TARGET_MS / single)));\n  const per = [];\n  const chunks = splitRuns(batch, single, ROOF_SPLIT_MS);   // 估計總時間 >100 ms 就拆成多個提交（每個提交都檢查中止條件）\n  for (let s = 0; s < ROOF_SAMPLES; s++) {\n    if (now() - t0 > ROOF_MAX_TOTAL_MS) break;\n    let tot = 0;\n    for (const c of chunks) {\n      const tt = await dispatch(iters, c);\n      if (!(tt <= ROOF_ABORT_MS)) return untrusted('一次提交 ' + c + ' 次派發共 ' + tt + ' ms');\n      tot += tt;\n    }\n    per.push(tot / batch);\n  }\n  if (!per.length) return { ok: false, reason: '時間上限內沒有完成任何樣本' };\n  return { ok: true, iters: iters, batch: batch, perDispatchMs: VR.medianOf(per), predicted: predicted, samples: per.length, totalMs: now() - t0 };\n}\n// 真裝置版：只包一層（建 pipeline 與 buffer，派發時計時並等 GPU 完成）。結果存進同一份快取，鍵為 ROOF|adapter|能力簽名。量不到回傳原因（不影響競賽）。\n// 對外入口：要拿 GPU 量測互斥鎖（前景排隊）。競賽內部呼叫時傳 locked:true，避免同一把鎖重入造成死結。\nfunction measureRoofline(o) {\n  const opts = o || {};\n  if (opts.locked) return measureRooflineInner(opts);\n  return nn.withMeasureLock(() => measureRooflineInner(opts));\n}\nasync function measureRooflineInner(o) {\n  const opts = o || {};\n  const VR = require('./variant_race.js');\n  const gd = await nn.getDevice(opts.navigator);\n  if (!gd.dev) return { ok: false, reason: '沒有 WebGPU（' + (gd.reason || '原因不明') + '）' };\n  const dev = gd.dev;\n  let lost = null; try { dev.lost.then((i) => { lost = (i && i.message) || 'lost'; }); } catch (_) { /* 監聽失敗不影響量測 */ }\n  const caps = CAPS || KS.probeCaps(null, dev);\n  const sig = require('./profile_priors.js').capSig(caps), adapter = opts.adapterDesc || ADAPTER;\n  const threads = 256 * 256, flopsPerIter = threads * 16 * 2;   // 每次迭代每執行緒 16 個 fma（每個 2 flop）\n  const out = gpuBuf(dev, null, threads * 4);\n  const pipe = dev.createComputePipeline({ layout: 'auto', compute: { module: dev.createShaderModule({ code: ROOF_WGSL }), entryPoint: 'main' } });\n  const ub = dev.createBuffer({ size: 16, usage: BUF.UNIFORM | BUF.COPY_DST });\n  const finish = (r) => { try { out.destroy(); ub.destroy(); } catch (_) { /* */ } return r; };\n  const dispatch = async (iters, n) => {\n    if (lost) throw new Error('裝置遺失：' + lost);\n    dev.queue.writeBuffer(ub, 0, new Uint32Array([iters, 0, 0, 0]));\n    const bg = dev.createBindGroup({ layout: pipe.getBindGroupLayout(0), entries: [{ binding: 0, resource: { buffer: out } }, { binding: 1, resource: { buffer: ub } }] });\n    const enc = dev.createCommandEncoder();\n    for (let r = 0; r < n; r++) { const pass = enc.beginComputePass(); pass.setPipeline(pipe); pass.setBindGroup(0, bg); pass.dispatchWorkgroups(256); pass.end(); }\n    const t = nowMsCore();\n    dev.queue.submit([enc.finish()]);\n    await dev.queue.onSubmittedWorkDone();\n    return nowMsCore() - t;\n  };\n  try {\n    const cal = await rooflineCalibrate({ dispatch: dispatch, now: nowMsCore });\n    if (lost) return finish({ ok: false, reason: '裝置遺失：' + lost });\n    if (!cal.ok) return finish(cal);\n    const gflops = gflopsFrom(flopsPerIter * cal.iters, cal.perDispatchMs);\n    const value = { gflops: Math.round(gflops * 100) / 100, iters: cal.iters, batch: cal.batch, perDispatchMs: Math.round(cal.perDispatchMs * 1000) / 1000, adapter: adapter, sig: sig, at: Date.now() };\n    const store = opts.store || TUNE.store || (TUNE.store = VR.createStore({}));\n    try { await store.set('ROOF|' + adapter + '|' + sig, value); } catch (_) { /* 退記憶體 */ }\n    return finish({ ok: true, gflops: value.gflops, value: value, totalMs: Math.round(cal.totalMs) });\n  } catch (e) {\n    return finish({ ok: false, reason: '量測失敗：' + String((e && e.message) || e).slice(0, 160) });\n  }\n}\n// 校正：在最小的形狀上量一次 mm_simple_f32（先暖機＝編譯，再計時），得到這台機器的實測 GFLOP/s。\nasync function calibrateSimple(sh, o) {\n  const opts = o || {};\n  const clock = () => (typeof performance !== 'undefined' ? performance : Date).now();\n  const M = sh.M, K = sh.K, N = sh.N;\n  let s = 11; const rnd = () => { s = (Math.imul(s, 1664525) + 1013904223) | 0; return (s >>> 0) / 4294967296 - 0.5; };\n  const a = Float32Array.from({ length: M * K }, rnd), b = Float32Array.from({ length: K * N }, rnd);\n  const warm = { navigator: opts.navigator, kernel: 'mm_simple_f32' };\n  await matmul(a, [M, K], b, [K, N], warm);\n  if (/cpu-js/.test((warm.lastInfo || {}).layer || '')) return { noGpu: true, reason: (warm.lastInfo || {}).reason || '' };\n  // 計時 3 次取中位數（單次量測會受首次提交等雜訊影響，偏慢或偏快都不可靠）\n  const xs = [];\n  for (let i = 0; i < 3; i++) {\n    const t = { navigator: opts.navigator, kernel: 'mm_simple_f32' };\n    const t0 = clock();\n    await matmul(a, [M, K], b, [K, N], t);\n    dispatchOk(t.lastInfo);\n    xs.push(Math.max(clock() - t0, 0.01));\n  }\n  xs.sort((p, q) => p - q);\n  const ms = xs[1];\n  return { noGpu: false, ms: ms, gSimple: flopsOf(sh) / (ms * 1e6) };\n}\n\nasync function raceMatmul(M, K, N, opts) {\n  const VR = require('./variant_race.js');\n  const o = opts || {};\n  const sh = { M: M, K: K, N: N };\n  const key = KS.cacheKey(ADAPTER, 'matmul', sh, CAPS);\n  const clock = () => (typeof performance !== 'undefined' ? performance : Date).now();\n  let s = 7; const rnd = () => { s = (Math.imul(s, 1664525) + 1013904223) | 0; return (s >>> 0) / 4294967296 - 0.5; };\n  let ids = KS.VARIANTS.matmul.filter((v) => !v.applies || v.applies(sh)).map((v) => v.id);\n  let gated = [];\n  if (o.gSimple) {\n    // 有校正：逐候選依預估時間判斷；全部超過上限就一次都不派發\n    const g = gateCandidates(sh, ids, o.gSimple, o.safeMs || SAFE_DISPATCH_MS);\n    ids = g.run; gated = g.skipped;\n    if (!ids.length) return { noGpu: false, winner: null, timings: {}, bad: [], skipped: [], cancelled: false, gated: gated, key: key };\n  } else {\n    // 沒有校正：暖機兼偵測，退 cpu-js 就不競賽\n    const wa = Float32Array.from({ length: M * K }, rnd), wb = Float32Array.from({ length: K * N }, rnd);\n    const warm = { navigator: o.navigator, kernel: 'mm_simple_f32' };\n    await matmul(wa, [M, K], wb, [K, N], warm);\n    if (/cpu-js/.test((warm.lastInfo || {}).layer || '')) return { noGpu: true, winner: null, timings: {}, bad: [], skipped: [], cancelled: false, gated: [], key: key };\n  }\n  // 只有真的要跑的形狀才產生輸入與 CPU 參考（參考在主執行緒算，大形狀會卡住頁面，所以被略過的形狀不做）\n  const a = Float32Array.from({ length: M * K }, rnd), b = Float32Array.from({ length: K * N }, rnd);\n  const ref = matmulRef(a, [M, K], b, [K, N]).y;\n  let scale = 0; for (let i = 0; i < ref.length; i++) scale = Math.max(scale, Math.abs(ref[i]));\n  // 計時改成「核心時間」：不含上傳與回讀。每個候選各編譯一次管線（編譯 ms 另記）；\n  // 一批派發放進同一次提交，等 GPU 完成才停表，除以批次數。驗證仍走完整路徑（對 CPU 參考）。\n  const gd = await nn.getDevice(o.navigator);\n  const dev = gd && gd.dev;\n  if (!dev) return { noGpu: true, winner: null, timings: {}, bad: [], skipped: [], cancelled: false, gated: gated, key: key, reason: (gd && gd.reason) || '' };\n  const bufA = gpuBuf(dev, a, M * K * 4), bufB = gpuBuf(dev, b, K * N * 4), bufY = gpuBuf(dev, null, M * N * 4);\n  const uni = new Int32Array([1, M, K, N, 1, 0, 0, 0]);   // 與 run() 的 u 相同欄位：B, M, K, N, Bb, azp, bzp, fl\n  const jobs = {};\n  const jobFor = async (id) => {\n    if (!jobs[id]) {\n      const simple = id === 'mm_simple_f32';\n      const code = id === 'mm_vec4_f32' ? WGSL_MM_F32_VEC4 : (simple ? WGSL_MM_F32 : WGSL_MM_F32_TILED);\n      const groups = simple ? [Math.ceil(M * N / 64), 1, 1] : [Math.ceil(N / 64), Math.ceil(M / 64), 1];\n      const job = await coreJob(dev, code, [bufA, bufB, bufY], uni, groups);\n      job.samples = [];\n      jobs[id] = job;\n    }\n    return jobs[id];\n  };\n  const cands = ids.map((id) => ({\n    id: id,\n    verify: async () => {\n      const ops = Object.assign({}, o, { kernel: id });\n      const r = await matmul(a, [M, K], b, [K, N], ops);\n      dispatchOk(ops.lastInfo);\n      let d = 0; for (let i = 0; i < ref.length; i++) d = Math.max(d, Math.abs(r.y[i] - ref[i]));\n      return d / Math.max(scale, 1e-30);\n    },\n    run: async () => {\n      const job = await jobFor(id);\n      if (!job.est) { const t = clock(); await job.reps(1); job.est = Math.max(clock() - t, 0.01); }\n      const n = pickBatch(job.est, CORE_SAMPLE_MS);\n      let tot = 0;\n      for (const c of splitRuns(n, job.est, CORE_SPLIT_MS)) { const t = clock(); await job.reps(c); tot += clock() - t; }   // 估計超過 100 ms 就拆成多個提交\n      const per = tot / n;\n      job.samples.push(per);\n      return per;\n    },\n  }));\n  let res;\n  try {\n    res = await VR.race(cands, { tol: 1e-5, budgetMs: o.budgetMs || VR.DEFAULT_BUDGET_MS, runs: o.runs || 3, K: o.K || 3, cancel: o.cancel, now: o.now || (() => clock()) });\n  } finally {\n    for (const k of Object.keys(jobs)) { try { jobs[k].destroy(); } catch (_) { /* */ } }\n    for (const x of [bufA, bufB, bufY]) { try { x.destroy(); } catch (_) { /* */ } }\n  }\n  res.gated = gated;\n  if (res.winner) {\n    const key = KS.cacheKey(ADAPTER, 'matmul', sh, CAPS);\n    const wj = jobs[res.winner.id];\n    const compile = wj ? compileFromSamples(wj.compileTotal, wj.samples) : null;\n    const value = { id: res.winner.id, median: res.winner.median, timings: res.timings, basis: 'kernel-only', compile: compile };\n    WINNERS.set(key, value);\n    if (o.store) { try { await o.store.set(key, value); } catch (_) { /* 退記憶體（已在 WINNERS） */ } }\n  }\n  res.key = KS.cacheKey(ADAPTER, 'matmul', sh, CAPS);\n  return res;\n}\n\n// ---------- 啟動接線（G4）：載入勝者；簽名變了（或從未量過）的形狀才背景重跑 ----------\n// 自動重跑只用小形狀（64×1024×1024）：CPU 參考在主執行緒算，大形狀會卡住頁面；大形狀由設定頁「重跑」手動做。\nconst TUNE = { started: false, store: null };\nconst AUTO_SHAPES = [{ M: 64, K: 1024, N: 1024 }];\n// 重跑（設定頁「重跑」用）：先清掉這些形狀的勝者（記憶體與儲存），再競賽一次；派發在競賽期間用規則，不會被擋住。\n// 注意：舊勝者在競賽前就清掉了；取消、沒有 GPU、或競賽失敗時，這些形狀就退回規則（下次競賽會再補上）。\nasync function rerunMatmul(shapes, o) {\n  const opts = o || {};\n  const list = (shapes || []).filter((sh) => sh && sh.M > 0 && sh.K > 0 && sh.N > 0);\n  const store = opts.store || TUNE.store;\n  for (const sh of list) {\n    const key = KS.cacheKey(ADAPTER, 'matmul', sh, CAPS);\n    WINNERS.delete(key);\n    if (store && typeof store.remove === 'function') { try { await store.remove(key); } catch (_) { /* 記憶體已清 */ } }\n  }\n  return startMatmulRace(list, opts);\n}\n// 窗格（設定頁）建立快取時要用的同一組鍵條件：adapter 描述與能力表。窗格若用別的值，就查不到這裡的勝者。\nfunction getMatmulTuneContext() { return { adapter: ADAPTER, caps: CAPS }; }\n\n// initMatmulTuning({ device, adapterDesc, store, shapes })：探測能力、從 store 整批載入勝者，回報缺勝者的形狀（簽名變了就會缺）。\n// 只讀，不量；量測由 startMatmulRace 做。store 沒給就用 variant_race 的預設（與 kernel_race 共用的 localStorage 快取，node 退記憶體）。\nasync function initMatmulTuning(o) {\n  const opts = o || {};\n  const VR = require('./variant_race.js');\n  // 已經設定過的能力（例如設定頁用 adapter 探測的結果）就沿用，不被裝置探測蓋掉：\n  // 兩種探測的欄位來源不同（adapter 的功能 vs 請求過的裝置功能），會讓同一張卡的競賽鍵飄移，設定頁的表格就查不到勝者。\n  const caps = CAPS || KS.probeCaps(null, opts.device || null);\n  const desc = opts.adapterDesc || 'unknown';\n  if (!CAPS) setMatmulCaps(caps, desc);\n  const store = opts.store || VR.createStore({});\n  let entries = [];\n  try { entries = await store.entries(); } catch (_) { entries = []; }\n  setMatmulWinners(entries);\n  TUNE.store = store;\n  const sig = KS.capsHash(caps);\n  const missing = (opts.shapes || []).filter((sh) => !WINNERS.has(KS.cacheKey(desc, 'matmul', sh, caps)));\n  const stale = entries.filter((e) => String(e.key).split('|').pop() !== sig).length;\n  return { tier: KS.tierOf(caps), capsSig: sig, loaded: entries.length, stale: stale, missing: missing };\n}\n// startMatmulRace(shapes, o)：逐形狀跑 raceMatmul（每形狀預算 2 秒，可取消）。o.navigator 必須給瀏覽器的 navigator 才會用 GPU。\n// 回傳每個形狀一筆：{ shape, key, winner, noGpu, bad, skipped（依預估略過的候選）, cancelled, error }。\n// 逐形狀獨立：某形狀丟例外只記在它自己那筆，後面照跑；裝置遺失就標原因並停止（其餘形狀標「未執行」）；取消在形狀之間與候選之間生效。\n// opts.onProgress({ i, n, shape, msg })：狀態列用。opts.raceOne／opts.calibrate 可注入（測試用）。\n// 競賽入口：整個競賽在 GPU 量測互斥鎖之內（前景排隊；opts.background 為真時，有量測在跑就跳過，不重疊）\nfunction startMatmulRace(shapes, o) {\n  const opts = o || {};\n  return nn.withMeasureLock(() => startMatmulRaceInner(shapes, opts), { background: !!opts.background });\n}\nasync function startMatmulRaceInner(shapes, o) {\n  const opts = o || {};\n  const list = (shapes || []).filter((sh) => sh && sh.M > 0 && sh.K > 0 && sh.N > 0);\n  const n = list.length, out = [];\n  const say = (i, sh, msg) => { try { if (opts.onProgress) opts.onProgress({ i: i + 1, n: n, shape: sh, msg: msg }); } catch (_) { /* 顯示失敗不影響競賽 */ } };\n  const raceOne = opts.raceOne || raceMatmul;\n  const calibrate = opts.calibrate || calibrateSimple;\n  if (!n) return out;\n  // 競賽勝者要寫進表格讀的那個儲存（TUNE.store）：沒有就建一個，表格之後也讀同一個，否則表格看不到這次的結果\n  if (!TUNE.store) TUNE.store = require('./variant_race.js').createStore({});\n  // 校正在最小的形狀上做（派發量最少，也是現行保護過的那個形狀）\n  let calib = null, calibErr = null;\n  try { calib = await calibrate(list.slice().sort((x, y) => flopsOf(x) - flopsOf(y))[0], opts); } catch (e) { calibErr = String((e && e.message) || e).slice(0, 200); }\n  if (calibErr || (calib && calib.noGpu)) {\n    const why = calibErr || ('沒有 GPU（' + String((calib && calib.reason) || '退回 CPU').slice(0, 160) + '）');\n    for (const sh of list) out.push({ shape: sh, key: null, winner: null, noGpu: !calibErr, bad: [], skipped: [], cancelled: false, error: why });\n    return out;\n  }\n  // 占峰值（屋頂 R0）：只在真的競賽時量一次，結果放 TUNE.roofline；量不到只記原因，不影響競賽\n  if (!opts.raceOne && opts.roofline !== false) {\n    try { TUNE.roofline = await measureRoofline({ navigator: opts.navigator, store: TUNE.store, locked: true }); }\n    catch (e) { TUNE.roofline = { ok: false, reason: '量測失敗：' + String((e && e.message) || e).slice(0, 160) }; }\n  }\n  let stop = null;\n  for (let i = 0; i < n; i++) {\n    const sh = list[i];\n    if (stop) { out.push({ shape: sh, key: null, winner: null, noGpu: false, bad: [], skipped: [], cancelled: stop === '已取消', error: '未執行：' + stop }); continue; }\n    if (opts.cancel && opts.cancel()) { stop = '已取消'; out.push({ shape: sh, key: null, winner: null, noGpu: false, bad: [], skipped: [], cancelled: true, error: '未執行：已取消' }); continue; }\n    say(i, sh, '驗證與計時中');\n    try {\n      const r = await raceOne(sh.M, sh.K, sh.N, { navigator: opts.navigator, store: TUNE.store, budgetMs: opts.budgetMs, cancel: opts.cancel, gSimple: calib.gSimple, safeMs: opts.safeMs, runs: opts.runs, K: opts.K, now: opts.now });\n      out.push({ shape: sh, key: r.key || null, winner: r.winner || null, noGpu: !!r.noGpu, bad: r.bad || [], skipped: r.gated || [], cancelled: !!r.cancelled, error: null });\n      if ((r.bad || []).some((b) => isLostText(b.reason))) stop = '裝置遺失（之後的形狀不再執行）';\n    } catch (e) {\n      const msg = String((e && e.message) || e).slice(0, 200);\n      out.push({ shape: sh, key: null, winner: null, noGpu: false, bad: [], skipped: [], cancelled: false, error: msg });\n      if (isLostText(msg)) stop = '裝置遺失（之後的形狀不再執行）';\n    }\n    if (out[out.length - 1].cancelled) stop = '已取消';\n  }\n  return out;\n}\n\nmodule.exports = { setOffloadCrossover, getOffloadStatus, rerunMatmul, getMatmulTuneContext, matmulRef, matmul, matmulIntRef, matmulInt, WGSL_MM_F32, WGSL_MM_F32_TILED, WGSL_MM_F32_VEC4, WGSL_MM_I32, plan, pickMatmulKernel, setMatmulCaps, getMatmulCaps: () => CAPS, setMatmulWinners, raceMatmul, initMatmulTuning, startMatmulRace, calibrateSimple, gateCandidates, estimateMs, flopsOf, SAFE_DISPATCH_MS, REL_SPEED, AUTO_SHAPES, TUNE, measureRoofline, pickBatch, compileFromSamples, pickRooflineIters, gflopsFrom, peakFromEntries, CORE_SAMPLE_MS, ROOF_TARGET_MS, ROOF_ABORT_MS, ROOF_MAX_ITERS, rooflineCalibrate, splitRuns, CORE_SPLIT_MS };\n\n};\nMODS[\"cpu_share\"] = function (module, exports, require) {\n'use strict';\n// cpu_share.js — 異質運算（GPU＋CPU 分工）：把一個 f32 矩陣乘按「列」切成兩段，GPU 算前段、CPU 的 Web Worker 同時算後段，再接起來。\n// 目的：內顯（Intel Xe 等）跑矩陣乘時 GPU 滿載、CPU 閒置；內顯與 CPU 共用記憶體，分工沒有 PCIe 搬運成本。\n//\n//   createCpuShare({ makeWorker, cores, now }) → share\n//     share.setCores(n)            CPU 出幾個核心（0＝關閉，完全不分工）\n//     share.cores()                目前設定\n//     share.run(gpuFn, A, B, m, k, n, opts) → Promise<{ y, info }>\n//         gpuFn(Arows, mG) → Promise<Float32Array>   算前 mG 列（呼叫端提供，通常是原本的 GPU 路徑）\n//         opts.transB          B 以 n×k 儲存\n//         opts.bKey            B 是常駐權重時給同一個物件，Worker 端快取、只送一次\n//     share.stats()                最近一次的分工結果（列數、兩邊耗時、採用的比例）\n//   cpuRowsRef(A, B, m, k, n, transB) → Float32Array     單執行緒參考實作（Worker 內跑的就是同一個函式）\n//\n// 不改變數值語意：兩邊都是 f32 累加（GPU 與 CPU 的累加順序不同，差異在 tolerance 內，與既有的 GPU↔CPU 對拍一致）。\n// 沒有 Worker（makeWorker 回傳 null／丟錯）或 cores=0 → 一律回報 shared:false，由呼叫端走原路徑。\n\nconst HS = require('./hetero_split.js');  // 分攤決策公式（見 docs/DESIGN.cudaweb-hetero.md 第 2 節）\nconst GQ = require('./gpu_async_queue.js'); // 統一句柄：CPU 段與 GPU 段都是佇列上的提交（見設計文件第 4 節）\nconst CG = require('./cpu_gemm.js');        // 分塊＋WASM SIMD 主執行緒核心（docs/DESIGN.cpu-gemm.md）\nconst CW = require('./cpu_gemm_wasm.js');   // WASM 位元組（送給 Worker；不支援 SIMD 時退回 cpuRowsRef）\nconst CR = require('./cpu_gemm_rows.js');   // Worker 內的列區塊核心（自給自足，可 toString 進 Blob）\nconst MIN_FLOPS = 2e7;      // M*K*N 小於這個不分工（派發與搬運的固定成本大於收益）\nconst MIN_ROWS = 16;\nconst MAX_CPU_RATIO = 0.5;  // CPU 最多分擔一半的列；GPU 慢到比 CPU 還慢時，使用者應直接選 CPU 模式\nconst FIRST_RATIO_PER_CORE = 0.02;\n// 還沒有 CPU 速率時的探測比例：只為了量 CPU 速率，會讓 CPU 做一小份（設計文件第 2 節的例外，見第 9 節）\nconst PROBE_EVERY = 10;     // 決策說「不切」時，每 10 次強制探測一次，免得 CPU 速率過期\nconst CPU_OVERHEAD_MS = 0.5; // 每次分工的 CPU 固定成本（送出／接收訊息、拷貝），用於決策\n\n// Worker 內與主執行緒共用的核心：列區塊 C[m×n] = A[m×k]·B（transB：B 是 n×k）。i-k-j 迴圈讓 B 的列連續讀。\nfunction cpuRowsRef(A, B, m, k, n, transB) {\n  const C = new Float32Array(m * n);\n  if (!transB) {\n    for (let i = 0; i < m; i++) {\n      const ci = i * n, ai = i * k;\n      for (let kk = 0; kk < k; kk++) {\n        const a = A[ai + kk]; if (a === 0) continue;\n        const bk = kk * n;\n        for (let j = 0; j < n; j++) C[ci + j] += a * B[bk + j];\n      }\n    }\n  } else {\n    for (let i = 0; i < m; i++) {\n      const ai = i * k;\n      for (let j = 0; j < n; j++) {\n        const bj = j * k; let s = 0;\n        for (let kk = 0; kk < k; kk++) s += A[ai + kk] * B[bj + kk];\n        C[i * n + j] = s;\n      }\n    }\n  }\n  return C;\n}\n\n// Worker 原始碼（Blob 用）：從 cpuRowsRef 的原始碼組出，所以測試與實際執行是同一份邏輯\n// 主執行緒的 CPU 核心：支援 SIMD 就用分塊＋WASM SIMD（實測約為舊核心 15 倍），否則退回 cpuRowsRef。結果等價（相對誤差 ≤ 1e-5）。\nconst SIMD_BYTES = (() => { try { return CW.simdSupported() ? CW.buildModule() : null; } catch (_) { return null; } })();\nfunction cpuKernel(A, B, m, k, n, transB, ko) {\n  if (SIMD_BYTES) { try { return CG.gemmPackedSimd(A, B, m, k, n, Object.assign({ transB: !!transB }, ko || {})); } catch (_) { /* 退回參考實作 */ } }\n  return cpuRowsRef(A, B, m, k, n, transB);\n}\n\n// 工作者路徑門檻（純函式）：運算量 2·m·k·n 小於門檻就只用主執行緒。\n// 依據（真機與節點量測）：512³（約 2.7e8 flops）時工作者慢於主執行緒（真機 9.6／9.4／11.4 vs 12.6 GFLOP/s）；\n// 1024³（約 2.1e9）時工作者有加速（節點 1.75× 到 2.7×）。門檻定在兩者之間，768³ 的 2 倍，之後要用真機再校正。\nconst MIN_WORKER_FLOPS = 2 * 768 * 768 * 768;\nfunction cpuPathFor(o) {\n  const m = Number(o.m) || 0, k = Number(o.k) || 0, n = Number(o.n) || 0, w = Math.floor(Number(o.workers) || 0);\n  const flops = 2 * m * k * n;\n  const thr = o.minFlops == null ? MIN_WORKER_FLOPS : Number(o.minFlops);\n  if (w < 1) return { path: 'main', flops, reason: '沒有工作者' };\n  if (flops < thr) return { path: 'main', flops, reason: '運算量 ' + flops + ' 小於門檻 ' + thr + '：傳送與拼接成本划不來，只用主執行緒' };\n  return { path: 'workers', flops, reason: '運算量大於門檻：沿 M 分給工作者' };\n}\n\nfunction workerSource() {\n  return cpuRowsRef.toString() + CR.gemmRowsSimdKernel.toString() + `\nconst CACHE = new Map();\nself.onmessage = (ev) => {\n  const d = ev.data;\n  try {\n    let B = d.B;\n    if (d.bKey != null) { if (B) { CACHE.set(d.bKey, B); if (CACHE.size > 4) CACHE.delete(CACHE.keys().next().value); } else B = CACHE.get(d.bKey); }\n    if (!B) { self.postMessage({ id: d.id, miss: true }); return; }\n    const C = d.wasm\n      ? gemmRowsSimdKernel(d.A, B, d.m, d.k, d.n, false, !!d.transB, 0, d.m, d.wasm, 96, 64, 512, null)\n      : cpuRowsRef(d.A, B, d.m, d.k, d.n, d.transB);\n    self.postMessage({ id: d.id, C }, [C.buffer]);\n  } catch (e) { self.postMessage({ id: d.id, error: String((e && e.message) || e) }); }\n};`;\n}\n\nfunction defaultMakeWorker() {\n  if (typeof Worker === 'undefined' || typeof Blob === 'undefined' || typeof URL === 'undefined') return null;\n  const url = URL.createObjectURL(new Blob([workerSource()], { type: 'application/javascript' }));\n  const w = new Worker(url);\n  w.__url = url;\n  return w;\n}\n\nfunction createCpuShare(o) {\n  const opts = o || {};\n  const makeWorker = opts.makeWorker || defaultMakeWorker;\n  const now = opts.now || (() => (typeof performance !== 'undefined' ? performance : Date).now());\n  let want = Math.max(0, Math.floor(opts.cores || 0));\n  const minWorkerFlops = opts.minWorkerFlops == null ? MIN_WORKER_FLOPS : Number(opts.minWorkerFlops);   // 測試可設 0 以強制走工作者路徑\n  const pool = [];                 // { w, busy, pending: Map id→{resolve,reject}, bKeys:Set }\n  let seq = 0;\n  let broken = null;               // 建立 Worker 失敗的原因；非 null 就不再嘗試\n  // 兩邊的實測速率（flops/ms，指數平均）；沒有資料前用保守的初始比例\n  const rate = { gpu: 0, cpu: 0 };\n  let last = null;\n  const profileOn = !!opts.profile;\n  // 主執行緒 CPU 核心的呼叫（含計時，評估模式才累加）\n  function timedKernel(A, B, m, k, n, transB, ko) {\n    const T = profileOn ? {} : null; const w0 = profileOn ? now() : 0;\n    const y = cpuKernel(A, B, m, k, n, transB, Object.assign({}, ko || {}, { timing: T }));\n    if (T) { cpuBreak.calls++; cpuBreak.wallMs += now() - w0; cpuBreak.packBMs += T.packBMs || 0; cpuBreak.packAMs += T.packAMs || 0; cpuBreak.computeMs += T.computeMs || 0; cpuBreak.blocksReused += T.blocksReused || 0; }\n    return y;\n  }   // 評估模式：累加主執行緒 CPU 核心的分段計時（打包 B、打包 A、計算、呼叫次數）\n  const cpuBreak = { calls: 0, packBMs: 0, packAMs: 0, computeMs: 0, blocksReused: 0, wallMs: 0 };\n  let goMs = 0;                    // GPU 段提交時在主執行緒的同步成本（EMA，毫秒）：不隨列數變，當作固定成本放進決策\n  let lastCpuOwnMs = 0;            // 最近一次 CPU 段自己執行的時間（不含排在 GPU 提交後面的等待）\n  // 速率持久化（可選）：opts.rateStore（hetero_rates.createRateStore）＋ opts.rateKey。建立時載入；每次分工後存回（不等待、失敗不影響執行）。\n  const rateStore = opts.rateStore || null, rateKeyStr = opts.rateKey || null;\n  if (rateStore && rateKeyStr) {\n    rateStore.load(rateKeyStr).then((v) => { if (v && !(rate.gpu > 0)) { rate.gpu = v.gpu; rate.cpu = v.cpu; } }).catch(() => {});\n  }\n  const saveRates = () => { if (rateStore && rateKeyStr && rate.gpu > 0 && rate.cpu > 0) rateStore.save(rateKeyStr, { gpu: rate.gpu, cpu: rate.cpu, updatedAt: Date.now() }).catch(() => {}); };\n\n  // 統一句柄的執行器：op.device 為 'cpu' 時把列區塊送給 Worker；為 'gpu' 時呼叫呼叫端的 gpuFn\n  let streamSeq = 0;\n  const queue = GQ.createGpuQueue({\n    maxPending: 64,\n    execute: (op, a) => {\n      if (op.device !== 'cpu') return Promise.resolve(a.fn(a.A, a.mG));\n      const s0 = now(); const p = cpuExec(a);\n      p.then(() => { lastCpuOwnMs = now() - s0; }, () => { lastCpuOwnMs = now() - s0; });\n      return p;\n    },\n  });\n  async function cpuExec(a) {\n    const rows = a.m - a.mG;\n    if (rows > 0 && !a.forceWorker && cpuPathFor({ m: rows, k: a.k, n: a.n, workers: a.nW, minFlops: minWorkerFlops }).path === 'main') {\n      return [timedKernel(a.A.slice(a.mG * a.k, a.m * a.k), a.B, rows, a.k, a.n, !!a.transB, { cacheB: a.bId != null })];\n    }\n    const parts = [];\n    for (let w = 0; w < a.nW; w++) {\n      const r0 = a.mG + w * a.per, r1 = Math.min(a.m, r0 + a.per); if (r1 <= r0) break;\n      const slot = pool[w];\n      const msg = { id: ++seq, A: a.A.slice(r0 * a.k, r1 * a.k), m: r1 - r0, k: a.k, n: a.n, transB: !!a.transB, wasm: SIMD_BYTES };\n      if (a.bId != null) {\n        msg.bKey = a.bId;\n        if (!slot.bKeys.has(a.bId)) { msg.B = a.B; slot.bKeys.add(a.bId); if (slot.bKeys.size > 4) slot.bKeys.delete(slot.bKeys.values().next().value); }\n      } else msg.B = a.B;\n      parts.push(post(slot, msg).catch(async (e) => {\n        if (!e || !e.miss) throw e;\n        slot.bKeys.delete(a.bId);\n        return post(slot, Object.assign({}, msg, { id: ++seq, B: a.B }));   // Worker 端快取被擠掉：補送一次\n      }));\n    }\n    return Promise.all(parts);\n  }\n  const bIds = new WeakMap(); let bSeq = 0;\n\n  function ensurePool() {\n    while (pool.length < want && !broken) {\n      let w = null;\n      try { w = makeWorker(); } catch (e) { broken = String((e && e.message) || e); break; }\n      if (!w) { broken = '這個環境沒有 Worker'; break; }\n      const slot = { w, pending: new Map(), bKeys: new Set() };\n      w.onmessage = (ev) => {\n        const d = ev.data || {}; const p = slot.pending.get(d.id); if (!p) return;\n        slot.pending.delete(d.id);\n        if (d.error) p.reject(new Error(d.error)); else if (d.miss) p.reject(Object.assign(new Error('miss'), { miss: true })); else p.resolve(d.C);\n      };\n      w.onerror = (e) => { slot.pending.forEach((p) => p.reject(new Error(String((e && e.message) || 'worker error')))); slot.pending.clear(); };\n      pool.push(slot);\n    }\n    while (pool.length > want) { const s = pool.pop(); try { s.w.terminate(); if (s.w.__url) URL.revokeObjectURL(s.w.__url); } catch (_) { /* 結束失敗不影響 */ } }\n  }\n\n  function setCores(n) {\n    want = Math.max(0, Math.min(256, Math.floor(Number(n) || 0)));\n    if (want === 0) ensurePool(); else { broken = null; }   // 關閉時立刻收掉 Worker；再開時允許重試\n  }\n\n  function post(slot, msg, transfer) {\n    return new Promise((resolve, reject) => { slot.pending.set(msg.id, { resolve, reject }); try { slot.w.postMessage(msg, transfer || []); } catch (e) { slot.pending.delete(msg.id); reject(e); } });\n  }\n\n  // 比例：兩邊速率都量到了，就用分攤決策（含固定成本與 15% margin，見 hetero_split）；還沒量到就做小份探測。\n  // 決策說不切時，每 PROBE_EVERY 次探測一次，免得 CPU 速率過期。未給尺寸時當作大運算（測試與舊呼叫端用）。\n  let sinceProbe = 0;\n  let fbFrac = null;   // 上一次分工的實測段耗時回饋（null＝還沒有）\n  function ratioNow(m, k, n) {\n    const probe = Math.min(MAX_CPU_RATIO, want * FIRST_RATIO_PER_CORE);\n    if (!(rate.gpu > 0 && rate.cpu > 0)) return probe;\n    const work = (m && k && n) ? 2 * m * k * n : 1e9;\n    const d = HS.decideSplit({ work, gpuAvailable: true, cpuAvailable: want > 0, gpuRate: rate.gpu, cpuRate: rate.cpu, gpuOverheadMs: goMs, cpuOverheadMs: CPU_OVERHEAD_MS });\n    if (d.mode === 'split') {\n      sinceProbe = 0;\n      const f = fbFrac == null ? d.fraction : Math.min(d.fraction, fbFrac);   // 實測段耗時的回饋只會往下修\n      return Math.min(MAX_CPU_RATIO, f);\n    }\n    if (++sinceProbe >= PROBE_EVERY) { sinceProbe = 0; return probe; }\n    return 0;\n  }\n  const ema = (old, v) => (old > 0 ? old * 0.6 + v * 0.4 : v);\n\n  async function run(gpuFn, A, B, m, k, n, ro) {\n    const r = ro || {};\n    const flops = 2 * m * k * n;\n    if (want <= 0) return { shared: false, why: 'off' };\n    if (m < MIN_ROWS || m * k * n < MIN_FLOPS) return { shared: false, why: 'small' };\n    ensurePool();\n    if (broken || !pool.length) return { shared: false, why: broken || 'no-worker' };\n    const ratio = ratioNow(m, k, n);\n    let mC = Math.floor(m * ratio);\n    mC = Math.min(mC, m - 1);\n    if (mC < 1) return { shared: false, why: 'ratio' };\n    const mG = m - mC;\n    // CPU 段再按列分給各 Worker\n    const nW = Math.min(pool.length, mC);\n    const per = Math.ceil(mC / nW);\n    let bId = null;\n    if (r.bKey && typeof r.bKey === 'object') { bId = bIds.get(r.bKey); if (bId == null) { bId = ++bSeq; bIds.set(r.bKey, bId); } }\n    const t0 = now();\n    let cpuMs = 0, gpuMs = 0;\n    // 統一句柄：CPU 段與 GPU 段都是佇列上的一次提交，各自一條 stream（每次分工用新的 stream 編號，失敗不會影響下一次）\n    const sG = ++streamSeq * 2, sC = sG + 1;\n    let gpuSyncMs = 0;\n    const timedGpu = (Asub, mGv) => { const s1 = now(); const rr = gpuFn(Asub, mGv); gpuSyncMs = now() - s1; return rr; };\n    const hG = queue.submit({ device: 'gpu', name: 'matmul' }, { fn: timedGpu, A: A.subarray(0, mG * k), mG }, sG);\n    // cpuSegment: 'worker' 強制 CPU 段走工作者（不占主執行緒）；預設 'auto' 依門檻決定\n    const hC = queue.submit({ device: 'cpu', name: 'rows' }, { A, B, m, k, n, transB: !!r.transB, bId, mG, nW, per, forceWorker: r.cpuSegment === 'worker' }, sC);\n    const pG = queue.wait(hG).then((v) => { gpuMs = now() - t0; return v; });\n    const pC = queue.wait(hC).then((v) => { cpuMs = now() - t0; return v; });\n    const settled = await Promise.all([pG, pC].map((p) => p.then((v) => ({ ok: true, v }), (e) => ({ ok: false, e }))));\n    try { queue.forget(hG); queue.forget(hC); } catch (_) { /* 句柄已在上面等完，forget 不會失敗；保險起見忽略 */ }\n    const bad = settled.find((s) => !s.ok);\n    if (bad) return { shared: false, why: 'error', error: String((bad.e && bad.e.message) || bad.e) };\n    const yG = settled[0].v, cpuParts = settled[1].v;\n    const y = new Float32Array(m * n);\n    y.set(yG.length === mG * n ? yG : yG.subarray(0, mG * n), 0);\n    let off = mG * n; cpuParts.forEach((c) => { y.set(c, off); off += c.length; });\n    // 段耗時回饋：這次實測的 GPU 段與 CPU 段耗時，算出讓兩段相等的比例；下一次的比例不會超過它（CPU 段慢 → 往下修）\n    const cpuOwn = lastCpuOwnMs > 0 ? lastCpuOwnMs : cpuMs;\n    fbFrac = HS.feedbackFraction(mC / m, gpuMs, cpuOwn, MAX_CPU_RATIO);\n    goMs = ema(goMs, gpuSyncMs);\n    // 回饋：兩邊各自的速率（用各自完成的時間，不是總時間），下一次的比例據此調整\n    if (gpuMs > 0) rate.gpu = ema(rate.gpu, (2 * mG * k * n) / gpuMs);\n    if (cpuOwn > 0) rate.cpu = ema(rate.cpu, (2 * mC * k * n) / cpuOwn);\n    saveRates();\n    last = { shared: true, gpuSyncMs: Math.round(gpuSyncMs * 10) / 10, cpuOwnMs: Math.round(cpuOwn * 10) / 10, m, mGpu: mG, mCpu: mC, workers: nW, ratio: Math.round(ratio * 1000) / 1000, gpuMs: Math.round(gpuMs * 10) / 10, cpuMs: Math.round(cpuMs * 10) / 10, totalMs: Math.round((now() - t0) * 10) / 10, flops };\n    return { shared: true, y, info: last };\n  }\n\n  // 純 CPU 池（沒有 WebGPU 時用；設計文件第 5 節）：全部列交給 Worker；沒有 Worker 就在主執行緒算；Worker 出錯也退回主執行緒。\n  // 回傳一定是 shared:true 且結果正確，info.mode 說明實際走的路徑（cpu-workers／cpu-main）。\n  async function runCpuOnly(A, B, m, k, n, ro) {\n    const r = ro || {};\n    const transB = !!r.transB;\n    const mainRun = (why, fallback) => ({ shared: true, y: timedKernel(A, B, m, k, n, transB, { cacheB: !!r.bKey }), info: { mode: 'cpu-main', workers: 0, why, fallback } });\n    if (want <= 0) return mainRun('off');\n    const pick = cpuPathFor({ m, k, n, workers: want, minFlops: minWorkerFlops });\n    if (pick.path === 'main') return { shared: true, y: cpuKernel(A, B, m, k, n, transB), info: { mode: 'cpu-main', workers: 0, why: pick.reason, threshold: true } };\n    ensurePool();\n    if (broken || !pool.length) return mainRun(broken || 'no-worker');\n    const nW = Math.min(pool.length, m);\n    if (nW < 1) return mainRun('empty');\n    const per = Math.ceil(m / nW);\n    let bId = null;\n    if (r.bKey && typeof r.bKey === 'object') { bId = bIds.get(r.bKey); if (bId == null) { bId = ++bSeq; bIds.set(r.bKey, bId); } }\n    const t0 = now();\n    try {\n      const parts = await cpuExec({ A, B, m, k, n, transB, bId, mG: 0, nW, per });\n      const y = new Float32Array(m * n);\n      let off = 0; parts.forEach((c) => { y.set(c, off); off += c.length; });\n      return { shared: true, y, info: { mode: 'cpu-workers', workers: nW, rows: m, totalMs: Math.round((now() - t0) * 10) / 10 } };\n    } catch (e) {\n      return mainRun(null, 'worker-error: ' + String((e && e.message) || e));\n    }\n  }\n\n  function stats() { return { cores: want, workers: pool.length, broken, rate: { gpu: rate.gpu, cpu: rate.cpu }, feedback: fbFrac, goMs, cpuBreak: profileOn ? Object.assign({}, cpuBreak) : null, last }; }\n  function dispose() { want = 0; ensurePool(); }\n  // _setRates／_ratioNow 只給測試用（底線開頭）：直接設定兩邊速率，讓決策可以確定地走到切分或不切\n  return { setCores, cores: () => want, run, runCpuOnly, stats, dispose, _ratioNow: ratioNow, _setRates: (g, c) => { rate.gpu = Number(g) || 0; rate.cpu = Number(c) || 0; fbFrac = null; } };\n}\n\n// 全域單例：mm_ops 與設定頁共用\nlet SHARED = null;\nfunction getShared() { if (!SHARED) SHARED = createCpuShare({}); return SHARED; }\n\n// CPU 核心的版本識別：核心改了（分塊、微核心、工作者協定）就要換這個字串，速率快取的鍵會跟著變，舊速率自動作廢。\nconst CPU_KERNEL_ID = 'cpu-simd-pack4x8-v2';\n\nmodule.exports = { createCpuShare, cpuRowsRef, workerSource, getShared, MIN_FLOPS, MIN_ROWS, MAX_CPU_RATIO, CPU_KERNEL_ID, MIN_WORKER_FLOPS, cpuPathFor };\n\n};\nMODS[\"cpu_gemm\"] = function (module, exports, require) {\n'use strict';\n// 純 CPU GEMM（GotoBLAS 風格）：外層分塊（NC×KC×MC）、把 A 與 B 打包成連續的小面板、內層 MR×NR 微核心。\n// 轉置在打包時處理（不整個矩陣轉置、不改輸入）。累加用 double（JS number），最後才寫成 Float32，誤差比逐步寫入 Float32 小。\n// 介面：gemmPacked(A, B, m, k, n, opts)；opts 可以是布林（視為 transB）或 {transA, transB, MC, KC, NC}。\n// 邏輯 shape：A 是 m×k、B 是 k×n、C 是 m×n。transA：A 以 k×m 儲存；transB：B 以 n×k 儲存。\nconst MR = 4, NR = 8;\n// KC=64：f32 微核心在每個 KC 區塊內累加，區塊越長誤差越大（K=512 時 KC=256 誤差 1.26e-5，超過 1e-5；KC=64 為 6.5e-6）。\nconst DEF_MC = 96, DEF_KC = 64, DEF_NC = 512;\n\nfunction gemmPacked(A, B, m, k, n, opts) {\n  const o = typeof opts === 'boolean' ? { transB: opts } : (opts || {});\n  const transA = !!o.transA, transB = !!o.transB;\n  const MC = o.MC || DEF_MC, KC = o.KC || DEF_KC, NC = o.NC || DEF_NC;\n  const C = new Float32Array(m * n);\n  if (m === 0 || n === 0 || k === 0) return C;\n  const acc = new Float64Array(MR * NR);\n  const Ap = new Float32Array(Math.ceil(MC / MR) * MR * KC);\n  const Bp = new Float32Array(Math.ceil(NC / NR) * NR * KC);\n  for (let jc = 0; jc < n; jc += NC) {\n    const nc = Math.min(NC, n - jc);\n    for (let pc = 0; pc < k; pc += KC) {\n      const kc = Math.min(KC, k - pc);\n      packB(B, transB, n, k, pc, kc, jc, nc, Bp);\n      for (let ic = 0; ic < m; ic += MC) {\n        const mc = Math.min(MC, m - ic);\n        packA(A, transA, m, k, ic, mc, pc, kc, Ap);\n        macro(Ap, Bp, C, n, ic, jc, mc, nc, kc, acc);\n      }\n    }\n  }\n  return C;\n}\n\n// 打包 A 的 mc×kc 區塊：面板 ir（MR 列）內依 p 連續存放 MR 個值；不足 MR 的列補 0。\nfunction packA(A, transA, m, k, ic, mc, pc, kc, Ap) {\n  let w = 0;\n  for (let ir = 0; ir < mc; ir += MR) {\n    const mr = Math.min(MR, mc - ir);\n    for (let p = 0; p < kc; p++) {\n      for (let i = 0; i < MR; i++) {\n        if (i < mr) {\n          const row = ic + ir + i, col = pc + p;\n          Ap[w++] = transA ? A[col * m + row] : A[row * k + col];\n        } else Ap[w++] = 0;\n      }\n    }\n  }\n}\n\n// 打包 B 的 kc×nc 區塊：面板 jr（NR 欄）內依 p 連續存放 NR 個值；不足 NR 的欄補 0。\nfunction packB(B, transB, n, k, pc, kc, jc, nc, Bp) {\n  let w = 0;\n  for (let jr = 0; jr < nc; jr += NR) {\n    const nr = Math.min(NR, nc - jr);\n    for (let p = 0; p < kc; p++) {\n      for (let j = 0; j < NR; j++) {\n        if (j < nr) {\n          const col = jc + jr + j, row = pc + p;\n          Bp[w++] = transB ? B[col * k + row] : B[row * n + col];\n        } else Bp[w++] = 0;\n      }\n    }\n  }\n}\n\nfunction macro(Ap, Bp, C, ldc, ic, jc, mc, nc, kc, acc) {\n  for (let jr = 0; jr < nc; jr += NR) {\n    const nr = Math.min(NR, nc - jr);\n    const bOff = (jr / NR) * NR * kc;\n    for (let ir = 0; ir < mc; ir += MR) {\n      const mr = Math.min(MR, mc - ir);\n      const aOff = (ir / MR) * MR * kc;\n      micro(kc, Ap, aOff, Bp, bOff, acc);\n      const cBase = (ic + ir) * ldc + (jc + jr);\n      for (let i = 0; i < mr; i++) {\n        for (let j = 0; j < nr; j++) C[cBase + i * ldc + j] += acc[i * NR + j];\n      }\n    }\n  }\n}\n\n// 微核心：MR×NR 個 double 累加器，沿 kc 連續讀兩個打包面板。\nfunction micro(kc, Ap, aOff, Bp, bOff, acc) {\n  for (let t = 0; t < MR * NR; t++) acc[t] = 0;\n  for (let p = 0; p < kc; p++) {\n    const a = aOff + p * MR, b = bOff + p * NR;\n    for (let i = 0; i < MR; i++) {\n      const av = Ap[a + i];\n      const r = i * NR;\n      for (let j = 0; j < NR; j++) acc[r + j] += av * Bp[b + j];\n    }\n  }\n}\n\n// 參考：朴素三重迴圈，雙精度累加（只用於交叉驗證）\nfunction gemmNaive(A, B, m, k, n, opts) {\n  const o = typeof opts === 'boolean' ? { transB: opts } : (opts || {});\n  const transA = !!o.transA, transB = !!o.transB;\n  const C = new Float64Array(m * n);\n  for (let i = 0; i < m; i++) for (let j = 0; j < n; j++) {\n    let s = 0;\n    for (let p = 0; p < k; p++) {\n      const av = transA ? A[p * m + i] : A[i * k + p];\n      const bv = transB ? B[j * k + p] : B[p * n + j];\n      s += av * bv;\n    }\n    C[i * n + j] = s;\n  }\n  return C;\n}\n\n// WASM SIMD 版：同樣的分塊與打包，但面板直接寫在 wasm 線性記憶體裡，微核心由 cpu_gemm_wasm.js 提供（沒有每次呼叫的拷貝）。\n// 不支援 SIMD 時拋錯；呼叫端應先用 simdSupported() 判斷。\nfunction simdSupported() { return require('./cpu_gemm_wasm.js').simdSupported(); }\nfunction gemmPackedSimd(A, B, m, k, n, opts) {\n  const W = require('./cpu_gemm_wasm.js');\n  const o = typeof opts === 'boolean' ? { transB: opts } : (opts || {});\n  const transA = !!o.transA, transB = !!o.transB;\n  const MC = o.MC || DEF_MC, KC = o.KC || DEF_KC, NC = o.NC || DEF_NC;\n  const Cacc = new Float64Array(m * n);   // 跨區塊累加用 f64（每個 KC 區塊的部分和只在 f32 內算一次，不逐區塊捨入到 f32）\n  if (m === 0 || n === 0 || k === 0) return new Float32Array(m * n);\n  const apBytes = Math.ceil(MC / MR) * MR * KC * 4;\n  const bpBytes = Math.ceil(NC / NR) * NR * KC * 4;\n  const outOff = apBytes + bpBytes;\n  const { mk, memory } = W.getKernel(outOff + 128);\n  const f32 = new Float32Array(memory.buffer);               // 在 getKernel 之後才取，記憶體可能已放大\n  const Ap = f32.subarray(0, apBytes / 4);\n  const Bp = f32.subarray(apBytes / 4, (apBytes + bpBytes) / 4);\n  const out = f32.subarray(outOff / 4, outOff / 4 + 32);\n  // 可選的計時（評估用）：timing 物件會累加 packBMs、packAMs、computeMs、blocksReused、calls。預設不計時。\n  const T = o.timing || null;\n  const now = () => (typeof performance !== 'undefined' ? performance : Date).now();\n  // 可選的 B 打包快取（opt-in：cacheB === true）：同一個 B 物件的打包區塊只打包一次。呼叫端承諾呼叫之間不改動 B。\n  const bc = o.cacheB === true ? packedBCacheFor(B, transB, k, n, KC, NC) : null;\n  for (let jc = 0; jc < n; jc += NC) {\n    const nc = Math.min(NC, n - jc);\n    for (let pc = 0; pc < k; pc += KC) {\n      const kc = Math.min(KC, k - pc);\n      const key = jc + ',' + pc;\n      const len = Math.ceil(nc / NR) * NR * kc;\n      if (bc && bc.blocks.has(key)) {\n        Bp.set(bc.blocks.get(key));\n        if (T) T.blocksReused = (T.blocksReused || 0) + 1;\n      } else {\n        const t0 = T ? now() : 0;\n        packB(B, transB, n, k, pc, kc, jc, nc, Bp);\n        if (T) T.packBMs = (T.packBMs || 0) + (now() - t0);\n        if (bc) bc.blocks.set(key, Bp.slice(0, len));\n      }\n      for (let ic = 0; ic < m; ic += MC) {\n        const mc = Math.min(MC, m - ic);\n        const ta = T ? now() : 0;\n        packA(A, transA, m, k, ic, mc, pc, kc, Ap);\n        if (T) T.packAMs = (T.packAMs || 0) + (now() - ta);\n        const tc = T ? now() : 0;\n        for (let jr = 0; jr < nc; jr += NR) {\n          const nr = Math.min(NR, nc - jr);\n          const bOff = apBytes + (jr / NR) * NR * kc * 4;\n          for (let ir = 0; ir < mc; ir += MR) {\n            const mr = Math.min(MR, mc - ir);\n            const aOff = (ir / MR) * MR * kc * 4;\n            mk(kc, aOff, bOff, outOff);\n            const cBase = (ic + ir) * n + (jc + jr);\n            for (let i = 0; i < mr; i++) for (let j = 0; j < nr; j++) Cacc[cBase + i * n + j] += out[i * NR + j];\n          }\n        }\n        if (T) T.computeMs = (T.computeMs || 0) + (now() - tc);\n      }\n    }\n  }\n  if (T) T.calls = (T.calls || 0) + 1;\n  return Float32Array.from(Cacc);\n}\n\n// 每個 B 物件一份打包快取（WeakMap，B 被回收就一起回收）；鍵含轉置與尺寸與分塊參數，任一不同就是另一份。\nconst PACKED_B = new WeakMap();\nfunction packedBCacheFor(B, transB, k, n, KC, NC) {\n  const sig = [transB ? 1 : 0, k, n, KC, NC].join('|');\n  let byB = PACKED_B.get(B);\n  if (!byB || byB.sig !== sig) { byB = { sig, blocks: new Map() }; PACKED_B.set(B, byB); }\n  return byB;\n}\n\n// 原地轉置（只在 opts.inplace === true 時使用；預設絕不改動呼叫端輸入）。\n// X 是 rows×cols 的行主序陣列；轉置後 X 變成 cols×rows 的行主序（同一塊記憶體）。\n// 方陣：兩兩交換（對稱位置），不需額外記憶體。非方陣：循環跟隨（元素 i 去 i·rows mod (N−1)），\n// 用位元組陣列記錄已搬過的位置，額外記憶體約 N/8 位元組（N = rows·cols），時間 O(N)。\nfunction transposeInPlace(X, rows, cols) {\n  if (X.length < rows * cols) throw new Error('transposeInPlace：陣列長度不足');\n  if (rows === cols) {\n    for (let i = 0; i < rows; i++) for (let j = i + 1; j < cols; j++) {\n      const t = X[i * cols + j]; X[i * cols + j] = X[j * cols + i]; X[j * cols + i] = t;\n    }\n    return X;\n  }\n  const N = rows * cols;\n  if (N <= 1) return X;\n  const seen = new Uint8Array(Math.ceil(N / 8));\n  const mark = (p) => { seen[p >> 3] |= (1 << (p & 7)); };\n  const isMarked = (p) => (seen[p >> 3] & (1 << (p & 7))) !== 0;\n  for (let start = 1; start < N - 1; start++) {\n    if (isMarked(start)) continue;\n    let cur = start, carry = X[start];\n    do {\n      const next = (cur * rows) % (N - 1);\n      const tmp = X[next]; X[next] = carry; carry = tmp;\n      mark(cur);\n      cur = next;\n    } while (cur !== start);\n    mark(start);\n  }\n  return X;\n}\n\n// 含 inplace 選項的 GEMM：inplace 為 true 且 transA／transB 時，先在呼叫端的陣列上原地轉置，再用不轉置的核心算。\n// 注意：這會「改動」呼叫端的 A／B（轉置後的內容），呼叫端必須接受這點；預設（沒給 inplace）完全不改動輸入，走打包時轉置。\nfunction gemmWithOptions(A, B, m, k, n, opts) {\n  const o = opts || {};\n  if (o.inplace === true) {\n    let Aw = A, Bw = B, tA = !!o.transA, tB = !!o.transB;\n    if (tA) { transposeInPlace(A, k, m); tA = false; }   // A 以 k×m 儲存 → 轉成 m×k\n    if (tB) { transposeInPlace(B, n, k); tB = false; }   // B 以 n×k 儲存 → 轉成 k×n\n    return