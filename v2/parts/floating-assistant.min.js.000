ton.textContent = '❐';\n    }\n  }\n\n  // ---- theme and shortcuts (window-level look and keys; the bridge validated every value) ----\n  var KEY_NAMES = { ' ': 'Space', Enter: 'Enter', Escape: 'Esc', ArrowUp: 'Up', ArrowDown: 'Down', ArrowLeft: 'Left', ArrowRight: 'Right', Delete: 'Delete', Backspace: 'Backspace', Tab: 'Tab' };\n  // a keydown as the bridge's shortcut text: Ctrl+Shift+Alt+<key> (Cmd counts as Ctrl); null for a key with no name\n  function shortcutKey(e) {\n    var key = String(e.key || '');\n    var name = KEY_NAMES[key] || (/^F([1-9]|1[0-2])$/.test(key) ? key : (key.length === 1 ? key.toUpperCase() : null));\n    if (!name) { return null; }\n    return ((e.ctrlKey || e.metaKey) ? 'Ctrl+' : '') + (e.shiftKey ? 'Shift+' : '') + (e.altKey ? 'Alt+' : '') + name;\n  }\n  // black or white, whichever reads better on the color (#rgb or #rrggbb)\n  function textOn(color) {\n    var h = String(color).replace('#', '');\n    if (h.length === 3) { h = h.charAt(0) + h.charAt(0) + h.charAt(1) + h.charAt(1) + h.charAt(2) + h.charAt(2); }\n    var r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);\n    return (0.299 * r + 0.587 * g + 0.114 * b) > 150 ? '#000000' : '#ffffff';\n  }\n  function allNodes(el, out) {\n    out = out || [];\n    // a real DOM's children is an HTMLCollection (no forEach): copy it into an array first\n    Array.prototype.slice.call(el.children || []).forEach(function (c) { out.push(c); allNodes(c, out); });\n    return out;\n  }\n  // Paints a window with its theme: { palette:{bg,fg,accent,danger,muted}, font, size, radius, density }. Called after the window's own style is set\n  // (the host replaces the whole style text), and safe to call with no theme. The stylesheet (GUI_CSS) derives surfaces, borders and hover states\n  // from the palette variables, so this only sets the variables, the scheme (dark or light text colors for the code editor) and a few basics.\n  var FONT_VARS = { 'sans-serif': 'var(--gui-sans)', serif: 'var(--gui-serif)', monospace: 'var(--gui-mono)' };\n  function isDark(color) {\n    var h = String(color).replace('#', '');\n    if (h.length === 3) { h = h.charAt(0) + h.charAt(0) + h.charAt(1) + h.charAt(1) + h.charAt(2) + h.charAt(2); }\n    var r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);\n    return (0.299 * r + 0.587 * g + 0.114 * b) < 128;\n  }\n  function applyTheme(win, theme) {\n    if (!win || !win.style || !theme || !Object.keys(theme).length) { return; }\n    var p = theme.palette || {}, st = win.style;\n    function v(name, value) { if (st.setProperty) { st.setProperty(name, value); } else { st[name] = value; } }\n    Object.keys(p).forEach(function (k) { v('--gui-' + k, p[k]); });\n    if (p.accent) { v('--gui-on-accent', textOn(p.accent)); }\n    if (p.bg) { st.background = p.bg; if (win.setAttribute) { win.setAttribute('data-scheme', isDark(p.bg) ? 'dark' : 'light'); } }\n    if (p.fg) { st.color = p.fg; }\n    if (theme.font) { v('--gui-font', FONT_VARS[theme.font] || theme.font); st.fontFamily = FONT_VARS[theme.font] || theme.font; }\n    if (theme.size) { st.fontSize = theme.size + 'px'; v('--gui-fs', theme.size + 'px'); }\n    if (theme.radius !== undefined) { v('--gui-radius', theme.radius + 'px'); }\n    if (theme.density && win.setAttribute) { win.setAttribute('data-density', theme.density); }\n  }\n\n  // keys the window answers: shortcuts is { 'Ctrl+S': 'save' }. A key with no Ctrl or Alt is ignored while typing in a text box.\n  function bindShortcuts(win, shortcuts, onEvent) {\n    var names = shortcuts || {};\n    if (!Object.keys(names).length) { return; }\n    win.tabIndex = -1; // a click into the window focuses it, so its keys arrive here\n    win.addEventListener('keydown', function (e) {\n      var combo = shortcutKey(e);\n      if (!combo || !Object.prototype.hasOwnProperty.call(names, combo)) { return; }\n      var tag = String((e.target && e.target.tagName) || '').toLowerCase();\n      if ((tag === 'input' || tag === 'textarea' || tag === 'select') && !/Ctrl\\+|Alt\\+/.test(combo)) { return; }\n      if (e.preventDefault) { e.preventDefault(); }\n      onEvent('shortcut', 'root', names[combo]);\n    });\n  }\n\n  // snapshot = { id, title, width, resizable, maximizable, theme, shortcuts, root }; onEvent(name, nodeId, value) is called for user actions in the window;\n  // opts (optional) = { image(nodeId, name) } for the pictures of the canvases\n  var CONTROL_BUTTON_CSS = 'border:none;background:transparent;cursor:pointer;font:inherit;font-size:15px;line-height:1;padding:3px 9px;border-radius:5px;color:inherit;';\n  function renderWindow(doc, snap, onEvent, onClose, opts) {\n    var win = doc.createElement('div');\n    ensureStyles(doc);\n    win.className = 'gui-window';\n    win.setAttribute('data-window', snap.id);\n    win.style.width = snap.width + 'px';\n    var bar = doc.createElement('div');\n    bar.className = 'gui-titlebar';\n    // the title on the left, the control buttons on the right (close last), like any desktop window\n    var title = doc.createElement('span');\n    title.textContent = snap.title;\n    title.style.cssText = 'flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';\n    var close = doc.createElement('button');\n    close.type = 'button';\n    close.className = 'gui-close';\n    close.textContent = '×';\n    close.style.cssText = CONTROL_BUTTON_CSS;\n    close.addEventListener('click', function () { onClose(); });\n    bar.appendChild(title);\n    if (snap.maximizable) {\n      var max = doc.createElement('button');\n      max.type = 'button';\n      max.className = 'gui-maximize';\n      max.textContent = '□';\n      max.style.cssText = CONTROL_BUTTON_CSS;\n      max.addEventListener('click', function () { toggleMaximize(win, max); });\n      bar.appendChild(max);\n    }\n    bar.appendChild(close);\n    win.appendChild(bar);\n    var body = renderNode(doc, Object.assign({}, snap.root, { id: 'root' }), onEvent, Object.assign({}, opts || {}, { resizable: !!snap.resizable }));\n    if (snap.resizable) {\n      // the window can be dragged bigger at its corner: the body takes the rest of the height, and its canvases fill it\n      win.setAttribute('data-resizable', '1');\n    }\n    body.className = (body.className ? body.className + ' ' : '') + 'gui-body';\n    win.appendChild(body);\n    bindShortcuts(win, snap.shortcuts, onEvent);\n    applyTheme(win, snap.theme); // the host sets the window's own style text afterwards and calls applyTheme again\n    return win;\n  }\n\n  return { patchNode: patchNode, GUI_CSS: GUI_CSS, tokenizeLine: tokenizeLine, isDark: isDark, CONTROL_BUTTON_CSS: CONTROL_BUTTON_CSS, renderWindow: renderWindow, paintFrame: paintFrame, applyTheme: applyTheme, shortcutKey: shortcutKey, textOn: textOn };\n}));\n",FA_GUI_ZENITY_SRC="// zenity-compatible dialogs for the terminal (pure, no DOM): `zenity --info|--question|--entry|--password|--list|--checklist|--radiolist|--progress ...`\n// so scripts written for zenity (winetricks, for one) run unchanged on the bridge. A dialog is a skill window (AiChatGuiBridge messages),\n// and the answer comes back the way zenity prints it: the text on stdout and an exit code (0 OK, 1 Cancel or closed, 5 timeout).\n// The terminal drives it: parse(words) -> build(parsed, winId) gives the window messages to apply; start(parsed) gives the answer state;\n// onEvent(parsed, state, event) returns null while waiting or {exit_code, stdout} when the dialog is answered.\n//\n// Limits on purpose (see DESIGN.skill-gui-bridge.md): --progress shows the bar and returns at once (it does not read stdin, and a\n// virtual command cannot sit in a pipe); --file-selection, --calendar, --scale, --notification, --forms and friends are refused with\n// exit 1 and a clear message. Row values with the same visible text in a --list are matched by their first occurrence.\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatZenity = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n\n  var MODES = { info: true, warning: true, error: true, question: true, entry: true, password: true, progress: true };\n  var UNSUPPORTED = ['file-selection', 'calendar', 'scale', 'notification', 'color-selection', 'forms', 'text-info', 'about', 'password-dialog'];\n  var VALUE_OPTS = { title: true, text: true, width: true, height: true, timeout: true, 'ok-label': true, 'cancel-label': true, 'entry-text': true,\n    column: true, 'hide-column': true, 'print-column': true, separator: true, percentage: true, 'window-icon': true, 'icon-name': true };\n  var FLAG_OPTS = { 'auto-close': true, pulsate: true, multiple: true, 'no-wrap': true, 'no-markup': true, ellipsize: true, modal: true,\n    'hide-header': true, editable: true, 'hide-text': true, 'default-cancel': true };\n  var MAX_ROWS = 150;   // one checkbox or list item per row; the bridge allows 200 nodes per window\n  var DEFAULT_TITLE = { info: 'Information', warning: 'Warning', error: 'Error', question: 'Question', entry: 'Enter a value', password: 'Enter password', progress: 'Progress', list: 'Select', checklist: 'Select', radiolist: 'Select' };\n\n  function fail(error) { return { ok: false, error: error }; }\n  function num(v, name, lo, hi, dflt) {\n    if (v === undefined) { return dflt; }\n    var n = parseFloat(v);\n    if (!isFinite(n)) { throw new Error('--' + name + ' needs a number'); }\n    return Math.min(hi, Math.max(lo, n));\n  }\n  function isListMode(mode) { return mode === 'list' || mode === 'checklist' || mode === 'radiolist'; }\n\n  // zenity's own argument form: `--name value`, `--name=value`, flags as `--name`. Words that do not start with -- are rows for --list.\n  function parse(words) {\n    var mode = null, listSeen = false, variant = null, opts = { columns: [] }, positional = [], error = null;\n    try {\n      for (var i = 0; i < words.length; i++) {\n        var w = String(words[i]);\n        if (w.indexOf('--') !== 0) { positional.push(w); continue; }\n        var name = w.slice(2), value = null, eq = name.indexOf('=');\n        if (eq !== -1) { value = name.slice(eq + 1); name = name.slice(0, eq); }\n        if (UNSUPPORTED.indexOf(name) !== -1) { return fail('--' + name + ' is not supported by the bridge (use the GUI bridge directly for that)'); }\n        if (MODES.hasOwnProperty(name)) {\n          if (mode && mode !== name) { return fail('only one dialog type can be given'); }\n          mode = name;\n          continue;\n        }\n        if (name === 'list') { listSeen = true; continue; }\n        if (name === 'checklist' || name === 'radiolist') { listSeen = true; variant = name; continue; }\n        if (VALUE_OPTS.hasOwnProperty(name)) {\n          if (value === null) {\n            if (i + 1 >= words.length) { return fail('--' + name + ' needs a value'); }\n            value = String(words[++i]);\n          }\n          if (name === 'column') { opts.columns.push(value); } else { opts[name] = value; }\n          continue;\n        }\n        if (FLAG_OPTS.hasOwnProperty(name)) { opts[name] = true; continue; }\n        return fail('unknown option --' + name);\n      }\n    } catch (e) {\n      return fail(e.message || String(e));\n    }\n    if (listSeen) {\n      if (mode) { return fail('a list cannot be combined with --' + mode); }\n      mode = variant || 'list';\n    }\n    if (!mode) { return fail('pick a dialog: --info, --warning, --error, --question, --entry, --password, --list, --checklist, --radiolist or --progress'); }\n\n    var out = { ok: true, mode: mode, opts: opts, title: opts.title !== undefined ? opts.title : DEFAULT_TITLE[mode] };\n    try {\n      out.width = num(opts.width, 'width', 160, 1200, 420);\n      out.timeout = num(opts.timeout, 'timeout', 0, 300, 0);      // 0 = no timeout\n      out.percentage = num(opts.percentage, 'percentage', 0, 100, 0);\n    } catch (e) { return fail(e.message); }\n    if (opts.separator === undefined) { out.separator = '|'; } else { out.separator = opts.separator; }\n\n    if (isListMode(mode)) {\n      var n = opts.columns.length;\n      if (!n) { return fail('--' + mode + ' needs at least one --column'); }\n      if (positional.length % n !== 0) { return fail('rows must come in groups of ' + n + ' values (one per --column)'); }\n      var rowCount = positional.length / n;\n      if (rowCount > MAX_ROWS) { return fail('at most ' + MAX_ROWS + ' rows'); }\n      out.rows = [];\n      for (var r = 0; r < rowCount; r++) { out.rows.push(positional.slice(r * n, r * n + n)); }\n      out.flagged = mode === 'checklist' || mode === 'radiolist';     // first column is TRUE/FALSE\n      if (out.flagged) {\n        for (var k = 0; k < out.rows.length; k++) {\n          if (out.rows[k][0] !== 'TRUE' && out.rows[k][0] !== 'FALSE') { return fail('row ' + (k + 1) + ': the first column must be TRUE or FALSE'); }\n        }\n      }\n      out.multiple = mode === 'checklist' || !!opts.multiple;\n      out.hideColumn = opts['hide-column'] !== undefined ? parseInt(opts['hide-column'], 10) : null;\n      out.printColumn = opts['print-column'] !== undefined ? parseInt(opts['print-column'], 10) : (out.flagged ? 2 : 1);\n      if (!(out.printColumn >= 1 && out.printColumn <= n)) { return fail('--print-column must be between 1 and ' + n); }\n      if (out.hideColumn !== null && !(out.hideColumn >= 1 && out.hideColumn <= n)) { return fail('--hide-column must be between 1 and ' + n); }\n      out.displayCols = [];\n      for (var c = 0; c < n; c++) {\n        if (out.flagged && c === 0) { continue; }\n        if (out.hideColumn === c + 1) { continue; }\n        out.displayCols.push(c);\n      }\n      out.labels = out.rows.map(function (row) { return out.displayCols.map(function (c) { return row[c]; }).join(' | '); });\n    } else if (positional.length) {\n      out.text = positional.join(' ');\n    }\n    return out;\n  }\n\n  // The window for the dialog, as AiChatGuiBridge messages (without \"v\"). Node ids: msg, val (entry), pick (list), c0.. (checkboxes), bar, ok, cancel.\n  function build(parsed, winId) {\n    var o = parsed.opts, mode = parsed.mode, msgs = [];\n    var text = o.text !== undefined ? o.text : (parsed.text || '');\n    msgs.push({ op: 'open', id: winId, title: parsed.title || '', width: parsed.width });\n    msgs.push({ op: 'add', id: winId, node: { id: 'msg', kind: 'label', text: text } });\n    function add(node, parent) { msgs.push({ op: 'add', id: winId, parent: parent || 'root', node: node }); }\n    function buttons() {\n      var row = { id: 'buttons', kind: 'row' };\n      add(row);\n      add({ id: 'ok', kind: 'button', text: o['ok-label'] || 'OK' }, 'buttons');\n      if (mode !== 'info' && mode !== 'warning' && mode !== 'error' && mode !== 'progress') {\n        add({ id: 'cancel', kind: 'button', text: o['cancel-label'] || 'Cancel' }, 'buttons');\n      }\n    }\n    if (mode === 'progress') {\n      add({ id: 'bar', kind: 'progress', value: parsed.opts.pulsate ? 0 : parsed.percentage, max: 100 });\n    } else if (mode === 'entry' || mode === 'password') {\n      add({ id: 'val', kind: 'entry', value: o['entry-text'] !== undefined ? o['entry-text'] : '', secret: mode === 'password' || !!o['hide-text'] });\n      buttons();\n    } else if (isListMode(mode)) {\n      if (parsed.multiple) {\n        parsed.labels.forEach(function (label, i) {\n          add({ id: 'c' + i, kind: 'checkbox', text: label, checked: parsed.flagged ? parsed.rows[i][0] === 'TRUE' : false });\n        });\n      } else {\n        var pick = { id: 'pick', kind: 'list', items: parsed.labels };\n        var preset = parsed.flagged ? parsed.rows.findIndex(function (row) { return row[0] === 'TRUE'; }) : -1;\n        if (preset >= 0) { pick.selected = parsed.labels[preset]; }\n        add(pick);\n      }\n      buttons();\n    } else {\n      buttons();\n    }\n    return msgs;\n  }\n\n  // The answer state for a dialog, before any event.\n  function start(parsed) {\n    var st = { value: parsed.opts['entry-text'] !== undefined ? parsed.opts['entry-text'] : '', selected: -1, checked: [] };\n    if (isListMode(parsed.mode)) {\n      st.checked = parsed.rows.map(function (row) { return parsed.flagged && row[0] === 'TRUE'; });\n      if (!parsed.multiple) { st.selected = parsed.flagged ? parsed.rows.findIndex(function (row) { return row[0] === 'TRUE'; }) : -1; }\n    }\n    return st;\n  }\n\n  function printed(parsed, index) { return parsed.rows[index][parsed.printColumn - 1]; }\n\n  // One event from the window (the parsed JSON of a bridge event line). Returns null while the dialog is open, or {exit_code, stdout}.\n  function onEvent(parsed, st, ev) {\n    if (!ev) { return null; }\n    if (ev.event === 'close') { return { exit_code: 1, stdout: '' }; }\n    if (ev.event === 'input' && ev.node === 'val') { st.value = String(ev.value); return null; }\n    if (ev.event === 'change' && /^c\\d+$/.test(ev.node)) { st.checked[parseInt(ev.node.slice(1), 10)] = !!ev.value; return null; }\n    if (ev.event === 'select' && ev.node === 'pick') { st.selected = parsed.labels.indexOf(String(ev.value)); return null; }\n    if (ev.event !== 'click') { return null; }\n    if (ev.node === 'cancel') { return { exit_code: 1, stdout: '' }; }\n    if (ev.node !== 'ok') { return null; }\n    var mode = parsed.mode;\n    if (mode === 'entry' || mode === 'password') { return { exit_code: 0, stdout: st.value + '\\n' }; }\n    if (mode === 'info' || mode === 'warning' || mode === 'error' || mode === 'question' || mode === 'progress') { return { exit_code: 0, stdout: '' }; }\n    if (parsed.multiple) {\n      var picked = [];\n      st.checked.forEach(function (on, i) { if (on) { picked.push(printed(parsed, i)); } });\n      return { exit_code: 0, stdout: picked.length ? picked.join(parsed.separator) + '\\n' : '' };\n    }\n    if (st.selected < 0) { return { exit_code: 1, stdout: '' }; }\n    return { exit_code: 0, stdout: printed(parsed, st.selected) + '\\n' };\n  }\n\n  // --progress does not wait for its window (no stdin in this version): the terminal opens the window and returns exit 0 at once.\n  function immediate(parsed) { return parsed.mode === 'progress' ? { exit_code: 0, stdout: '' } : null; }\n\n  return { parse: parse, build: build, start: start, onEvent: onEvent, immediate: immediate, MAX_ROWS: MAX_ROWS };\n}));\n",FA_GUI_HOST_SRC="// GUI 視窗主機：擁有一個終端機 session 的所有 GUI 視窗（開、關、重繪、事件佇列）。\n// 協定由 AiChatGuiBridge 檢查（上限 4 視窗、每視窗節點數等）；畫面由 AiChatGuiRender 畫進 container 裡的浮層。\n// 這裡不直接碰 DOM 的細節：doc、container、bridge、render 都由呼叫端傳入，所以 node 測試可以用假的 render。\n// 事件先進每視窗的佇列（上限 50）：frame 只留最新一個，連續的 mouse move 合併成一個。\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatGuiHost = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n  var QUEUE_MAX = 50;\n\n  // opts: { doc, container, bridge, render, onClosed(winId), decorate(el, {id, title, bar, minW, minH, floating, onChange}) -> controller or null }\n  // decorate (optional) is the app's window shell (FaWin: popped window, drag, edge resize, maximize over the whole page). It is used for windows that\n  // asked to be resizable or maximizable; a window the shell cannot decorate keeps the plain resize corner and the renderer's own maximize button.\n  function createHost(opts) {\n    var doc = opts.doc, container = opts.container, bridge = opts.bridge, render = opts.render;\n    var session = bridge.createSession();\n    var layer = null, views = {}, queues = {}, waiters = {}, pictures = {}, shells = {};\n\n    function ensureLayer() {\n      if (!layer) {\n        layer = doc.createElement('div');\n        layer.className = 'ai-gui-layer';\n        if (layer.style) { layer.style.cssText = 'position:absolute;left:0;top:0;right:0;bottom:0;overflow:auto;pointer-events:none;'; }\n        container.appendChild(layer);\n      }\n      return layer;\n    }\n\n    // one event line from the page, queued for the window (frame and mouse move are merged)\n    function enqueue(winId, name, line) {\n      var q = queues[winId] || (queues[winId] = []);\n      var move = name === 'mouse' && /\"kind\":\"move\"/.test(line);\n      if (name === 'frame' || name === 'caret') { for (var i = q.length - 1; i >= 0; i--) { if (q[i].name === name && (name === 'frame' || q[i].node === nodeOf(line))) { q.splice(i, 1); } } }\n      else if (move && q.length && q[q.length - 1].move) { q.pop(); }\n      q.push({ name: name, line: line, move: move, node: name === 'caret' ? nodeOf(line) : null });\n      if (q.length > QUEUE_MAX) { q.shift(); }\n      var w = waiters[winId];\n      if (w && q.length) { delete waiters[winId]; w(take(winId)); }\n    }\n    function nodeOf(line) { try { return JSON.parse(line).node; } catch (e) { return null; } }\n    function take(winId) { var q = queues[winId] || []; return q.length ? q.shift().line : null; }\n\n    function onEventFor(winId) {\n      return function (name, nodeId, value) {\n        var line = bridge.eventLine(session, winId, nodeId, name, value);\n        if (line) { enqueue(winId, name, line); }\n      };\n    }\n\n    // pictures: the decoded Image for a canvas picture name (created once from the checked data URL)\n    function picture(winId, nodeId, name) {\n      var win = session.windows[winId], node = win && win.nodes[nodeId];\n      var data = node && node.images && node.images[name];\n      if (!data) { return null; }\n      var key = winId + '/' + nodeId + '/' + name;\n      if (!pictures[key] || pictures[key].src !== data) {\n        var img = new (doc.defaultView || root).Image();\n        img.src = data;\n        img.onload = function () { repaintCanvas(winId, nodeId); };\n        pictures[key] = img;\n      }\n      return pictures[key].complete ? pictures[key] : null;\n    }\n\n    function removeView(winId) {\n      var v = views[winId];\n      if (shells[winId]) { try { shells[winId].destroy(); } catch (e) { /* the shell is gone with the window */ } delete shells[winId]; }\n      if (v && v.parentNode) { v.parentNode.removeChild(v); }\n      delete views[winId];\n    }\n\n    function show(winId) {\n      var snap = bridge.snapshot(session, winId);\n      if (!snap) { return; }\n      var old = views[winId];\n      var wasActive = !!(old && old.classList && old.classList.contains('ai-chat-wheel-on'));\n      var wasPopped = !!(shells[winId] && shells[winId].isPopped());\n      // 視窗外殼（可縮放、可最大化的視窗）的位置與大小也要保留：外殼是套在同一個元素上，所以樣式還在 old.style 裡\n      var prev = old && old.style ? {\n        left: old.style.left, top: old.style.top, width: old.style.width, height: old.style.height, maxWidth: old.style.maxWidth,\n        resized: !!(old.style.height || (old.getAttribute && old.getAttribute('data-saved'))),\n        saved: old.getAttribute ? old.getAttribute('data-saved') : null\n      } : null;\n      removeView(winId);\n      var view = render.renderWindow(doc, snap, onEventFor(winId), function () { closeByUser(winId); }, {\n        image: function (nodeId, name) { return picture(winId, nodeId, name); }\n      });\n      views[winId] = view;\n      // the canvas takes the pointer and the wheel only after a click into its window: gui_render.js checks the ai-chat-wheel-on class on\n      // an ancestor. Set it in the capture phase so it is already there when the canvas's own mousedown listener runs, and keep it across\n      // a re-show (add, set) of the same window.\n      if (wasActive) { view.classList.add('ai-chat-wheel-on'); }\n      if (view.addEventListener) { view.addEventListener('mousedown', function () { view.classList.add('ai-chat-wheel-on'); }, true); }\n      // a window sits in the layer at its own spot; pointer events are on again for the window itself\n      if (view.style) {\n        // the look (colors, font, border, shadow) comes from the stylesheet and the window's palette variables (gui_render.js GUI_CSS)\n        view.style.cssText = 'position:absolute;left:12px;top:12px;pointer-events:auto;box-sizing:border-box;width:' + snap.width + 'px;'\n          // a window with a first height keeps it (the body's grow areas fill it); a resizable one: the corner drags (CSS resize), the content never spills out\n          + (snap.height ? 'height:' + snap.height + 'px;' : '')\n          + (snap.resizable ? 'resize:both;overflow:hidden;min-width:200px;min-height:120px;' : '');\n        // a re-show (add, set) keeps the place and size the user gave the window, and a maximized window stays maximized\n        if (prev) {\n          if (prev.left) { view.style.left = prev.left; }\n          if (prev.top) { view.style.top = prev.top; }\n          if (prev.resized) { view.style.width = prev.width; view.style.height = prev.height; }\n          if (prev.maxWidth) { view.style.maxWidth = prev.maxWidth; }\n          if (prev.saved) {\n            view.setAttribute('data-saved', prev.saved);\n            var mb = view.querySelector && view.querySelector('.gui-maximize');\n            if (mb) { mb.textContent = '❐'; }\n          }\n        }\n      }\n      // the window's own style text replaced the theme's colors above: put the theme back\n      if (render.applyTheme) { render.applyTheme(view, snap.theme); }\n      ensureLayer().appendChild(view);\n      if (opts.decorate && (snap.resizable || snap.maximizable)) {\n        var bar = view.querySelector && view.querySelector('.gui-titlebar');\n        var ctl = null;\n        try {\n          ctl = opts.decorate(view, {\n            id: 'gui-' + snap.title, title: snap.title, bar: bar, minW: 240, minH: 160, floating: wasPopped,\n            // a popped window has the shell's own edge handles: the CSS corner would double them\n            onChange: function (st) { if (view.style) { view.style.resize = st.popped ? 'none' : (snap.resizable ? 'both' : ''); } }\n          });\n        } catch (e) { ctl = null; }\n        if (ctl) {\n          shells[winId] = ctl;\n          // the shell appended its buttons after the close button: style them like the others and put the close button last (right edge)\n          if (bar && bar.querySelectorAll) {\n            Array.prototype.forEach.call(bar.querySelectorAll('button'), function (b) { if (!b.style.cssText) { b.style.cssText = render.CONTROL_BUTTON_CSS || ''; } });\n            var cl = bar.querySelector('.gui-close');\n            if (cl) { bar.appendChild(cl); }\n          }\n          // the shell has its own maximize button\n          var own = view.querySelector('.gui-maximize');\n          if (own && own.parentNode) { own.parentNode.removeChild(own); }\n        }\n      }\n    }\n\n    function repaintCanvas(winId, nodeId) {\n      var view = views[winId];\n      var el = view && view.querySelector ? view.querySelector('[data-node=\"' + nodeId + '\"]') : null;\n      var win = session.windows[winId], node = win && win.nodes[nodeId];\n      if (!el || !node || node.kind !== 'canvas') { return; }\n      var ctx = el.getContext ? el.getContext('2d') : null;\n      if (!ctx) { return; }\n      render.paintFrame(ctx, node.frame || [], el.width, el.height, function (name) { return picture(winId, nodeId, name); });\n    }\n\n    function paint(winId) {\n      var win = session.windows[winId];\n      if (!win) { return; }\n      Object.keys(win.nodes).forEach(function (nid) { if (win.nodes[nid].kind === 'canvas') { repaintCanvas(winId, nid); } });\n    }\n\n    // close: removes the window and everything queued for it; the program's wait gets null\n    function close(winId) {\n      if (!session.windows[winId]) { return; }\n      bridge.apply(session, { v: 1, op: 'close', id: winId });\n      teardown(winId);\n    }\n    // the user pressed the window's × : the program must learn it (a \"close\" event, which gui.py's wait and poll return), so the event stays\n    // queued for the program; the window itself is gone at once. A program that waits gets the event now.\n    function closeByUser(winId) {\n      if (!session.windows[winId]) { return; }\n      enqueue(winId, 'close', JSON.stringify({ v: 1, event: 'close', id: winId }));\n      bridge.apply(session, { v: 1, op: 'close', id: winId });\n      removeView(winId);\n      if (opts.onClosed) { opts.onClosed(winId); }\n    }\n    // everything a closed window leaves behind: its view, its queue, a waiting program, and the caller's notice\n    function teardown(winId) {\n      removeView(winId);\n      delete queues[winId];\n      var w = waiters[winId];\n      if (w) { delete waiters[winId]; w(null); }\n      if (opts.onClosed) { opts.onClosed(winId); }\n    }\n\n    // a short beep: opts.tone(freq, ms, wave) when the caller gave one (tests, a native path), else the page's audio. A page that cannot\n    // play (no audio, blocked until a click) just stays silent: a tone never fails the program.\n    var audio = null;\n    function playTone(freq, ms, wave) {\n      try {\n        if (opts.tone) { opts.tone(freq, ms, wave); return; }\n        var view = doc.defaultView || root;\n        var Ctx = view && (view.AudioContext || view.webkitAudioContext);\n        if (!Ctx) { return; }\n        audio = audio || new Ctx();\n        var osc = audio.createOscillator(), gain = audio.createGain();\n        osc.type = wave; osc.frequency.value = freq;\n        gain.gain.value = 0.15;\n        osc.connect(gain); gain.connect(audio.destination);\n        osc.start(); osc.stop(audio.currentTime + ms / 1000);\n      } catch (e) { /* silent */ }\n    }\n\n    // a set of plain props (text, value, enabled, checked, visible, selected ...) changes the one element in place: the user keeps the focus, the\n    // caret and the scroll position of what they are typing in. Anything else (a layout prop, a table's rows, a list's items) rebuilds the window.\n    function patch(msg) {\n      if (!render.patchNode) { return false; }\n      var win = session.windows[msg.id], node = win && win.nodes[msg.node], view = views[msg.id];\n      if (!node || !view || !view.querySelector) { return false; }\n      var el = view.querySelector('[data-node=\"' + msg.node + '\"]');\n      try { return !!(el && render.patchNode(el, node, msg.props)); } catch (e) { return false; }\n    }\n\n    // apply one \"@gui\" line (or an already parsed message). Returns {ok} or {ok:false, error}; never throws.\n    function apply(line) {\n      var parsed = bridge.parseLine(line);\n      if (!parsed) { return { ok: false, error: 'not a GUI line' }; }\n      if (parsed.error) { return { ok: false, error: parsed.error }; }\n      var msg = parsed.msg, result = bridge.apply(session, msg);\n      if (!result.ok) { return result; }\n      if (msg.op === 'open') { show(msg.id); }\n      else if (msg.op === 'close') { teardown(msg.id); }\n      else if (msg.op === 'set') { if (!patch(msg)) { show(msg.id); } }\n      else if (msg.op === 'add' || msg.op === 'remove' || msg.op === 'theme' || msg.op === 'shortcut') { show(msg.id); }\n      else if (msg.op === 'tone') { playTone(msg.freq, msg.ms, msg.wave || 'sine'); }\n      else if (msg.op === 'draw') { paint(msg.id); }\n      else if (msg.op === 'image') { repaintCanvas(msg.id, msg.node); }\n      return { ok: true };\n    }\n\n    // gui wait: resolves with the next event line of the window, or null when the window closes (timeout is the caller's job)\n    function wait(winId) {\n      if (!session.windows[winId]) { return Promise.resolve(null); }\n      if (queues[winId] && queues[winId].length) { return Promise.resolve(take(winId)); }\n      return new Promise(function (resolve) { waiters[winId] = resolve; });\n    }\n\n    function poll(winId) { return take(winId); }\n\n    function isOpen(winId) { return !!session.windows[winId]; }\n\n    // closeAll: closes every window of this session (the AI path does this when a GUI program hits its time limit and nobody can close it)\n    function closeAll() { Object.keys(session.windows).forEach(close); }\n\n    // the window's current snapshot (for tests and for the caller's own checks)\n    function snapshot(winId) { return bridge.snapshot(session, winId); }\n\n    return { apply: apply, wait: wait, poll: poll, close: close, closeAll: closeAll, paint: paint, isOpen: isOpen, snapshot: snapshot, session: session, queueLength: function (winId) { return (queues[winId] || []).length; } };\n  }\n\n  return { createHost: createHost, QUEUE_MAX: QUEUE_MAX };\n}));\n",FA_GUI_PYWORKER_SRC="// 會開視窗的 Python 程式（py_async.js 判斷為 true 的）在 module Worker 裡跑：這裡只放純函式與要送進 Worker 的程式。\n// 為什麼要 Worker：同步的 runPython 內不能等 JS 的 Promise；Worker 裡用 JSPI（pyodide.ffi.run_sync）可以在 Python 呼叫處等頁面回覆。\n// 為什麼 Worker 是 module：classic Worker 裡 Pyodide 會報「Classic web workers are not supported」（2026-11-03 實測）。\n// 為什麼頁面不用 SharedArrayBuffer：頁面 crossOriginIsolated 是 false，所以只能用 Promise 與 postMessage。\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatPyWorker = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n\n  // 送進 Worker 的主程式。用 Function.prototype.toString 取出原始碼，所以函式內不能用外部變數，只能用參數 base（Pyodide 的網址）。\n  // 訊息：主執行緒 → Worker：init（檔案、程式、Python 前置程式）、reply（對 call 的回覆）；Worker → 主執行緒：out／err（輸出）、call（橋接請求）、done（結束碼）。\n  function workerMain(base) {\n    var pending = {}, nextId = 1;\n    function request(op, args) {\n      return new Promise(function (resolve) {\n        var id = nextId++;\n        pending[id] = resolve;\n        self.postMessage({ type: 'call', id: id, op: op, args: args });\n      });\n    }\n    async function run(m) {\n      try {\n        var mod = await import(base + 'pyodide.mjs');\n        var py = await mod.loadPyodide({ indexURL: base });\n        py.setStdout({ batched: function (s) { self.postMessage({ type: 'out', text: s + '\\n' }); } });\n        py.setStderr({ batched: function (s) { self.postMessage({ type: 'err', text: s + '\\n' }); } });\n        py.setStdin({ stdin: function () { return null; } });\n        // _fa_pybridge：fa_bridge.call 在網頁版直接呼叫它（同步的 run_sync 會等這裡的 Promise）\n        py.registerJsModule('_fa_pybridge', {\n          call: function (op, argsJson) { return request(String(op), JSON.parse(String(argsJson || '{}'))); },\n          sleep: function (ms) { return new Promise(function (r) { setTimeout(r, Number(ms) || 0); }); }\n        });\n        Object.keys(m.files).forEach(function (k) {\n          var full = '/fa_pybridge/' + k, dir = full.slice(0, full.lastIndexOf('/'));\n          py.FS.mkdirTree(dir);\n          py.FS.writeFile(full, m.files[k]);\n        });\n        py.FS.mkdirTree('/work');\n        m.inputs.forEach(function (f) {\n          var full = '/work/' + f.rel, dir = full.slice(0, full.lastIndexOf('/'));\n          if (dir !== '/work') py.FS.mkdirTree(dir);\n          py.FS.writeFile(full, f.bytes);\n        });\n        py.FS.chdir('/work');\n        py.runPython(m.prelude);\n        py.globals.set('__fa_src__', m.src);\n        py.globals.set('__fa_path__', '/work/' + m.scriptName);\n        py.runPython(m.runner);\n        // 程式寫在目前目錄（/work）的檔案送回頁面，讓終端機的 ls 看得到（例如 missile 範例寫出的貼圖）\n        function syncBack() {\n          var files = [];\n          py.FS.readdir('/work').forEach(function (n) {\n            var p = '/work/' + n;\n            if (n === '.' || n === '..' || !py.FS.isFile(py.FS.stat(p).mode)) { return; }\n            files.push({ rel: n, bytes: py.FS.readFile(p) });\n          });\n          self.postMessage({ type: 'files', files: files });\n        }\n        var go = py.globals.get('go');\n        try {\n          var rc = await go.callPromising();   // go() 回傳程式的結束碼（SystemExit 的值，或正常結束的 0）\n          syncBack();\n          self.postMessage({ type: 'done', code: typeof rc === 'number' ? rc : 0 });\n        } catch (e) {\n          self.postMessage({ type: 'err', text: String((e && e.message) || e) + '\\n' });\n          syncBack();\n          self.postMessage({ type: 'done', code: 1 });\n        } finally {\n          go.destroy();\n        }\n      } catch (e) {\n        self.postMessage({ type: 'err', text: '無法啟動 Python（' + String((e && e.message) || e) + '）\\n' });\n        self.postMessage({ type: 'done', code: 1 });\n      }\n    }\n    self.onmessage = function (ev) {\n      var m = ev.data || {};\n      if (m.type === 'reply') { var p = pending[m.id]; delete pending[m.id]; if (p) p(m.raw); return; }\n      if (m.type === 'init') run(m);\n    };\n  }\n\n  // 要放進 Worker 執行的原始碼（module）。base 是 Pyodide 的網址，要與頁面用的相同（FA_ASSET_URLS.pyodideJsBase）。\n  function workerSource(base) {\n    return '(' + workerMain.toString() + ')(' + JSON.stringify(String(base)) + ');';\n  }\n\n  // Worker 內先執行：轉接層的路徑、橋接版 fa_bridge（網頁版：IN_BROWSER 時 call 用 run_sync）。sys.path 把 /work 放最前面，跟桌面版的 python 一樣。\n  // install_hooks 不放這裡：它會呼叫 run_sync，頂層不在 callPromising 裡會報「Cannot stack switch」，所以放進 RUNNER_PY 的 go() 裡。\n  var PRELUDE_PY = [\n    'import sys',\n    \"if '/fa_pybridge' not in sys.path:\",\n    \"    sys.path.insert(0, '/fa_pybridge')\",\n    \"sys.path.insert(0, '/work')\",\n    'import fa_bridge',\n    'fa_bridge.ACTIVE = True',\n  ].join('\\n');\n\n  // 把程式包在 go() 裡執行：整支程式在 callPromising 裡，頂層的 gui 呼叫才能同步等待。__name__ 設成 __main__，__file__ 指向 /work 內的路徑。\n  var RUNNER_PY = [\n    'def go():',\n    '    fa_bridge.install_hooks()',\n    '    import builtins, io',\n    '    def _readline(prompt=\"\"):',\n    '        return fa_bridge.call(\"stdin.readline\", {\"prompt\": str(prompt)})',\n    '    def _input(prompt=\"\"):',\n    '        r = _readline(prompt)',\n    '        if r is None:',\n    '            raise EOFError(\"EOF when reading a line\")',\n    '        return r[:-1] if r.endswith(\"\\\\n\") else r',\n    '    class _Stdin(io.TextIOBase):',\n    '        def readable(self): return True',\n    '        def isatty(self): return False',\n    '        def readline(self, size=-1):',\n    '            r = _readline(\"\")',\n    '            return \"\" if r is None else r',\n    '        def read(self, size=-1):',\n    '            parts = []',\n    '            while True:',\n    '                r = _readline(\"\")',\n    '                if r is None: break',\n    '                parts.append(r)',\n    '            return \"\".join(parts)',\n    '    builtins.input = _input',\n    '    sys.stdin = _Stdin()',\n    \"    g = {'__name__': '__main__', '__file__': __fa_path__}\",\n    // SystemExit 與 Python 的 sys.exit 一樣：整數是結束碼，None 是 0，其他值印到 stderr 後結束碼 1；未捕捉的例外仍是 1（由 JS 端的 catch 處理）\n    '    try:',\n    '        exec(compile(__fa_src__, __fa_path__, \"exec\"), g)',\n    '    except SystemExit as e:',\n    '        c = e.code',\n    '        if c is None: return 0',\n    '        if isinstance(c, int): return c',\n    '        sys.stderr.write(str(c) + \"\\\\n\")',\n    '        return 1',\n    '    return 0',\n  ].join('\\n');\n\n  // gui.* 橋接操作（gui.py 呼叫的名字，去掉 gui. 前綴）。與 gui_bridge.js 的 OPS 對應，另外 poll／wait／image 由頁面處理。\n  var GUI_OPS = ['open', 'add', 'set', 'remove', 'close', 'draw', 'image', 'theme', 'shortcut', 'tone', 'usertpl', 'pickfile', 'poll', 'wait'];\n\n  // 把 gui.py 送來的參數轉成 \"@gui\" 協定訊息（v:1 + op + 其餘欄位，欄位名與 gui.py 一致）\n  function guiMessage(op, args) {\n    var m = { v: 1, op: String(op) };\n    Object.keys(args || {}).forEach(function (k) { m[k] = args[k]; });\n    return m;\n  }\n\n  // 等待視窗的下一個事件（gui.wait）。host.wait 的 resolver 不能取消，超時後下一個事件會被丟掉，所以改成輪詢佇列（host.poll）。\n  // 視窗已關閉且佇列空的，回傳 close 事件；超時回傳 null（視窗保持開著，程式可以再等）。\n  async function waitEvent(host, winId, timeoutSec, o) {\n    var stepMs = (o && o.stepMs) || 15;\n    var deadline = o.now() + Math.max(0, Number(timeoutSec) || 0) * 1000;\n    for (;;) {\n      var line = host.poll(winId);\n      if (line !== null && line !== undefined) return JSON.parse(line);\n      if (!host.isOpen(winId)) return { event: 'close', id: winId };\n      if (o.now() >= deadline) return null;\n      await o.sleep(stepMs);\n    }\n  }\n\n  return {\n    workerSource: workerSource,\n    workerMain: workerMain,\n    PRELUDE_PY: PRELUDE_PY,\n    RUNNER_PY: RUNNER_PY,\n    GUI_OPS: GUI_OPS,\n    guiMessage: guiMessage,\n    waitEvent: waitEvent,\n  };\n}));\n",FA_READ_LEDGER_SRC="// Read ledger (pure, no DOM, no I/O): remembers paged reads that the model has not finished.\n// A tool result that says there is more (has_more:true, or chunk.hasMore:true, or truncated:true with a continuation offset)\n// is recorded under its source. The same source returning a result without has_more (its last page) clears the entry.\n// The tool loop asks pending(ledger) before accepting a final answer and uses reminderText(pending) to tell the model what is still unread.\n// Every function returns new values; the ledger is plain JSON-serializable data: { entries: { [key]: entry } }.\n//\n// entry: { key, toolName, label, nextOffset, nextStartLine, total, blocking }\n//   blocking:true  -> has_more, or truncated with a continuation offset (the loop may refuse a final answer)\n//   blocking:false -> truncated with no continuation offset (only a reminder; never refuses an answer)\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatReadLedger = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n  var SOURCE_FIELDS = ['ref', 'path', 'url', 'file_id', 'fileId', 'attachment_id', 'attachmentId', 'id'];\n  var PAGING_ARGS = ['offset', 'start', 'start_line', 'startLine', 'page', 'cursor', 'limit', 'max_chars', 'max_lines', 'chunk', 'from', 'to', 'next_offset', 'nextOffset'];\n\n  function isObj(x) { return x !== null && typeof x === 'object' && !Array.isArray(x); }\n  function pick() { for (var i = 0; i < arguments.length; i++) if (arguments[i] != null && arguments[i] !== '') return arguments[i]; return null; }\n\n  function stableStr(x) {\n    if (x === null || typeof x !== 'object') return JSON.stringify(x === undefined ? null : x);\n    if (Array.isArray(x)) return '[' + x.map(stableStr).join(',') + ']';\n    return '{' + Object.keys(x).sort().map(function (k) { return JSON.stringify(k) + ':' + stableStr(x[k]); }).join(',') + '}';\n  }\n\n  // Source identity: the first known id field (ref, path, url, file_id, attachment id ...). A path is qualified by cwd_abs when given.\n  function sourceOf(args) {\n    var a = isObj(args) ? args : {};\n    var cwd = typeof a.cwd_abs === 'string' ? a.cwd_abs : '';\n    for (var i = 0; i < SOURCE_FIELDS.length; i++) {\n      var f = SOURCE_FIELDS[i], v = a[f];\n      if (v != null && v !== '') return (cwd && f === 'path' ? cwd + '|' : '') + f + '=' + String(v);\n    }\n    // 沒有來源欄位時，用其餘參數當身分；續讀參數（offset、page、cursor ……）每頁都會變，不能算進身分，否則同一來源永遠清不掉\n    var rest = {};\n    Object.keys(a).forEach(function (k) { if (PAGING_ARGS.indexOf(k) < 0) rest[k] = a[k]; });\n    return 'args=' + stableStr(rest);\n  }\n\n  function sourceKey(toolName, args) { return String(toolName || '') + '\\u0001' + sourceOf(args); }\n\n  function createLedger() { return { entries: {} }; }\n\n  // Reads the paging fields in both snake_case and camelCase forms (the skill reference reader uses chunk.hasMore / chunk.nextOffset).\n  function paging(res) {\n    var ch = isObj(res.chunk) ? res.chunk : null;\n    return {\n      more: res.has_more === true || !!(ch && ch.hasMore === true),\n      truncated: res.truncated === true || !!(ch && ch.truncated === true),\n      nextOffset: pick(res.next_offset, ch && ch.nextOffset),\n      nextStartLine: pick(res.next_start_line, ch && ch.nextStartLine),\n      total: pick(res.total, ch && ch.total)\n    };\n  }\n\n  // ===== 覆蓋範圍（JSONL 分頁，見 jsonl_pager.js 與 DESIGN.jsonl-paging.md）=====\n  // 一頁的 meta（_page）帶 source、from、to（半開區間，單位＝第幾筆）、total、has_more、done。\n  // 帳本記「已讀過哪些區間」，而不只是「下一個位置」：跳到最後一頁不會把中間沒讀的部分清掉，要整份從 0 連續覆蓋到 total，而且收到最後一頁，才算讀完。\n  // 以 meta.source 當身分（不分哪個工具回的第一頁），所以 interpret_image 回的第 1 頁與 big_content 讀的第 2 頁會算同一份。\n  function mergeRange(list, a, b) {\n    if (!(b > a)) return list.slice();\n    var out = [];\n    list.concat([[a, b]]).sort(function (x, y) { return x[0] - y[0] || x[1] - y[1]; }).forEach(function (r) {\n      var last = out[out.length - 1];\n      if (last && r[0] <= last[1]) last[1] = Math.max(last[1], r[1]); else out.push([r[0], r[1]]);\n    });\n    return out;\n  }\n  function gapsOf(covered, total) {\n    var gaps = [], pos = 0;\n    covered.forEach(function (r) { if (r[0] > pos) gaps.push([pos, Math.min(r[0], total)]); pos = Math.max(pos, r[1]); });\n    if (pos < total) gaps.push([pos, total]);\n    return gaps.filter(function (g) { return g[1] > g[0]; });\n  }\n  function recordPage(base, m) {\n    var entries = Object.assign({}, base.entries), key = 'page\\u0001' + String(m.source || '');\n    if (base.completed && base.completed[key]) return { entries: entries, completed: base.completed };\n    var prev = entries[key];\n    var total = Number(m.total); if (!isFinite(total) || total < 0) total = 0;\n    var from = Number(m.from) || 0, to = Number(m.to) || 0;\n    var covered = mergeRange(prev && Array.isArray(prev.covered) ? prev.covered : [], from, to);\n    var done = !!(prev && prev.done) || m.done === true;\n    var part = m.record_part && m.record_part.part + 1 < m.record_part.of ? { record: m.record_part.record, next: m.record_part.part + 1, of: m.record_part.of } : null; // 單筆太大分段：沒讀到最後一段不算讀過\n    var exact = m.total_exact !== false;\n    var gaps = gapsOf(covered, total);\n    var complete = done && gaps.length === 0 && !part;\n    if (complete) { delete entries[key]; var done2 = Object.assign({}, base.completed); done2[key] = true; return { entries: entries, completed: done2 }; } // 讀完的來源記下來：之後再重讀其中一頁，不能又把它變成「沒讀完」\n    entries[key] = {\n      key: key, toolName: 'jsonl', label: String(m.source || ''), source: String(m.source || ''), unit: 'record',\n      covered: covered, total: total, totalExact: exact, gaps: gaps, done: done, pendingPart: part, pages: ((prev && prev.pages) || 0) + 1,\n      nextCursor: m.next_cursor || (prev && prev.nextCursor) || null, viaOffset: m.next_cursor == null && m.next_offset != null || !!(prev && prev.viaOffset && m.next_cursor == null), nextOffset: null, nextStartLine: null, blocking: true\n    };\n    return { entries: entries, completed: base.completed };\n  }\n\n  // Returns a new ledger after one tool result. Failed results (ok:false) change nothing.\n  function record(ledger, toolName, args, resultObj) {\n    var base = isObj(ledger) && isObj(ledger.entries) ? ledger : createLedger();\n    if (!isObj(resultObj) || resultObj.ok === false) return { entries: Object.assign({}, base.entries), completed: base.completed };\n    if (isObj(resultObj._page) && resultObj._page.source != null) { if (resultObj._page.blocking === false) return { entries: Object.assign({}, base.entries), completed: base.completed }; return recordPage(base, resultObj._page); } // blocking:false＝選擇性翻頁（排名搜尋），不逼模型讀完\n    var entries = Object.assign({}, base.entries);\n    var key = sourceKey(toolName, args), p = paging(resultObj);\n    var hasNext = p.nextOffset != null || p.nextStartLine != null;\n    if (p.more || (p.truncated)) {\n      entries[key] = {\n        key: key,\n        toolName: String(toolName || ''),\n        label: sourceOf(args),\n        nextOffset: p.nextOffset,\n        nextStartLine: p.nextStartLine,\n        total: p.total,\n        blocking: p.more || hasNext\n      };\n    } else {\n      delete entries[key]; // last page of this source: nothing left to read\n    }\n    return { entries: entries, completed: base.completed };\n  }\n\n  // Unfinished reads, oldest first (insertion order).\n  function pending(ledger) {\n    var entries = isObj(ledger) && isObj(ledger.entries) ? ledger.entries : {};\n    return Object.keys(entries).map(function (k) { return entries[k]; });\n  }\n\n  // Chinese reminder that lists each unfinished source and where to continue. Empty list gives an empty string.\n  // 覆蓋範圍型來源（單位＝第幾筆）的缺口描述：「第 a～b 筆」（人看的是 1 起算，區間是 0 起算半開）\n  function gapText(e, cursorFor) {\n    var gs = (e.gaps || []).slice(0, 6).map(function (g) { return '第 ' + (g[0] + 1) + '～' + g[1] + ' 筆' + (e.viaOffset ? '（offset：' + g[0] + '）' : typeof cursorFor === 'function' ? '（cursor：' + cursorFor(e.source, g[0]) + '）' : ''); });\n    if ((e.gaps || []).length > 6) gs.push('…還有 ' + (e.gaps.length - 6) + ' 段');\n    return gs.join('、');\n  }\n  // 頁數預估：記錄清單還要幾頁（沒讀的筆數 ÷ 平均每頁讀到幾筆）；opts.room（上下文還剩幾 token）與 opts.pageTokens（一頁約幾 token）\n  // 給了就一併算「放得下幾頁」。放不下就別無止盡續讀：先用 grep／json 只取需要的，或把已讀的重點寫成摘要（舊頁會被換成 placeholder）。\n  function estimate(e, opts) {\n    if (!e || e.unit !== 'record' || !(e.total > 0)) return null;\n    var got = (e.covered || []).reduce(function (s, r) { return s + (r[1] - r[0]); }, 0), pages = e.pages || 0;\n    var left = Math.max(0, e.total - got); if (!left) return { pagesLeft: 0, fits: null, enough: true };\n    var per = pages > 0 && got > 0 ? got / pages : 0; var pagesLeft = per > 0 ? Math.ceil(left / per) : null;\n    var fits = opts && opts.room > 0 && opts.pageTokens > 0 ? Math.max(0, Math.floor(opts.room / opts.pageTokens)) : null;\n    return { pagesLeft: pagesLeft, fits: fits, enough: pagesLeft == null || fits == null ? null : fits >= pagesLeft };\n  }\n  function reminderText(list, opts) {\n    var items = Array.isArray(list) ? list : [];\n    if (!items.length) return '';\n    var cursorFor = opts && opts.cursorFor;\n    var lines = items.map(function (e) {\n      if (e.unit === 'record') {\n        var got = (e.covered || []).reduce(function (s, r) { return s + (r[1] - r[0]); }, 0);\n        var miss = (e.gaps || []).length ? '還沒讀：' + gapText(e, cursorFor) : (e.pendingPart ? '第 ' + (e.pendingPart.record + 1) + ' 筆太大分成 ' + e.pendingPart.of + ' 段，還有第 ' + (e.pendingPart.next + 1) + ' 段以後沒讀' : '還沒收到最後一頁');\n        var est = estimate(e, opts), estText = '';\n        if (est && est.pagesLeft != null) estText = '；約還要 ' + est.pagesLeft + ' 頁' + (est.fits != null ? '，現在的上下文只放得下約 ' + est.fits + ' 頁' + (est.enough ? '' : '：放不下，別一頁頁全讀——先用 big_content 的 grep／json 只取需要的，或先把已讀的重點寫成一小段摘要再繼續（舊的頁會被省略）') : '');\n        return '・來源 ' + e.label + '（記錄清單，已讀 ' + got + '／' + e.total + ' 筆）：' + miss + estText + (e.nextCursor && !(e.gaps || []).length ? '；下一頁 cursor：' + e.nextCursor : '');\n      }\n      var where = e.nextOffset != null ? '下一個 offset：' + e.nextOffset\n        : e.nextStartLine != null ? '下一個起始行：' + e.nextStartLine\n        : '沒有提供續讀位置，可能只讀了一部分';\n      var total = e.total != null ? '（總量 ' + e.total + '）' : '';\n      return '・來源 ' + e.label + '（工具 ' + e.toolName + '）：' + where + total;\n    });\n    return '【讀取尚未完成】以下來源還沒有讀到最後一頁：\\n' + lines.join('\\n') +\n      '\\n請用上面的續讀位置繼續呼叫工具讀完。讀完之前不可下結論，不要說「報告都正確」之類的話。';\n  }\n\n  // 給最終回答前面由程式附加的警語用：一個沒讀完的來源讀到哪、缺什麼（不靠模型自己說）\n  function describe(e) {\n    if (e.unit === 'record') {\n      var got = (e.covered || []).reduce(function (s, r) { return s + (r[1] - r[0]); }, 0);\n      return e.label + '（只讀了 ' + got + '／' + e.total + ' 筆' + ((e.gaps || []).length ? '，沒讀到：' + gapText(e) : '') + '）';\n    }\n    return e.label + '（已讀到 ' + (e.nextOffset != null ? 'offset ' + e.nextOffset : '第 ' + e.nextStartLine + ' 行') + '）';\n  }\n\n  return {\n    createLedger: createLedger,\n    record: record,\n    pending: pending,\n    reminderText: reminderText,\n    estimate: estimate,\n    describe: describe,\n    sourceKey: sourceKey\n  };\n}));\n",FA_JSONL_PAGER_SRC="// JSONL 分頁器（純函式，無 DOM、無 I/O、UMD；嵌入 floating-assistant 後用 new Function 載入）。\n// 用途：很大的 JSON 回應（記錄清單）不再「只放開頭就截斷」，而是一頁一頁、每行一筆記錄地給模型，模型可以用 cursor 一直讀到完。\n// 設計與實證見 DESIGN.jsonl-paging.md。\n//\n// 一頁的文字格式：第一行是 meta：{\"_page\":{...}}，其後每行一筆記錄（單行 JSON，內容裡的換行都已跳脫）。\n//   單筆比一頁還大：不丟、不截斷，拆成多頁，每段一行 {\"_part\":{\"record\":i,\"part\":k,\"of\":n,\"text\":\"…\"}}，把 text 依序接起來就是那一筆的原文。\n// 大小跟內容窗口按比例（budgetChars），沒有字元下限；一頁至少 1 筆（或 1 段）。\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatJsonlPager = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n  var VERSION = 'c1';\n  var META_TOKENS = 130; // 同上，以 token 計（JSON 標點與中文提示分詞很碎）\n  var META_OVERHEAD = 320; // meta 那一行大約佔多少字元（含 hint），從預算裡先扣掉\n\n  function isObj(x) { return x !== null && typeof x === 'object' && !Array.isArray(x); }\n  function safeStringify(v) { try { var s = JSON.stringify(v); return s === undefined ? 'null' : s; } catch (e) { return null; } }\n\n  // 一頁可以放多少字元：內容窗口 token × 比例 × 每 token 約幾個字元。沒有下限常數。\n  function budgetChars(o) {\n    o = o || {};\n    if (Number(o.chars) > 0) return Math.floor(Number(o.chars));\n    var ctx = Number(o.ctxTokens) || 0, fr = Number(o.fraction) || 0.15, cpt = Number(o.charsPerToken) || 3;\n    return Math.max(1, Math.floor(ctx * fr * cpt));\n  }\n\n  // 短雜湊（FNV-1a 32 位元），讓帳本核對「這一頁真的拿到過」\n  function digest(text) {\n    var h = 0x811c9dc5; text = String(text);\n    for (var i = 0; i < text.length; i++) { h ^= text.charCodeAt(i); h = (h + ((h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24))) >>> 0; }\n    return ('00000000' + h.toString(16)).slice(-8);\n  }\n\n  // 逐行解析 JSONL 文字：回傳 { values:[{line, value}], bad:[{line, raw, error}], lines } ；空行略過但行號照算，壞行保留不丟\n  function parseLines(text) {\n    var out = { values: [], bad: [], lines: 0 };\n    var rows = String(text == null ? '' : text).replace(/^\ufeff/, '').split(/\\r?\\n/);\n    for (var i = 0; i < rows.length; i++) {\n      var s = rows[i]; if (!s.trim()) continue;\n      out.lines++;\n      try { out.values.push({ line: i + 1, value: JSON.parse(s) }); }\n      catch (e) { out.bad.push({ line: i + 1, raw: s.length > 200 ? s.slice(0, 200) + '…' : s, error: String(e && e.message || e).split('\\n')[0] }); }\n    }\n    return out;\n  }\n\n  // 找頂層物件裡「占大宗」的陣列欄位（最多往下兩層）：回傳 { path:[...], arr }；沒有回 nul