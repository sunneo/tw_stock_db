outb",format:"OUTB",description:"Byte-sized port output."},{name:"outw",format:"OUTW",description:"Word-sized port output."},{name:"outl",format:"OUTL",description:"Doubleword-sized port output."},{name:"ins",format:"INS m8/m16/m32, DX",description:"String input from port DX into memory at [ES:(E)DI], auto-incrementing."},{name:"outs",format:"OUTS DX, m8/m16/m32",description:"String output from memory at [DS:(E)SI] to port DX, auto-incrementing."},{name:"insb",format:"INSB",description:"Byte-granularity form of INS."},{name:"outsb",format:"OUTSB",description:"Byte-granularity form of OUTS."},{name:"insw",format:"INSW",description:"Word-granularity form of INS."},{name:"outsw",format:"OUTSW",description:"Word-granularity form of OUTS."},{name:"insd",format:"INSD",description:"Doubleword-granularity form of INS."},{name:"outsd",format:"OUTSD",description:"Doubleword-granularity form of OUTS."},{name:"cli",format:"CLI",description:"Clears the interrupt flag (IF=0), disabling maskable interrupts."},{name:"sti",format:"STI",description:"Sets the interrupt flag (IF=1), enabling maskable interrupts."},{name:"hlt",format:"HLT",description:"Halts the CPU until the next external interrupt."},{name:"lock",format:"LOCK <instr>",description:"Prefix asserting the bus/cache lock for an atomic read-modify-write."},{name:"wbinvd",format:"WBINVD",description:"Writes back and invalidates the entire cache hierarchy."},{name:"invd",format:"INVD",description:"Invalidates the cache without writing back (data loss risk)."},{name:"clflush",format:"CLFLUSH m8",description:"Flushes a cache line for the given linear address."},{name:"rdmsr",format:"",description:"讀取模型特定暫存器"},{name:"wrmsr",format:"",description:"寫入模型特定暫存器"},{name:"rdtsc",format:"",description:"讀取時間戳計數器"},{name:"rdtscp",format:"",description:"讀取時間戳計數器並取得處理器 ID"},{name:"rdpmc",format:"",description:"讀取效能計數器"},{name:"cpuid",format:"",description:"查詢處理器功能"},{name:"lgdt",format:"",description:"載入全域描述元表"},{name:"lidt",format:"",description:"載入中斷描述元表"},{name:"lldt",format:"",description:"載入區域描述元表"},{name:"ltr",format:"",description:"載入工作暫存器"},{name:"sgdt",format:"",description:"儲存全域描述元表"},{name:"sidt",format:"",description:"儲存中斷描述元表"},{name:"invlpg",format:"",description:"使 TLB 項目失效"},{name:"swapgs",format:"",description:"交換 GS 基底（核心／使用者）"},{name:"sysret",format:"",description:"從系統呼叫返回使用者態"},{name:"sysexit",format:"",description:"快速返回使用者態"},{name:"sysenter",format:"",description:"快速進入核心"},{name:"vmcall",format:"",description:"虛擬機呼叫超管理器"},{name:"vmlaunch",format:"",description:"啟動虛擬機"},{name:"vmresume",format:"",description:"繼續虛擬機"},{name:"vmxon",format:"",description:"進入 VMX 操作"},{name:"vmxoff",format:"",description:"離開 VMX 操作"},{name:"xgetbv",format:"",description:"讀取擴充控制暫存器"},{name:"xsetbv",format:"",description:"寫入擴充控制暫存器"},{name:"xsave",format:"",description:"儲存處理器擴充狀態"},{name:"xrstor",format:"",description:"還原處理器擴充狀態"},{name:"fxsave",format:"",description:"儲存浮點與 SSE 狀態"},{name:"fxrstor",format:"",description:"還原浮點與 SSE 狀態"},{name:"rdfsbase",format:"",description:"讀取 FS 基底"},{name:"wrfsbase",format:"",description:"寫入 FS 基底"},{name:"rdgsbase",format:"",description:"讀取 GS 基底"},{name:"wrgsbase",format:"",description:"寫入 GS 基底"},{name:"smsw",format:"",description:"儲存機器狀態字"},{name:"lmsw",format:"",description:"載入機器狀態字"}],memory_management:[{name:"mov",format:"MOV dst, src",description:"Copies src into dst (register/memory/immediate)."},{name:"lea",format:"LEA r, m",description:"Loads the computed effective address of m into r (no memory read)."},{name:"push",format:"PUSH src",description:"Decrements the stack pointer and stores src at [SP]."},{name:"pop",format:"POP dst",description:"Loads dst from [SP] and increments the stack pointer."},{name:"movzx",format:"MOVZX dst, src",description:"Move with zero-extension to a wider register."},{name:"movsx",format:"MOVSX dst, src",description:"Move with sign-extension to a wider register."},{name:"movs",format:"MOVS m, m",description:"String move: copies [SI]->[DI], auto-incrementing/decrementing."},{name:"movsb",format:"MOVSB",description:"Byte-sized MOVS (explicit-size AT&T mnemonic - copies one byte [SI]->[DI])."},{name:"movsw",format:"MOVSW",description:"Word-sized MOVS."},{name:"movsd",format:"MOVSD",description:"Doubleword-sized MOVS (string-move sense - NOT the SSE2 scalar-double-move instruction of the same mnemonic; disambiguated by context, this table lists the string-instruction meaning since that's the one paired with REP.)"},{name:"movsq",format:"MOVSQ",description:"Quadword-sized MOVS (64-bit mode)."},{name:"stos",format:"STOS m",description:"Stores AL/AX/EAX to [DI], auto-incrementing/decrementing."},{name:"stosb",format:"STOSB",description:"Byte-sized STOS (explicit-size AT&T mnemonic - stores AL to [DI]; the core instruction of the classic `rep stosb` memset/bzero-to-zero idiom)."},{name:"stosw",format:"STOSW",description:"Word-sized STOS (stores AX to [DI])."},{name:"stosd",format:"STOSD",description:"Doubleword-sized STOS (stores EAX to [DI])."},{name:"stosq",format:"STOSQ",description:"Quadword-sized STOS (64-bit mode, stores RAX to [DI])."},{name:"lods",format:"LODS m",description:"Loads AL/AX/EAX from [SI], auto-incrementing/decrementing."},{name:"lodsb",format:"LODSB",description:"Byte-sized LODS (explicit-size AT&T mnemonic)."},{name:"lodsw",format:"LODSW",description:"Word-sized LODS."},{name:"lodsd",format:"LODSD",description:"Doubleword-sized LODS."},{name:"lodsq",format:"LODSQ",description:"Quadword-sized LODS (64-bit mode)."},{name:"cmps",format:"CMPS m, m",description:"Compares [SI] and [DI], auto-incrementing/decrementing."},{name:"cmpsb",format:"CMPSB",description:"Byte-sized CMPS (explicit-size AT&T mnemonic)."},{name:"cmpsw",format:"CMPSW",description:"Word-sized CMPS."},{name:"cmpsd",format:"CMPSD",description:"Doubleword-sized CMPS (string-compare sense - same disambiguation note as MOVSD above.)"},{name:"cmpsq",format:"CMPSQ",description:"Quadword-sized CMPS (64-bit mode)."},{na