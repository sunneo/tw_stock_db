料集"],0)+a(16,50,284,40,{r:6})+i(26,75,"左邊：要「管理」的清單",{size:12,fill:r.MUT})+a(316,8,316,344,{r:8,stroke:r.OK,sw:2.2})+d(324,14,["🏋️ 訓練","📜 紀錄"],0)+i(330,80,"右邊：資料集預覽、逐筆編輯、評量結果",{size:12,fill:r.OK})+i(330,104,"都開在右邊的分頁；上一頁 ◀ 下一頁 ▶ 切換。",{size:12,fill:r.MUT})+o(330,316,140,"還原版面"))}},h="adv"===e||"advanced"===e?function(e){return{title:"如何使用離線訓練器（進階模式）",chapters:[{title:"全部設定",slides:[f("離線訓練器：進階模式","所有設定都在這裡","這一集介紹進階模式。所有欄位都在同一頁：訓練種類、運算後端、核心數、基準測試、訓練表單，還有暫停、續訓和匯出。",e.title("進階模式")),m("訓練種類與後端","進階模式最上面是訓練種類和運算後端。後端選「自動」最省事，程式會挑最合適的。下面的核心數，預設是自動，也就是全部核心減一，讓電腦保持可用。要改的話填整數，按套用。",["訓練種類、運算後端","核心數：自動＝全部減 1"],e.adv()),m("運算後端怎麼選","純處理器用你電腦上的 Python，速度快，可以暫停續訓，但匯出的檢查點不含優化器。網頁處理器在頁面裡跑，慢但正確，檢查點完整，可以帶到別台續訓。WebGPU、DirectML、Vulkan 目前還沒實作，會顯示不可用和原因。",["純處理器：快","網頁處理器：完整可匯出"],e.backends()),m("基準測試","正式訓練前，可以先按「跑基準測試」。它很小，三十步、十六筆，在背景執行，至少留一個核心，也不會下載任何檔案，用來看這台電腦大概多快。",["30 步、16 筆","背景執行、不下載"],e.adv()),m("訓練表單","訓練資料可以從下拉清單挑已匯入或內建的資產，不用自己找路徑；也可以選「不從資產挑」，自己填檔案路徑。名稱會用來命名成果。步數和學習率在網頁處理器上才會用到。",["訓練資料：從資產挑","名稱＝成果名字","步數、學習率（網頁處理器）"],e.form()),m("暫停、續訓與匯出","訓練中按暫停會存檢查點，之後按續訓接著練。網頁處理器的檢查點可以匯出成 .fackpt，帶到另一台機器繼續。純處理器的檢查點不含優化器，所以不能無縫換後端續訓。",["暫停 → 續訓",".fackpt 匯出／匯入","純處理器不含優化器"],e.ctl()),m("LLM 匯出","訓練好的 LoRA 可以併回基底模型，匯出成 ONNX 或 GGUF。每一步的狀態和阻礙都會顯示出來。這個功能只在桌面版執行。",["ONNX q8","GGUF Q8_0","只在桌面版"],e.llm()),m("分頁與版面","工作室的分頁列分在左右兩邊。資料集預覽、逐筆編輯、評量結果這類內容，會開在右邊的分頁，用上一頁、下一頁切換。版面亂了，按「還原版面」就回到預設。",["預覽、逐筆編輯、評量結果","開在右邊分頁","還原版面"],e.tabs()),f("隨時回來看","簡單模式與進階模式","兩種模式可以隨時切換，選擇會記在這台電腦上。需要教學，回到設定頁的按鈕就好。祝你訓練順利。",e.title("隨時切換"))]}]}}(c):function(e){return{title:"如何使用離線訓練器（簡單模式）",chapters:[{title:"一步一步",slides:[f("離線訓練器：簡單模式","照著填，就能開始訓練","歡迎使用離線訓練器。簡單模式像精靈一樣，一次只問你一件事，預設值都幫你填好，照著點就能開始訓練。",e.title("簡單模式")),m("從設定開啟","先到設定，找到離線訓練工作室，按「開啟離線訓練器」。旁邊還有兩顆按鈕，可以隨時回來看簡單模式或進階模式的教學。",["設定 › 離線訓練工作室","按「開啟離線訓練器」"],e.open()),m("選簡單模式","開啟之後，到右邊的「訓練」分頁，上面有兩個模式。選「簡單模式」就是一步一步的精靈。你的選擇會記在這台電腦上，下次開啟沿用。",["訓練分頁 › 簡單模式","選擇會記住"],e.modes()),m("第 1 步：想做什麼","第一步，問你想做什麼。「訓練」是用資料訓練出新的成果；「更新資產」是你已經有一份資產，想再訓練、補資料，或重新評量。沒有選之前，下一步是灰的。",["訓練：做出新成果","更新資產：改進現有的"],e.s1()),m("第 2 步：選目標","第二步，選目標。可以訓練語言模型 LoRA、積木課程、矩陣層、UML 設計、CoLU 排名，或離線訓練器本身。每張卡片都寫了需不需要挑資料。",["LoRA、積木、矩陣、UML","CoLU、離線訓練器：不用挑資料"],e.s2()),m("第 3 步：資料從哪裡來","第三步，資料從哪裡來？可以從已經匯入或內建的資產裡挑，也可以選新的資料，檔案、網頁或文字，系統會帶你到資料匯入。匯入好再回來挑，不用自己輸入路徑。這一步只有需要資料的目標才會出現。",["已匯入／內建的資產","新的資料 → 資料匯入","不用輸入路徑"],e.s3()),m("第 4 步：確認","第四步，確認。名字已經自動取好，想改就改。語言模型會告訴你會用哪個環境訓練：有 Python 就用 Python，快；沒有就自動改用網頁處理器，慢但正確。不用挑資料的目標，像 CoLU 排名，步驟只有四步，直接從目標到確認。",["名字自動取好","自動選環境","不用挑資料就少一步"],e.s4()),m("第 5 步：開始","按「開始訓練」之後，會看到進度條、狀態和紀錄；語言模型還會畫出 loss 曲線，loss 往下走，代表越學越好。中途可以按暫停，存下檢查點；也可以停止。訓練完成後，成果會存成資產。如果沒辦法開始，畫面會寫出原因和解除方法。",["進度條、狀態與紀錄","可暫停、可停止","沒辦法開始時寫出原因"],e.s5()),m("更新資產","如果選的是「更新資產」，先挑你自己的資產，再選要做什麼：補充資料、再訓練一次。積木課程、矩陣層、UML、CoLU 另外有重新評量，看有沒有退步。",["補充資料","再訓練一次","重新評量（部分種類）"],e.u2()),f("想調更多？","切到進階模式","簡單模式用的都是建議值。想自己調步數、學習率、核心數，或匯出檢查點，請切到進階模式。祝你訓練順利。",e.title("進階模式有全部設定"))]}]}}(c);return{deck:{title:h.title,lang:"zh-TW",speed:1},chapters:JSON.parse(JSON.stringify(h.chapters))}}return{buildDeck:h,buildYaml:function(e,t){return JSON.stringify(h(e,t),null,1)},title:function(e){return h(e).deck.title},pr:t,PRON:e,PALETTE:n,SIMPLE_STEPS:p}})}.call(null,void 0,e),function(e,t){!function(t,n){"object"==typeof e&&e.exports?e.exports=n():t.FaStudioModelTypes=n()}(void 0!==t?t:this,function(){"use strict";var e={done:"已完成可用",half:"半成品",design:"只有設計"},t=[{id:"llm",name:"語言模型",status:"done",goal:"lora",summary:"用你的對話或問答資料，訓練一顆小的語言模型調整檔（LoRA），或把它併回基底模型，匯出完整模型。",sources:["資料匯入產生的資料集（.jsonl，每行一筆）","已匯入或內建的資料集"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"},{id:"wasm-web",label:"網頁處理器（頁內 WebAssembly，慢但正確）"}],outputs:[{id:"lora",label:"LoRA 小檔（疊在基底上）",available:!0,formats:["工作室資產（.fatrain 可匯出）"],note:"檔案小，可以跟其他 LoRA 一起套用（最多同時幾顆見「LoRA 登錄」）。"},{id:"full",label:"完整模型（合併匯出）",available:!0,formats:["ONNX q8（桌面版預設）","GGUF Q8_0（llama.cpp）"],note:"先訓練 LoRA，再到進階模式最下方的匯出區（ONNX／GGUF）併回基底。目前是手動的第二步，只在桌面版執行。"}],can:["訓練 LoRA 小檔","併回基底匯出完整模型（ONNX／GGUF，桌面版）"],cannot:[]},{id:"symbolic",name:"離線訓練器（積木課、矩陣層、UML、CoLU、訓練器本身）",status:"done",goal:"symbolic",summary:"符號式的訓練：用題目與回饋重訓排名模型、整理積木課或矩陣層的操作。結果存成工作室資產。",sources:["題目資產（積木課、矩陣層）","情境配對（UML）","採用／退回回饋（CoLU）"],backends:[{id:"cpu-js",label:"處理器（不需要安裝任何東西）"}],outputs:[{id:"asset",label:"工作室資產",available:!0,formats:["工作室資產"],note:""}],can:["訓練後存成工作室資產"],cannot:[]},{id:"speech",name:"語音合成（念出文字）",status:"done",ext:"speech",summary:"把文字念成聲音。以語音合成基底模型與一個基底語音包為起點，只訓練語音包的風格偏移（256 維），其餘權重凍結。輸出是一個與語音包同格式的檔案。",sources:["配對資料夾（每行一筆的 .jsonl 訓練檔與留出檔，附錄音；錄音由基底模型合成，不需要你另外錄）"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"}],outputs:[{id:"lora",label:"風格偏移小檔（語音包）",available:!0,formats:["語音包檔（與基底同格式，522,240 位元組）"],note:"只改語音包的風格，不是 LoRA，也不是整個模型的微調。"},{id:"full",label:"完整模型",available:!1,formats:[],reason:"沒有整個語音合成模型的微調與匯出路徑。"}],gap:"實測：30 步，留出句的損失由 2.103 降到 1.308；合成一句並核對可以載入。限制：只看留出句的損失，沒有主觀聆聽評分；訓練資料是基底模型自己合成的音訊；風格偏移只有 256 個數字。",can:["從工作室按開始訓練風格偏移（處理器，30 步約 1 分鐘）","訓練完合成一句並核對"],cannot:["訓練整個語音合成模型","匯出完整語音合成模型"]},{id:"music",name:"音樂作曲（輸出音符）",status:"done",ext:"music",summary:"依程式作曲的旋律資料，從零開始訓練一個小型作曲模型（約 46 萬參數），訓練後取樣並核對重新載入的結果。不是預訓練模型的微調，也不是用真實作曲資料訓練。",sources:["作曲資料（程式作曲產生，自動準備，不需要你另外提供資料）"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"}],outputs:[{id:"lora",label:"LoRA 小檔",available:!1,formats:[],reason:"這個類型訓練的是從零開始的小型模型，不產生 LoRA 小檔。"},{id:"full",label:"完整模型（權重與設定）",available:!0,formats:["權重檔加設定檔與詞彙表"],note:"輸出放在工作室的外部訓練資料夾，還沒有收進工作室資產，也還沒接到作曲流程。"}],gap:"實測：留出 90 首，損失由 4.756 降到 1.150；取樣 36 首中語法合格由 2 首升到 27 首；從磁碟重新載入後 36 首逐首相同。限制：只在程式作曲的資料上驗證，沒有和真實作曲比較過音樂品質；輸出還沒進工作室資產；作曲流程不會換用訓練出的模型。",can:["從工作室按開始訓練（產生資料、訓練、重新載入核對；處理器約 1 分鐘）","輸出權重、設定、詞彙表與取樣樣本"],cannot:["用真實作曲資料訓練","在作曲流程中換用訓練出的模型","把輸出收進工作室資產"]},{id:"speech_recognition",name:"語音辨識（聽寫成文字）",status:"done",ext:"speech_recognition",summary:"把錄音聽寫成文字。以小型語音辨識基底（39M 參數）為底，只在注意力的查詢與值投影掛 LoRA 小檔，用處理器訓練。",sources:["語音辨識資料（每行一筆的 .jsonl 檔：16 千赫、單聲道的錄音相對路徑、參考文字、切分）"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"}],outputs:[{id:"lora",label:"LoRA 小檔",available:!0,formats:["LoRA 小檔（資料夾內含權重與設定）"],note:"注意：驗證集的字錯率沒有下降（實測 15.81%→15.81%；120 步反而變差到 17.28%）。損失下降不代表辨識變好。"},{id:"full",label:"完整模型",available:!1,formats:[],reason:"還沒有把 LoRA 併回基底的匯出路徑。"}],gap:"實測：40 步訓練損失由 1.061 降到 0.053；同設定重新載入後的輸出與訓練時逐位元相同。限制：字錯率沒有下降；LoRA 還沒接進應用程式的聽寫流程；輸出還沒進工作室資產。",can:["從工作室按開始訓練 LoRA（處理器，40 步約 30 秒）","訓練完重新載入並核對輸出"],cannot:["把語音辨識 LoRA 併回基底匯出完整模型","在應用程式內換用這個 LoRA"]},{id:"audio_to_notes",name:"音訊轉音符（把錄音轉成樂譜）",status:"done",ext:"audio_to_notes",summary:"把錄音轉成音符。以轉譜模型為底，全參數微調（凍結前端的頻譜特徵層），匯出 ONNX，形狀與原檔相同。",sources:["合成資料（已知音符的鋼琴式音色，由程式產生，不需要你準備資料）"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"}],outputs:[{id:"lora",label:"LoRA 小檔",available:!1,formats:[],reason:"這個類型微調的是整個轉譜模型，不產生 LoRA 小檔。"},{id:"full",label:"完整模型（ONNX）",available:!0,formats:["ONNX（形狀與原檔相同）"],note:"輸出放在外部訓練資料夾，還沒有收進工作室資產；應用程式的轉譜流程仍用原版模型。"}],gap:"實測（300 步，約 25 秒）：合成訓練 200 段、留出 40 段；訓練腳本的音符準確度由 0.927 升到 0.957；匯出的模型可以重新載入。先前紀錄：應用程式解碼器在留出 100 段上由 0.735 升到 0.941。限制：只有合成資料；沒有真實錄音驗證；還沒接進應用程式。",can:["從工作室按開始微調（產生資料、訓練、匯出並重新載入核對；處理器約 25 秒）","輸出 ONNX 模型"],cannot:["用真實錄音訓練或驗證","在應用程式內換用微調後的模型"]},{id:"image",name:"圖像生成（SDXS 類快速模型）",status:"done",ext:"image",summary:"用合成的圖文配對，在 SDXS 快速模型上訓練 LoRA 小檔（只掛在注意力層），疊在基底上依文字畫圖。",sources:["圖文配對（由程式合成的圖與描述，不需要你準備資料）"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"}],outputs:[{id:"lora",label:"LoRA 小檔（疊在 SDXS 基底上）",available:!0,formats:["LoRA 檔（格式版本 1）"],note:"同種子前後比對，以及從檔案重新載入的結果都逐位元相同（實測）。"},{id:"full",label:"完整模型（合併匯出）",available:!1,formats:[],reason:"還沒有 SDXS 的完整模型匯出路徑（合併與驗證都沒做）。目前只輸出 LoRA。"}],gap:"實測（40 步，訓練 35 秒）：重複生圖與跨程序生圖逐位元相同；LoRA 確實改變了輸出（平均像素差 94／255）。這只說明 LoRA 有作用，不代表畫得好。限制：只用合成資料，沒有人工評量；LoRA 還沒有接進網頁或桌面的 ONNX 生圖執行環境（未驗證）。",can:["從工作室按開始訓練 LoRA（處理器，512 解析度，約 1 秒／步）","訓練完生一張圖核對"],cannot:["輸出完整模型","在 ONNX 生圖執行環境套用 LoRA（未驗證）"]},{id:"vision",name:"看圖說文字（視覺語言模型）",status:"done",ext:"vision",summary:"看圖回答或描述圖片。以小型看圖模型為底，只掛 LoRA 小檔。資料由程式合成（顏色與形狀的圖），留出的顏色與形狀組合不進訓練。",sources:["合成的圖文問答（由程式產生，不需要你準備資料）"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"}],outputs:[{id:"lora",label:"LoRA 小檔",available:!0,formats:["LoRA 資料夾（權重與設定）"],note:"評量只看顏色與形狀是否說對，沒有人工評量。"},{id:"full",label:"完整模型",available:!1,formats:[],reason:"還沒有併回基底的匯出路徑接進工作室（合併匯出的腳本存在，但沒有驗證）。"}],gap:"實測（300 步，約 4.4 分鐘）：合成的留出 12 題，顏色、形狀與兩者都對都是 12/12（100%）；4 步冒煙時是 0.58。限制：只有合成資料，題型很單純；只評量顏色與形狀；沒有人工評量。",can:["從工作室按開始訓練 LoRA（處理器，約 1 秒／步）","載入 LoRA 重跑留出題"],cannot:["輸出完整模型","在應用程式內換用這個 LoRA"]},{id:"llm_scratch",name:"建立語言模型（從零開始）",status:"done",ext:"llm_scratch",summary:"從語料開始建一顆語言模型：清理語料 → 訓練分詞器（位元組級合併，繁體中文）→ 預訓練 → 指令微調（聊天樣板）→ 匯出 ONNX q8 → 重新載入核對。可選架構：密集、專家混合（每層多個專家）、推理（思考＋答案，再用可核對答案的算術題做強化學習）；可調層數、寬度與分組查詢注意力。模型是 Qwen3 同型，約 2 百萬到 2 千萬參數。",sources:["你自己的文字檔或資料夾；留空＝內建小語料（只夠示範）","指令微調資料（每行一筆對話的 .jsonl）；留空＝內建 34 筆範例（推理架構改用程式產生的算術題）"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"}],outputs:[{id:"lora",label:"LoRA 小檔",available:!1,formats:[],reason:"這個類型是從零開始建整顆模型，不產生 LoRA 小檔。要在這顆模型上訓練 LoRA，請用輸出裡的標準格式資料夾當基底，走「語言模型」類型。"},{id:"full",label:"完整模型（ONNX q8 與標準格式）",available:!0,formats:["ONNX q8（模型檔加分詞器檔）","標準 Qwen3 或 Qwen3 專家混合格式（safetensors、設定檔、分詞器檔）"],note:"輸出放在外部訓練資料夾；還沒有自動收進「離線模型」清單，要手動複製到離線模型資料夾。GGUF 沒做。鍵值頭數不是 8 的模型只輸出標準格式，原生執行環境載不了。"}],gap:"實測（命令列；機器忙碌時量的）。密集迷你模型（13,480,288 參數，語料 1.6 百萬字，預訓練 150 步約 7.7 萬個詞元）：分詞器在留出文字上 3.19 位元組／詞元，編碼後可還原；預訓練留出困惑度 4170→1372；指令微調（150 步）留出困惑度 4100→2070，學會用結束標記收尾，但回答只是標點，不是答案。匯出：ONNX 全精度與訓練框架輸出最大差約百萬分之一點四，q8 貪婪輸出一致，重新載入逐字一致，原生執行環境載入並生成、兩個獨立程序輸出逐位元相同。專家混合對照密集（實驗用 4 層，每個詞元用到的參數相同：都是 256 萬；專家混合總參數 433 萬；600 步）：留出損失 密集 5.926、專家混合 6.011（種子 0）；密集 5.892、專家混合 5.847（種子 1），差距小於種子差異，看不出誰比較好；專家負載平衡（最忙的專家是均勻的 1.46 倍，沒有閒置專家）。推理（2 百萬級模型，算術題 150 題留出）：不思考直接答 44.7%、思考＋答案微調 54.7%、再加強化學習 62.0%（題數少，差距的誤差約 4 個百分點）；原生執行環境只能用不思考模式。限制：沒有可用的聊天品質；推理只在兩位數加減乘上驗證；專家混合匯出到原生執行環境時所有專家都會算，沒有省算力；原生執行環境寫死鍵值頭數 8、每頭維度 128、最多 28 層，淺層模型以 28 層介面補齊；結束標記不在它的停止清單裡。",can:["從工作室選架構（密集、專家混合、推理）後按開始，跑完全流程並核對（處理器）","輸出 ONNX q8 與標準格式，兩者都用另一條路徑載入核對過（專家混合也一樣）","用自己的語料與指令微調資料；調層數、寬度、專家數與分組查詢注意力"],cannot:["訓練出能可靠回答一般問題的模型（需要數十倍以上的詞元與時間）","輸出 GGUF","在原生執行環境用思考模式（它固定送出空的思考區塊）","讓專家混合在原生執行環境省算力","自動註冊進離線模型清單"]},{id:"context_extend",name:"加長上下文（語言模型）",status:"done",ext:"context_extend",summary:"把語言模型的上下文加寬為 2 倍或 4 倍（旋轉位置內插），用長文做一段 LoRA 微調，合併後輸出新的完整模型（ONNX q8），應用程式的上下文上限依新模型的設定放寬。",sources:["專案內的長文（設計文件，自動準備；留出文件不進訓練）"],backends:[{id:"cpu-py",label:"純處理器（Python，桌面版）"}],outputs:[{id:"lora",label:"LoRA 小檔",available:!1,formats:[],reason:"加長上下文的產物是完整模型（旋轉表與權重都改了），不是 LoRA 小檔。"},{id:"full",label:"完整模型（ONNX q8，加長上下文）",available:!0,formats:["ONNX q8（與應用程式內的圖結構相同）"],note:"輸出放在外部訓練資料夾；應用程式是否改用這個模型，見設計文件第 16 節。"}],gap:"（見設計文件第 16 節的實測數字與未量測項目。）",can:["從工作室選來源模型與目標倍數（2 或 4），按開始：長文微調、替換旋轉表與線性層、寫 ONNX q8、以執行環境核對","估計記憶體（鍵值快取）與時間"],cannot:["在處理器上量 4 倍（163840 權杖）的品質","把新模型換進應用程式（需要另外的接線）"]}];function n(e){for(var n=0;n<t.length;n++)if(t[n].id===e)return t[n];return null}function r(e,t){return"done"===e.status||!0===t}return{TYPES:t,STATUS_LABEL:e,find:n,listFor:function(n){return t.filter(function(e){return r(e,n)}).map(function(t){return{id:t.id,name:t.name,status:t.status,badge:"done"===t.status?"":e[t.status],label:t.name+("done"===t.status?"":"（"+e[t.status]+"）"),summary:t.summary,sources:t.sources.slice(),backends:t.backends.slice(),outputs:t.outputs.map(function(e){return Object.assign({},e,{formats:(e.formats||[]).slice()})}),gap:t.gap||"",can:t.can.slice(),cannot:t.cannot.slice(),goal:t.goal||null}})},canStart:function(t,s,a){var i=n(t);if(!i)return{level:"blocked",ok:!1,message:"找不到這個模型類型（"+t+"）。請重新選擇。",can:[],cannot:[]};if(!r(i,a))return{level:"blocked",ok:!1,message:"「"+i.name+"」是"+e[i.status]+"，要先到設定開啟「顯示半成品的功能」才能選。",can:[],cannot:[]};if("done"===i.status){var o=i.outputs.filter(function(e){return e.id===s})[0]||i.outputs[0];return o.available?{level:"run",ok:!0,message:"可以訓練："+i.name+"，輸出「"+o.label+"」。",can:i.can.slice(),cannot:[]}:{level:"blocked",ok:!1,message:"「"+o.label+"」目前不能輸出："+(o.reason||"還沒有這種輸出。")+"請改選其他輸出。",can:i.can.slice(),cannot:[]}}return"half"===i.status?{level:"partial",ok:!1,message:"「"+i.name+"」目前是半成品，工作室還不能產生模型。目前能做到："+i.can.join("；")+"。還不能做："+i.cannot.join("；")+"。"+i.gap,c