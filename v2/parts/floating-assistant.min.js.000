wered.\n//\n// Limits on purpose (see DESIGN.skill-gui-bridge.md): --progress shows the bar and returns at once (it does not read stdin, and a\n// virtual command cannot sit in a pipe); --file-selection, --calendar, --scale, --notification, --forms and friends are refused with\n// exit 1 and a clear message. Row values with the same visible text in a --list are matched by their first occurrence.\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatZenity = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n\n  var MODES = { info: true, warning: true, error: true, question: true, entry: true, password: true, progress: true };\n  var UNSUPPORTED = ['file-selection', 'calendar', 'scale', 'notification', 'color-selection', 'forms', 'text-info', 'about', 'password-dialog'];\n  var VALUE_OPTS = { title: true, text: true, width: true, height: true, timeout: true, 'ok-label': true, 'cancel-label': true, 'entry-text': true,\n    column: true, 'hide-column': true, 'print-column': true, separator: true, percentage: true, 'window-icon': true, 'icon-name': true };\n  var FLAG_OPTS = { 'auto-close': true, pulsate: true, multiple: true, 'no-wrap': true, 'no-markup': true, ellipsize: true, modal: true,\n    'hide-header': true, editable: true, 'hide-text': true, 'default-cancel': true };\n  var MAX_ROWS = 150;   // one checkbox or list item per row; the bridge allows 200 nodes per window\n  var DEFAULT_TITLE = { info: 'Information', warning: 'Warning', error: 'Error', question: 'Question', entry: 'Enter a value', password: 'Enter password', progress: 'Progress', list: 'Select', checklist: 'Select', radiolist: 'Select' };\n\n  function fail(error) { return { ok: false, error: error }; }\n  function num(v, name, lo, hi, dflt) {\n    if (v === undefined) { return dflt; }\n    var n = parseFloat(v);\n    if (!isFinite(n)) { throw new Error('--' + name + ' needs a number'); }\n    return Math.min(hi, Math.max(lo, n));\n  }\n  function isListMode(mode) { return mode === 'list' || mode === 'checklist' || mode === 'radiolist'; }\n\n  // zenity's own argument form: `--name value`, `--name=value`, flags as `--name`. Words that do not start with -- are rows for --list.\n  function parse(words) {\n    var mode = null, listSeen = false, variant = null, opts = { columns: [] }, positional = [], error = null;\n    try {\n      for (var i = 0; i < words.length; i++) {\n        var w = String(words[i]);\n        if (w.indexOf('--') !== 0) { positional.push(w); continue; }\n        var name = w.slice(2), value = null, eq = name.indexOf('=');\n        if (eq !== -1) { value = name.slice(eq + 1); name = name.slice(0, eq); }\n        if (UNSUPPORTED.indexOf(name) !== -1) { return fail('--' + name + ' is not supported by the bridge (use the GUI bridge directly for that)'); }\n        if (MODES.hasOwnProperty(name)) {\n          if (mode && mode !== name) { return fail('only one dialog type can be given'); }\n          mode = name;\n          continue;\n        }\n        if (name === 'list') { listSeen = true; continue; }\n        if (name === 'checklist' || name === 'radiolist') { listSeen = true; variant = name; continue; }\n        if (VALUE_OPTS.hasOwnProperty(name)) {\n          if (value === null) {\n            if (i + 1 >= words.length) { return fail('--' + name + ' needs a value'); }\n            value = String(words[++i]);\n          }\n          if (name === 'column') { opts.columns.push(value); } else { opts[name] = value; }\n          continue;\n        }\n        if (FLAG_OPTS.hasOwnProperty(name)) { opts[name] = true; continue; }\n        return fail('unknown option --' + name);\n      }\n    } catch (e) {\n      return fail(e.message || String(e));\n    }\n    if (listSeen) {\n      if (mode) { return fail('a list cannot be combined with --' + mode); }\n      mode = variant || 'list';\n    }\n    if (!mode) { return fail('pick a dialog: --info, --warning, --error, --question, --entry, --password, --list, --checklist, --radiolist or --progress'); }\n\n    var out = { ok: true, mode: mode, opts: opts, title: opts.title !== undefined ? opts.title : DEFAULT_TITLE[mode] };\n    try {\n      out.width = num(opts.width, 'width', 160, 1200, 420);\n      out.timeout = num(opts.timeout, 'timeout', 0, 300, 0);      // 0 = no timeout\n      out.percentage = num(opts.percentage, 'percentage', 0, 100, 0);\n    } catch (e) { return fail(e.message); }\n    if (opts.separator === undefined) { out.separator = '|'; } else { out.separator = opts.separator; }\n\n    if (isListMode(mode)) {\n      var n = opts.columns.length;\n      if (!n) { return fail('--' + mode + ' needs at least one --column'); }\n      if (positional.length % n !== 0) { return fail('rows must come in groups of ' + n + ' values (one per --column)'); }\n      var rowCount = positional.length / n;\n      if (rowCount > MAX_ROWS) { return fail('at most ' + MAX_ROWS + ' rows'); }\n      out.rows = [];\n      for (var r = 0; r < rowCount; r++) { out.rows.push(positional.slice(r * n, r * n + n)); }\n      out.flagged = mode === 'checklist' || mode === 'radiolist';     // first column is TRUE/FALSE\n      if (out.flagged) {\n        for (var k = 0; k < out.rows.length; k++) {\n          if (out.rows[k][0] !== 'TRUE' && out.rows[k][0] !== 'FALSE') { return fail('row ' + (k + 1) + ': the first column must be TRUE or FALSE'); }\n        }\n      }\n      out.multiple = mode === 'checklist' || !!opts.multiple;\n      out.hideColumn = opts['hide-column'] !== undefined ? parseInt(opts['hide-column'], 10) : null;\n      out.printColumn = opts['print-column'] !== undefined ? parseInt(opts['print-column'], 10) : (out.flagged ? 2 : 1);\n      if (!(out.printColumn >= 1 && out.printColumn <= n)) { return fail('--print-column must be between 1 and ' + n); }\n      if (out.hideColumn !== null && !(out.hideColumn >= 1 && out.hideColumn <= n)) { return fail('--hide-column must be between 1 and ' + n); }\n      out.displayCols = [];\n      for (var c = 0; c < n; c++) {\n        if (out.flagged && c === 0) { continue; }\n        if (out.hideColumn === c + 1) { continue; }\n        out.displayCols.push(c);\n      }\n      out.labels = out.rows.map(function (row) { return out.displayCols.map(function (c) { return row[c]; }).join(' | '); });\n    } else if (positional.length) {\n      out.text = positional.join(' ');\n    }\n    return out;\n  }\n\n  // The window for the dialog, as AiChatGuiBridge messages (without \"v\"). Node ids: msg, val (entry), pick (list), c0.. (checkboxes), bar, ok, cancel.\n  function build(parsed, winId) {\n    var o = parsed.opts, mode = parsed.mode, msgs = [];\n    var text = o.text !== undefined ? o.text : (parsed.text || '');\n    msgs.push({ op: 'open', id: winId, title: parsed.title || '', width: parsed.width });\n    msgs.push({ op: 'add', id: winId, node: { id: 'msg', kind: 'label', text: text } });\n    function add(node, parent) { msgs.push({ op: 'add', id: winId, parent: parent || 'root', node: node }); }\n    function buttons() {\n      var row = { id: 'buttons', kind: 'row' };\n      add(row);\n      add({ id: 'ok', kind: 'button', text: o['ok-label'] || 'OK' }, 'buttons');\n      if (mode !== 'info' && mode !== 'warning' && mode !== 'error' && mode !== 'progress') {\n        add({ id: 'cancel', kind: 'button', text: o['cancel-label'] || 'Cancel' }, 'buttons');\n      }\n    }\n    if (mode === 'progress') {\n      add({ id: 'bar', kind: 'progress', value: parsed.opts.pulsate ? 0 : parsed.percentage, max: 100 });\n    } else if (mode === 'entry' || mode === 'password') {\n      add({ id: 'val', kind: 'entry', value: o['entry-text'] !== undefined ? o['entry-text'] : '', secret: mode === 'password' || !!o['hide-text'] });\n      buttons();\n    } else if (isListMode(mode)) {\n      if (parsed.multiple) {\n        parsed.labels.forEach(function (label, i) {\n          add({ id: 'c' + i, kind: 'checkbox', text: label, checked: parsed.flagged ? parsed.rows[i][0] === 'TRUE' : false });\n        });\n      } else {\n        var pick = { id: 'pick', kind: 'list', items: parsed.labels };\n        var preset = parsed.flagged ? parsed.rows.findIndex(function (row) { return row[0] === 'TRUE'; }) : -1;\n        if (preset >= 0) { pick.selected = parsed.labels[preset]; }\n        add(pick);\n      }\n      buttons();\n    } else {\n      buttons();\n    }\n    return msgs;\n  }\n\n  // The answer state for a dialog, before any event.\n  function start(parsed) {\n    var st = { value: parsed.opts['entry-text'] !== undefined ? parsed.opts['entry-text'] : '', selected: -1, checked: [] };\n    if (isListMode(parsed.mode)) {\n      st.checked = parsed.rows.map(function (row) { return parsed.flagged && row[0] === 'TRUE'; });\n      if (!parsed.multiple) { st.selected = parsed.flagged ? parsed.rows.findIndex(function (row) { return row[0] === 'TRUE'; }) : -1; }\n    }\n    return st;\n  }\n\n  function printed(parsed, index) { return parsed.rows[index][parsed.printColumn - 1]; }\n\n  // One event from the window (the parsed JSON of a bridge event line). Returns null while the dialog is open, or {exit_code, stdout}.\n  function onEvent(parsed, st, ev) {\n    if (!ev) { return null; }\n    if (ev.event === 'close') { return { exit_code: 1, stdout: '' }; }\n    if (ev.event === 'input' && ev.node === 'val') { st.value = String(ev.value); return null; }\n    if (ev.event === 'change' && /^c\\d+$/.test(ev.node)) { st.checked[parseInt(ev.node.slice(1), 10)] = !!ev.value; return null; }\n    if (ev.event === 'select' && ev.node === 'pick') { st.selected = parsed.labels.indexOf(String(ev.value)); return null; }\n    if (ev.event !== 'click') { return null; }\n    if (ev.node === 'cancel') { return { exit_code: 1, stdout: '' }; }\n    if (ev.node !== 'ok') { return null; }\n    var mode = parsed.mode;\n    if (mode === 'entry' || mode === 'password') { return { exit_code: 0, stdout: st.value + '\\n' }; }\n    if (mode === 'info' || mode === 'warning' || mode === 'error' || mode === 'question' || mode === 'progress') { return { exit_code: 0, stdout: '' }; }\n    if (parsed.multiple) {\n      var picked = [];\n      st.checked.forEach(function (on, i) { if (on) { picked.push(printed(parsed, i)); } });\n      return { exit_code: 0, stdout: picked.length ? picked.join(parsed.separator) + '\\n' : '' };\n    }\n    if (st.selected < 0) { return { exit_code: 1, stdout: '' }; }\n    return { exit_code: 0, stdout: printed(parsed, st.selected) + '\\n' };\n  }\n\n  // --progress does not wait for its window (no stdin in this version): the terminal opens the window and returns exit 0 at once.\n  function immediate(parsed) { return parsed.mode === 'progress' ? { exit_code: 0, stdout: '' } : null; }\n\n  return { parse: parse, build: build, start: start, onEvent: onEvent, immediate: immediate, MAX_ROWS: MAX_ROWS };\n}));\n",FA_GUI_HOST_SRC="// GUI 視窗主機：擁有一個終端機 session 的所有 GUI 視窗（開、關、重繪、事件佇列）。\n// 協定由 AiChatGuiBridge 檢查（上限 4 視窗、每視窗節點數等）；畫面由 AiChatGuiRender 畫進 container 裡的浮層。\n// 這裡不直接碰 DOM 的細節：doc、container、bridge、render 都由呼叫端傳入，所以 node 測試可以用假的 render。\n// 事件先進每視窗的佇列（上限 50）：frame 只留最新一個，連續的 mouse move 合併成一個。\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatGuiHost = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n  var QUEUE_MAX = 50;\n\n  // opts: { doc, container, bridge, render, onClosed(winId), decorate(el, {id, title, bar, minW, minH, floating, onChange}) -> controller or null }\n  // decorate (optional) is the app's window shell (FaWin: popped window, drag, edge resize, maximize over the whole page). It is used for windows that\n  // asked to be resizable or maximizable; a window the shell cannot decorate keeps the plain resize corner and the renderer's own maximize button.\n  function createHost(opts) {\n    var doc = opts.doc, container = opts.container, bridge = opts.bridge, render = opts.render;\n    var session = bridge.createSession();\n    var layer = null, views = {}, queues = {}, waiters = {}, pictures = {}, prevPictures = {}, shells = {}, externs = {};\n    var presentedCount = 0;   // 頁面實際畫出的零拷貝畫面張數（量測用）\n    var bitmaps = {};   // winId/nodeId → 最後一張送來的 ImageBitmap（見 present；視窗重畫時要再畫一次）\n\n    function ensureLayer() {\n      if (!layer) {\n        layer = doc.createElement('div');\n        layer.className = 'ai-gui-layer';\n        if (layer.style) { layer.style.cssText = 'position:absolute;left:0;top:0;right:0;bottom:0;overflow:auto;pointer-events:none;'; }\n        container.appendChild(layer);\n      }\n      return layer;\n    }\n\n    // one event line from the page, queued for the window (frame and mouse move are merged)\n    function enqueue(winId, name, line) {\n      var q = queues[winId] || (queues[winId] = []);\n      var move = name === 'mouse' && /\"kind\":\"move\"/.test(line);\n      if (name === 'frame' || name === 'caret') { for (var i = q.length - 1; i >= 0; i--) { if (q[i].name === name && (name === 'frame' || q[i].node === nodeOf(line))) { q.splice(i, 1); } } }\n      else if (move && q.length && q[q.length - 1].move) { q.pop(); }\n      q.push({ name: name, line: line, move: move, node: name === 'caret' ? nodeOf(line) : null });\n      if (q.length > QUEUE_MAX) { q.shift(); }\n      var w = waiters[winId];\n      if (w && q.length) { delete waiters[winId]; w(take(winId)); }\n    }\n    function nodeOf(line) { try { return JSON.parse(line).node; } catch (e) { return null; } }\n    function take(winId) { var q = queues[winId] || []; return q.length ? q.shift().line : null; }\n\n    function onEventFor(winId) {\n      return function (name, nodeId, value) {\n        var line = bridge.eventLine(session, winId, nodeId, name, value);\n        if (line) { enqueue(winId, name, line); }\n        // resizing a canvas clears it (2D and WebGL alike): draw the last frame again, so a program that only draws when something changes\n        // does not show an empty canvas\n        if (name === 'resize') { repaintCanvas(winId, nodeId); }\n      };\n    }\n\n    // pictures: the decoded Image for a canvas picture name (created once from the checked data URL)\n    function picture(winId, nodeId, name) {\n      var win = session.windows[winId], node = win && win.nodes[nodeId];\n      var data = node && node.images && node.images[name];\n      if (!data) { return null; }\n      var key = winId + '/' + nodeId + '/' + name;\n      if (!pictures[key] || pictures[key].src !== data) {\n        var img = new (doc.defaultView || root).Image();\n        // a picture registered again under the same name (a program that redraws a rendered frame): keep showing the last decoded one\n        // until the new one has loaded, so the canvas does not flash empty\n        if (pictures[key] && pictures[key].complete) { prevPictures[key] = pictures[key]; }\n        img.src = data;\n        img.onload = function () { delete prevPictures[key]; repaintCanvas(winId, nodeId); };\n        pictures[key] = img;\n      }\n      return pictures[key].complete ? pictures[key] : (prevPictures[key] || null);\n    }\n\n    function removeView(winId) {\n      var v = views[winId];\n      if (shells[winId]) { try { shells[winId].destroy(); } catch (e) { /* the shell is gone with the window */ } delete shells[winId]; }\n      if (v && v.parentNode) { v.parentNode.removeChild(v); }\n      delete views[winId];\n    }\n\n    function show(winId) {\n      var snap = bridge.snapshot(session, winId);\n      if (!snap) { return; }\n      var old = views[winId];\n      var wasActive = !!(old && old.classList && old.classList.contains('ai-chat-wheel-on'));\n      var wasPopped = !!(shells[winId] && shells[winId].isPopped());\n      var hadShell = !!shells[winId];\n      // 視窗外殼（可縮放、可最大化的視窗）的位置與大小也要保留：外殼是套在同一個元素上，所以樣式還在 old.style 裡\n      var prev = old && old.style ? {\n        left: old.style.left, top: old.style.top, width: old.style.width, height: old.style.height, maxWidth: old.style.maxWidth,\n        resized: !!(old.style.height || (old.getAttribute && old.getAttribute('data-saved'))),\n        saved: old.getAttribute ? old.getAttribute('data-saved') : null\n      } : null;\n      removeView(winId);\n      var view = render.renderWindow(doc, snap, onEventFor(winId), function () { closeByUser(winId); }, {\n        image: function (nodeId, name) { return picture(winId, nodeId, name); }\n      });\n      views[winId] = view;\n      // the canvas takes the pointer and the wheel only after a click into its window: gui_render.js checks the ai-chat-wheel-on class on\n      // an ancestor. Set it in the capture phase so it is already there when the canvas's own mousedown listener runs, and keep it across\n      // a re-show (add, set) of the same window.\n      if (wasActive) { view.classList.add('ai-chat-wheel-on'); }\n      if (view.addEventListener) { view.addEventListener('mousedown', function () { view.classList.add('ai-chat-wheel-on'); }, true); }\n      // a window sits in the layer at its own spot; pointer events are on again for the window itself\n      if (view.style) {\n        // the look (colors, font, border, shadow) comes from the stylesheet and the window's palette variables (gui_render.js GUI_CSS)\n        view.style.cssText = 'position:absolute;left:12px;top:12px;pointer-events:auto;box-sizing:border-box;width:' + snap.width + 'px;'\n          // a window with a first height keeps it (the body's grow areas fill it); a resizable one: the corner drags (CSS resize), the content never spills out\n          + (snap.height ? 'height:' + snap.height + 'px;' : '')\n          + (snap.resizable ? 'resize:both;overflow:hidden;min-width:200px;min-height:120px;' : '');\n        // a re-show (add, set) keeps the place and size the user gave the window, and a maximized window stays maximized\n        if (prev) {\n          if (prev.left) { view.style.left = prev.left; }\n          if (prev.top) { view.style.top = prev.top; }\n          if (prev.resized) { view.style.width = prev.width; view.style.height = prev.height; }\n          if (prev.maxWidth) { view.style.maxWidth = prev.maxWidth; }\n          if (prev.saved) {\n            view.setAttribute('data-saved', prev.saved);\n            var mb = view.querySelector && view.querySelector('.gui-maximize');\n            if (mb) { mb.textContent = '❐'; }\n          }\n        }\n      }\n      // the window's own style text replaced the theme's colors above: put the theme back\n      if (render.applyTheme) { render.applyTheme(view, snap.theme); }\n      ensureLayer().appendChild(view);\n      if (opts.decorate) {   // 所有視窗都套外殼：從終端機開出的視窗一開始就彈出到整個頁面上（拖曳、縮放、最大化都不受終端機範圍限制）\n        var bar = view.querySelector && view.querySelector('.gui-titlebar');\n        var ctl = null;\n        try {\n          ctl = opts.decorate(view, {\n            id: 'gui-' + snap.title, title: snap.title, bar: bar, minW: 240, minH: 160, floating: hadShell ? wasPopped : true,\n            // a popped window has the shell's own edge handles: the CSS corner would double them\n            onChange: function (st) { if (view.style) { view.style.resize = st.popped ? 'none' : (snap.resizable ? 'both' : ''); } }\n          });\n        } catch (e) { ctl = null; }\n        if (ctl) {\n          shells[winId] = ctl;\n          // the shell appended its buttons after the close button: style them like the others and put the close button last (right edge)\n          if (bar && bar.querySelectorAll) {\n            Array.prototype.forEach.call(bar.querySelectorAll('button'), function (b) { if (!b.style.cssText) { b.style.cssText = render.CONTROL_BUTTON_CSS || ''; } });\n            var cl = bar.querySelector('.gui-close');\n            if (cl) { bar.appendChild(cl); }\n          }\n          // the shell has its own maximize button\n          var own = view.querySelector('.gui-maximize');\n          if (own && own.parentNode) { own.parentNode.removeChild(own); }\n        }\n      }\n    }\n\n    function repaintCanvas(winId, nodeId) {\n      var view = views[winId];\n      var el = view && view.querySelector ? view.querySelector('[data-node=\"' + nodeId + '\"]') : null;\n      var win = session.windows[winId], node = win && win.nodes[nodeId];\n      if (!el || !node || node.kind !== 'canvas') { return; }\n      var bkey = winId + '/' + nodeId;\n      if (bitmaps[bkey]) {\n        if (node.frame && node.frame.length) { closeBitmap(bkey); }   // 程式後來又用 draw 畫了：以 draw 為準\n        else { drawBitmap(el, bitmaps[bkey]); return; }\n      }\n      if (node.gl) {\n        render.paintGl(el, node, function (msg) { var line = bridge.eventLine(session, winId, nodeId, 'glerror', msg); if (line) { enqueue(winId, 'glerror', line); } }, function (name) { return externs[winId + '/' + nodeId + '/' + name] || null; });\n        // 量測用的鉤子（沒有就什麼都不做）：每畫完一幀 GL，呼叫 FA_GUI_AFTER_GLFRAME(視窗, 節點, 第幾幀)，評測要在同一幀比像素\n        if (typeof globalThis.FA_GUI_AFTER_GLFRAME === 'function') { globalThis.FA_GUI_AFTER_GLFRAME(winId, nodeId, node.glframeSeq); }\n        return;\n      }\n      var ctx = el.getContext ? el.getContext('2d') : null;\n      if (!ctx) { return; }\n      var ops = node.frame || [];\n      // adaptive: a frame whose measured cost (ops x the page's own ms-per-op, learned from earlier frames) would take longer than a few\n      // milliseconds is painted at most once per animation frame, the newest one, so a program that draws faster than the screen refreshes\n      // (or draws huge frames) cannot freeze the window. Small frames are painted at once, as before.\n      var raf = (doc.defaultView || root).requestAnimationFrame;\n      if (typeof raf === 'function' && ops.length * opCostMs > BIG_FRAME_MS) {\n        var key = winId + '/' + nodeId;\n        if (!framePending[key]) {\n          framePending[key] = true;\n          raf.call(doc.defaultView || root, function () {\n            delete framePending[key];\n            var w2 = session.windows[winId], n2 = w2 && w2.nodes[nodeId];\n            if (!n2 || !views[winId]) { return; }\n            paintNow(ctx, winId, nodeId, el, n2);\n          });\n        }\n        return;\n      }\n      paintNow(ctx, winId, nodeId, el, node);\n    }\n\n    var opCostMs = 0.01, framePending = {}, BIG_FRAME_MS = 6;   // opCostMs: learned milliseconds per drawing command (starts at a guess)\n    function nowMs() { var p = (doc.defaultView || root).performance; return p && p.now ? p.now() : Date.now(); }\n    function paintNow(ctx, winId, nodeId, el, node) {\n      var ops = node.frame || [], t0 = nowMs();\n      render.paintFrame(ctx, ops, el.width, el.height, function (name) { return picture(winId, nodeId, name); }, !!node.transparent);\n      if (ops.length >= 20) { opCostMs = opCostMs * 0.8 + 0.2 * ((nowMs() - t0) / ops.length); }\n    }\n\n    function closeBitmap(key) { var b = bitmaps[key]; delete bitmaps[key]; if (b && b.close) { try { b.close(); } catch (e) { /* 已經關了 */ } } }\n    function drawBitmap(el, bmp) {\n      var ctx = el.getContext ? el.getContext('2d') : null;\n      if (ctx) { ctx.drawImage(bmp, 0, 0, el.width, el.height); }\n    }\n    // 零拷貝的畫面：程式在 Worker 裡用 WebGL2／SDL 畫好，OffscreenCanvas 的 ImageBitmap（GPU 上的點陣圖，經 postMessage 轉移所有權，沒有編碼也沒有複製）\n    // 直接畫到視窗的畫布上。回傳 true＝畫了；false＝沒有這個視窗或畫布（點陣圖會被關掉）。\n    function present(winId, nodeId, bmp) {\n      var view = views[winId], el = view && view.querySelector ? view.querySelector('[data-node=\"' + nodeId + '\"]') : null;\n      var win = session.windows[winId], node = win && win.nodes[nodeId];\n      if (!el || !node || node.kind !== 'canvas' || node.gl) { if (bmp && bmp.close) { try { bmp.close(); } catch (e) { /* */ } } return false; }\n      var key = winId + '/' + nodeId, old = bitmaps[key];\n      drawBitmap(el, bmp);\n      presentedCount++;\n      bitmaps[key] = bmp;\n      if (old && old.close) { try { old.close(); } catch (e) {