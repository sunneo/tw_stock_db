e<T>; awaiting it gives Result<T, JoinError> (Err if the task panicked or was cancelled)"}},"tokio::time::sleep":{summary:"Asynchronously waits for the duration (does not block the thread).",parameters:[{name:"duration",meaning:"how long to wait"}],return:{meaning:"a future that completes after the duration"}},"rusqlite::Connection::open":{summary:"Opens (or creates) a SQLite database file.",parameters:[{name:"path",meaning:"database file path"}],return:{meaning:"Result<Connection>"}}},go:{"os.Open":{summary:"Opens a file READ-ONLY.",parameters:[{name:"name",meaning:"file path"}],return:{meaning:"(*os.File, error): error is non-nil if the file does not exist or cannot be opened; remember to Close() it"}},"os.Create":{summary:"Creates or TRUNCATES a file and opens it for reading and writing.",parameters:[{name:"name",meaning:"file path"}],return:{meaning:"(*os.File, error)"}},"os.OpenFile":{summary:"Opens a file with explicit flags and permissions.",parameters:[{name:"name",meaning:"file path"},{name:"flag",meaning:"O_RDONLY/O_WRONLY/O_RDWR | O_APPEND | O_CREATE | O_TRUNC | O_EXCL"},{name:"perm",meaning:"permission bits used when the file is created (before umask)"}],return:{meaning:"(*os.File, error)"}},"os.ReadFile":{summary:"Reads a whole file into memory.",parameters:[{name:"name",meaning:"file path"}],return:{meaning:"([]byte, error)"}},"os.WriteFile":{summary:"Writes data to a file, creating or TRUNCATING it.",parameters:[{name:"name",meaning:"file path"},{name:"data",meaning:"bytes to write"},{name:"perm",meaning:"permission bits used when the file is created"}],return:{meaning:"error (nil on success)"}},"os.Remove":{summary:"Deletes a file or an empty directory. Destructive.",parameters:[{name:"name",meaning:"path"}],return:{meaning:"error (nil on success)"}},"os.RemoveAll":{summary:"Recursively deletes a path. Destructive.",parameters:[{name:"path",meaning:"file or directory tree"}],return:{meaning:"error (nil on success, also nil if the path does not exist)"}},"os.MkdirAll":{summary:"Creates a directory and all missing parents.",parameters:[{name:"path",meaning:"directory path"},{name:"perm",meaning:"permission bits for newly created directories"}],return:{meaning:"error (nil on success, also nil if it already exists)"}},"os.Exit":{summary:"Ends the process immediately with the status code (deferred functions do NOT run).",parameters:[{name:"code",meaning:"exit status (0 = success)"}],return:{meaning:"does not return"}},"os.Getenv":{summary:"Reads an environment variable.",parameters:[{name:"key",meaning:"variable name"}],return:{meaning:'the value, or "" when unset (use LookupEnv to tell "unset" from "empty")'}},"os.LookupEnv":{summary:"Reads an environment variable and reports whether it is set.",parameters:[{name:"key",meaning:"variable name"}],return:{meaning:"(value string, found bool)"}},"http.Get":{summary:"Sends an HTTP GET using the default client (no timeout!).",parameters:[{name:"url",meaning:"request URL"}],return:{meaning:"(*http.Response, error): error only for transport failures - a 404/500 is a normal response; the caller must Close() resp.Body"}},"http.Post":{summary:"Sends an HTTP POST using the default client (no timeout!).",parameters:[{name:"url",meaning:"request URL"},{name:"contentType",meaning:"Content-Type header value"},{name:"body",meaning:"io.Reader with the request body"}],return:{meaning:"(*http.Response, error); the caller must Close() resp.Body"}},"http.ListenAndServe":{summary:"Starts an HTTP server and blocks serving requests.",parameters:[{name:"addr",meaning:'listen address, e.g. ":8080"'},{name:"handler",meaning:"http.Handler; nil means http.DefaultServeMux"}],return:{meaning:"error: always non-nil when it returns (the server stopped or could not bind)"}},"http.HandleFunc":{summary:"Registers a handler function for a URL pattern on the default mux.",parameters:[{name:"pattern",meaning:"URL path pattern"},{name:"handler",meaning:"func(http.ResponseWriter, *http.Request)"}],return:{meaning:"nothing"}},"net.Dial":{summary:"Opens a network connection (blocks until connected or failed).",parameters:[{name:"network",meaning:'"tcp", "udp", "unix", ...'},{name:"address",meaning:'"host:port"'}],return:{meaning:"(net.Conn, error)"}},"net.Listen":{summary:"Starts listening on a local address.",parameters:[{name:"network",meaning:'"tcp", "unix", ...'},{name:"address",meaning:'local address, e.g. ":8080"'}],return:{meaning:"(net.Listener, error); call Accept() in a loop"}},"exec.Command":{summary:"Prepares an external command (nothing runs until Run/Start/Output).",parameters:[{name:"name",meaning:"program (looked up in PATH)"},{name:"arg",meaning:"arguments, passed WITHOUT a shell"}],return:{meaning:"*exec.Cmd"}},"exec.CommandContext":{summary:"Like exec.Command but the process is killed when the context ends.",parameters:[{name:"ctx",meaning:"context controlling the process lifetime"},{name:"name",meaning:"program"},{name:"arg",meaning:"arguments"}],return:{meaning:"*exec.Cmd"}},"json.Marshal":{summary:"Encodes a value as JSON.",parameters:[{name:"v",meaning:"any value"}],return:{meaning:"([]byte, error): error for unsupported types (channels, funcs, cycles)"}},"json.Unmarshal":{summary:"Decodes JSON into a value.",parameters:[{name:"data",meaning:"JSON bytes"},{name:"v",meaning:"POINTER to the destination"}],return:{meaning:"error: non-nil on malformed JSON or a type mismatch (the destination may be partly filled)"}},"sql.Open":{summary:"Prepares a database handle - it does NOT connect yet.",parameters:[{name:"driverName",meaning:'registered driver, e.g. "postgres"'},{name:"dataSourceName",meaning:"driver-specific connection string"}],return:{meaning:"(*sql.DB, error); call Ping() to verify the connection"}},"strconv.Atoi":{summary:"Parses a decimal integer.",parameters:[{name:"s",meaning:"text to parse"}],return:{meaning:"(int, error): error is non-nil if the text is not a valid int or out of range"}},"strconv.ParseInt":{summary:"Parses an integer in a given base and bit size.",parameters:[{name:"s",meaning:"text"},{name:"base",meaning:"0 = detect from prefix, else 2..36"},{name:"bitSize",meaning:"0, 8, 16, 32 or 64"}],return:{meaning:"(int64, error)"}},"time.Sleep":{summary:"Pauses the current goroutine for at least the duration.",parameters:[{name:"d",meaning:"time.Duration"}],return:{meaning:"nothing"}},"time.After":{summary:"Returns a channel that receives the current time once after the duration (leaks the timer until it fires).",parameters:[{name:"d",meaning:"time.Duration"}],return:{meaning:"<-chan time.Time"}},"context.WithTimeout":{summary:"Derives a context that is cancelled after the timeout.",parameters:[{name:"parent",meaning:"parent context"},{name:"timeout",meaning:"time.Duration"}],return:{meaning:"(context.Context, cancel func()); ALWAYS call cancel (usually defer cancel()) to release resources"}},"context.WithCancel":{summary:"Derives a cancellable context.",parameters:[{name:"parent",meaning:"parent context"}],return:{meaning:"(context.Context, cancel func()); call cancel to stop everything derived from it"}},".Lock":{summary:"Locks a sync.Mutex / RWMutex (blocks until acquired).",parameters:[],return:{meaning:"nothing; pair with Unlock, usually via defer"}},".Unlock":{summary:"Unlocks a sync.Mutex; unlocking an unlocked mutex is a fatal error.",parameters:[],return:{meaning:"nothing"}},".Wait":{summary:"Blocks until the sync.WaitGroup counter drops to zero (or until a sync.Cond is signalled, or until an exec.Cmd finishes).",parameters:[],return:{meaning:"nothing (WaitGroup/Cond) or error (exec.Cmd.Wait)"}},".Done":{summary:"Decrements the WaitGroup counter by one (call when a goroutine finishes; usually deferred).",parameters:[],return:{meaning:"nothing"}},panic:{summary:"Stops normal execution of the goroutine and unwinds, running deferred functions; crashes the program unless recovered.",parameters:[{name:"v",meaning:"any value describing the failure"}],return:{meaning:"does not return"}},recover:{summary:"Stops a panic in progress (only effective inside a deferred function).",parameters:[],return:{meaning:"the value passed to panic, or nil if the goroutine was not panicking"}},make:{summary:"Allocates and initializes a slice, map or channel.",parameters:[{name:"t",meaning:"slice/map/chan type"},{name:"size",meaning:"length (slice), capacity hint (map) or buffer size (chan)"}],return:{meaning:"the initialized value (not a pointer)"}},append:{summary:"Appends elements to a slice; may allocate a new backing array.",parameters:[{name:"s",meaning:"the slice"},{name:"elems",meaning:"elements to add"}],return:{meaning:"the resulting slice - you MUST assign it back (s = append(s, x))"}},copy:{summary:"Copies elements between slices.",parameters:[{name:"dst",meaning:"destination slice"},{name:"src",meaning:"source slice"}],return:{meaning:"the number of elements copied (min of both lengths)"}},"log.Fatal":{summary:"Prints to the standard logger, then ends the process with status 1 (deferred functions do NOT run).",parameters:[{name:"v",meaning:"values to print"}],return:{meaning:"does not return"}},"fmt.Println":{summary:"Prints values to standard output separated by spaces, with a newline.",parameters:[{name:"a",meaning:"values to print"}],return:{meaning:"(n int, err error) - usually ignored"}},"fmt.Printf":{summary:"Prints formatted text to standard output.",parameters:[{name:"format",meaning:"format string (%d %s %v ...)"},{name:"a",meaning:"values"}],return:{meaning:"(n int, err error) - usually ignored"}},"fmt.Sprintf":{summary:"Builds a formatted string (does not print).",parameters:[{name:"format",meaning:"format string (%d %s %v ...)"},{name:"a",meaning:"values"}],return:{meaning:"the formatted string"}},"fmt.Errorf":{summary:"Creates an error with a formatted message; %w wraps another error so errors.Is/As can see it.",parameters:[{name:"format",meaning:"format string"},{name:"a",meaning:"values"}],return:{meaning:"an error"}},"sort.Slice":{summary:"Sorts a slice in place using a less function (not stable).",parameters:[{name:"x",meaning:"the slice"},{name:"less",meaning:"func(i, j int) bool: true if element i must come before j"}],return:{meaning:"nothing"}},"rand.Intn":{summary:"Returns a pseudo-random int in [0, n) from math/rand (NOT cryptographically secure).",parameters:[{name:"n",meaning:"upper bound, must be > 0"}],return:{meaning:"a non-negative int below n; panics if n <= 0"}},"rand.Read":{summary:"Fills the slice with random bytes (crypto/rand is cryptographically secure; math/rand is not - check the import).",parameters:[{name:"b",meaning:"slice to fill"}],return:{meaning:"(n int, err error)"}}},csharp:{"File.ReadAllText":{summary:"Reads the ENTIRE text file into one string (opens, reads, closes).",parameters:[{name:"path",meaning:"file path"},{name:"encoding",meaning:"text encoding (default UTF-8 with BOM detection)"}],return:{meaning:"the file contents; throws FileNotFoundException / DirectoryNotFoundException / UnauthorizedAccessException / IOException on failure"}},"File.ReadAllTextAsync":{summary:"Asynchronously reads the ENTIRE text file into one string.",parameters:[{name:"path",meaning:"file path"},{name:"cancellationToken",meaning:"optional cancellation token"}],return:{meaning:"a Task<string> with the file contents (exceptions surface when awaited)"}},"File.ReadAllLines":{summary:"Reads a text file into a string[] with one element per line.",parameters:[{name:"path",meaning:"file path"}],return:{meaning:"the lines (without line terminators); throws on I/O failure"}},"File.WriteAllText":{summary:"Creates or OVERWRITES a file with the given text (opens, writes, closes).",parameters:[{name:"path",meaning:"file path"},{name:"contents",meaning:"the text to write"}],return:{meaning:"nothing (void); throws on I/O failure"}},"File.AppendAllText":{summary:"Appends text to the end of a file, creating it if it does not exist.",parameters:[{name:"path",meaning:"file path"},{name:"contents",meaning:"the text to append"}],return:{meaning:"nothing (void)"}},"File.Exists":{summary:"Checks whether a FILE exists at the path (returns false for directories and for any error such as a permission problem).",parameters:[{name:"path",meaning:"file path"}],return:{meaning:"true if the file exists",rules:[{when:{op:"==",value:1},meaning:"the file exists"},{when:{op:"==",value:0},meaning:"no file there (or the check itself failed)"}]}},"File.Delete":{summary:"Deletes the file; no error if the file does not exist (but the directory must).",parameters:[{name:"path",meaning:"file path"}],return:{meaning:"nothing (void)"}},"Directory.CreateDirectory":{summary:"Creates the directory and any missing parent directories; does nothing if it already exists.",parameters:[{name:"path",meaning:"directory path"}],return:{meaning:"a DirectoryInfo for the directory"}},"Path.Combine":{summary:"Joins path segments with the platform separator (a later rooted segment RESETS the path).",parameters:[{name:"paths",meaning:"the segments"}],return:{meaning:"the combined path string"}},"Console.WriteLine":{summary:"Writes the text followed by a newline to standard output.",parameters:[{name:"value",meaning:"text or object to print (formatted with ToString)"}],return:{meaning:"nothing (void)"}},"Console.Error.WriteLine":{summary:"Writes the text followed by a newline to standard ERROR.",parameters:[{name:"value",meaning:"text to print"}],return:{meaning:"nothing (void)"}},"Process.Start":{summary:"Starts an operating-system process (or opens a document/URL with its default program).",parameters:[{name:"startInfo",meaning:"ProcessStartInfo: file name, arguments, redirection, working directory"}],return:{meaning:"the Process object (null if an existing process was reused)"}},"Environment.GetEnvironmentVariable":{summary:"Reads one environment variable of the current process.",parameters:[{name:"variable",meaning:"variable name"}],return:{meaning:"its value, or null when it is not set",rules:[{when:{op:"==",value:0},meaning:"the variable is not set"}]}},"Environment.Exit":{summary:"Terminates the process immediately with the given exit code (finally blocks do NOT run for other threads).",parameters:[{name:"exitCode",meaning:"process exit code (0 = success)"}],return:{meaning:"never returns"}},"Thread.Sleep":{summary:"Blocks the CURRENT thread for the given time (use Task.Delay in async code).",parameters:[{name:"millisecondsTimeout",meaning:"how long to block, in ms"}],return:{meaning:"nothing (void)"}},"Task.Run":{summary:"Queues work on the thread pool and returns a Task for it.",parameters:[{name:"action",meaning:"the delegate to run"}],return:{meaning:"a Task (or Task<T>) you can await; exceptions surface when awaited"}},"Task.Delay":{summary:"Creates a Task that completes after the delay WITHOUT blocking a thread.",parameters:[{name:"delay",meaning:"milliseconds or TimeSpan"}],return:{meaning:"a Task to await"}},"JsonSerializer.Deserialize":{summary:"Parses JSON text into an object of the given type (System.Text.Json).",parameters:[{name:"json",meaning:"the JSON string or reader"},{name:"options",meaning:"optional JsonSerializerOptions"}],return:{meaning:"the object; throws JsonException on malformed JSON (null for the JSON literal null)"}},"JsonSerializer.Serialize":{summary:"Converts an object into JSON text (System.Text.Json).",parameters:[{name:"value",meaning:"the object"},{name:"options",meaning:"optional JsonSerializerOptions"}],return:{meaning:"the JSON string"}},"JsonConvert.DeserializeObject":{summary:"Parses JSON text into an object (Newtonsoft.Json).",parameters:[{name:"value",meaning:"the JSON string"}],return:{meaning:"the object (null for empty input); throws JsonException on malformed JSON"}},HttpClient:{summary:"Creates an HTTP client — reuse ONE instance per process (creating one per request exhausts sockets).",parameters:[],return:{meaning:"a new HttpClient"}},".GetAsync":{summary:"Sends an HTTP GET and completes when the response headers arrive.",parameters:[{name:"requestUri",meaning:"the URL"}],return:{meaning:"a Task<HttpResponseMessage> (check IsSuccessStatusCode / EnsureSuccessStatusCode; network failures throw HttpRequestException)"}},".PostAsync":{summary:"Sends an HTTP POST with the given content.",parameters:[{name:"requestUri",meaning:"the URL"},{name:"content",meaning:"HttpContent (StringContent, FormUrlEncodedContent, ...)"}],return:{meaning:"a Task<HttpResponseMessage>"}},".EnsureSuccessStatusCode":{summary:"Throws HttpRequestException when the HTTP status is not 2xx.",parameters:[],return:{meaning:"the same response object when it was successful"}},".ExecuteNonQuery":{summary:"Runs an INSERT/UPDATE/DELETE/DDL statement that returns no rows.",parameters:[],return:{meaning:"the number of rows affected (-1 for statements that are not DML)",rules:[{when:{op:"<",value:0},meaning:"not a row-count statement (DDL, SELECT)"},{when:{op:"==",value:0},meaning:"the statement matched no rows"}]}},".ExecuteReader":{summary:"Runs a query and returns a forward-only reader over the result rows.",parameters:[],return:{meaning:"a DbDataReader — call Read() per row and dispose it"}},".ExecuteScalar":{summary:"Runs a query and returns the first column of the first row.",parameters:[],return:{meaning:"that value as object (null / DBNull when there are no rows)"}},".SaveChanges":{summary:"Writes all tracked entity changes to the database in one transaction (Entity Framework).",parameters:[],return:{meaning:"the number of entities written"}},"Regex.IsMatch":{summary:"Tests whether the pattern matches anywhere in the input.",parameters:[{name:"input",meaning:"the text"},{name:"pattern",meaning:"the regular expression"}],return:{meaning:"true if there is a match",rules:[{when:{op:"==",value:1},meaning:"a match exists"},{when:{op:"==",value:0},meaning:"no match"}]}},"SHA256.HashData":{summary:"Computes the SHA-256 digest of the bytes in one call.",parameters:[{name:"source",meaning:"the bytes to hash"}],return:{meaning:"the 32-byte hash"}},"RandomNumberGenerator.GetBytes":{summary:"Fills/returns CRYPTOGRAPHICALLY secure random bytes.",parameters:[{name:"count",meaning:"how many bytes"}],return:{meaning:"the random bytes"}},"GC.Collect":{summary:"Forces a garbage collection now (rarely the right fix; mostly for tests and diagnostics).",parameters:[],return:{meaning:"nothing (void)"}},"Marshal.AllocHGlobal":{summary:"Allocates UNMANAGED memory — you must free it with Marshal.FreeHGlobal.",parameters:[{name:"cb",meaning:"size in bytes"}],return:{meaning:"an IntPtr to the block"}},"GL.Clear":{summary:"Clears the selected buffers (color/depth/stencil) of the current OpenGL framebuffer.",parameters:[{name:"mask",meaning:"ClearBufferMask flags"}],return:{meaning:"nothing (void)"}},"GL.DrawElements":{summary:"Draws primitives using an index buffer.",parameters:[{name:"mode",meaning:"primitive type"},{name:"count",meaning:"number of indices"},{name:"type",meaning:"index data type"},{name:"indices",meaning:"offset into the bound element buffer"}],return:{meaning:"nothing (void)"}},"SDL.SDL_PollEvent":{summary:"Polls for a pending SDL event WITHOUT blocking.",parameters:[{name:"e",meaning:"out SDL_Event to fill"}],return:{meaning:"non-zero when an event was stored, 0 when the queue is empty",rules:[{when:{op:"==",value:0},meaning:"no event pending"},{when:{op:"!=",value:0},meaning:"an event was written to e"}]}},"SDL.SDL_GL_SwapWindow":{summary:"Presents the window's OpenGL back buffer (call once per frame after drawing).",parameters:[{name:"window",meaning:"the SDL window"}],return:{meaning:"nothing (void)"}},"Matrix4x4.CreatePerspectiveFieldOfView":{summary:"Builds a perspective projection matrix.",parameters:[{name:"fieldOfView",meaning:"vertical field of view in radians"},{name:"aspectRatio",meaning:"width / height"},{name:"nearPlaneDistance",meaning:"near clip distance"},{name:"farPlaneDistance",meaning:"far clip distance"}],return:{meaning:"the projection Matrix4x4"}}},ruby:{"File.read":{summary:"Reads the ENTIRE file into one string (opens, reads, closes).",parameters:[{name:"name",meaning:"file path"},{name:"length",meaning:"optional: only the first N bytes"},{name:"offset",meaning:"optional: start reading at this byte"}],return:{meaning:"the contents as a String (raises Errno::ENOENT when the file is missing, Errno::EACCES when not permitted)"}},"File.write":{summary:"Writes a string to a file, TRUNCATING it first (opens, writes, closes).",parameters:[{name:"name",meaning:"file path"},{name:"string",meaning:"the data to write"},{name:"mode",meaning:'optional: pass mode: "a" to append instead of truncate'}],return:{meaning:"the number of bytes written"}},"File.open":{summary:"Opens a file; with a block the file is closed automatically when the block ends.",parameters:[{name:"filename",meaning:"file path"},{name:"mode",meaning:'"r" read, "w" truncate+write, "a" append, "r+" read/write, add "b" for binary'}],return:{meaning:"a File object (or the block's value when a block is given); raises Errno::ENOENT etc. on failure"}},"File.exist?":{summary:"Checks whether a file or directory exists at the path.",parameters:[{name:"file_name",meaning:"path"}],return:{meaning:"true if it exists",rules:[{when:{op:"==",value:1},meaning:"it exists"},{when:{op:"==",value:0},meaning:"it does not exist"}]}},"File.delete":{summary:"Deletes the named files (raises if one does not exist).",parameters:[{name:"file_name",meaning:"one or more paths"}],return:{meaning:"the number of files deleted"}},"Dir.mkdir":{summary:"Creates ONE directory (the parent must exist; use FileUtils.mkdir_p for the whole path).",parameters:[{name:"path",meaning:"directory path"},{name:"permissions",meaning:"optional mode bits"}],return:{meaning:"0 on success; raises Errno::EEXIST / Errno::ENOENT on failure"}},"FileUtils.mkdir_p":{summary:"Creates the directory and any missing parents (like mkdir -p); no error if it exists.",parameters:[{name:"list",meaning:"path or paths"}],return:{meaning:"the list of directories"}},"FileUtils.rm_rf":{summary:"Recursively deletes files/directories and IGNORES errors (like rm -rf) — dangerous with a wrong path.",parameters:[{name:"list",meaning:"path or paths"}],return:{meaning:"the list of paths"}},puts:{summary:"Writes each argument followed by a newline to standard output (arrays are printed one element per line).",parameters:[{name:"objects",meaning:"what to print (to_s is used)"}],return:{meaning:"nil"}},system:{summary:"Runs a command in a subshell (or directly when given separate arguments), waits for it, and shows its output on the terminal.",parameters:[{name:"command",meaning:"the command line, or the program followed by its arguments"}],return:{meaning:"true if it exited with status 0, false if it exited non-zero, nil if the command could not be run",rules:[{when:{op:"==",value:1},meaning:"command succeeded (exit status 0)"},{when:{op:"==",value:0},meaning:"command failed (non-zero exit)"}]}},"Open3.capture2":{summary:"Runs a command, feeds it stdin_data, and returns its stdout and exit status (no terminal output).",parameters:[{name:"cmd",meaning:"program and arguments"},{name:"stdin_data",meaning:"text to send to its standard input"}],return:{meaning:"[stdout string, Process::Status]"}},"Process.spawn":{summary:"Starts a command in a NEW process WITHOUT waiting for it.",parameters:[{name:"command",meaning:"program and arguments"},{name:"options",meaning:"redirections, env, chdir"}],return:{meaning:"the child process id (wait for it with Process.wait)"}},"Thread.new":{summary:"Starts a new thread running the block.",parameters:[{name:"args",meaning:"values passed to the block"}],return:{meaning:"the Thread; call join/value to wait; an exception inside is re-raised in the joiner"}},"Time.now":{summary:"Reads the current wall-clock time.",parameters:[],return:{meaning:"a Time object (local time zone)"}},"JSON.parse":{summary:"Parses JSON text into Ruby Hashes/Arrays/values.",parameters:[{name:"source",meaning:"the JSON string"},{name:"symbolize_names",meaning:"optional: use Symbol keys"}],return:{meaning:"the parsed structure; raises JSON::ParserError on malformed input"}},"YAML.load_file":{summary:"Parses a YAML file (check the safe-loading rules of your Psych version).",parameters:[{name:"filename",meaning:"path"}],return:{meaning:"the parsed structure"}},"Net::HTTP.get":{summary:"Sends an HTTP GET and returns only the response BODY.",parameters:[{name:"uri",meaning:"a URI (or host and path)"}],return:{meaning:"the body String (raises on network errors; does NOT check the status code)"}},"Net::HTTP.start":{summary:"Opens an HTTP connection, yields it, and closes it afterwards.",parameters:[{name:"address",meaning:"host"},{name:"port",meaning:"port"},{name:"use_ssl",meaning:"true for https"}],return:{meaning:"the block's value"}},"Digest::SHA256.hexdigest":{summary:"Computes the SHA-256 of a string and returns it as lowercase hex.",parameters:[{name:"string",meaning:"the data"}],return:{meaning:"a 64-character hex String"}},"SecureRandom.hex":{summary:"Generates cryptographically secure random bytes as a hex string.",parameters:[{name:"n",meaning:"number of random BYTES (the string is twice as long)"}],return:{meaning:"a hex String"}},"ENV.fetch":{summary:"Reads an environment variable; raises KeyError when it is missing unless a default is given.",parameters:[{name:"name",meaning:"variable name"},{name:"default",meaning:"optional default value"}],return:{meaning:"the value"}},raise:{summary:"Raises an exception (RuntimeError when only a message is given) — control leaves the method unless rescued.",parameters:[{name:"exception",meaning:"an exception class/object"},{name:"message",meaning:"the error message"}],return:{meaning:"never returns"}},exit:{summary:"Terminates the program (raises SystemExit so ensure blocks and at_exit handlers run).",parameters:[{name:"status",meaning:"exit code: 0/true success, 1/false failure"}],return:{meaning:"never returns"}},sleep:{