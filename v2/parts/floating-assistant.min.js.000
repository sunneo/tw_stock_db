,{name:"repne",format:"REPNE instr",description:'Repeat-while-not-equal prefix (alias REPNZ): like REP, but ALSO stops early if ZF becomes 1 - pairs with CMPS/SCAS for "compare/scan until match" idioms (e.g. a REPNE SCASB-based strlen).'},{name:"repnz",format:"REPNZ instr",description:"Alias for REPNE."},{name:"jmp",format:"JMP target",description:"Unconditional jump."},{name:"je",format:"JE target",description:"Jump if equal (ZF=1)."},{name:"jne",format:"JNE target",description:"Jump if not equal (ZF=0)."},{name:"jz",format:"JZ target",description:"Jump if zero (ZF=1) - alias of JE."},{name:"jnz",format:"JNZ target",description:"Jump if not zero (ZF=0) - alias of JNE."},{name:"jg",format:"JG target",description:"Jump if greater (signed)."},{name:"jl",format:"JL target",description:"Jump if less (signed)."},{name:"jge",format:"JGE target",description:"Jump if greater or equal (signed)."},{name:"jle",format:"JLE target",description:"Jump if less or equal (signed)."},{name:"ja",format:"JA target",description:"Jump if above (unsigned)."},{name:"jb",format:"JB target",description:"Jump if below (unsigned)."},{name:"jae",format:"JAE target",description:"Jump if above or equal (unsigned)."},{name:"jbe",format:"JBE target",description:"Jump if below or equal (unsigned)."},{name:"jc",format:"JC target",description:"Jump if carry flag set."},{name:"jnc",format:"JNC target",description:"Jump if carry flag clear."},{name:"call",format:"CALL target",description:"Pushes the return address and jumps to target (function call)."},{name:"ret",format:"RET",description:"Pops the return address and jumps to it (function return)."},{name:"loop",format:"LOOP target",description:"Decrements (E)CX and jumps to target if (E)CX != 0."},{name:"loope",format:"LOOPE target",description:"Decrements (E)CX, jumps if (E)CX != 0 AND ZF=1."},{name:"loopne",format:"LOOPNE target",description:"Decrements (E)CX, jumps if (E)CX != 0 AND ZF=0."},{name:"js",format:"",description:"負數則跳"},{name:"jns",format: