ult<File>"}},"fs::read_to_string":{summary:"Reads a whole file into a String (UTF-8).",parameters:[{name:"path",meaning:"file path"}],return:{meaning:"io::Result<String>; Err if the file is unreadable or not valid UTF-8"}},"fs::read":{summary:"Reads a whole file into a Vec<u8>.",parameters:[{name:"path",meaning:"file path"}],return:{meaning:"io::Result<Vec<u8>>"}},"fs::write":{summary:"Writes bytes to a file, creating it or TRUNCATING an existing one.",parameters:[{name:"path",meaning:"file path"},{name:"contents",meaning:"bytes or string to write"}],return:{meaning:"io::Result<()>"}},"fs::remove_file":{summary:"Deletes a file. Destructive.",parameters:[{name:"path",meaning:"file path"}],return:{meaning:"io::Result<()>"}},"fs::remove_dir_all":{summary:"Recursively deletes a directory tree. Destructive.",parameters:[{name:"path",meaning:"directory path"}],return:{meaning:"io::Result<()>"}},"fs::create_dir_all":{summary:"Creates a directory and all missing parents.",parameters:[{name:"path",meaning:"directory path"}],return:{meaning:"io::Result<()>; Ok even if it already exists"}},"TcpStream::connect":{summary:"Opens a TCP connection (blocks until connected or failed).",parameters:[{name:"addr",meaning:'anything ToSocketAddrs: "host:port", (ip, port), ...'}],return:{meaning:"io::Result<TcpStream>"}},"TcpListener::bind":{summary:"Binds a TCP listening socket.",parameters:[{name:"addr",meaning:'anything ToSocketAddrs, e.g. "0.0.0.0:8080"'}],return:{meaning:"io::Result<TcpListener>; Err if the port is in use or not permitted"}},"thread::spawn":{summary:"Starts a new OS thread running the closure.",parameters:[{name:"f",meaning:"closure to run; it must be Send + 'static, so it usually needs `move`"}],return:{meaning:"JoinHandle<T>; join() returns Err if the thread panicked. Dropping the handle detaches the thread"}},"Command::new":{summary:"Starts building an external command (nothing runs until spawn/output/status).",parameters:[{name:"program",meaning:"program to run (looked up in PATH)"}],return:{meaning:"a Command builder; add .arg()/.args() then .spawn()/.output()/.status()"}},"env::var":{summary:"Reads an environment variable.",parameters:[{name:"key",meaning:"variable name"}],return:{meaning:"Result<String, VarError>: Err(NotPresent) if unset, Err(NotUnicode) if not valid UTF-8"}},"process::exit":{summary:"Ends the whole process immediately with the exit code (destructors do NOT run).",parameters:[{name:"code",meaning:"exit status (0 = success)"}],return:{meaning:"does not return"}},"Instant::now":{summary:"Reads the monotonic clock (for measuring elapsed time, not wall-clock time).",parameters:[],return:{meaning:"an Instant; .elapsed() gives the Duration since"}},"SystemTime::now":{summary:"Reads the wall clock.",parameters:[],return:{meaning:"a SystemTime; duration_since(UNIX_EPOCH) can fail if the clock went backwards"}},"Box::new":{summary:"Allocates a value on the heap.",parameters:[{name:"x",meaning:"the value to move into the allocation"}],return:{meaning:"a Box<T> owning it (freed when dropped)"}},"Arc::new":{summary:"Allocates a value behind an atomically reference-counted pointer shared across threads.",parameters:[{name:"data",meaning:"the value to share"}],return:{meaning:"an Arc<T>; clone it to share, the value is freed when the last Arc drops"}},"Mutex::new":{summary:"Creates a mutex protecting a value.",parameters:[{name:"t",meaning:"the protected value"}],return:{meaning:'a Mutex<T>; .lock() returns a guard (Err if another thread panicked while holding it - "poisoned")'}},".lock":{summary:"Locks a Mutex (blocks until acquired).",parameters:[],return:{meaning:"LockResult<MutexGuard<T>>: Err when the mutex is poisoned (a thread panicked while holding it); the guard unlocks on drop"}},"mpsc::channel":{summary:"Creates an unbounded multi-producer single-consumer channel.",parameters:[],return:{meaning:"(Sender<T>, Receiver<T>); send never blocks, recv blocks, both fail once the other side is dropped"}},"serde_json