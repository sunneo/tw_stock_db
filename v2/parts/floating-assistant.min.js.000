simdOk = false; }\n  return simdOk;\n}\n\n// 取得（必要時放大）線性記憶體，回傳 mk(kc, aOff, bOff, outOff) 與 memory\nfunction getKernel(minBytes) {\n  if (!simdSupported()) throw new Error('cpu_gemm_wasm：此環境不支援 WASM SIMD');\n  if (!inst) {\n    const mod = new WebAssembly.Module(buildModule());\n    inst = new WebAssembly.Instance(mod, {});\n    memory = inst.exports.mem;\n  }\n  const need = Math.ceil(minBytes / 65536);\n  if (memory.buffer.byteLength < need * 65536) memory.grow(need - memory.buffer.byteLength / 65536);\n  return { mk: inst.exports.mk, memory };\n}\n\nmodule.exports = { simdSupported, getKernel, buildModule };\n\n};\nMODS[\"cpu_gemm_rows\"] = function (module, exports, require) {\n'use strict';\n// 多核 GEMM：沿 M 方向把列區塊分給工作者。工作者內的核心 gemmRowsSimdKernel 是「自給自足」的函式（所有輔助函式都在裡面），\n// 所以可以用 fn.toString() 放進 Blob Worker 或 worker_threads 的 eval 字串，和 cpu_share 的做法一樣。\n// 輸入 A、B 若在 SharedArrayBuffer 裡就直接讀（零複製）；否則主執行緒先複製一份進 SAB（或用 postMessage 拷貝，見 transferMode）。\n// 輸出：每個工作者寫進自己的列區塊；SAB 可用時直接寫進共享的 C（零複製回傳），否則回傳區塊後由主執行緒拼接。\n\n// 自給自足的 SIMD 列區塊核心：計算 C[rowStart..rowEnd) = A·B（旗標 transA／transB 與 cpu_gemm.js 同義）。\n// 回傳 Float32Array（長度 (rowEnd-rowStart)·n）；若傳入 Cout（同長度）則直接寫進 Cout 並回傳它。\nfunction gemmRowsSimdKernel(A, B, m, k, n, transA, transB, rowStart, rowEnd, wasmBytes, MC, KC, NC, Cout) {\n  const MR = 4, NR = 8;\n  const rows = rowEnd - rowStart;\n  const C = Cout || new Float32Array(rows * n);\n  if (rows <= 0 || n === 0 || k === 0) return C;\n  const apBytes = Math.ceil(MC / MR) * MR * KC * 4;\n  const bpBytes = Math.ceil(NC / NR) * NR * KC * 4;\n  const outOff = apBytes + bpBytes;\n  // 編譯與實例化只做一次（工作者的全域快取，以位元組長度與總和為鍵）。每次呼叫都重新編譯會吃掉約 25 ms，這是小尺寸工作者比主執行緒慢的主因。\n  const gl = typeof globalThis !== 'undefined' ? globalThis : self;\n  let sum = 0; for (let i = 0; i < wasmBytes.length; i++) sum = (sum * 31 + wasmBytes[i]) | 0;\n  const cacheKey = wasmBytes.length + ':' + sum;\n  if (!gl.__faGemmInst || gl.__faGemmKey !== cacheKey) {\n    gl.__faGemmInst = new WebAssembly.Instance(new WebAssembly.Module(wasmBytes), {});\n    gl.__faGemmKey = cacheKey;\n  }\n  const inst = gl.__faGemmInst;\n  const need = Math.ceil((outOff + 128) / 65536);\n  const memory = inst.exports.mem;\n  if (memory.buffer.byteLength < need * 65536) memory.grow(need - memory.buffer.byteLength / 65536);\n  const mk = inst.exports.mk;\n  const f32 = new Float32Array(memory.buffer);\n  const Ap = f32.subarray(0, apBytes / 4);\n  const Bp = f32.subarray(apBytes / 4, (apBytes + bpBytes) / 4);\n  const out = f32.subarray(outOff / 4, outOff / 4 + 32);\n  const packA = (ic, mc, pc, kc) => {\n    let w = 0;\n    for (let ir = 0; ir < mc; ir += MR) {\n      const mr = Math.min(MR, mc - ir);\n      for (let p = 0; p < kc; p++) for (let i = 0; i < MR; i++) {\n        if (i < mr) { const row = ic + ir + i, col = pc + p; Ap[w++] = transA ? A[col * m + row] : A[row * k + col]; }\n        else Ap[w++] = 0;\n      }\n    }\n  };\n  const packB = (jc, nc, pc, kc) => {\n    let w = 0;\n    for (let jr = 0; jr < nc; jr += NR) {\n      const nr = Math.min(NR, nc - jr);\n      for (let p = 0; p < kc; p++) for (let j = 0; j < NR; j++) {\n        if (j < nr) { const col = jc + jr + j, row = pc + p; Bp[w++] = transB ? B[col * k + row] : B[row * n + col]; }\n        else Bp[w++] = 0;\n      }\n    }\n  };\n  // 列區塊內的 C 是 C[(i-rowStart)·n + j]，所以 C 用相對列號寫入；累加到 C（先清零）\n  C.fill(0);\n  for (let jc = 0; jc < n; jc += NC) {\n    const nc = Math.min(NC, n - jc);\n    for (let pc = 0; pc < k; pc += KC) {\n      const kc = Math.min(KC, k - pc);\n      packB(jc, nc, pc, kc);\n      for (let ic = rowStart; ic < rowEnd; ic += MC) {\n        const mc = Math.min(MC, rowEnd - ic);\n        packA(ic, mc, pc, kc);\n        for (let jr = 0; jr < nc; jr += NR) {\n          const nr = Math.min(NR, nc - jr);\n          const bOff = apBytes + (jr / NR) * NR * kc * 4;\n          for (let ir = 0; ir < mc; ir += MR) {\n            const mr = Math.min(MR, mc - ir);\n            const aOff = (ir / MR) * MR * kc * 4;\n            mk(kc, aOff, bOff, outOff);\n            const cBase = (ic + ir - rowStart) * n + (jc + jr);\n            for (let i = 0; i < mr; i++) for (let j = 0; j < nr; j++) C[cBase + i * n + j] += out[i * NR + j];\n          }\n        }\n      }\n    }\n  }\n  return C;\n}\n\n// 把 m 列切成 parts 段，每段列數為 MR 的倍數（最後一段可以不是），回傳 [[rowStart,rowEnd],...]\nfunction splitRowsAligned(m, parts, MR = 4) {\n  if (m <= 0) return [];\n  const per = Math.max(MR, Math.ceil(Math.ceil(m / parts) / MR) * MR);\n  const out = [];\n  for (let s = 0; s < m; s += per) out.push([s, Math.min(m, s + per)]);\n  return out;\n}\n\n// 節點驗證／量測用的工作者驅動：每個工作者以 eval 字串載入 gemmRowsSimdKernel，回傳自己的列區塊。\n// 用 SAB 時 A、B、C 都放 SAB（零複製回傳）；否則用 postMessage 複製。\nfunction gemmParallelNode(A, B, m, k, n, opts, workerCount) {\n  const { Worker } = require('worker_threads');\n  const W = require('./cpu_gemm_wasm.js');\n  const o = opts || {};\n  const MC = o.MC || 96, KC = o.KC || 64, NC = o.NC || 512;\n  const transA = !!o.transA, transB = !!o.transB;\n  const wasmBytes = W.buildModule();\n  const useSab = typeof SharedArrayBuffer === 'function';\n  const parts = splitRowsAligned(m, workerCount);\n  const kernelSrc = gemmRowsSimdKernel.toString();\n  const src = `const { parentPort, workerData } = require('worker_threads');\nconst gemmRowsSimdKernel = (${kernelSrc});\nparentPort.on('message', (d) => {\n  const { A, B, m, k, n, transA, transB, rowStart, rowEnd, wasmBytes, MC, KC, NC, C } = d;\n  const Cv = C ? new Float32Array(C.buffer || C, C.byteOffset || 0, (rowEnd - rowStart) * n) : null;\n  const res = gemmRowsSimdKernel(A, B, m, k, n, transA, transB, rowStart, rowEnd, wasmBytes, MC, KC, NC, Cv);\n  parentPort.postMessage(Cv ? null : res, Cv ? undefined : [res.buffer]);\n});`;\n  let Aw = A, Bw = B, Cshared = null;\n  if (useSab) {\n    const sa = new Float32Array(new SharedArrayBuffer(A.length * 4)); sa.set(A); Aw = sa;\n    const sb = new Float32Array(new SharedArrayBuffer(B.length * 4)); sb.set(B); Bw = sb;\n    Cshared = new Float32Array(new SharedArrayBuffer(m * n * 4));\n  }\n  return new Promise((resolve, reject) => {\n    const C = useSab ? Cshared : new Float32Array(m * n);\n    let pending = parts.length;\n    const workers = parts.map(([rs, re]) => {\n      const w = new Worker(src, { eval: true });\n      w.on('message', (res) => {\n        if (res) C.set(res, rs * n);\n        if (--pending === 0) { workers.forEach((x) => x.terminate()); resolve(C); }\n      });\n      w.on('error', (e) => { workers.forEach((x) => x.terminate()); reject(e); });\n      const payload = { A: Aw, B: Bw, m, k, n, transA, transB, rowStart: rs, rowEnd: re, wasmBytes, MC, KC, NC };\n      if (useSab) payload.C = Cshared.subarray(rs * n, re * n);\n      w.postMessage(payload);\n      return w;\n    });\n  });\n}\n\n// 持久工作者池（節點版）：工作者只建立一次，之後每次呼叫只送資料與列區塊，量到的是計算時間而不是啟動時間。\n// 瀏覽器版（Blob Worker）的做法相同，見 cpu_share.js 的 workerSource 模式。\nfunction createRowPool(workerCount) {\n  const { Worker } = require('worker_threads');\n  const kernelSrc = gemmRowsSimdKernel.toString();\n  const src = `const { parentPort } = require('worker_threads');\nconst gemmRowsSimdKernel = (${kernelSrc});\nparentPort.on('message', (d) => {\n  const { A, B, m, k, n, transA, transB, rowStart, rowEnd, wasmBytes, MC, KC, NC, C, id } = d;\n  const Cv = C ? new Float32Array(C.buffer, C.byteOffset, (rowEnd - rowStart) * n) : null;\n  const res = gemmRowsSimdKernel(A, B, m, k, n, transA, transB, rowStart, rowEnd, wasmBytes, MC, KC, NC, Cv);\n  if (Cv) parentPort.postMessage({ id, done: true });\n  else parentPort.postMessage({ id, C: res }, [res.buffer]);\n});`;\n  const ws = [];\n  for (let i = 0; i < workerCount; i++) ws.push(new Worker(src, { eval: true }));\n  let seq = 0;\n  const useSab = typeof SharedArrayBuffer === 'function';\n  return {\n    workers: ws.length,\n    shared: useSab,\n    run(A, B, m, k, n, opts) {\n      const o = opts || {};\n      const MC = o.MC || 96, KC = o.KC || 64, NC = o.NC || 512;\n      const transA = !!o.transA, transB = !!o.transB;\n      const wasmBytes = require('./cpu_gemm_wasm.js').buildModule();\n      const parts = splitRowsAligned(m, ws.length);\n      let Aw = A, Bw = B, C;\n      if (useSab) {\n        const sa = new Float32Array(new SharedArrayBuffer(A.length * 4)); sa.set(A); Aw = sa;\n        const sb = new Float32Array(new SharedArrayBuffer(B.length * 4)); sb.set(B); Bw = sb;\n        C = new Float32Array(new SharedArrayBuffer(m * n * 4));\n      } else C = new Float32Array(m * n);\n      const id = ++seq;\n      return new Promise((resolve, reject) => {\n        let pending = parts.length;\n        const listeners = [];\n        parts.forEach(([rs, re], idx) => {\n          const w = ws[idx];\n          const onMsg = (msg) => {\n            if (msg.id !== id) return;\n            if (msg.C) C.set(msg.C, rs * n);\n            if (--pending === 0) { cleanup(); resolve(C); }\n          };\n          const onErr = (e) => { cleanup(); reject(e); };\n          const cleanup = () => { listeners.forEach(([x, f, g]) => { x.off('message', f); x.off('error', g); }); };\n          w.on('message', onMsg); w.on('error', onErr);\n          listeners.push([w, onMsg, onErr]);\n          const payload = { A: Aw, B: Bw, m, k, n, transA, transB, rowStart: rs, rowEnd: re, wasmBytes, MC, KC, NC, id };\n          if (useSab) payload.C = C.subarray(rs * n, re * n);\n          w.postMessage(payload);\n        });\n        if (parts.length === 0) resolve(C);\n      });\n    },\n    close() { ws.forEach((w) => w.terminate()); },\n  };\n}\n\nmodule.exports = { gemmRowsSimdKernel, splitRowsAligned, gemmParallelNode, createRowPool };\n\n};\nMODS[\"cpu_gemm_offload\"] = function (module, exports, require) {\n'use strict';\n// 卸載交界點（純函式）：矩陣乘的運算量（2·m·k·n）小於交界點時走 CPU（省上傳與讀回），否則走 GPU。\n// 交界點來自 Profile 的實測（faProfilePlan 的 crossoverFlops）；沒有實測值時回到「維持 GPU」，不自己編門檻。\n// 特殊值：crossoverFlops === Infinity 表示 CPU 在各種大小都不輸（全走 CPU）；0 或負數 = 永遠走 GPU。\n\nfunction flopsOf(m, k, n) { return 2 * m * k * n; }\n\n// 回傳 { route: 'cpu' | 'gpu', flops, reason }\nfunction offloadDecision(o) {\n  const { m, k, n } = o || {};\n  const flops = flopsOf(m, k, n);\n  if (o.gpuReady === false) return { route: 'cpu', flops, reason: '沒有可用的 GPU' };\n  const x = o.crossoverFlops;\n  if (x === null || x === undefined || Number.isNaN(Number(x))) return { route: 'gpu', flops, reason: '尚未量測卸載交界點，維持 GPU' };\n  if (x === Infinity) return { route: 'cpu', flops, reason: 'Profile 量測：CPU 在各種大小都不輸 GPU' };\n  if (!(x > 0)) return { route: 'gpu', flops, reason: 'Profile 量測：交界點不為正，永遠走 GPU' };\n  if (flops < x) return { route: 'cpu', flops, reason: `運算量 ${flops} 小於交界點 ${x}，CPU 較快且省傳輸` };\n  return { route: 'gpu', flops, reason: `運算量 ${flops} 不小於交界點 ${x}，走 GPU` };\n}\n\nmodule.exports = { offloadDecision, flopsOf };\n\n};\nMODS[\"gpu_async_queue\"] = function (module, exports, require) {\n'use strict';\n// GPU 非同步提交佇列（純邏輯，不碰 WebGPU）。\n// 語意仿 CUDA：\n//  - submit() 立刻回傳句柄（handle），不等 GPU；\n//  - 同一個 stream 內依提交順序執行（保序）；不同 stream 各自獨立，可以重疊；\n//  - 錯誤不在 submit 丟出，而是存到句柄上，在 wait／synchronize／eventSynchronize 時才丟出；\n//  - 某個 stream 出錯後，該 stream 之後的操作全部以同一個錯誤失敗（sticky，與 CUDA 相同），直到 reset(stream)；\n//  - 未完成句柄數達上限時 submit 丟 QueueFullError（同步函式不能等，由呼叫端先 wait 最舊的再重試）。\n// execute(op, args) 由宿主提供，回傳 Promise；測試時用假裝置。\n\nclass QueueFullError extends Error {\n  constructor(limit) { super('GPU 佇列已滿（未完成的操作達上限 ' + limit + '），請先等待較早的句柄'); this.name = 'QueueFullError'; this.limit = limit; }\n}\n\nfunction createGpuQueue(opts) {\n  opts = opts || {};\n  if (typeof opts.execute !== 'function') throw new TypeError('createGpuQueue：需要 execute(op, args) 函式');\n  const execute = opts.execute;\n  const maxPending = opts.maxPending > 0 ? opts.maxPending : 64;\n  const now = typeof opts.now === 'function' ? opts.now : () => Date.now();\n  const streams = new Map(); // streamId → { tail, pending:Set<rec>, poison:null }\n  const recs = new Map();    // handleId → rec\n  let seq = 0;\n  let pendingTotal = 0;\n\n  function getStream(id) {\n    let s = streams.get(id);\n    if (!s) { s = { tail: Promise.resolve(), pending: new Set(), poison: null }; streams.set(id, s); }\n    return s;\n  }\n\n  function submit(op, args, streamId) {\n    const sid = streamId == null ? 0 : streamId;\n    if (pendingTotal >= maxPending) throw new QueueFullError(maxPending);\n    const s = getStream(sid);\n    // op 可以是字串，也可以是物件（例如 { device: 'cpu', name: 'matmul' }，給多裝置排程用）；原樣交給 execute\n    const rec = { id: ++seq, stream: sid, op, state: 'pending', result: undefined, error: null, doneAt: null, done: null };\n    recs.set(rec.id, rec);\n    s.pending.add(rec);\n    pendingTotal++;\n    const prev = s.tail;\n    rec.done = prev.then(() => {\n      if (s.poison) throw s.poison; // 同一個 stream 已出錯：這一筆直接以同一個錯誤失敗\n      return execute(rec.op, args);\n      // （rec.op 維持原樣：字串或裝置物件）\n    }).then((v) => {\n      rec.state = 'done'; rec.result = v;\n    }, (e) => {\n      rec.state = 'error'; rec.error = e;\n      if (!s.poison) s.poison = e;\n    }).then(() => {\n      rec.doneAt = now();\n      s.pending.delete(rec);\n      pendingTotal--;\n    });\n    s.tail = rec.done; // rec.done 不會 reject，tail 可安全串接\n    return { id: rec.id, stream: sid };\n  }\n\n  function getRec(handle) {\n    const rec = recs.get(handle && handle.id);\n    if (!rec) throw new Error('未知的 GPU 句柄（已被 forget，或不屬於這個佇列）');\n    return rec;\n  }\n\n  // 等單一句柄完成；回傳結果或丟出它的錯誤。可重複等待。\n  async function wait(handle) {\n    const rec = getRec(handle);\n    await rec.done;\n    if (rec.state === 'error') throw rec.error;\n    return rec.result;\n  }\n\n  // 非阻塞查詢：'pending' | 'done' | 'error'\n  function query(handle) {\n    return getRec(handle).state;\n  }\n\n  // 釋放句柄與結果（Python 讀完後呼叫，避免結果一直佔記憶體）\n  function forget(handle) {\n    const rec = getRec(handle);\n    if (rec.state === 'pending') throw new Error('句柄尚未完成，不能 forget');\n    recs.delete(rec.id);\n  }\n\n  // 等某個 stream（或全部 stream）的所有已提交操作；若有錯誤（含 sticky）就丟出\n  async function synchronize(streamId) {\n    const targets = streamId == null ? Array.from(streams.values()) : (streams.has(streamId) ? [streams.get(streamId)] : []);\n    await Promise.all(targets.map((s) => s.tail));\n    for (const s of targets) if (s.poison) throw s.poison;\n  }\n\n  // 事件：記錄「此刻 stream 中尚未完成的操作」。事件完成 = 這些操作全部完成。\n  function record(streamId) {\n    const sid = streamId == null ? 0 : streamId;\n    const s = getStream(sid);\n    const snap = Array.from(s.pending);\n    const ev = { stream: sid, snap, poisonAtRecord: s.poison, doneAt: null, _p: null };\n    ev._p = Promise.all(snap.map((r) => r.done)).then(() => { ev.doneAt = now(); });\n    return ev;\n  }\n\n  // 等事件；若記錄時或現在 stream 已有錯誤，丟出錯誤\n  async function eventSynchronize(ev) {\n    await ev._p;\n    for (const r of ev.snap) if (r.state === 'error') throw r.error;\n    if (ev.poisonAtRecord) throw ev.poisonAtRecord;\n    const s = streams.get(ev.stream);\n    if (s && s.poison) throw s.poison;\n  }\n\n  function eventQuery(ev) {\n    return ev.doneAt != null;\n  }\n\n  // 兩個已完成事件之間的牆鐘時間（毫秒）；未完成回傳 NaN。注意：這是主機時鐘，不是 GPU 時間戳。\n  function eventElapsed(a, b) {\n    if (a.doneAt == null || b.doneAt == null) return NaN;\n    return b.doneAt - a.doneAt;\n  }\n\n  // 清除某個 stream 的 sticky 錯誤（重新開始用）\n  function reset(streamId) {\n    const s = streams.get(streamId == null ? 0 : streamId);\n    if (s) s.poison = null;\n  }\n\n  function stats() {\n    return { pending: pendingTotal, streams: streams.size, handles: recs.size, limit: maxPending };\n  }\n\n  return { submit, wait, query, forget, synchronize, record, eventSynchronize, eventQuery, eventElapsed, reset, stats };\n}\n\nmodule.exports = { createGpuQueue, QueueFullError };\n\n};\nMODS[\"mp_core\"] = function (module, exports, require) {\n'use strict';\n// 多工作者（multiprocessing 墊片）的純排程邏輯，不碰 Worker／Pyodide。由 floating-assistant.js 的 _mpWorkerCap、_mpAcquire、_mpSubmit 接上。\n// 內容：(1) 工作者上限（低階裝置降到 1 到 2）；(2) 建立工作者失敗時的退回（已有工作者就改等它們，一個都沒有才丟錯）；\n// (3) 依序分派、結果保持輸入順序；(4) 任務出錯：不再開始新任務、等在飛中的任務結束後丟出第一個錯誤；(5) 取消（AbortSignal）同樣不再開始新任務，在飛中的任務會跑完（Web Worker 中途不能強殺單一任務）。\n\n// 工作者上限。opts: { maxWorkers, hardwareConcurrency, deviceMemory }\n// 原本的公式：max(2, min(8, 核心數))，再受 maxWorkers 限制；這裡加上低階裝置的降級：\n//   deviceMemory ≤ 2 GB → 1；核心數 ≤ 2 → 最多 2。結果一定在 [1, 8]。\nfunction mpWorkerCap(opts) {\n  opts = opts || {};\n  const hc = Number(opts.hardwareConcurrency) > 0 ? Number(opts.hardwareConcurrency) : 4;\n  const mem = Number(opts.deviceMemory) > 0 ? Number(opts.deviceMemory) : 0;\n  let cap = Math.max(2, Math.min(8, hc));\n  if (Number(opts.maxWorkers) > 0) cap = Math.min(cap, Number(opts.maxWorkers));\n  if (mem && mem <= 2) cap = 1;\n  else if (hc <= 2) cap = Math.min(cap, 2);\n  return Math.max(1, Math.min(8, Math.floor(cap)));\n}\n\n// 建立工作者失敗時該怎麼辦。liveCount：目前仍可用的工作者數。\n// 有工作者：不丟錯，改等它們，並把上限降到目前的數量（記憶體可能吃緊，之後不再嘗試多開）。\n// 沒有工作者：丟錯（沒有任何東西能跑），上限降為 1。\nfunction afterCreateFailure(liveCount) {\n  const n = Math.max(0, Math.floor(Number(liveCount) || 0));\n  if (n > 0) return { action: 'wait', cap: n, reason: '建立工作者失敗（可能記憶體不足），改用已有的 ' + n + ' 個工作者' };\n  return { action: 'throw', cap: 1, reason: '建立工作者失敗，而且沒有任何可用的工作者' };\n}\n\n// 依序分派任務，最多 concurrency 個同時執行。\n// opts: { items, concurrency, runTask(item, index) → Promise, signal? }\n// 回傳與 items 同順序的結果陣列；第一個錯誤或取消會讓之後的任務不再開始，等在飛中的任務結束後丟出。\nasync function runMap(opts) {\n  const items = Array.from((opts && opts.items) || []);\n  const runTask = opts && opts.runTask;\n  if (typeof runTask !== 'function') throw new TypeError('runMap：需要 runTask(item, index)');\n  const signal = opts && opts.signal;\n  const results = new Array(items.length);\n  if (items.length === 0) return results;\n  const n = Math.max(1, Math.min(Math.floor(Number(opts.concurrency) || 1), items.length));\n  let next = 0, firstErr = null, stopped = false;\n  const onAbort = () => {\n    if (!firstErr) { const e = new Error('已取消'); e.name = 'AbortError'; firstErr = e; }\n    stopped = true;\n  };\n  if (signal) {\n    if (signal.aborted) onAbort();\n    else signal.addEventListener('abort', onAbort, { once: true });\n  }\n  const runner = async () => {\n    while (!stopped && next < items.length) {\n      const i = next++;\n      try {\n        results[i] = await runTask(items[i], i);\n      } catch (e) {\n        if (!firstErr) firstErr = e;\n        stopped = true;\n      }\n    }\n  };\n  try {\n    await Promise.all(Array.from({ length: n }, runner));\n  } finally {\n    if (signal) signal.removeEventListener('abort', onAbort);\n  }\n  if (firstErr) throw firstErr;\n  return results;\n}\n\nmodule.exports = { mpWorkerCap, afterCreateFailure, runMap };\n\n};\nMODS[\"hetero_split\"] = function (module, exports, require) {\n'use strict';\n// cudaweb 異質排程器的純邏輯（設計見 docs/DESIGN.cudaweb-hetero.md 第 2、7 節）：\n// 分攤決策（公式）、列切分、依位置合併、執行（同時跑 GPU 段與 CPU 段，含退回與取消）。\n// 不碰 WebGPU、Worker、IndexedDB；裝置由呼叫端以 gpuPart／cpuPart 注入。\n\nconst MAX_CPU_FRAC = 0.5;   // CPU 最多分擔一半（與 cpu_share 的 MAX_CPU_RATIO 一致）\nconst MARGIN = 0.15;        // 切分至少要比只給 GPU 快 15%，否則全給 GPU（保守）\nconst NET_MIN = 0.10;       // 保守閘：扣掉 margin 後的淨收益要至少 10%（也就是切分總共要省 25%）\n\n// 實測段耗時回饋：上一次的比例 f、GPU 段與 CPU 段實測毫秒（GPU 段 = (1−f) 的列，CPU 段 = f 的列），\n// 假設各段時間與各自的列數成正比，算出讓兩段耗時相等的新比例。CPU 段慢 → 比例往下修；快 → 往上修。\n// 結果限制在 [0, maxF]；小於 2% 直接取 0（不值得分攤）。資料不足（段耗時非正）時回傳原比例。\nfunction feedbackFraction(f, gpuSegMs, cpuSegMs, maxF) {\n  const cap = maxF == null ? MAX_CPU_FRAC : Number(maxF);\n  const x = Number(f) || 0;\n  const tg = Number(gpuSegMs), tc = Number(cpuSegMs);\n  if (!(x > 0 && x < 1) || !(tg > 0) || !(tc > 0)) return x;\n  const kc = tc / x;            // CPU 每單位比例的耗時\n  const kg = tg / (1 - x);      // GPU 每單位比例的耗時\n  let nf = kg / (kc + kg);      // 讓 kc·f = kg·(1−f) 的 f\n  nf = Math.min(cap, Math.max(0, nf));\n  return nf < 0.02 ? 0 : nf;\n}\n\n// 分攤決策。\n// o: { work, gpuAvailable, cpuAvailable, gpuRate, cpuRate, gpuOverheadMs, cpuOverheadMs, margin?, maxCpuFrac?, minCpuMs? }\n//   work：運算量（單位要和速率一致，例如 flops 或元素數）\n//   gpuRate／cpuRate：單位／毫秒；0 或沒有＝尚未量測\n// 回傳 { mode: 'none'|'gpu'|'cpu'|'split', fraction, predictedMs?, gpuOnlyMs?, reason }\nfunction decideSplit(o) {\n  o = o || {};\n  const W = Number(o.work) || 0;\n  const gA = !!o.gpuAvailable, cA = !!o.cpuAvailable;\n  const g = Number(o.gpuRate) || 0, c = Number(o.cpuRate) || 0;\n  const go = Math.max(0, Number(o.gpuOverheadMs) || 0);\n  const co = Math.max(0, Number(o.cpuOverheadMs) || 0);\n  const margin = o.margin == null ? MARGIN : Number(o.margin);\n  const maxF = o.maxCpuFrac == null ? MAX_CPU_FRAC : Number(o.maxCpuFrac);\n  if (W <= 0) return { mode: 'none', fraction: 0, reason: '沒有運算量' };\n  if (!gA && !cA) return { mode: 'none', fraction: 0, reason: '沒有可用的裝置（沒有 WebGPU，也沒有 CPU 池）' };\n  if (!gA) return { mode: 'cpu', fraction: 1, reason: '沒有 WebGPU，全部給 CPU' };\n  if (!cA) return { mode: 'gpu', fraction: 0, reason: '沒有 CPU 池，全部給 GPU' };\n  if (!(g > 0)) return { mode: 'gpu', fraction: 0, reason: 'GPU 速率尚未量測，保守地全給 GPU' };\n  if (!(c > 0)) return { mode: 'gpu', fraction: 0, reason: 'CPU 速率尚未量測，保守地全給 GPU' };\n  const G = W / g, C = W / c;            // 整份運算在 GPU、CPU 上各自的純計算時間（毫秒）\n  const gpuOnlyMs = go + G;\n  // 平衡點：(1−f)G + go = fC + co\n  let f = (G + go - co) / (G + C);\n  if (!(f > 0)) return { mode: 'gpu', fraction: 0, gpuOnlyMs, reason: '固定成本使 CPU 分到的部分不划算，全給 GPU' };\n  f = Math.min(f, maxF);\n  const minCpuMs = o.minCpuMs == null ? 2 * co : Number(o.minCpuMs);\n  const cpuSegMs = f * C + co;\n  if (f * C < minCpuMs) return { mode: 'gpu', fraction: 0, gpuOnlyMs, reason: 'CPU 段太小，固定成本划不來，全給 GPU' };\n  const predictedMs = Math.max((1 - f) * G + go, cpuSegMs);\n  // 保守閘：預估收益（已扣固定成本）減去 margin 後，要至少 NET_MIN；否則全給 GPU\n  const saving = (gpuOnlyMs - predictedMs) / gpuOnlyMs;\n  const net = saving - margin;\n  if (net < NET_MIN) return { mode: 'gpu', fraction: 0, gpuOnlyMs, predictedMs, saving, net, reason: '扣掉 margin 後淨收益 ' + Math.round(net * 100) + '%，低於 ' + Math.round(NET_MIN * 100) + '%，全給 GPU' };\n  return { mode: 'split', fraction: f, predictedMs, gpuOnlyMs, saving, net, reason: '切分預測省 ' + Math.round(saving * 100) + '%（淨 ' + Math.round(net * 100) + '%）' };\n}\n\n// 依列切分：GPU 拿前面的列，CPU 拿後面的列（與 cpu_share 相同的順序）。至少給 GPU 一列。\nfunction splitRows(total, fraction) {\n  const t = Math.max(0, Math.floor(Number(total) || 0));\n  let cpuRows = Math.floor(t * Math.max(0, Math.min(1, Number(fraction) || 0)));\n  if (cpuRows >= t) cpuRows = Math.max(0, t - 1);\n  if (cpuRows < 1) cpuRows = 0;\n  const gpuRows = t - cpuRows;\n  return { gpuStart: 0, gpuCount: gpuRows, cpuStart: gpuRows, cpuCount: cpuRows };\n}\n\n// 合併：parts = [{ start, count, data }]（data 長度 = count·cols）。必須正好覆蓋 [0, total)，不重不漏，否則丟錯。\nfunction mergeParts(total, cols, parts) {\n  const T = Math.floor(total), C = Math.floor(cols);\n  const sorted = Array.from(parts || []).slice().sort((a, b) => a.start - b.start);\n  const out = new Float32Array(T * C);\n  let pos = 0;\n  for (const p of sorted) {\n    if (p.start !== pos) throw new Error('合併失敗：第 ' + pos + ' 列之後的段從 ' + p.start + ' 開始（有缺口或重疊）');\n    if (p.data.length !== p.count * C) throw new Error('合併失敗：段 ' + p.start + ' 的長度不符');\n    out.set(p.data, p.start * C);\n    pos += p.count;\n  }\n  if (pos !== T) throw new Error('合併失敗：段只覆蓋到第 ' + pos + ' 列，共 ' + T + ' 列');\n  return out;\n}\n\nfunction settle(p) {\n  return Promise.resolve(p).then((value) => ({ ok: true, value }), (error) => ({ ok: false, error }));\n}\n\nfunction abortError() { const e = new Error('已取消'); e.name = 'AbortError'; return e; }\n\n// 執行一次分攤運算。\n// o: { total, cols, decision, gpuPart(start, count) → Promise<Float32Array>, cpuPart(start, count) → Promise<Float32Array>, signal? }\n// 回傳 { data: Float32Array, info: { mode, fraction, gpuRows, cpuRows, fallback?, fallbackReason? } }\n// - mode 'gpu'：整份給 GPU；GPU 失敗就整份改由 CPU 算（fallback: 'gpu-error'）。\n// - mode 'cpu'：整份給 CPU；失敗就丟錯。\n// - mode 'split'：兩段同時跑；GPU 段失敗就由 CPU 補算那些列；CPU 段失敗就丟錯（兩段都結束後才丟，第一個錯誤）。\n// - 取消：開始前已取消就丟 AbortError；執行中取消則等兩段結束後丟 AbortError（在飛中的段不會被強制中止）。\nasync function runSplit(o) {\n  const total = Math.floor(o.total), cols = Math.floor(o.cols);\n  const d = o.decision || {};\n  const signal = o.signal;\n  if (signal && signal.aborted) throw abortError();\n  if (d.mode === 'none') throw new Error('沒有可用的裝置：' + (d.reason || ''));\n  const gpuPart = o.gpuPart, cpuPart = o.cpuPart;\n  if (total <= 0) return { data: new Float32Array(0), info: { mode: d.mode, fraction: 0, gpuRows: 0, cpuRows: 0 } };\n  const finish = (data, info) => {\n    if (signal && signal.aborted) throw abortError();\n    return { data, info };\n  };\n  if (d.mode === 'cpu') {\n    const data = await cpuPart(0, total);\n    return finish(data, { mode: 'cpu', fraction: 1, gpuRows: 0, cpuRows: total });\n  }\n  if (d.mode === 'gpu') {\n    const r = await settle(gpuPart(0, total));\n    if (r.ok) return finish(r.value, { mode: 'gpu', fraction: 0, gpuRows: total, cpuRows: 0 });\n    const data = await cpuPart(0, total);\n    return finish(data, { mode: 'gpu', fraction: 0, gpuRows: 0, cpuRows: total, fallback: 'gpu-error', fallbackReason: String((r.error && r.error.message) || r.error) });\n  }\n  // split\n  const rows = splitRows(total, d.fraction);\n  const gP = rows.gpuCount > 0 ? settle(gpuPart(rows.gpuStart, rows.gpuCount)) : Promise.resolve({ ok: true, value: new Float32Array(0) });\n  const cP = rows.cpuCount > 0 ? settle(cpuPart(rows.cpuStart, rows.cpuCount)) : Promise.resolve({ ok: true, value: new Float32Array(0) });\n  const [gr, cr] = await Promise.all([gP, cP]);\n  if (!cr.ok) throw cr.error;   // CPU 段失敗：整個運算失敗（GPU 段已經結束）\n  let gpuData, info = { mode: 'split', fraction: d.fraction, gpuRows: rows.gpuCount, cpuRows: rows.cpuCount };\n  if (gr.ok) gpuData = gr.value;\n  else {\n    // GPU 段失敗：由 CPU 補算那些列\n    gpuData = await cpuPart(rows.gpuStart, rows.gpuCount);\n    info = Object.assign(info, { fallback: 'gpu-error', fallbackReason: String((gr.error && gr.error.message) || gr.error) });\n  }\n  const merged = mergeParts(total, cols, [\n    { start: rows.gpuStart, count: rows.gpuCount, data: gpuData },\n    { start: rows.cpuStart, count: rows.cpuCount, data: cr.value },\n  ]);\n  return finish(merged, info);\n}\n\nmodule.exports = { decideSplit, splitRows, mergeParts, runSplit, feedbackFraction, MAX_CPU_FRAC, MARGIN, NET_MIN };\n\n};\nMODS[\"hetero_rates\"] = function (module, exports, require) {\n'use strict';\n// cudaweb 異質排程器的速率持久化（設計見 docs/DESIGN.cudaweb-hetero.md 第 3 節）。\n// 純邏輯：鍵的組成、資料檢查、EMA 更新、與儲存後端的包裝。IndexedDB 由呼叫端注入（backend.get／backend.set）。\n// 任何讀寫失敗都不丟錯：讀不到或資料壞掉就當作沒有速率（呼叫端會走保守預設）。\n\n// 鍵：裝置環境變了就是新的量測。\n// o: { op, browser, adapter, cores, kernel }。kernel 是 CPU 核心的版本識別（cpu_share.CPU_KERNEL_ID）：核心換了，舊速率自動作廢。\nfunction rateKey(o) {\n  o = o || {};\n  const part = (v) => String(v == null ? '' : v).replace(/\\|/g, '/');\n  return ['v2', part(o.op), part(o.browser), part(o.adapter), part(o.cores), part(o.kernel || 'none')].join(' | ');\n}\n\n// 檢查儲存的速率。只接受 gpu、cpu 都是有限正數的物件；其餘一律視為沒有資料。\nfunction sanitizeRates(v) {\n  if (!v || typeof v !== 'object') return null;\n  const g = Number(v.gpu), c = Number(v.cpu);\n  if (!(isFinite(g) && g > 0 && isFinite(c) && c > 0)) return null;\n  return { gpu: g, cpu: c, updatedAt: Number(v.updatedAt) || 0 };\n}\n\n// 指數平均（與 cpu_share 相同的 0.6／0.4 權重）\nconst ema = (old, v) => (old > 0 ? old * 0.6 + v * 0.4 : v);\n\n// 包裝儲存後端。backend: { get(key) → Promise<any>, set(key, value) → Promise }\n// 讀取：失敗或資料不合法 → null。寫入：失敗就忽略（回傳 false）。\nfunction createRateStore(backend) {\n  if (!backend || typeof backend.get !== 'function' || typeof backend.set !== 'function') {\n    throw new TypeError('createRateStore：需要 backend.get 與 backend.set');\n  }\n  return {\n    async load(key) {\n      try {\n        return sanitizeRates(await backend.get(key));\n      } catch (_) {\n        return null;\n      }\n    },\n    async save(key, rates) {\n      const clean = sanitizeRates(rates);\n      if (!clean) return false;\n      try {\n        await backend.set(key, clean);\n        return true;\n      } catch (_) {\n        return false;\n      }\n    },\n  };\n}\n\n// 記憶體後端（測試用，也可在 IndexedDB 不能用時當退路；注意：這種退路不會跨頁面保存）\nfunction memoryBackend() {\n  const m = new Map();\n  return {\n    get: async (k) => m.get(k),\n    set: async (k, v) => { m.set(k, v); },\n    _map: m,\n  };\n}\n\nmodule.exports = { rateKey, sanitizeRates, ema, createRateStore, memoryBackend };\n\n};\nMODS[\"hetero_rates_idb\"] = function (module, exports, require) {\n'use strict';\n// 速率的 IndexedDB 後端（設計見 docs/DESIGN.cudaweb-hetero.md 第 3 節）。\n// 只做「鍵值存取」：get(key) → Promise<值或 undefined>，set(key, value) → Promise。\n// 與 hetero_rates.js 的 createRateStore 搭配使用（後者負責資料檢查與吞掉錯誤）。\n// idb 由呼叫端注入（瀏覽器預設 indexedDB；測試用假的）。資料庫與物件庫名稱與變體競賽分開。\n\nfunction createIdbBackend(o) {\n  o = o || {};\n  const idb = o.idb || (typeof indexedDB !== 'undefined' ? indexedDB : null);\n  if (!idb || typeof idb.open !== 'function') throw new Error('沒有 IndexedDB（速率將不會保存，改用保守預設）');\n  const dbName = o.dbName || 'fa-cudaweb-rates';\n  const storeName = o.storeName || 'rates';\n  let dbP = null;\n\n  function open() {\n    if (dbP) return dbP;\n    dbP = new Promise((resolve, reject) => {\n      const req = idb.open(dbName, 1);\n      req.onupgradeneeded = () => {\n        const db = req.result;\n        if (!db.objectStoreNames.contains(storeName)) db.createObjectStore(storeName);\n      };\n      req.onsuccess = () => resolve(req.result);\n      req.onerror = () => reject(req.error || new Error('IndexedDB 開啟失敗'));\n      req.onblocked = () => reject(new Error('IndexedDB 被其他分頁擋住'));\n    });\n    // 開啟失敗就清掉快取的 promise，下一次再試\n    dbP.catch(() => { dbP = null; });\n    return dbP;\n  }\n\n  function run(mode, makeReq) {\n    return open().then((db) => new Promise((resolve, reject) => {\n      const tx = db.transaction(storeName, mode);\n      const store = tx.objectStore(storeName);\n      const r = makeReq(store);\n      let out;\n      if (r) r.onsuccess = () => { out = r.result; };\n      tx.oncomplete = () => resolve(out);\n      tx.onerror = () => reject(tx.error || new Error('IndexedDB 交易失敗'));\n      tx.onabort = () => reject(tx.error || new Error('IndexedDB 交易中止'));\n    }));\n  }\n\n  return {\n    get: (key) => run('readonly', (s) => s.get(key)),\n    set: (key, value) => run('readwrite', (s) => s.put(value, key)),\n  };\n}\n\nmodule.exports = { createIdbBackend };\n\n};\nMODS[\"kernel_select\"] = function (module, exports, require) {\n// kernel_select.js — cudaweb 核心變體選擇器（清單 O1）。純函式：不碰 GPU、不碰 DOM，node 可測。\n// 輸入：能力表（probeCaps 從 adapter／device 讀出，探不到的給保守預設）、運算名稱、形狀、覆蓋表。\n// 輸出：{ id, tier, reason, forced }。每個變體宣告它需要的能力與共用記憶體用量，能力不足的變體不會被選到。\n// 只有已實作的變體才列在表裡；計畫中的變體（f16、子群組、貼圖記憶體）等實作時才加進來。\n'use strict';\n\nconst KIB = 1024;\n// 保守預設：探不到時當作低階（這是 Kepler 等級，所有核心都必須能跑）\nconst DEFAULT_CAPS = {\n  probed: false,\n  software: false,\n  maxWorkgroupStorage: 16 * KIB,\n  maxInvocations: 256,\n  maxWorkgroupSizeX: 256,\n  maxStorageBinding: 128 * 1024 * 1024,\n  maxUniformBinding: 64 * KIB,\n  maxTextureDim: 8192,\n  hasF16: false,\n  hasSubgroups: false,\n  hasTimestamp: false,\n  hasPackedDot: false,\n};\n\n// 能力表：從 adapter（features、info）與 device（limits）讀出。兩者都可能缺，缺的用保守預設。\nfunction probeCaps(adapter, device) {\n  const caps = Object.assign({}, DEFAULT_CAPS);\n  const lim = (device && device.limits) || (adapter && adapter.limits) || null;\n  if (!lim) return caps;\n  const num = (v, d) => (typeof v === 'number' && isFinite(v) ? v : d);\n  caps.probed = true;\n  caps.maxWorkgroupStorage = num(lim.maxComputeWorkgroupStorageSize, caps.maxWorkgroupStorage);\n  caps.maxInvocations = num(lim.maxComputeInvocationsPerWorkgroup, caps.maxInvocations);\n  caps.maxWorkgroupSizeX = num(lim.maxComputeWorkgroupSizeX, caps.maxWorkgroupSizeX);\n  caps.maxStorageBinding = num(lim.maxStorageBufferBindingSize, caps.maxStorageBinding);\n  caps.maxUniformBinding = num(lim.maxUniformBufferBindingSize, caps.maxUniformBinding);\n  caps.maxTextureDim = num(lim.maxTextureDimension2D, caps.maxTextureDim);\n  const feats = (device && device.features) || (adapter && adapter.features) || null;\n  const has = (name) => !!(feats && typeof feats.has === 'function' && feats.has(name));\n  caps.hasF16 = has('shader-f16');\n  caps.hasSubgroups = has('subgroups');\n  caps.hasTimestamp = has('timestamp-query');\n  caps.hasPackedDot = has('packed_4x8_integer_dot_product');  // 語言功能；這裡只記錄，尚無核心使用\n  caps.software = !!(adapter && adapter.isFallbackAdapter);\n  return caps;\n}\n\n// 等級定義（看能力，不看廠牌）：\n//   min  ：軟體 adapter，或共用記憶體／執行緒上限比低階還小 → 只用逐格的簡單核心\n//   low  ：共用記憶體 ≥16 KiB、每群組 ≥256 執行緒、沒有 f16、沒有子群組（Kepler 14 W 這台屬於這一級）\n//   mid  ：有 shader-f16 或點積語言功能，且共用記憶體 ≥32 KiB\n//   high ：有子群組，且共用記憶體 ≥48 KiB\nfunction tierOf(caps) {\n  if (!caps || !caps.probed || caps.software) return 'min';\n  if (caps.maxWorkgroupStorage < 16 * KIB || caps.maxInvocations < 256 || caps.maxWorkgroupSizeX < 256) return 'min';\n  if (caps.hasSubgroups && caps.maxWorkgroupStorage >= 48 * KIB) return 'high';\n  if ((caps.hasF16 || caps.hasPackedDot) && caps.maxWorkgroupStorage >= 32 * KIB) return 'mid';\n  return 'low';\n}\n\n// 變體表：每個運算依偏好順序列出已實作的變體。needs 是能力下限；shared 是共用記憶體位元組；threads 是每群組執行緒數。\n// applies(shape) 決定形狀是否適用（沒有 applies 表示任何形狀都適用）。最後一個一定是無需求的簡單版（保底）。\nconst VARIANTS = {\n  matmul: [\n    // split-K（mm_splitk.js，R3）：K ≥ 1024，且 M=1（解碼）或 N ≤ 64 且 M ≤ 64（LoRA 小秩）時，把 K 切片（S 由 pickSplits 決定），兩段派發（部分和＋歸約），同一批次送出。\n    //   同機 intel xe-lpg 純核心（每次派發，20 次中位數，雜訊約 ±15%）：1×1024×1024 0.15 ms（simple 0.47、vec4 0.40、子群組 0.26）；\n    //   1×1024×3072 0.49（子群組 0.65、vec4 0.71）；1×8192×1024 1.18（子群組 1.92、vec4 2.10）；\n    //   LoRA：8×4096×16 0.195（vec4 0.725）；1×4096×16 0.155（子群組 0.245）；64×1024×16 0.145（vec4 0.235）；16×4096×64 0.205（vec4 0.74）。\n    //   輸的：8×4096×1024 split-K 1.89 對 vec4 1.13；64×1024×256 0.46 對 vec4 0.255。\n    { id: 'mm_splitk_f32', shared: 0, threads: 256, needs: {}, applies: (s) => s.K >= 1024 && (s.M === 1 || (s.N <= 64 && s.M <= 64)) },\n    // 子群組版（mm_subgroup.js）：M=1 且 K < 1024 時（split-K 不適用）且有 subgroups 才選。K < 1024 的 M=1 與 simple 比較沒有量測（見 mm_subgroup_integ_check 只驗正確性）。\n    //   同機 intel xe-lpg：1×1024×1024 0.255 ms（vec4 0.425、simple 0.515）；M=8、16 比 vec4 慢，所以只給 M=1。\n    { id: 'mm_subgroup_f32', shared: 0, threads: 256, needs: { subgroups: true }, applies: (s) => s.M === 1 && s.K < 1024 },\n    // vec4 載入版（O5）：K、N 為 4 的倍數、不轉置時才用；同一份平鋪幾何，只把全域讀取改成 vec4\n    { id: 'mm_vec4_f32', shared: 8 * KIB, threads: 256, needs: {}, applies: (s) => s.M >= 16 && s.N >= 16 && s.K % 4 === 0 && s.N % 4 === 0 },\n    { id: 'mm_tiled_f32', shared: 8 * KIB, threads: 256, needs: {}, applies: (s) => s.M >= 16 && s.N >= 16 },\n    { id: 'mm_simple_f32', shared: 0, threads: 1, needs: {} },\n  ],\n  // q8mm 的順序與 infer_ops.q8mmVariant 的自動規則一致（K 未給時只有 i32 版；f32 版只在 K ≤ 4096 時適用）。\n  // shared 來自各 WGSL 的 var<workgroup> 位元組數（見 infer_ops.js 的 WGSL_Q8MM_*）。\n  q8mm: [\n    { id: 'q8mm_pf8x4', shared: 6 * KIB, threads: 256, needs: {}, applies: (s) => s.N % 4 === 0 && s.M >= 64 && s.K !== undefined && s.K <= 4096 },\n    { id: 'q8mm_pf', shared: 5 * KIB, threads: 256, needs: {}, applies: (s) => s.N % 4 === 0 && s.M >= 64 },\n    { id: 'q8mm_decr8f', shared: 8 * KIB, threads: 256, needs: {}, applies: (s) => s.N % 4 === 0 && s.M >= 8 && s.K !== undefined && s.K <= 4096 },\n    { id: 'q8mm_decr8', shared: 8 * KIB, threads: 256, needs: {}, applies: (s) => s.N % 4 === 0 && s.M >= 8 },\n    { id: 'q8mm_decr4f', shared: 8 * KIB, threads: 256, needs: {}, applies: (s) => s.N % 4 === 0 && s.M >= 4 && s.K !== undefined && s.K <= 4096 },\n    { id: 'q8mm_decr', shared: 8 * KIB, threads: 256, needs: {}, applies: (s) => s.N % 4 === 0 && s.M >= 4 },\n    { id: 'q8mm_decr2f', shared: 6 * KIB, threads: 256, needs: {}, applies: (s) => s.N % 4 === 0 && s.M === 2 && s.K !== undefined && s.K <= 4096 },\n    { id: 'q8mm_dec', shared: 5 * KIB, threads: 256, needs: {}, applies: (s) => s.N % 4 === 0 },\n    { id: 'q8mm_simple', shared: 0, threads: 64, needs: {} },\n  ],\n};\n\nfunction meets(caps, v) {\n  if (caps.maxWorkgroupStorage < v.shared) return '共用記憶體 ' + v.shared + ' 位元組超過上限 ' + caps.maxWorkgroupStorage;\n  if (caps.maxInvocations < v.threads) return '每群組 ' + v.threads + ' 執行緒超過上限 ' + caps.maxInvocations;\n  if (caps.maxWorkgroupSizeX < Math.min(v.threads, 256)) return 'workgroup X 上限不足';\n  if (v.needs.f16 && !caps.hasF16) return '缺 shader-f16';\n  if (v.needs.subgroups && !caps.hasSubgroups) return '缺 subgroups';\n  if (v.needs.packedDot && !caps.hasPackedDot) return '缺 packed_4x8_integer_dot_product';\n  return null;\n}\n\n// pickVariant(op, shape, caps, overrides) → { id, tier, reason, forced }\n//   overrides：{ [op]: 變體 id }。強制的變體若能力不足，不硬用，退回自動選擇並在 reason 寫明。\nfunction pickVariant(op, shape, caps, overrides) {\n  const list = VARIANTS[op];\n  if (!list) throw new Error('kernel_select：未知運算 ' + op);\n  const c = caps || DEFAULT_CAPS;\n  const tier = tierOf(c);\n  const s = shape || {};\n  const forcedId = overrides && overrides[op];\n  const notes = [];\n  if (forcedId) {\n    const v = list.find((x) => x.id === forcedId);\n    if (!v) notes.push('強制變體 ' + forcedId + ' 不存在');\n    else if (v.applies && !v.applies(s)) notes.push('強制變體 ' + forcedId + ' 不適用此形狀');\n    else if (meets(c, v)) notes.push('強制變體 ' + forcedId + ' 能力不足：' + meets(c, v));\n    else return { id: v.id, tier: tier, reason: '強制指定', forced: true };\n  }\n  for (const v of list) {\n    if (v.applies && !v.applies(s)) continue;\n    const why = meets(c, v);\n    if (why) { notes.push(v.id + '：' + why); continue; }\n    return { id: v.id, tier: tier, reason: notes.join('；'), forced: false };\n  }\n  throw new Error('kernel_select：' + op + ' 沒有可用變體（保底變體也不符合，這不應發生）');\n}\n\n// ---------- 變體競賽的快取（清單 O9）：只處理鍵、失效與挑選；實際計時在瀏覽器端做 ----------\n// 快取鍵 = adapter 描述 | 運算 | 形狀區間 | 能力表雜湊。能力表一變（換卡、換驅動、旗標變了），雜湊就變，舊結果自動失效。\nfunction fnv1a(str) {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }\n  return ('00000000' + h.toString(16)).slice(-8);\n}\nfunction capsHash(caps) {\n  const c = caps || DEFAULT_CAPS;\n  return fnv1a(JSON.stringify([c.maxWorkgroupStorage, c.maxInvocations, c.maxWorkgroupSizeX, c.maxStorageBinding, c.maxUniformBinding, c.maxTextureDim, c.hasF16, c.hasSubgroups, c.hasTimestamp, c.hasPackedDot, c.software]));\n}\n// 形狀區間：每一維取不小於它的 2 的冪次（同一區間共用一個競賽結果）\nfunction ceilPow2(v) { let b = 1; while (b < v) b *= 2; return b; }\nfunction shapeBucket(shape) {\n  const s = shape || {};\n  return Object.keys(s).sort().map((k) => k + ceilPow2(Math.max(1, s[k] | 0))).join(',');\n}\nfunction cacheKey(adapterDesc, op, shape, caps) {\n  return [String(adapterDesc || 'unknown'), op, shapeBucket(shape), capsHash(caps)].join('|');\n}\n// store：任何有 get(key)／set(key, value) 的物件（瀏覽器端用 localStorage 包一層）。\n// 回傳 { id, source: 'forced'|'tuned'|'rule', reason }。已強制的永遠優先；快取裡的變體若能力不足就忽略。\nfunction pickWithCache(op, shape, caps, overrides, store, adapterDesc) {\n  const forcedId = overrides && overrides[op];\n  if (forcedId) {\n    const r = pickVariant(op, shape, caps, overrides);\n    return { id: r.id, source: r.forced ? 'forced' : 'rule', reason: r.reason };\n  }\n  const key = cacheKey(adapterDesc, op, shape, caps);\n  let entry = null;\n  try { entry = store && store.get ? store.get(key) : null; } catch (_) { entry = null; }\n  if (entry && entry.id) {\n    const v = (VARIANTS[op] || []).find((x) => x.id === entry.id);\n    if (v && !(v.applies && !v.applies(shape || {})) && !meets(caps || DEFAULT_CAPS, v)) {\n      return { id: v.id, source: 'tuned', reason: '快取的競賽結果（' + key + '）' };\n    }\n  }\n  const r = pickVariant(op, shape, caps, overrides);\n  return { id: r.id, source: 'rule', reason: r.reason };\n}\n// 競賽結果：timings = { 變體 id: [毫秒, 毫秒, ...] }，取中位數最小者；沒有有效量測回傳 null\nfunction medianOf(xs) {\n  const a = xs.filter((x) => typeof x === 'number' && isFinite(x)).sort((p, q) => p - q);\n  if (!a.length) return null;\n  const m = a.length >> 1;\n  return a.length % 2 ? a[m] : (a[m - 1] + a[m]) / 2;\n}\nfunction chooseWinner(timings) {\n  let b