base: inc.manifest.base, compat: Object.assign({}, inc.manifest.compat, { data_sha256: undefined }), counts: Object.assign({}, existing.counts, inc.manifest.counts), eval: inc.manifest.eval, parent: existing.parent, owner: existing.owner, created: existing.created, extra: inc.manifest.extra });\n            asset = { manifest: mf, files };\n        }\n        const w = await storage.saveAsset(asset, { replace: plan.action !== 'merge' });\n        return { ok: !!w.ok, plan, summary: r.summary, write: w, dataMayBeLost: !!w.dataMayBeLost, warnings: r.warnings, error: w.ok ? undefined : w.error };\n    }\n\n    // ===== 分卷（整個容器再切） =====\n    function splitVolumes(bytes, baseName, maxBytes) {\n        maxBytes = maxBytes || SHARD_BYTES; const out = [];\n        for (let i = 0, k = 1; i < bytes.length; i += maxBytes, k++) out.push({ name: baseName + '.' + String(k).padStart(3, '0'), bytes: bytes.subarray(i, Math.min(bytes.length, i + maxBytes)) });\n        if (!out.length) out.push({ name: baseName + '.001', bytes: new Uint8Array(0) });\n        return out;\n    }\n    function joinVolumes(volumes) {\n        const vs = volumes.slice().sort((a, b) => (a.name < b.name ? -1 : 1));\n        for (let i = 0; i < vs.length; i++) { const m = /\\.(\\d{3})$/.exec(vs[i].name); if (!m || Number(m[1]) !== i + 1) throw new Error('分卷不連續或檔名不對：缺少第 ' + String(i + 1).padStart(3, '0') + ' 卷'); }\n        let n = 0; for (const x of vs) n += x.bytes.length; const out = new Uint8Array(n); let o = 0; for (const x of vs) { out.set(x.bytes, o); o += x.bytes.length; }\n        return out;\n    }\n\n    return { SHARD_BYTES, crc32, writeZip, readZip, exportAsset, readAsset, inspect, importAsset, splitVolumes, joinVolumes };\n});\n\n};\nMODS[\"onnx_patch_core\"] = function (module, exports, require) {\n/* 網頁版 LoRA：最小的 ONNX（protobuf）讀寫器——只做「找節點／初始值」與「換掉某些初始值」，其他位元組原封不動複製（零拷貝切片）。\n *  純函式核心（UMD）：Node 與瀏覽器（含 Worker）都能載入。不依賴 onnx 套件。\n *  為什麼自己寫：網頁版要在載入 q8 模型前改權重與縮放值（DESIGN.TODO.offline-training-studio.md §14 路線 c），模型約 600 MB，只能在記憶體裡做位元組級修改。\n *  支援範圍（超出就丟明確錯誤，絕不靜默產生壞模型）：\n *   - 權重必須是 raw_data 內嵌（不是外部資料檔、不是 int32_data 之類的欄位）。\n *   - 被換掉的初始值不得同時出現在 graph.input（舊版 IR 把初始值也列為輸入，換形狀會對不上宣告）。\n *  API：\n *   indexModel(bytes) → {graph:{tagStart,start,end}, nodes:[{name,op,inputs,outputs}], inits:Map<name,{dataType,dims,rawStart,rawEnd,tagStart,start,end,external}>, graphInputs:Set, producers:Map<output,node>, consumers:Map<name,node[]>}\n *   encodeTensor({name,dataType,dims,raw}) → Uint8Array（TensorProto）\n *   rewrite(bytes, index, replacements:Map<initName,Uint8Array 新 TensorProto>) → {parts:Uint8Array[], length}\n *   concatParts(parts, length) → Uint8Array；toBlob(parts) → Blob */\n(function (root, factory) {\n    if (typeof module === 'object' && module.exports) module.exports = factory();\n    else root.FaOnnxPatch = factory();\n})(typeof self !== 'undefined' ? self : this, function () {\n    'use strict';\n    const TD = typeof TextDecoder !== 'undefined' ? new TextDecoder('utf-8') : null;\n    const TE = typeof TextEncoder !== 'undefined' ? new TextEncoder() : null;\n    const DT = { FLOAT: 1, UINT8: 2, INT8: 3 };\n\n    function readVarint(b, p) {\n        let v = 0, mul = 1, i = 0;\n        for (;;) {\n            if (p >= b.length) throw new Error('protobuf 讀到檔尾（檔案不完整或不是 ONNX）');\n            const c = b[p++];\n            v += (c & 0x7f) * mul; mul *= 128; i++;\n            if (!(c & 0x80)) return [v, p];\n            if (i > 9) throw new Error('protobuf varint 過長');\n        }\n    }\n    function varintBytes(v) {\n        const out = [];\n        while (v >= 128) { out.push((v % 128) | 0x80); v = Math.floor(v / 128); }\n        out.push(v);\n        return Uint8Array.from(out);\n    }\n    // 走訪 [p, end) 內的欄位。回呼 fn({num, wt, tagStart, vs, ve, val}) ；wt=2 時 [vs,ve) 是內容，wt=0 時 val 是數值\n    function eachField(b, p, end, fn) {\n        while (p < end) {\n            const tagStart = p; let tag; [tag, p] = readVarint(b, p);\n            const num = Math.floo