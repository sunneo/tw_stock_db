t, ptr %t312\n  %t314 = fmul float %t313, 0x3FE0000000000000\n  %t315 = getelementptr float, ptr %a11, i32 1\n  store float %t314, ptr %t315\n  %t316 = getelementptr float, ptr %a9, i32 2\n  %t317 = load float, ptr %t316\n  %t318 = fmul float %t317, 0x3FE0000000000000\n  %t319 = getelementptr float, ptr %a11, i32 2\n  store float %t318, ptr %t319\n  br label %endif88\nendif88:\n  br label %endif84\nendif84:\n  %t320 = load i32, ptr %a22\n  %t321 = icmp ne i32 %t320, 0\n  br i1 %t321, label %then89, label %endif90\nthen89:\n  %t322 = getelementptr float, ptr %a11, i32 0\n  %t323 = load float, ptr %t322\n  %t324 = getelementptr float, ptr %a10, i32 0\n  store float %t323, ptr %t324\n  %t325 = getelementptr float, ptr %a11, i32 1\n  %t326 = load float, ptr %t325\n  %t327 = getelementptr float, ptr %a10, i32 1\n  store float %t326, ptr %t327\n  %t328 = getelementptr float, ptr %a11, i32 2\n  %t329 = load float, ptr %t328\n  %t330 = getelementptr float, ptr %a10, i32 2\n  store float %t329, ptr %t330\n  br label %endif90\nendif90:\n  %t331 = load i32, ptr %a22\n  %t332 = icmp eq i32 %t331, 0\n  br i1 %t332, label %then91, label %endif92\nthen91:\n  %t333 = getelementptr float, ptr %a9, i32 0\n  %t334 = load float, ptr %t333\n  %t335 = fmul float %t334, 0x3FE0000000000000\n  %t336 = getelementptr float, ptr %a10, i32 0\n  store float %t335, ptr %t336\n  %t337 = getelementptr float, ptr %a9, i32 1\n  %t338 = load float, ptr %t337\n  %t339 = fmul float %t338, 0x3FE0000000000000\n  %t340 = getelementptr float, ptr %a10, i32 1\n  store float %t339, ptr %t340\n  %t341 = getelementptr float, ptr %a9, i32 2\n  %t342 = load float, ptr %t341\n  %t343 = fmul float %t342, 0x3FE0000000000000\n  %t344 = getelementptr float, ptr %a10, i32 2\n  store float %t343, ptr %t344\n  br label %endif92\nendif92:\n  %t345 = load float, ptr %a26\n  %t346 = load float, ptr %a27\n  %t347 = load float, ptr %a28\n  %t348 = getelementptr float, ptr %a9, i32 7\n  %t349 = load float, ptr %t348\n  call void @draw_scene(ptr %a1, ptr %a2, ptr %a3, i32 %t17, ptr %a10, float %t345, float %t346, float %t347, float %t349)\n  %t350 = load i32, ptr %a23\n  %t351 = icmp ne i32 %t350, 0\n  br i1 %t351, label %then93, label %endif94\nthen93:\n  %t352 = load i32, ptr %a20\n  %t353 = load i32, ptr %a16\n  %t354 = load float, ptr %a34\n  %t355 = load i32, ptr %a21\n  %t356 = load float, ptr %a26\n  %t357 = load float, ptr %a27\n  %t358 = load float, ptr %a28\n  %t359 = load i32, ptr %a22\n  %t360 = load i32, ptr %a25\n  call void @draw_hud(i32 %t17, i32 %t352, i32 %t353, float %t354, ptr %a9, i32 %t355, float %t356, float %t357, float %t358, i32 %t359, i32 %t360)\n  br label %endif94\nendif94:\n  call void @SDL_GL_SwapWindow(ptr %t19)\n  call void @SDL_Delay(i32 1)\n  %t361 = load i32, ptr %a19\n  %t362 = add i32 %t361, 1\n  store i32 %t362, ptr %a19\n  %t363 = load i32, ptr %a17\n  %t364 = icmp sgt i32 %t363, 0\n  %t365 = load i32, ptr %a19\n  %t366 = load i32, ptr %a17\n  %t367 = icmp sge i32 %t365, %t366\n  %t368 = and i1 %t364, %t367\n  br i1 %t368, label %then95, label %endif96\nthen95:\n  store i32 0, ptr %a18\n  br label %endif96\nendif96:\n  br label %wc13\nwe15:\n  %t369 = load i32, ptr %a19\n  %t370 = getelementptr float, ptr %a12, i32 0\n  %t371 = load float, ptr %t370\n  %t372 = fpext float %t371 to double\n  %t373 = getelementptr float, ptr %a12, i32 1\n  %t374 = load float, ptr %t373\n  %t375 = fpext float %t374 to double\n  %t376 = getelementptr float, ptr %a12, i32 2\n  %t377 = load float, ptr %t376\n  %t378 = fpext float %t377 to double\n  %t379 = call i32 (ptr, ...) @printf(ptr @.s23, i32 %t369, i32 %t17, double %t372, double %t375, double %t378)\n  call void @SDL_GL_DeleteContext(ptr %t20)\n  call void @SDL_DestroyWindow(ptr %t19)\n  call void @SDL_Quit()\n  ret i32 0\n}\n\n',"llc/gpgpu/opencl_icd_reduce.ll":'; OpenCL 局部記憶體歸約（ICD 模式）：核心用 __local 與 barrier 做樹狀歸約，4 個工作群各算 64 個 float 的和，主機再加總。\n; 第一行註解 "fa-opencl: icd" 讓 run terminal 把這份 IR 的 cl* 呼叫交給 ICD 載入器（OpenCL C 前端 clc）——預設的墊片不支援 __local 與 barrier。\n; 真機器（有 OpenCL 驅動）：clang／lli 照常連結 libOpenCL，同一份 IR 直接跑。\n; fa-opencl: icd\ntarget triple = "x86_64-pc-linux-gnu"\n\n@src = private constant [306 x i8] c"__kernel void red(__global const float* x, __global float* out, __local float* t) { int l = get_local_id(0); t[l] = x[get_global_id(0)]; barrier(CLK_LOCAL_MEM_FENCE); for (int s = 32; s > 0; s >>= 1) { if (l < s) t[l] += t[l + s]; barrier(CLK_LOCAL_MEM_FENCE); } if (l == 0) out[get_group_id(0)] = t[0]; }\\00"\n@name = private constant [4 x i8] c"red\\00"\n@okf = private constant [17 x i8] c"red OK sum=%.1f\\0A\\00"\n@badf = private constant [30 x i8] c"red MISMATCH sum=%.1f err=%d\\0A\\00"\n\ndeclare i32 @clGetPlatformIDs(i32, ptr, ptr)\ndeclare i32 @clGetDeviceIDs(ptr, i64, i32, ptr, ptr)\ndeclare ptr @clCreateContext(ptr, i32, ptr, ptr, ptr, ptr)\ndeclare ptr @clCreateCommandQueue(ptr, ptr, i64, ptr)\ndeclare ptr @clCreateProgramWithSource(ptr, i32, ptr, ptr, ptr)\ndeclare i32 @clBuildProgram(ptr, i32, ptr, ptr, ptr, ptr)\ndeclare ptr @clCreateKernel(ptr, ptr, ptr)\ndeclare ptr @clCreateBuffer(ptr, i64, i64, ptr, ptr)\ndeclare i32 @clSetKernelArg(ptr, i32, i64, ptr)\ndeclare i32 @clEnqueueNDRangeKernel(ptr, ptr, i32, ptr, ptr, ptr, i32, ptr, ptr)\ndeclare i32 @clEnqueueReadBuffer(ptr, ptr, i32, i64, i64, ptr, i32, ptr, ptr)\ndeclare ptr @malloc(i32)\ndeclare i32 @printf(ptr, ...)\n\ndefine i32 @main(i32 %argc, ptr %argv) {\nentry:\n  %plat = alloca ptr\n  %dev = alloca ptr\n  %rc = alloca i32\n  %srcp = alloca ptr\n  %bx = alloca ptr\n  %bo = alloca ptr\n  %gws = alloca i32\n  %lws = alloca i32\n  %iv = alloca i32\n  %err = alloca i32\n  store i32 0, ptr %err\n  %e1 = call i32 @clGetPlatformIDs(i32 1, ptr %plat, ptr null)\n  %p = load ptr, ptr %plat\n  %e2 = call i32 @clGetDeviceIDs(ptr %p, i64 2, i32 1, ptr %dev, ptr null)      ; CL_DEVICE_TYPE_CPU\n  %c = call ptr @clCreateContext(ptr null, i32 1, ptr %dev, ptr null, ptr null, ptr %rc)\n  %d = load ptr, ptr %dev\n  %q = call ptr @clCreateCommandQueue(ptr %c, ptr %d, i64 0, ptr %rc)\n  store ptr @src, ptr %srcp\n  %prog = call ptr @clCreateProgramWithSource(ptr %c, i32 1, ptr %srcp, ptr null, ptr %rc)\n  %e3 = call i32 @clBuildProgram(ptr %prog, i32 1, ptr %dev, ptr null, ptr null, ptr null)\n  %k = call ptr @clCreateKernel(ptr %prog, ptr @name, ptr %rc)\n  %hx = call ptr @malloc(i32 1024)\n  %ho = call ptr @malloc(i32 16)\n  store i32 0, ptr %iv\n  br label %fill\nfill:\n  %i = load i32, ptr %iv\n  %more = icmp slt i32 %i, 256\n  br i1 %more, label %fillbody, label %run\nfillbody:\n  %fi = sitofp i32 %i to float\n  %px = getelementptr float, ptr %hx, i32 %i\n  store float %fi, ptr %px\n  %i1 = add i32 %i, 1\n  store i32 %i1, ptr %iv\n  br label %fill\nrun:\n  %b1 = call ptr @clCreateBuffer(ptr %c, i64 36, i64 1024, ptr %hx, ptr %rc)    ; READ_ONLY|COPY_HOST_PTR\n  %b2 = call ptr @clCreateBuffer(ptr %c, i64 2, i64 16, ptr null, ptr %rc)      ; WRITE_ONLY\n  store ptr %b1, ptr %bx\n  store ptr %b2, ptr %bo\n  %a0 = call i32 @clSetKernelArg(ptr %k, i32 0, i64 4, ptr %bx)\n  %a1 = call i32 @clSetKernelArg(ptr %k, i32 1, i64 4, ptr %bo)\n  %a2 = call i32 @clSetKernelArg(ptr %k, i32 2, i64 256, ptr null)              ; __local float[64]\n  store i32 256, ptr %gws\n  store i32 64, ptr %lws\n  %e4 = call i32 @clEnqueueNDRangeKernel(ptr %q, ptr %k, i32 1, ptr null, ptr %gws, ptr %lws, i32 0, ptr null, ptr null)\n  %e5 = call i32 @clEnqueueReadBuffer(ptr %q, ptr %b2, i32 1, i64 0, i64 16, ptr %ho, i32 0, ptr null, ptr null)\n  %o0 = load float, ptr %ho\n  %p1 = getelementptr float, ptr %ho, i32 1\n  %o1 = load float, ptr %p1\n  %p2 = getelementptr float, ptr %ho, i32 2\n  %o2 = load float, ptr %p2\n  %p3 = getelementptr float, ptr %ho, i32 3\n  %o3 = load float, ptr %p3\n  %s01 = fadd float %o0, %o1\n  %s23 = fadd float %o2, %o3\n  %sum = fadd float %s01, %s23\n  %ea = or i32 %e1, %e2\n  %eb = or i32 %e3, %e4\n  %ec = or i32 %e5, %a0\n  %ed = or i32 %a1, %a2\n  %ee = or i32 %ea, %eb\n  %ef = or i32 %ec, %ed\n  %eg = or i32 %ee, %ef\n  %good = fcmp oeq float %sum, 3.264000e+04\n  %sd = fpext float %sum to double\n  br i1 %good, label %ok, label %bad\nok:\n  %r1 = call i32 (ptr, ...) @printf(ptr @okf, double %sd)\n  ret i32 %eg\nbad:\n  %r2 = call i32 (ptr, ...) @printf(ptr @badf, double %sd, i32 %eg)\n  ret i32 1\n}\n',"llc/gpgpu/opencl_vecadd.ll":'; OpenCL 向量相加（GPGPU）：c[i] = a[i] + b[i]，N 個 float（預設 1048576，可由第一個參數指定），用 OpenCL C 核心字串在執行時編譯。\n; 流程：平台 → 裝置（GPU 優先、沒有就 CPU）→ context → queue → program（編譯核心）→ kernel → buffer → 執行 → 讀回 → 驗證。\n; 在 run terminal／job 的模擬環境：OpenCL 由 renderer/src/uml/llvm_host.js 的 CPU 後備提供（核心字串用 JS 執行，不需要 GPU 或驅動）。\n; 真機器（有 OpenCL 驅動）：clang／lli 照常連結 libOpenCL，同一份 IR 直接跑。建置：見 ../README.md。\n; 注意：本墊片的核心只支援簡單子集（見 DESIGN.run-terminal.md §21）；這個範例的核心（get_global_id＋算術＋if）在子集內。\ntarget triple = "x86_64-pc-linux-gnu"\n\n@src = private constant [136 x i8] c"__kernel void vadd(__global const float*a,__global const float*b,__global float*c,int n){int i=get_global_id(0);if(i<n)c[i]=a[i]+b[i];}\\00"\n@name = private constant [5 x i8] c"vadd\\00"\n@ok = private constant [20 x i8] c"vadd OK, n=%d c=%f\\0A\\00"\n@bad = private constant [26 x i8] c"vadd MISMATCH at %d: %f\\0A\\00\\00"\n@err = private constant [22 x i8] c"OpenCL error %d at %d\\00"\n@errnl = private constant [2 x i8] c"\\0A\\00"\n\ndeclare i32 @clGetPlatformIDs(i32, ptr, ptr)\ndeclare i32 @clGetDeviceIDs(ptr, i64, i32, ptr, ptr)\ndeclare ptr @clCreateContext(ptr, i32, ptr, ptr, ptr, ptr)\ndeclare ptr @clCreateCommandQueue(ptr, ptr, i64, ptr)\ndeclare ptr @clCreateProgramWithSource(ptr, i32, ptr, ptr, ptr)\ndeclare i32 @clBuildProgram(ptr, i32, ptr, ptr, ptr, ptr)\ndeclare ptr @clCreateKernel(ptr, ptr, ptr)\ndeclare ptr @clCreateBuffer(ptr, i64, i64, ptr, ptr)\ndeclare i32 @clSetKernelArg(ptr, i32, i64, ptr)\ndeclare i32 @clEnqueueNDRangeKernel(ptr, ptr, i32, ptr, ptr, ptr, i32, ptr, ptr)\ndeclare i32 @clEnqueueReadBuffer(ptr, ptr, i32, i64, i64, ptr, i32, ptr, ptr)\ndeclare i32 @clFinish(ptr)\ndeclare ptr @malloc(i32)\ndeclare i32 @atoi(ptr)\ndeclare i32 @printf(ptr, ...)\n\ndefine i32 @fail(i32 %code, i32 %where) {\n  call i32 (ptr, ...) @printf(ptr @err, i32 %code, i32 %where)\n  call i32 (ptr, ...) @printf(ptr @errnl)\n  ret i32 1\n}\n\ndefine i32 @main(i32 %argc, ptr %argv) {\nentry:\n  %plat = alloca ptr\n  %dev = alloca ptr\n  %rc = alloca i32\n  %n = alloca i32\n  %gsz = alloca i64\n  %srcp = alloca ptr\n  %dbuf = alloca ptr\n  %da = alloca ptr\n  %db = alloca ptr\n  %dc = alloca ptr\n  %iv = alloca i32\n  %jv = alloca i32\n  store i32 1048576, ptr %n\n  %many = icmp sgt i32 %argc, 1\n  br i1 %many, label %getn, label %platform\ngetn:\n  %ap = getelementptr ptr, ptr %argv, i32 1\n  %a1 = load ptr, ptr %ap\n  %v = call i32 @atoi(ptr %a1)\n  store i32 %v, ptr %n\n  br label %platform\nplatform:\n  %r1 = call i32 @clGetPlatformIDs(i32 1, ptr %plat, ptr null)\n  %e1 = icmp ne i32 %r1, 0\n  br i1 %e1, label %f1, label %device\nf1:\n  %x1 = call i32 @fail(i32 %r1, i32 1)\n  ret i32 %x1\ndevice:\n  %p = load ptr, ptr %plat\n  %r2 = call i32 @clGetDeviceIDs(ptr %p, i64 4, i32 1, ptr %dev, ptr null)      ; CL_DEVICE_TYPE_GPU\n  %e2 = icmp ne i32 %r2, 0\n  br i1 %e2, label %cpu, label %ctx\ncpu:\n  %r2b = call i32 @clGetDeviceIDs(ptr %p, i64 2, i32 1, ptr %dev, ptr null)     ; 退回 CL_DEVICE_TYPE_CPU\n  %e2b = icmp ne i32 %r2b, 0\n  br i1 %e2b, label %f2, label %ctx\nf2:\n  %x2 = call i32 @fail(i32 %r2b, i32 2)\n  ret i32 %x2\nctx:\n  %c = call ptr @clCreateContext(ptr null, i32 1, ptr %dev, ptr null, ptr null, ptr %rc)\n  %d = load ptr, ptr %dev\n  %q = call ptr @clCreateCommandQueue(ptr %c, ptr %d, i64 0, ptr %rc)\n  store ptr @src, ptr %srcp\n  %prog = call ptr @clCreateProgramWithSource(ptr %c, i32 1, ptr %srcp, ptr null, ptr %rc)\n  %r3 = call i32 @clBuildProgram(ptr %prog, i32 1, ptr %dev, ptr null, ptr null, ptr null)\n  %e3 = icmp ne i32 %r3, 0\n  br i1 %e3, label %f3, label %kern\nf3:\n  %x3 = call i32 @fail(i32 %r3, i32 3)\n  ret i32 %x3\nkern:\n  %k = call ptr @clCreateKernel(ptr %prog, ptr @name, ptr %rc)\n  %nn = load i32, ptr %n\n  %n64 = sext i32 %nn to i64\n  %bytes = mul i64 %n64, 4\n  %b32 = trunc i64 %bytes to i32\n  %ha = call ptr @malloc(i32 %b32)\n  %hb = call ptr @malloc(i32 %b32)\n  %hc = call ptr @malloc(i32 %b32)\n  store i32 0, ptr %iv\n  br label %fill\nfill:\n  %i = load i32, ptr %iv\n  %more = icmp slt i32 %i, %nn\n  br i1 %more, label %fillbody, label %bufs\nfillbody:\n  %fi = sitofp i32 %i to float\n  %pa = getelementptr float, ptr %ha, i32 %i\n  %pb = getelementptr float, ptr %hb, i32 %i\n  store float %fi, ptr %pa\n  %fb = fmul float %fi, 0x4000000000000000\n  store float %fb, ptr %pb\n  %i1 = add i32 %i, 1\n  store i32 %i1, ptr %iv\n  br label %fill\nbufs:\n  %ba = call ptr @clCreateBuffer(ptr %c, i64 36, i64 %bytes, ptr %ha, ptr %rc)    ; READ_ONLY|COPY_HOST_PTR\n  %bb = call ptr @clCreateBuffer(ptr %c, i64 36, i64 %bytes, ptr %hb, ptr %rc)\n  %bc = call ptr @clCreateBuffer(ptr %c, i64 2, i64 %bytes, ptr null, ptr %rc)    ; WRITE_ONLY\n  store ptr %ba, ptr %da\n  store ptr %bb, ptr %db\n  store ptr %bc, ptr %dc\n  call i32 @clSetKernelArg(ptr %k, i32 0, i64 8, ptr %da)\n  call i32 @clSetKernelArg(ptr %k, i32 1, i64 8, ptr %db)\n  call i32 @clSetKernelArg(ptr %k, i32 2, i64 8, ptr %dc)\n  call i32 @clSetKernelArg(ptr %k, i32 3, i64 4, ptr %n)\n  store i64 %n64, ptr %gsz\n  %r4 = call i32 @clEnqueueNDRangeKernel(ptr %q, ptr %k, i32 1, ptr null, ptr %gsz, ptr null, i32 0, ptr null, ptr null)\n  %e4 = icmp ne i32 %r4, 0\n  br i1 %e4, label %f4, label %readback\nf4:\n  %x4 = call i32 @fail(i32 %r4, i32 4)\n  ret i32 %x4\nreadback:\n  %r5 = call i32 @clEnqueueReadBuffer(ptr %q, ptr %bc, i32 1, i64 0, i64 %bytes, ptr %hc, i32 0, ptr null, ptr null)\n  call i32 @clFinish(ptr %q)\n  store i32 0, ptr %jv\n  br label %check\ncheck:\n  %j = load i32, ptr %jv\n  %jm = icmp slt i32 %j, %nn\n  br i1 %jm, label %checkbody, label %good\ncheckbody:\n  %pc = getelementptr float, ptr %hc, i32 %j\n  %got = load float, ptr %pc\n  %fj = sitofp i32 %j to float\n  %want = fmul float %fj, 0x4008000000000000\n  %same = fcmp oeq float %got, %want\n  %j1 = add i32 %j, 1\n  store i32 %j1, ptr %jv\n  br i1 %same, label %check, label %mismatch\nmismatch:\n  %gd = fpext float %got to double\n  call i32 (ptr, ...) @printf(ptr @bad, i32 %j, double %gd)\n  ret i32 2\ngood:\n  %last = sub i32 %nn, 1\n  %pl = getelementptr float, ptr %hc, i32 %last\n  %lv = load float, ptr %pl\n  %lvd = fpext float %lv to double\n  call i32 (ptr, ...) @printf(ptr @ok, i32 %nn, double %lvd)\n  ret i32 0\n}\n',"llc/gui/demo.mid.b64":"","llc/gui/gtk3_widgets.ll":'; GTK3 視窗：標籤、輸入框、按鈕、勾選框（widget）。按鈕每按一次，標籤顯示「第 N 次，輸入框：…」。\n; 命令列第一個參數 N（測試用）：程式自己按 N 次按鈕後 200 ms 離開；沒給就一直跑到關視窗。\n; 建置：見 ../README.md（連結旗標用 pkg-config --libs gtk+-3.0）。\ntarget triple = "x86_64-pc-linux-gnu"\n\n@title = private constant [14 x i8] c"IR GTK3 demo\\00\\00"\n@hello = private constant [21 x i8] c"Press the button...\\0A\\00"\n@btn = private constant [9 x i8] c"Count++\\00\\00"\n@chk = private constant [12 x i8] c"Show text\\00\\00\\00"\n@sig_clicked = private constant [8 x i8] c"clicked\\00"\n@sig_destroy = private constant [8 x i8] c"destroy\\00"\n@fmt = private constant [28 x i8] c"Pressed %d times, entry: %s\\00"\n@fmt2 = private constant [12 x i8] c"count=%d\\0A\\00\\00\\00"\n@lbl0 = private constant [18 x i8] c"Not pressed yet.\\00\\00"\n\n@count = internal global i32 0\n@label = internal global ptr null\n@entry = internal global ptr null\n@button = internal global ptr null\n@check = internal global ptr null\n\ndeclare void @gtk_init(ptr, ptr)\ndeclare ptr @gtk_window_new(i32)\ndeclare void @gtk_window_set_title(ptr, ptr)\ndeclare void @gtk_window_set_default_size(ptr, i32, i32)\ndeclare ptr @gtk_box_new(i32, i32)\ndeclare ptr @gtk_label_new(ptr)\ndeclare void @gtk_label_set_text(ptr, ptr)\ndeclare ptr @gtk_entry_new()\ndeclare ptr @gtk_entry_get_text(ptr)\ndeclare ptr @gtk_button_new_with_label(ptr)\ndeclare ptr @gtk_check_button_new_with_label(ptr)\ndeclare i32 @gtk_toggle_button_get_active(ptr)\ndeclare void @gtk_button_clicked(ptr)\ndeclare void @gtk_container_add(ptr, ptr)\ndeclare void @gtk_container_set_border_width(ptr, i32)\ndeclare void @gtk_box_pack_start(ptr, ptr, i32, i32, i32)\ndeclare void @gtk_widget_show_all(ptr)\ndeclare void @gtk_main()\ndeclare void @gtk_main_quit()\ndeclare i32 @g_signal_connect_data(ptr, ptr, ptr, ptr, ptr, i32)   ; 回傳的 gulong 沒用到，宣告成 i32（native 與 wasm 的 host import 都適用）\ndeclare i32 @g_timeout_add(i32, ptr, ptr)\ndeclare i32 @atoi(ptr)\ndeclare i32 @snprintf(ptr, i64, ptr, ...)\ndeclare i32 @printf(ptr, ...)\n\ndefine void @on_click(ptr %w, ptr %data) {\n  %c = load i32, ptr @count\n  %c1 = add i32 %c, 1\n  store i32 %c1, ptr @count\n  %e = load ptr, ptr @entry\n  %t = call ptr @gtk_entry_get_text(ptr %e)\n  %k = load ptr, ptr @check\n  %on = call i32 @gtk_toggle_button_get_active(ptr %k)\n  %buf = alloca [160 x i8]\n  %shown = icmp ne i32 %on, 0\n  %txt = select i1 %shown, ptr %t, ptr @lbl0\n  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 160, ptr @fmt, i32 %c1, ptr %txt)\n  %l = load ptr, ptr @label\n  call void @gtk_label_set_text(ptr %l, ptr %buf)\n  ret void\n}\n\ndefine void @on_destroy(ptr %w, ptr %data) {\n  call void @gtk_main_quit()\n  ret void\n}\n\ndefine i32 @quit_cb(ptr %data) {\n  %c = load i32, ptr @count\n  call i32 (ptr, ...) @printf(ptr @fmt2, i32 %c)\n  call void @gtk_main_quit()\n  ret i32 0\n}\n\ndefine i32 @main(i32 %argc, ptr %argv) {\n  call void @gtk_init(ptr null, ptr null)\n  %win = call ptr @gtk_window_new(i32 0)\n  call void @gtk_window_set_title(ptr %win, ptr @title)\n  call void @gtk_window_set_default_size(ptr %win, i32 320, i32 160)\n  call void @gtk_container_set_border_width(ptr %win, i32 12)\n  %box = call ptr @gtk_box_new(i32 1, i32 8)\n  call void @gtk_container_add(ptr %win, ptr %box)\n  %lab = call ptr @gtk_label_new(ptr @lbl0)\n  store ptr %lab, ptr @label\n  %ent = call ptr @gtk_entry_new()\n  store ptr %ent, ptr @entry\n  %ck = call ptr @gtk_check_button_new_with_label(ptr @chk)\n  store ptr %ck, ptr @check\n  %bt = call ptr @gtk_button_new_with_label(ptr @btn)\n  store ptr %bt, ptr @button\n  call void @gtk_box_pack_start(ptr %box, ptr %lab, i32 1, i32 1, i32 0)\n  call void @gtk_box_pack_start(ptr %box, ptr %ent, i32 0, i32 0, i32 0)\n  call void @gtk_box_pack_start(ptr %box, ptr %ck, i32 0, i32 0, i32 0)\n  call void @gtk_box_pack_start(ptr %box, ptr %bt, i32 0, i32 0, i32 0)\n  call i32 @g_signal_connect_data(ptr %bt, ptr @sig_clicked, ptr @on_click, ptr null, ptr null, i32 0)\n  call i32 @g_signal_connect_data(ptr %win, ptr @sig_destroy, ptr @on_destroy, ptr null, ptr null, i32 0)\n  call void @gtk_widget_show_all(ptr %win)\n  %auto = icmp sgt i32 %argc, 1\n  br i1 %auto, label %test, label %run\ntest:\n  %ap = getelementptr ptr, ptr %argv, i32 1\n  %a1 = load ptr, ptr %ap\n  %n = call i32 @atoi(ptr %a1)\n  %iv = alloca i32\n  store i32 0, ptr %iv\n  br label %clicks\nclicks:\n  %i = load i32, ptr %iv\n  %more = icmp slt i32 %i, %n\n  br i1 %more, label %click, label %arm\nclick:\n  call void @gtk_button_clicked(ptr %bt)\n  %i1 = add i32 %i, 1\n  store i32 %i1, ptr %iv\n  br label %clicks\narm:\n  call i32 @g_timeout_add(i32 200, ptr @quit_cb, ptr null)\n  br label %run\nrun:\n  call void @gtk_main()\n  ret i32 0\n}\n',"llc/gui/midi_player.ll":'; MIDI 播放器（SDL2 音訊＋影像＋鍵盤＋檔案）：在 IR 裡解析標準 MIDI 檔（SMF 格式 0／1、變長時間、running status、tempo 表），即時合成（最多 12 聲部的正弦）\n; 經 SDL_QueueAudio 送出，視窗畫捲動的 piano roll。第一個參數＝.mid 檔（fopen 讀沙盒或 /mnt/<名稱>）；沒給就播內嵌示範曲。空白＝暫停、R＝從頭、Esc 離開；第二個參數＝跑幾幀後離開（測試用）。\n; （由 _gen/_gen_midi_player.py 產生）\ntarget triple = "x86_64-pc-linux-gnu"\n\ndeclare i32 @SDL_SetRenderDrawColor(ptr, i8, i8, i8, i8)\ndeclare i32 @SDL_RenderFillRect(ptr, ptr)\ndeclare i32 @SDL_Init(i32)\ndeclare void @SDL_Quit()\ndeclare ptr @SDL_CreateWindow(ptr, i32, i32, i32, i32, i32)\ndeclare ptr @SDL_CreateRenderer(ptr, i32, i32)\ndeclare i32 @SDL_PollEvent(ptr)\ndeclare i32 @SDL_RenderClear(ptr)\ndeclare void @SDL_RenderPresent(ptr)\ndeclare void @SDL_Delay(i32)\ndeclare void @SDL_DestroyRenderer(ptr)\ndeclare void @SDL_DestroyWindow(ptr)\ndeclare i32 @SDL_OpenAudioDevice(ptr, i32, ptr, ptr, i32)\ndeclare void @SDL_PauseAudioDevice(i32, i32)\ndeclare i32 @SDL_QueueAudio(i32, ptr, i32)\ndeclare i32 @SDL_GetQueuedAudioSize(i32)\ndeclare void @SDL_CloseAudioDevice(i32)\ndeclare ptr @fopen(ptr, ptr)\ndeclare i64 @fread(ptr, i64, i64, ptr)\ndeclare i32 @fclose(ptr)\ndeclare double @sin(double)\ndeclare double @pow(double, double)\ndeclare i32 @atoi(ptr)\ndeclare i32 @printf(ptr, ...)\n\n@.s1 = private constant [8 x i8] c"PLAYING\\00"\n@.s2 = private constant [8 x i8] c"PAUSED \\00"\n@.s3 = private constant [6 x i8] c"NOTES\\00"\n@.s4 = private constant [33 x i8] c"SPACE PAUSE\\20\\20R RESTART\\20\\20ESC QUIT\\00"\n@.s5 = private constant [13 x i8] c"SOURCE: FILE\\00"\n@.s6 = private constant [13 x i8] c"SOURCE: DEMO\\00"\n@.s7 = private constant [3 x i8] c"rb\\00"\n@.s8 = private constant [16 x i8] c"cannot open %s\\0A\\00"\n@.s9 = private constant [17 x i8] c"not a MIDI file\\0A\\00"\n@.s10 = private constant [15 x i8] c"IR MIDI player\\00"\n@.s11 = private constant [51 x i8] c"notes=%d tempos=%d div=%d seconds=%d played=%d ok\\0A\\00"\n@hud_font = private constant [1235 x i32] [i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 8, i32 8, i32 8, i32 8, i32 8, i32 8, i32 0, i32 8, i32 0, i32 0, i32 0, i32 0, i32 0, i32 20, i32 20, i32 20, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 10, i32 20, i32 63, i32 20, i32 20, i32 126, i32 40, i32 40, i32 0, i32 0, i32 0, i32 0, i32 0, i32 8, i32 28, i32 40, i32 40, i32 28, i32 10, i32 10, i32 60, i32 8, i32 8, i32 0, i32 0, i32 0, i32 48, i32 72, i32 50, i32 4, i32 24, i32 46, i32 10, i32 14, i32 0, i32 0, i32 0, i32 0, i32 0, i32 28, i32 32, i32 32, i32 48, i32 74, i32 70, i32 98, i32 62, i32 0, i32