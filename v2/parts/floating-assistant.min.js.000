+' - 3px)';b.style.flex='1 1 0'}}\nfunction menu(x,y,items){var m=$('#menu');m.textContent='';items.forEach(function(it){m.appendChild(h('div',{text:it[0],onclick:function(){m.style.display='none';it[1]()}}))});m.style.left=Math.min(x,innerWidth-150)+'px';m.style.top=Math.min(y,innerHeight-30*items.length-8)+'px';m.style.display='block'}\ndocument.addEventListener('click',function(){$('#menu').style.display='none'});\nvar dragId=null;\n// 詳情／瀏覽資料：開在「資產清單的另一側」的可關閉分頁（不佔資產清單的版面）；暫時的，不存進版面偏好\nvar DT=[],dtAct=null;\nfunction detSide(){return L.panes.left.indexOf('assets')>=0?'right':'left'}\nfunction openDetail(kind,name){var id=kind+'/'+name;if(!DT.some(function(d){return d.id===id}))DT.push({id:id,kind:kind,name:name,hist:[{t:'asset'}],i:0});dtAct=id;if(L.max&&L.max!==detSide())L=Lay.toggleMax(L,L.max);render([detSide()])}\n// 每個詳情分頁有自己的瀏覽歷史（上一頁／下一頁）：資產詳情 → 點檔案 → 檔案內容；上一頁回到詳情\n// 統一規則（使用者 2026-11-12：「左邊需要展開的，都統一開在右邊」）：會在左邊清單底下展開的內容（資料集預覽／逐筆編輯、語料塊預覽、家族題目預覽、評量結果…）一律開成右邊的可關閉分頁，\n// 跟資產詳情同一套（關閉、右鍵選單、上一頁／下一頁、不會讓左邊捲回開頭）。render(body) 負責把內容畫進分頁；同一個 id 再點一次＝切到已開的那一頁並重畫。\nfunction outPane(id,title,icon,el){var out=el||h('div');var busy=false;new MutationObserver(function(){if(busy||!out.firstChild)return;busy=true;try{openView(id,title,function(b){b.textContent='';b.appendChild(out);out.style.display=''},icon)}finally{busy=false}}).observe(out,{childList:true});return out}\nfunction openView(id,title,render,icon){var d=DT.filter(function(x){return x.id===id})[0];if(!d){d={id:id,kind:'view',name:title,icon:icon||'📄',hist:[{t:'custom',fn:render}],i:0};DT.push(d)}else{d.name=title;d.hist=d.hist.slice(0,d.i+1);d.hist[d.i]={t:'custom',fn:render}}dtAct=id;if(L.max&&L.max!==detSide())L=Lay.toggleMax(L,L.max);render([detSide()])}\nfunction pushView(d,v){d.hist=d.hist.slice(0,d.i+1);d.hist.push(v);d.i=d.hist.length-1;render([detSide()])}\nfunction navDetail(d,dir){var n=d.i+dir;if(n<0||n>=d.hist.length)return;d.i=n;render([detSide()])}\nasync function renderDetail(d,body){var v=d.hist[d.