ts:{}},"python-pip":{name:"python-pip",aliases:["pip","pip3"],summary:"Python 套件管理員",synopsis:"pip [選項] 命令",options:[{flag:"install",arg:"",desc:"安裝套件（-r requirements.txt、-e 可編輯安裝、--user、-U 升級、--no-cache-dir）"},{flag:"uninstall",arg:"",desc:"移除套件"},{flag:"list",arg:"",desc:"列出已安裝套件"},{flag:"freeze",arg:"",desc:"以 requirements 格式輸出已安裝套件"},{flag:"show",arg:"",desc:"顯示套件資訊"},{flag:"download",arg:"",desc:"只下載套件"},{flag:"-r",arg:"檔案",desc:"從 requirements 檔安裝"},{flag:"-U",arg:"",desc:"升級到最新版"},{flag:"--upgrade",arg:"",desc:"升級到最新版"},{flag:"-e",arg:"",desc:"可編輯安裝（開發模式）"},{flag:"--user",arg:"",desc:"安裝到使用者目錄"},{flag:"--no-cache-dir",arg:"",desc:"不使用快取"},{flag:"--index-url",arg:"URL",desc:"指定套件索引"},{flag:"-i",arg:"URL",desc:"指定套件索引"},{flag:"--break-system-packages",arg:"",desc:"允許修改系統管理的 Python 環境（不建議）"},{flag:"-q",arg:"",desc:"安靜"},{flag:"-v",arg:"",desc:"詳細"}],subs:{},lists:{}},npm:{name:"npm",aliases:["npx","yarn","pnpm"],summary:"Node.js 套件管理員",synopsis:"npm 命令 [引數]",options:[{flag:"install",arg:"",desc:"安裝相依套件（npm i；-D 開發相依、-g 全域、--save-exact 鎖定版本）"},{flag:"ci",arg:"",desc:"依 lock 檔乾淨安裝（CI 用）"},{flag:"run",arg:"",desc:"執行 package.json 的 scripts"},{flag:"start",arg:"",desc:"執行 start 腳本"},{flag:"test",arg:"",desc:"執行 test 腳本"},{flag:"publish",arg:"",desc:"發布套件"},{flag:"update",arg:"",desc:"更新套件"},{flag:"uninstall",arg:"",desc:"移除套件"},{flag:"init",arg:"",desc:"建立 package.json"},{flag:"audit",arg:"",desc:"檢查相依套件弱點（audit fix 修復）"},{flag:"ls",arg:"",desc:"列出已安裝套件樹"},{flag:"outdated",arg:"",desc:"列出可更新的套件"},{flag:"-g",arg:"",desc:"全域安裝"},{flag:"-D",arg:"",desc:"存成開發相依"},{flag:"--save-dev",arg:"",desc:"存成開發相依"},{flag:"--legacy-peer-deps",arg:"",desc:"忽略 peer 相依衝突"},{flag:"--force",arg:"",desc:"強制（略過部分檢查）"},{flag:"--prefix",arg:"路徑",desc:"指定專案資料夾"},{flag:"-w",arg:"工作區",desc:"指定 workspace"}],subs:{},lists:{}},nproc:{name:"nproc",aliases:[],summary:"顯示可用的處理器核心數",synopsis:"nproc [選項]",options:[{flag:"--all",arg:"",desc:"顯示所有核心（不受 cgroup 限制）"}],subs:{},lists:{}},uname:{name:"uname",