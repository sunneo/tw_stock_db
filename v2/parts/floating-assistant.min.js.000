01f) {\\0A        float r = sqrt(r2);\\0A        float w = h - r;\\0A        float rhoj = rho[j];\\0A        float pj = (rhoj - rho0) * K;\\0A        if (pj < 0.0f) { pj = 0.0f; }\\0A        float cp = ((pi + pj) / (rhoj * 2.0f)) * (w * w / r) * cs;\\0A        float cvv = (w / rhoj) * cv;\\0A        f += dx * cp + (vx[j] - vxi) * cvv;\\0A      }\\0A    }\\0A  }\\0A  ax[i] = f * (1.0f / rhoi);\\0A}\\0A\\0A__kernel void kfy(__global const float* x, __global const float* y, __global const float* z, __global const float* vx, __global const float* vy, __global const float* vz, __global const float* rho, __global float* ay, int n, float h2, float h, float K, float rho0, float cs, float cv, float g) {\\0A  int i = get_global_id(0);\\0A  float xi = x[i]; float yi = y[i]; float zi = z[i]; float vyi = vy[i];\\0A  float rhoi = rho[i];\\0A  float pi = (rhoi - rho0) * K;\\0A  if (pi < 0.0f) { pi = 0.0f; }\\0A  float f = 0.0f;\\0A  for (int j = 0; j < n; j++) {\\0A    float dx = xi - x[j]; float dy = yi - y[j]; float dz = zi - z[j];\\0A    float r2 = dx * dx + dy * dy + dz * dz;\\0A    if (r2 < h2) {\\0A      if (r2 > 0.000000000001f) {\\0A        float r = sqrt(r2);\\0A        float w = h - r;\\0A        float rhoj = rho[j];\\0A        float pj = (rhoj - rho0) * K;\\0A        if (pj < 0.0f) { pj = 0.0f; }\\0A        float cp = ((pi + pj) / (rhoj * 2.0f)) * (w * w / r) * cs;\\0A        float cvv = (w / rhoj) * cv;\\0A        f += dy * cp + (vy[j] - vyi) * cvv;\\0A      }\\0A    }\\0A  }\\0A  ay[i] = f * (1.0f / rhoi) + g;\\0A}\\0A\\0A__kernel void kfz(__global const float* x, __global const float* y, __global const float* z, __global const float* vx, __global const float* vy, __global const float* vz, __global const float* rho, __global float* az, int n, float h2, float h, float K, float rho0, float cs, float cv, float g) {\\0A  int i = get_global_id(0);\\0A  float xi = x[i]; float yi = y[i]; float zi = z[i]; float vzi = vz[i];\\0A  float rhoi = rho[i];\\0A  float pi = (rhoi - rh