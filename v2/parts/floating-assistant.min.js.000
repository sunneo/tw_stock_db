  var c = ctx, t = c.currentTime;\n      try {\n        if (fadeMs > 0) { slot.gain.gain.cancelScheduledValues(t); slot.gain.gain.setValueAtTime(slot.gain.gain.value, t); slot.gain.gain.linearRampToValueAtTime(0, t + fadeMs / 1000); slot.src.stop(t + fadeMs / 1000); }\n        else { slot.src.stop(); }\n      } catch (e) { /* 已經停了 */ }\n      return true;\n    }\n    function play(a, owner) {\n      var s = sounds[String(a.name || '')]; if (!s) { throw new Error('沒有載入這個聲音：' + a.name); }\n      var susp = resume(), c = ctx; ensureChannels();\n      var isMusic = !!a.music, idx = -1;\n      if (!isMusic) {\n        if (a.ch !== undefined && a.ch !== null && Number(a.ch) >= 0) { idx = Math.min(nch - 1, Number(a.ch) | 0); stopSlot(channels[idx], 0); }\n        else { for (var i = 0; i < nch; i++) { if (!channels[i]) { idx = i; break; } } }\n        if (idx < 0) { return { ch: -1 }; }\n      } else { stopSlot(music, 0); }\n      var src = c.createBufferSource(), gain = c.createGain(), vol = a.volume === undefined ? 1 : Math.max(0, Math.min(1, Number(a.volume)));\n      src.buffer = s.buffer; var loops = a.loops === undefined ? 0 : Number(a.loops);\n      if (loops !== 0) { src.loop = true; }\n      var fade = Number(a.fade_ms) || 0, t = c.currentTime;\n      if (fade > 0) { gain.gain.setValueAtTime(0, t); gain.gain.linearRampToValueAtTime(vol, t + fade / 1000); } else { gain.gain.value = vol; }\n      src.connect(gain); gain.connect(master);\n      var slot = { src: src, gain: gain, name: a.name, owner: owner || '', ends: loops === -1 ? Infinity : t + s.buffer.duration * (loops + 1) };\n      if (isMusic) { music = slot; } else { channels[idx] = slot; }\n      src.onended = function () { if (isMusic) { if (music === slot) { music = null; } } else if (channels[idx] === slot) { channels[idx] = null; } };\n      if (loops > 0) { try { src.loopEnd = s.buffer.duration; } catch (e) { /* 預設就是整段 */ } }\n      src.start(t);\n      var stopAfter = Number(a.maxtime_ms) > 0 ? Number(a.maxtime_ms) / 1000 : (loops > 0 ? s.buffer.duration * (loops + 1) : 0);\n      if (stopAfter > 0) { try { src.stop(t + stopAfter); } catch (e) { /* */ } }\n      return { ch: isMusic ? -2 : idx, suspended: susp };\n    }\n    function stop(a, owner) {\n      if (!ctx) { return { stopped: 0 }; }\n      var n = 0, fade = Number(a.fade_ms) || 0;\n      // 不淡出的停止：聲道立刻釋放（onended 是瀏覽器非同步送來的，不能等它）\n      function kill(i, isMusic) { var slot = isMusic ? music : channels[i]; if (!stopSlot(slot, fade)) { return 0; } if (fade <= 0) { if (isMusic) { music = null; } else { channels[i] = null; } } return 1; }\n      if (a.all) { for (var i = 0; i < channels.length; i++) { if (channels[i] && (!owner || channels[i].owner === owner)) { n += kill(i, false); } } if (music && (!owner || music.owner === owner)) { n += kill(0, true); } }\n      else if (a.music) { n += kill(0, true); }\n      else if (a.ch !== undefined && a.ch !== null) { n += kill(Number(a.ch) | 0, false); }\n      else if (a.name) { for (var j = 0; j < channels.length; j++) { if (channels[j] && channels[j].name === a.name) { n += kill(j, false); } } }\n      return { stopped: n };\n    }\n    function busy(a) {\n      if (!ctx) { return { busy: false, count: 0 }; }\n      if (a.music) { return { busy: !!music, count: music ? 1 : 0 }; }\n      if (a.ch !== undefined && a.ch !== null) { var s = channels[Number(a.ch) | 0]; return { busy: !!s, count: s ? 1 : 0 }; }\n      var n = 0; for (var i = 0; i < channels.length; i++) { if (channels[i]) { n++; } }\n      return { busy: n > 0, count: n };\n    }\n    function volume(a) {\n      ensure();\n      var v = Math.max(0, Math.min(1, Number(a.volume === undefined ? a.master : a.volume)));\n      if (a.master !== undefined && a.ch === undefined && !a.music) { masterVol = v; master.gain.value = v; return { ok: true }; }\n      var slot = a.music ? music : channels[Number(a.ch) | 0]; if (slot) { slot.gain.gain.value = v; }\n      return { ok: !!slot };\n    }\n\n    // 回傳 Promise（或同步值）：呼叫端一律 await\n    function handle(a, owner) {\n      a = a || {};\n      switch (String(a.cmd || '')) {\n        case 'load': return load(a);\n        case 'unload': drop(String(a.name || '')); return { ok: true };\n        case 'play': return play(a, owner);\n        case 'stop': return stop(a, owner);\n        case 'volume': return volume(a);\n        case 'busy': return busy(a);\n        case 'pause': if (ctx && ctx.suspend) { ctx.suspend(); } return { ok: true };\n        case 'resume': if (ctx && ctx.resume) { ctx.resume(); } return { ok: true };\n        case 'channels': nch = Math.max(1, Math.min(MAX_CH, Number(a.n) | 0 || 8)); ensureChannels(); return { n: nch };\n        case 'stream_open': return streamOpen(a, owner);\n        case 'stream_queue': return streamQueue(a);\n        case 'stream_pause': return streamPause(a);\n        case 'stream_queued': return streamQueued(a);\n        case 'stream_clear': return streamClear(a);\n        case 'stream_close': return streamClose(a);\n        case 'info': return sounds[String(a.name || '')] ? { duration: sounds[String(a.name)].buffer.duration } : null;\n        default: throw new Error('不認得的 audio 指令：' + a.cmd);\n      }\n    }\n    // 程式結束：收掉這個 owner 的聲音（沒有 owner 就全部）\n    function stopOwner(owner) { stop({ all: true }, owner); Object.keys(streams).forEach(function (id) { if (!owner || streams[id].owner === owner) { streamClose({ id: id }); } }); }\n    return { handle: handle, stopOwner: stopOwner, stats: function () { return { sounds: Object.keys(sounds).length, bytes: total, channels: nch, streams: Object.keys(streams).length, state: ctx ? ctx.state : 'none' }; }, close: function () { stop({ all: true }); Object.keys(streams).forEach(function (id) { streamClose({ id: id }); }); sounds = {}; total = 0; if (ctx && ctx.close) { try { ctx.close(); } catch (e) { /* */ } } ctx = null; } };\n  }\n  return { create: create, LIMITS: { MAX_PCM: MAX_PCM, MAX_ENC: MAX_ENC, MAX_SOUNDS: MAX_SOUNDS, MAX_TOTAL: MAX_TOTAL, MAX_CH: MAX_CH } };\n}));\n",FA_GUI_PYWORKER_SRC="// 會開視窗的 Python 程式（py_async.js 判斷為 true 的）在 module Worker 裡跑：這裡只放純函式與要送進 Worker 的程式。\n// 為什麼要 Worker：同步的 runPython 內不能等 JS 的 Promise；Worker 裡用 JSPI（pyodide.ffi.run_sync）可以在 Python 呼叫處等頁面回覆。\n// 為什麼 Worker 是 module：classic Worker 裡 Pyodide 會報「Classic web workers are not supported」（2026-11-03 實測）。\n// 為什麼頁面不用 SharedArrayBuffer：頁面 crossOriginIsolated 是 false，所以只能用 Promise 與 postMessage。\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatPyWorker = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n\n  // 送進 Worker 的主程式。用 Function.prototype.toString 取出原始碼，所以函式內不能用外部變數，只能用參數 base（Pyodide 的網址）。\n  // 訊息：主執行緒 → Worker：init（檔案、程式、Python 前置程式）、reply（對 call 的回覆）；Worker → 主執行緒：out／err（輸出）、call（橋接請求）、done（結束碼）。\n  function workerMain(base) {\n    var pending = {}, nextId = 1, inflight = 0, acked = 0;   // inflight：已送出、頁面還沒確認畫完的點陣圖張數\n    function request(op, args) {\n      return new Promise(function (resolve) {\n        var id = nextId++;\n        pending[id] = resolve;\n        self.postMessage({ type: 'call', id: id, op: op, args: args });\n      });\n    }\n    async function run(m) {\n      try {\n        var mod = await import(base + 'pyodide.mjs');\n        var py = await mod.loadPyodide({ indexURL: base });\n        py.setStdout({ batched: function (s) { self.postMessage({ type: 'out', text: s + '\\n' }); } });\n        py.setStderr({ batched: function (s) { self.postMessage({ type: 'err', text: s + '\\n' }); } });\n        py.setStdin({ stdin: function () { return null; } });\n        // _fa_pybridge：fa_bridge.call 在網頁版直接呼叫它（同步的 run_sync 會等這裡的 Promise）\n        py.registerJsModule('_fa_pybridge', {\n          call: function (op, argsJson) { return request(String(op), JSON.parse(String(argsJson || '{}'))); },\n          // present(win, node, bitmap)：零拷貝送一張畫面（OffscreenCanvas 的 ImageBitmap，轉移所有權）。不等頁面回覆：在途的張數有上限（頁面畫完會回 present_ack），\n          // 超過就把這張丟掉（回 0，程式照常往下跑、下一幀再送）。回 1＝已送出。頁面端不認得這個訊息的舊版本不會有這個函式（Python 用 hasattr 判斷後退回 PNG）。\n          ready: function () { return inflight < 2 ? 1 : 0; },\n          acked: function () { return acked; },   // 頁面確認畫完的張數（Python 用它量頁面實際畫出的幀率）\n          // tick()：讓出一下事件迴圈（Promise，用 MessageChannel，不受計時器 4 ms 下限限制），Worker 才收得到頁面的 present_ack。Python 迴圈是同步的（Clock.tick 這類阻塞呼叫不會讓出），所以要主動讓。\n          tick: function () { return new Promise(function (r) { var c = new MessageChannel(); c.port1.onmessage = function () { c.port1.close(); r(); }; c.port2.postMessage(0); }); },   // 在途張數還沒滿（滿了就不必白做一次擷取）\n          present: function (win, node, bmp) {\n            if (inflight >= 2) { try { bmp.close(); } catch (e) { /* */ } return 0; }\n            inflight++;\n            self.postMessage({ type: 'present', win: String(win), node: String(node), bitmap: bmp }, [bmp]);\n            return 1;\n          },\n          sleep: function (ms) { return new Promise(function (r) { setTimeout(r, Number(ms) || 0); }); }\n        });\n        Object.keys(m.files).forEach(function (k) {\n          var full = '/fa_pybridge/' + k, dir = full.slice(0, full.lastIndexOf('/'));\n          py.FS.mkdirTree(dir);\n          py.FS.writeFile(full, m.files[k]);\n        });\n        // 標準 pyopencl：程式 import pyopencl 時，在 Worker 裡建立 OpenCL 載入器（GPU 用 Worker 自己的 navigator.gpu／OffscreenCanvas，資料不跨執行緒）並取得真的 pyopencl\n        // （m.clSrc＝頁面嵌入的 OpenCL 模組原始碼，頁面只在程式用到 pyopencl 時才送）。失敗不擋：程式自己 import 時會得到原本的錯誤。\n        if (m.clSrc) {\n          try {\n            var clh = {}; new Function('module', 'require', 'self', m.clSrc)(undefined, undefined, clh);\n            await clh.FaClHostPage.prepare(py, { mods: clh, nav: self.navigator, makeCanvas: function () { return new OffscreenCanvas(4, 4); }, jspi: typeof WebAssembly !== 'undefined' && typeof WebAssembly.Suspending === 'function' && typeof WebAssembly.promising === 'function', files: m.files, onProgress: function (t) { self.postMessage({ type: 'err', text: '[pyopencl] ' + t + '\\n' }); } });\n          } catch (e) { self.postMessage({ type: 'err', text: '[提示] pyopencl 準備失敗：' + String((e && e.message) || e).slice(0, 300) + '\\n' }); }\n        }\n        py.FS.mkdirTree('/work');\n        m.inputs.forEach(function (f) {\n          var full = '/work/' + f.rel, dir = full.slice(0, full.lastIndexOf('/'));\n          if (dir !== '/work') py.FS.mkdirTree(dir);\n          py.FS.writeFile(full, f.bytes);\n        });\n        py.FS.chdir('/work');\n        // 程式 import 了 numpy 等 Pyodide 內建套件就先載入（失敗不擋：程式自己 import 時會得到原本的錯誤訊息）\n        try { await py.loadPackagesFromImports(m.src); } catch (e) { self.postMessage({ type: 'err', text: '[提示] 載入內建套件失敗：' + String((e && e.message) || e).slice(0, 200) + '\\n' }); }\n        // PyOpenGL 不是 Pyodide 內建的套件（純 Python）：程式 import OpenGL 或 gl3d（建在 PyOpenGL 上）時用 micropip 從 PyPI 裝（要有網路）；平台後端（fa_opengl_platform）接 WebGL2\n        if (/^[ \\t]*(?:import[ \\t]+(?:[\\w.]+(?:[ \\t]+as[ \\t]+\\w+)?[ \\t]*,[ \\t]*)*(?:OpenGL|gl3d)|from[ \\t]+(?:OpenGL|gl3d))(?![\\w])/m.test(m.src)) {\n          try { await py.loadPackage('micropip'); await py.pyimport('micropip').install('PyOpenGL'); }\n          catch (e) { self.postMessage({ type: 'err', text: '[提示] 安裝 PyOpenGL 失敗（需要網路連到 PyPI）：' + String((e && e.message) || e).slice(0, 200) + '\\n' }); }\n        }\n        py.runPython(m.prelude);\n        py.globals.set('__fa_src__', m.src);\n        py.globals.set('__fa_path__', '/work/' + m.scriptName);\n        py.runPython(m.runner);\n        // 程式寫在目前目錄（/work）的檔案送回頁面，讓終端機的 ls 看得到（例如 missile 範例寫出的貼圖）\n        function syncBack() {\n          var files = [];\n          py.FS.readdir('/work').forEach(function (n) {\n            var p = '/work/' + n;\n            if (n === '.' || n === '..' || !py.FS.isFile(py.FS.stat(p).mode)) { return; }\n            files.push({ rel: n, bytes: py.FS.readFile(p) });\n          });\n          self.postMessage({ type: 'files', files: files });\n        }\n        var go = py.globals.get('go');\n        try {\n          var rc = await go.callPromising();   // go() 回傳程式的結束碼（SystemExit 的值，或正常結束的 0）\n          syncBack();\n          self.postMessage({ type: 'done', code: typeof rc === 'number' ? rc : 0 });\n        } catch (e) {\n          self.postMessage({ type: 'err', text: String((e && e.message) || e) + '\\n' });\n          syncBack();\n          self.postMessage({ type: 'done', code: 1 });\n        } finally {\n          go.destroy();\n        }\n      } catch (e) {\n        self.postMessage({ type: 'err', text: '無法啟動 Python（' + String((e && e.message) || e) + '）\\n' });\n        self.postMessage({ type: 'done', code: 1 });\n      }\n    }\n    self.onmessage = function (ev) {\n      var m = ev.data || {};\n      if (m.type === 'reply') { var p = pending[m.id]; delete pending[m.id]; if (p) p(m.raw); return; }\n      if (m.type === 'present_ack') { inflight = Math.max(0, inflight - 1); acked++; return; }\n      if (m.type === 'init') run(m);\n    };\n  }\n\n  // 要放進 Worker 執行的原始碼（module）。base 是 Pyodide 的網址，要與頁面用的相同（FA_ASSET_URLS.pyodideJsBase）。\n  function workerSource(base) {\n    return '(' + workerMain.toString() + ')(' + JSON.stringify(String(base)) + ');';\n  }\n\n  // Worker 內先執行：轉接層的路徑、橋接版 fa_bridge（網頁版：IN_BROWSER 時 call 用 run_sync）。sys.path 把 /work 放最前面，跟桌面版的 python 一樣。\n  // install_hooks 不放這裡：它會呼叫 run_sync，頂層不在 callPromising 裡會報「Cannot stack switch」，所以放進 RUNNER_PY 的 go() 裡。\n  var PRELUDE_PY = [\n    'import sys',\n    \"if '/fa_pybridge' not in sys.path:\",\n    \"    sys.path.insert(0, '/fa_pybridge')\",\n    \"sys.path.insert(0, '/work')\",\n    'import fa_bridge',\n    'fa_bridge.ACTIVE = True',\n  ].join('\\n');\n\n  // 把程式包在 go() 裡執行：整支程式在 callPromising 裡，頂層的 gui 呼叫才能同步等待。__name__ 設成 __main__，__file__ 指向 /work 內的路徑。\n  var RUNNER_PY = [\n    'def go():',\n    '    fa_bridge.install_hooks()',\n    '    import builtins, io',\n    '    def _readline(prompt=\"\"):',\n    '        return fa_bridge.call(\"stdin.readline\", {\"prompt\": str(prompt)})',\n    '    def _input(prompt=\"\"):',\n    '        r = _readline(prompt)',\n    '        if r is None:',\n    '            raise EOFError(\"EOF when reading a line\")',\n    '        return r[:-1] if r.endswith(\"\\\\n\") else r',\n    '    class _Stdin(io.TextIOBase):',\n    '        def readable(self): return True',\n    '        def isatty(self): return False',\n    '        def readline(self, size=-1):',\n    '            r = _readline(\"\")',\n    '            return \"\" if r is None else r',\n    '        def read(self, size=-1):',\n    '            parts = []',\n    '            while True:',\n    '                r = _readline(\"\")',\n    '                if r is None: break',\n    '                parts.append(r)',\n    '            return \"\".join(parts)',\n    '    builtins.input = _input',\n    '    sys.stdin = _Stdin()',\n    \"    g = {'__name__': '__main__', '__file__': __fa_path__}\",\n    // SystemExit 與 Python 的 sys.exit 一樣：整數是結束碼，None 是 0，其他值印到 stderr 後結束碼 1；未捕捉的例外仍是 1（由 JS 端的 catch 處理）\n    '    try:',\n    '        exec(compile(__fa_src__, __fa_path__, \"exec\"), g)',\n    '    except SystemExit as e:',\n    '        c = e.code',\n    '        if c is None: return 0',\n    '        if isinstance(c, int): return c',\n    '        sys.stderr.write(str(c) + \"\\\\n\")',\n    '        return 1',\n    '    return 0',\n  ].join('\\n');\n\n  // gui.* 橋接操作（gui.py 呼叫的名字，去掉 gui. 前綴）。與 gui_bridge.js 的 OPS 對應，另外 poll／wait／image 由頁面處理。\n  var GUI_OPS = ['open', 'add', 'set', 'remove', 'close', 'draw', 'image', 'theme', 'shortcut', 'tone', 'usertpl', 'pickfile', 'pickmany', 'poll', 'wait', 'glbuf', 'glprog', 'glframe'];\n\n  // 把 gui.py 送來的參數轉成 \"@gui\" 協定訊息（v:1 + op + 其餘欄位，欄位名與 gui.py 一致）\n  function guiMessage(op, args) {\n    var m = { v: 1, op: String(op) };\n    Object.keys(args || {}).forEach(function (k) { m[k] = args[k]; });\n    return m;\n  }\n\n  // 等待視窗的下一個事件（gui.wait）。host.wait 的 resolver 不能取消，超時後下一個事件會被丟掉，所以改成輪詢佇列（host.poll）。\n  // 視窗已關閉且佇列空的，回傳 close 事件；超時回傳 null（視窗保持開著，程式可以再等）。\n  async function waitEvent(host, winId, timeoutSec, o) {\n    var stepMs = (o && o.stepMs) || 15;\n    var deadline = o.now() + Math.max(0, Number(timeoutSec) || 0) * 1000;\n    for (;;) {\n      var line = host.poll(winId);\n      if (line !== null && line !== undefined) return JSON.parse(line);\n      if (!host.isOpen(winId)) return { event: 'close', id: winId };\n      if (o.now() >= deadline) return null;\n      await o.sleep(stepMs);\n    }\n  }\n\n  return {\n    workerSource: workerSource,\n    workerMain: workerMain,\n    PRELUDE_PY: PRELUDE_PY,\n    RUNNER_PY: RUNNER_PY,\n    GUI_OPS: GUI_OPS,\n    guiMessage: guiMessage,\n    waitEvent: waitEvent,\n  };\n}));\n",FA_READ_LEDGER_SRC="// Read ledger (pure, no DOM, no I/O): remembers paged reads that the model has not finished.\n// A tool result that says there is more (has_more:true, or chunk.hasMore:true, or truncated:true with a continuation offset)\n// is recorded under its source. The same source returning a result without has_more (its last page) clears the entry.\n// The tool loop asks pending(ledger) before accepting a final answer and uses reminderText(pending) to tell the model what is still unread.\n// Every function returns new values; the ledger is plain JSON-serializable data: { entries: { [key]: entry } }.\n//\n// entry: { key, toolName, label, nextOffset, nextStartLine, total, blocking }\n//   blocking:true  -> has_more, or truncated with a continuation offset (the loop may refuse a final answer)\n//   blocking:false -> truncated with no continuation offset (only a reminder; never refuses an answer)\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatReadLedger = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n  var SOURCE_FIELDS = ['ref', 'path', 'url', 'file_id', 'fileId', 'attachment_id', 'attachmentId', 'id'];\n  var PAGING_ARGS = ['offset', 'start', 'start_line', 'startLine', 'page', 'cursor', 'limit', 'max_chars', 'max_lines', 'chunk', 'from', 'to', 'next_offset', 'nextOffset'];\n\n  function isObj(x) { return x !== null && typeof x === 'object' && !Array.isArray(x); }\n  function pick() { for (var i = 0; i < arguments.length; i++) if (arguments[i] != null && arguments[i] !== '') return arguments[i]; return null; }\n\n  function stableStr(x) {\n    if (x === null || typeof x !== 'object') return JSON.stringify(x === undefined ? null : x);\n    if (Array.isArray(x)) return '[' + x.map(stableStr).join(',') + ']';\n    return '{' + Object.keys(x).sort().map(function (k) { return JSON.stringify(k) + ':' + stableStr(x[k]); }).join(',') + '}';\n  }\n\n  // Source identity: the first known id field (ref, path, url, file_id, attachment id ...). A path is qualified by cwd_abs when given.\n  function sourceOf(args) {\n    var a = isObj(args) ? args : {};\n    var cwd = typeof a.cwd_abs === 'string' ? a.cwd_abs : '';\n    for (var i = 0; i < SOURCE_FIELDS.length; i++) {\n      var f = SOURCE_FIELDS[i], v = a[f];\n      if (v != null && v !== '') return (cwd && f === 'path' ? cwd + '|' : '') + f + '=' + String(v);\n    }\n    // 沒有來源欄位時，用其餘參數當身分；續讀參數（offset、page、cursor ……）每頁都會變，不能算進身分，否則同一來源永遠清不掉\n    var rest = {};\n    Object.keys(a).forEach(function (k) { if (PAGING_ARGS.indexOf(k) < 0) rest[k] = a[k]; });\n    return 'args=' + stableStr(rest);\n  }\n\n  function sourceKey(toolName, args) { return String(toolName || '') + '\\u0001' + sourceOf(args); }\n\n  function createLedger() { return { entries: {} }; }\n\n  // Reads the paging fields in both snake_case and camelCase forms (the skill reference reader uses chunk.hasMore / chunk.nextOffset).\n  function paging(res) {\n    var ch = isObj(res.chunk) ? res.chunk : null;\n    return {\n      more: res.has_more === true || !!(ch && ch.hasMore === true),\n      truncated: res.truncated === true || !!(ch && ch.truncated === true),\n      nextOffset: pick(res.next_offset, ch && ch.nextOffset),\n      nextStartLine: pick(res.next_start_line, ch && ch.nextStartLine),\n      total: pick(res.total, ch && ch.total)\n    };\n  }\n\n  // ===== 覆蓋範圍（JSONL 分頁，見 jsonl_pager.js 與 DESIGN.jsonl-paging.md）=====\n  // 一頁的 meta（_page）帶 source、from、to（半開區間，單位＝第幾筆）、total、has_more、done。\n  // 帳本記「已讀過哪些區間」，而不只是「下一個位置」：跳到最後一頁不會把中間沒讀的部分清掉，要整份從 0 連續覆蓋到 total，而且收到最後一頁，才算讀完。\n  // 以 meta.source 當身分（不分哪個工具回的第一頁），所以 interpret_image 回的第 1 頁與 big_content 讀的第 2 頁會算同一份。\n  function mergeRange(list, a, b) {\n    if (!(b > a)) return list.slice();\n    var out = [];\n    list.concat([[a, b]]).sort(function (x, y) { return x[0] - y[0] || x[1] - y[1]; }).forEach(function (r) {\n      var last = out[out.length - 1];\n      if (last && r[0] <= last[1]) last[1] = Math.max(last[1], r[1]); else out.push([r[0], r[1]]);\n    });\n    return out;\n  }\n  function gapsOf(covered, total) {\n    var gaps = [], pos = 0;\n    covered.forEach(function (r) { if (r[0] > pos) gaps.push([pos, Math.min(r[0], total)]); pos = Math.max(pos, r[1]); });\n    if (pos < total) gaps.push([pos, total]);\n    return gaps.filter(function (g) { return g[1] > g[0]; });\n  }\n  function recordPage(base, m) {\n    var entries = Object.assign({}, base.entries), key = 'page\\u0001' + String(m.source || '');\n    if (base.completed && base.completed[key]) return { entries: entries, completed: base.completed };\n    var prev = entries[key];\n    var total = Number(m.total); if (!isFinite(total) || total < 0) total = 0;\n    var from = Number(m.from) || 0, to = Number(m.to) || 0;\n    var covered = mergeRange(prev && Array.isArray(prev.covered) ? prev.covered : [], from, to);\n    var done = !!(prev && prev.done) || m.done === true;\n    var part = m.record_part && m.record_part.part + 1 < m.record_part.of ? { record: m.record_part.record, next: m.record_part.part + 1, of: m.record_part.of } : null; // 單筆太大分段：沒讀到最後一段不算讀過\n    var exact = m.total_exact !== false;\n    var gaps = gapsOf(covered, total);\n    var complete = done && gaps.length === 0 && !part;\n    if (complete) { delete entries[key]; var done2 = Object.assign({}, base.completed); done2[key] = true; return { entries: entries, completed: done2 }; } // 讀完的來源記下來：之後再重讀其中一頁，不能又把它變成「沒讀完」\n    entries[key] = {\n      key: key, toolName: 'jsonl', label: String(m.source || ''), source: String(m.source || ''), unit: 'record',\n      covered: covered, total: total, totalExact: exact, gaps: gaps, done: done, pendingPart: part, pages: ((prev && prev.pages) || 0) + 1,\n      nextCursor: m.next_cursor || (prev && prev.nextCursor) || null, viaOffset: m.next_cursor == null && m.next_offset != null || !!(prev && prev.viaOffset && m.next_cursor == null), nextOffset: null, nextStartLine: null, blocking: true\n    };\n    return { entries: entries, completed: base.completed };\n  }\n\n  // Returns a new ledger after one tool result. Failed results (ok:false) change nothing.\n  function record(ledger, toolName, args, resultObj) {\n    var base = isObj(ledger) && isObj(ledger.entries) ? ledger : createLedger();\n    if (!isObj(resultObj) || resultObj.ok === false) return { entries: Object.assign({}, base.entries), completed: base.completed };\n    if (isObj(resultObj._page) && resultObj._page.source != null) { if (resultObj._page.blocking === false) return { entries: Object.assign({}, base.entries), completed: base.completed }; return recordPage(base, resultObj._page); } // blocking:false＝選擇性翻頁（排名搜尋），不逼模型讀完\n    var entries = Object.assign({}, base.entries);\n    var key = sourceKey(toolName, args), p = paging(resultObj);\n    var hasNext = p.nextOffset != null || p.nextStartLine != null;\n    if (p.more || (p.truncated)) {\n      entries[key] = {\n        key: key,\n        toolName: String(toolName || ''),\n        label: sourceOf(args),\n        nextOffset: p.nextOffset,\n        nextStartLine: p.nextStartLine,\n        total: p.total,\n        blocking: p.more || hasNext\n      };\n    } else {\n      delete entries[key]; // last page of this source: nothing left to read\n    }\n    return { entries: entries, completed: base.completed };\n  }\n\n  // Unfinished reads, oldest first (insertion order).\n  function pending(ledger) {\n    var entries = isObj(ledger) && isObj(ledger.entries) ? ledger.entries : {};\n    return Object.keys(entries).map(function (k) { return entries[k]; });\n  }\n\n  // Chinese reminder that lists each unfinished source and where to continue. Empty list gives an empty string.\n  // 覆蓋範圍型來源（單位＝第幾筆）的缺口描述：「第 a～b 筆」（人看的是 1 起算，區間是 0 起算半開）\n  function gapText(e, cursorFor) {\n    var gs = (e.gaps || []).slice(0, 6).map(function (g) { return '第 ' + (g[0] + 1) + '～' + g[1] + ' 筆' + (e.viaOffset ? '（offset：' + g[0] + '）' : typeof cursorFor === 'function' ? '（cursor：' + cursorFor(e.source, g[0]) + '）' : ''); });\n    if ((e.gaps || []).length > 6) gs.push('…還有 ' + (e.gaps.length - 6) + ' 段');\n    return gs.join('、');\n  }\n  // 頁數預估：記錄清單還要幾頁（沒讀的筆數 ÷ 平均每頁讀到幾筆）；opts.room（上下文還剩幾 token）與 opts.pageTokens（一頁約幾 token）\n  // 給了就一併算「放得下幾頁」。放不下就別無止盡續讀：先用 grep／json 只取需要的，或把已讀的重點寫成摘要（舊頁會被換成 placeholder）。\n  function estimate(e, opts) {\n    if (!e || e.unit !== 'record' || !(e.total > 0)) return null;\n    var got = (e.covered || []).reduce(function (s, r) { return s + (r[1] - r[0]); }, 0), pages = e.pages || 0;\n    var left = Math.max(0, e.total - got); if (!left) return { pagesLeft: 0, fits: null, enough: true };\n    var per = pages > 0 && got > 0 ? got / pages : 0; var pagesLeft = per > 0 ? Math.ceil(left / per) : null;\n    var fits = opts && opts.room > 0 && opts.pageTokens > 0 ? Math.max(0, Math.floor(opts.room / opts.pageTokens)) : null;\n    return { pagesLeft: pagesLeft, fits: fits, enough: pagesLeft == null || fits == null ? null : fits >= pagesLeft };\n  }\n  function reminderText(list, opts) {\n    var items = Array.isArray(list) ? list : [];\n    if (!items.length) return '';\n    var cursorFor = opts && opts.cursorFor;\n    var lines = items.map(function (e) {\n      if (e.unit === 'record') {\n        var got = (e.covered || []).reduce(function (s, r) { return s + (r[1] - r[0]); }, 0);\n        var miss = (e.gaps || []).length ? '還沒讀：' + gapText(e, cursorFor) : (e.pendingPart ? '第 ' + (e.pendingPart.record + 1) + ' 筆太大分成 ' + e.pendingPart.of + ' 段，還有第 ' + (e.pendingPart.next + 1) + ' 段以後沒讀' : '還沒收到最後一頁');\n        var est = estimate(e, opts), estText = '';\n        if (est && est.pagesLeft != null) estText = '；約還要 ' + est.pagesLeft + ' 頁' + (est.fits != null ? '，現在的上下文只放得下約 ' + est.fits + ' 頁' + (est.enough ? '' : '：放不下，別一頁頁全讀——先用 big_content 的 grep／json 只取需要的，或先把已讀的重點寫成一小段摘要再繼續（舊的頁會被省略）') : '');\n        return '・來源 ' + e.label + '（記錄清單，已讀 ' + got + '／' + e.total + ' 筆）：' + miss + estText + (e.nextCursor && !(e.gaps || []).length ? '；下一頁 cursor：' + e.nextCursor : '');\n      }\n      var where = e.nextOffset != null ? '下一個 offset：' + e.nextOffset\n        : e.nextStartLine != null ? '下一個起始行：' + e.nextStartLine\n        : '沒有提供續讀位置，可能只讀了一部分';\n      var total = e.total != null ? '（總量 ' + e.total + '）' : '';\n      return '・來源 ' + e.label + '（工具 ' + e.toolName + '）：' + where + total;\n    });\n    return '【讀取尚未完成】以下來源還沒有讀到最後一頁：\\n' + lines.join('\\n') +\n      '\\n請用上面的續讀位置繼續呼叫工具讀完。讀完之前不可下結論，不要說「報告都正確」之類的話。';\n  }\n\n  // 給最終回答前面由程式附加的警語用：一個沒讀完的來源讀到哪、缺什麼（不靠模型自己說）\n  function describe(e) {\n    if (e.unit === 'record') {\n      var got = (e.covered || []).reduce(function (s, r) { return s + (r[1] - r[0]); }, 0);\n      return e.label + '（只讀了 ' + got + '／' + e.total + ' 筆' + ((e.gaps || []).length ? '，沒讀到：' + gapText(e) : '') + '）';\n    }\n    return e.label + '（已讀到 ' + (e.nextOffset != null ? 'offset ' + e.nextOffset : '第 ' + e.nextStartLine + ' 行') + '）';\n  }\n\n  return {\n    createLedger: createLedger,\n    record: record,\n    pending: pending,\n    reminderText: reminderText,\n    estimate: estimate,\n    describe: describe,\n    sourceKey: sourceKey\n  };\n}));\n",FA_JSONL_PAGER_SRC="// JSONL 分頁器（純函式，無 DOM、無 I/O、UMD；嵌入 floating-assistant 後用 new Function 載入）。\n// 用途：很大的 JSON 回應（記錄清單）不再「只放開頭就截斷」，而是一頁一頁、每行一筆記錄地給模型，模型可以用 cursor 一直讀到完。\n// 設計與實證見 DESIGN.jsonl-paging.md。\n//\n// 一頁的文字格式：第一行是 meta：{\"_page\":{...}}，其後每行一筆記錄（單行 JSON，內容裡的換行都已跳脫）。\n//   單筆比一頁還大：不丟、不截斷，拆成多頁，每段一行 {\"_part\":{\"record\":i,\"part\":k,\"of\":n,\"text\":\"…\"}}，把 text 依序接起來就是那一筆的原文。\n// 大小跟內容窗口按比例（budgetChars），沒有字元下限；一頁至少 1 筆（或 1 段）。\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatJsonlPager = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n  var VERSION = 'c1';\n  var META_TOKENS = 130; // 同上，以 token 計（JSON 標點與中文提示分詞很碎）\n  var META_OVERHEAD = 320; // meta 那一行大約佔多少字元（含 hint），從預算裡先扣掉\n\n  function isObj(x) { return x !== null && typeof x === 'object' && !Array.isArray(x); }\n  function safeStringify(v) { try { var s = JSON.stringify(v); return s === undefined ? 'null' : s; } catch (e) { return null; } }\n\n  // 一頁可以放多少字元：內容窗口 token × 比例 × 每 token 約幾個字元。沒有下限常數。\n  function budgetChars(o) {\n    o = o || {};\n    if (Number(o.chars) > 0) return Math.floor(Number(o.chars));\n    var ctx = Number(o.ctxTokens) || 0, fr = Number(o.fraction) || 0.15, cpt = Number(o.charsPerToken) || 3;\n    return Math.max(1, Math.floor(ctx * fr * cpt));\n  }\n\n  // 短雜湊（FNV-1a 32 位元），讓帳本核對「這一頁真的拿到過」\n  function digest(text) {\n    var h = 0x811c9dc5; text = String(text);\n    for (var i = 0; i < text.length; i++) { h ^= text.charCodeAt(i); h = (h + ((h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24))) >>> 0; }\n    return ('00000000' + h.toString(16)).slice(-8);\n  }\n\n  // 逐行解析 JSONL 文字：回傳 { values:[{line, value}], bad:[{line, raw, error}], lines } ；空行略過但行號照算，壞行保留不丟\n  function parseLines(text) {\n    var out = { values: [], bad: [], lines: 0 };\n    var rows = String(text == null ? '' : text).replace(/^\ufeff/, '').split(/\\r?\\n/);\n    for (var i = 0; i < rows.length; i++) {\n      var s = rows[i]; if (!s.trim()) continue;\n      out.lines++;\n      try { out.values.push({ line: i + 1, value: JSON.parse(s) }); }\n      catch (e) { out.bad.push({ line: i + 1, raw: s.length > 200 ? s.slice(0, 200) + '…' : s, error: String(e && e.message || e).split('\\n')[0] }); }\n    }\n    return out;\n  }\n\n  // 找頂層物件裡「占大宗」的陣列欄位（最多往下兩層）：回傳 { path:[...], arr }；沒有回 null\n  function dominantArray(obj, totalLen) {\n    var best = null;\n    function visit(o, path, depth) {\n      Object.keys(o).forEach(function (k) {\n        var v = o[k];\n        if (Array.isArray(v) && v.length >= 2) {\n          var s = safeStringify(v); var len = s ? s.length : 0;\n          if (!best || len > best.len) best = { path: path.concat(k), arr: v, len: len };\n        } else if (isObj(v) && depth < 1) visit(v, path.concat(k), depth + 1);\n      });\n    }\n    visit(obj, [], 0);\n    if (!best || best.len < totalLen * 0.5) return null;\n    return best;\n  }\n\n  function withoutPath(obj, path) {\n    var copy = Array.isArray(obj) ? obj.slice() : Object.assign({}, obj);\n    if (path.length === 1) { copy[path[0]] = '[見後面的記錄]'; return copy; }\n    copy[path[0]] = withoutPath(obj[path[0]], path.slice(1));\n    return copy;\n  }\n\n  // 把一個結果轉成「一行一筆」的記錄。input：JSON 文字、JSONL 文字或已解析的值。\n  // 回傳 { lines:[每筆一行的字串], shape, head, bad, path } 或 null（不是記錄清單，呼叫者退回原本的截斷）。\n\n  // 超深的結構攤平成 JSONL：每個節點一行 {\"path\":\"/a/b/0/c\",\"type\":\"string\",\"value\":…}（JSON Pointer；容器行只有 type 與 keys／length，\n  // 沒有 value），先序、鍵順序不變，所以 unflatten 可以逐字還原。單行不含實體換行（JSON.stringify），單一葉子太大由分頁器分段。\n  function ptrEsc(k) { return String(k).replace(/~/g, '~0').replace(/\\//g, '~1'); }\n  // maxDepth：只攤到這一層，更深的容器變成一行 {collapsed:true,size:子孫節點數}（先看全貌，要哪裡再用 expand 往下鑽）；沒給就攤到底。\n  function dkeys(o) { return Object.keys(o).filter(function (k) { return o[k] !== undefined && typeof o[k] !== 'function'; }); } // 跟 JSON.stringify 一樣：值是 undefined／函式的欄位不存在\n  function countNodes(v) { var n = 1; if (Array.isArray(v)) for (var i = 0; i < v.length; i++) n += countNodes(v[i]); else if (isObj(v)) { var dk = dkeys(v); for (var q = 0; q < dk.length; q++) n += countNodes(v[dk[q]]); } return n; }\n  function flatten(value, opts) {\n    opts = opts || {}; var maxNodes = Number(opts.maxNodes) > 0 ? Number(opts.maxNodes) : 2000000;\n    var limit = opts.maxDepth != null && Number(opts.maxDepth) >= 0 ? Number(opts.maxDepth) : Infinity, base = opts.basePath || '', d0 = Number(opts.baseDepth) || 0;\n    var out = [], count = 0, truncated = false;\n    (function walk(v, path, depth) {\n      if (truncated) return;\n      if (++count > maxNodes) { truncated = true; return; }\n      var isArr = Array.isArray(v), isO = isObj(v);\n      if (isArr || isO) {\n        var row = { path: path, depth: depth, type: isArr ? 'array' : 'object' }; if (isArr) row.length = v.length; else row.keys = dkeys(v).length;\n        if (depth - d0 >= limit && (isArr ? v.length : row.keys)) { row.collapsed = true; row.size = countNodes(v) - 1; out.push(safeStringify(row)); return; }\n        out.push(safeStringify(row));\n        if (isArr) for (var i = 0; i < v.length; i++) walk(v[i], path + '/' + i, depth + 1);\n        else { var ks = dkeys(v); for (var j = 0; j < ks.length; j++) walk(v[ks[j]], path + '/' + ptrEsc(ks[j]), depth + 1); }\n      } else out.push(safeStringify({ path: path, depth: depth, type: v === null ? 'null' : typeof v, value: v === undefined ? null : v }));\n    })(value, base, d0);\n    return { lines: out, nodes: out.length, truncated: truncated };\n  }\n  // 往下鑽：把 path（JSON Pointer）那個節點再攤開 levels 層（預設 1），行的 path 是從根算起的完整路徑，可以直接接在先前的行後面一起 unflatten。\n  function getByPointer(value, path) {\n    var cur = value; if (path === '' || path == null) return { ok: true, value: cur };\n    var segs = String(path).split('/').slice(1).map(function (x) { return x.replace(/~1/g, '/').replace(/~0/g, '~'); });\n    for (var i = 0; i < segs.length; i++) { if