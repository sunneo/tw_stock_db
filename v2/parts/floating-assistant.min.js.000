"},{when:{op:"==",value:0},meaning:"the two are equal"},{when:{op:">",value:0},meaning:"the first is larger"}]}},memcmp:{summary:"Compares two strings or memory blocks byte by byte.",parameters:[{name:"s1",meaning:"first operand"},{name:"s2",meaning:"second operand"},{name:"n",meaning:"number of bytes to compare (strncmp/memcmp)"}],return:{meaning:"zero when equal, otherwise the sign of the first difference",rules:[{when:{op:"<",value:0},meaning:"the first is smaller"},{when:{op:"==",value:0},meaning:"the two are equal"},{when:{op:">",value:0},meaning:"the first is larger"}]}},strlen:{summary:"Counts the characters before the terminating NUL.",parameters:[{name:"s",meaning:"the NUL-terminated string"}],return:{meaning:"the length in characters, excluding the terminator"}},strchr:{summary:"Searches for a character or substring and returns a pointer to it.",parameters:[{name:"s",meaning:"the text or memory to search"},{name:"c",meaning:"the character (or needle string) to find"}],return:{meaning:"a pointer to the first match, or NULL if absent",rules:[{when:{op:"==",value:0},meaning:"not found"},{when:{op:"!=",value:0},meaning:"pointer to the match"}]}},strrchr:{summary:"Searches for a character or substring and returns a pointer to it.",parameters:[{name:"s",meaning:"the text or memory to search"},{name:"c",meaning:"the character (or needle string) to find"}],return:{meaning:"a pointer to the first match, or NULL if absent",rules:[{when:{op:"==",value:0},meaning:"not found"},{when:{op:"!=",value:0},meaning:"pointer to the match"}]}},strstr:{summary:"Searches for a character or substring and returns a pointer to it.",parameters:[{name:"s",meaning:"the text or memory to search"},{name:"c",meaning:"the character (or needle string) to find"}],return:{meaning:"a pointer to the first match, or NULL if absent",rules:[{when:{op:"==",value:0},meaning:"not found"},{when:{op:"!=",value:0},meaning:"pointer to the match"}]}},memchr:{summary:"Searches for a character or substring 