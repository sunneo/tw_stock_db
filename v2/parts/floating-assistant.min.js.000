ft'|'right' }\n * 偏好存主程式 localStorage（iframe 沒有儲存空間），所以所有輸入都當不可信：normalize 會丟掉未知分頁、補回遺失的、保證兩區至少各一個。 */\n(function (root, factory) {\n    if (typeof module === 'object' && module.exports) module.exports = factory();\n    else root.FaStudioLayout = factory();\n})(typeof self !== 'undefined' ? self : this, function () {\n    'use strict';\n    const TABS = [\n        { id: 'assets', title: '資產清單', icon: '📦' },\n        { id: 'lora', title: 'LoRA 登錄', icon: '🧩' },\n        { id: 'ingest', title: '資料匯入', icon: '📥' },\n        { id: 'datasets', title: '資料集', icon: '🗂️' },\n        { id: 'domains', title: '領域', icon: '🧬' },\n        { id: 'eval', title: '評量', icon: '📊' },\n        { id: 'train', title: '訓練', icon: '🏋️' },\n        { id: 'pipeline', title: '流程', icon: '🧭' },\n        { id: 'teacher', title: '老師', icon: '🎓' },\n        { id: 'log', title: '紀錄', icon: '📜' },\n    ];\n    const IDS = TABS.map((t) => t.id);\n    const DEFAULT = { panes: { left: ['assets', 'lora', 'ingest', 'datasets', 'domains', 'eval'], right: ['train', 'pipeline', 'teacher', 'log'] }, active: { left: 'assets', right: 'train' }, closed: [], split: 0.45, max: null };\n    const SPLIT_MIN = 0.2, SPLIT_MAX = 0.8, STACK_BELOW = 640;\n    const clone = (o) => JSON.parse(JSON.stringify(o));\n    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));\n\n    function defaults() { return clone(DEFAULT); }\n    // 正規化：未知分頁丟掉、重複只留第一個、沒出現在任何地方的（也不在 closed）補回預設所在側、兩區至少一個分頁\n    function normalize(input) {\n        const L = defaults(); if (!input || typeof input !== 'object') return L;\n        const seen = new Set(), panes = { left: [], right: [] }, closed = [];\n        ['left', 'right'].forEach((side) => { const a = input.panes && Array.isArray(input.panes[side]) ? input.panes[side] : []; a.forEach((id) => { if (IDS.indexOf(id) >= 0 && !seen.has(id)) { seen.add(id); panes[side].push(id); } }); });\n        (Array.isArray(input.closed) ? input.closed : []).forEach((id) => { if (IDS.indexOf(id) >= 0 && !seen.has(id)) { seen.add(id); closed.push(id); } });\n        IDS.forEach((id) => { if (!seen.has(id)) { seen.add(id); (DEFAULT.panes.left.indexOf(id) >= 0 ? panes.left : panes.right).push(id); } });\n        ['left', 'right'].forEach((side, i) => { if (!panes[side].length) { const other = side === 'left' ? 'right' : 'left'; if (panes[other].length > 1) panes[side].push(panes[other].pop()); else if (closed.length) panes[side].push(closed.shift()); } });\n        L.panes = panes; L.closed = closed;\n        ['left', 'right'].forEach((side) => { const a = input.active && input.active[side]; L.active[side] = panes[side].indexOf(a) >= 0 ? a : (panes[side][0] || null); });\n        const sp = Number(input.split); L.split = Number.isFinite(sp) ? clamp(sp, SPLIT_MIN, SPLIT_MAX) : DEFAULT.split;\n        L.max = input.max === 'left' || input.max === 'right' ? input.max : null;\n        if (L.max && !panes[L.max].length) L.max = null;\n        return L;\n    }\n    const sideOf = (L, id) => (L.panes.left.indexOf(id) >= 0 ? 'left' : (L.panes.right.indexOf(id) >= 0 ? 'right' : null));\n    const total = (L) => L.panes.left.length + L.panes.right.length;\n    // 搬移：兩區各至少一個分頁（來源只剩這一個時拒絕，除非搬進同一側重新排序）\n    function moveTab(L, id, side, index) {\n        const from = sideOf(L, id); if (!from) return { ok: false, error: '分頁不在任何一區（先用「+」開啟）' };\n        if (side !== 'left' && side !== 'right') return { ok: false, error: '目標只能是 left／right' };\n        if (from !== side && L.panes[from].length <= 1) return { ok: false, error: '每一區至少要保留一個分頁' };\n        const N = clone(L); N.panes[from] = N.panes[from].filter((x) => x !== id);\n        const at = index === undefined || index < 0 || index > N.panes[side].length ? N.panes[side].length : index;\n        N.panes[side].splice(at, 0, id); N.active[side] = id;\n        if (from !== side) N.active[from] = N.panes[from].indexOf(N.active[from]) >= 0 ? N.active[from] : N.panes[from][0];\n        return { ok: true, layout: N };\n    }\n    function closeTab(L, id) {\n        const side = sideOf(L, id); if (!side) return { ok: false, error: '分頁已經關閉' };\n        if (L.panes[side].length <= 1) return { ok: false, error: '每一區至少要保留一個分頁' };\n        const N = clone(L); N.panes[side] = N.panes[side].filter((x) => x !== id); N.closed.push(id);\n        if (N.active[side] === id) N.active[side] = N.panes[side][Math.min(L.panes[side].indexOf(id), N.panes[side].length - 1)];\n        return { ok: true, layout: N };\n    }\n    function openTab(L, id, side) {\n        if (IDS.indexOf(id) < 0) return { ok: false, error: '沒有這個分頁' };\n        if (sideOf(L, id)) { const N = clone(L); N.active[sideOf(L, id)] = id; return { ok: true, layout: N }; }\n        const s = side === 'left' || side === 'right' ? side : (DEFAULT.panes.left.indexOf(id) >= 0 ? 'left' : 'right');\n        const N = clone(L); N.closed = N.closed.filter((x) => x !== id); N.panes[s].push(id); N.active[s] = id; return { ok: true, layout: N };\n    }\n    function activate(L, id) { const s = sideOf(L, id); if (!s) return L; const N = clone(L); N.active[s] = id; return N; }\n    // 分隔線：以比例（0–1）記，拖曳時夾在上下限；雙擊還原\n    const setSplit = (L, v) => { const N = clone(L), x = Number(v); N.split = Number.isFinite(x) ? clamp(x, SPLIT_MIN, SPLIT_MAX) : DEFAULT.split; return N; };\n    const resetSplit = (L) => { const N = clone(L); N.split = DEFAULT.split; return N; };\n    const toggleMax = (L, side) => { const N = clone(L); N.max = N.max === side ? null : (side === 'left' || side === 'right' ? side : null); return N; };\n    const orientation = (widthPx) => (widthPx < STACK_BELOW ? 'stack' : 'side');\n    // 滑鼠位置 → 比例；horizontal＝左右（用 x），否則上下（用 y）\n    const ratioFromPointer = (pos, start, size) => (size > 0 ? clamp((pos - start) / size, SPLIT_MIN, SPLIT_MAX) : DEFAULT.split);\n    return { TABS, IDS, DEFAULT, SPLIT_MIN, SPLIT_MAX, STACK_BELOW, defaults, normalize, sideOf, total, moveTab, closeTab, openTab, activate, setSplit, resetSplit, toggleMax, orientation, ratioFromPointer };\n});\n",FA_WEBLORA_WORKER_SRC="const holder = {};\n(function (module, self) {\n/* 網頁版 LoRA：最小的 ONNX（protobuf）讀寫器——只做「找節點／初始值」與「換掉某些初始值」，其他位元組原封不動複製（零拷貝切片）。\n *  純函式核心（UMD）：Node 與瀏覽器（含 Worker）都能載入。不依賴 onnx 套件。\n *  為什麼自己寫：網頁版要在載入 q8 模型前改權重與縮放值（DESIGN.TODO.offline-training-studio.md §14 路線 c），模型約 600 MB，只能在記憶體裡做位元組級修改。\n *  支援範圍（超出就丟明確錯誤，絕不靜默產生壞模型）：\n *   - 權重必須是 raw_data 內嵌（不是外部資料檔、不是 int32_data 之類的欄位）。\n *   - 被換掉的初始值不得同時出現在 graph.input（舊版 IR 把初始值也列為輸入，換形狀會對不上宣告）。\n *  API：\n *   indexModel(bytes) → {graph:{tagStart,start,end}, nodes:[{name,op,inputs,outputs}], inits:Map<name,{dataType,dims,rawStart,rawEnd,tagStart,start,end,external}>, graphInputs:Set, producers:Map<output,node>, consumers:Map<name,node[]>}\n *   encodeTensor({name,dataType,dims,raw}) → Uint8Array（TensorProto）\n *   rewrite(bytes, index, replacements:Map<initName,Uint8Array 新 TensorProto>) → {parts:Uint8Array[], length}\n *   concatParts(parts, length) → Uint8Array；toBlob(parts) → Blob */\n(function (root, factory) {\n    if (typeof module === 'object' && module.exports) module.exports = factory();\n    else root.FaOnnxPatch = factory();\n})(typeof self !== 'undefined' ? self : this, function () {\n    'use strict';\n    const TD = typeof TextDecoder !== 'undefined' ? new TextDecoder('utf-8') : null;\n    const TE = typeof TextEncoder !== 'undefined' ? new TextEncoder() : null;\n    const DT = { FLOAT: 1, UINT8: 2, INT8: 3 };\n\n    function readVarint(b, p) {\n        let v = 0, mul = 1, i = 0;\n        for (;;) {\n            if (p >= b.length) throw new Error('protobuf 讀到檔尾（檔案不完整或不是 ONNX）');\n            const c = b[p++];\n            v += (c & 0x7f) * mul; mul *= 128; i++;\n            if (!(c & 0x80)) return [v, p];\n            if (i > 9) throw new Error('protobuf varint 過長');\n        }\n    }\n    function varintBytes(v) {\n        const out = [];\n        while (v >= 128) { out.push((v % 128) | 0x80); v = Math.floor(v / 128); }\n        out.push(v);\n        return Uint8Array.from(out);\n    }\n    // 走訪 [p, end) 內的欄位。回呼 fn({num, wt, tagStart, vs, ve, val}) ；wt=2 時 [vs,ve) 是內容，wt=0 時 val 是數值\n    function eachField(b, p, end, fn) {\n        while (p < end) {\n            const tagStart = p; let tag; [tag, p] = readVarint(b, p);\n            const num = Math.floor(tag / 8), wt = tag % 8;\n            if (wt === 0) { let val; [val, p] = readVarint(b, p); fn({ num, wt, tagStart, vs: p, ve: p, val, fieldEnd: p }); }\n            else if (wt === 2) { let len; [len, p] = readVarint(b, p); if (p + len > end) throw new Error('protobuf 長度超出範圍'); fn({ num, wt, tagStart, vs: p, ve: p + len, fieldEnd: p + len }); p += len; }\n            else if (wt === 1) { fn({ num, wt, tagStart, vs: p, ve: p + 8, fieldEnd: p + 8 }); p += 8; }\n            else if (wt === 5) { fn({ num, wt, tagStart, vs: p, ve: p + 4, fieldEnd: p + 4 }); p += 4; }\n            else throw new Error('protobuf 不支援的 wire type ' + wt);\n        }\n    }\n    const str = (b, s, e) => TD.decode(b.subarray(s, e));\n\n    function parseNode(b, s, e) {\n        const n = { name: '', op: '', inputs: [], outputs: [] };\n        eachField(b, s, e, (f) => {\n            if (f.wt !== 2) return;\n            if (f.num === 1) n.inputs.push(str(b, f.vs, f.ve));\n            else if (f.num === 2) n.outputs.push(str(b, f.vs, f.ve));\n            else if (f.num === 3) n.name = str(b, f.vs, f.ve);\n            else if (f.num === 4) n.op = str(b, f.vs, f.ve);\n        });\n        return n;\n    }\n    function parseTensor(b, s, e, tagStart) {\n        const t = { name: '', dataType: 0, dims: [], rawStart: -1, rawEnd: -1, external: false, otherData: false, floatData: null, int32Data: null, tagStart, start: s, end: e };\n        eachField(b, s, e, (f) => {\n            if (f.num === 1) {\n                if (f.wt === 0) t.dims.push(f.val);\n                else if (f.wt === 2) { let p = f.vs; while (p < f.ve) { let v; [v, p] = readVarint(b, p); t.dims.push(v); } }\n            } else if (f.num === 2 && f.wt === 0) t.dataType = f.val;\n            else if (f.num === 8 && f.wt === 2) t.name = str(b, f.vs, f.ve);\n            else if (f.num === 9 && f.wt === 2) { t.rawStart = f.vs; t.rawEnd = f.ve; }\n            else if (f.num === 13) t.external = true;\n            else if (f.num === 14 && f.wt === 0 && f.val === 1) t.external = true;\n            else if (f.num === 4 && f.wt === 2 && f.ve - f.vs <= 64) { t.floatData = t.floatData || []; const dv = new DataView(b.buffer, b.byteOffset + f.vs, f.ve - f.vs); for (let o = 0; o + 4 <= f.ve - f.vs; o += 4) t.floatData.push(dv.getFloat32(o, true)); }\n            else if (f.num === 4 && f.wt === 5) { t.floatData = t.floatData || []; t.floatData.push(new DataView(b.buffer, b.byteOffset + f.vs, 4).getFloat32(0, true)); }\n            else if (f.num === 5 && f.wt === 2 && f.ve - f.vs <= 64) { t.int32Data = t.int32Data || []; let p = f.vs; while (p < f.ve) { let v; [v, p] = readVarint(b, p); t.int32Data.push(v); } }\n            else if (f.num === 5 && f.wt === 0) { t.int32Data = t.int32Data || []; t.int32Data.push(f.val); }\n            else if ([4, 5, 6, 7, 10, 11].includes(f.num)) t.otherData = true;\n        });\n        return t;\n    }\n    function parseValueInfoName(b, s, e) { let name = ''; eachField(b, s, e, (f) => { if (f.num === 1 && f.wt === 2) name = str(b, f.vs, f.ve); }); return name; }\n\n    function indexModel(bytes) {\n        if (!(bytes instanceof Uint8Array)) throw new Error('indexModel 需要 Uint8Array');\n        let graph = null;\n        eachField(bytes, 0, bytes.length, (f) => { if (f.num === 7 && f.wt === 2) graph = { tagStart: f.tagStart, start: f.vs, end: f.ve }; });\n        if (!graph) throw new Error('找不到 graph 欄位（不是 ONNX 模型檔）');\n        const nodes = [], inits = new Map(), graphInputs = new Set(), producers = new Map(), consumers = new Map();\n        eachField(bytes, graph.start, graph.end, (f) => {\n            if (f.wt !== 2) return;\n            if (f.num === 1) nodes.push(parseNode(bytes, f.vs, f.ve));\n            else if (f.num === 5) { const t = parseTensor(bytes, f.vs, f.ve, f.tagStart); inits.set(t.name, t); }\n            else if (f.num === 11) graphInputs.add(parseValueInfoName(bytes, f.vs, f.ve));\n        });\n        for (const n of nodes) {\n            for (const o of n.outputs) producers.set(o, n);\n            for (const i of n.inputs) { if (!consumers.has(i)) consumers.set(i, []); consumers.get(i).push(n); }\n        }\n        return { graph, nodes, inits, graphInputs, producers, consumers };\n    }\n\n    function encodeTensor(t) {\n        const name = TE.encode(t.name), raw = t.raw;\n        const dimsPayload = []; for (const d of t.dims) dimsPayload.push(...varintBytes(d));\n        const parts = [];\n        if (t.dims.length) parts.push(Uint8Array.from([0x0a]), varintBytes(dimsPayload.length), Uint8Array.from(dimsPayload)); // 1: dims（packed）\n        parts.push(Uint8Array.from([0x10]), varintBytes(t.dataType));                                                            // 2: data_type\n        parts.push(Uint8Array.from([0x42]), varintBytes(name.length), name);                                                      // 8: name\n        parts.push(Uint8Array.from([0x4a]), varintBytes(raw.length), raw);                                                        // 9: raw_data\n        return concat(parts);\n    }\n    function concat(arrs) {\n        let n = 0; for (const a of arrs) n += a.length;\n        const out = new Uint8Array(n); let o = 0; for (const a of arrs) { out.set(a, o); o += a.length; }\n        return out;\n    }\n\n    // 重寫整個模型：只有被換掉的初始值改變，其餘用 subarray 零拷貝切片串起來。\n    function rewrite(bytes, index, replacements) {\n        const g = index.graph;\n        for (const name of replacements.keys()) {\n            if (!index.inits.has(name)) throw new Error('要換的初始值不存在：' + name);\n            if (index.graphInputs.has(name)) throw new Error('初始值 ' + name + ' 同時是 graph.input（舊版 IR），換形狀會與宣告不符，不支援');\n        }\n        const gparts