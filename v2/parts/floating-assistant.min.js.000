n(){if(confirm('停止訓練？（不存檢查點；要保留進度請用「暫停」）'))api('POST','/api/train/stop',{})}});\n  var bEx=h('button',{text:'匯出續訓檢查點 .fackpt',disabled:!r.webTrain,onclick:async function(){var x=await api('POST','/api/train/checkpoint/export',{name:nm.value.trim()});if(x.ok===false)alert(x.error)}});\n  var bIm=h('button',{text:'匯入續訓檢查點…',disabled:!r.webTrain,onclick:async function(){var x=await api('POST','/api/train/checkpoint/import',{name:nm.value.trim()||undefined});if(x.ok===false){alert(x.error);return}if(x.cancelled)return;alert('已匯入：'+x.step+' 步（產生者 '+((x.produced_by&&x.produced_by.backend)||'?')+'）。按「續訓」從這裡接著訓練。')}});\n  function refresh(){var on=canRun();[bGo,bPa,bRe,bSt].forEach(function(b){b.disabled=!on})}bs.onchange=refresh;refresh();\n  out.appendChild(h('div',{'class':'row'},[bGo,bPa,bRe,bSt]));out.appendChild(h('div',{'class':'row'},[bEx,bIm]));\n  // LLM 匯出（DESIGN §25）：LoRA 併回基底 → ONNX q8 或 GGUF Q8_0；每一步的狀態與阻礙都顯示出來（只在桌面版執行）\n  out.appendChild(h('div',{'class':'grp',text:'LLM 匯出（ONNX／GGUF）'}));\n  var lfm=h('select',{},[h('option',{value:'onnx',text:'ONNX q8（桌面版 onnxruntime 吃的格式，預設）'}),h('option',{value:'gguf',text:'GGUF Q8_0（llama.cpp）'})]);\n  var lad=h('input',{type:'text',placeholder:'LoRA adapter 資料夾的絕對路徑（PEFT：adapter_config.json＋adapter_model.safetensors）'}),lbd=h('input',{type:'text',value:'models/Qwen3-0.6B',placeholder:'基底 HF 資料夾（本機已有；離線不下載）'});\n  var lst=h('div',{'class':'card',style:'white-space:pre-line'}),ltool=h('div',{style:'font-size:12px;color:var(--mut);white-space:pre-line'});\n  out.appendChild(h('label',{text:'格式'}));out.appendChild(lfm);\n  out.appendChild(h('label',{text:'LoRA adapter 資料夾'}));out.appendChild(lad);\n  out.appendChild(h('label',{text:'基底 HF 資料夾'}));out.appendChild(lbd);\n  var lGo=h('button',{'class':'pri',text:'匯出',disabled:!r.desktop,onclick:async function(){var x=await api('POST','/api/llm/export',{format:lfm.value,adapterDir:lad.value.trim(),baseDir:lbd.value.trim()});if(x.ok===false){alert(x.error||'匯出沒有啟動');if(x.tools)ltool.textContent=JSON.stringify(x.tools);return}pollLlmExport(lst)}});\n  var lChk=h('button',{text:'檢查工具',disabled:!r.desktop,onclick:async function(){var x=await api('GET','/api/llm/tools');if(x.ok===false){ltool.textContent=x.error||'偵測失敗';return}ltool.textContent=Object.keys(x.availability||{}).map(function(k){var a=x.availability[k];return k.toUpperCase()+'：'+(a.available?'可用':'不可用（'+a.reason+'）')}).join('\\n')}});\n  out.appendChild(h('div',{'class':'row'},[lGo,lChk]));out.appendChild(ltool);out.appendChild(lst);out.appendChild(h('div',{id:'fa-llm-actions','class':'row'}));\n  out.appendChild(webLlmBox());\n  if(!r.desktop)out.appendChild(h('div',{'class':'todo',text:'網頁版只能匯出設定、實際匯出在桌面版（需要 Python 與 llama.cpp）。'}));\n  if(!r.desktop&&!r.webTrain)out.appendChild(h('div',{'class':'todo',text:'這個環境沒有可用的訓練後端（沒有子行程，頁內處理器訓練也沒接上）。到「資產清單」匯出 .fatrain，拿到桌面版訓練。'}));\n  if(!r.desktop&&r.webTrain)out.appendChild(h('div',{'class':'todo',text:'網頁版用頁內處理器訓練：慢但正確；可隨時「暫停」，再「匯出續訓檢查點」帶到另一台（桌面版或另一個網頁）接著訓練。'}));\n  out.appendChild(prog);prog.appendChild(h('div',{text:'還沒有訓練。'}));prog.appendChild(cv);pollTrain(prog,cv,true)}\n ksel.onchange=build;setMode(MODE==='adv'?'adv':'simple')};\n\n// ===== 簡單模式：訓練精靈（選目標 → 選資料 → 確認 → 開始），每一步只問一件事，預設值都填好 =====\n/* ===== 模型類型（模型類型登錄表的結果，由 app 傳入；開關「顯示半成品的功能」改變時會即時更新） ===== */\nvar MTYPES=CFG.modelTypes||[],GUARDS=CFG.guards||{},MT_MISSING=!!CFG.modelTypesMissing;\nvar MT_KEY='fa_train_modeltype',MT_OUT_KEY='fa_train_output';\nvar MT_MEM={};\nfunction lsGet(k,d){try{var v=localStorage.getItem(k);if(v)return v}catch(e){}return MT_MEM[k]||d}\nfunction lsSet(k,v){MT_MEM[k]=v;try{localStorage.setItem(k,v)}catch(e){}}\nfunction mtGet(){var id=lsGet(MT_KEY,'llm');return MTYPES.filter(function(t){return t.id===id})[0]||MTYPES[0]||null}\nfunction mtSet(id){lsSet(MT_KEY,id)}\nfunction mtOut(){return lsGet(MT_OUT_KEY,'lora')}\nfunction mtOutSet(o){lsSet(MT_OUT_KEY,o)}\nfunction mtGuard(t){var g=GUARDS[t.id]||{};var o=mtOut();var r=t.outputs.some(function(x){return x.id===o})?g[o]:null;return r||g._default||{level:'blocked',ok:false,message:'模型類型登錄表沒有接上，無法判斷這個類型能不能訓練。請重新整理工作室。'}}\nfunction mtWarn(t){var g=mtGuard(t);return h('div',{'class':g.level==='run'?'todo':'warn',text:(g.level==='run'?'✅ ':'⚠️ ')+g.message})}\n/* 半成品與只有設計：按「開始」不會訓練，而是把目前能做到哪一步、還缺什麼寫清楚（不悄悄失敗） */\nfunction mtStartBtn(t){var b=h('button',{'class':'pri',text:'▶ 開始訓練'});var msg=h('div');b.onclick=function(){msg.textContent='';msg.appendChild(h('div',{'class':'warn',text:'還沒有開始訓練。'+mtGuard(t).message}))};return h('div',{},[b,msg])}\n/* 外部訓練作業（六種型別的命令列核心）：按開始呼叫 /api/ext/start，每 2 秒讀 /api/ext/status；寫清楚預估時間與限制，失敗給原因。\n * 欄位由 EXT_RUN 描述（步數、路徑、可留空的 Python）。路徑與格式的檢查在主行程做（studio_ext_check），這裡只顯示它的錯誤。 */\nvar EXT_RUN={\n music:{est:'處理器（CPU）約 1 分鐘（1500 步，實測 55 秒）。',steps:1500,paths:[]},\n speech_recognition:{est:'處理器（CPU）40 步約 30 秒（實測 29 秒）。',steps:40,paths:[{k:'base',t:'dir',label:'基底模型資料夾（小型語音辨識基底）'},{k:'data',t:'file',label:'語音資料檔（data.jsonl）'}]},\n speech:{est:'處理器（CPU）約 2 秒／步（實測 30 步 51 秒；以你的電腦為準）。',steps:30,paths:[{k:'model',t:'dir',label:'Kokoro-82M 模型資料夾（config.json、kokoro-v1_0.pth）'},{k:'voice',t:'file',label:'基底語音包（.pt）'},{k:'data',t:'dir',label:'配對資料夾（train.jsonl、heldout.jsonl）'}]},\n audio_to_notes:{est:'處理器（CPU）300 步約 25 秒（實測 24 秒；以你的電腦為準）。只用合成資料。',steps:300,paths:[{k:'base',t:'file',label:'基底轉譜模型（nmp.onnx）'}]},\n vision:{est:'處理器（CPU）約 1 秒／步（實測 300 步 264 秒）。只用合成的顏色與形狀圖。',steps:300,paths:[{k:'base',t:'dir',label:'基底看圖模型資料夾（SmolVLM 格式）'}]},\n llm_scratch:{est:'處理器（CPU）迷你模型：預訓練每 1000 個 token 約 26 秒、指令微調每步約 3 秒（實測，負載很高的機器；閒置時預期較快，未量測）。預設全流程約 1 小時，結果只是示範等級。專家混合約慢 1.1 倍；推理另加算術微調與強化學習（實驗用 tiny：強化學習每步約 12 秒）。步數欄位＝預訓練步數。',steps:300,paths:[{k:'corpus',t:'file',label:'語料（文字檔或資料夾；留空＝內建小語料，只夠示範）'}],fields:[{k:'arch',label:'架構（dense＝密集、moe＝專家混合、reasoning＝推理：思考＋答案再強化學習）',value:'dense'},{k:'preset',label:'模型大小（mini＝約 1 千 3 百萬參數、small＝約 2 千萬、tiny＝4 層實驗用）',value:'mini'},{k:'kvHeads',label:'鍵值頭數（8＝可給原生執行環境；其他值只輸出標準格式；留空＝8）',value:''},{k:'layers',label:'層數（1 到 28，留空＝依大小）',value:''},{k:'experts',label:'專家數（只對 moe）',value:'8'},{k:'topK',label:'每個詞元挑幾個專家（只對 moe）',value:'2'},{k:'vocab',label:'分詞器詞彙表大小',value:'4096'},{k:'batch',label:'預訓練批次',value:'4'},{k:'seq',label:'序列長度',value:'128'},{k:'sftSteps',label:'指令微調步數',value:'40'}]},\n image:{est:'處理器（CPU）約 1 秒／步（512 解析度，實測 40 步訓練 35 秒）；只用合成圖文配對。',steps:40,paths:[{k:'base',t:'dir',label:'SDXS 基底模型資料夾（unet、vae、text_encoder、tokenizer）'}]}\n};\nfunction extRunPanel(t){\n var cfg=EXT_RUN[t.id]||{est:'',steps:100,paths:[]},box=h('div',{}),st={jobId:null,timer:null},inp={};\n var nm=h('input',{type:'text',placeholder:'輸出名稱（英數、中文、底線、連字號）',style:'width:100%'});\n var steps=h('input',{type:'number',min:'1',value:String(cfg.steps),style:'width:140px'});\n var py=h('input',{type:'text',placeholder:'訓練用 Python 路徑（留空＝自動）',style:'width:100%'});\n var msg=h('div',{style:'font-size:12px;margin-top:6px'}),prog=h('div',{style:'font-size:12px;color:var(--mut);margin-top:4px;white-space:pre-line'});\n var bGo=h('button',{'class':'pri',text:'▶ 開始訓練'}),bStop=h('button',{text:'停止',disabled:true});\n box.appendChild(h('div',{style:'font-size:12px;margin-top:6px',text:'預估時間：'+cfg.est}));\n box.appendChild(h('label',{text:'輸出名稱'}));box.appendChild(nm);\n box.appendChild(h('label',{text:'訓練步數'}));box.appendChild(steps);\n cfg.paths.forEach(function(pd){var i=h('input',{type:'text',placeholder:pd.t==='dir'?'資料夾完整路徑':'檔案完整路徑',style:'width:100%'});inp[pd.k]=i;box.appendChild(h('label',{text:pd.label}));box.appendChild(i)});\n var fld={};(cfg.fields||[]).forEach(function(fd){var i=h('input',{type:'text',value:fd.value,style:'width:100%'});fld[fd.k]=i;box.appendChild(h('label',{text:fd.label}));box.appendChild(i)});\n box.appendChild(h('label',{text:'Python（進階，留空＝自動）'}));box.appendChild(py);\n box.appendChild(h('div',{'class':'row',style:'gap:6px;margin-top:6px'},[bGo,bStop]));\n box.appendChild(msg);box.appendChild(prog);\n function stopPoll(){if(st.timer){clearInterval(st.timer);st.timer=null}}\n async function poll(){\n  var s=await api('GET','/api/ext/status?jobId='+encodeURIComponent(st.jobId||''));\n  if(!s||s.ok===false){stopPoll();msg.textContent='讀取狀態失敗：'+((s&&s.error)||'');bGo.disabled=false;bStop.disabled=true;return}\n  if(s.state==='running'){var cur=(s.steps||[]).filter(function(x){return x.state==='running'})[0];prog.textContent=(s.steps||[]).map(function(x){return (x.state==='done'?'✓ ':x.state==='running'?'▶ ':'○ ')+x.label}).join(' → ')+'\\n執行中：'+(cur?cur.label:'')+'；步數 '+(s.step||0)+'；損失 '+(s.loss==null?'—':Number(s.loss).toFixed(4))+'；已跑 '+Math.round((s.elapsedMs||0)/1000)+' 秒';return}\n  stopPoll();bGo.disabled=false;bStop.disabled=true;prog.textContent='';\n  if(s.state==='finished')msg.textContent='完成。輸出在：'+(s.outDir||'')+'（還沒收進工作室資產）';\n  else if(s.state==='stopped')msg.textContent='已停止：'+(s.message||'');\n  else msg.textContent='失敗：'+(s.message||'未知原因');\n }\n bGo.onclick=async function(){\n  msg.textContent='';var gd=mtGuard(t);if(gd&&gd.ok===false){msg.textContent='目前選的輸出不能用：'+(gd.message||'請改選其他輸出。');return}\n  var paths={};cfg.paths.forEach(function(pd){var v=inp[pd.k].value.trim();if(v||!pd.optional)paths[pd.k]=v;if(!v&&pd.k==='corpus')delete paths[pd.k]});\n  var prm={steps:Number(steps.value)};Object.keys(fld).forEach(function(k){var v=fld[k].value.trim();if(v==='')return;prm[k]=(k==='preset'||k==='arch')?v:Number(v)});\n  var body={type:t.id,output:mtOut(),name:nm.value.trim(),params:prm,paths:paths};if(py.value.trim())body.python=py.value.trim();\n  var x=await api('POST','/api/ext/start',body);if(x.ok===false){msg.textContent=String(x.error||'沒有啟動');return}\n  st.jobId=x.jobId;bGo.disabled=true;bStop.disabled=false;msg.textContent='已開始。'+(x.limitsNote||'');st.timer=setInterval(poll,2000)};\n bStop.onclick=async function(){await api('POST','/api/ext/stop',{jobId:st.jobId});msg.textContent='要求停止中…'};\n return box}\nfunction modelTypePanel(onChange){\n var box=h('div',{'class':'card',style:'margin-bottom:8px'});\n if(MT_MISSING||!MTYPES.length){box.appendChild(h('div',{'class':'warn',text:'模型類型登錄表沒有接上，下面只能用既有的訓練。請重新整理工作室。'}));return box}\n var cur=mtGet();\n var sel=h('select',{style:'width:100%'},MTYPES.map(function(t){return h('option',{value:t.id,text:t.label})}));if(cur)sel.value=cur.id;\n sel.onchange=function(){mtSet(sel.value);onChange()};\n box.appendChild(h('label',{text:'模型類型（先選你要做哪一種模型）'}));box.appendChild(sel);\n if(!cur)return box;\n var head=h('div',{style:'margin-top:8px'},[h('b',{text:cur.name}),h('span',{'class':'badge '+(cur.status==='done'?'ok':'wn'),text:cur.status==='done'?'已完成可用':cur.badge}) ]);box.appendChild(head);\n box.appendChild(h('div',{style:'font-size:12px;color:var(--mut);margin-top:2px',text:cur.summary}));\n box.appendChild(h('div',{style:'font-size:12px;margin-top:6px',text:'資料來源：'+(cur.sources.length?cur.sources.join('；'):'這一種目前沒有可用的資料來源。')}));\n box.appendChild(h('div',{style:'font-size:12px;margin-top:2px',text:'後端：'+(cur.backends.length?cur.backends.map(function(b){return b.label}).join('；'):'目前沒有可用的後端（還沒有訓練核心）。')}));\n var outs=h('div',{style:'margin-top:6px'});outs.appendChild(h('div',{style:'font-size:12px;color:var(--mut)',text:'輸出（LoRA 小檔可以疊在基底上；完整模型是併回基底後匯出）：'}));\n var row=h('div',{'class':'row',style:'gap:6px'});\n cur.outputs.forEach(function(o){var on=mtOut()===o.id&&o.available;\n  if(cur.outputs.length<2){row.appendChild(h('span',{'class':'badge ok',text:o.label}));return}\n  row.appendChild(h('button',{'class':on?'pri':'',text:(on?'✅ ':'')+o.label,disabled:!o.available,title:o.available?'':o.reason,onclick:function(){mtOutSet(o.id);onChange()}}))});\n outs.appendChild(row);\n cur.outputs.forEach(function(o){if(!o.available)outs.appendChild(h('div',{style:'font-size:12px;color:var(--mut)',text:'• '+o.label+'：'+o.reason}));else if(o.note&&cur.outputs.length>1)outs.appendChild(h('div',{style:'font-size:12px;color:var(--mut)',text:'• '+o.label+'：'+o.note}))});\n box.appendChild(outs);\n if(cur.gap)box.appendChild(h('div',{'class':'todo',style:'margin-top:6px;font-size:12px',text:cur.gap}));\n box.appendChild(mtWarn(cur));\n return box}\nfunction trainWizard(host){\n var GOALS=[\n  ['lora','🧠 訓練語言模型（LoRA）','讓內建的小模型學會你的資料。需要一個 .jsonl 資料集。','需要資料集'],\n  ['blockly','🧩 積木課程','用題目資產窮舉＋判題，收成一套課。','需要題目資產'],\n  ['matrix','🔢 矩陣層','用題目資產擬合矩陣運算的範式。','需要題目資產'],\n  ['uml','📐 UML 設計','用「情境→設計」配對補強決策表與詞彙。','需要情境配對資產'],\n  ['colu','🎯 CoLU 排名','用目前的「採用／退回」回饋重訓排名模型。','不用挑資料'],\n  ['trainer','🎓 離線訓練器','把重複成功的做法升格成技能。','不用挑資料']];\n var W=host._w||(host._w={step:0,intent:'',kind:'lora',data:'',name:'',files:null,src:'asset'});\n function wantFile(k){return k==='uml'?'data/pairs.jsonl':(k==='lora'?null:'data/tasks.jsonl')}\n function needsData(k){return k!=='colu'&&k!=='trainer'}\n function steps(){if(W.intent==='update')return ['想做什麼','挑資產','要做什麼','開始'];return needsData(W.kind)?['想做什麼','目標','資料','確認','開始']:['想做什麼','目標','確認','開始']}\n function bar(){var st=steps(),cur=W.step;return h('div',{'class':'row',style:'gap:6px'},st.map(function(t,i){return h('span',{'class':'badge'+(i===cur?' ok':''),text:(i+1)+'. '+t})}))}\n function nav(back,next,nextText){var r=h('div',{'class':'row'},[]);if(back)r.appendChild(h('button',{text:'← 上一步',onclick:back}));if(next)r.appendChild(h('button',{'class':'pri',text:nextText||'下一步 →',onclick:next}));return r}\n function go(d){W.step=Math.max(0,W.step+d);draw()}\n function stepName(){return steps()[W.step]}\n async function draw(){host.textContent='';var mcur=mtGet();if(mcur&&mcur.goal==='lora'&&W.kind!=='lora'){W.kind='lora';W.step=0}if(mcur&&EXT_RUN[mcur.id]){host.appendChild(mtWarn(mcur));host.appendChild(extRunPanel(mcur));return}\n if(mcur&&mcur.status!=='done'){host.appendChild(mtWarn(mcur));host.appendChild(mtStartBtn(mcur));host.appendChild(h('div',{style:'color:var(--mut);font-size:12px',text:'要改訓練哪一種模型，請在上面的「模型類型」重新選。'}));return}host.appendChild(bar());var sn=stepName();\n  if(sn==='想做什麼'){host.appendChild(h('b',{text:'你想做什麼？'}));\n   [['train','🏋 訓練','用資料訓練出新的成果（語言模型、積木課、矩陣層、UML、CoLU…）'],['update','🔄 更新