'—'}),h('td',{text:x.peakMemBytes?fmtB(x.peakMemBytes):'—'}),h('td',{text:nc?(nc.pass?'通過':'失敗：'+(nc.failed||[]).join('、')):'—'}),h('td',{text:w.reason||x.reason||''})]))});\n tb.appendChild(t);tb.appendChild(h('div',{style:'color:var(--mut);font-size:12px',text:'狀態：'+(STZH[r.state]||r.state)+'　用時 '+Math.round(r.elapsedMs/1000)+' 秒'}));\n if(r.state==='running')pollBench.t=setTimeout(function(){pollBench(tb,bStart,bStop)},1500);else{bStart.disabled=false;bStop.disabled=true}}\nfunction symTrain(out,kind){\n var NEEDS={blockly:'題目資產（data/tasks.jsonl：{id,statement,solution,tests}）',matrix:'題目資產（data/tasks.jsonl：{id,statement,examples:[{in,out}]}）',uml:'情境與設計對資產（data/pairs.jsonl：{scenario,model}）',colu:'不需要（用目前的採用／退回回饋）',trainer:'不需要（整理目前的成功案例）'};\n var WHAT={blockly:'窮舉＋判題收成課（需要判題器：桌面版並允許執行程式）',matrix:'範式擬合（L0–L3 真演算法；L4–L6 只有窮舉、不保證）',uml:'決策表／詞彙補強（結構驗證；執行期套用見說明）',colu:'重訓排名模型（留一組交叉驗證）',trainer:'蒸餾（重複 ≥3 次的成功做法升格成技能；開始前自動快照）'};\n out.appendChild(h('div',{'class':'card'},[h('b',{text:WHAT[kind]}),h('div',{style:'color:var(--mut);font-size:12px',text:'只需處理器（cpu-js）。可暫停／繼續（同一次開啟內）；完成後寫成資產並跑評量。需要的輸入：'+NEEDS[kind]})]));\n var nm=h('input',{type:'text',placeholder:'輸出資產名稱',value:kind+'-'+new Date().toISOString().slice(0,10)}),fa=h('input',{type:'text',placeholder:'輸入資產（kind/name）',style:'width:240px',disabled:kind==='colu'||kind==='trainer'}),fo=h('input',{type:'checkbox'});\n var pick=h('select',{style:'width:260px',disabled:kind==='colu'||kind==='trainer'},[h('option',{value:'',text:'（載入可用資產…）'})]);\n if(kind!=='colu'&&kind!=='trainer')api('GET','/api/datasets').then(function(x){var want=kind==='uml'?'data/pairs.jsonl':'data/tasks.jsonl';pick.textContent='';pick.appendChild(h('option',{value:'',text:'— 從已匯入／內建的資產挑 —'}));((x&&x.files)||[]).filter(function(f){return f.path===want}).forEach(function(f){pick.appendChild(h('option',{value:f.kind+'/'+f.name,text:f.kind+'/'+f.name+(f.readonly?'（內建）':'')}))});if(pick.options.length===1)pick.options[0].text='沒有帶 '+want+' 的資產（先到「資料