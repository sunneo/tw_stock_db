:"",description:"帶溢位相加（ADX）"},{name:"crc32",format:"",description:"計算 CRC-32C"},{name:"aesenc",format:"",description:"AES 一輪加密"},{name:"aesenclast",format:"",description:"AES 最後一輪加密"},{name:"aesdec",format:"",description:"AES 一輪解密"},{name:"aesdeclast",format:"",description:"AES 最後一輪解密"},{name:"aeskeygenassist",format:"",description:"AES 金鑰擴展輔助"},{name:"aesimc",format:"",description:"AES 反向混合行"},{name:"pclmulqdq",format:"",description:"無進位乘法（GCM、CRC 用）"},{name:"sha1rnds4",format:"",description:"SHA-1 四輪"},{name:"sha256rnds2",format:"",description:"SHA-256 兩輪"},{name:"sha256msg1",format:"",description:"SHA-256 訊息排程 1"},{name:"sha256msg2",format:"",description:"SHA-256 訊息排程 2"},{name:"rdrand",format:"",description:"取硬體亂數"},{name:"rdseed",format:"",description:"取硬體種子亂數"}],concurrency:[{name:"xacquire",format:"",description:"硬體鎖省略（舊 TSX）"},{name:"xrelease",format:"",description:"硬體鎖省略釋放（舊 TSX）"},{name:"xbegin",format:"",description:"開始硬體交易（TSX）"},{name:"xend",format:"",description:"提交硬體交易（TSX）"},{name:"xabort",format:"",description:"中止硬體交易（TSX）"},{name:"monitor",format:"",description:"設定監看位址（配合 mwait）"},{name:"mwait",format:"",description:"等待監看位址被寫入"},{name:"umonitor",format:"",description:"使用者態監看位址"},{name:"umwait",format:"",description:"使用者態等待"},{name:"tpause",format:"",description:"計時暫停"}]},arm:{process_exec:[{name:"svc",format:"SVC #imm",description:"Supervisor Call - traps to EL1/kernel (AArch32's syscall instruction; also called SWI)."},{name:"swi",format:"SWI #imm",description:"Software Interrupt - pre-UAL name for SVC."}],low_level_hardware:[{name:"mcr",format:"MCR coproc, opc1, Rt, CRn, CRm, opc2",description:"Moves a register to a coprocessor register (e.g. CP15 system control)."},{name:"mrc",format:"MRC coproc, opc1, Rt, CRn, CRm, opc2",description:"Moves a coprocessor register to a general-purpose register."},{name:"mrrc",format:"MRRC coproc, opc1, Rt, Rt2, CRm",description:"Moves a 64-bit coprocessor register pair to two GP registers."},{name:"mcrr",format:"MCRR coproc, opc1, Rt, Rt2, CRm",description:"Moves two GP registers to a 64-bit coprocessor register pair."},{name:"mrs",format:"MRS Rd, <special_reg>",description:"Reads a special/status register (e.g. CPSR) into a GP register."},{name:"msr",format:"MSR <special_reg>, Rn",description:"Writes a GP register into a special/status register."},{name:"wfi",format:"WFI",description:"Wait For Interrupt - suspends execution until an interrupt/event."},{name:"wfe",format:"WFE",description:"Wait For Event - suspends execution until an event signal."},{name:"sev",format:"SEV",description:"Send Event - wakes up cores waiting via WFE."},{name:"dsb",format:"DSB <option>",description:"Data Synchronization Barrier - blocks until prior memory accesses complete."},{name:"dmb",format:"DMB <option>",description:"Data Memory Barrier - orders memory accesses across the barrier."},{name:"isb",format:"ISB <option>",description:"Instruction Synchronization Barrier - flushes the pipeline."},{name:"cps",format:"CPS #mode",description:"Change Processor State - masks/unmasks interrupts or changes mode (privileged)."},{name:"setend",format:"SETEND BE/LE",description:"Sets the endianness for data accesses."}],memory_management:[{name:"ldr",format:"LDR Rt, [Rn, #imm]",description:"Loads a 32-bit word from memory into a register."},{name:"str",format:"STR Rt, [Rn, #imm]",description:"Stores a 32-bit register value to memory."},{name:"ldm",format:"LDM Rn, {reglist}",description:"Loads multiple registers from consecutive memory."},{name:"stm",format:"STM Rn, {reglist}",description:"Stores multiple registers to consecutive memory."},{name:"ldrb",format:"LDRB Rt, [Rn, #imm]",description:"Loads an unsigned byte from memory."},{name:"strb",format:"STRB Rt, [Rn, #imm]",description:"Stores a byte to memory."},{name:"ldrh",format:"LDRH Rt, [Rn, #imm]",description:"Loads an unsigned halfword from memory."},{name:"strh",format:"STRH Rt, [Rn, #imm]",description:"Stores a halfword to memory."},{name:"ldrd",format:"LDRD Rt, Rt2, [Rn, #imm]",description:"Loads a register pair (64 bits) from memory."},{name:"strd",format:"STRD Rt, Rt2, [Rn, #imm]",description:"Stores a register pair (64 bits) to memory."},{name:"push",format:"PUSH {reglist}",description:"Pushes registers onto the stack (alias for STMDB sp!)."},{name:"pop",format:"POP {reglist}",description:"Pops registers off the stack (alias for LDMIA sp!)."},{name:"ldrsb",format:"LDRSB Rt, [Rn]",description:"Loads a byte and sign-extends it."},{name:"ldrsh",format:"LDRSH Rt, [Rn]",description:"Loads a halfword and sign-extends it."},{name:"ldrex",format:"LDREX Rt, [Rn]",description:"Load-exclusive - first half of an atomic RMW sequence."},{name:"strex",format:"STREX Rd, Rt, [Rn]",description:"Store-exclusive - second half of an atomic RMW sequence."},{name:"swp",format:"SWP Rt, Rt2, [Rn]",description:"Atomically swaps a register with memory (deprecated, pre-LDREX/STREX)."}],control_flow:[{name:"b",format:"B target",description:"Unconditional branch."},{name:"bl",format:"BL target",description:"Branch with link - saves return address in LR (function call)."},{name:"bx",format:"BX Rm",description:"Branch and exchange instruction set (ARM/Thumb) to address in Rm."},{name:"blx",format:"BLX target/Rm",description:"Branch with link and exchange instruction set."},{name:"cbz",format:"CBZ Rn, target",description:"Compare and branch if Rn is zero (Thumb-only)."},{name:"cbnz",format:"CBNZ Rn, target",description:"Compare and branch if Rn is nonzero (Thumb-only)."},{name:"beq",format:"BEQ target",description:"Branch if equal (Z=1)."},{name:"bne",format:"BNE target",description:"Branch if not equal (Z=0)."},{name:"bgt",format:"BGT target",description:"Branch if greater than (signed)."},{name:"blt",format:"BLT target",description:"Branch if less than (signed)."},{name:"bge",format:"BGE target",description:"Branch if greater or equal (signed)."},{name:"ble",format:"BLE target",description:"Branch if less or equal (signed)."},{name:"bls",format:"BLS target",description:"Branch if lower or same (unsigned <=)."},{name:"bhi",format:"BHI target",description:"Branch if higher (unsigned >)."},{name:"bpl",format:"BPL target",description:"Branch if plus (N=0)."},{name:"bmi",format:"BMI target",description:"Branch if minus/negative (N=1)."},{name:"bvs",format:"BVS target",description:"Branch if overflow set."},{name:"bvc",format:"BVC target",description:"Branch if no overflow."},{name:"bcs",format:"BCS target",description:"Branch if carry set (alias BHS, unsigned >=)."},{name:"bcc",format:"BCC target",description:"Branch if carry clear (alias BLO, unsigned <)."}],simd_vector:[{name:"vadd.i32",format:"VADD.I32 Dd, Dn, Dm",description:"NEON: add packed 32-bit integers."},{name:"vsub.i32",format:"VSUB.I32 Dd, Dn, Dm",description:"NEON: subtract packed 32-bit integers."},{name:"vmul.f32",format:"VMUL.F32 Dd, Dn, Dm",description:"NEON: multiply packed single-precision floats."},{name:"vld1.32",format:"VLD1.32 {Dd}, [Rn]",description:"NEON: load packed 32-bit elements from memory."},{name:"vst1.32",format:"VST1.32 {Dd}, [Rn]",description:"NEON: store packed 32-bit elements to memory."},{name:"vmov",format:"VMOV Dd, Dm",description:"NEON/VFP: move between vector/float registers (or GP<->float)."},{name:"vdup.32",format:"VDUP.32 Qd, Dm[x]",description:"NEON: duplicate one lane across all lanes of a vector register."},{name:"vmla.f32",format:"VMLA.F32 Dd, Dn, Dm",description:"NEON: multiply-accumulate packed single-precision floats."},{name:"vand",format:"VAND Dd, Dn, Dm",description:"NEON: bitwise AND of two vector registers."},{name:"veor",format:"VEOR Dd, Dn, Dm",description:"NEON: bitwise XOR of two vector registers."},{name:"vceq",format:"VCEQ Dd, Dn, Dm",description:"NEON: per-lane compare-equal, result is all-1s/all-0s mask."},{name:"vmax",format:"VMAX Dd, Dn, Dm",description:"NEON: per-lane maximum."}],arithmetic_logic:[{name:"add",format:"ADD Rd, Rn, Op2",description:"Rd = Rn + Op2."},{name:"adc",format:"ADC Rd, Rn, Op2",description:"Rd = Rn + Op2 + carry."},{name:"sub",format:"SUB Rd, Rn, Op2",description:"Rd = Rn - Op2."},{name:"sbc",format:"SBC Rd, Rn, Op2",description:"Rd = Rn - Op2 - NOT(carry)."},{name:"rsb",format:"RSB Rd, Rn, Op2",description:"Rd = Op2 - Rn (reverse subtract)."},{name:"mul",format:"MUL Rd, Rm, Rs",description:"Rd = Rm * Rs (low 32 bits)."},{name:"mla",format:"MLA Rd, Rm, Rs, Rn",description:"Rd = (Rm * Rs) + Rn (multiply-accumulate)."},{name:"umull",format:"UMULL RdLo, RdHi, Rm, Rs",description:"64-bit unsigned multiply: RdHi:RdLo = Rm * Rs."},{name:"smull",format:"SMULL RdLo, RdHi, Rm, Rs",description:"64-bit signed multiply: RdHi:RdLo = Rm * Rs."},{name:"and",format:"AND Rd, Rn, Op2",description:"Rd = Rn AND Op2 (bitwise)."},{name:"orr",format:"ORR Rd, Rn, Op2",description:"Rd = Rn OR Op2 (bitwise)."},{name:"eor",format:"EOR Rd, Rn, Op2",description:"Rd = Rn XOR Op2 (bitwise)."},{name:"bic",format:"BIC Rd, Rn, Op2",description:"Rd = Rn AND NOT(Op2) (bit clear)."},{name:"mvn",format:"MVN Rd, Op2",description:"Rd = NOT(Op2) (bitwise complement/move-negate)."},{name:"lsl",format:"LSL Rd, Rm, #imm",description:"Logical shift left."},{name:"lsr",format:"LSR Rd, Rm, #imm",description:"Logical shift right (zero-fill)."},{name:"asr",format:"ASR Rd, Rm, #imm",description:"Arithmetic shift right (sign-extending)."},{name:"ror",format:"ROR Rd, Rm, #imm",description:"Rotate right."},{name:"cmp",format:"CMP Rn, Op2",description:"Sets flags from Rn - Op2 (result discarded)."},{name:"cmn",format:"CMN Rn, Op2",description:"Sets flags from Rn + Op2 (result discarded)."},{name:"tst",format:"TST Rn, Op2",description:"Sets flags from Rn AND Op2 (result discarded)."},{name:"teq",format:"TEQ Rn, Op2",description:"Sets flags from Rn XOR Op2 (result discarded)."},{name:"clz",format:"CLZ Rd, Rm",description:"Counts leading zero bits in Rm."}]},aarch64:{process_exec:[{name:"svc",format:"SVC #imm",description:"Supervisor Call - AArch64's syscall trap to EL1 (Linux syscall entry)."},{name:"hvc",format:"HVC #imm",description:"Hypervisor Call - traps to EL2."},{name:"smc",format:"SMC #imm",description:"Secure Monitor Call - traps to EL3 (TrustZone)."}],low_level_hardware:[{name:"mrs",format:"MRS Xt, <system_reg>",description:"Reads a system register into a general-purpose register."},{name:"msr",format:"MSR <system_reg>, Xt",description:"Writes a general-purpose register into a system register."},{name:"wfi",format:"WFI",description:"Wait For Interrupt - suspends execution."},{name:"wfe",format:"WFE",description:"Wait For Event - suspends execution until an event."},{name:"sev",format:"SEV",description:"Send Event to all cores waiting via WFE."},{name:"sevl",format:"SEVL",description:"Send Event Local - sets the local event register."},{name:"dsb",format:"DSB <option>",description:"Data Synchronization Barrier."},{name:"dmb",format:"DMB <option>",description:"Data Memory Barrier."},{name:"isb",format:"ISB <option>",description:"Instruction Synchronization Barrier."},{name:"ic",format:"IC <op>, Xt",description:"Instruction Cache maintenance operation."},{name:"tlbi",format:"TLBI <op>, Xt",description:"TLB Invalidate operation."}],memory_management:[{name:"ldr",format:"LDR Xt, [Xn, #imm]",description:"Loads a register from memory."},{name:"str",format:"STR Xt, [Xn, #imm]",description:"Stores a register to memory."},{name:"ldp",format:"LDP Xt1, Xt2, [Xn, #imm]",description:"Loads a pair of registers from memory."},{name:"stp",format:"STP Xt1, Xt2, [Xn, #imm]",description:"Stores a pair of registers to memory."},{name:"ldrb",format:"LDRB Wt, [Xn, #imm]",description:"Loads an unsigned byte from memory."},{name:"strb",format:"STRB Wt, [Xn, #imm]",description:"Stores a byte to memory."},{name:"ldrh",format:"LDRH Wt, [Xn, #imm]",description:"Loads an unsigned halfword from memory."},{name:"strh",format:"STRH Wt, [Xn, #imm]",description:"Stores a halfword to memory."},{name:"ldur",format:"LDUR Xt, [Xn, #simm]",description:"Loads a register using an unscaled immediate offset."},{name:"stur",format:"STUR Xt, [Xn, #simm]",description:"Stores a register using an unscaled immediate offset."},{name:"ldxr",format:"LDXR Xt, [Xn]",description:"Load-exclusive - first half of an atomic RMW sequence."},{name:"stxr",format:"STXR Ws, Xt, [Xn]",description:"Store-exclusive - second half of an atomic RMW sequence."},{name:"ldar",format:"LDAR Xt, [Xn]",description:"Load-acquire - an atomic load with acquire ordering semantics."},{name:"stlr",format:"STLR Xt, [Xn]",description:"Store-release - an atomic store with release ordering semantics."},{name:"cas",format:"CAS Xs, Xt, [Xn]",description:"Compare-And-Swap (ARMv8.1 atomics) - single-instruction atomic RMW."},{name:"ldadd",format:"LDADD Xs, Xt, [Xn]",description:"Atomic add to memory, returns the old value (ARMv8.1 atomics)."}],control_flow:[{name:"b",format:"B target",description:"Unconditional branch."},{name:"bl",format:"BL target",description:"Branch with link (function call), saves return address in X30/LR."},{name:"br",format:"BR Xn",description:"Branch to address in register Xn."},{name:"blr",format:"BLR Xn",description:"Branch with link to address in register Xn."},{name:"ret",format:"RET {Xn}",description:"Return - branches to X30 (or Xn if given)."},{name:"cbz",format:"CBZ Xt, target",description:"Compare and branch if Xt is zero."},{name:"cbnz",format:"CBNZ Xt, target",description:"Compare and branch if Xt is nonzero."},{name:"beq",format:"B.EQ target",description:"Branch if equal (Z=1)."},{name:"bne",format:"B.NE target",description:"Branch if not equal (Z=0)."},{name:"tbz",format:"TBZ Xt, #bit, target",description:"Test bit and branch if zero."},{name:"tbnz",format:"TBNZ Xt, #bit, target",description:"Test bit and branch if nonzero."},{name:"b.gt",format:"B.GT target",description:"Branch if greater than (signed)."},{name:"b.lt",format:"B.LT target",description:"Branch if less than (signed)."},{name:"b.ge",format:"B.GE target",description:"Branch if greater or equal (signed)."},{name:"b.le",format:"B.LE target",description:"Branch if less or equal (signed)."},{name:"b.hi",format:"B.HI target",description:"Branch if higher (unsigned >)."},{name:"b.lo",format:"B.LO target",description:"Branch if lower (unsigned <)."},{name:"csel",format:"CSEL Xd, Xn, Xm, cond",description:"Conditional select: Xd = cond ? Xn : Xm (branchless)."},{name:"cset",format:"CSET Xd, cond",description:"Sets Xd to 1 if cond is true, else 0 (branchless)."}],simd_vector:[{name:"fadd",format:"FADD Vd, Vn, Vm",description:"Adds packed or scalar floating-point values."},{name:"fmul",format:"FMUL Vd, Vn, Vm",description:"Multiplies packed or scalar floating-point values."},{name:"fsub",format:"FSUB Vd, Vn, Vm",description:"Subtracts packed or scalar floating-point values."},{name:"fdiv",format:"FDIV Vd, Vn, Vm",description:"Divides packed or scalar floating-point values."},{name:"ld1",format:"LD1 {Vt.T}, [Xn]",description:"NEON: loads one or more vector registers from memory."},{name:"st1",format:"ST1 {Vt.T}, [Xn]",description:"NEON: stores one or more vector registers to memory."},{name:"dup",format:"DUP Vd.T, Vn.T[x]",description:"NEON: duplicates one lane across an entire vector register."},{name:"fmla",format:"FMLA Vd, Vn, Vm",description:"Floating-point fused multiply-accumulate."},{name:"fmov",format:"FMOV Vd, Vn",description:"Moves a value between floating-point/vector registers (or GP<->float)."},{name:"fcmp",format:"FCMP Sn, Sm",description:"Compares two floating-point values, sets flags."},{name:"fneg",format:"FNEG Vd, Vn",description:"Negates a floating-point value."},{name:"fabs",format:"FABS Vd, Vn",description:"Absolute value of a floating-point value."},{name:"fmax",format:"FMAX Vd, Vn, Vm",description:"Per-lane floating-point maximum."},{name:"fmin",format:"FMIN Vd, Vn, Vm",description:"Per-lane floating-point minimum."}],arithmetic_logic:[{name:"add",format:"ADD Xd, Xn, Xm",description:"Xd = Xn + Xm."},{name:"adds",format:"ADDS Xd, Xn, Xm",description:"Xd = Xn + Xm, updates NZCV flags."},{name:"sub",format:"SUB Xd, Xn, Xm",description:"Xd = Xn - Xm."},{name:"subs",format:"SUBS Xd, Xn, Xm",description:"Xd = Xn - Xm, updates NZCV flags (also CMP's underlying op)."},{name:"mul",format:"MUL Xd, Xn, Xm",description:"Xd = Xn * Xm (low bits)."},{name:"madd",format:"MADD Xd, Xn, Xm, Xa",description:"Xd = Xa + (Xn * Xm) (multiply-add)."},{name:"msub",format:"MSUB Xd, Xn, Xm, Xa",description:"Xd = Xa - (Xn * Xm) (multiply-subtract)."},{name:"sdiv",format:"SDIV Xd, Xn, Xm",description:"Signed division: Xd = Xn / Xm."},{name:"udiv",format:"UDIV Xd, Xn, Xm",description:"Unsigned division: Xd = Xn / Xm."},{name:"and",format:"AND Xd, Xn, Xm",description:"Xd = Xn AND Xm."},{name:"orr",format:"ORR Xd, Xn, Xm",description:"Xd = Xn OR Xm."},{name:"eor",format:"EOR Xd, Xn, Xm",description:"Xd = Xn XOR Xm."},{name:"bic",format:"BIC Xd, Xn, Xm",description:"Xd = Xn AND NOT(Xm)."},{name:"mvn",format:"MVN Xd, Xm",description:"Xd = NOT(Xm)."},{name:"lsl",format:"LSL Xd, Xn, #imm",description:"Logical shift left."},{name:"lsr",format:"LSR Xd, Xn, #imm",description:"Logical shift right."},{name:"asr",format:"ASR Xd, Xn, #imm",description:"Arithmetic shift right."},{name:"cmp",format:"CMP Xn, Xm",description:"Sets flags from Xn - Xm (alias of SUBS with discarded result)."},{name:"cmn",format:"CMN Xn, Xm",description:"Sets flags from Xn + Xm (alias of ADDS with discarded result)."},{name:"tst",format:"TST Xn, Xm",description:"Sets flags from Xn AND Xm (alias of ANDS with discarded result)."},{name:"neg",format:"NEG Xd, Xm",description:"Xd = -Xm (two's complement negate)."},{name:"clz",format:"CLZ Xd, Xn",description:"Counts leading zero bits."},{name:"rbit",format:"RBIT Xd, Xn",description:"Reverses the bit order."},{name:"rev",format:"REV Xd, Xn",description:"Reverses byte order (endianness swap)."}]},power:{process_exec:[{name:"sc",format:"SC",description:"System Call - traps to the kernel (PowerPC's syscall instruction)."}],low_level_hardware:[{name:"mtspr",format:"MTSPR spr, Rs",description:"Moves a general-purpose register to a special-purpose register."},{name:"mfspr",format:"MFSPR Rt, spr",description:"Moves a special-purpose register to a general-purpose register."},{name:"mtmsr",format:"MTMSR Rs",description:"Moves a register into the Machine State Register (32-bit)."},{name:"mfmsr",format:"MFMSR Rt",description:"Reads the Machine State Register into a register."},{name:"mtmsrd",format:"MTMSRD Rs",description:"Moves a register into the Machine State Register (64-bit)."},{name:"eieio",format:"EIEIO",description:"Enforces in-order execution of I/O - a memory-ordering barrier for MMIO."},{name:"sync",format:"SYNC",description:"Heavyweight memory synchronization barrier."},{name:"isync",format:"ISYNC",description:"Instruction synchronization - flushes the pipeline."},{name:"lwsync",format:"LWSYNC",description:"Lightweight (acquire/release) memory synchronization barrier."},{name:"dcbf",format:"DCBF Ra, Rb",description:"Data Cache Block Flush - writes back and invalidates a cache line."},{name:"dcbi",format:"DCBI Ra, Rb",description:"Data Cache Block Invalidate (privileged, no writeback)."},{name:"icbi",format:"ICBI Ra, Rb",description:"Instruction Cache Block Invalidate."}],memory_management:[{name:"lwz",format:"LWZ Rt, d(Ra)",description:"Load Word and Zero from memory."},{name:"stw",format:"STW Rs, d(Ra)",description:"Store Word to memory."},{name:"lbz",format:"LBZ Rt, d(Ra)",description:"Load Byte and Zero from memory."},{name:"stb",format:"STB Rs, d(Ra)",description:"Store Byte to memory."},{name:"lhz",format:"LHZ Rt, d(Ra)",description:"Load Halfword and Zero from memory."},{name:"sth",format:"STH Rs, d(Ra)",description:"Store Halfword to memory."},{name:"lwzu",format:"LWZU Rt, d(Ra)",description:"Load Word and Zero, updating Ra with the effective address."},{name:"stwu",format:"STWU Rs, d(Ra)",description:"Store Word, updating Ra with the effective address."},{name:"ld",format:"LD Rt, ds(Ra)",description:"Load Doubleword (64-bit) from memory."},{name:"std",format:"STD Rs, ds(Ra)",description:"Store Doubleword (64-bit) to memory."},{name:"lwarx",format:"LWARX Rt, Ra, Rb",description:"Load Word And Reserve Indexed - first half of an atomic RMW."},{name:"stwcx",format:"STWCX. Rs, Ra, Rb",description:"Store Word Conditional Indexed - second half of an atomic RMW."}],control_flow:[{name:"b",format:"B target",description:"Unconditional branch."},{name:"ba",format:"BA target",description:"Branch absolute."},{name:"bl",format:"BL target",description:"Branch and link (function call), saves return address in LR."},{name:"bla",format:"BLA target",description:"Branch and link absolute."},{name:"bc",format:"BC BO, BI, target",description:"Branch conditional on the condition register/count register."},{name:"bcl",format:"BCL BO, BI, target",description:"Branch conditional and link."},{name:"blr",format:"BLR",description:"Branch to the address in the Link Register (function return)."},{name:"bctr",format:"BCTR",description:"Branch to the address in the Count Register."},{name:"bctrl",format:"BCTRL",description:"Branch to the Count Register and link (indirect call)."}],simd_vector:[{name:"vaddubm",format:"VADDUBM Vd, Va, Vb",description:"AltiVec: add unsigned byte modulo (packed byte add)."},{name:"vadduwm",format:"VADDUWM Vd, Va, Vb",description:"AltiVec: add unsigned word modulo (packed 32-bit add)."},{name:"vsububm",format:"VSUBUBM Vd, Va, Vb",description:"AltiVec: subtract unsigned byte modulo."},{name:"vmuluwm",format:"VMULUWM Vd, Va, Vb",description:"AltiVec: multiply unsigned word modulo."},{name:"lvx",format:"LVX Vt, Ra, Rb",description:"AltiVec: loads a 128-bit vector register from memory."},{name:"stvx",format:"STVX Vs, Ra, Rb",description:"AltiVec: stores a 128-bit vector register to memory."},{name:"vperm",format:"VPERM Vd, Va, Vb, Vc",description:"AltiVec: byte-wise permute of two vectors using a control vector."},{name:"vxor",format:"VXOR Vd, Va, Vb",description:"AltiVec: bitwise XOR of two vector registers."}],arithmetic_logic:[{name:"add",format:"ADD rd, ra, rb",description:"rd = ra + rb."},{name:"addi",format:"ADDI rd, ra, imm",description:"rd = ra + imm (also the LI idiom when ra=r0)."},{name:"subf",format:"SUBF rd, ra, rb",description:"rd = rb - ra (note reversed operand order)."},{name:"mullw",format:"MULLW rd, ra, rb",description:"rd = low 32 bits of ra * rb."},{name:"divw",format:"DIVW rd, ra, rb",description:"Signed 32-bit division."},{name:"and",format:"AND rd, ra, rb",description:"rd = ra AND rb."},{name:"or",format:"OR rd, ra, rb",description:"rd = ra OR rb (also the MR register-copy idiom: or rd,ra,ra)."},{name:"xor",format:"XOR rd, ra, rb",description:"rd = ra XOR rb."},{name:"nand",format:"NAND rd, ra, rb",description:"rd = NOT(ra AND rb)."},{name:"slw",format:"SLW rd, ra, rb",description:"Shift left word."},{name:"srw",format:"SRW rd, ra, rb",description:"Shift right word (logical)."},{name:"sraw",format:"SRAW rd, ra, rb",description:"Shift right word arithmetic."},{name:"cmpw",format:"CMPW ra, rb",description:"Compares two words, sets a condition register field."}]},mips:{process_exec:[{name:"syscall",format:"SYSCALL",description:"System Call - traps to the kernel."},{name:"break",format:"BREAK",description:"Breakpoint trap (debugger exception)."}],low_level_hardware:[{name:"mtc0",format:"MTC0 Rt, Rd",description:"Moves a GP register to a Coprocessor 0 (system control) register."},{name:"mfc0",format:"MFC0 Rt, Rd",description:"Moves a Coprocessor 0 register to a GP register."},{name:"mtc1",format:"MTC1 Rt, Fs",description:"Moves a GP register to an FPU (Coprocessor 1) register."},{name:"mfc1",format:"MFC1 Rt, Fs",description:"Moves an FPU register to a GP register."},{name:"eret",format:"ERET",description:"Exception return - restores state and resumes from an exception handler."},{name:"sync",format:"SYNC",description:"Memory ordering barrier."},{name:"cache",format:"CACHE op, offset(base)",description:"Performs a cache maintenance operation."}],memory_management:[{name:"lw",format:"LW Rt, offset(Rs)",description:"Load Word from memory."},{name:"sw",format:"SW Rt, offset(Rs)",description:"Store Word to memory."},{name:"lb",format:"LB Rt, offset(Rs)",description:"Load Byte (sign-extended) from memory."},{name:"sb",format:"SB Rt, offset(Rs)",description:"Store Byte to memory."},{name:"lh",format:"LH Rt, offset(Rs)",description:"Load Halfword (sign-extended) from memory."},{name:"sh",format:"SH Rt, offset(Rs)",description:"Store Halfword to memory."},{name:"lui",format:"LUI Rt, imm",description:"Load Upper Immediate - sets the high 16 bits of a register."},{name:"la",format:"LA Rt, label",description:"Load Address pseudo-instruction (assembles to LUI+ORI/ADDIU)."},{name:"ld",format:"LD Rt, offset(Rs)",description:"Load Doubleword (64-bit, MIPS64)."},{name:"sd",format:"SD Rt, offset(Rs)",description:"Store Doubleword (64-bit, MIPS64)."},{name:"lwu",format:"LWU Rt, offset(Rs)",description:"Load Word Unsigned (zero-extended, MIPS64)."}],control_flow:[{name:"j",format:"J target",description:"Unconditional jump."},{name:"jal",format:"JAL target",description:"Jump and link (function call), saves return address in $ra."},{name:"jr",format:"JR Rs",description:"Jump to the address in register Rs."},{name:"jalr",format:"JALR Rd, Rs",description:"Jump and link register (indirect call)."},{name:"beq",format:"BEQ Rs, Rt, target",description:"Branch if Rs equals Rt."},{name:"bne",format:"BNE Rs, Rt, target",description:"Branch if Rs does not equal Rt."},{name:"beqz",format:"BEQZ Rs, target",description:"Branch if Rs equals zero."},{name:"bnez",format:"BNEZ Rs, target",description:"Branch if Rs is nonzero."},{name:"bgez",format:"BGEZ Rs, target",description:"Branch if Rs is greater than or equal to zero."},{name:"bltz",format:"BLTZ Rs, target",description:"Branch if Rs is less than zero."},{name:"b",format:"B target",description:"Unconditional branch pseudo-instruction (assembles to BEQ $zero,$zero)."}],simd_vector:[{name:"addv.b",format:"ADDV.B Wd, Ws, Wt",description:"MSA: add packed bytes."},{name:"addv.h",format:"ADDV.H Wd, Ws, Wt",description:"MSA: add packed halfwords."},{name:"addv.w",format:"ADDV.W Wd, Ws, Wt",description:"MSA: add packed words."},{name:"subv.b",format:"SUBV.B Wd, Ws, Wt",description:"MSA: subtract packed bytes."},{name:"ld.b",format:"LD.B Wd, offset(Rs)",description:"MSA: loads a vector register with byte elements."},{name:"st.b",format:"ST.B Wd, offset(Rs)",description:"MSA: stores a vector register's byte elements."},{name:"ld.w",format:"LD.W Wd, offset(Rs)",description:"MSA: loads a vector register with word elements."},{name:"st.w",format:"ST.W Wd, offset(Rs)",description:"MSA: stores a vector register's word elements."}],arithmetic_logic:[{name:"add",format:"ADD rd, rs, rt",description:"rd = rs + rt (trapping on overflow)."},{name:"addu",format:"ADDU rd, rs, rt",description:"rd = rs + rt (no overflow trap - the common one)."},{name:"addiu",format:"ADDIU rd, rs, imm",description:"rd = rs + imm (also the MOVE/LI idiom)."},{name:"sub",format:"SUB rd, rs, rt",description:"rd = rs - rt (trapping on overflow)."},{name:"subu",format:"SUBU rd, rs, rt",description:"rd = rs - rt (no overflow trap)."},{name:"mult",format:"MULT rs, rt",description:"Signed multiply into HI:LO."},{name:"div",format:"DIV rs, rt",description:"Signed divide: LO=quotient, HI=remainder."},{name:"and",format:"AND rd, rs, rt",description:"rd = rs AND rt."},{name:"or",format:"OR rd, rs, rt",description:"rd = rs OR rt (also the MOVE idiom: or rd,rs,$zero)."},{name:"xor",format:"XOR rd, rs, rt",description:"rd = rs XOR rt."},{name:"nor",format:"NOR rd, rs, rt",description:"rd = NOT(rs OR rt) (also the NOT idiom: nor rd,rs,$zero)."},{name:"sll",format:"SLL rd, rt, shamt",description:"Shift left logical (also the classic NOP: sll $zero,$zero,0)."},{name:"srl",format:"SRL rd, rt, shamt",description:"Shift right logical."},{name:"sra",format:"SRA rd, rt, shamt",description:"Shift right arithmetic."},{name:"slt",format:"SLT rd, rs, rt",description:"rd = (rs < rt) ? 1 : 0, signed."},{name:"sltu",format:"SLTU rd, rs, rt",description:"rd = (rs < rt) ? 1 : 0, unsigned."}]},riscv:{process_exec:[{name:"ecall",format:"ECALL",description:"Environment Call - traps to the next-higher privilege level (Linux syscall entry)."},{name:"ebreak",format:"EBREAK",description:"Breakpoint trap (debugger exception)."}],low_level_hardware:[{name:"csrrw",format:"CSRRW rd, csr, rs1",description:"Atomically swaps a CSR with a GP register."},{name:"csrrs",format:"CSRRS rd, csr, rs1",description:"Atomically sets bits in a CSR using a GP register as a mask."},{name:"csrrc",format:"CSRRC rd, csr, rs1",description:"Atomically clears bits in a CSR using a GP register as a mask."},{name:"csrrwi",format:"CSRRWI rd, csr, imm",description:"CSRRW with a 5-bit immediate instead of a register."},{name:"csrrsi",format:"CSRRSI rd, csr, imm",description:"CSRRS with a 5-bit immediate instead of a register."},{name:"csrrci",format:"CSRRCI rd, csr, imm",description:"CSRRC with a 5-bit immediate instead of a register."},{name:"fence",format:"FENCE pred, succ",description:"Orders memory accesses between the pred and succ sets."},{name:"fence.i",format:"FENCE.I",description:"Synchronizes the instruction and data streams (for self-modifying code)."},{name:"wfi",format:"WFI",description:"Wait For Interrupt - hints the hart may stall until an interrupt."}],memory_management:[{name:"lw",format:"LW rd, offset(rs1)",description:"Load Word from memory."},{name:"sw",format:"SW rs2, offset(rs1)",description:"Store Word to memory."},{name:"lb",format:"LB rd, offset(rs1)",description:"Load Byte (sign-extended) from memory."},{name:"sb",format:"SB rs2, offset(rs1)",description:"Store Byte to memory."},{name:"lh",format:"LH rd, offset(rs1)",description:"Load Halfword (sign-extended) from memory."},{name:"sh",format:"SH rs2, offset(rs1)",description:"Store Halfword to memory."},{name:"ld",format:"LD rd, offset(rs1)",description:"Load Doubleword (RV64)."},{name:"sd",format:"SD rs2, offset(rs1)",description:"Store Doubleword (RV64)."},{name:"la",format:"LA rd, symbol",description:"Load Address pseudo-instruction."},{name:"li",format:"LI rd, imm",description:"Load Immediate pseudo-instruction."},{name:"lbu",format:"LBU rd, offset(rs1)",description:"Load Byte Unsigned (zero-extended)."},{name:"lhu",format:"LHU rd, offset(rs1)",description:"Load Halfword Unsigned (zero-extended)."},{name:"lwu",format:"LWU rd, offset(rs1)",description:"Load Word Unsigned (zero-extended, RV64)."},{name:"flw",format:"FLW rd, offset(rs1)",description:"Loads a single-precision float (F extension)."},{name:"fsw",format:"FSW rs2, offset(rs1)",description:"Stores a single-precision float (F extension)."},{name:"fld",format:"FLD rd, offset(rs1)",description:"Loads a double-precision float (D extension)."},{name:"fsd",format:"FSD rs2, offset(rs1)",description:"Stores a double-precision float (D extension)."},{name:"lr.w",format:"LR.W rd, (rs1)",description:"Load-Reserved - first half of an atomic RMW sequence (A extension)."},{name:"sc.w",format:"SC.W rd, rs2, (rs1)",description:"Store-Conditional - second half of an atomic RMW sequence (A extension)."},{name:"amoadd.w",format:"AMOADD.W rd, rs2, (rs1)",description:"Atomic memory add, returns the old value (A extension)."},{name:"amoswap.w",format:"AMOSWAP.W rd, rs2, (rs1)",description:"Atomic memory swap (A extension)."}],control_flow:[{name:"beq",format:"BEQ rs1, rs2, target",description:"Branch if rs1 equals rs2."},{name:"bne",format:"BNE rs1, rs2, target",description:"Branch if rs1 does not equal rs2."},{name:"blt",format:"BLT rs1, rs2, target",description:"Branch if rs1 < rs2 (signed)."},{name:"bge",format:"BGE rs1, rs2, target",description:"Branch if rs1 >= rs2 (signed)."},{name:"bltu",format:"BLTU rs1, rs2, target",description:"Branch if rs1 < rs2 (unsigned)."},{name:"bgeu",format:"BGEU rs1