p:46px;left:8px;z-index:60;width:min(460px,92vw);max-height:62vh;overflow:auto;background:var(--bg);border:1px solid var(--bd);border-radius:8px;box-shadow:0 6px 22px rgba(0,0,0,.25);padding:4px;display:none}\n#navp .nh{display:flex;align-items:center;gap:8px;padding:4px 8px;color:var(--mut);font-size:12px}#navp .nh b{flex:1}\n#navp a{display:flex;gap:8px;align-items:baseline;padding:4px 8px;border-radius:5px;cursor:pointer;color:var(--fg);word-break:break-all;text-decoration:none}#navp a:hover{background:var(--sf)}\n#navp a.cur{background:var(--hl);font-weight:600}#navp a.fail{color:var(--er)}#navp a .ix{color:var(--mut);font-size:11px;min-width:22px;text-align:right}\n#load{padding:30px;text-align:center;color:var(--mut)}#bar{height:6px;background:var(--bd);border-radius:3px;margin:10px auto;max-width:420px;overflow:hidden}#bar i{display:block;height:100%;width:0;background:var(--ac)}\n#app{flex:1;display:flex;min-height:0}\n.pane{display:none;flex:1;min-height:0}.pane.on{display:flex}\n.side{width:330px;max-width:42vw;border-right:1px solid var(--bd);display:flex;flex-direction:column;background:var(--sf);min-height:0}\n.side input,.side select{margin:8px 10px 0;padding:7px 9px;border:1px solid var(--bd);border-radius:6px;background:var(--bg);color:var(--fg);font-size:13px}\n.list{flex:1;overflow:auto;padding:8px 6px 14px}\n.list a,.list summary{display:block;padding:3px 8px;border-radius:5px;color:var(--fg);text-decoration:none;cursor:pointer;word-break:break-all}\n.list a:hover,.list summary:hover{background:var(--bd)}.list .k{color:var(--mut);font-size:12px;margin-left:6px}.list details>div{margin-left:12px}\n.main{flex:1;overflow:auto;padding:16px 26px 70px;min-width:0}\nh1.t{font-size:20px;margin:0 0 8px;word-break:break-all}h1,h2,h3{line-height:1.3}h2{font-size:16px;margin:20px 0 6px;border-bottom:1px solid var(--bd);padding-bottom:4px}h3{font-size:14px;margin:14px 0 4px}\n.mut{color:var(--mut)}code,pre,textarea{font-family:ui-monospace,Consolas,monospace;font-size:12.5px}pre{background:var(--sf);border:1px solid var(--bd);border-radius:6px;padding:8px 10px;overflow:auto;margin:6px 0}\n:not(pre)>code{background:var(--sf);border:1px solid var(--bd);border-radius:4px;padding:0 4px}\na.l,.md a{color:var(--ac);cursor:pointer;text-decoration:none}a.l:hover,.md a:hover{text-decoration:underline}\ntable{border-collapse:collapse;width:100%;margin:6px 0}td,th{border-bottom:1px solid var(--bd);padding:4px 8px;text-align:left;vertical-align:top;word-break:break-word}th{background:var(--sf);position:sticky;top:0}\n.tag{display:inline-block;padding:0 7px;border-radius:10px;background:var(--sf);border:1px solid var(--bd);font-size:12px;color:var(--mut);margin-right:4px}\n.note{background:var(--hl);border-radius:6px;padding:6px 10px;margin:8px 0;white-space:pre-wrap}.err{color:var(--er);white-space:pre-wrap}\n.md ul,.md ol{padding-left:22px}.md blockquote{border-left:3px solid var(--bd);margin:6px 0;padding:0 10px;color:var(--mut)}\nsvg.dg{max-width:100%;height:auto;background:var(--sf);border:1px solid var(--bd);border-radius:6px;margin:6px 0}svg.dg text{fill:var(--fg);font:12px sans-serif}svg.dg rect{fill:var(--bg);stroke:var(--ac)}svg.dg path{stroke:var(--mut);fill:none}\n.ask{display:flex;gap:8px}.ask input{flex:1;padding:9px 11px;border:1px solid var(--bd);border-radius:6px;background:var(--bg);color:var(--fg);font-size:14px}\nbutton.b{padding:7px 14px;border:1px solid var(--ac);background:var(--ac);color:#fff;border-radius:6px;cursor:pointer}button.b.s{background:var(--bg);color:var(--ac)}\n.chips{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}.chips span{padding:2px 9px;border:1px solid var(--bd);border-radius:12px;cursor:pointer;font-size:12px;color:var(--mut)}.chips span:hover{border-color:var(--ac);color:var(--ac)}\n.qa{border:1px solid var(--bd);border-radius:8px;padding:10px 14px;margin:12px 0}.qa .q{font-weight:600;margin-bottom:4px}\ntextarea{width:100%;min-height:110px;padding:8px;border:1px solid var(--bd);border-radius:6px;background:var(--bg);color:var(--fg);resize:vertical}\n.res{overflow:auto;max-height:60vh;border:1px solid var(--bd);border-radius:6px;margin-top:8px}\n#panes{flex:1;display:flex;min-width:0;min-height:0}\n#dock{display:flex;flex-direction:column;min-width:0;min-height:0;background:var(--bg);overflow:auto;padding:10px 16px 40px;flex:none}\n#dock .dh{display:flex;align-items:center;gap:8px;margin-bottom:4px}#dock .dh h1{margin:0;font-size:16px;flex:1}\n#dock .dh select,#dock .dh button{padding:2px 6px;border:1px solid var(--bd);border-radius:5px;background:var(--bg);color:var(--fg);font-size:12px;cursor:pointer}\n#split{flex:none;background:var(--bd);opacity:.6}#split:hover,#split.on{background:var(--ac);opacity:1}\n#app[data-dock=right]{flex-direction:row}#app[data-dock=right] #dock{width:var(--dw,380px)}#app[data-dock=right] #split{width:5px;cursor:col-resize}\n#app[data-dock=bottom]{flex-direction:column}#app[data-dock=top]{flex-direction:column-reverse}\n#app[data-dock=bottom] #dock,#app[data-dock=top] #dock{height:var(--dh,300px)}#app[data-dock=bottom] #split,#app[data-dock=top] #split{height:5px;cursor:row-resize}\n#app.nodock #dock,#app.nodock #split{display:none}\n#fapst{cursor:pointer;color:var(--mut);font-size:12px;border:1px dashed var(--bd);border-radius:10px;padding:0 8px}#fapst.ok{color:var(--ok);border-color:var(--ok)}#fapst:hover{border-color:var(--ac)}\na.src{cursor:pointer;text-decoration:none;margin-left:3px;font-size:12px}a.src:hover{filter:brightness(1.3)}\n.ned{margin:8px 0}.ned textarea{min-height:64px}.ned .ns{font-size:12px;color:var(--mut);margin-left:8px}\n#srcv{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;z-index:50}#srcv[hidden]{display:none}\n.sv-box{width:min(1150px,95vw);height:90vh;background:var(--bg);border:1px solid var(--bd);border-radius:10px;display:flex;flex-direction:column;overflow:hidden}\n.sv-bar{display:flex;gap:8px;align-items:center;padding:8px 12px;border-bottom:1px solid var(--bd);background:var(--sf)}.sv-bar b{word-break:break-all}\n#sv-c{flex:1;min-height:0;width:100%;display:block;background:#0d1117}\n@media (max-width:720px){.pane.on{flex-direction:column}.side{width:100%;max-width:none;height:40vh}.main{padding:12px}}\n</style></head><body>\n<header><button class=\"nvb\" id=\"navB\" title=\"上一個位置（Alt+←、滑鼠上一頁鍵）\" disabled>◀</button><button class=\"nvb\" id=\"navF\" title=\"下一個位置（Alt+→、滑鼠下一頁鍵）\" disabled>▶</button><button class=\"nvb\" id=\"navH\" title=\"瀏覽歷史（像 call stack：最新在最上面，點一下跳回去）\">🕘</button><h1 id=\"ttl\"></h1><span class=\"st\" id=\"stat\"></span><span id=\"fapst\" title=\"讀原始碼與讀寫說明需要先授權專案資料夾\"></span><nav id=\"nav\"></nav></header>\n<div id=\"load\"><div id=\"lmsg\">載入中…</div><div id=\"bar\"><i id=\"barfill\"></i></div></div>\n<div id=\"app\" style=\"display:none\" data-dock=\"right\"><div id=\"panes\">\n<section class=\"pane\" id=\"p-wiki\"><div class=\"side\"><input id=\"wq\" placeholder=\"搜尋頁面…\"><div class=\"list\" id=\"wl\"></div></div><div class=\"main\" id=\"wm\"></div></section>\n<section class=\"pane\" id=\"p-files\"><div class=\"side\"><input id=\"fq\" placeholder=\"搜尋檔案路徑…\"><div class=\"list\" id=\"fl\"></div></div><div class=\"main\" id=\"fm\"></div></section>\n<section class=\"pane\" id=\"p-syms\"><div class=\"side\"><input id=\"sq\" placeholder=\"搜尋函式／類別名稱或說明…\"><select id=\"sk\"><option value=\"\">所有種類</option></select><div class=\"list\" id=\"sl\"></div></div><div class=\"main\" id=\"sm\"></div></section>\n\n<section class=\"pane\" id=\"p-sql\"><div class=\"main\" id=\"qm\" style=\"max-width:1100px\">\n<h1 class=\"t\">SQL 查詢（內嵌 SQLite）</h1>\n<div class=\"mut\">資料表：files、symbols、imports（src→dst，檔案之間的引用）、uses（file_id 呼叫了 symbol_id）、pages、glossary、meta；檢視：v_symbols、v_imports、v_uses。id 是序號（從0開始）。Ctrl+Enter 執行。</div>\n<div style=\"margin:8px 0\"><select id=\"qex\"></select></div>\n<textarea id=\"qsql\" spellcheck=\"false\"></textarea>\n<div style=\"margin:8px 0;display:flex;gap:8px;align-items:center\"><button class=\"b\" id=\"qrun\">執行</button><button class=\"b s\" id=\"qcsv\">下載CSV</button><span class=\"mut\" id=\"qinfo\"></span></div>\n<div class=\"res\" id=\"qres\"></div>\n<details style=\"margin-top:12px\"><summary class=\"mut\">資料表結構</summary><pre id=\"qschema\"></pre></details></div></section>\n</div><div id=\"split\" title=\"拖曳調整大小，雙擊還原\"></div>\n<aside id=\"dock\">\n<div class=\"dh\"><h1>問答（離線，不需要網路或AI）</h1><select id=\"dockpos\" title=\"停靠位置\"><option value=\"right\">靠右</option><option value=\"bottom\">靠下</option><option value=\"top\">靠上</option></select><button id=\"dockx\" title=\"收起\">✕</button></div>\n<label class=\"mut\" style=\"font-size:12px\" id=\"aimlab\" title=\"「🧠 解釋」查到事實後，是否再用離線文字模型把它寫成一句話（第一次要下載模型；關掉就只用程式組出的說明）\"><input type=\"checkbox\" id=\"aimodel\"> 解釋時用離線模型潤飾</label>\n<div class=\"mut\">依索引裡的定義、註解、依賴與呼叫關係回答。中英文都可以，函式名稱請照原樣寫。</div>\n<div class=\"ask\" style=\"margin-top:10px\"><input id=\"aq\" placeholder=\"例如：parse_config 是做什麼的？／誰用到 Logger？\"><button class=\"b\" id=\"ago\">問</button></div>\n<div class=\"chips\" id=\"achips\"></div><div id=\"aout\"></div>\n</aside></div>\n<div id=\"srcv\" hidden><div class=\"sv-box\"><div class=\"sv-bar\"><b id=\"sv-t\"></b><span class=\"mut\" id=\"sv-s\"></span><span style=\"flex:1\"></span><button class=\"b s\" id=\"sv-pick\" hidden>選擇專案資料夾</button><button class=\"b s\" id=\"sv-x\">✕ 關閉（Esc）</button></div><div id=\"sv-msg\" class=\"note\" style=\"margin:8px 12px\" hidden></div><canvas id=\"sv-c\"></canvas></div></div>\n<script id=\"cfg\" type=\"application/json\">__CFG__<\/script>\n<script id=\"payload\" type=\"application/json\">__PAYLOAD__<\/script>\n<script id=\"aipack\" type=\"application/json\">__AIPACK__<\/script>\n<script>\n__DECKCODE__\n<\/script>\n<script>\n__WASMENGINE__\n<\/script>\n<script>\n__RUNTIME__\n<\/script>\n<script>\n(function(){\nvar CFG=JSON.parse(document.getElementById('cfg').textContent);\nvar DB=null,IX=null,SQLDB=null,SQLJS=null,PAGES=[],GLOSS={},fileMap={},LASTCOLS=[],LASTROWS=[],CURF=null,CURS=null;\nfunction $(s){return document.querySelector(s)}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}\nfunction b64u8(b){var bin=atob(b),n=bin.length,u=new Uint8Array(n);for(var i=0;i<n;i++)u[i]=bin.charCodeAt(i);return u}\nasync function gunzip(u8,gz){if(!gz)return u8;var r=new Response(new Blob([u8]).stream().pipeThrough(new DecompressionStream('gzip')));return new Uint8Array(await r.arrayBuffer())}\nfunction setLoad(msg,pct){$('#lmsg').textContent=msg;if(pct!=null)$('#barfill').style.width=Math.round(pct)+'%'}\nfunction tick(){return new Promise(function(r){setTimeout(r,0)})}\nfunction loadScript(text){return new Promise(function(res,rej){var u=URL.createObjectURL(new Blob([text],{type:'application/javascript'}));var s=document.createElement('script');s.src=u;s.onload=function(){URL.revokeObjectURL(u);res()};s.onerror=function(){rej(new Error('載入SQLite引擎失敗'))};document.head.appendChild(s)})}\nfunction rows(sql){var r=SQLDB.exec(sql);return r.length?r[0].values:[]}\nfunction F(i){return DB.files[i]||['?','',0,'']}\nfunction S(i){return DB.syms[i]}\nfunction srcLink(ref){var m=/^(.*?):(\\d+)(?:-(\\d+))?$/.exec(ref)||[ref,ref];return '<a class=\"src\" data-src=\"'+esc(m[1])+(m[2]?':'+m[2]+(m[3]?'-'+m[3]:''):'')+'\" title=\"看原始碼\">🧾</a>'}\nfunction link(path,label){return '<a class=\"l\" data-go=\"file:'+esc(path)+'\">'+esc(label||path)+'</a>'}\nfunction slink(name){return '<a class=\"l\" data-go=\"sym:'+esc(name)+'\">'+esc(name)+'</a>'}\n/* ---- 迷你Markdown ---- */\nfunction inline(t){\n  t=esc(t);\n  t=t.replace(/`([^`]+)`/g,function(m,c){var p=c.replace(/:\\d+(-\\d+)?$/,'');return (fileMap[p]!=null||(PARTS&&/^[\\w.+\\-@\\/]+\\.[A-Za-z0-9]{1,6}$/.test(p)))?'<a class=\"l\" data-go=\"file:'+esc(p)+'\"><code>'+c+'</code></a>'+(p!==c?srcLink(c):''):(IX&&IX.nameMap[c.toLowerCase()]?'<a class=\"l\" data-go=\"sym:'+esc(c)+'\"><code>'+c+'</code></a>':'<code>'+c+'</code>')});\n  t=t.replace(/\\*\\*([^*]+)\\*\\*/g,'<b>$1</b>').replace(/\\[([^\\]]+)\\]\\(page:([^)]+)\\)/g,'<a class=\"l\" data-go=\"page:$2\">$1</a>').replace(/\\[([^\\]]+)\\]\\((https?:[^)]+)\\)/g,'<a href=\"$2\" target=\"_blank\" rel=\"noopener\">$1</a>');\n  return t;\n}\nfunction mdToHtml(md){\n  var lines=String(md||'').split('\\n'),h='',i=0;\n  while(i<lines.length){\n    var l=lines[i];\n    if(/^```/.test(l)){var lang=l.replace(/^```/,'').trim();var buf=[];i++;while(i<lines.length&&!/^```/.test(lines[i])){buf.push(lines[i]);i++}i++;\n      if(lang==='mermaid'){var sv=mermaidLite(buf.join('\\n'));h+=sv||'<pre>'+esc(buf.join('\\n'))+'</pre>'}else h+='<pre>'+esc(buf.join('\\n'))+'</pre>';continue}\n    var m;\n    if((m=/^(#{1,4})\\s+(.*)$/.exec(l))){var n=m[1].length;h+='<h'+n+'>'+inline(m[2])+'</h'+n+'>';i++;continue}\n    if(/^\\|.*\\|\\s*$/.test(l)&&i+1<lines.length&&/^\\|[\\s:|-]+\\|\\s*$/.test(lines[i+1])){var hd=l.split('|').slice(1,-1);i+=2;var rows=[];while(i<lines.length&&/^\\|.*\\|\\s*$/.test(lines[i])){rows.push(lines[i].split('|').slice(1,-1));i++}\n      h+='<table><tr>'+hd.map(function(c){return '<th>'+inline(c.trim())+'</th>'}).join('')+'</tr>'+rows.map(function(r){return '<tr>'+r.map(function(c){return '<td>'+inline(c.trim())+'</td>'}).join('')+'</tr>'}).join('')+'</table>';continue}\n    if(/^\\s*[-*]\\s+/.test(l)){var it=[];while(i<lines.length&&/^\\s*[-*]\\s+/.test(lines[i])){it.push('<li>'+inline(lines[i].replace(/^\\s*[-*]\\s+/,''))+'</li>');i++}h+='<ul>'+it.join('')+'</ul>';continue}\n    if(/^\\s*\\d+\\.\\s+/.test(l)){var it2=[];while(i<lines.length&&/^\\s*\\d+\\.\\s+/.test(lines[i])){it2.push('<li>'+inline(lines[i].replace(/^\\s*\\d+\\.\\s+/,''))+'</li>');i++}h+='<ol>'+it2.join('')+'</ol>';continue}\n    if(/^>\\s?/.test(l)){var q=[];while(i<lines.length&&/^>\\s?/.test(lines[i])){q.push(lines[i].replace(/^>\\s?/,''));i++}h+='<blockquote>'+inline(q.join(' '))+'</blockquote>';continue}\n    if(!l.trim()){i++;continue}\n    var p=[l];i++;while(i<lines.length&&lines[i].trim()&&!/^(#{1,4}\\s|```|\\s*[-*]\\s|\\s*\\d+\\.\\s|>|\\|)/.test(lines[i])){p.push(lines[i]);i++}\n    h+='<p>'+inline(p.join(' '))+'</p>';\n  }\n  return h;\n}\n/* ---- 迷你流程圖（只支援 graph LR/TD 的節點與箭頭）---- */\nfunction mermaidLite(src){\n  var ls=src.split('\\n').map(function(x){return x.trim()}).filter(Boolean);\n  if(!ls.length||!/^(graph|flowchart)\\s+(LR|RL|TD|TB|BT)/i.test(ls[0]))return '';\n  var dir=/LR|RL/i.test(ls[0])?'LR':'TD';var nodes={},order=[],edges=[];\n  function nd(tok){var m=/^([A-Za-z0-9_\\-.]+)\\s*(?:\\[\\[?\"?([^\\]\"]*)\"?\\]?\\]|\\(\\(?\"?([^)\"]*)\"?\\)?\\)|\\{\"?([^}\"]*)\"?\\})?$/.exec(tok.trim());if(!m)return null;var id=m[1];var label=m[2]||m[3]||m[4];if(!nodes[id]){nodes[id]={id:id,label:label||id};order.push(id)}else if(label)nodes[id].label=label;return id}\n  for(var k=1;k<ls.length;k++){var ln=ls[k];if(/^(subgraph|end|classDef|class|style|linkStyle|%%)/.test(ln))continue;\n    var parts=ln.split(/\\s*(?:--\x3e|---|-\\.->|==>)\\s*(?:\\|([^|]*)\\|\\s*)?/);\n    var ids=[];for(var j=0;j<parts.length;j+=2){var id=nd(parts[j]||'');if(!id)return '';ids.push({id:id,lab:parts[j+1]||''})}\n    for(var e=0;e+1<ids.length;e++)edges.push({a:ids[e].id,b:ids[e+1].id,lab:ids[e+1].lab||''});}\n  if(!order.length||order.length>60)return '';\n  var rank={};order.forEach(function(id){rank[id]=0});\n  for(var it=0;it<order.length;it++){var ch=false;edges.forEach(function(e){if(e.a!==e.b&&rank[e.b]<rank[e.a]+1&&rank[e.a]+1<order.length){rank[e.b]=rank[e.a]+1;ch=true}});if(!ch)break}\n  var cols={};order.forEach(function(id){(cols[rank[id]]=cols[rank[id]]||[]).push(id)});\n  var W=170,H=44,GX=60,GY=22,pos={},maxc=0,maxr=0;\n  Object.keys(cols).forEach(function(r){cols[r].forEach(function(id,idx){pos[id]=dir==='LR'?{x:r*(W+GX)+10,y:idx*(H+GY)+10}:{x:idx*(W+GX)+10,y:r*(H+GY+20)+10};maxc=Math.max(maxc,pos[id].x+W+10);maxr=Math.max(maxr,pos[id].y+H+10)})});\n  var s='<svg class=\"dg\" viewBox=\"0 0 '+maxc+' '+maxr+'\" width=\"'+Math.min(maxc,900)+'\"><defs><marker id=\"ar\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" style=\"fill:var(--mut);stroke:none\"/></marker></defs>';\n  edges.forEach(function(e){var a=pos[e.a],b=pos[e.b];if(!a||!b)return;var x1=dir==='LR'?a.x+W:a.x+W/2,y1=dir==='LR'?a.y+H/2:a.y+H,x2=dir==='LR'?b.x:b.x+W/2,y2=dir==='LR'?b.y+H/2:b.y;var mx=(x1+x2)/2,my=(y1+y2)/2;\n    s+='<path d=\"M'+x1+','+y1+' C'+(dir==='LR'?mx:x1)+','+(dir==='LR'?y1:my)+' '+(dir==='LR'?mx:x2)+','+(dir==='LR'?y2:my)+' '+x2+','+y2+'\" marker-end=\"url(#ar)\"/>';if(e.lab)s+='<text x=\"'+mx+'\" y=\"'+(my-3)+'\" text-anchor=\"middle\">'+esc(e.lab)+'</text>'});\n  order.forEach(function(id){var p=pos[id],lb=nodes[id].label;if(lb.length>24)lb=lb.slice(0,23)+'…';s+='<rect x=\"'+p.x+'\" y=\"'+p.y+'\" width=\"'+W+'\" height=\"'+H+'\" rx=\"6\"/><text x=\"'+(p.x+W/2)+'\" y=\"'+(p.y+H/2+4)+'\" text-anchor=\"middle\">'+esc(lb)+'</text>'});\n  return s+'</svg>';\n}\n\nasync function boot(){\n  $('#ttl').textContent=CFG.title;\n  var P=JSON.parse(document.getElementById('payload').textContent);\n  if(CFG.mode==='sqlite'){\n    setLoad('解壓縮 SQLite 引擎…',3);\n    var js=new TextDecoder().decode(await gunzip(b64u8(P.js),CFG.sql.gz.js));\n    var wasm=await gunzip(b64u8(P.wasm),CFG.sql.gz.wasm);\n    await loadScript(js);\n    setLoad('載入資料庫…',10);\n    var dbBytes=await gunzip(b64u8(P.db),CFG.sql.gz.db);\n    var SQL=await initSqlJs({wasmBinary:wasm.buffer.slice(wasm.byteOffset,wasm.byteOffset+wasm.byteLength)});\n    SQLJS=SQL;SQLDB=new SQL.Database(dbBytes);\n    setLoad('讀取資料表…',18);await tick();\n    DB={root:CFG.root,files:rows('SELECT path,lang,lines,doc,note FROM files ORDER BY id'),syms:rows('SELECT name,kind,file_id,line,doc,sig,note FROM symbols ORDER BY id'),imps:rows('SELECT src,dst FROM imports'),uses:rows('SELECT file_id,symbol_id FROM uses')};\n    PAGES=rows('SELECT id,title,kind,auto,md FROM pages').map(function(r){return {id:r[0],title:r[1],kind:r[2],auto:!!r[3],md:r[4]}});\n    rows('SELECT term,definition FROM glossary').forEach(function(r){GLOSS[r[0]]={definition:r[1]}});\n  }else{\n    setLoad('解壓縮資料…',5);\n    var j=JSON.parse(new TextDecoder().decode(await gunzip(b64u8(P.data),CFG.dataGz)));\n    DB=j;PAGES=j.pages||[];GLOSS=j.glossary||{};\n  }\n  Object.assign(FOLD,CFG.folderNotes||{});\n  DB.files.forEach(function(f,i){fileMap[f[0]]=i});\n  setLoad('建立檢索索引…',22);await tick();\n  IX=_faCodeIndexNew(DB);\n  var total=(DB.syms.length+DB.files.length)||1;\n  while(!_faCodeIndexTokens(IX,120)){setLoad('建立檢索索引… '+Math.round((IX.ti+IX.tf)/total*100)+'%',22+78*(IX.ti+IX.tf)/total);await tick()}\n  $('#load').style.display='none';$('#app').style.display='flex';\n  $('#stat').textContent=CFG.stats.files+' 個檔案 · '+CFG.stats.symbols+' 個定義 · '+CFG.stats.imports+' 條引用 · '+CFG.stats.uses+' 條呼叫'+(CFG.complete?'':' · （部分索引）')+' · 產生於 '+new Date(CFG.generated).toLocaleString();\n  var tabs=[['wiki','百科'],['files','檔案'],['syms','符號'],['ask','問答 ▸']];if(SQLDB)tabs.push(['sql','SQL']);\n  $('#nav').innerHTML=tabs.map(function(t){return '<button data-t=\"'+t[0]+'\">'+t[1]+'</button>'}).join('');\n  $('#nav').onclick=function(e){var b=e.target.closest('button');if(b)show(b.dataset.t)};\n  initWiki();initFiles();initSyms();initAsk();if(SQLDB)initSql();initDock();initSrcView();\n  show('wiki');fapInit();\n}\nfunction show(t){if(t==='ask'){dockOpen(!DOCK.open);return}\n  document.querySelectorAll('.pane').forEach(function(p){p.classList.toggle('on',p.id==='p-'+t)});document.querySelectorAll('#nav button').forEach(function(b){if(b.dataset.t!=='ask')b.classList.toggle('on',b.dataset.t===t)})}\nfunction goRaw(g){var i=g.indexOf(':'),k=g.slice(0,i),v=g.slice(i+1);\n  if(k==='file'){show('files');CURF=v;showFileX(v)}else if(k==='sym'){show('syms');CURS=v;showSymX(v)}else if(k==='page'){show('wiki');showPage(v)}else if(k==='folder'){show('files');showFolder(v)}}\n\n/* ===== 瀏覽歷史：上一個／下一個位置＋歷史清單（像 call stack）。連到壞掉的連結也會留在歷史裡（標紅），隨時可以退回去 ===== */\nvar NAV={st:[],i:-1,max:200};\nfunction navScroller(){return document.querySelector('.pane.on .main')||document.getElementById('main')}\nfunction navSave(){var e=NAV.st[NAV.i],sc=navScroller();if(e&&sc)e.sy=sc.scrollTop}\nfunction navText(g){var i=g.indexOf(':'),k=g.slice(0,i),v=g.slice(i+1);return (k==='file'?'📄 ':k==='sym'?'ƒ ':(k==='dir'||k==='folder')?'📁 ':k==='page'?'📖 ':'• ')+(k==='file'?v.split('/').slice(-2).join('/'):v)}\nfunction navPush(g){navSave();var top=NAV.st[NAV.i];if(top&&top.g===g){navRender();return}NAV.st.length=NAV.i+1;NAV.st.push({g:g,t:navText(g),fail:''});if(NAV.st.length>NAV.max)NAV.st.shift();NAV.i=NAV.st.length-1;navRender()}\nfunction navFail(why){var e=NAV.st[NAV.i];if(e){e.fail=why||'失敗';navRender()}}\nfunction navTo(i){if(i<0||i>=NAV.st.length)return;navSave();NAV.i=i;var e=NAV.st[i],sy=e.sy||0;e.fail='';navRender();var rs=function(){var sc=navScroller();if(sc)sc.scrollTop=sy};Promise.resolve(goRaw(e.g)).then(function(){setTimeout(rs,0);setTimeout(rs,250)},function(){});setTimeout(rs,60)} /* 每一筆記得捲動位置：退回去時回到原本看到的地方 */\nfunction navBack(){navTo(NAV.i-1)}function navFwd(){navTo(NAV.i+1)}\nfunction navRender(){\n  var b=document.getElementById('navB'),f=document.getElementById('navF');if(b)b.disabled=NAV.i<=0;if(f)f.disabled=NAV.i>=NAV.st.length-1;\n  var p=document.getElementById('navp');if(!p||p.style.display==='none')return;\n  var h='<div class=\"nh\"><b>瀏覽歷史（'+NAV.st.length+'）　最新在上</b><a data-navclear=\"1\" style=\"padding:0 6px;display:inline\">清除</a></div>';\n  for(var k=NAV.st.length-1;k>=0;k--){var e=NAV.st[k];h+='<a data-navi=\"'+k+'\" class=\"'+(k===NAV.i?'cur ':'')+(e.fail?'fail':'')+'\" title=\"'+esc(e.fail||e.g)+'\"><span class=\"ix\">'+(k+1)+'</span><span>'+esc(e.t)+(e.fail?' ⚠ '+esc(e.fail):'')+'</span><span style=\"margin-left:auto;color:var(--mut);font-size:11px;white-space:nowrap\">'+(k===NAV.i?'目前':(k>NAV.i?'下一個位置':''))+'</span></a>'}\n  p.innerHTML=h}\n(function(){var p=document.createElement('div');p.id='navp';document.body.appendChild(p);\n  document.getElementById('navB').onclick=navBack;document.getElementById('navF').onclick=navFwd;\n  document.getElementById('navH').onclick=function(e){e.stopPropagation();p.style.display=p.style.display==='block'?'none':'block';navRender()};\n  p.addEventListener('click',function(e){e.stopPropagation();var c=e.target.closest('[data-navclear]');if(c){var cur=NAV.st[NAV.i];NAV.st=cur?[cur]:[];NAV.i=cur?0:-1;navRender();return}var a=e.target.closest('[data-navi]');if(a){p.style.display='none';navTo(+a.getAttribute('data-navi'))}});\n  document.addEventListener('click',function(e){if(!e.target.closest('#navp'))p.style.display='none'});\n  document.addEventListener('keydown',function(e){if(e.altKey&&e.key==='ArrowLeft'){e.preventDefault();navBack()}else if(e.altKey&&e.key==='ArrowRight'){e.preventDefault();navFwd()}else if(e.key==='Escape')p.style.display='none'});\n  document.addEventListener('mouseup',function(e){if(e.button===3){e.preventDefault();navBack()}else if(e.button===4){e.preventDefault();navFwd()}});\n  document.addEventListener('click',function(e){var a=e.target.closest('[data-nav]');if(a){e.preventDefault();if(a.getAttribute('data-nav')==='back')navBack();else navFwd()}})})();\nfunction go(g){navPush(g);goRaw(g)}\n/* 符號找不到：說明原因（繼承／覆寫／框架／沒建索引的函式庫）、同名候選、回上一個位置 */\nfunction symMissHtml(name,hits){\n  var tail=String(name).split(/[.:]+|->|#/).filter(Boolean).pop()||name;\n  var h='<div class=\"note\"><b>索引裡沒有「'+esc(name)+'」的定義。</b><br>常見原因：它是<b>繼承或覆寫</b>來的（例如 C# 的 <code>InitializeComponent</code> 在 .Designer.cs 的 partial class 裡，<code>OnPaint</code> 這類來自框架的父類別），或來自沒有建索引的函式庫，或這個檔案還沒被分析到。這不是匯出壞了。</div>'+\n    '<div style=\"margin:8px 0\"><button class=\"nvb\" data-nav=\"back\"'+(NAV.i>0?'':' disabled')+'>◀ 回到上一個位置</button> <button class=\"nvb\" onclick=\"document.getElementById(\\'navH\\').click()\">🕘 看瀏覽歷史</button></div>';\n  if(hits&&hits.length)h+='<h2>名字相同的其他定義（'+hits.length+'，不一定是同一個）</h2>'+hits.slice(0,30).map(function(x){return '<div><a class=\"l\" data-go=\"sym:'+esc(x[0])+'\">'+esc(x[0])+'</a> <span class=\"k\">'+esc(x[1])+' · '+esc(x[2])+':'+x[3]+'</span></div>'}).join('');\n  else h+='<div class=\"mut\">這份匯出裡沒有任何名叫「'+esc(tail)+'」的定義。</div>';\n  return h}\ndocument.addEventListener('click',function(e){var a=e.target.closest('[data-go]');if(a){e.preventDefault();go(a.dataset.go);return}\n  a=e.target.closest('[data-src]');if(a){e.preventDefault();var m=/^(.*?)(?::(\\d+)(?:-(\\d+))?)?$/.exec(a.dataset.src);openSrc(m[1],+m[2]||0,+m[3]||0);return}\n  a=e.target.closest('[data-ai]');if(a){e.preventDefault();aiExplain(a);return}\n  a=e.target.closest('[data-aifolder]');if(a){e.preventDefault();aiFolder(a);return}\n  a=e.target.closest('[data-nsave]');if(a){e.preventDefault();saveNoteBtn(a)}});\n/* ---- 百科 ---- */\nfunction initWiki(){\n  function render(){var q=$('#wq').value.trim().toLowerCase();var h='';\n    PAGES.forEach(function(p){if(q&&p.title.toLowerCase().indexOf(q)<0&&String(p.md).toLowerCase().indexOf(q)<0)return;h+='<a data-go=\"page:'+esc(p.id)+'\">'+esc(p.title)+(p.auto?'<span class=\"k\">草稿</span>':'')+'</a>'});\n    var gl=Object.keys(GLOSS);if(gl.length&&!q)h+='<div class=\"mut\" style=\"padding:8px 8px 2px\">名詞</div>'+gl.sort().map(function(t){return '<a data-go=\"term:'+esc(t)+'\">'+esc(t)+'</a>'}).join('');\n    $('#wl').innerHTML=h||'<div class=\"mut\" style=\"padding:8px\">沒有符合的頁面</div>'}\n  $('#wq').oninput=render;render();\n  if(PAGES.length){navPush('page:'+PAGES[0].id);showPage(PAGES[0].id)}else{var h2='<h1 class=\"t\">專案概況</h1><div class=\"mut\">'+esc(CFG.root)+'</div><p>這份匯出沒有百科頁面，請用「檔案」「符號」「問答」。</p>';$('#wm').innerHTML=h2}\n}\nfunction showPage(id){var p=PAGES.filter(function(x){return x.id===id})[0];if(!p){$('#wm').innerHTML='<div class=\"note\">沒有這個頁面</div>';return}\n  $('#wm').innerHTML='<div class=\"md\">'+(p.auto?'<div class=\"note\">這一頁是依程式碼結構自動產生的草稿。</div>':'')+mdToHtml(p.md)+'</div>';$('#wm').scrollTop=0}\n/* ---- 檔案 ---- */\nfunction initFiles(){\n  var tree={};DB.files.forEach(function(f,i){var segs=f[0].split('/'),n=tree;for(var k=0;k<segs.length-1;k++){n=(n.d=n.d||{})[segs[k]]=(n.d&&n.d[segs[k]])||{}}(n.f=n.f||[]).push(i)});\n  function node(n,depth,pre){pre=pre||'';var h='';Object.keys(n.d||{}).sort().forEach(function(k){h+='<details'+(depth<1?' open':'')+'><summary>'+esc(k)+'/ <a class=\"src\" data-go=\"folder:'+esc(pre+k)+'\" title=\"這個資料夾的說明\">ⓘ</a></summary><div>'+node(n.d[k],depth+1,pre+k+'/')+'</div></details>'});\n    (n.f||[]).slice(0,300).forEach(function(i){h+='<a data-go=\"file:'+esc(F(i)[0])+'\">'+esc(F(i)[0].split('/').pop())+'<span class=\"k\">'+(IX.fileSyms[i]||[]).length+'</span></a>'});return h}\n  var lazy=null;\n  function render(){var q=$('#fq').value.trim().toLowerCase();\n    if(!q){if(!lazy)lazy=node(tree,0,'');$('#fl').innerHTML=lazy;return}\n    var h='',c=0;for(var i=0;i<DB.files.length&&c<200;i++){if(DB.files[i][0].toLowerCase().indexOf(q)>=0){c++;h+='<a data-go=\"file:'+esc(DB.files[i][0])+'\">'+esc(DB.files[i][0])+'</a>'}}\n    $('#fl').innerHTML=h||'<div class=\"mut\" style=\"padding:8px\">沒有符合的檔案</div>'}\n  $('#fq').oninput=render;render();\n  $('#fm').innerHTML='<h1 class=\"t\">檔案</h1><div class=\"mut\">左邊選一個檔案，看它定義了什麼、引用了誰、被誰引用。</div>';\n}\nfunction showFile(path){var i=fileMap[path];if(i==null){$('#fm').innerHTML='<div class=\"note\">索引裡沒有這個檔案</div>';return}\n  var f=F(i),syms=IX.fileSyms[i]||[],out=IX.impOut[i]||[],inn=IX.impIn[i]||[],uses=IX.fileUses[i]||[];\n  var h='<h1 class=\"t\">'+esc(path)+'</h1><div><span class=\"tag\">'+esc(f[1])+'</span><span class=\"tag\">'+f[2]+' 行</span></div>';\n  h+=noteView('檔案說明',f[4])+noteEditor('file',path,'',f[4]);\n  h+='<div style=\"margin:4px 0\"><a class=\"l\" data-src=\"'+esc(path)+'\">🧾 看原始碼</a>'+explainBtn('file',path,'')+'</div>';\n  if(f[3])h+='<p>'+esc(f[3])+'</p>';\n  h+='<h2>定義（'+syms.length+'）</h2>';\n  if(syms.length){h+='<table>';syms.slice(0,400).forEach(function(k){var s=S(k);h+='<tr><td>'+slink(s[0])+'</td><td><span class=\"tag\">'+esc(s[1])+'</span></td><td>第 '+s[3]+' 行 '+srcLink(path+':'+s[3])+explainBtn('fn',path,s[0])+'</td><td>'+(s[6]?noteFold(s[6]):'')+(s[4]?esc(s[4])+'<br>':'')+(s[5]?'<code>'+esc(s[5])+'</code>':'')+'</td></tr>'});h+='</table>'}else h+='<div class=\"mut\">（沒有抽到定義）</div>';\n  h+='<h2>引用了誰（'+out.length+'）</h2>'+(out.length?out.slice(0,200).map(function(k){return '<div>'+link(F(k)[0])+'</div>'}).join(''):'<div class=\"mut\">（沒有內部引用）</div>');\n  h+='<h2>被誰引用（'+inn.length+'）</h2>'+(inn.length?inn.slice(0,200).map(function(k){return '<div>'+link(F(k)[0])+'</div>'}).join(''):'<div class=\"mut\">（沒有已分析的檔案引用它）</div>');\n  if(uses.length){var seen={};h+='<h2>呼叫了別處的定義（'+uses.length+'）</h2>'+uses.slice(0,200).filter(function(k){return !seen[k]&&(seen[k]=1)}).map(function(k){var s=S(k);return '<div>'+slink(s[0])+' <span class=\"mut\">'+esc(F(s[2])[0])+':'+s[3]+'</span></div>'}).join('')}\n  $('#fm').innerHTML=h;$('#fm').scrollTop=0}\n/* ---- 符號 ---- */\nfunction initSyms(){\n  var kinds={};DB.syms.forEach(function(s){kinds[s[1]]=(kinds[s[1]]||0)+1});\n  $('#sk').innerHTML='<option value=\"\">所有種類</option>'+Object.keys(kinds).sort(function(a,b){return kinds[b]-kinds[a]}).map(function(k){return '<option value=\"'+esc(k)+'\">'+esc(k)+'（'+kinds[k]+'）</option>'}).join('');\n  var order=null;\n  function render(){var q=$('#sq').value.trim().toLowerCase(),kd=$('#sk').value,h='',c=0;\n    if(!order){order=DB.syms.map(function(s,i){return i}).sort(function(a,b){return String(DB.syms[a][0]).toLowerCase()<String(DB.syms[b][0]).toLowerCase()?-1:1})}\n    for(var n=0;n<order.length&&c<300;n++){var s=DB.syms[order[n]];if(kd&&s[1]!==kd)continue;if(q&&String(s[0]).toLowerCase().indexOf(q)<0&&String(s[4]).toLowerCase().indexOf(q)<0)continue;c++;h+='<a data-go=\"sym:'+esc(s[0])+'\">'+esc(s[0])+'<span class=\"k\">'+esc(s[1])+' · '+esc(F(s[2])[0].split('/').pop())+'</span></a>'}\n    $('#sl').innerHTML=h||'<div class=\"mut\" style=\"padding:8px\">沒有符合的結果</div>'+(c>=300?'':'')}\n  $('#sq').oninput=render;$('#sk').onchange=render;render();\n  $('#sm').innerHTML='<h1 class=\"t\">符號</h1><div class=\"mut\">函式、類別、結構、巨集…（最多列300筆，用上面的搜尋縮小範圍）。</div>';\n}\nfunction symTail(name){return String(name).split(/[.:]+|->|#/).filter(Boolean).pop()||String(name)}\nfunction viaNote(name,tail){return '<div class=\"mut\" style=\"margin-bottom:6px\">「'+esc(name)+'」本身不在索引裡，用最後一段「'+esc(tail)+'」查到：</div>'}\nfunction showSym(name){var ids=IX.nameMap[String(name).toLowerCase()]||[],via='';\n  if(!ids.length&&symTail(name)!==name){var t0=symTail(name),i2=IX.nameMap[t0.toLowerCase()]||[];if(i2.length){ids=i2;via=viaNote(name,t0)}}\n  if(!ids.length){navFail('索引裡沒有');var tl=symTail(name).toLowerCase(),hs=[];\n    Object.keys(IX.nameMap).forEach(function(k){if(hs.length<30&&k.split(/[.:]+/).pop()===tl)(IX.nameMap[k]||[]).slice(0,3).forEach(function(id){var s=S(id);hs.push([s[0],s[1],F(s[2])[0],s[3]])})});\n    $('#sm').innerHTML=symMissHtml(name,hs);return}\n  var h=via+'<h1 class=\"t\">'+esc(S(ids[0])[0])+'</h1><div class=\"mut\">'+ids.length+' 個定義</div>';\n  ids.slice(0,12).forEach(function(k){var s=S(k),fi=s[2];\n    h+='<h2>'+esc(s[1])+'　'+link(F(fi)[0],F(fi)[0]+':'+s[3])+srcLink(F(fi)[0]+':'+s[3])+explainBtn('fn',F(fi)[0],s[0])+'</h2>';\n    h+=noteView('說明',s[6])+noteEditor('sym',F(fi)[0],s[0],s[6]);\n    h+=s[4]?'<p>'+esc(s[4])+'</p>':(s[6]?'':'<p class=\"mut\">'+esc(_faCodeNameGuess(s[0]))+'</p>');\n    if(s[5])h+='<pre>'+esc(s[5])+'</pre>';\n    var users=(IX.usedBy[k]||[]);if(users.length)h+='<div><b>被這些檔案呼叫／使用（'+users.length+'）：</b> '+users.slice(0,30).map(function(u){return link(F(u)[0])}).join('、')+'</div>';\n    var inn=IX.impIn[fi]||[];if(inn.length)h+='<div class=\"mut\" style=\"margin-top:4px\">定義它的檔案被 '+inn.length+' 個檔案引用：'+inn.slice(0,12).map(function(u){return link(F(u)[0])}).join('、')+'</div>';\n    var same=(IX.fileSyms[fi]||[]).filter(function(x){return x!==k}).slice(0,15);if(same.length)h+='<div style=\"margin-top:4px\"><b>同檔案的其他定義：</b> '+same.map(function(x){return slink(S(x)[0])}).join('、')+'</div>'});\n  $('#sm').innerHTML=h;$('#sm').scrollTop=0}\n/* ---- 問答 ---- */\nfunction initAsk(){\n  var ex=['這個專案是做什麼的','哪些檔案被最多檔案引用','處理設定檔的函式在哪','錯誤處理相關的程式'];\n  var big=DB.syms.length?DB.syms[0][0]:'main';\n  ex=[big+' 是做什麼的','where is '+big+' defined','誰用到 '+big,big+' 相關的東西'].concat(ex.slice(2));\n  $('#achips').innerHTML=ex.map(function(x){return '<span>'+esc(x)+'</span>'}).join('');\n  $('#achips').onclick=function(e){if(e.target.tagName==='SPAN'){$('#aq').value=e.target.textContent;ask()}};\n  $('#ago').onclick=ask;$('#aq').onkeydown=function(e){if(e.key==='Enter')ask()};\n}\nasync function ask(){var q=$('#aq').value.trim();if(!q)return;var t0=performance.now();var r;try{r=PARTS?await askP(q):_faCodeAsk(IX,q)}catch(e){$('#aout').insertAdjacentHTML('afterbegin','<div class=\"qa\"><div class=\"q\">'+esc(q)+'</div><div class=\"err\">'+esc(e.message||e)+'</div></div>');return}\n  var ms=Math.round(performance.now()-t0);\n  var h='<div class=\"qa\"><div class=\"q\">'+esc(q)+'</div><div class=\"md\">'+mdToHtml(r.answer)+'</div><div class=\"mut\" style=\"margin-top:6px\">意圖：'+esc({where:'找定義位置',who:'誰在用',related:'相關',deps:'檔案依賴',purpose:'做什麼用',about:'關於',search:'語意搜尋'}[r.intent]||r.intent)+' · '+ms+' ms</div>'+evHtml(r)+'</div>';\n  $('#aout').insertAdjacentHTML('afterbegin',h);$('#aq').select()}\nfunction evHtml(r){var ev=(r.evidence||[]),seen={},o=[];ev.forEach(function(x){var k=x.path+':'+x.line;if(!seen[k]&&o.length<8){seen[k]=1;o.push('<span class=\"mut\">'+esc(x.path)+':'+x.line+'</span>'+srcLink(x.path+':'+x.line))}});return o.length?'<div style=\"margin-top:6px\"><b>相關位置：</b> '+o.join('　')+'</div>':''}\n/* ---- 右側問答面板（可停靠右／下／上，大小記在 localStorage）---- */\nvar DOCK={open:true,pos:'right',w:380,h:300};\nfunction dockSave(){try{localStorage.setItem('aidoc-export-dock',JSON.stringify({open:DOCK.open,pos:DOCK.pos,w:DOCK.w,h:DOCK.h}))}catch(e){}}\nfunction dockApply(){var app=$('#app'),pos=DOCK.pos;if(window.innerWidth<720&&pos==='right')pos='bottom';\n  app.setAttribute('data-dock',pos);app.classList.toggle('nodock',!DOCK.open);app.style.setProperty('--dw',DOCK.w+'px');app.style.setProperty('--dh',DOCK.h+'px');\n  $('#dockpos').value=DOCK.pos;var b=document.querySelector('#nav button[data-t=\"ask\"]');if(b)b.classList.toggle('on',DOCK.open)}\nfunction dockOpen(v){DOCK.open=!!v;dockApply();dockSave();if(v)$('#aq').focus()}\nfunction initDock(){\n  try{var o=JSON.parse(localStorage.getItem('aidoc-export-dock')||'null');if(o){if(o.pos==='right'||o.pos==='bottom'||o.pos==='top')DOCK.pos=o.pos;if(o.w>=240)DOCK.w=o.w;if(o.h>=120)DOCK.h=o.h;DOCK.open=o.open!==false}}catch(e){}\n  if(window.innerWidth<720)DOCK.open=false;\n  dockApply();\n  $('#dockx').onclick=function(){dockOpen(false)};\n  $('#dockpos').onchange=function(){DOCK.pos=this.value;dockApply();dockSave()};\n  window.addEventListener('resize',dockApply);\n  var am=$('#aimodel');if(!CFG.ai){$('#aimlab').style.display='none'}else{am.checked=aiUseModel();am.onchange=function(){try{localStorage.setItem('aidoc-export-ai-model',am.checked?'1':'0')}catch(e){}}}\n  var sp=$('#split'),drag=false;\n  sp.onmousedown=function(e){drag=true;sp.classList.add('on');e.preventDefault()};\n  window.addEventListener('mousemove',function(e){if(!drag)return;var r=$('#app').getBoundingClientRect(),pos=$('#app').getAttribute('data-dock');\n    if(pos==='right')DOCK.w=Math.max(240,Math.min(r.width-260,Math.round(r.right-e.clientX)));\n    else if(pos==='bottom')DOCK.h=Math.max(120,Math.min(r.height-160,Math.round(r.bottom-e.clientY)));\n    else DOCK.h=Math.max(120,Math.min(r.height-160,Math.round(e.clientY-r.top)));dockApply()});\n  window.addEventListener('mouseup',function(){if(drag){drag=false;sp.classList.remove('on');dockSave()}});\n  sp.ondblclick=function(){DOCK.w=380;DOCK.h=300;dockApply();dockSave()};\n}\n/* ---- 專案資料夾（File Access Point）：讀原始碼、讀寫 notes.sqlite3 ---- */\nvar FAP={h:null,perm:'none'},NOTES_PATH='.floating-assistant/index/notes.sqlite3',NOTEMEM={};\nfunction idbp(mode,fn){return new Promise(function(res,rej){var q;try{q=indexedDB.open('aidoc-export-fap',1)}catch(e){return rej(e)}\n  q.onupgradeneeded=function(){q.result.createObjectStore('h')};q.onerror=function(){rej(q.error)};\n  q.onsuccess=function(){var db=q.result,tx=db.transaction('h',mode),r=fn(tx.objectStore('h'));tx.oncomplete=function(){db.close();res(r&&r.result)};tx.onerror=function(){rej(tx.error)}}})}\nfunction hperm(h,req){var o={mode:'readwrite'};if(req&&h.requestPermission)return h.requestPermission(o);return h.queryPermission?h.queryPermission(o):Promise.resolve('granted')}\nfunction fapStatus(){var e=$('#fapst'),t,ok=FAP.perm==='granted';\n  if(!window.showDirectoryPicker)t='⚠️ 這個瀏覽器不能讀專案資料夾（請用 Chrome／Edge）';\n  else if(ok)t='📁 已授權：'+FAP.h.name;else if(FAP.h)t='📁 需要重新授權（點這裡）';else t='📁 尚未授權專案資料夾（點這裡選）';\n  e.textContent=t;e.className=ok?'ok':'';e.onclick=function(){if(!window.showDirectoryPicker||ok)return;ensureRoot().catch(function(){})}}\nasync function fapInit(){\n  if(window.showDirectoryPicker){try{var h=await idbp('readonly',function(s){return s.get(CFG.root)});if(h){FAP.h=h;FAP.perm=await hperm(h,false)}}catch(e){}}\n  fapStatus();if(FAP.perm==='granted')await fapNotesPull()}\nasync function ensureRoot(){ // 需要使用者手勢\n  if(!window.showDirectoryPicker)throw new Error('這個瀏覽器不支援 File System Access（請用 Chrome／Edge 開啟這個檔案）');\n  if(FAP.h){if(FAP.perm!=='granted'){try{FAP.perm=await hperm(FAP.h,true)}catch(e){FAP.perm='prompt'}}if(FAP.perm==='granted'){fapStatus();return FAP.h}}\n  var h=await showDirectoryPicker({mode:'readwrite'});FAP.h=h;FAP.perm='granted';\n  try{await idbp('readwrite',function(s){return s.put(h,CFG.root)})}catch(e){}\n  fapStatus();await fapNotesPull();return h}\nasync function fapFile(path,create){var segs=path.split('/').filter(Boolean),d=FAP.h;for(var i=0;i<segs.length-1;i++)d=await d.getDirectoryHandle(segs[i],{create:!!create});return d.getFileHandle(segs[segs.length-1],{create:!!create})}\nasync function readSrc(path){var f=await (await fapFile(path)).getFile();if(f.size>3e6)throw new Error('檔案太大（'+f.size+' 位元組），不在這裡開');return f.text()}\nfunction symIdx(path,name){var fi=fileMap[path];if(fi==null)return -1;var a=IX.fileSyms[fi]||[];for(var i=0;i<a.length;i++)if(DB.syms[a[i]][0]===name)return a[i];return -1}\nfunction applyNote(kind,path,name,text){\n  if(path.slice(-1)==='/'){FOLD[path]=text;if(PARTS)NOTES.files[path]=text;return}\n  if(PARTS){if(kind==='file')NOTES.files[path]=text;else NOTES.syms[path+'\\u0000'+name]=text;return}\n  if(kind==='file'){var fi=fileMap[path];if(fi==null)return;DB.files[fi][4]=text;if(SQLDB)try{SQLDB.run('UPDATE files SET note=? WHERE path=?',[text,path])}catch(e){}}\n  else{var si=symIdx(path,name);if(si<0)return;DB.syms[si][6]=text;if(SQLDB)try{SQLDB.run('UPDATE symbols SET note=? WHERE name=? AND file_id=?',[text,name,DB.syms[si][2]])}catch(e){}}}\nasync function fapNotesPull(){ // notes.sqlite3 是權威：打開就蓋過匯出時內嵌的說明\n  if(PARTS){if(DBH&&FAP.perm==='granted')await partsNotesPull();return}\n  if(!SQLJS||FAP.perm!=='granted')return;var db=null;\n  try{var f=await (await fapFile(NOTES_PATH)).getFile();db=new SQLJS.Database(new Uint8Array(await f.arrayBuffer()))}catch(e){return}\n  try{var n=0;\n    [['file','SELECT path,note FROM file_notes'],['sym','SELECT path,note,name FROM sym_notes']].forEach(function(q){var r=db.exec(q[1]);if(!r.length)return;r[0].values.forEach(function(v){applyNote(q[0],v[0],v[2],v[1]);n++})});\n    var g=db.exec('SELECT term,definition FROM glossary');if(g.length)g[0].values.forEach(function(v){GLOSS[v[0]]={definition:v[1]}});\n    NOTEMEM.pulled=n;\n  }catch(e){}finally{db.close()}\n  if(CURF)showFile(CURF);if(CURS)showSym(CURS)}\nasync function writeNote(kind,path,name,text){\n  await ensureRoot();var bytes=null;\n  try{var f=await (await fapFile(NOTES_PATH)).getFile();bytes=new Uint8Array(await f.arrayBuffer())}catch(e){bytes=null}\n  var db=bytes&&bytes.length?new SQLJS.Database(bytes):new SQLJS.Database(),out;\n  try{(CFG.notesDdl||[]).forEach(function(d){db.run(d)});var now=Date.now();\n    if(kind==='file')db.run('INSERT INTO file_notes(path,note,author,ts,hash) VALUES(?,?,?,?,NULL) ON CONFLICT(path) DO UPDATE SET note=excluded.note,author=excluded.author,ts=excluded.ts,hash=NULL',[path,text,'user',now]);\n    else db.run('INSERT INTO sym_notes(path,name,note,author,ts,hash) VALUES(?,?,?,?,?,NULL) ON CONFLICT(path,name) DO UPDATE SET note=excluded.note,author=excluded.author,ts=excluded.ts,hash=NULL',[path,name,text,'user',now]);\n    db.run(\"INSERT INTO meta(k,v) VALUES('notes_ver',?) ON CONFLICT(k) DO UPDATE SET v=excluded.v\",[String(now)]);\n    out=db.export();\n  }finally{db.close()}\n  var created=false;try{await FAP.h.getDirectoryHandle('.floating-assistant/index'.split('/')[0])}catch(e){created=true}\n  var wf=await fapFile(NOTES_PATH,true),w=await wf.createWritable();await w.write(out);await w.close();\n  try{await (await fapFile('.floating-assistant/index/.gitignore')).getFile()}catch(e){try{var gw=await (await fapFile('.floating-assistant/index/.gitignore',true)).createWritable();await gw.write('*\\n');await gw.close()}catch(e2){}}\n  return out.length}\nfunction noteFold(x){x=String(x==null?'':x).trim();if(!x)return '';var multi=x.length>220||x.indexOf('\\n')>=0;if(!multi)return '<div class=\"md\">'+mdToHtml(x)+'</div>';var first=(x.split('\\n').filter(function(l){return l.trim()})[0]||'').replace(/^#+\\s*/,'').replace(/[*`|]/g,'').trim().slice(0,100);return '<details><summary>'+esc(first||'說明')+'</summary><div class=\"md\">'+mdToHtml(x)+'</div></details>'}\nfunction noteHtml(x){x=String(x==null?'':x);return /\\n|\\|.*\\|/.test(x)?'<div class=\"md\">'+mdToHtml(x)+'</div>':esc(x)}\nfunction noteView(label,text){return text?'<div class=\"note\"><b>'+label+'</b>：'+noteHtml(text)+'</div>':''}\nfunction noteEditor(kind,path,name,cur){\n  var tip=(SQLJS||PARTS)?'存到專案資料夾的 <code>notes.sqlite3</code>（重建索引不會洗掉）':'這份匯出沒有內嵌 SQLite，說明只在這次瀏覽有效，重新整理就消失';\n  return '<details class=\"ned\"><summary class=\"mut\">✏️ '+(cur?'修改':'補寫')+'說明</summary><textarea data-nt maxlength=\"2000\" placeholder=\"用自己的話寫這是做什麼的（保留換行，最多2000字）\">'+esc(cur||'')+'</textarea><div><button class=\"b s\" data-nsave=\"'+kind+'\" data-p=\"'+esc(path)+'\" data-n=\"'+esc(name)+'\">儲存說明</button><span class=\"ns\">'+tip+'</span></div></details>'}\nasync function saveNoteBtn(btn){\n  var box=btn.closest('.ned'),ta=box.querySelector('[data-nt]'),st=box.querySelector('.ns'),text=ta.value.trim().slice(0,2000);\n  if(!text){st.textContent='說明不能是空的';return}\n  applyNote(btn.dataset.nsave,btn.dataset.p,btn.dataset.n,text);\n  if(!SQLJS&&!PARTS){st.textContent='✓ 已更新畫面（只在這次瀏覽有效，沒有寫進任何檔案）';return}\n  st.textContent='寫入中…';\n  try{var n=await (PARTS?partsWriteNote:writeNote)(btn.dataset.nsave,btn.dataset.p,btn.dataset.n,text);st.textContent='✓ 已存進 '+NOTES_PATH+'（'+n+' 位元組）'}\n  catch(e){st.textContent='⚠️ 畫面已更新，但沒寫進資料夾：'+(e&&e.message||e)}}\n/* ---- 原始碼檢視器（沿用簡報的 code 元件 AiChatDeckCode；不需要載入任何模型）---- */\nvar SV={v:null,drag:null,path:'',line:0};\nfunction svMsg(t,pick){var m=$('#sv-msg');m.hidden=!t;m.textContent=t||'';$('#sv-pick').hidden=!pick}\nfunction svSize(){var c=$('#sv-c'),d=window.devicePixelRatio||1,w=c.clientWidth,h=c.clientHeight;if(c.width!==Math.round(w*d)||c.height!==Math.round(h*d)){c.width=Math.round(w*d);c.height=Math.round(h*d)}}\nfunction svDraw(){var c=$('#sv-c');if(!SV.v||$('#srcv').hidden)return;svSize();var d=window.devicePixelRatio||1,x=c.getContext('2d');x.setTransform(d,0,0,d,0,0);x.clearRect(0,0,c.clientWidth,c.clientHeight);SV.v.draw(x,{x:0,y:0,w:c.clientWidth,h:c.clientHeight},0)}\nfunction svClose(){$('#srcv').hidden=true;SV.v=null}\nasync function openSrc(path,line,end){\n  SV.path=path;SV.line=line;SV.v=null;$('#srcv').hidden=false;$('#sv-t').textContent=path+(line?':'+line:'');$('#sv-s').textContent='';svMsg('',false);\n  var c=$('#sv-c');c.getContext('2d').clearRect(0,0,c.width,c.height);\n  try{await ensureRoot()}catch(e){svMsg((e&&e.name==='AbortError')?'沒有選資料夾，所以看不到原始碼。':'無法讀取專案資料夾：'+(e&&e.message||e),true);return}\n  var text;try{text=await readSrc(path)}catch(e){svMsg('讀不到 '+path+'（'+(e&&e.name||'錯誤')+'）。請確認選的是專案根目錄——索引裡的路徑是相對於它的。',true);return}\n  var hi=line?[[line,end||line]]:[];\n  SV.v=AiChatDeckCode.create({code:text,filename:path,size:15,highlight:hi,start_line:Math.max(1,line-4)});\n  $('#sv-s').textContent=SV.v.rows.length+' 行'+(SV.v.cut?'（太長，只顯示前面一段）':'');\n  svDraw();svDraw()}\nfunction initSrcView(){\n  var c=$('#sv-c');\n  function pos(e){var r=c.getBoundingClientRect();return {x:e.clientX-r.left,y:e.clientY-r.top}}\n  $('#sv-x').onclick=svClose;$('#srcv').onmousedown=function(e){if(e.target===this)svClose()};\n  $('#sv-pick').onclick=function(){openSrc(SV.path,SV.line)};\n  c.addEventListener('wheel',function(e){if(!SV.v)return;e.preventDefault();var k=e.deltaMode===1?20:1;SV.v.scrollBy(e.shiftKey?e.deltaY*k:e.deltaX*k,e.shiftKey?0:e.deltaY*k);svDraw()},{passive:false});\n  c.addEventListener('mousedown',function(e){if(!SV.v)return;var p=pos(e),a=SV.v.hitThumb(p.x,p.y);if(a){SV.drag={a:a,p:a==='y'?p.y:p.x};e.preventDefault()}});\n  window.addEventListener('mousemove',function(e){if(!SV.drag||!SV.v)return;var p=pos(e),cur=SV.drag.a==='y'?p.y:p.x;SV.v.dragThumb(SV.drag.a,cur-SV.drag.p);SV.drag.p=cur;svDraw()});\n  window.addEventListener('mouseup',function(){if(SV.drag&&SV.v)SV.v.endDrag();SV.drag=null});\n  window.addEventListener('resize',svDraw);\n  document.addEventListener('keydown',function(e){if($('#srcv').hidden)return;\n    if(e.key==='Escape'){svClose();return}if(!SV.v)return;var h=c.clientHeight;\n    var m={PageDown:[0,h*0.85],PageUp:[0,-h*0.85],ArrowDown:[0,40],ArrowUp:[0,-40],ArrowRight:[40,0],ArrowLeft:[-40,0]}[e.key];\n    if(m){e.preventDefault();SV.v.scrollBy(m[0],m[1]);svDraw()}else if(e.key==='Home'){e.preventDefault();SV.v.scrollBy(-1e9,-1e9);svDraw()}else if(e.key==='End'){e.preventDefault();SV.v.scrollBy(0,1e9);svDraw()}});\n}\n/* ---- 分段匯出模式（資料庫不在頁面裡：授權專案資料夾後，用 sqlite-wasm 唯讀開 .export.parts/ 的分段檔，只讀查詢碰到的頁面）---- */\nvar PARTS=CFG.mode==='parts',ENG=null,DBH=null,MAN=null,PARTS_DIR='.floating-assistant/index/.export.parts/',NOTES={files:{},syms:{}};\nasync function qrows(sql,bind,limit){var r=await ENG.call('exec',{db:DBH,sql:sql,bind:bind||[],limit:limit||500});var x=r.results&&r.results[0];if(x&&x.error)throw new Error(x.error);return x?x.rows:[]}\nfunction showFileX(v){return PARTS?showFileP(v):showFile(v)}function showSymX(v){return PARTS?showSymP(v):showSym(v)}\nfunction ftsTokens(q){var t=(typeof _faSemTokens==='function'?_faSemTokens(q):String(q).toLowerCase().split(/\\W+/)).map(function(x){return String(x).replace(/[^A-Za-z0-9_一-鿿]/g,'_')}).filter(Boolean);return t.slice(0,12).map(function(x){return '\"'+x.replace(/\"/g,'\"\"')+'\"'}).join(' OR ')}\nasync function bootParts(){\n  $('#ttl').textContent=CFG.title;var P=JSON.parse(document.getElementById('payload').textContent);\n  setLoad('解壓縮 sqlite-wasm…',5);\n  var js=new TextDecoder().decode(await gunzip(b64u8(P.js),CFG.sql.gz.js)),wasm=await gunzip(b64u8(P.wasm),CFG.sql.gz.wasm);\n  ENG=new FaWasmEngine.WasmSqlEngine({url:URL.createObjectURL(new Blob([js],{type:'application/javascript'})),wasmUrl:URL.createObjectURL(new Blob([wasm],{type:'application/wasm'}))});\n  await fapInit();\n  while(FAP.perm!=='granted'){\n    $('#lmsg').innerHTML='這是<b>分段匯出</b>：資料庫不在這個頁面裡，而是在專案資料夾的 <code>'+PARTS_DIR+'</code>。<br>請授權專案資料夾（選專案根目錄）。<br><button class=\"b\" id=\"ldpick\" style=\"margin-top:10px\">📁 授權專案資料夾</button><div class=\"err\" id=\"lderr\" style=\"margin-top:8px\"></div>';\n    await new Promise(function(res){$('#ldpick').onclick=async function(){try{await ensureRoot()}catch(e){$('#lderr').textContent=(e&&e.name==='AbortError')?'沒有選資料夾':String(e&&e.message||e)}res()}});\n  }\n  setLoad('讀取分段清單…',15);\n  var mf;try{mf=await (await fapFile(PARTS_DIR+'manifest.json')).getFile()}catch(e){throw new Error('找不到 '+PARTS_DIR+'manifest.json：這個資料夾沒有匯出完（匯出到一半失敗），或選錯了資料夾（要選專案根目錄）。')}\n  MAN=JSON.parse(await mf.text());\n  if(MAN.exportId!==CFG.exportId)throw new Error('這個頁面與資料夾裡的分段檔不是同一次匯出（頁面 '+CFG.exportId+'／資料夾 '+MAN.exportId+'）。請用資料夾裡的 viewer.html，或重新匯出。');\n  var files=[];\n  for(var i=0;i<MAN.parts.length;i++){setLoad('檢查分段 '+(i+1)+'／'+MAN.parts.length+'…',15+40*(i+1)/MAN.parts.length);\n    var f;try{f=await (await fapFile(PARTS_DIR+MAN.parts[i].name)).getFile()}catch(e){throw new Error('分段檔遺失：'+MAN.parts[i].name+'（任何一段遺失就開不起來，請重新匯出）')}\n    if(f.size!==MAN.parts[i].size)throw new Error('分段檔大小不符：'+MAN.parts[i].name+'（預期 '+MAN.parts[i].size+'、實際 '+f.size+'）。檔案遺失或被改過，請重新匯出。');files.push(f)}\n  setLoad('開啟資料庫（唯讀，只讀查詢碰到的頁面）…',70);\n  var o=await ENG.call('open',{file:new Blob(files),label:'index.sqlite3',readonly:true});DBH=o.db;\n  PAGES=MAN.pages||[];GLOSS=MAN.glossary||{};Object.assign(FOLD,MAN.folderNotes||{});\n  var n=await qrows('select (select count(*) from files),(select count(*) from symbols)');\n  $('#load').style.display='none';$('#app').style.display='flex';\n  $('#stat').textContent=n[0][0]+' 個檔案 · '+n[0][1]+' 個定義 · 分段 '+MAN.parts.length+' 份（'+Math.round(MAN.size/1048576)+' MB）'+(MAN.complete?'':' · （部分索引）')+' · 產生於 '+new Date(MAN.created).toLocaleString();\n  var tabs=[['wiki','百科'],['files','檔案'],['syms','符號'],['ask','問答 ▸'],['sql','SQL']];\n  $('#nav').innerHTML=tabs.map(function(t){return '<button data-t=\"'+t[0]+'\">'+t[1]+'</button>'}).join('');\n  $('#nav').onclick=function(e){var b=e.target.closest('button');if(b)show(b.dataset.t)};\n  initWiki();initFilesP();initSymsP();initAskP();initSqlP();initDock();initSrcView();\n  show('wiki');fapStatus();await fapNotesPull();\n}\n/* 檔案：依資料夾一層一層展開（每次只查那一層） */\nasync function dirChildren(d){\n  var L=d?d.length+1:0,pre=d?d+'/':'',sub,fl;\n  if(d)sub=await qrows(\"select distinct case when instr(substr(dir,?),'/')>0 then substr(dir,?,instr(substr(dir,?),'/')-1) else substr(dir,?) end from files where dir like ? escape '\\\\' and length(dir)>?\",[L+1,L+1,L+1,L+1,pre.replace(/[\\\\%_]/g,'\\\\$&')+'%',L]);\n  else sub=await qrows(\"select distinct case when instr(dir,'/')>0 then substr(dir,1,instr(dir,'/')-1) else dir end from files where dir<>''\");\n  fl=await qrows('select path,name,nsyms from files where dir=? order by name limit 500',[d||'']);\n  return {dirs:sub.map(function(r){return r[0]}).filter(Boolean).sort(),files:fl}}\nfunction dirHtml(d,c){var h='';c.dirs.forEach(function(n){var p=d?d+'/'+n:n;h+='<details data-d=\"'+esc(p)+'\"><summary>'+esc(n)+'/ <a class=\"src\" data-go=\"folder:'+esc(p)+'\" title=\"這個資料夾的說明\">ⓘ</a></summary><div class=\"lz\"><span class=\"mut\">…</span></div></details>'});\n  c.files.forEach(function(r){h+='<a data-go=\"file:'+esc(r[0])+'\">'+esc(r[1])+'<span class=\"k\">'+r[2]+'</span></a>'});return h}\nasync function initFilesP(){\n  var c0=await dirChildren('');$('#fl').innerHTML=dirHtml('',c0);\n  $('#fl').addEventListener('toggle',async function(e){var d=e.target;if(!d.open||!d.dataset||d.dataset.d==null||d.dataset.loaded)return;d.dataset.loaded='1';\n    try{var c=await dirChildren(d.dataset.d);d.querySelector('.lz').innerHTML=dirHtml(d.dataset.d,c)||'<span class=\"mut\">（空）</span>'}catch(x){d.querySelector('.lz').innerHTML='<span class=\"err\">'+esc(x.message)+'</span>'}},true);\n  var tm=null;$('#fq').oninput=function(){clearTimeout(tm);tm=setTimeout(async function(){var q=$('#fq').value.trim();\n    if(!q){$('#fl').innerHTML=dirHtml('',c0);return}\n    var r=await qrows(\"select path from files where path like ? escape '\\\\' order by length(path) limit 200\",['%'+q.replace(/[\\\\%_]/g,'\\\\$&')+'%']);\n    $('#fl').innerHTML=r.map(function(x){return '<a data-go=\"file:'+esc(x[0])+'\">'+esc(x[0])+'</a>'}).join('')||'<div class=\"mut\" style=\"padding:8px\">沒有符合的檔案</div>'},250)};\n  $('#fm').innerHTML='<h1 class=\"t\">檔案</h1><div class=\"mut\">左邊一層一層展開資料夾（只查那一層），或搜尋路徑。</div>';\n}\nasync function showFileP(path){\n  var r=await qrows('select id,lang,lines,doc,note,nsyms,refs,used from files where path=?',[path]);\n  if(!r.length){$('#fm').innerHTML='<div class=\"note\">索引裡沒有這個檔案</div>';return}\n  var f=r[0],id=f[0],note=NOTES.files[path]||f[4]||'';\n  var syms=await qrows('select name,kind,line,doc,sig,note from symbols where file_id=? order by id limit 400',[id]);\n  var out=await qrows('select f.path from imports i join files f on f.id=i.dst where i.src=? limit 200',[id]);\n  var inn=await qrows('select f.path from imports i join files f on f.id=i.src where i.dst=? limit 200',[id]);\n  var called=await qrows('select distinct s.name,f2.path,s.line from uses u join symbols s on s.id=u.symbol_id join files f2 on f2.id=s.file_id where u.file_id=? limit 200',[id]);\n  var h='<h1 class=\"t\">'+esc(path)+'</h1><div><span class=\"tag\">'+esc(f[1])+'</span><span class=\"tag\">'+f[2]+' 行</span></div>';\n  h+=noteView('檔案說明',note)+noteEditor('file',path,'',note)+'<div style=\"margin:4px 0\"><a class=\"l\" data-src=\"'+esc(path)+'\">🧾 看原始碼</a>'+explainBtn('file',path,'')+'</div>';\n  if(f[3])h+='<p>'+esc(f[3])+'</p>';\n  h+='<h2>定義（'+f[5]+'）</h2>';\n  if(syms.length){h+='<table>';syms.forEach(function(s){var sn=NOTES.syms[path+'\\u0000'+s[0]]||s[5];h+='<tr><td>'+slink(s[0])+'</td><td><span class=\"tag\">'+esc(s[1])+'</span></td><td>第 '+s[2]+' 行 '+srcLink(path+':'+s[2])+explainBtn('fn',path,s[0])+'</td><td>'+(sn?noteFold(sn):'')+(s[3]?esc(s[3])+'<br>':'')+(s[4]?'<code>'+esc(s[4])+'</code>':'')+'</td></tr>'});h+='</table>'}else h+='<div class=\"mut\">（沒有抽到定義）</div>';\n  h+='<h2>引用了誰（'+out.length+'）</h2>'+(out.length?out.map(function(k){return '<div>'+link(k[0])+'</div>'}).join(''):'<div class=\"mut\">（沒有內部引用）</div>');\n  h+='<h2>被誰引用（'+inn.length+'）</h2>'+(inn.length?inn.map(function(k){return '<div>'+link(k[0])+'</div>'}).join(''):'<div class=\"mut\">（沒有已分析的檔案引用它）</div>');\n  if(called.length)h+='<h2>呼叫了別處的定義（'+called.length+'）</h2>'+called.map(function(s){return '<div>'+slink(s[0])+' <span class=\"mut\">'+esc(s[1])+':'+s[2]+'</span></div>'}).join('');\n  $('#fm').innerHTML=h;$('#fm').scrollTop=0}\nasync function symRows(where,bind,limit){return qrows('select s.id,s.name,s.kind,f.path,s.line,s.doc,s.sig,s.note,s.used_by from symbols s join files f on f.id=s.file_id where '+where,bind,limit||300)}\nasync function initSymsP(){\n  $('#sk').style.display='none';\n  async function render(){var q=$('#sq').value.trim(),rows=[];\n    if(!q)rows=await symRows('1=1 order by s.used_by desc limit 200',[]);\n    else{rows=await symRows(\"s.name like ? escape '\\\\' collate nocase order by s.used_by desc limit 150\",[q.replace(/[\\\\%_]/g,'\\\\$&')+'%']);\n      var ft=ftsTokens(q);if(ft){try{var ids=(await qrows('select rowid from sym_fts where sym_fts match ? order by rank limit 100',[ft])).map(function(r){return r[0]});\n        if(ids.length){var more=await symRows('s.id in ('+ids.join(',')+')',[]);var seen={};rows.forEach(function(r){seen[r[0]]=1});more.forEach(function(r){if(!seen[r[0]])rows.push(r)})}}catch(e){}}}\n    var seenN={};$('#sl').innerHTML=rows.filter(function(r){return !seenN[r[1]+r[3]]&&(seenN[r[1]+r[3]]=1)}).slice(0,300).map(function(r){return '<a data-go=\"sym:'+esc(r[1])+'\">'+esc(r[1])+'<span class=\"k\">'+esc(r[2])+' · '+esc(r[3].split('/').pop())+'</span></a>'}).join('')||'<div class=\"mut\" style=\"padding:8px\">沒有符合的結果</div>'}\n  var tm=null;$('#sq').oninput=function(){clearTimeout(tm);tm=setTimeout(render,250)};await render();\n  $('#sm').innerHTML='<h1 class=\"t\">符號</h1><div class=\"mut\">依名稱開頭與全文索引搜尋（不載入整個符號表）。沒搜尋時列「被用到最多」的前 200 個。</div>';\n}\nasync function showSymP(name){\n  var rows=await symRows('s.name=? collate nocase order by s.used_by desc limit 12',[name]),via='';\n  if(!rows.length&&symTail(name)!==name){var t0=symTail(name);rows=await symRows('s.name=? collate nocase order by s.used_by desc limit 12',[t0]);if(rows.length)via=viaNote(name,t0)}\n  if(!rows.length){navFail('索引裡沒有');var tl=symTail(name),hr=[];\n    try{hr=(await symRows('s.name like ? collate nocase order by s.used_by desc limit 60',['%'+tl])).filter(function(r){return String(r[1]).split(/[.:]+/).pop().toLowerCase()===tl.toLowerCase()}).map(function(r){return [r[1],r[2],r[3],r[4]]})}catch(e){}\n    $('#sm').innerHTML=symMissHtml(name,hr);return}\n  var h=via+'<h1 class=\"t\">'+esc(rows[0][1])+'</h1><div class=\"mut\">'+rows.length+' 個定義</div>';\n  for(var i=0;i<rows.length;i++){var s=rows[i],note=NOTES.syms[s[3]+'\\u0000'+s[1]]||s[7]||'';\n    h+='<h2>'+esc(s[2])+'　'+link(s[3],s[3]+':'+s[4])+srcLink(s[3]+':'+s[4])+explainBtn('fn',s[3],s[1])+'</h2>'+noteView('說明',note)+noteEditor('sym',s[3],s[1],note);\n    h+=s[5]?'<p>'+esc(s[5])+'</p>':(note?'':'<p class=\"mut\">'+esc(_faCodeNameGuess(s[1]))+'</p>');if(s[6])h+='<pre>'+esc(s[6])+'</pre>';\n    var us=await qrows('select distinct f.path from uses u join files f on f.id=u.file_id where u.symbol_id=? limit 30',[s[0]]);\n    if(us.length)h+='<div><b>被這些檔案呼叫／使用（'+us.length+(us.length>=30?'+':'')+'）：</b> '+us.map(function(u){return link(u[0])}).join('、')+'</div>';\n    var same=await qrows('select name from symbols where file_id=(select file_id from symbols where id=?) and id<>? limit 15',[s[0],s[0]]);\n    if(same.length)h+='<div style=\"margin-top:4px\"><b>同檔案的其他定義：</b> '+same.map(function(x){return slink(x[0])}).join('、')+'</div>'}\n  $('#sm').innerHTML=h;$('#sm').scrollTop=0}\n/* 問答（結構由 SQL 查：名稱、全文召回、呼叫關係；沒有載入模型時就是這個答案） */\nfunction initAskP(){\n  var ex=['誰用到 main','where is main defined','解析設定檔相關的函式','錯誤處理相關的程式'];\n  $('#achips').innerHTML=ex.map(function(x){return '<span>'+esc(x)+'</span>'}).join('');\n  $('#achips').onclick=function(e){if(e.target.tagName==='SPAN'){$('#aq').value=e.target.textContent;ask()}};\n  $('#ago').onclick=ask;$('#aq').onkeydown=function(e){if(e.key==='Enter')ask()};\n}\nasync function askP(q){\n  var t0=performance.now(),ids=(q.match(/[A-Za-z_][A-Za-z0-9_]{2,}/g)||[]).filter(function(x,i,a){return a.indexOf(x)===i}).slice(0,6);\n  var who=/誰.*(用|呼叫)|被誰|who\\s+(uses|calls)|used\\s+by|callers?/i.test(q),where=/在哪|哪裡|where|定義|defined/i.test(q),what=/做什麼|是什麼|用途|what\\s+(does|is)|purpose/i.test(q);\n  var md=[],ev=[],intent='search',hit=0;\n  for(var i=0;i<ids.length&&hit<3;i++){var rows=await symRows('s.name=? collate nocase order by s.used_by desc limit 6',[ids[i]]);if(!rows.length)continue;hit++;\n    intent=who?'who':where?'where':what?'purpose':'about';\n    rows.forEach(function(s){ev.push({path:s[3],line:s[4]});var note=NOTES.syms[s[3]+'\\u0000'+s[1]]||s[7];md.push('**'+s[1]+'**（'+s[2]+'）定義在 `'+s[3]+':'+s[4]+'`'+(note?'\\n說明：'+note:(s[5]?'\\n說明：'+s[5]:''))+(s[6]&&!where?'\\n簽名：`'+s[6]+'`':''))});\n    if(who||what){var us=await qrows('select distinct f.path from uses u join symbols s on s.id=u.symbol_id join files f on f.id=u.file_id where s.name=? collate nocase limit 12',[ids[i]]);md.push(us.length?'被這些檔案使用（'+us.length+(us.length>=12?'+':'')+'）：'+us.map(function(u){return '`'+u[0]+'`'}).join('、'):'沒有已分析的檔案呼叫它。')}}\n  if(!hit){var ft=ftsTokens(q);if(ft){try{var sid=(await qrows('select rowid from sym_fts where sym_fts match ? order by rank limit 8',[ft])).map(function(r){return r[0]});\n      if(sid.length){(await symRows('s.id in ('+sid.join(',')+')',[])).forEach(function(s){ev.push({path:s[3],line:s[4]});md.push('- **'+s[1]+'**（'+s[2]+'）`'+s[3]+':'+s[4]+'`'+((NOTES.syms[s[3]+'\\u0000'+s[1]]||s[7]||s[5])?'：'+(NOTES.syms[s[3]+'\\u0000'+s[1]]||s[7]||s[5]):''))})}\n      var fid=(await qrows('select rowid from file_fts where file_fts match ? order by rank limit 5',[ft])).map(function(r){return r[0]});\n      if(fid.length){var fr=await qrows('select path,doc,note from files where id in ('+fid.join(',')+')',[]);md.push('相關檔案：');fr.forEach(function(f){md.push('- `'+f[0]+'`'+((NOTES.files[f[0]]||f[2]||f[1])?'：'+(NOTES.files[f[0]]||f[2]||f[1]):''))})}}catch(e){md.push('全文查詢失敗：'+e.message)}}}\n  if(!md.length)md.push('索引裡找不到相關的定義或檔案。試試換個說法，或直接寫函式名稱。');\n  return {answer:md.join('\\n\\n'),intent:intent,evidence:ev,ms:Math.round(performance.now()-t0)}}\nfunction initSqlP(){\n  var EX=[['被引用最多的檔案',\"SELECT path, used AS 被引用數, refs AS 引用數 FROM files ORDER BY used DESC LIMIT 30\"],\n    ['某檔案引用了誰（改檔名）',\"SELECT f2.path FROM imports i JOIN files f1 ON f1.id=i.src JOIN files f2 ON f2.id=i.dst WHERE f1.path LIKE '%main%' LIMIT 100\"],\n    ['某符號的使用者（改名稱）',\"SELECT DISTINCT f.path FROM uses u JOIN symbols s ON s.id=u.symbol_id JOIN files f ON f.id=u.file_id WHERE s.name='main' LIMIT 100\"],\n    ['最常被呼叫的函式',\"SELECT s.name, f.path, s.used_by FROM symbols s JOIN files f ON f.id=s.file_id ORDER BY s.used_by DESC LIMIT 30\"],\n    ['各語言統計',\"SELECT lang, COUNT(*) AS 檔案數, SUM(lines) AS 行數 FROM files GROUP BY lang ORDER BY 行數 DESC\"],\n    ['全文搜尋符號（改關鍵字）',\"SELECT s.name, f.path, s.line FROM symbols s JOIN files f ON f.id=s.file_id WHERE s.id IN (SELECT rowid FROM sym_fts WHERE sym_fts MATCH '\\\"config\\\"') LIMIT 50\"]];\n  $('#qex').innerHTML='<option value=\"\">範例查詢…</option>'+EX.map(function(x,i){return '<option value=\"'+i+'\">'+esc(x[0])+'</option>'}).join('');\n  $('#qex').onchange=function(){if(this.value!=='')$('#qsql').value=EX[this.value][1]};$('#qsql').value=EX[0][1];\n  $('#qrun').onclick=runSqlP;$('#qsql').onkeydown=function(e){if(e.key==='Enter'&&(e.ctrlKey||e.metaKey)){e.preventDefault();runSqlP()}};\n  $('#qcsv').onclick=function(){if(!LASTCOLS.length)return;var csv=[LASTCOLS].concat(LASTROWS).map(function(r){return r.map(function(c){c=c==null?'':String(c);return /[\",\\n]/.test(c)?'\"'+c.replace(/\"/g,'\"\"')+'\"':c}).join(',')}).join('\\n');var a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv'}));a.download='query.csv';a.click()};\n  qrows(\"select sql from sqlite_master where sql is not null and name not like 'sqlite_%' and type='table' order by name\").then(function(r){$('#qschema').textContent=r.map(function(x){return x[0]+';'}).join('\\n\\n')}).catch(function(){});\n}\nasync function runSqlP(){var sql=$('#qsql').value.trim();if(!sql)return;var t0=performance.now();\n  if(!/^\\s*(select|with|pragma\\s+table_info|explain)\\b/i.test(sql)){$('#qres').innerHTML='<div style=\"padding:10px\" class=\"err\">分段匯出的資料庫是唯讀的，只能執行 SELECT／WITH。</div>';return}\n  try{var res=await ENG.call('exec',{db:DBH,sql:sql,limit:5000});var x=res.results[0];if(x&&x.error)throw new Error(x.error);var ms=Math.round(performance.now()-t0);\n    if(!x||!x.columns.length){$('#qres').innerHTML='<div style=\"padding:10px\" class=\"mut\">執行完成，沒有回傳資料列。</div>';$('#qinfo').textContent=ms+' ms';LASTCOLS=[];LASTROWS=[];return}\n    LASTCOLS=x.columns;LASTROWS=x.rows;var max=500;\n    $('#qres').innerHTML='<table><tr>'+x.columns.map(function(c){return '<th>'+esc(c)+'</th>'}).join('')+'</tr>'+x.rows.slice(0,max).map(function(row){return '<tr>'+row.map(function(c,ci){var t=c==null?'':String(c);var lk=/path|file/i.test(x.columns[ci])&&t&&t.indexOf('/')>=0;return '<td>'+(lk?'<a class=\"l\" data-go=\"file:'+esc(t)+'\">'+esc(t)+'</a>':esc(t))+'</td>'}).join('')+'</tr>'}).join('')+'</table>';\n    $('#qinfo').textContent=x.rows.length+' 列'+(x.rows.length>=5000?'（最多取 5000 列）':'')+(x.rows.length>max?'（畫面只顯示前'+max+'列，CSV是完整的）':'')+' · '+ms+' ms'}\n  catch(e){$('#qres').innerHTML='<div style=\"padding:10px\" class=\"err\">'+esc(e.message||e)+'</div>';$('#qinfo').textContent=''}}\n/* 分段模式的說明庫：notes.sqlite3 用同一個引擎讀寫（開成記憶體資料庫、改完整個匯出再寫回） */\nasync function partsNotesPull(){\n  var u8;try{u8=new Uint8Array(await (await (await fapFile(NOTES_PATH)).getFile()).arrayBuffer())}catch(e){return}\n  var c=await ENG.call('open',{bytes:u8,readonly:true,label:'notes.sqlite3'});\n  try{var g=async function(sql){var r=await ENG.call('exec',{db:c.db,sql:sql,limit:100000});return (r.results[0]&&r.results[0].rows)||[]};\n    (await g('SELECT path,note FROM file_notes')).forEach(function(r){NOTES.files[r[0]]=r[1]});\n    (await g('SELECT path,name,note FROM sym_notes')).forEach(function(r){NOTES.syms[r[0]+'\\u0000'+r[1]]=r[2]});\n    (await g('SELECT term,definition FROM glossary')).forEach(function(r){GLOSS[r[0]]={definition:r[1]}});\n  }finally{await ENG.call('close',{db:c.db})}\n  if(CURF)showFileP(CURF);if(CURS)showSymP(CURS)}\nasync function partsWriteNote(kind,path,name,text){\n  await ensureRoot();var u8=null;\n  try{u8=new Uint8Array(await (await (await fapFile(NOTES_PATH)).getFile()).arrayBuffer())}catch(e){u8=null}\n  var c=await ENG.call('open',(u8&&u8.length)?{bytes:u8,label:'notes.sqlite3'}:{label:'notes.sqlite3'}),out;\n  try{var ex=function(sql,bind){return ENG.call('exec',{db:c.db,sql:sql,bind:bind||[]}).then(function(r){var x=r.results[0];if(x&&x.error)throw new Error(x.error)})};\n    for(var i=0;i<(CFG.notesDdl||[]).length;i++)await ex(CFG.notesDdl[i]);var now=Date.now();\n    if(kind==='file')await ex('INSERT INTO file_notes(path,note,author,ts,hash) VALUES(?,?,?,?,NULL) ON CONFLICT(path) DO UPDATE SET note=excluded.note,author=excluded.author,ts=excluded.ts,hash=NULL',[path,text,'user',now]);\n    else await ex('INSERT INTO sym_notes(path,name,note,author,ts,hash) VALUES(?,?,?,?,?,NULL) ON CONFLICT(path,name) DO UPDATE SET note=excluded.note,author=excluded.author,ts=excluded.ts,hash=NULL',[path,name,text,'user',now]);\n    await ex(\"INSERT INTO meta(k,v) VALUES('notes_ver',?) ON CONFLICT(k) DO UPDATE SET v=excluded.v\",[String(now)]);\n    out=(await ENG.call('export',{db:c.db})).bytes;\n  }finally{await ENG.call('close',{db:c.db})}\n  var wf=await fapFile(NOTES_PATH,true),w=await wf.createWritable();await w.write(out);await w.close();\n  try{await (await fapFile('.floating-assistant/index/.gitignore')).getFile()}catch(e){try{var gw=await (await fapFile('.floating-assistant/index/.gitignore',true)).createWritable();await gw.write('*\\n');await gw.close()}catch(e2){}}\n  return out.length}\n/* ---- 解釋：檔案用途／函式做什麼（語法樹＋基礎函式語意在頁面裡跑；離線模型只負責措辭）---- */\nvar AI={pack:null,beh:null,ex:null,eng:null,wk:null,loaded:null,tid:0,pending:{},busy:false},FOLD={};\nfunction aiOn(){return !!CFG.ai}\nfunction aiUseModel(){try{return localStorage.getItem('aidoc-export-ai-model')!=='0'}catch(e){return true}}\nasync function cfetch(url,bin){ // 先看瀏覽器快取（file:// 沒有 Cache API 時直接抓）\n  var c=null;try{c=await caches.open('aidoc-export-ai');var m=await c.match(url);if(m)return bin?new Uint8Array(await m.arrayBuffer()):await m.text()}catch(e){c=null}\n  var r=await fetch(url);if(!r.ok)throw new Error('下載失敗（HTTP '+r.status+'）：'+url);var cl=r.clone();\n  var out=bin?new Uint8Array(await r.arrayBuffer()):await r.text();try{if(c)await c.put(url,cl)}catch(e){}return out}\nasync function aiPack(){\n  if(AI.ex)return;if(!CFG.ai)throw new Error('這份匯出沒有內嵌解釋功能（匯出時關掉了，或沒有設定離線文字模型）');\n  var pk=JSON.parse(new TextDecoder().decode(await gunzip(b64u8(document.getElementById('aipack').textContent.trim()),CFG.aiGz)));\n  AI.pack=pk;AI.beh=new Function(pk.beh2)();AI.ex=new Function('var module=undefined,self={};'+pk.explain+';return self.FaExplain')()}\nasync function aiTs(){\n  await aiPack();if(AI.eng)return;\n  var host={async loadTreeSitter(){if(!window.TreeSitter){var js=await cfetch(CFG.ai.tsBase+'tree-sitter.js');\n      await new Promise(function(res,rej){var u=URL.createObjectURL(new Blob([js],{type:'application/javascript'}));var s=document.createElement('script');s.src=u;s.onload=function(){URL.revokeObjectURL(u);res()};s.onerror=function(){rej(new Error('載入 tree-sitter 失敗'))};document.head.appendChild(s)})}\n      var w=await cfetch(CFG.ai.tsBase+'tree-sitter.wasm',true);var wu=URL.createObjectURL(new Blob([w],{type:'application/wasm'}));await window.TreeSitter.init({locateFile:function(){return wu}});return window.TreeSitter},\n    async loadLanguageWasm(n){return await cfetch(CFG.ai.tsLang+'tree-sitter-'+n+'.wasm',true)}};\n  AI.eng=AI.beh.create({patterns:AI.pack.behData.patterns,api:AI.pack.behData.api},host,{categories:{},api:{},idioms:{},notes:{},mnemonics:{}})}\nfunction aiWorker(){\n  if(AI.wk)return AI.wk;var u=URL.createObjectURL(new Blob([AI.pack.vlmWorker],{type:'text/javascript'}));var w=new Worker(u,{type:'module'});\n  w.onmessage=function(ev){var m=ev.data||{},p=AI.pending[m.tid];if(!p)return;if(m.type==='progress'){if(p.onp)p.onp(m.p);return}if(m.type==='stream')return;delete AI.pending[m.tid];if(m.type==='error')p.rej(new Error(m.error||'worker 錯誤'));else p.res(m)};\n  w.onerror=function(e){Object.keys(AI.pending).forEach(function(k){AI.pending[k].rej(new Error((e&&e.message)||'worker 錯誤'))});AI.pending={};AI.wk=null;AI.loaded=null};\n  return (AI.wk=w)}\nfunction aiRpc(type,payload,onp){var w=aiWorker(),tid=++AI.tid;return new Promise(function(res,rej){AI.pending[tid]={res:res,rej:rej,onp:onp};w.postMessage(Object.assign({type:type,tid:tid},payload))})}\nfunction fmtB(n){return n>=1048576?(n/1048576).toFixed(0)+' MB':Math.round(n/1024)+' KB'}\nasync function aiModel(onstat){\n  if(AI.loaded)return;var m=CFG.ai.model,order=(window.navigator.gpu?['webgpu','wasm']:['wasm']),err=[];\n  try{if(navigator.storage&&navigator.storage.persist)navigator.storage.persist()}catch(e){}\n  for(var i=0;i<order.length;i++){var dev=order[i],dt=m.dtype[dev==='webgpu'?'gpu':'cpu'];if(!dt)continue;\n    var files={},last=0;\n    try{await aiRpc('load',{libUrl:dev==='webgpu'?CFG.ai.libGpu:CFG.ai.libCpu,modelId:m.id,arch:m.arch,repo:m.repo,processorRepo:m.repo,dtype:dt,device:dev,threads:(dev==='wasm'&&typeof SharedArrayBuffer!=='undefined'&&window.crossOriginIsolated)?Math.max(1,Math.min(4,navigator.hardwareConcurrency||1)):1},function(p){\n        if(!p||!p.file)return;if(p.status==='progress'||p.status==='download')files[p.file]={l:+p.loaded||0,t:+p.total||0};else if(p.status==='done'){var f=files[p.file]||{l:0,t:0};files[p.file]={l:f.t||f.l,t:f.t||f.l}}\n        var now=Date.now();if(now-last<400)return;last=now;var l=0,t=0;Object.keys(files).forEach(function(k){l+=files[k].l;t+=files[k].t});if(t>0)onstat('下載離線模型（'+m.label+'）：'+fmtB(l)+' / '+fmtB(t)+'（只下載一次，存在瀏覽器快取）')});\n      AI.loaded=dev;return}\n    catch(e){err.push((dev==='webgpu'?'GPU':'CPU')+'：'+(e&&e.message||e));if(AI.wk){try{AI.wk.terminate()}catch(x){}AI.wk=null}}}\n  throw new Error('模型載入失敗：'+err.join('；'))}\nasync function aiGen(msgs,onstat){await aiModel(onstat);onstat('離線模型寫說明中…');var r=await aiRpc('chat',{messages:msgs,maxTokens:120,gen:CFG.ai.gen});return r.raw}\nasync function aiPolish(kind,d,span,onstat){var msgs=AI.ex.buildMessages(kind,d,{span:span,beh:AI.beh});var raw=await aiGen(msgs,onstat);return AI.ex.cleanModelNote(raw,d.name,msgs[msgs.length-1].content)}\nfunction explainBtn(kind,path,name){return aiOn()?' <button class=\"b s\" style=\"padding:1px 8px;font-size:12px\" data-ai=\"'+kind+'|'+esc(path)+'|'+esc(name||'')+'\" title=\"用語法樹與基礎函式語意查出它做什麼（離線；可再用離線模型潤飾）\">🧠 解釋</button>':''}\nfunction aiBox(btn){var host=btn.closest('h2')||btn.closest('td')||btn.parentNode;var box=host._aibox;if(!box){box=document.createElement('div');box.className='note aires';host._aibox=box;if(host.tagName==='H2')host.insertAdjacentElement('afterend',box);else host.appendChild(box)}return box}\nfunction aiShow(box,kind,path,name,note,source,facts,warn){\n  var lab={comment:'原始碼註解',auto:'自動分析（語法樹＋函式語意）',model:'離線模型（依語法樹事實潤飾）'}[source]||source;\n  box.innerHTML='<b>🧠 '+(kind==='file'?'檔案用途':kind==='folder'?'資料夾用途':'函式做什麼')+'</b>：'+esc(note)+' <span class=\"mut\">（來源：'+lab+'）</span>'+(warn?'<div class=\"mut\">⚠️ '+esc(warn)+'</div>':'')+'<details><summary class=\"mut\">依據（程式查到的事實）</summary><pre>'+esc((facts||[]).join('\\n'))+'</pre></details>'+noteEditor(kind==='fn'?'sym':'file',path,name,note);\n  var ed=box.querySelector('.ned');if(ed){ed.open=true;ed.querySelector('summary').textContent='✏️ 確認或修改後存成說明'}}\nasync function aiExplain(btn){\n  if(AI.busy)return;var p=btn.dataset.ai.split('|'),kind=p[0],path=p[1],name=p[2],box=aiBox(btn);AI.busy=true;btn.disabled=true;\n  var say=function(t){box.innerHTML='<span class=\"mut\">'+esc(t)+'</span>'};\n  try{\n    say('授權專案資料夾…');await ensureRoot();   // 需要使用者手勢，必須在載入模型之前\n    say('讀原始碼…');var text=await readSrc(path);\n    say('語法樹分析…（第一次要下載 tree-sitter，之後存在瀏覽器快取）');await aiTs();\n    var r;try{r=await AI.eng.explain(path,text,{notes:{}})}catch(e){throw new Error('語法樹分析失敗：'+(e&&e.message||e))}\n    var imp=0;try{imp=PARTS?0:((IX.impIn[fileMap[path]]||[]).length)}catch(e){}\n    var d=AI.ex.fromBehResult(r,{path:path,labels:AI.pack.labels,beh:AI.beh,importedBy:imp});\n    var item,span='';\n    if(kind==='file')item=Object.assign({},d.file,{name:path.split('/').pop()});\n    else{item=d.fns.filter(function(f){return f.name===name})[0];if(!item)throw new Error('語法樹裡找不到函式「'+name+'」（可能是巨集、宣告或這個語言的剖析器不認得）');var sp=extractSourceSpan(text,item.line,40);span=sp?sp.text:''}\n    aiShow(box,kind,path,name,item.note,item.source,item.facts);\n    if(item.source!=='comment'&&aiUseModel()){\n      try{var n2=await aiPolish(kind==='file'?'file':'fn',item,span,function(t){var s=box.querySelector('.aistat');if(!s){box.insertAdjacentHTML('afterbegin','<div class=\"aistat mut\"></div>');s=box.querySelector('.aistat')}s.textContent=t});\n        if(n2)aiShow(box,kind,path,name,n2,'model',item.facts);else{var s2=box.querySelector('.aistat');if(s2)s2.remove();aiShow(box,kind,path,name,item.note,item.source,item.facts,'離線模型的輸出不可用（空的、簡體、編造名稱或複述名稱），採用程式組出的說明')}}\n      catch(e){aiShow(box,kind,path,name,item.note,item.source,item.facts,'離線模型沒跑起來：'+(e&&e.message||e)+'。採用程式組出的說明')}}\n  }catch(e){box.innerHTML='<span class=\"err\">'+esc(e&&e.name==='AbortError'?'沒有選資料夾，所以讀不到原始碼。':(e&&e.message||e))+'</span>'}\n  finally{AI.busy=false;btn.disabled=false}}\n/* ---- 資料夾：名稱是連結，點進去看子檔案與子資料夾；說明只用子檔案已有的說明，不重新讀檔 ---- */\nasync function folderInfo(path){\n  var pre=path?path+'/':'',files=[],dirs={};\n  if(PARTS){var c=await dirChildren(path);dirs=c.dirs;\n    var rows=await qrows('select path,name,note,doc from files where dir=? order by name limit 300',[path]);files=rows.map(function(r){return {path:r[0],name:r[1],note:NOTES.files[r[0]]||r[2]||'',doc:r[3]||''}});\n    var tot=await qrows(\"select count(*) from files where dir=? or dir like ? escape '\\\\'\",[path,pre.replace(/[\\\\%_]/g,'\\\\$&')+'%']);return {files:files,dirs:dirs,total:tot[0][0]}}\n  var sub={},total=0;DB.files.forEach(function(f){if(f[0].indexOf(pre)!==0)return;total++;var rest=f[0].slice(pre.length),i=rest.indexOf('/');if(i<0)files.push({path:f[0],name:rest,note:f[4]||'',doc:f[3]||''});else sub[rest.slice(0,i)]=1});\n  return {files:files.slice(0,300),dirs:Object.keys(sub).sort(),total:total}}\nasync function showFolder(path){\n  var info=await folderInfo(path),key=path+'/',note=FOLD[key]||(PARTS&&NOTES.files[key])||'',box=PARTS?$('#fm'):$('#fm');\n  var h='<h1 class=\"t\">'+esc(path)+'/</h1><div class=\"mut\">'+info.files.length+' 個檔案、'+info.dirs.length+' 個子資料夾（含子孫共 '+info.total+' 個檔案）</div>';\n  h+=noteView('資料夾說明',note)+noteEditor('file',key,'',note);\n  if(aiOn())h+='<div style=\"margin:6px 0\"><button class=\"b s\" style=\"padding:1px 8px;font-size:12px\" data-aifolder=\"'+esc(path)+'\" title=\"只用子檔案已有的說明（文字重排挑代表句），不重新讀檔\">🧠 產生資料夾說明</button></div><div data-aifbox></div>';\n  if(info.dirs.length)h+='<h2>子資料夾</h2>'+info.dirs.map(function(d){return '<div><a class=\"l\" data-go=\"folder:'+esc(path?path+'/'+d:d)+'\">'+esc(d)+'/</a></div>'}).join('');\n  h+='<h2>檔案</h2>'+(info.files.length?'<table>'+info.files.map(function(f){var t=f.note||f.doc;return '<tr><td>'+link(f.path,f.name)+'</td><td>'+(f.note?'<b>'+esc(f.note)+'</b>':esc(t||'').slice(0,160)||'<span class=\"mut\">（沒有說明）</span>')+'</td></tr>'}).join('')+'</table>':'<div class=\"mut\">（沒有直接放在這層的檔案）</div>');\n  $('#fm').innerHTML=h;$('#fm').scrollTop=0;window.__folderInfo=info}\nasync function aiFolder(btn){\n  if(AI.busy)return;AI.busy=true;btn.disabled=true;var path=btn.dataset.aifolder,box=document.querySelector('[data-aifbox]'),info=window.__folderInfo;\n  var say=function(t){box.innerHTML='<span class=\"mut\">'+esc(t)+'</span>'};\n  try{say('載入解釋引擎…');await aiPack();\n    var files=info.files.filter(function(f){return f.note||f.doc}).map(function(f){var n=f.note||f.doc;return {name:f.name,note:String(n).split(/\\n/)[0],source:f.note?(/^（自動分析）/.test(f.note)?'auto':'comment'):'comment'}});\n    var d=AI.ex.describeFolder({path:path+'/',files:files,dirs:info.dirs,totalFiles:info.files.length,beh:AI.beh});var note=d.note,src='auto',warn='';\n    aiShow(box,'folder',path+'/','',note,src,d.facts);\n    if(files.length>=2&&aiUseModel()){try{var n2=await aiPolish('folder',d,'',function(t){var s=box.querySelector('.aistat');if(!s){box.insertAdjacentHTML('afterbegin','<div class=\"aistat mut\"></div>');s=box.querySelector('.aistat')}s.textContent=t});if(n2)aiShow(box,'folder',path+'/','',n2,'model',d.facts);else aiShow(box,'folder',path+'/','',note,src,d.facts,'離線模型的輸出不可用，採用程式組出的說明')}catch(e){aiShow(box,'folder',path+'/','',note,src,d.facts,'離線模型沒跑起來：'+(e&&e.message||e))}}\n  }catch(e){box.innerHTML='<span class=\"err\">'+esc(e&&e.message||e)+'</span>'}\n  finally{AI.busy=false;btn.disabled=false}}\n/* ---- SQL ---- */\nvar EXAMPLES=[\n['被最多檔案引用的檔案（Top 30）',\"SELECT path, imported_by_n AS 被引用數, imports_n AS 引用數 FROM files ORDER BY imported_by_n DESC LIMIT 30\"],\n['某檔案引用了誰／被誰引用（改 LIKE 裡的檔名）',\"SELECT 'imports' AS 方向, dst_path AS 檔案 FROM v_imports WHERE src_path LIKE '__FILE__'\\nUNION ALL\\nSELECT 'imported_by', src_path FROM v_imports WHERE dst_path LIKE '__FILE__'\"],\n['某檔案的所有間接依賴（遞迴）',\"WITH RECURSIVE dep(id, depth) AS (\\n  SELECT id, 0 FROM (SELECT id FROM files WHERE path LIKE '__FILE__' ORDER BY id LIMIT 1)\\n  UNION\\n  SELECT i.dst, dep.depth + 1 FROM imports i JOIN dep ON i.src = dep.id WHERE dep.depth < 6\\n)\\nSELECT f.path, MIN(dep.depth) AS 距離 FROM dep JOIN files f ON f.id = dep.id GROUP BY f.path ORDER BY 距離, f.path\"],\n['最常被呼叫的函式（依呼叫它的檔案數）',\"SELECT symbol AS 名稱, defined_in AS 定義在, COUNT(DISTINCT caller_file) AS 呼叫的檔案數 FROM v_uses GROUP BY symbol, defined_in ORDER BY 呼叫的檔案數 DESC LIMIT 30\"],\n['某個符號的所有使用者（改名稱）',\"SELECT DISTINCT caller_file AS 使用的檔案, defined_in AS 定義在 FROM v_uses WHERE symbol = '__SYM__'\"],\n['同名定義（可能衝突或多型）',\"SELECT name, COUNT(*) AS 個數, group_concat(path, '  |  ') AS 位置 FROM v_symbols GROUP BY name HAVING COUNT(*) > 1 ORDER BY 個數 DESC LIMIT 50\"],\n['定義最多的檔案',\"SELECT f.path, COUNT(*) AS 定義數 FROM symbols s JOIN files f ON f.id = s.file_id GROUP BY f.id ORDER BY 定義數 DESC LIMIT 30\"],\n['孤立檔案（沒人引用、也沒引用別人）',\"SELECT path, lines FROM files WHERE imports_n = 0 AND imported_by_n = 0 ORDER BY lines DESC LIMIT 100\"],\n['說明（註解）裡有某個關鍵字的定義',\"SELECT name, kind, path, line, doc FROM v_symbols WHERE doc LIKE '%config%' ORDER BY name LIMIT 50\"],\n['AI 補過說明的定義（note 欄位）',\"SELECT name, kind, path, line, note FROM v_symbols WHERE note IS NOT NULL AND note <> '' ORDER BY path, line LIMIT 100\"],\n['各目錄的檔案數與行數',\"SELECT dir AS 目錄, COUNT(*) AS 檔案數, SUM(lines) AS 總行數 FROM files GROUP BY dir ORDER BY 總行數 DESC LIMIT 40\"],\n['各語言統計',\"SELECT lang AS 語言, COUNT(*) AS 檔案數, SUM(lines) AS 行數 FROM files GROUP BY lang ORDER BY 行數 DESC\"]\n];\nfunction initSql(){\n  var hot='%',sym='main';\n  try{var a=SQLDB.exec('SELECT name FROM files ORDER BY imports_n+imported_by_n DESC LIMIT 1');if(a.length)hot='%'+a[0].values[0][0]+'%';var b=SQLDB.exec('SELECT symbol FROM v_uses GROUP BY symbol ORDER BY COUNT(*) DESC LIMIT 1');if(b.length)sym=b[0].values[0][0]}catch(e){}\n  EXAMPLES.forEach(function(x){x[1]=x[1].split('__FILE__').join(hot).split('__SYM__').join(sym)});\n  $('#qex').innerHTML='<option value=\"\">範例查詢…</option>'+EXAMPLES.map(function(x,i){return '<option value=\"'+i+'\">'+esc(x[0])+'</option>'}).join('');\n  $('#qex').onchange=function(){if(this.value!=='')$('#qsql').value=EXAMPLES[this.value][1]};\n  $('#qsql').value=EXAMPLES[0][1];\n  $('#qrun').onclick=runSql;$('#qsql').onkeydown=function(e){if(e.key==='Enter'&&(e.ctrlKey||e.metaKey)){e.preventDefault();runSql()}};\n  $('#qcsv').onclick=function(){if(!LASTCOLS.length)return;var csv=[LASTCOLS].concat(LASTROWS).map(function(r){return r.map(function(c){c=c==null?'':String(c);return /[\",\\n]/.test(c)?'\"'+c.replace(/\"/g,'\"\"')+'\"':c}).join(',')}).join('\\n');var a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv'}));a.download='query.csv';a.click()};\n  try{var sc=SQLDB.exec(\"SELECT name,sql FROM sqlite_master WHERE sql IS NOT NULL AND name NOT LIKE 'sqlite_%' ORDER BY type DESC,name\");$('#qschema').textContent=sc.length?sc[0].values.map(function(r){return r[1]+';'}).join('\\n\\n'):''}catch(e){}\n}\nfunction runSql(){var sql=$('#qsql').value.trim();if(!sql)return;var t0=performance.now();\n  try{var res=SQLDB.exec(sql);var ms=Math.round(performance.now()-t0);\n    if(!res.length){$('#qres').innerHTML='<div style=\"padding:10px\" class=\"mut\">執行完成，沒有回傳資料列。</div>';$('#qinfo').textContent=ms+' ms';LASTCOLS=[];LASTROWS=[];return}\n    var r=res[res.length-1];LASTCOLS=r.columns;LASTROWS=r.values;var max=500;\n    var h='<table><tr>'+r.columns.map(function(c){return '<th>'+esc(c)+'</th>'}).join('')+'</tr>'+r.values.slice(0,max).map(function(row){return '<tr>'+row.map(function(c,ci){var t=c==null?'':String(c);var col=r.columns[ci];var lk=(/path|file|defined_in|檔案|定義在|src_path|dst_path|caller/i.test(col)&&fileMap[t]!=null)?link(t):esc(t);return '<td>'+lk+'</td>'}).join('')+'</tr>'}).join('')+'</table>';\n    $('#qres').innerHTML=h;$('#qinfo').textContent=r.values.length+' 列'+(r.values.length>max?'（畫面只顯示前'+max+'列，CSV是完整的）':'')+' · '+ms+' ms'}\n  catch(e){$('#qres').innerHTML='<div style=\"padding:10px\" class=\"err\">'+esc(e.message||e)+'</div>';$('#qinfo').textContent=''}}\n(CFG.mode==='parts'?bootParts():boot()).catch(function(e){$('#lmsg').innerHTML='<span class=\"err\">載入失敗：'+esc(e&&e.message||e)+'</span>'});\n})();\n<\/script>\n</body></html>\n",FA_PYBRIDGE_FILES={"anthropic/__init__.py":'# -*- coding: utf-8 -*-\n"""\nanthropic（Claude）的「轉接版」：Floating AI Assistant 在執行技能包的 Python 腳本時提供。\n\n腳本照原本的寫法（同步或 async）：\n    from anthropic import Anthropic, AsyncAnthropic\n    client = Anthropic(api_key=...)\n    msg = client.messages.create(model="claude-...", max_tokens=1024, system="...", messages=[...], tools=[...])\n    print(msg.content[0].text)\n    with client.messages.stream(...) as s:\n        for t in s.text_stream: ...\n\n實際上不會連 Anthropic，而是把 Claude 格式的請求轉成 chat/completions，交給助理「已設定的 LLM Model 清單」裡的 Model\n（有 tools 就挑支援工具呼叫的、有圖片就挑支援讀圖的；腳本自己的 api_key、model 都忽略），再把回應轉回 Claude 的格式\n（content 區塊、stop_reason、usage、tool_use、串流事件）。所有 Model 都不支援該功能才丟 anthropic.NotSupportedError。\n"""\nimport json\nimport re\n\nimport fa_bridge\nimport fa_llm\n\n__version__ = "0.99.0+fa-bridge"\n\n\n# ---------------------------------------------------------------- 錯誤\nclass AnthropicError(Exception):\n    pass\n\n\nclass APIError(AnthropicError):\n    def __init__(self, message="", request=None, body=None, **kw):\n        super(APIError, self).__init__(message)\n        self.message = message\n        self.request = request\n        self.body = body\n\n\nclass APIStatusError(APIError):\n    status_code = 500\n\n    def __init__(self, message="", response=None, body=None, status_code=None, **kw):\n        super(APIStatusError, self).__init__(message, body=body)\n        self.response = response\n        if status_code:\n            self.status_code = status_code\n\n\nclass APIConnectionError(APIError):\n    pass\n\n\nclass APITimeoutError(APIConnectionError):\n    pass\n\n\nclass BadRequestError(APIStatusError):\n    status_code = 400\n\n\nclass AuthenticationError(APIStatusError):\n    status_code = 401\n\n\nclass PermissionDeniedError(APIStatusError):\n    status_code = 403\n\n\nclass NotFoundError(APIStatusError):\n    status_code = 404\n\n\nclass RateLimitError(APIStatusError):\n    status_code = 429\n\n\nclass InternalServerError(APIStatusError):\n    status_code = 500\n\n\nclass NotSupportedError(APIStatusError, NotImplementedError):\n    status_code = 501\n\n\n_CLS = {400: BadRequestError, 401: AuthenticationError, 403: PermissionDeniedError, 404: NotFoundError, 429: RateLimitError}\n\n\ndef _translate(e):\n    if isinstance(e, fa_bridge.NotSupported):\n        return NotSupportedError(str(e) or "沒有任何已設定的 LLM Model 支援這個功能")\n    msg = str(e)\n    m = re.search(r"API錯誤\\((\\d{3})\\)", msg)\n    if m:\n        c = int(m.group(1))\n        return (_CLS.get(c) or (InternalServerError if c >= 500 else APIStatusError))(msg, status_code=c)\n    if "逾時" in msg:\n        return APITimeoutError(msg)\n    return APIConnectionError(msg)\n\n\n# ---------------------------------------------------------------- 物件\nclass _Obj(object):\n    def __init__(self, d):\n        self.__dict__["_d"] = d\n\n    def __getattr__(self, k):\n        if k.startswith("__"):\n            raise AttributeError(k)\n        return _wrap(self.__dict__["_d"].get(k))\n\n    def __getitem__(self, k):\n        return _wrap(self.__dict__["_d"][k])\n\n    def get(self, k, default=None):\n        return _wrap(self.__dict__["_d"].get(k, default))\n\n    def to_dict(self, **kw):\n        return self.__dict__["_d"]\n\n    model_dump = to_dict\n\n    def to_json(self, **kw):\n        return json.dumps(self.__dict__["_d"], ensure_ascii=False)\n\n    model_dump_json = to_json\n\n    def __repr__(self):\n        return "<anthropic.%s %r>" % (self.__dict__["_d"].get("type", "obj"), self.__dict__["_d"])\n\n\ndef _wrap(v):\n    if isinstance(v, dict):\n        return _Obj(v)\n    if isinstance(v, list):\n        return [_wrap(x) for x in v]\n    return v\n\n\ndef _message(resp, model):\n    return fa_llm.chat_to_anthropic(resp, model)\n\n\n# ---------------------------------------------------------------- 串流管理員：messages.stream(...)\nclass MessageStream(object):\n    def __init__(self, msg):\n        self._m = msg\n        self._events = list(fa_llm.anthropic_events(msg))\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *a):\n        return False\n\n    def __iter__(self):\n        for e in self._events:\n            yield _Obj(e)\n\n    @property\n    def text_stream(self):\n        for e in self._events:\n            if e.get("type") == "content_block_delta" and e["delta"].get("type") == "text_delta":\n                yield e["delta"]["text"]\n\n    def get_final_message(self):\n        return _Obj(self._m)\n\n    def get_final_text(self):\n        return "".join(b.get("text", "") for b in self._m["content"] if b["type"] == "text")\n\n    def until_done(self):\n        return None\n\n\nclass AsyncMessageStream(object):\n    def __init__(self, awaitable_msg):\n        self._aw = awaitable_msg\n        self._m = None\n        self._events = []\n\n    async def __aenter__(self):\n        self._m = await self._aw\n        self._events = list(fa_llm.anthropic_events(self._m))\n        return self\n\n    async def __aexit__(self, *a):\n        return False\n\n    def __aiter__(self):\n        async def gen():\n            for e in self._events:\n                yield _Obj(e)\n        return gen()\n\n    @property\n    def text_stream(self):\n        async def gen():\n            for e in self._events:\n                if e.get("type") == "content_block_delta" and e["delta"].get("type") == "text_delta":\n                    yield e["delta"]["text"]\n        return gen()\n\n    async def get_final_message(self):\n        return _Obj(self._m)\n\n    async def get_final_text(self):\n        return "".join(b.get("text", "") for b in self._m["content"] if b["type"] == "text")\n\n\nclass Stream(object):\n    def __init__(self, events):\n        self._it = iter(events)\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        return _Obj(next(self._it))\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *a):\n        return False\n\n\nclass AsyncStream(object):\n    def __init__(self, events):\n        self._it = iter(events)\n\n    def __aiter__(self):\n        return self\n\n    async def __anext__(self):\n        try:\n            return _Obj(next(self._it))\n        except StopIteration:\n            raise StopAsyncIteration\n\n    async def __aenter__(self):\n        return self\n\n    async def __aexit__(self, *a):\n        return False\n\n\n# ---------------------------------------------------------------- 資源\ndef _build(A):\n    def prep(kw):\n        model = kw.get("model")\n        stream = kw.get("stream", False)\n        req = fa_llm.anthropic_to_chat(**{k: v for k, v in kw.items() if k != "stream"})\n        return model, stream, req\n\n    class Messages(object):\n        if A:\n            async def create(self, **kw):\n                model, stream, req = prep(kw)\n                try:\n                    r = await fa_llm.acomplete(req)\n                except Exception as e:\n                    raise _translate(e)\n                m = _message(r, model)\n                return AsyncStream(fa_llm.anthropic_events(m)) if stream else _Obj(m)\n\n            def stream(self, **kw):\n                model, _, req = prep(kw)\n\n                async def go():\n                    try:\n                        r = await fa_llm.acomplete(req)\n                    except Exception as e:\n                        raise _translate(e)\n                    return _message(r, model)\n                return AsyncMessageStream(go())\n\n            async def count_tokens(self, **kw):\n                return _Obj({"input_tokens": fa_llm.estimate_tokens({"s": kw.get("system"), "m": kw.get("messages")})})\n        else:\n            def create(self, **kw):\n                model, stream, req = prep(kw)\n                try:\n                    r = fa_llm.complete(req)\n                except Exception as e:\n                    raise _translate(e)\n                m = _message(r, model)\n                return Stream(fa_llm.anthropic_events(m)) if stream else _Obj(m)\n\n            def stream(self, **kw):\n                model, _, req = prep(kw)\n                try:\n                    r = fa_llm.complete(req)\n                except Exception as e:\n                    raise _translate(e)\n                return MessageStream(_message(r, model))\n\n            def count_tokens(self, **kw):\n                return _Obj({"input_tokens": fa_llm.estimate_tokens({"s": kw.get("system"), "m": kw.get("messages")})})\n\n        def __getattr__(self, k):\n            raise NotSupportedError("messages.%s 在 AI 助理的 anthropic 轉接版沒有支援" % k)\n\n    class Completions(object):\n        """舊的 text completions（prompt 以 \\\\n\\\\nHuman: … \\\\n\\\\nAssistant: 組成）。"""\n        if A:\n            async def create(self, model=None, prompt="", max_tokens_to_sample=1024, **kw):\n                msgs = _legacy_prompt(prompt)\n                r = await fa_llm.acomplete(fa_llm.chat_request(model, msgs, max_tokens=max_tokens_to_sample, temperature=kw.get("temperature")))\n                return _Obj({"id": "compl_fa", "type": "completion", "model": model, "completion": fa_llm.text_of(r["choices"][0]["message"]["content"]), "stop_reason": "stop_sequence"})\n        else:\n            def create(self, model=None, prompt="", max_tokens_to_sample=1024, **kw):\n                msgs = _legacy_prompt(prompt)\n                r = fa_llm.complete(fa_llm.chat_request(model, msgs, max_tokens=max_tokens_to_sample, temperature=kw.get("temperature")))\n                return _Obj({"id": "compl_fa", "type": "completion", "model": model, "completion": fa_llm.text_of(r["choices"][0]["message"]["content"]), "stop_reason": "stop_sequence"})\n\n    class Models(object):\n        def _info(self):\n            try:\n                return fa_bridge.call("llm.info", {}, timeout=10.0).get("model") or "assistant"\n            except Exception:\n                return "assistant"\n\n        if A:\n            async def list(self, **kw):\n                return _Obj({"data": [{"id": self._info(), "type": "model", "display_name": self._info()}], "has_more": False})\n        else:\n            def list(self, **kw):\n                return _Obj({"data": [{"id": self._info(), "type": "model", "display_name": self._info()}], "has_more": False})\n\n    class Client(object):\n        def __init__(self, api_key=None, base_url=None, auth_token=None, timeout=None, max_retries=None, default_headers=None, http_client=None, **kw):\n            self.api_key = api_key\n            self.base_url = base_url\n            self.messages = Messages()\n            self.completions = Completions()\n            self.models = Models()\n            self.beta = self\n\n        def with_options(self, **kw):\n            return self\n\n        copy = with_options\n\n        def close(self):\n            return None\n\n        def __getattr__(self, k):\n            if k.startswith("__"):\n                raise AttributeError(k)\n            raise NotSupportedError("client.%s 在 AI 助理的 anthropic 轉接版沒有支援" % k)\n    return Client\n\n\ndef _legacy_prompt(prompt):\n    msgs = []\n    parts = re.split(r"\\n\\n(Human|Assistant):", "\\n\\n" + str(prompt or ""))\n    i = 1\n    while i + 1 < len(parts):\n        role = "user" if parts[i] == "Human" else "assistant"\n        txt = parts[i + 1].strip()\n        if txt:\n            msgs.append({"role": role, "content": txt})\n        i += 2\n    return msgs or [{"role": "user", "content": str(prompt or "")}]\n\n\nclass Anthropic(_build(False)):\n    pass\n\n\nclass AsyncAnthropic(_build(True)):\n    async def close(self):\n        return None\n\n    async def __aenter__(self):\n        return self\n\n    async def __aexit__(self, *a):\n        return False\n\n\nHUMAN_PROMPT = "\\n\\nHuman:"\nAI_PROMPT = "\\n\\nAssistant:"\n',"fa_bridge.py":'# -*- coding: utf-8 -*-\n"""\nfa_bridge — Python 端的「API 轉接」通道（由 Floating AI Assistant 在執行技能包的 Python 腳本時自動提供）。\n\n腳本裡呼叫的某些公開 API（例如 playwright.sync_api）在這個環境裡其實是轉接到 AI 助理自己的工具／領域，\n所以腳本不需要真的有 Chrome 遠端除錯埠、也不需要裝 Playwright。\n\n通訊方式：桌面版用檔案當信箱；網頁版（Pyodide）直接呼叫助理頁面的 JS 模組。桌面版的信箱做法：——把請求寫成 req-<id>.json 放進 FA_BRIDGE_RPC 資料夾，助理（主程式）處理後寫出 res-<id>.json。\n不需要開任何網路埠、不需要改主程式。\n\n直接用法：\n    import fa_bridge\n    fa_bridge.tool("browser_get_page_text", tab_id=3)           # 呼叫助理的一個工具\n    fa_bridge.domain("browser_control", "開啟 https://… 並截圖")  # 委派給助理的一個領域（子 AI）\n"""\nimport json\nimport os\nimport sys\nimport time\nimport uuid\n\nRPC_DIR = os.environ.get("FA_BRIDGE_RPC", "")\nIN_BROWSER = sys.platform == "emscripten"  # 網頁版／Pyodide：直接呼叫助理頁面的 JS 模組 _fa_pybridge，不需要信箱檔案\n\n\nACTIVE = True  # 網頁版：停用轉接（一般的 python_execute）時設成 False，攔截會全部放行\n\n\nclass BridgeError(RuntimeError):\n    pass\n\n\nclass NotSupported(BridgeError):\n    """助理設定的所有 LLM Model 都沒有這個能力（embeddings、圖片、語音、工具呼叫…）。有任何一個 Model 支援就不會丟這個。"""\n\n\ndef _fail(data, op):\n    msg = data.get("error") or "橋接呼叫失敗：" + op\n    if str(msg).startswith("NOT_SUPPORTED:"):\n        raise NotSupported(str(msg)[len("NOT_SUPPORTED:"):].strip())\n    raise BridgeError(msg)\n\n\ndef available():\n    return IN_BROWSER or (bool(RPC_DIR) and os.path.isdir(RPC_DIR))\n\n\ndef sleep(seconds):\n    """等一下。在網頁版（Pyodide）不能用 time.sleep（會卡住整個頁面），改用 JS 的計時器。"""\n    if IN_BROWSER:\n        import asyncio\n        import _fa_pybridge\n        asyncio.run(_fa_pybridge.sleep(int(float(seconds) * 1000)))\n    else:\n        time.sleep(seconds)\n\n\ndef call(op, args=None, timeout=240.0):\n    """送一個請求給助理並等回應。op 例如 \'pw.goto\'、\'tool\'、\'domain\'。"""\n    if IN_BROWSER:\n        # 同步等待 JS Promise：pyodide.ffi.run_sync 在 JSPI 下掛起 wasm 堆疊，不需要 SharedArrayBuffer。\n        # 前提是整支程式包在 callPromising 裡執行（見 floating-assistant.js 的 worker 路徑）；否則這裡會報錯。\n        from pyodide.ffi import run_sync\n        import _fa_pybridge\n        raw = run_sync(_fa_pybridge.call(op, json.dumps(args or {})))\n        data = json.loads(str(raw))\n        if not data.get("ok", False):\n            _fail(data, op)\n        return data.get("result")\n    if not available():\n        raise BridgeError("不在 AI 助理的橋接環境裡（沒有 FA_BRIDGE_RPC）。這支腳本要由助理的 run_command（桌面版）或 python_execute 執行。")\n    rid = uuid.uuid4().hex[:12]\n    req = os.path.join(RPC_DIR, "req-%s.json" % rid)\n    res = os.path.join(RPC_DIR, "res-%s.json" % rid)\n    tmp = req + ".tmp"\n    with open(tmp, "w", encoding="utf-8") as f:\n        json.dump({"id": rid, "op": op, "args": args or {}}, f, ensure_ascii=False)\n    os.replace(tmp, req)\n    t0 = time.time()\n    delay = 0.03\n    while True:\n        if os.path.exists(res):\n            try:\n                with open(res, "r", encoding="utf-8") as f:\n                    data = json.load(f)\n            except (ValueError, OSError):\n                time.sleep(0.05)  # 助理還在寫入\n                continue\n            for p in (res, req):\n                try:\n                    os.remove(p)\n                except OSError:\n                    pass\n            if not data.get("ok", False):\n                _fail(data, op)\n            return data.get("result")\n        if time.time() - t0 > timeout:\n            raise BridgeError("橋接逾時（%d 秒沒有回應）：%s" % (int(timeout), op))\n        time.sleep(delay)\n        delay = min(0.2, delay * 1.5)\n\n\nasync def acall(op, args=None, timeout=240.0):\n    """call 的 async 版：網頁版直接 await 助理頁面的 JS（不會卡住事件迴圈）；桌面版把檔案信箱的等待丟到執行緒，不擋住別的 async 工作。"""\n    if IN_BROWSER:\n        import _fa_pybridge\n        raw = await _fa_pybridge.call(op, json.dumps(args or {}))\n        data = json.loads(str(raw))\n        if not data.get("ok", False):\n            _fail(data, op)\n        return data.get("result")\n    import asyncio\n    loop = asyncio.get_event_loop()\n    return await loop.run_in_executor(None, lambda: call(op, args, timeout))\n\n\ndef install_hooks():\n    """裝上轉接用的攔截：直接送 HTTP 的 LLM 呼叫（OpenAI 標準與 Claude 格式）轉給助理的模型；網頁版另外把檔案寫入繞進 fap。可重複呼叫。"""\n    try:\n        import fa_http\n        fa_http.install()\n    except Exception as e:  # 缺 requests／httpx 之類不是錯誤\n        sys.stderr.write("[fa-bridge] http hook: %s\\n" % e)\n    if IN_BROWSER:\n        try:\n            import fa_fs\n            fa_fs.install()\n        except Exception as e:\n            sys.stderr.write("[fa-bridge] fs hook: %s\\n" % e)\n\n\ndef tool(name, **args):\n    """呼叫助理的一個工具（目前開放 browser_* 這組）。回傳工具的結果（已解析的 dict）。"""\n    return call("tool", {"name": name, "args": args})\n\n\ndef domain(domain_key, task):\n    """把一個任務委派給助理的領域（子 AI，例如 browser_control、desktop_ops）。回傳它的文字結論。"""\n    return call("domain", {"domain": domain_key, "task": task}, timeout=900.0)\n',"fa_fs.py":'# -*- coding: utf-8 -*-\n"""\nfa_fs — 網頁版（Pyodide）的檔案存取：寫入繞進 fap（使用者授權的資料夾）。\n\n網頁版的 Python 跑在瀏覽器裡，只有一個看不到的暫存檔案系統（關掉頁面就消失）。腳本寫出的報告、截圖、資料庫等如果留在那裡，\n使用者永遠拿不到。所以這裡把檔案存取接到 fap：\n  * 明確指定：/fap/<資料夾名稱>/路徑，或 "fap:<資料夾名稱>/路徑"\n  * 一般路徑（相對路徑、或不是系統內部用途的絕對路徑）：自動放進「預設的 fap」——設定裡指定的那一個，沒指定就用第一個已授權、可寫入的\n  * 系統內部路徑（/tmp、/proc、/dev、Python 的標準函式庫與套件、轉接層自己）維持在暫存檔案系統，不繞\n沒有任何可寫入的 fap 時，寫入會丟出 PermissionError 並說明怎麼授權（不會悄悄把檔案丟掉）。\n\n做法：open() 讀取時先把 fap 的內容取到暫存、寫入時在關閉檔案的當下送回 fap；os／pathlib 的 exists、stat、listdir、scandir、makedirs、mkdir、\nremove、rmdir、rename、replace 也接上。桌面版 Python 是真的檔案系統，不需要這一層。\n"""\nimport builtins\nimport io\nimport os\nimport sys\n\nimport fa_bridge\n\n_ST = {"installed": False, "default": None, "cache": "/fa_fap_cache"}\n_LOCAL = ("/tmp", "/proc", "/dev", "/sys", "/lib", "/usr", "/fa_pybridge", "/fa_fap_cache", "/home/pyodide/.cache", "/etc", "/var/tmp", "/work")  # /work＝python_execute 的工作目錄（工具自己的輸出管道，不導向 fap）\n_orig = {}\n\n\ndef _call(op, **a):\n    return fa_bridge.call(op, a, timeout=120.0)\n\n\ndef default_label():\n    if _ST["default"] is None:\n        r = _call("fs.info")\n        if not r or not r.get("label"):\n            raise PermissionError((r or {}).get("hint") or "沒有可以寫入的授權資料夾（fap）。請先在助理的「檔案存取點」授權一個資料夾，或在設定指定 pythonBridgeFap。")\n        _ST["default"] = r["label"]\n    return _ST["default"]\n\n\ndef _site_dirs():\n    out = [p for p in sys.path if p and p.startswith("/") and ("site-packages" in p or "python3" in p or p.endswith(".zip"))]\n    pre = getattr(sys, "prefix", "") or ""\n    if len(pre) > 1:  # Pyodide 的 sys.prefix 是 "/"，不能拿來當前綴（會讓所有路徑都被當成系統路徑）\n        out.append(pre)\n    return out\n\n\ndef classify(path):\n    """回傳 (label, rel) 表示要走 fap，或 None 表示維持本地。"""\n    if not fa_bridge.ACTIVE:\n        return None\n    if isinstance(path, int) or path is None:\n        return None\n    try:\n        p = os.fspath(path)\n    except TypeError:\n        return None\n    if isinstance(p, bytes):\n        p = p.decode("utf-8", "replace")\n    if p.startswith("fap:"):\n        rest = p[4:].lstrip("/")\n        label, _, rel = rest.partition("/")\n        return label, rel.strip("/")\n    if p.startswith("/fap/"):\n        rest = p[5:]\n        label, _, rel = rest.partition("/")\n        return label, rel.strip("/")\n    absp = os.path.normpath(os.path.join(os.getcwd(), p)) if not p.startswith("/") else os.path.normpath(p)\n    if any(absp == l or absp.startswith(l + "/") for l in _LOCAL) or any(absp.startswith(s) for s in _site_dirs()):\n        return None\n    cwd = os.getcwd().rstrip("/")\n    if absp == cwd or absp.startswith(cwd + "/"):\n        rel = absp[len(cwd):].strip("/")\n    else:\n        rel = absp.strip("/")\n    return default_label(), rel\n\n\ndef _cache_path(label, rel):\n    return os.path.join(_ST["cache"], label, rel) if rel else os.path.join(_ST["cache"], label)\n\n\ndef _mk_local(path):\n    d = os.path.dirname(path)\n    if d:\n        _orig["makedirs"](d, exist_ok=True)\n\n\ndef _fetch(label, rel):\n    """把 fap 的檔案取到暫存，回傳暫存路徑（fap 沒有這個檔案就回 None）。"""\n    r = _call("fs.read", label=label, path=rel)\n    if not r or not r.get("exists"):\n        return None\n    import base64\n    cp = _cache_path(label, rel)\n    _mk_local(cp)\n    with _orig["open"](cp, "wb") as f:\n        f.write(base64.b64decode(r.get("b64") or ""))\n    return cp\n\n\ndef _push(label, rel, cp):\n    import base64\n    with _orig["open"](cp, "rb") as f:\n        data = f.read()\n    _call("fs.write", label=label, path=rel, b64=base64.b64encode(data).decode("ascii"))\n\n\nclass _SyncFile(object):\n    """寫入模式的檔案：關閉時把內容送回 fap。其餘行為跟真的檔案物件一樣。"""\n\n    def __init__(self, f, label, rel, cp):\n        self.__dict__.update(_f=f, _label=label, _rel=rel, _cp=cp, _done=False)\n\n    def __getattr__(self, k):\n        return getattr(self.__dict__["_f"], k)\n\n    def __iter__(self):\n        return iter(self.__dict__["_f"])\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *a):\n        self.close()\n        return False\n\n    def close(self):\n        d = self.__dict__\n        if d["_done"]:\n            return\n        d["_done"] = True\n        d["_f"].close()\n        _push(d["_label"], d["_rel"], d["_cp"])\n\n    def __del__(self):\n        try:\n            self.close()\n        except Exception:\n            pass\n\n\ndef _explicit(path):\n    s = str(os.fspath(path)) if not isinstance(path, int) else ""\n    return s.startswith("fap:") or s.startswith("/fap/")\n\n\ndef _local_has(path):\n    """沒有明確指定 fap 的路徑，如果本地暫存檔案系統裡已經有（例如 python_execute 放進去的檔案），就維持本地。"""\n    try:\n        _orig["stat"](path)\n        return True\n    except (OSError, ValueError, TypeError):\n        return False\n\n\ndef _open(file, mode="r", *a, **kw):\n    c = classify(file)\n    if c is None:\n        return _orig["open"](file, mode, *a, **kw)\n    label, rel = c\n    writing = any(m in mode for m in "wax+")\n    if not writing and not _explicit(file) and _local_has(file):\n        return _orig["open"](file, mode, *a, **kw)\n    cp = _cache_path(label, rel)\n    if "w" in mode or "x" in mode:\n        if "x" in mode and _call("fs.exists", label=label, path=rel).get("exists"):\n            raise FileExistsError(file)\n        _mk_local(cp)\n        return _SyncFile(_orig["open"](cp, mode, *a, **kw), label, rel, cp)\n    got = _fetch(label, rel)\n    if got is None:\n        if "a" in mode or "+" in mode and "r" not in mode:\n            _mk_local(cp)\n            return _SyncFile(_orig["open"](cp, mode, *a, **kw), label, rel, cp)\n        raise FileNotFoundError(2, "No such file or directory (fap)", str(file))\n    f = _orig["open"](cp, mode, *a, **kw)\n    return _SyncFile(f, label, rel, cp) if writing else f\n\n\n# ---- os 層\ndef _stat(path, *a, **kw):\n    c = classify(path)\n    if c is None or (not _explicit(path) and _local_has(path)):\n        return _orig["stat"](path, *a, **kw)\n    label, rel = c\n    r = _call("fs.stat", label=label, path=rel)\n    if not r or not r.get("exists"):\n        raise FileNotFoundError(2, "No such file or directory (fap)", str(path))\n    mode = (0o040755 if r.get("is_dir") else 0o100644)\n    t = float(r.get("mtime") or 0) / 1000.0\n    return os.stat_result((mode, 0, 0, 1, 0, 0, int(r.get("size") or 0), t, t, t))\n\n\ndef _listdir(path="."):\n    c = classify(path)\n    if c is None or (not _explicit(path) and _local_has(path)):\n        return _orig["listdir"](path)\n    r = _call("fs.list", label=c[0], path=c[1])\n    if r is None or r.get("exists") is False:\n        raise FileNotFoundError(2, "No such file or directory (fap)", str(path))\n    return [e["name"] for e in r.get("entries", [])]\n\n\nclass _Entry(object):\n    def __init__(self, base, e):\n        self.name = e["name"]\n        self.path = os.path.join(base, e["name"])\n        self._dir = bool(e.get("is_dir"))\n\n    def is_dir(self, follow_symlinks=True):\n        return self._dir\n\n    def is_file(self, follow_symlinks=True):\n        return not self._dir\n\n    def is_symlink(self):\n        return False\n\n    def stat(self, follow_symlinks=True):\n        return _stat(self.path)\n\n    def __fspath__(self):\n        return self.path\n\n\nclass _ScanIter(object):\n    def __init__(self, items):\n        self._it = iter(items)\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        return next(self._it)\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *a):\n        return False\n\n    def close(self):\n        pass\n\n\ndef _scandir(path="."):\n    c = classify(path)\n    if c is None or (not _explicit(path) and _local_has(path)):\n        return _orig["scandir"](path)\n    r = _call("fs.list", label=c[0], path=c[1])\n    if r is None or r.get("exists") is False:\n        raise FileNotFoundError(2, "No such file or directory (fap)", str(path))\n    base = os.fspath(path)\n    return _ScanIter([_Entry(base, e) for e in r.get("entries", [])])\n\n\ndef _makedirs(name, mode=0o777, exist_ok=False):\n    c = classify(name)\n    if c is None:\n        return _orig["makedirs"](name, mode, exist_ok)\n    if _call("fs.exists", label=c[0], path=c[1]).get("exists") and not exist_ok:\n        raise FileExistsError(17, "File exists (fap)", str(name))\n    _call("fs.mkdir", label=c[0], path=c[1])\n\n\ndef _mkdir(path, mode=0o777, *a, **kw):\n    c = classify(path)\n    if c is None:\n        return _orig["mkdir"](path, mode, *a, **kw)\n    if _call("fs.exists", label=c[0], path=c[1]).get("exists"):\n        raise FileExistsError(17, "File exists (fap)", str(path))\n    _call("fs.mkdir", label=c[0], path=c[1])\n\n\ndef _remove(path, *a, **kw):\n    c = classify(path)\n    if c is None:\n        return _orig["remove"](path, *a, **kw)\n    r = _call("fs.remove", label=c[0], path=c[1])\n    if not r or not r.get("removed"):\n        raise FileNotFoundError(2, "No such file or directory (fap)", str(path))\n    cp = _cache_path(*c)\n    if os.path.exists(cp):\n        try:\n            _orig["remove"](cp)\n        except OSError:\n            pass\n\n\ndef _rename(src, dst, *a, **kw):\n    cs, cd = classify(src), classify(dst)\n    if cs is None and cd is None:\n        return _orig["rename"](src, dst, *a, **kw)\n    with _open(src, "rb") as f:\n        data = f.read()\n    with _open(dst, "wb") as g:\n        g.write(data)\n    _remove(src)\n\n\ndef install():\n    if _ST["installed"]:\n        return\n    _ST["installed"] = True\n    for k, mod, name in (("open", builtins, "open"), ("stat", os, "stat"), ("listdir", os, "listdir"), ("scandir", os, "scandir"),\n                         ("makedirs", os, "makedirs"), ("mkdir", os, "mkdir"), ("remove", os, "remove"), ("rename", os, "rename")):\n        _orig[k] = getattr(mod, name)\n    builtins.open = _open\n    io.open = _open\n    os.stat = _stat\n    os.listdir = _listdir\n    os.scandir = _scandir\n    os.makedirs = _makedirs\n    os.mkdir = _mkdir\n    os.remove = _remove\n    os.unlink = _remove\n    os.rmdir = _remove\n    os.rename = _rename\n    os.replace = _rename\n    try:\n        _orig["makedirs"](_ST["cache"], exist_ok=True)\n    except OSError:\n        pass\n',"fa_http.py":'# -*- coding: utf-8 -*-\n"""\nfa_http — 直接送 HTTP 的 LLM 呼叫也轉給助理的模型。\n\n有些腳本不用 openai／anthropic 套件，而是自己用 requests／httpx／urllib 打 API：\n    requests.post("https://api.openai.com/v1/chat/completions", headers={"Authorization": ...}, json={...})\n    requests.post("https://api.anthropic.com/v1/messages", headers={"x-api-key": ..., "anthropic-version": ...}, json={...})\n或打自己架的相容伺服器（任何主機，路徑長得一樣就算）。這裡攔截這些呼叫，**不真的連出去**，改由助理已設定的 LLM Model 回答，\n回傳的格式跟被呼叫的端點一樣（OpenAI 標準或 Claude 格式；一般回應與串流 SSE 都支援）。\n\n支援的端點（路徑後綴比對，前面的 /v1、/openai/v1 之類不拘）：\n  OpenAI 標準：POST /chat/completions、/responses、/completions、/embeddings、/images/generations|edits|variations、\n               /audio/transcriptions|translations|speech、/moderations；GET /models\n  Claude：     POST /messages（含 stream）、/messages/count_tokens\nembeddings、圖片、語音、工具呼叫一律先從已設定的 LLM Model 清單找有這個能力的 Model，全部都不支援才回 501。\n不是這些路徑的請求完全不碰（照原本連網）。想讓某個主機不被攔截：環境變數 FA_HTTP_BYPASS_HOSTS=host1,host2。\n"""\nimport base64\nimport io\nimport json\nimport os\nimport re\nimport sys\n\nimport fa_bridge\nimport fa_llm\nimport fa_net\nimport fa_sim\nimport fa_ws\n\n_INSTALLED = {"done": False, "hooked": set()}\n\n\n# ---------------------------------------------------------------- multipart 解析（圖片編輯、語音轉文字會用到）\ndef parse_multipart(body, content_type):\n    m = re.search(r\'boundary="?([^";]+)"?\', content_type or "")\n    if not m:\n        return {}, []\n    boundary = ("--" + m.group(1)).encode()\n    fields, files = {}, []\n    for part in body.split(boundary):\n        part = part.strip(b"\\r\\n")\n        if not part or part == b"--":\n            continue\n        head, _, data = part.partition(b"\\r\\n\\r\\n")\n        h = head.decode("utf-8", "replace")\n        name = re.search(r\'name="([^"]*)"\', h)\n        fn = re.search(r\'filename="([^"]*)"\', h)\n        ct = re.search(r"Content-Type:\\s*([^\\r\\n]+)", h, re.I)\n        if data.endswith(b"\\r\\n"):\n            data = data[:-2]\n        if fn:\n            files.append({"name": name.group(1) if name else "file", "filename": fn.group(1), "type": ct.group(1).strip() if ct else "application/octet-stream",\n                          "b64": base64.b64encode(data).decode("ascii")})\n        elif name:\n            fields[name.group(1)] = data.decode("utf-8", "replace")\n    return fields, files\n\n\ndef _err(status, message, style):\n    if style == "anthropic":\n        body = {"type": "error", "error": {"type": "api_error" if status != 501 else "not_supported_error", "message": message}}\n    else:\n        body = {"error": {"message": message, "type": "not_supported" if status == 501 else "api_error", "param": None, "code": "not_supported" if status == 501 else None}}\n    return status, {"content-type": "application/json"}, json.dumps(body, ensure_ascii=False).encode("utf-8")\n\n\ndef _status_of(e):\n    if isinstance(e, fa_bridge.NotSupported):\n        return 501\n    m = re.search(r"API錯誤\\((\\d{3})\\)", str(e))\n    return int(m.group(1)) if m else 502\n\n\ndef _json(obj, status=200):\n    return status, {"content-type": "application/json"}, json.dumps(obj, ensure_ascii=False).encode("utf-8")\n\n\ndef _sse(events, done):\n    return 200, {"content-type": "text/event-stream", "cache-control": "no-cache"}, fa_llm.sse(events, done=done).encode("utf-8")\n\n\n# ---------------------------------------------------------------- 路由\n_ROUTES = [\n    ("POST", re.compile(r"/messages/count_tokens/?$"), "count_tokens"),\n    ("POST", re.compile(r"/messages/?$"), "anthropic"),\n    ("POST", re.compile(r"/chat/completions/?$"), "chat"),\n    ("POST", re.compile(r"/responses/?$"), "responses"),\n    ("POST", re.compile(r"/completions/?$"), "completions"),\n    ("POST", re.compile(r"/embeddings/?$"), "embeddings"),\n    ("POST", re.compile(r"/images/(generations|edits|variations)/?$"), "images"),\n    ("POST", re.compile(r"/audio/(transcriptions|translations|speech)/?$"), "audio"),\n    ("POST", re.compile(r"/moderations/?$"), "moderations"),\n    ("GET", re.compile(r"/models/?$"), "models"),\n]\n\n\ndef route(method, url, headers=None, body=b""):\n    """先看是不是 LLM 端點（回 (status, headers, body_bytes)），再看是不是要接手的一般 HTTP（本機 mock 伺服器、網頁版的外部網址；見 fa_net）。都不是就回 None。"""\n    r = _route_llm(method, url, headers, body)\n    return r if r is not None else fa_net.route(method, url, headers, body)\n\n\ndef _route_llm(method, url, headers=None, body=b""):\n    """是 LLM 端點就回 (status, headers, body_bytes)，不是就回 None。"""\n    if not fa_bridge.ACTIVE:\n        return None\n    try:\n        from urllib.parse import urlparse\n        u = urlparse(url)\n    except Exception:\n        return None\n    if not u.scheme.startswith("http"):\n        return None\n    bypass = [h.strip().lower() for h in os.environ.get("FA_HTTP_BYPASS_HOSTS", "").split(",") if h.strip()]\n    if (u.hostname or "").lower() in bypass:\n        return None\n    method = (method or "GET").upper()\n    kind = None\n    for m, rx, k in _ROUTES:\n        if m == method and rx.search(u.path):\n            kind = k\n            m_ = rx.search(u.path)\n            break\n    if kind is None:\n        return None\n    ct = ""\n    for k, v in (headers or {}).items():\n        if str(k).lower() == "content-type":\n            ct = str(v)\n    if isinstance(body, str):\n        body = body.encode("utf-8")\n    body = body or b""\n    style = "anthropic" if kind in ("anthropic", "count_tokens") else "openai"\n    data = {}\n    fields, files = {}, []\n    if kind not in ("models",):\n        if "multipart/form-data" in ct:\n            fields, files = parse_multipart(body, ct)\n        else:\n            try:\n                data = json.loads(body.decode("utf-8") or "{}")\n            except ValueError:\n                return None\n            if not isinstance(data, dict):\n                return None\n    # 保險：看起來不像 LLM 請求就不碰（例如別的服務剛好也有 /messages 這種路徑）\n    if kind == "anthropic" and not ("messages" in data and ("model" in data or "max_tokens" in data)):\n        return None\n    if kind == "count_tokens" and "messages" not in data:\n        return None\n    if kind == "chat" and "messages" not in data:\n        return None\n    if kind == "responses" and "input" not in data and "instructions" not in data:\n        return None\n    if kind == "completions" and "prompt" not in data:\n        return None\n    try:\n        return _handle(kind, m_, data, fields, files, u)\n    except Exception as e:\n        return _err(_status_of(e), str(e), style)\n\n\ndef _handle(kind, m, data, fields, files, u):\n    if kind == "chat":\n        d = dict(data)\n        stream, so = d.pop("stream", False), d.pop("stream_options", None)\n        r = fa_llm.complete(fa_llm.chat_request(d.pop("model", None), d.pop("messages"), **d))\n        r.setdefault("object", "chat.completion")\n        if stream:\n            return _sse(fa_llm.chat_chunks(r, include_usage=bool((so or {}).get("include_usage"))), done=True)\n        return _json(r)\n    if kind == "responses":\n        d = dict(data)\n        stream = d.pop("stream", False)\n        r = fa_llm.complete(fa_llm.responses_to_chat(model=d.pop("model", None), input=d.pop("input", None), instructions=d.pop("instructions", None), **d))\n        resp = fa_llm.chat_to_response(r, data.get("model"))\n        return _sse(fa_llm.response_events(resp), done=False) if stream else _json(resp)\n    if kind == "completions":\n        d = dict(data)\n        stream = d.pop("stream", False)\n        r = fa_llm.complete(fa_llm.completions_to_chat(d.pop("prompt"), model=d.pop("model", None), **{k: v for k, v in d.items() if k in ("temperature", "max_tokens", "top_p", "stop", "n", "seed")}))\n        out = fa_llm.chat_to_completion(r)\n        return _json(out)\n    if kind == "anthropic":\n        d = dict(data)\n        stream = d.pop("stream", False)\n        r = fa_llm.complete(fa_llm.anthropic_to_chat(**d))\n        msg = fa_llm.chat_to_anthropic(r, data.get("model"))\n        return _sse(fa_llm.anthropic_events(msg), done=False) if stream else _json(msg)\n    if kind == "count_tokens":\n        return _json({"input_tokens": fa_llm.estimate_tokens({"s": data.get("system"), "m": data.get("messages")})})\n    if kind == "embeddings":\n        r = fa_llm.upstream("embeddings", "/embeddings", json_body=data)\n        return _json(r.get("json") or {})\n    if kind == "images":\n        sub = m.group(1)\n        path = "/images/" + sub\n        if files:\n            r = fa_llm.upstream("images", path, form={"fields": fields, "files": files})\n        else:\n            r = fa_llm.upstream("images", path, json_body=data)\n        return _json(r.get("json") or {})\n    if kind == "audio":\n        sub = m.group(1)\n        if sub == "speech":\n            r = fa_llm.upstream("audio_speech", "/audio/speech", json_body=data, want="bytes")\n            return 200, {"content-type": r.get("content_type") or "audio/mpeg"}, base64.b64decode(r.get("b64") or "")\n        fmt = fields.get("response_format")\n        r = fa_llm.upstream("audio_transcribe", "/audio/" + sub, form={"fields": fields, "files": files}, want="bytes" if fmt in ("text", "srt", "vtt") else "json")\n        if fmt in ("text", "srt", "vtt"):\n            return 200, {"content-type": "text/plain; charset=utf-8"}, base64.b64decode(r.get("b64") or "")\n        return _json(r.get("json") or {})\n    if kind == "moderations":\n        return _json(fa_sim.moderation(**{k: v for k, v in data.items() if k in ("input", "model")}))\n    if kind == "models":\n        return _json(fa_sim.models(fa_bridge.call("llm.info", {}, timeout=10.0).get("model"))[0])\n    return None\n\n\n# ---------------------------------------------------------------- 安裝：requests／httpx／urllib（模組之後才被 import 也會補上）\ndef _patch_requests():\n    import requests\n    from requests import Session\n    if getattr(Session.send, "_fa_patched", False):\n        return\n    orig = Session.send\n\n    def send(self, request, **kw):\n        hdrs = dict(request.headers or {})\n        r = route(request.method, request.url, hdrs, request.body if not hasattr(request.body, "read") else request.body.read())\n        if r is None:\n            return orig(self, request, **kw)\n        status, h, body = r\n        resp = requests.Response()\n        resp.status_code = status\n        resp._content = body\n        resp.headers = requests.structures.CaseInsensitiveDict(h)\n        resp.url = request.url\n        resp.request = request\n        resp.encoding = "utf-8"\n        resp.raw = io.BytesIO(body)\n        resp.reason = "OK" if status < 400 else "Error"\n        return resp\n    send._fa_patched = True\n    Session.send = send\n\n\ndef _patch_httpx():\n    import httpx\n    for cls_name, is_async in (("Client", False), ("AsyncClient", True)):\n        cls = getattr(httpx, cls_name, None)\n        if cls is None or getattr(cls.send, "_fa_patched", False):\n            continue\n        orig = cls.send\n        if is_async:\n            async def send(self, request, *a, __orig=orig, **kw):\n                r = route(request.method, str(request.url), dict(request.headers), request.content if hasattr(request, "content") else b"")\n                if r is None:\n                    return await __orig(self, request, *a, **kw)\n                return httpx.Response(r[0], headers=r[1], content=r[2], request=request)\n        else:\n            def send(self, request, *a, __orig=orig, **kw):\n                r = route(request.method, str(request.url), dict(request.headers), request.read() if hasattr(request, "read") else b"")\n                if r is None:\n                    return __orig(self, request, *a, **kw)\n                return httpx.Response(r[0], headers=r[1], content=r[2], request=request)\n        send._fa_patched = True\n        cls.send = send\n\n\ndef _patch_urllib():\n    import urllib.request\n    import urllib.response\n    import urllib.error\n    import email.message\n    if getattr(urllib.request.urlopen, "_fa_patched", False):\n        return\n    orig = urllib.request.urlopen\n\n    def urlopen(url, data=None, *a, **kw):\n        req = url if isinstance(url, urllib.request.Request) else None\n        full = req.full_url if req else url\n        method = req.get_method() if req else ("POST" if data is not None else "GET")\n        body = data if data is not None else (req.data if req else None)\n        hdrs = dict(req.header_items()) if req else {}\n        r = route(method, full, hdrs, body or b"")\n        if r is None:\n            return orig(url, data, *a, **kw)\n        status, h, payload = r\n        msg = email.message.Message()\n        for k, v in h.items():\n            msg[k] = v\n        resp = urllib.response.addinfourl(io.BytesIO(payload), msg, full, status)\n        if status >= 400:\n            raise urllib.error.HTTPError(full, status, "Error", msg, io.BytesIO(payload))\n        return resp\n    urlopen._fa_patched = True\n    urllib.request.urlopen = urlopen\n\n\n_PATCHERS = {"requests": _patch_requests, "httpx": _patch_httpx, "websocket": fa_ws.patch_websocket_client, "websockets": fa_ws.patch_websockets}\n\n\nclass _OnImport(object):\n    """requests／httpx 在安裝轉接之後才被 import（例如 Pyodide 裡 micropip 現裝）時，import 完成後補上攔截。"""\n\n    def find_spec(self, name, path=None, target=None):\n        if name not in _PATCHERS or name in _INSTALLED["hooked"]:\n            return None\n        import importlib.util\n        _INSTALLED["hooked"].add(name)\n        try:\n            spec = importlib.util.find_spec(name)\n        finally:\n            _INSTALLED["hooked"].discard(name)\n        if spec is None or spec.loader is None:\n            return None\n        loader = spec.loader\n        orig_exec = loader.exec_module\n\n        def exec_module(module, _o=orig_exec, _n=name):\n            _o(module)\n            try:\n                _PATCHERS[_n]()\n            except Exception as e:\n                sys.stderr.write("[fa-bridge] patch %s: %s\\n" % (_n, e))\n        try:\n            loader.exec_module = exec_module\n        except Exception:\n            return None\n        return spec\n\n\ndef install():\n    if _INSTALLED["done"]:\n        return\n    _INSTALLED["done"] = True\n    try:\n        fa_net.install()\n    except Exception as e:\n        sys.stderr.write("[fa-bridge] patch http.client: %s\\n" % e)\n    try:\n        _patch_urllib()\n    except Exception as e:\n        sys.stderr.write("[fa-bridge] patch urllib: %s\\n" % e)\n    for name, fn in _PATCHERS.items():\n        if name in sys.modules:\n            try:\n                fn()\n            except Exception as e:\n                sys.stderr.write("[fa-bridge] patch %s: %s\\n" % (name, e))\n        else:\n            import importlib.util\n            try:\n                if importlib.util.find_spec(name) is not None:\n                    try:\n                        fn()\n                    except Exception as e:\n                        sys.stderr.write("[fa-bridge] patch %s: %s\\n" % (name, e))\n            except Exception:\n                pass\n    if not any(isinstance(f, _OnImport) for f in sys.meta_path):\n        sys.meta_path.insert(0, _OnImport())\n',"fa_llm.py":'# -*- coding: utf-8 -*-\n"""\nfa_llm — LLM API 的格式轉換與串流模擬（只用標準函式庫）。\n\n助理實際使用的模型走「OpenAI 相容的 chat/completions」。腳本卻可能用各種寫法呼叫 LLM：\n  * OpenAI 標準：chat.completions、responses、completions（舊）、embeddings\n  * Claude（Anthropic）：messages\n這個模組把它們全部轉成同一種請求（chat/completions），再把回應轉回腳本期待的格式，所以不管腳本用哪一種，\n實際上都是助理目前選用的那個模型在回答。\n\n兩種呼叫方式都支援：Python 套件（openai／anthropic，同步與 async）與直接送 HTTP（requests／httpx／urllib，見 fa_http.py）。\n"""\nimport json\nimport time\nimport uuid\n\nimport fa_bridge\n\n\n# ---------------------------------------------------------------- 小工具\ndef _id(prefix):\n    return "%s_%s" % (prefix, uuid.uuid4().hex[:24])\n\n\ndef _now():\n    return int(time.time())\n\n\ndef text_of(content):\n    """把各種 content 形式（字串、區塊清單）變成純文字。"""\n    if content is None:\n        return ""\n    if isinstance(content, str):\n        return content\n    if isinstance(content, list):\n        out = []\n        for b in content:\n            if isinstance(b, str):\n                out.append(b)\n            elif isinstance(b, dict):\n                t = b.get("type")\n                if t in ("text", "input_text", "output_text") or ("text" in b and t is None):\n                    out.append(str(b.get("text", "")))\n                elif t == "tool_result":\n                    out.append(text_of(b.get("content")))\n        return "".join(out)\n    if isinstance(content, dict):\n        return str(content.get("text", ""))\n    return str(content)\n\n\ndef estimate_tokens(text):\n    """沒有真正的 tokenizer 時的粗估：英文約 4 字元一個 token，中日韓字約 1.3 字一個。"""\n    s = text if isinstance(text, str) else json.dumps(text, ensure_ascii=False)\n    cjk = sum(1 for ch in s if "぀" <= ch <= "鿿" or "가" <= ch <= "힯")\n    return max(1, int(cjk / 1.3 + (len(s) - cjk) / 4.0))\n\n\n# ---------------------------------------------------------------- 呼叫助理的模型\ndef complete(req, timeout=600.0):\n    """req 是 OpenAI chat/completions 形式的 dict；回傳 OpenAI chat.completion 形式的 dict。"""\n    return fa_bridge.call("llm.complete", req, timeout=timeout)\n\n\nasync def acomplete(req, timeout=600.0):\n    return await fa_bridge.acall("llm.complete", req, timeout=timeout)\n\n\ndef vision_describe(image, prompt="", policy=None, max_tokens=None, timeout=900.0):\n    """看圖：交給助理外層「抽象的 vision API」，由助理依設定決定用線上視覺模型還是離線模型（優先順序與備援都在外層處理）。\n    image：bytes、檔案路徑（例如 /work/in/a.png）、data URL 或 http(s) 網址；prompt：一般的自然語言（中文英文都行，要描述、辨識文字或問問題）——\n    各模型自己的提示詞格式由外層處理，這裡不用管。policy（選填）：llm-first／offline-first／llm／offline，不給就用助理的設定。\n    回傳 dict：text、backend（"llm"或"offline"）、model、attempts（每個後端試了什麼、為什麼失敗）。"""\n    import base64\n    if isinstance(image, (bytes, bytearray)):\n        img = "data:image/png;base64," + base64.b64encode(bytes(image)).decode("ascii")\n    elif isinstance(image, str) and (image.startswith("data:") or image.startswith("http://") or image.startswith("https://")):\n        img = image\n    else:\n        with open(image, "rb") as f:\n            raw = f.read()\n        ext = str(image).lower().rsplit(".", 1)[-1]\n        mime = {"jpg": "image/jpeg", "jpeg": "image/jpeg", "gif": "image/gif", "webp": "image/webp", "bmp": "image/bmp"}.get(ext, "image/png")\n        img = "data:%s;base64,%s" % (mime, base64.b64encode(raw).decode("ascii"))\n    req = {"image": img, "prompt": prompt or ""}\n    if policy:\n        req["policy"] = policy\n    if max_tokens:\n        req["max_tokens"] = int(max_tokens)\n    return fa_bridge.call("vision.describe", req, timeout=timeout)\n\n\nasync def avision_describe(image, prompt="", policy=None, max_tokens=None, timeout=900.0):\n    """vision_describe 的 async 版本。"""\n    import base64\n    if isinstance(image, (bytes, bytearray)):\n        img = "data:image/png;base64," + base64.b64encode(bytes(image)).decode("ascii")\n    elif isinstance(image, str) and (image.startswith("data:") or image.startswith("http://") or image.startswith("https://")):\n        img = image\n    else:\n        with open(image, "rb") as f:\n            raw = f.read()\n        img = "data:image/png;base64," + base64.b64encode(raw).decode("ascii")\n    req = {"image": img, "prompt": prompt or ""}\n    if policy:\n        req["policy"] = policy\n    if max_tokens:\n        req["max_tokens"] = int(max_tokens)\n    return await fa_bridge.acall("vision.describe", req, timeout=timeout)\n\n\ndef upstream(cap, path, json_body=None, form=None, want="json", method="POST", timeout=600.0):\n    """把一個 OpenAI 標準的 HTTP 呼叫轉給助理「已設定的 LLM Model 清單」裡有這個能力的那一個（依序試，第一個成功的就用）。\n    cap：embeddings、images、audio_transcribe、audio_speech、chat、tools、vision。\n    所有 Model 都不支援才會丟 fa_bridge.NotSupported。回傳 {status, content_type, json | b64, model}。"""\n    return fa_bridge.call("llm.upstream", {"cap": cap, "path": path, "method": method, "json": json_body, "form": form, "want": want}, timeout=timeout)\n\n\nasync def aupstream(cap, path, json_body=None, form=None, want="json", method="POST", timeout=600.0):\n    return await fa_bridge.acall("llm.upstream", {"cap": cap, "path": path, "method": method, "json": json_body, "form": form, "want": want}, timeout=timeout)\n\n\ndef file_part(name, file, default_filename="file", default_type="application/octet-stream"):\n    """把腳本給的檔案（bytes、路徑、檔案物件、(檔名, 內容[, 類型]) 元組）變成可以傳過橋接的表單檔案。"""\n    import base64\n    import mimetypes\n    import os\n    filename, data, ctype = default_filename, None, None\n    if isinstance(file, tuple):\n        filename = file[0] or filename\n        data = file[1] if len(file) > 1 else b""\n        ctype = file[2] if len(file) > 2 else None\n    else:\n        data = file\n    if isinstance(data, str) and os.path.exists(data):\n        filename = os.path.basename(data)\n        data = open(data, "rb").read()\n    elif hasattr(data, "read"):\n        filename = os.path.basename(str(getattr(data, "name", filename)))\n        data = data.read()\n    elif hasattr(data, "__fspath__"):\n        filename = os.path.basename(str(data))\n        data = open(data, "rb").read()\n    if isinstance(data, str):\n        data = data.encode("utf-8")\n    ctype = ctype or mimetypes.guess_type(filename)[0] or default_type\n    return {"name": name, "filename": filename, "type": ctype, "b64": base64.b64encode(data or b"").decode("ascii")}\n\n\ndef note_simulated(api):\n    """告訴助理：這個呼叫是模擬的（助理沒有對應能力），讓上層 AI 知道結果不是真的。"""\n    try:\n        fa_bridge.call("sim.note", {"api": api}, timeout=10.0)\n    except Exception:\n        pass\n\n\n# ---------------------------------------------------------------- OpenAI chat 的清理\n_CHAT_KEYS = ("messages", "temperature", "top_p", "max_tokens", "stop", "tools", "tool_choice", "response_format",\n              "n", "presence_penalty", "frequency_penalty", "seed", "user", "logit_bias", "parallel_tool_calls")\n\n\ndef chat_request(model=None, messages=None, **kw):\n    """整理成可以送去上游的 chat/completions 請求（丟掉上游不一定認得的欄位）。"""\n    req = {"messages": list(messages or [])}\n    if kw.get("max_completion_tokens") is not None and kw.get("max_tokens") is None:\n        kw["max_tokens"] = kw["max_completion_tokens"]\n    for k in _CHAT_KEYS:\n        if k == "messages":\n            continue\n        v = kw.get(k)\n        if v is not None:\n            req[k] = v\n    if model:\n        req["_requested_model"] = model\n    return req\n\n\ndef chat_chunks(resp, chunk_chars=24, include_usage=False):\n    """把一個完整的 chat.completion 變成串流的 chunk（模擬串流：上游先整段回來，再分段送出）。"""\n    cid = resp.get("id") or _id("chatcmpl")\n    model = resp.get("model") or "assistant"\n    created = resp.get("created") or _now()\n    base = {"id": cid, "object": "chat.completion.chunk", "created": created, "model": model}\n    for ch in resp.get("choices") or [{}]:\n        idx = ch.get("index", 0)\n        msg = ch.get("message") or {}\n        yield dict(base, choices=[{"index": idx, "delta": {"role": "assistant", "content": ""}, "finish_reason": None}])\n        text = text_of(msg.get("content"))\n        for i in range(0, len(text), max(1, chunk_chars)):\n            yield dict(base, choices=[{"index": idx, "delta": {"content": text[i:i + chunk_chars]}, "finish_reason": None}])\n        for ti, tc in enumerate(msg.get("tool_calls") or []):\n            fn = tc.get("function") or {}\n            yield dict(base, choices=[{"index": idx, "delta": {"tool_calls": [{"index": ti, "id": tc.get("id") or _id("call"), "type": "function",\n                                                                              "function": {"name": fn.get("name", ""), "arguments": fn.get("arguments", "")}}]},\n                                       "finish_reason": None}])\n        yield dict(base, choices=[{"index": idx, "delta": {}, "finish_reason": ch.get("finish_reason") or "stop"}])\n    if include_usage:\n        yield dict(base, choices=[], usage=resp.get("usage") or {})\n\n\n# ---------------------------------------------------------------- 舊的 completions\ndef completions_to_chat(prompt, **kw):\n    if isinstance(prompt, list):\n        prompt = "\\n".join(str(p) for p in prompt)\n    return chat_request(messages=[{"role": "user", "content": str(prompt or "")}], **kw)\n\n\ndef chat_to_completion(resp):\n    return {"id": (resp.get("id") or _id("cmpl")).replace("chatcmpl", "cmpl"), "object": "text_completion", "created": resp.get("created") or _now(),\n            "model": resp.get("model") or "assistant",\n            "choices": [{"text": text_of((c.get("message") or {}).get("content")), "index": c.get("index", 0), "logprobs": None,\n                         "finish_reason": c.get("finish_reason") or "stop"} for c in resp.get("choices") or []],\n            "usage": resp.get("usage") or {}}\n\n\n# ---------------------------------------------------------------- OpenAI Responses API\ndef _resp_content_to_chat(content):\n    if isinstance(content, str):\n        return content\n    parts = []\n    for b in content or []:\n        t = b.get("type") if isinstance(b, dict) else None\n        if t in ("input_text", "output_text", "text"):\n            parts.append({"type": "text", "text": b.get("text", "")})\n        elif t == "input_image":\n            url = b.get("image_url") or b.get("url") or ""\n            parts.append({"type": "image_url", "image_url": {"url": url if isinstance(url, str) else (url or {}).get("url", "")}})\n    if all(p["type"] == "text" for p in parts):\n        return "".join(p["text"] for p in parts)\n    return parts\n\n\ndef responses_to_chat(model=None, input=None, instructions=None, **kw):\n    msgs = []\n    if instructions:\n        msgs.append({"role": "system", "content": str(instructions)})\n    if isinstance(input, str):\n        msgs.append({"role": "user", "content": input})\n    else:\n        for it in input or []:\n            t = it.get("type", "message") if isinstance(it, dict) else "message"\n            if t == "message" or "role" in it:\n                role = it.get("role", "user")\n                msgs.append({"role": "system" if role == "developer" else role, "content": _resp_content_to_chat(it.get("content"))})\n            elif t == "function_call":\n                msgs.append({"role": "assistant", "content": None, "tool_calls": [{"id": it.get("call_id") or it.get("id") or _id("call"), "type": "function",\n                                                                                     "function": {"name": it.get("name", ""), "arguments": it.get("arguments", "{}")}}]})\n            elif t == "function_call_output":\n                msgs.append({"role": "tool", "tool_call_id": it.get("call_id", ""), "content": text_of(it.get("output"))})\n    tools = None\n    if kw.get("tools"):\n        tools = []\n        for t in kw["tools"]:\n            if t.get("type") == "function":\n                fn = t.get("function") or {"name": t.get("name"), "description": t.get("description", ""), "parameters": t.get("parameters") or {"type": "object", "properties": {}}}\n                tools.append({"type": "function", "function": fn})\n    rf = None\n    fmt = (kw.get("text") or {}).get("format") if isinstance(kw.get("text"), dict) else None\n    if isinstance(fmt, dict) and fmt.get("type") in ("json_object", "json_schema"):\n        rf = {"type": fmt["type"]}\n        if fmt["type"] == "json_schema":\n            rf["json_schema"] = {"name": fmt.get("name", "output"), "schema": fmt.get("schema") or {}, "strict": bool(fmt.get("strict"))}\n    return chat_request(model=model, messages=msgs, temperature=kw.get("temperature"), top_p=kw.get("top_p"),\n                        max_tokens=kw.get("max_output_tokens"), tools=tools, tool_choice=kw.get("tool_choice"), response_format=rf)\n\n\ndef chat_to_response(resp, requested=None):\n    ch = (resp.get("choices") or [{}])[0]\n    msg = ch.get("message") or {}\n    text = text_of(msg.get("content"))\n    rid = _id("resp")\n    output = []\n    if text or not msg.get("tool_calls"):\n        output.append({"id": _id("msg"), "type": "message", "status": "completed", "role": "assistant",\n                       "content": [{"type": "output_text", "text": text, "annotations": []}]})\n    for tc in msg.get("tool_calls") or []:\n        fn = tc.get("function") or {}\n        output.append({"id": _id("fc"), "type": "function_call", "status": "completed", "call_id": tc.get("id") or _id("call"),\n                       "name": fn.get("name", ""), "arguments": fn.get("arguments", "{}")})\n    u = resp.get("usage") or {}\n    pt, ct = u.get("prompt_tokens") or 0, u.get("completion_tokens") or 0\n    return {"id": rid, "object": "response", "created_at": resp.get("created") or _now(), "status": "completed", "error": None,\n            "model": resp.get("model") or requested or "assistant", "output": output, "output_text": text,\n            "usage": {"input_tokens": pt, "output_tokens": ct, "total_tokens": u.get("total_tokens") or (pt + ct)}}\n\n\ndef response_events(r, chunk_chars=24):\n    """Responses API 的串流事件（模擬）。"""\n    seq = 0\n\n    def ev(t, **kw):\n        nonlocal seq\n        seq += 1\n        d = {"type": t, "sequence_number": seq}\n        d.update(kw)\n        return d\n    skeleton = dict(r, status="in_progress", output=[], output_text="")\n    yield ev("response.created", response=skeleton)\n    yield ev("response.in_progress", response=skeleton)\n    for oi, item in enumerate(r.get("output") or []):\n        yield ev("response.output_item.added", output_index=oi, item=dict(item, status="in_progress", content=[]) if item["type"] == "message" else item)\n        if item["type"] == "message":\n            yield ev("response.content_part.added", output_index=oi, content_index=0, item_id=item["id"], part={"type": "output_text", "text": "", "annotations": []})\n            t = item["content"][0]["text"]\n            for i in range(0, len(t), max(1, chunk_chars)):\n                yield ev("response.output_text.delta", output_index=oi, content_index=0, item_id=item["id"], delta=t[i:i + chunk_chars])\n            yield ev("response.output_text.done", output_index=oi, content_index=0, item_id=item["id"], text=t)\n            yield ev("response.content_part.done", output_index=oi, content_index=0, item_id=item["id"], part=item["content"][0])\n        elif item["type"] == "function_call":\n            yield ev("response.function_call_arguments.delta", output_index=oi, item_id=item["id"], delta=item.get("arguments", ""))\n            yield ev("response.function_call_arguments.done", output_index=oi, item_id=item["id"], arguments=item.get("arguments", ""))\n        yield ev("response.output_item.done", output_index=oi, item=item)\n    yield ev("response.completed", response=r)\n\n\n# ---------------------------------------------------------------- Anthropic（Claude）messages\n_STOP_MAP = {"stop": "end_turn", "length": "max_tokens", "tool_calls": "tool_use", "function_call": "tool_use", "content_filter": "refusal"}\n\n\ndef _a_content_to_chat(content, role):\n    """Anthropic 的 content（字串或區塊）→ OpenAI 的訊息清單（可能展開成多則：tool_result 要變成 role=tool）。"""\n    if isinstance(content, str):\n        return [{"role": role, "content": content}]\n    parts, tool_calls, tool_msgs = [], [], []\n    for b in content or []:\n        t = b.get("type")\n        if t == "text":\n            parts.append({"type": "text", "text": b.get("text", "")})\n        elif t == "image":\n            src = b.get("source") or {}\n            if src.get("type") == "base64":\n                parts.append({"type": "image_url", "image_url": {"url": "data:%s;base64,%s" % (src.get("media_type", "image/png"), src.get("data", ""))}})\n            elif src.get("type") == "url":\n                parts.append({"type": "image_url", "image_url": {"url": src.get("url", "")}})\n        elif t == "tool_use":\n            tool_calls.append({"id": b.get("id") or _id("toolu"), "type": "function",\n                               "function": {"name": b.get("name", ""), "arguments": json.dumps(b.get("input") or {}, ensure_ascii=False)}})\n        elif t == "tool_result":\n            tool_msgs.append({"role": "tool", "tool_call_id": b.get("tool_use_id", ""), "content": text_of(b.get("content")) or ("（錯誤）" if b.get("is_error") else "")})\n        elif t in ("thinking", "redacted_thinking"):\n            continue\n    out = []\n    if parts or tool_calls:\n        msg = {"role": role}\n        if parts and all(p["type"] == "text" for p in parts):\n            msg["content"] = "".join(p["text"] for p in parts)\n        else:\n            msg["content"] = parts or None\n        if tool_calls:\n            msg["tool_calls"] = tool_calls\n        out.append(msg)\n    return tool_msgs + out if role == "user" else out + tool_msgs\n\n\ndef anthropic_to_chat(model=None, messages=None, system=None, max_tokens=None, temperature=None, top_p=None, stop_sequences=None, tools=None, tool_choice=None, **kw):\n    msgs = []\n    if system:\n        msgs.append({"role": "system", "content": text_of(system)})\n    for m in messages or []:\n        msgs.extend(_a_content_to_chat(m.get("content"), m.get("role", "user")))\n    oa_tools = None\n    if tools:\n        oa_tools = [{"type": "function", "function": {"name": t.get("name"), "description": t.get("description", ""),\n                                                      "parameters": t.get("input_schema") or {"type": "object", "properties": {}}}} for t in tools if t.get("name")]\n    tc = None\n    if isinstance(tool_choice, dict):\n        k = tool_choice.get("type")\n        tc = "auto" if k == "auto" else ("required" if k == "any" else ({"type": "function", "function": {"name": tool_choice.get("name")}} if k == "tool" else ("none" if k == "none" else None)))\n    return chat_request(model=model, messages=msgs, temperature=temperature, top_p=top_p, max_tokens=max_tokens, stop=stop_sequences or None, tools=oa_tools, tool_choice=tc)\n\n\ndef chat_to_anthropic(resp, requested=None):\n    ch = (resp.get("choices") or [{}])[0]\n    msg = ch.get("message") or {}\n    content = []\n    text = text_of(msg.get("content"))\n    if text or not msg.get("tool_calls"):\n        content.append({"type": "text", "text": text})\n    for tc in msg.get("tool_calls") or []:\n        fn = tc.get("function") or {}\n        try:\n            inp = json.loads(fn.get("arguments") or "{}")\n        except ValueError:\n            inp = {"_raw": fn.get("arguments")}\n        content.append({"type": "tool_use", "id": tc.get("id") or _id("toolu"), "name": fn.get("name", ""), "input": inp})\n    u = resp.get("usage") or {}\n    return {"id": _id("msg"), "type": "message", "role": "assistant", "model": resp.get("model") or requested or "assistant", "content": content,\n            "stop_reason": _STOP_MAP.get(ch.get("finish_reason") or "stop", "end_turn"), "stop_sequence": None,\n            "usage": {"input_tokens": u.get("prompt_tokens") or 0, "output_tokens": u.get("completion_tokens") or 0}}\n\n\ndef anthropic_events(m, chunk_chars=24):\n    """Anthropic messages 的串流事件（模擬）。"""\n    start = dict(m, content=[], stop_reason=None, usage={"input_tokens": m["usage"]["input_tokens"], "output_tokens": 0})\n    yield {"type": "message_start", "message": start}\n    for i, b in enumerate(m["content"]):\n        if b["type"] == "text":\n            yield {"type": "content_block_start", "index": i, "content_block": {"type": "text", "text": ""}}\n            t = b["text"]\n            for k in range(0, len(t), max(1, chunk_chars)):\n                yield {"type": "content_block_delta", "index": i, "delta": {"type": "text_delta", "text": t[k:k + chunk_chars]}}\n        else:\n            yield {"type": "content_block_start", "index": i, "content_block": {"type": "tool_use", "id": b["id"], "name": b["name"], "input": {}}}\n            js = json.dumps(b["input"], ensure_ascii=False)\n            for k in range(0, len(js), 40):\n                yield {"type": "content_block_delta", "index": i, "delta": {"type": "input_json_delta", "partial_json": js[k:k + 40]}}\n        yield {"type": "content_block_stop", "index": i}\n    yield {"type": "message_delta", "delta": {"stop_reason": m["stop_reason"], "stop_sequence": None}, "usage": {"output_tokens": m["usage"]["output_tokens"]}}\n    yield {"type": "message_stop"}\n\n\n# ---------------------------------------------------------------- SSE 文字（給直接送 HTTP 的腳本用）\ndef sse(events, done=False):\n    out = []\n    for e in events:\n        name = e.get("type") if isinstance(e, dict) and "type" in e and "object" not in e else None\n        out.append(("event: %s\\n" % name if name else "") + "data: " + json.dumps(e, ensure_ascii=False) + "\\n\\n")\n    if done:\n        out.append("data: [DONE]\\n\\n")\n    return "".join(out)\n\n\n# ---------------------------------------------------------------- 嵌入（回應）格式\ndef embeddings_response(vectors, model, tokens=0):\n    return {"object": "list", "model": model or "assistant-embedding",\n            "data": [{"object": "embedding", "index": i, "embedding": v} for i, v in enumerate(vectors)],\n            "usage": {"prompt_tokens": tokens, "total_tokens": tokens}}\n',"fa_net.py":'# -*- coding: utf-8 -*-\n"""\nfa_net — 一般 HTTP（不是 LLM 端點）的去處，以及 http.client 的攔截。\n\n兩個去處：\n  1. 本機網址（127.0.0.1、localhost、[::1]、*.localhost、*.local）\n     助理的沙盒有 mock 伺服器（資料存在 IndexedDB 的持久儲存那一層）時，請求就接給它；\n     沒有 mock 伺服器：網頁版回「連線被拒」（Pyodide 沒有 socket，本來就連不到），桌面版照原本連真的本機伺服器。\n  2. 外部網址（只有網頁版）\n     Pyodide 沒有 socket、又有 CORS，所以改走助理既有的出口 _terminalHttpFetch：有設定 proxy／Cloudflare Worker 就經過它，\n     沒設定就直接 fetch（可能被 CORS 擋下，錯誤訊息會說明）。桌面版的外部網址照原本連網，不經過這裡。\n\nhttp.client 的 HTTPConnection／HTTPSConnection.request() 會先問 route()；有人接手就不真的連線，getresponse() 回一個標準的 HTTPResponse。\nrequests／httpx／urllib 由 fa_http 的攔截呼叫同一個 route()（先看是不是 LLM 端點，再看這裡）。\n想讓某個主機完全不被攔截：環境變數 FA_HTTP_BYPASS_HOSTS=host1,host2。\n限制：只攔 request()（urlopen、requests 的 urllib3 都是用它）；自己用 putrequest／putheader／endheaders 逐步組請求的程式不攔。\n"""\nimport base64\nimport http.client\nimport io\nimport os\nimport sys\n\nimport fa_bridge\n\n_INSTALLED = {"done": False}\n\n\ndef is_local_host(host):\n    h = (host or "").lower().strip("[]")\n    return h in ("localhost", "127.0.0.1", "::1", "0.0.0.0") or h.startswith("127.") or h.endswith(".localhost") or h.endswith(".local")\n\n\ndef route(method, url, headers=None, body=b""):\n    """回 (status, headers_dict, body_bytes)；不接手就回 None。連不上會丟 ConnectionError。"""\n    if not fa_bridge.ACTIVE:\n        return None\n    try:\n        from urllib.parse import urlparse\n        u = urlparse(url)\n    except Exception:\n        return None\n    if not (u.scheme or "").startswith("http"):\n        return None\n    host = (u.hostname or "").lower()\n    if host in [h.strip().lower() for h in os.environ.get("FA_HTTP_BYPASS_HOSTS", "").split(",") if h.strip()]:\n        return None\n    local = is_local_host(host)\n    if not local and not fa_bridge.IN_BROWSER:\n        return None\n    if isinstance(body, str):\n        body = body.encode("utf-8")\n    args = {"method": (method or "GET").upper(), "url": url, "headers": {str(k): str(v) for k, v in (headers or {}).items()},\n            "b64": base64.b64encode(body).decode("ascii") if body else ""}\n    if local:\n        r = fa_bridge.call("net.local", args, timeout=90.0)\n        if r.get("found"):\n            return _pack(r)\n        if fa_bridge.IN_BROWSER:\n            names = r.get("servers") or []\n            raise ConnectionRefusedError("連不到 %s：網頁版沒有真的本機伺服器，也沒有開著的 mock 伺服器（沙盒的 sandbox_mock 部署過的：%s）。先用 sandbox_mock 部署一個伺服器程式再連。" % (host, "、".join(names) or "無"))\n        return None\n    try:\n        r = fa_bridge.call("net.fetch", args, timeout=180.0)\n    except fa_bridge.BridgeError as e:\n        raise ConnectionError(str(e))\n    return _pack(r)\n\n\ndef _pack(r):\n    h = {}\n    for k, v in r.get("headers") or []:\n        k = str(k).lower()\n        h[k] = (h[k] + ", " + v) if k in h and k != "set-cookie" else v\n    return int(r.get("status") or 502), h, base64.b64decode(r.get("b64") or "")\n\n\nclass _FakeSock(object):\n    def __init__(self, raw):\n        self._raw = raw\n\n    def makefile(self, *a, **k):\n        return io.BytesIO(self._raw)\n\n    def close(self):\n        pass\n\n\ndef _make_response(status, headers, body, reason, method):\n    lines = ["HTTP/1.1 %d %s" % (status, reason or http.client.responses.get(status, "Status"))]\n    hs = {k: v for k, v in headers.items() if k not in ("content-length", "transfer-encoding", "connection")}\n    for k, v in hs.items():\n        lines.append("%s: %s" % (k, v))\n    lines.append("Content-Length: %d" % len(body))\n    lines.append("Connection: close")\n    raw = ("\\r\\n".join(lines) + "\\r\\n\\r\\n").encode("latin-1", "replace") + (b"" if method == "HEAD" else body)\n    resp = http.client.HTTPResponse(_FakeSock(raw), method=method)\n    resp.begin()\n    return resp\n\n\ndef patch_http_client():\n    if getattr(http.client.HTTPConnection.request, "_fa_patched", False):\n        return\n    orig_request = http.client.HTTPConnection.request\n    orig_getresponse = http.client.HTTPConnection.getresponse\n    orig_close = http.client.HTTPConnection.close\n\n    def request(self, method, url, body=None, headers=None, *a, **kw):\n        self._fa_pending = None\n        self._fa_method = (method or "GET").upper()\n        if fa_bridge.ACTIVE:\n            try:\n                import fa_http\n                scheme = "https" if isinstance(self, http.client.HTTPSConnection) else "http"\n                default = 443 if scheme == "https" else 80\n                host = self.host if ":" not in self.host else "[" + self.host + "]"\n                full = url if url.startswith("http") else "%s://%s%s%s" % (scheme, host, "" if self.port == default else ":%d" % self.port, url)\n                payload = body\n                if payload is not None and not isinstance(payload, (bytes, bytearray, str)):\n                    payload = payload.read() if hasattr(payload, "read") else b"".join(x if isinstance(x, bytes) else str(x).encode("utf-8") for x in payload)\n                r = fa_http.route(method, full, dict(headers or {}), payload or b"")\n            except OSError as e:\n                self._fa_pending = e\n                return None\n            if r is not None:\n                self._fa_pending = r\n                return None\n        return orig_request(self, method, url, body, headers or {}, *a, **kw)\n\n    def getresponse(self):\n        p = getattr(self, "_fa_pending", None)\n        if p is None:\n            return orig_getresponse(self)\n        self._fa_pending = None\n        if isinstance(p, Exception):\n            raise p\n        status, h, payload = p[0], p[1], p[2]\n        reason = ""\n        return _make_response(status, h, payload, reason, getattr(self, "_fa_method", "GET"))\n\n    def close(self):\n        self._fa_pending = None\n        return orig_close(self)\n    request._fa_patched = True\n    http.client.HTTPConnection.request = request\n    http.client.HTTPConnection.getresponse = getresponse\n    http.client.HTTPConnection.close = close\n\n\ndef install():\n    if _INSTALLED["done"]:\n        return\n    _INSTALLED["done"] = True\n    try:\n        patch_http_client()\n    except Exception as e:\n        sys.stderr.write("[fa-bridge] patch http.client: %s\\n" % e)\n',"fa_run.py":'# -*- coding: utf-8 -*-\n"""\nfa_run.py — Floating AI Assistant 執行技能包 Python 腳本的啟動器。\n\n用法（由助理自動改寫指令，不需要手動打）：\n    python fa_run.py --rpc <信箱資料夾> -- <腳本.py> [腳本參數…]\n    python fa_run.py --rpc <信箱資料夾> --argsfile <args.json>   （腳本路徑或參數含中文等非 ASCII 字元時用）\n\n作用：讓腳本 import 到「轉接版」的 playwright（實際呼叫助理的瀏覽器工具）與 fa_bridge，\n並把同樣的設定傳給腳本再啟動的子程序（PYTHONPATH），然後照原樣執行腳本。\n"""\nimport os\nimport runpy\nimport sys\n\n\ndef main():\n    argv = sys.argv[1:]\n    rpc = ""\n    if argv[:1] == ["--rpc"] and len(argv) >= 2:\n        rpc = argv[1]\n        argv = argv[2:]\n    if argv[:1] == ["--argsfile"] and len(argv) >= 2:\n        # Windows 的指令列碰到中文路徑會變成亂碼（例如 週報 → �g��），所以腳本路徑與參數改放在 UTF-8 的 JSON 檔裡傳進來\n        import json\n        with open(argv[1], "r", encoding="utf-8") as f:\n            data = json.load(f)\n        argv = [data["script"]] + list(data.get("args", []))\n    elif argv[:1] == ["--"]:\n        argv = argv[1:]\n    if not argv:\n        sys.stderr.write("fa_run.py: 沒有指定要執行的腳本\\n")\n        return 2\n    # Windows 主控台預設是 cp950，助理讀輸出時當 UTF-8 解碼，中文會變成亂碼（�g��）；統一輸出 UTF-8（子程序也一樣）\n    os.environ["PYTHONIOENCODING"] = "utf-8"\n    os.environ["PYTHONUTF8"] = "1"\n    for _s in (sys.stdout, sys.stderr):\n        try:\n            _s.reconfigure(encoding="utf-8")\n        except Exception:\n            pass\n    here = os.path.dirname(os.path.abspath(__file__))\n    script = os.path.abspath(argv[0])\n    os.environ["FA_BRIDGE_RPC"] = rpc\n    os.environ["PYTHONPATH"] = here + os.pathsep + os.environ.get("PYTHONPATH", "")\n    sys.path.insert(0, here)\n    sys.path.insert(1, os.path.dirname(script))  # 跟直接 python script.py 一樣，腳本所在資料夾在 sys.path 裡\n    sys.argv = [script] + argv[1:]\n    try:\n        import fa_bridge\n        fa_bridge.install_hooks()  # 直接送 HTTP 的 LLM 呼叫（OpenAI 標準與 Claude 格式）轉給助理的模型\n    except Exception as e:\n        sys.stderr.write("[fa-bridge] install_hooks: %s" % e + chr(10))\n    runpy.run_path(script, run_name="__main__")\n    return 0\n\n\nif __name__ == "__main__":\n    sys.exit(main() or 0)\n',"fa_sim.py":'# -*- coding: utf-8 -*-\n"""\nfa_sim — 助理沒有對應能力時的「回應模擬」（只用標準函式庫）。\n\nOpenAI／Claude 的 API 有些功能助理沒有對應的東西（審核、檔案、批次、微調、assistants…）。\n腳本在這些地方丟例外會讓整支腳本壞掉，所以這裡提供「結構正確、內容誠實」的模擬回應：\n  * 欄位與型別跟真的一樣，腳本的後續處理不會因為少欄位而當掉；\n  * 內容不假裝是真的：微調工作直接回報不支援、審核一律回報未違規並標示是模擬；\n  * 每次模擬都會通知助理（fa_llm.note_simulated），上層 AI 看得到「哪些呼叫是模擬的」。\n能真的做的就真的做：batches 逐筆走助理的模型、threads／runs 用助理的模型回答。\n圖片、語音、嵌入、工具呼叫不模擬——先從已設定的 LLM Model 找有支援的，所有 Model 都不支援才丟 NotSupported。\n"""\nimport base64\nimport io\nimport json\nimport re\nimport struct\nimport time\nimport uuid\nimport zlib\n\nimport fa_llm\n\n_STORE = {"files": {}, "batches": {}, "threads": {}, "vector_stores": {}, "assistants": {}, "jobs": {}}\n\n\ndef _id(p):\n    return "%s_%s" % (p, uuid.uuid4().hex[:20])\n\n\ndef _now():\n    return int(time.time())\n\n\n# 圖片、語音、嵌入、工具呼叫「不」在這裡模擬：它們要先從助理已設定的 LLM Model 清單裡找有這個能力的 Model（fa_llm.upstream），\n# 所有 Model 都不支援才丟 NotSupported，不會回傳假的結果。\nclass SimBytes(object):\n    """二進位內容的回應（有 .content、.read()、.iter_bytes()、.stream_to_file()）。語音合成等真的由 Model 回傳的二進位用這個包起來。"""\n\n    def __init__(self, data, content_type=None):\n        self.content = data\n        self.content_type = content_type\n\n    def read(self):\n        return self.content\n\n    def iter_bytes(self, chunk_size=1024):\n        for i in range(0, len(self.content), chunk_size):\n            yield self.content[i:i + chunk_size]\n\n    def stream_to_file(self, path):\n        with open(path, "wb") as f:\n            f.write(self.content)\n\n    write_to_file = stream_to_file\n\n    @property\n    def text(self):\n        return self.content.decode("utf-8", "replace")\n\n\ndef _mark(d, api):\n    d["fa_simulated"] = True\n    fa_llm.note_simulated(api)\n    return d\n\n\n# ---------------------------------------------------------------- 審核\n_CATS = ["hate", "hate/threatening", "harassment", "harassment/threatening", "self-harm", "self-harm/intent", "self-harm/instructions",\n         "sexual", "sexual/minors", "violence", "violence/graphic", "illicit", "illicit/violent"]\n\n\ndef moderation(input=None, model=None, **kw):\n    items = input if isinstance(input, list) else [input]\n    res = [{"flagged": False, "categories": {c: False for c in _CATS}, "category_scores": {c: 0.0 for c in _CATS}} for _ in items]\n    return _mark({"id": _id("modr"), "model": model or "omni-moderation-latest", "results": res}, "moderations")\n\n\n# ---------------------------------------------------------------- 模型\ndef models(current):\n    m = {"id": current or "assistant", "object": "model", "created": _now(), "owned_by": "floating-assistant"}\n    return {"object": "list", "data": [m]}, m\n\n\n# ---------------------------------------------------------------- 檔案（記憶體內）\ndef file_create(file=None, purpose="assistants", **kw):\n    data = b""\n    name = "file"\n    if isinstance(file, tuple):\n        name = file[0]\n        data = file[1] if len(file) > 1 else b""\n        data = data.read() if hasattr(data, "read") else data\n    elif hasattr(file, "read"):\n        data = file.read()\n        name = getattr(file, "name", name)\n    elif isinstance(file, (bytes, str)):\n        data = file if isinstance(file, bytes) else file.encode("utf-8")\n    elif isinstance(file, str):\n        data = open(file, "rb").read()\n        name = file\n    if isinstance(data, str):\n        data = data.encode("utf-8")\n    fid = _id("file")\n    meta = {"id": fid, "object": "file", "bytes": len(data), "created_at": _now(), "filename": str(name).split("/")[-1].split(chr(92))[-1], "purpose": purpose, "status": "processed"}\n    _STORE["files"][fid] = (meta, data)\n    return _mark(dict(meta), "files.create")\n\n\ndef file_get(fid):\n    if fid not in _STORE["files"]:\n        raise KeyError(fid)\n    return _STORE["files"][fid]\n\n\ndef file_list():\n    return {"object": "list", "data": [m for m, _ in _STORE["files"].values()]}\n\n\ndef file_delete(fid):\n    _STORE["files"].pop(fid, None)\n    return {"id": fid, "object": "file", "deleted": True}\n\n\n# ---------------------------------------------------------------- 批次：真的逐筆走助理的模型\ndef batch_create(input_file_id=None, endpoint="/v1/chat/completions", completion_window="24h", metadata=None, **kw):\n    meta, data = file_get(input_file_id)\n    outs, errs, total = [], [], 0\n    for line in data.decode("utf-8", "replace").splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        total += 1\n        try:\n            item = json.loads(line)\n            body = item.get("body") or {}\n            if "messages" in body:\n                resp = fa_llm.complete(fa_llm.chat_request(**body))\n            else:\n                raise ValueError("只支援 chat/completions 的批次")\n            outs.append({"id": _id("batch_req"), "custom_id": item.get("custom_id"), "response": {"status_code": 200, "request_id": _id("req"), "body": resp}, "error": None})\n        except Exception as e:\n            errs.append({"id": _id("batch_req"), "custom_id": (item or {}).get("custom_id") if isinstance(locals().get("item"), dict) else None,\n                         "response": None, "error": {"code": "failed", "message": str(e)[:300]}})\n    ofid = errfid = None\n    if outs:\n        ofid = file_create(("batch_output.jsonl", "\\n".join(json.dumps(o, ensure_ascii=False) for o in outs).encode("utf-8")), purpose="batch_output")["id"]\n    if errs:\n        errfid = file_create(("batch_errors.jsonl", "\\n".join(json.dumps(o, ensure_ascii=False) for o in errs).encode("utf-8")), purpose="batch_output")["id"]\n    bid = _id("batch")\n    b = {"id": bid, "object": "batch", "endpoint": endpoint, "input_file_id": input_file_id, "completion_window": completion_window, "status": "completed",\n         "output_file_id": ofid, "error_file_id": errfid, "created_at": _now(), "completed_at": _now(),\n         "request_counts": {"total": total, "completed": len(outs), "failed": len(errs)}, "metadata": metadata}\n    _STORE["batches"][bid] = b\n    return b\n\n\ndef batch_get(bid):\n    if bid not in _STORE["batches"]:\n        raise KeyError(bid)\n    return _STORE["batches"][bid]\n\n\n# ---------------------------------------------------------------- 微調：誠實回報不支援\ndef finetune_create(model=None, training_file=None, **kw):\n    jid = _id("ftjob")\n    j = {"id": jid, "object": "fine_tuning.job", "model": model, "training_file": training_file, "created_at": _now(), "status": "failed", "fine_tuned_model": None,\n         "error": {"code": "not_supported", "message": "AI 助理的轉接層不支援微調（沒有可訓練的模型）。這是模擬回應。", "param": None}}\n    _STORE["jobs"][jid] = j\n    return _mark(dict(j), "fine_tuning.jobs.create")\n\n\n# ---------------------------------------------------------------- threads／runs（Assistants，最小版：用助理的模型回答）\ndef thread_create(messages=None, **kw):\n    tid = _id("thread")\n    t = {"id": tid, "object": "thread", "created_at": _now(), "metadata": kw.get("metadata") or {}}\n    _STORE["threads"][tid] = {"meta": t, "messages": []}\n    for m in messages or []:\n        message_create(tid, role=m.get("role", "user"), content=m.get("content", ""))\n    return _mark(dict(t), "beta.threads.create")\n\n\ndef message_create(thread_id, role="user", content="", **kw):\n    th = _STORE["threads"].get(thread_id)\n    if th is None:\n        raise KeyError(thread_id)\n    msg = {"id": _id("msg"), "object": "thread.message", "created_at": _now(), "thread_id": thread_id, "role": role,\n           "content": [{"type": "text", "text": {"value": fa_llm.text_of(content), "annotations": []}}], "assistant_id": kw.get("assistant_id"), "run_id": kw.get("run_id")}\n    th["messages"].append(msg)\n    return msg\n\n\ndef messages_list(thread_id, order="desc", limit=20):\n    th = _STORE["threads"].get(thread_id)\n    if th is None:\n        raise KeyError(thread_id)\n    msgs = list(th["messages"])\n    if order == "desc":\n        msgs.reverse()\n    return {"object": "list", "data": msgs[:int(limit or 20)], "has_more": False}\n\n\ndef run_create(thread_id, assistant_id=None, instructions=None, **kw):\n    th = _STORE["threads"].get(thread_id)\n    if th is None:\n        raise KeyError(thread_id)\n    asst = _STORE["assistants"].get(assistant_id) or {}\n    msgs = []\n    sysm = instructions or asst.get("instructions")\n    if sysm:\n        msgs.append({"role": "system", "content": sysm})\n    for m in th["messages"]:\n        msgs.append({"role": m["role"], "content": m["content"][0]["text"]["value"]})\n    rid = _id("run")\n    try:\n        resp = fa_llm.complete(fa_llm.chat_request(messages=msgs))\n        text = fa_llm.text_of(((resp.get("choices") or [{}])[0].get("message") or {}).get("content"))\n        message_create(thread_id, role="assistant", content=text, assistant_id=assistant_id, run_id=rid)\n        status, err = "completed", None\n    except Exception as e:\n        status, err = "failed", {"code": "server_error", "message": str(e)[:300]}\n    return {"id": rid, "object": "thread.run", "created_at": _now(), "thread_id": thread_id, "assistant_id": assistant_id, "status": status, "last_error": err,\n            "completed_at": _now() if status == "completed" else None, "model": asst.get("model") or "assistant"}\n\n\ndef assistant_create(**kw):\n    aid = _id("asst")\n    a = {"id": aid, "object": "assistant", "created_at": _now(), "name": kw.get("name"), "description": kw.get("description"), "model": kw.get("model") or "assistant",\n         "instructions": kw.get("instructions"), "tools": kw.get("tools") or [], "metadata": kw.get("metadata") or {}}\n    _STORE["assistants"][aid] = a\n    return _mark(dict(a), "beta.assistants.create")\n\n\ndef vector_store_create(name=None, **kw):\n    vid = _id("vs")\n    v = {"id": vid, "object": "vector_store", "created_at": _now(), "name": name, "status": "completed", "file_counts": {"in_progress": 0, "completed": 0, "failed": 0, "cancelled": 0, "total": 0}}\n    _STORE["vector_stores"][vid] = v\n    return _mark(dict(v), "vector_stores.create")\n',"fa_sqlite.py":'# -*- coding: utf-8 -*-\n"""\nfa_sqlite — 走助理 SQLite 引擎的 sqlite3 相容介面（DB-API 風格）。\n\n為什麼不直接用標準函式庫的 sqlite3：\n  * 檔案可以是助理看得到、Python 看不到的地方：fap:<名稱>/<路徑>（授權的資料夾）、終端機沙盒內的檔案、file:<真實路徑>；\n  * 與終端機的 sqlite3／sqlitebrowser 共用同一個引擎（SQLite 3.53、含 FTS5），結果一致；\n  * 大型資料庫由引擎在主行程開檔，不吃 Python 的記憶體。\n只在執行技能包的腳本裡可用（要有橋接，見 fa_bridge）；一般的 Python 想開本機資料庫，直接用標準函式庫的 sqlite3 就好。\n\n    import fa_sqlite as sqlite3\n    con = sqlite3.connect("fap:myproj/.floating-assistant/index/index.sqlite3", readonly=True)\n    for name, line in con.execute("select name, line from symbols where name = ?", ("main",)):\n        print(name, line)\n    con.close()\n\n交易語意與標準 sqlite3 相同：isolation_level 預設 ""，第一個 INSERT／UPDATE／DELETE／REPLACE 前自動 BEGIN，commit() 才提交\n並把變更寫回來源（暫存副本會寫回 fap／沙盒）；isolation_level=None 是自動提交。\n"""\nimport base64\nimport json\n\nimport fa_bridge\n\nparamstyle = "qmark"\napilevel = "2.0"\nthreadsafety = 1\nsqlite_version = "3.53.4"\nversion = "fa-1"\nPARSE_DECLTYPES = 1\nPARSE_COLNAMES = 2\n\n\nclass Error(Exception):\n    pass\n\n\nclass Warning(Exception):\n    pass\n\n\nclass InterfaceError(Error):\n    pass\n\n\nclass DatabaseError(Error):\n    pass\n\n\nclass DataError(DatabaseError):\n    pass\n\n\nclass OperationalError(DatabaseError):\n    pass\n\n\nclass IntegrityError(DatabaseError):\n    pass\n\n\nclass InternalError(DatabaseError):\n    pass\n\n\nclass ProgrammingError(DatabaseError):\n    pass\n\n\nclass NotSupportedError(DatabaseError):\n    pass\n\n\ndef _raise(msg):\n    m = str(msg)\n    low = m.lower()\n    if "constraint failed" in low or "unique constraint" in low or "foreign key" in low:\n        raise IntegrityError(m)\n    if "no such" in low or "syntax error" in low or "locked" in low or "readonly" in low or "unable to open" in low or "already exists" in low:\n        raise OperationalError(m)\n    if "bind" in low or "parameter" in low:\n        raise ProgrammingError(m)\n    raise DatabaseError(m)\n\n\ndef _enc(v):\n    if v is None or isinstance(v, (str, float)):\n        return v\n    if isinstance(v, bool):\n        return 1 if v else 0\n    if isinstance(v, int):\n        return v if -(2 ** 53) < v < 2 ** 53 else {"$int": str(v)}\n    if isinstance(v, (bytes, bytearray, memoryview)):\n        return {"$blob": base64.b64encode(bytes(v)).decode("ascii")}\n    raise InterfaceError("不支援的參數型別：%s" % type(v).__name__)\n\n\ndef _dec(v):\n    if isinstance(v, dict):\n        if "$blob" in v:\n            return base64.b64decode(v["$blob"])\n        if "$int" in v:\n            return int(v["$int"])\n        if "$real" in v:\n            return float(v["$real"])\n    return v\n\n\ndef _bind(params):\n    if params is None:\n        return None\n    if isinstance(params, dict):\n        return {k: _enc(v) for k, v in params.items()}\n    return [_enc(v) for v in params]\n\n\nclass Row(object):\n    """sqlite3.Row 的對應：可以用位置或欄位名稱取值。"""\n    __slots__ = ("_keys", "_vals")\n\n    def __init__(self, cursor, row):\n        self._keys = [d[0] for d in cursor.description]\n        self._vals = tuple(row)\n\n    def keys(self):\n        return list(self._keys)\n\n    def __getitem__(self, k):\n        if isinstance(k, str):\n            for i, n in enumerate(self._keys):\n                if n.lower() == k.lower():\n                    return self._vals[i]\n            raise IndexError("No item with that key")\n        return self._vals[k]\n\n    def __iter__(self):\n        return iter(self._vals)\n\n    def __len__(self):\n        return len(self._vals)\n\n    def __eq__(self, other):\n        return isinstance(other, Row) and self._vals == other._vals and self._keys == other._keys\n\n    def __repr__(self):\n        return "<Row %s>" % dict(zip(self._keys, self._vals))\n\n\n_WRITE = ("INSERT", "UPDATE", "DELETE", "REPLACE")\n\n\ndef _first_word(sql):\n    s = sql.lstrip()\n    while s.startswith("--") or s.startswith("/*"):\n        if s.startswith("--"):\n            nl = s.find("\\n")\n            s = "" if nl < 0 else s[nl + 1:].lstrip()\n        else:\n            end = s.find("*/")\n            s = "" if end < 0 else s[end + 2:].lstrip()\n    w = s.split(None, 1)[0].upper() if s else ""\n    return w\n\n\nclass Cursor(object):\n    arraysize = 1\n\n    def __init__(self, con):\n        self.connection = con\n        self.description = None\n        self.rowcount = -1\n        self.lastrowid = None\n        self.row_factory = None\n        self._rows = []\n        self._pos = 0\n\n    def _run(self, sql, params):\n        con = self.connection\n        con._check()\n        w = _first_word(sql)\n        if con.isolation_level is not None and not con._in_txn and w in _WRITE:\n            con._exec("BEGIN")\n            con._in_txn = True\n        results = con._exec(sql, params)\n        res = results[-1] if results else {"columns": [], "rows": []}\n        return res\n\n    def execute(self, sql, parameters=()):\n        res = self._run(sql, _bind(parameters))\n        cols = res.get("columns") or []\n        self.description = tuple((c, None, None, None, None, None, None) for c in cols) if cols else None\n        self._rows = [tuple(_dec(v) for v in r) for r in (res.get("rows") or [])]\n        self._pos = 0\n        self.rowcount = -1 if cols else int(res.get("changes") or 0)\n        lid = res.get("last_id")\n        if lid is not None:\n            self.lastrowid = _dec(lid)\n        if self.connection._in_txn is False and _first_word(sql) in ("BEGIN", "SAVEPOINT"):\n            self.connection._in_txn = True\n        elif _first_word(sql) in ("COMMIT", "END", "ROLLBACK"):\n            self.connection._in_txn = False\n        return self\n\n    def executemany(self, sql, seq):\n        total = 0\n        for p in seq:\n            self.execute(sql, p)\n            total += max(0, self.rowcount)\n        self.rowcount = total\n        return self\n\n    def executescript(self, script):\n        con = self.connection\n        con.commit()\n        con._exec(script)\n        con._in_txn = False\n        return self\n\n    def _wrap(self, r):\n        f = self.row_factory or self.connection.row_factory\n        return f(self, r) if f else r\n\n    def fetchone(self):\n        if self._pos >= len(self._rows):\n            return None\n        r = self._rows[self._pos]\n        self._pos += 1\n        return self._wrap(r)\n\n    def fetchmany(self, size=None):\n        n = size or self.arraysize\n        out = []\n        while len(out) < n:\n            r = self.fetchone()\n            if r is None:\n                break\n            out.append(r)\n        return out\n\n    def fetchall(self):\n        out = []\n        while True:\n            r = self.fetchone()\n            if r is None:\n                break\n            out.append(r)\n        return out\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        r = self.fetchone()\n        if r is None:\n            raise StopIteration\n        return r\n\n    def close(self):\n        self._rows = []\n\n    def setinputsizes(self, *a):\n        pass\n\n    def setoutputsize(self, *a):\n        pass\n\n\nclass Connection(object):\n    Error = Error\n    DatabaseError = DatabaseError\n    OperationalError = OperationalError\n    IntegrityError = IntegrityError\n    ProgrammingError = ProgrammingError\n\n    def __init__(self, ref, readonly=False, create=True, isolation_level="", max_rows=1000000):\n        self.row_factory = None\n        self.isolation_level = isolation_level\n        self.text_factory = str\n        self._in_txn = False\n        self._closed = False\n        self._max_rows = max_rows\n        self._ref = ref\n        r = fa_bridge.call("sqlite.open", {"ref": ref, "readonly": bool(readonly), "create": bool(create)})\n        self._db = r["db"]\n        self.label = r.get("label", ref)\n        self.readonly = bool(readonly)\n\n    def _check(self):\n        if self._closed:\n            raise ProgrammingError("Cannot operate on a closed database.")\n\n    def _exec(self, sql, bind=None):\n        args = {"db": self._db, "sql": sql, "limit": self._max_rows, "typed": False}\n        if bind is not None:\n            args["bind"] = bind\n        r = fa_bridge.call("sqlite.exec", args)\n        results = r.get("results") or []\n        for x in results:\n            if x.get("error"):\n                _raise(x["error"])\n        return results\n\n    def cursor(self, factory=None):\n        self._check()\n        c = (factory or Cursor)(self)\n        return c\n\n    def execute(self, sql, parameters=()):\n        return self.cursor().execute(sql, parameters)\n\n    def executemany(self, sql, seq):\n        return self.cursor().executemany(sql, seq)\n\n    def executescript(self, script):\n        return self.cursor().executescript(script)\n\n    def commit(self):\n        self._check()\n        if self._in_txn:\n            self._exec("COMMIT")\n            self._in_txn = False\n        fa_bridge.call("sqlite.sync", {"db": self._db})  # 暫存副本寫回 fap／沙盒\n\n    def rollback(self):\n        self._check()\n        if self._in_txn:\n            self._exec("ROLLBACK")\n            self._in_txn = False\n\n    def sync(self):\n        self.commit()\n\n    def close(self):\n        if self._closed:\n            return\n        try:\n            if self._in_txn:\n                self._exec("ROLLBACK")  # 與標準 sqlite3 一樣：close 不會提交\n        except Exception:\n            pass\n        self._closed = True\n        fa_bridge.call("sqlite.close", {"db": self._db})\n\n    @property\n    def total_changes(self):\n        r = self._exec("select total_changes()")\n        return int(r[0]["rows"][0][0]) if r and r[0].get("rows") else 0\n\n    @property\n    def in_transaction(self):\n        return self._in_txn\n\n    def create_function(self, *a, **k):\n        raise NotSupportedError("fa_sqlite 不支援自訂 SQL 函式（引擎在助理的主行程裡）")\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, et, ev, tb):\n        if et is None:\n            self.commit()\n        else:\n            self.rollback()\n        return False\n\n\ndef connect(database, timeout=5.0, detect_types=0, isolation_level="", check_same_thread=True, factory=None, cached_statements=128, uri=False, readonly=False, create=True, max_rows=1000000):\n    """database：:memory:、fap:<名稱>/<路徑>、file:<真實路徑>、或助理終端機沙盒內的路徑。"""\n    return Connection(database, readonly=readonly, create=create, isolation_level=isolation_level, max_rows=max_rows)\n\n\ndef complete_statement(sql):\n    s = sql.rstrip()\n    return s.endswith(";") and s.count("\'") % 2 == 0\n',"fa_ws.py":'# -*- coding: utf-8 -*-\n"""\nfa_ws — Python 的 WebSocket 用戶端接到沙盒 mock 伺服器（跟 fa_net 的 HTTP 同一層，支援 websocket-client 與 websockets）。\n\n本機網址（127.0.0.1、localhost、[::1]、*.localhost、*.local）有 mock 伺服器就接過去；\n沒有：網頁版丟 ConnectionRefusedError（Pyodide 沒有 socket），桌面版照原本連真的本機伺服器。\n外部網址：網頁版丟 ConnectionError（沒有可用的 WebSocket 出口），桌面版照原本連網。\n\n支援：\n  websocket-client：websocket.create_connection()（send／send_binary／recv／recv_data／settimeout／close）、WebSocketApp.run_forever()（on_open／on_message／on_error／on_close、send、close）\n  websockets：websockets.sync.client.connect()、websockets.connect()／websockets.asyncio.client.connect()（async with／await／async for、send／recv／close）\n模組在轉接安裝之後才被 import 也會補上（見 fa_http 的 import 攔截）。收訊息是短輪詢（每次最多等 250 毫秒），非同步程式同時收送不會互相卡住。\n"""\nimport base64\nimport sys\nimport time\n\nimport fa_bridge\nimport fa_net\n\n\nclass Closed(Exception):\n    def __init__(self, code=1005, reason=""):\n        Exception.__init__(self, "連線已關閉（%s %s）" % (code, reason))\n        self.code = code\n        self.reason = reason\n\n\ndef _applies(url):\n    """要接手就回 True；不接手回 False（桌面版放行）；網頁版沒出口就丟錯。"""\n    if not fa_bridge.ACTIVE:\n        return False\n    try:\n        from urllib.parse import urlparse\n        host = (urlparse(url).hostname or "").lower()\n    except Exception:\n        return False\n    if fa_net.is_local_host(host):\n        return True\n    if fa_bridge.IN_BROWSER:\n        raise ConnectionError("網頁版連不到外部 WebSocket（%s）：沒有可用的 WebSocket 出口；本機網址（127.0.0.1／localhost／*.local）可以連沙盒的 mock 伺服器。" % host)\n    return False\n\n\ndef _headers(h):\n    out = {}\n    if isinstance(h, dict):\n        out = {str(k): str(v) for k, v in h.items()}\n    elif h:\n        for x in h:\n            if isinstance(x, (tuple, list)) and len(x) == 2:\n                out[str(x[0])] = str(x[1])\n            elif isinstance(x, str) and ":" in x:\n                k, _, v = x.partition(":")\n                out[k.strip()] = v.strip()\n    return out\n\n\ndef _opened(r, url):\n    if not r.get("found"):\n        if fa_bridge.IN_BROWSER:\n            raise ConnectionRefusedError("連不到 %s：網頁版沒有真的本機伺服器，也沒有開著的 mock 伺服器（沙盒部署過的：%s）。先用 sandbox_mock 部署一個有 WebSocket 的伺服器程式。" % (url, "、".join(r.get("servers") or []) or "無"))\n        return None\n    if not r.get("ok"):\n        raise ConnectionError("WebSocket 連線失敗：%s" % r.get("error"))\n    return _Sock(r["id"])\n\n\ndef open_mock(url, headers=None):\n    """接手就回 _Sock；桌面版沒有 mock 伺服器回 None（照原本連）。"""\n    if not _applies(url):\n        return None\n    return _opened(fa_bridge.call("ws.open", {"url": url, "headers": _headers(headers)}, timeout=30.0), url)\n\n\nasync def aopen_mock(url, headers=None):\n    if not _applies(url):\n        return None\n    return _opened(await fa_bridge.acall("ws.open", {"url": url, "headers": _headers(headers)}, timeout=30.0), url)\n\n\ndef _msg(r):\n    if r.get("text") is not None:\n        return r["text"]\n    if r.get("binary"):\n        return base64.b64decode(r.get("b64") or "")\n    return None\n\n\nclass _Sock(object):\n    def __init__(self, sid):\n        self.id = sid\n        self.closed = None\n\n    def _send_args(self, data):\n        if isinstance(data, (bytes, bytearray, memoryview)):\n            return {"id": self.id, "binary": True, "b64": base64.b64encode(bytes(data)).decode("ascii")}\n        return {"id": self.id, "text": str(data)}\n\n    def _check(self, r):\n        if r.get("closed"):\n            self.closed = r["closed"]\n            raise Closed(self.closed.get("code"), self.closed.get("reason"))\n\n    def send(self, data):\n        self._check(fa_bridge.call("ws.send", self._send_args(data), timeout=30.0) or {})\n\n    async def asend(self, data):\n        self._check(await fa_bridge.acall("ws.send", self._send_args(data), timeout=30.0) or {})\n\n    def recv(self, timeout=None):\n        end = None if timeout is None else time.time() + timeout\n        while True:\n            if self.closed:\n                raise Closed(self.closed.get("code"), self.closed.get("reason"))\n            r = fa_bridge.call("ws.recv", {"id": self.id, "wait_ms": 250}, timeout=30.0) or {}\n            self._check(r)\n            m = _msg(r)\n            if m is not None:\n                return m\n            if end is not None and time.time() >= end:\n                raise TimeoutError("等不到 WebSocket 訊息")\n\n    async def arecv(self, timeout=None):\n        import asyncio\n        end = None if timeout is None else time.time() + timeout\n        while True:\n            if self.closed:\n                raise Closed(self.closed.get("code"), self.closed.get("reason"))\n            r = await fa_bridge.acall("ws.recv", {"id": self.id, "wait_ms": 250}, timeout=30.0) or {}\n            self._check(r)\n            m = _msg(r)\n            if m is not None:\n                return m\n            if end is not None and time.time() >= end:\n                raise TimeoutError("等不到 WebSocket 訊息")\n            await asyncio.sleep(0)\n\n    def close(self, code=1000, reason=""):\n        if self.closed is None:\n            try:\n                fa_bridge.call("ws.close", {"id": self.id, "code": code, "reason": reason}, timeout=15.0)\n            except Exception:\n                pass\n            self.closed = {"code": code, "reason": reason}\n\n    async def aclose(self, code=1000, reason=""):\n        if self.closed is None:\n            try:\n                await fa_bridge.acall("ws.close", {"id": self.id, "code": code, "reason": reason}, timeout=15.0)\n            except Exception:\n                pass\n            self.closed = {"code": code, "reason": reason}\n\n\n# ---------------------------------------------------------------- websocket-client\ndef patch_websocket_client():\n    import websocket\n    if getattr(websocket.create_connection, "_fa_patched", False):\n        return\n    exc_closed = getattr(websocket, "WebSocketConnectionClosedException", Exception)\n    exc_timeout = getattr(websocket, "WebSocketTimeoutException", TimeoutError)\n\n    class _WSC(object):\n        def __init__(self, sock):\n            self._s = sock\n            self.timeout = None\n            self.status = 101\n            self.headers = {}\n\n        @property\n        def connected(self):\n            return self._s.closed is None\n\n        def send(self, payload, opcode=1):\n            self._s.send(payload.encode("utf-8") if opcode == 2 and isinstance(payload, str) else payload)\n            return len(payload)\n\n        def send_text(self, s):\n            return self.send(s)\n\n        def send_binary(self, b):\n            self._s.send(bytes(b))\n            return len(b)\n\n        def recv(self):\n            try:\n                return self._s.recv(self.timeout)\n            except Closed:\n                raise exc_closed("Connection is already closed.")\n            except TimeoutError:\n                raise exc_timeout("timed out")\n\n        def recv_data(self, control_frame=False):\n            m = self.recv()\n            return (2, m) if isinstance(m, bytes) else (1, m.encode("utf-8"))\n\n        def settimeout(self, t):\n            self.timeout = t\n\n        def gettimeout(self):\n            return self.timeout\n\n        def getstatus(self):\n            return 101\n\n        def getheaders(self):\n            return {}\n\n        def close(self, status=1000, reason=b"", timeout=3):\n            self._s.close(status, reason.decode("utf-8", "replace") if isinstance(reason, bytes) else str(reason))\n\n        shutdown = close\n\n        def __enter__(self):\n            return self\n\n        def __exit__(self, *a):\n            self.close()\n\n        def __iter__(self):\n            while self.connected:\n                try:\n                    yield self.recv()\n                except exc_closed:\n                    return\n\n    orig_create = websocket.create_connection\n\n    def create_connection(url, timeout=None, **options):\n        s = open_mock(url, options.get("header"))\n        if s is None:\n            return orig_create(url, timeout=timeout, **options)\n        c = _WSC(s)\n        c.timeout = timeout\n        return c\n    create_connection._fa_patched = True\n    websocket.create_connection = create_connection\n\n    App = getattr(websocket, "WebSocketApp", None)\n    if App is None:\n        return\n    orig_run, orig_send, orig_close = App.run_forever, App.send, App.close\n\n    def run_forever(self, *a, **kw):\n        s = None\n        try:\n            s = open_mock(self.url, getattr(self, "header", None))\n        except Exception as e:\n            self._fa_call("on_error", e)\n            return False\n        if s is None:\n            return orig_run(self, *a, **kw)\n        self._fa_sock = s\n        self.keep_running = True\n        self._fa_call("on_open")\n        try:\n            while self.keep_running and s.closed is None:\n                try:\n                    m = s.recv(0.25)\n                except TimeoutError:\n                    continue\n                except Closed:\n                    break\n                self._fa_call("on_message", m)\n        except Exception as e:\n            self._fa_call("on_error", e)\n        finally:\n            c = s.closed or {"code": 1005, "reason": ""}\n            s.close()\n            self.keep_running = False\n            self._fa_call("on_close", c.get("code"), c.get("reason"))\n        return False\n\n    def _fa_call(self, name, *args):\n        cb = getattr(self, name, None)\n        if cb:\n            cb(self, *args)\n\n    def send(self, data, opcode=1):\n        s = getattr(self, "_fa_sock", None)\n        if s is None:\n            return orig_send(self, data, opcode)\n        s.send(data.encode("utf-8") if opcode == 2 and isinstance(data, str) else data)\n\n    def close(self, **kw):\n        s = getattr(self, "_fa_sock", None)\n        if s is None:\n            return orig_close(self, **kw)\n        self.keep_running = False\n        s.close(kw.get("status", 1000), "")\n    App.run_forever, App.send, App.close, App._fa_call = run_forever, send, close, _fa_call\n\n\n# ---------------------------------------------------------------- websockets\ndef _closed_exc():\n    try:\n        from websockets.exceptions import ConnectionClosedOK\n        return ConnectionClosedOK\n    except Exception:\n        return Closed\n\n\ndef _mk_closed(c):\n    cls = _closed_exc()\n    try:\n        return cls(None, None)\n    except Exception:\n        return cls(c.code, c.reason)\n\n\nclass _WSS(object):\n    """websockets.sync.client 的連線。"""\n\n    def __init__(self, sock):\n        self._s = sock\n\n    def send(self, message, text=None):\n        try:\n            self._s.send(message)\n        except Closed as c:\n            raise _mk_closed(c)\n\n    def recv(self, timeout=None, decode=None):\n        try:\n            m = self._s.recv(timeout)\n        except Closed as c:\n            raise _mk_closed(c)\n        if decode is True and isinstance(m, bytes):\n            return m.decode("utf-8")\n        if decode is False and isinstance(m, str):\n            return m.encode("utf-8")\n        return m\n\n    def close(self, code=1000, reason=""):\n        self._s.close(code, reason)\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *a):\n        self.close()\n\n    def __iter__(self):\n        while True:\n            try:\n                yield self.recv()\n            except _closed_exc():\n                return\n\n    @property\n    def open(self):\n        return self._s.closed is None\n\n    @property\n    def closed(self):\n        return self._s.closed is not None\n\n\nclass _AWSS(object):\n    """websockets 非同步連線。"""\n\n    def __init__(self, sock):\n        self._s = sock\n\n    async def send(self, message, text=None):\n        try:\n            await self._s.asend(message)\n        except Closed as c:\n            raise _mk_closed(c)\n\n    async def recv(self, decode=None):\n        try:\n            m = await self._s.arecv()\n        except Closed as c:\n            raise _mk_closed(c)\n        if decode is True and isinstance(m, bytes):\n            return m.decode("utf-8")\n        if decode is False and isinstance(m, str):\n            return m.encode("utf-8")\n        return m\n\n    async def close(self, code=1000, reason=""):\n        await self._s.aclose(code, reason)\n\n    async def wait_closed(self):\n        return None\n\n    def __aiter__(self):\n        return self\n\n    async def __anext__(self):\n        try:\n            return await self.recv()\n        except _closed_exc():\n            raise StopAsyncIteration\n\n    async def __aenter__(self):\n        return self\n\n    async def __aexit__(self, *a):\n        await self.close()\n\n    @property\n    def open(self):\n        return self._s.closed is None\n\n    @property\n    def closed(self):\n        return self._s.closed is not None\n\n\nclass _AConnect(object):\n    def __init__(self, orig, uri, a, kw):\n        self._orig, self._uri, self._a, self._kw = orig, uri, a, kw\n        self._real = None\n\n    async def _open(self):\n        s = await aopen_mock(self._uri, self._kw.get("additional_headers") or self._kw.get("extra_headers"))\n        if s is not None:\n            return _AWSS(s)\n        self._real = self._orig(self._uri, *self._a, **self._kw)\n        return await self._real\n\n    def __await__(self):\n        return self._open().__await__()\n\n    async def __aenter__(self):\n        self._conn = await self._open()\n        if self._real is not None:\n            return self._conn\n        return self._conn\n\n    async def __aexit__(self, *exc):\n        if self._real is not None and hasattr(self._real, "__aexit__"):\n            return await self._real.__aexit__(*exc)\n        await self._conn.close()\n\n\ndef patch_websockets():\n    import websockets\n    if getattr(websockets, "_fa_ws_patched", False):\n        return\n    websockets._fa_ws_patched = True\n    try:\n        import websockets.sync.client as sc\n        orig_sc = sc.connect\n\n        def sync_connect(uri, *a, **kw):\n            s = open_mock(uri, kw.get("additional_headers"))\n            return _WSS(s) if s is not None else orig_sc(uri, *a, **kw)\n        sc.connect = sync_connect\n    except Exception:\n        pass\n    for modname in ("websockets.asyncio.client", "websockets.client", "websockets.legacy.client"):\n        try:\n            mod = __import__(modname, fromlist=["connect"])\n            orig = getattr(mod, "connect", None)\n            if orig is None or getattr(orig, "_fa_patched", False):\n                continue\n\n            def make(o):\n                def connect(uri, *a, **kw):\n                    return _AConnect(o, uri, a, kw)\n                connect._fa_patched = True\n                return connect\n            mod.connect = make(orig)\n        except Exception:\n            continue\n    try:\n        orig_top = websockets.connect\n        if not getattr(orig_top, "_fa_patched", False):\n            def top(uri, *a, **kw):\n                return _AConnect(orig_top, uri, a, kw)\n            top._fa_patched = True\n            websockets.connect = top\n    except Exception:\n        pass\n',"gui.py":'# -*- coding: utf-8 -*-\n"""\ngui -- windows for skill scripts (the Python side of the skill GUI bridge).\n\nA window is drawn in the terminal named in python_execute\'s "terminal" (the same window host that zenity and\n`gui wait` use in the shell). The window does not block the script: open it, add nodes, then wait for an event.\n\n    import gui\n    w = gui.Window("Name", width=320)\n    name = w.entry("")\n    ok = w.button("OK")\n    while True:\n        ev = w.wait(timeout=120)          # {"event": "click", "node": ...}, or None on timeout\n        if ev is None or ev["event"] == "close" or ev["node"] == ok:\n            break\n    print(w.value(name))\n    w.close()\n\nEvents: "click" (buttons), "close" (the user closed the window). These update value() and do not return from wait():\n"input" (entry, textarea or editor text), "cell" (a table cell), "toggle" (an expander), "select" (a multilist or\nlistbox selection), "change" (a checkbox).\nNode kinds: label, button, entry, textarea, checkbox, progress, listbox, row, column, expander, editor, table, multilist,\ncanvas, tabs (with tab pages), split, menubar (menu, menuitem). Dialogs: message(text), confirm(text) -> bool, ask(text, default) -> str or None, pick_file(title, accept) -> file dict or None.\nRows, columns and expanders take a parent=... argument to hold other nodes. set(node, text=..., enabled=...,\nvisible=..., value=...) changes a node that was already added.\nReady-made apps: before writing a window program from scratch, look for a template: `import guitpl; guitpl.catalog("what the\nuser asked for")` lists matching templates (id, title, params with the question to ask); `guitpl.run("office/main", params={...})`\nbuilds and runs one (customize by passing params, or write a new .jsonl/.py pair that "extends" it).\nLook and keys: theme(palette={...}, font=..., size=..., radius=...) colors and styles the window; shortcut("Ctrl+S", "save")\nmakes wait() and poll() return {"event": "shortcut", "value": "save"} when the key is pressed; tone(freq, ms, wave) beeps.\n"""\nimport base64\nimport os\n\nimport fa_bridge\n\n\nclass Window(object):\n    def __init__(self, title, width=360, resizable=False, maximizable=False, height=None):\n        # resizable: the user can drag the window\'s corner bigger or smaller; maximizable: a button fills the terminal\'s area.\n        # A canvas in a resizable window reports its new size with a "resize" event.\n        self.id = "w" + os.urandom(4).hex()\n        self._nodes = 0\n        self._values = {}\n        self._images = 0\n        self._tables = set()\n        self._carets = {}\n        self.closed = False\n        self._style = {}\n        args = {"id": self.id, "title": str(title), "width": int(width), "resizable": bool(resizable), "maximizable": bool(maximizable)}\n        if height:\n            args["height"] = int(height)  # the window\'s first height; a resizable window\'s body fills it (see grow)\n        fa_bridge.call("gui.open", args)\n\n    def _node(self, kind, parent, **fields):\n        self._nodes += 1\n        node = {"id": "n%d" % self._nodes, "kind": kind}\n        node.update(fields)\n        node.update(self._style)\n        fa_bridge.call("gui.add", {"id": self.id, "parent": parent or "root", "node": node})\n        return node["id"]\n\n    def label(self, text, parent=None):\n        return self._node("label", parent, text=str(text))\n\n    def button(self, text, parent=None, icon=""):\n        """A push button. icon is a short symbol or emoji shown before the text (toolbar look)."""\n        return self._node("button", parent, text=str(text), **({"icon": str(icon)} if icon else {}))\n\n    def entry(self, value="", parent=None):\n        nid = self._node("entry", parent, value=str(value))\n        self._values[nid] = str(value)\n        return nid\n\n    def row(self, parent=None):\n        return self._node("row", parent)\n\n    def column(self, parent=None):\n        return self._node("column", parent)\n\n    def grid(self, columns=2, parent=None):\n        """A container that lays its children out in `columns` equal columns, row by row (1-12)."""\n        return self._node("grid", parent, columns=int(columns))\n\n    def scroll(self, height=200, parent=None):\n        """A column at most `height` pixels high (40-1200); what does not fit scrolls."""\n        return self._node("scroll", parent, height=int(height))\n\n    def tabs(self, parent=None):\n        """A container of tab pages: add pages with tab(title, parent=<its id>), put the page\'s content in with parent=<page id>.\n        value() is the id of the page shown (the first one until the user clicks another); a click makes a "select" event."""\n        nid = self._node("tabs", parent)\n        self._values[nid] = None\n        return nid\n\n    def tab(self, title, parent):\n        """One page of a tabs container (parent is the tabs id). Returns the page\'s id: children of the page take parent=<this id>."""\n        nid = self._node("tab", parent, text=str(title))\n        if self._values.get(parent) is None:\n            self._values[parent] = nid\n        return nid\n\n    def split(self, direction="row", ratio=50, parent=None):\n        """Two or more children side by side (direction "row") or stacked ("column"); the first one gets `ratio` percent (10-90)."""\n        return self._node("split", parent, direction=str(direction), ratio=int(ratio))\n\n    def menubar(self, parent=None):\n        """A bar of menus: add menu(title, parent=<its id>), then menuitem(text, parent=<menu id>)."""\n        return self._node("menubar", parent)\n\n    def menu(self, title, parent):\n        return self._node("menu", parent, text=str(title))\n\n    def menuitem(self, text, parent, keys=""):\n        """An item of a menu; a click gives {"event": "click", "node": id}. keys is only the hint shown beside the text (for example\n        "Ctrl+S"): register the real key with shortcut()."""\n        fields = {"text": str(text)}\n        if keys:\n            fields["keys"] = str(keys)\n        return self._node("menuitem", parent, **fields)\n\n    def expander(self, text, expanded=False, parent=None):\n        """A collapsible container: children take parent=<its id>. value() is True while it is open."""\n        nid = self._node("expander", parent, text=str(text), expanded=bool(expanded))\n        self._values[nid] = bool(expanded)\n        return nid\n\n    def editor(self, value="", lang="", rows=8, parent=None, numbers=True, prose=False, wrap=False):\n        """A code and text editing surface: monospace, line numbers (numbers=False hides them), the current line highlighted, scrollbars,\n        and syntax colors for lang "python", "javascript", "json", "markdown", "html" or "css" (anything else is plain). value() is its text.\n        Give it grow=1 to fill its parent. prose=True uses a reading font and roomier lines (a document). caret(nid) is the user\'s caret or\n        selection; set(nid, value=..., caret=a, caret_to=b) writes new text, moves the caret (selects a..b), focuses the editor and scrolls to it."""\n        nid = self._node("editor", parent, value=str(value), lang=str(lang), rows=int(rows), numbers=bool(numbers), **({"prose": True} if prose else {}), **({"wrap": True} if wrap else {}))\n        self._values[nid] = str(value)\n        return nid\n\n    def markdown(self, value="", parent=None):\n        """A read-only view of Markdown text, drawn with real headings, bold, italic, lists, quotes, code and rules (the preview of a document).\n        Change it with set(nid, value=...). Give it grow=1 to fill its parent."""\n        return self._node("markdown", parent, value=str(value))\n\n    def table(self, columns, rows=(), parent=None):\n        """A grid of text cells: columns is a list of headings, rows a list of lists (one text per column).\n        value() is the current list of rows and changes as the user edits cells."""\n        cols = [str(c) for c in columns]\n        data = [[str(c) for c in r] for r in rows]\n        for i, r in enumerate(data):\n            if len(r) != len(cols):\n                raise ValueError("table row %d has %d cells, the table has %d columns" % (i, len(r), len(cols)))\n        nid = self._node("table", parent, columns=cols, rows=data)\n        self._values[nid] = [list(r) for r in data]\n        self._tables.add(nid)\n        return nid\n\n    def multilist(self, items, selected=(), parent=None):\n        """A list where several items can be selected. value() is the list of selected items."""\n        nid = self._node("multilist", parent, items=[str(i) for i in items], selected=[str(s) for s in selected])\n        self._values[nid] = [str(s) for s in selected]\n        return nid\n\n    def textarea(self, value="", rows=4, placeholder="", parent=None):\n        """A multi-line text box (not monospace, no language). value() is its text."""\n        nid = self._node("textarea", parent, value=str(value), rows=int(rows), placeholder=str(placeholder))\n        self._values[nid] = str(value)\n        return nid\n\n    def checkbox(self, text, checked=False, parent=None):\n        """A tick box with a label. value() is True while ticked; a "change" event is queued for poll()."""\n        nid = self._node("checkbox", parent, text=str(text), checked=bool(checked))\n        self._values[nid] = bool(checked)\n        return nid\n\n    def progress(self, value=0, max=100, parent=None):\n        """A progress bar. Change it with set(nid, value=...)."""\n        return self._node("progress", parent, value=float(value), max=float(max))\n\n    def listbox(self, items, selected="", parent=None):\n        """A list where one item is selected. value() is the selected item\'s text ("" when none)."""\n        nid = self._node("list", parent, items=[str(i) for i in items], selected=str(selected))\n        self._values[nid] = str(selected)\n        return nid\n\n    def set(self, nid, **props):\n        """Change properties of a node already added: set(btn, text="Save", enabled=False), set(box, visible=False),\n        set(pb, value=40), set(lbl, text="..."). value() follows value / checked / selected."""\n        fa_bridge.call("gui.set", {"id": self.id, "node": nid, "props": props})\n        if "caret" in props:\n            self._carets[nid] = (int(props["caret"]), int(props.get("caret_to", props["caret"])))\n        for key in ("value", "checked", "selected"):\n            if key in props and nid in self._values:\n                self._values[nid] = props[key]\n        if "rows" in props and nid in self._tables:\n            self._values[nid] = [[str(c) for c in r] for r in props["rows"]]\n\n    def theme(self, palette=None, font=None, size=None, radius=None, density=None):\n        """The window\'s look. palette: a dict with any of bg, fg, accent, danger, muted ("#rgb" or "#rrggbb"; the ones not given\n        keep their value). font: "sans-serif", "serif" or "monospace". size: text size 10-24. radius: corner radius 0-16.\n        Only what is given changes, so it can be called again later (for example to switch dark and light)."""\n        args = {"id": self.id}\n        if palette is not None:\n            args["palette"] = dict(palette)\n        if font is not None:\n            args["font"] = str(font)\n        if size is not None:\n            args["size"] = int(size)\n        if radius is not None:\n            args["radius"] = int(radius)\n        if density is not None:\n            args["density"] = str(density)  # "compact", "normal" or "comfy": the spacing scale\n        fa_bridge.call("gui.theme", args)\n\n    def shortcut(self, keys, name):\n        """Register a window shortcut. keys: "Ctrl+S", "Ctrl+Shift+Z", "Alt+Left", "F5", "Esc" (modifiers in the order Ctrl, Shift,\n        Alt; a letter or digit, F1-F12, Enter, Esc, Space, Up, Down, Left or Right). When the user presses it, wait() and\n        poll() return {"event": "shortcut", "value": name}. name None removes the shortcut. A key with no Ctrl or Alt is\n        ignored while the user types in a text box."""\n        fa_bridge.call("gui.shortcut", {"id": self.id, "keys": str(keys), "name": None if name is None else str(name)})\n\n    def tone(self, freq=440, ms=120, wave="sine"):\n        """Play a short beep in the page: freq 40-8000 Hz, ms 10-2000, wave "sine", "square", "triangle" or "sawtooth".\n        It returns at once and stays silent if the page cannot play sound (nothing is raised)."""\n        fa_bridge.call("gui.tone", {"id": self.id, "freq": float(freq), "ms": int(ms), "wave": str(wave)})\n\n    def canvas(self, width=320, height=240, fps=0, parent=None, fit=False):\n        """A drawing area for frames (pygame uses this). draw(nid, ops) paints one whole frame. fps > 0 queues "frame" events for poll().\n        fit=True keeps width x height as the drawing space and scales it (whole picture visible, centered) to fill the area the canvas is given\n        (with grow=1): draw once in fixed coordinates and it fills any window size. Without fit, a canvas in a resizable window is resized to\n        the window and reports "resize"."""\n        return self._node("canvas", parent, width=int(width), height=int(height), fps=int(fps), **({"fit": True} if fit else {}))\n\n    def draw(self, nid, ops):\n        """Paint one frame on a canvas. ops: lists such as ["rect", x, y, w, h, "#rrggbb"], ["circle", x, y, r, color],\n        ["line", x1, y1, x2, y2, color], ["text", x, y, text, color], ["clear", color], ["image", name, x, y, w, h]. At most 200 ops."""\n        fa_bridge.call("gui.draw", {"id": self.id, "node": nid, "ops": ops})\n\n    def image(self, nid, data, mime):\n        """Register a picture (PNG, JPEG, GIF or WebP bytes, at most 256 KB) on a canvas. Returns (name, w, h): draw it with\n        ["image", name, x, y] or ["image", name, x, y, w, h]. The page decodes it; a picture it cannot decode raises an error."""\n        self._images += 1\n        name = "i%d" % self._images\n        url = "data:%s;base64,%s" % (mime, base64.b64encode(data).decode("ascii"))\n        size = fa_bridge.call("gui.image", {"id": self.id, "node": nid, "name": name, "data": url})\n        return name, int(size["w"]), int(size["h"])\n\n    def poll(self):\n        """The next queued event now, or None. Never waits. Key events come as {"event": "key", "value": {"key", "down"}}."""\n        ev = fa_bridge.call("gui.poll", {"id": self.id})\n        if ev is None:\n            return None\n        if ev.get("event") == "caret":\n            self._store_caret(ev)\n        elif ev.get("event") in ("input", "cell", "toggle", "select", "change"):\n            self._event_value(ev)\n        if ev.get("event") == "close":\n            self.closed = True\n        return ev\n\n    def value(self, nid):\n        """The current value of a widget: entry text, editor text, table rows, expander open flag, multilist selection."""\n        return self._values.get(nid)\n\n    def _store_caret(self, ev):\n        v = ev.get("value") or {}\n        self._carets[ev.get("node")] = (int(v.get("start", 0)), int(v.get("end", 0)))\n\n    def caret(self, nid):\n        """The user\'s caret or selection in an editor as (start, end) character offsets into value(nid); both are the end of the text until the\n        user has clicked into it. Reported by the page as "caret" events (poll() returns them, wait() takes them in)."""\n        c = self._carets.get(nid)\n        if c is None:\n            n = len(self._values.get(nid) or "")\n            return (n, n)\n        n = len(self._values.get(nid) or "")\n        return (min(c[0], n), min(c[1], n))\n\n    def _event_value(self, ev):\n        """Store a value-changing event (input, cell, toggle, select) in value()."""\n        kind = ev.get("event")\n        node = ev.get("node")\n        if kind == "cell":\n            cell = ev.get("value") or {}\n            self._values[node][cell["row"]][cell["col"]] = cell.get("text")\n        else:\n            self._values[node] = ev.get("value")\n\n    def wait(self, timeout=300):\n        """Block until a button is clicked or the window is closed. Returns the event dict, or None on timeout."""\n        import time\n        end = time.time() + float(timeout)\n        while True:\n            left = end - time.time()\n            if left <= 0:\n                return None\n            ev = fa_bridge.call("gui.wait", {"id": self.id, "timeout": left}, timeout=left + 15)\n            if ev is None:\n                return None\n            kind = ev.get("event")\n            if kind == "caret":\n                self._store_caret(ev)\n                continue\n            if kind in ("input", "cell", "toggle", "select", "change"):\n                self._event_value(ev)\n                continue\n            if kind == "close":\n                self.closed = True\n            return ev\n\n    def close(self):\n        if not self.closed:\n            self.closed = True\n            fa_bridge.call("gui.close", {"id": self.id})\n\n\n# Every node method also takes these look and layout keywords: grow (0-10, the share of the free space in the parent: a row grows sideways,\n# a column downwards; the window body fills a resizable window), gap and pad (0-32 pixels, space between the children and inside), and role\n# (the design system\'s look: toolbar, sidebar, statusbar, card, panel, heading, title, muted, primary, danger, surface, group, divider, outline, page).\n# Example: w.editor(parent=col, grow=1); bar = w.row(role="toolbar").\n_STYLE_KEYS = ("grow", "gap", "pad", "role")\n\n\ndef _styled(fn):\n    def wrapper(self, *args, **kwargs):\n        style = {}\n        for k in _STYLE_KEYS:\n            if k in kwargs:\n                v = kwargs.pop(k)\n                if v is not None:\n                    style[k] = v if k == "role" else float(v)\n                    if k == "role":\n                        style[k] = str(v)\n        self._style = style\n        try:\n            return fn(self, *args, **kwargs)\n        finally:\n            self._style = {}\n    wrapper.__name__ = fn.__name__\n    wrapper.__doc__ = fn.__doc__\n    return wrapper\n\n\nfor _name in ("label", "button", "entry", "row", "column", "grid", "scroll", "tabs", "tab", "split", "menubar", "menu", "menuitem", "expander",\n              "editor", "table", "multilist", "textarea", "checkbox", "progress", "listbox", "canvas", "markdown"):\n    setattr(Window, _name, _styled(getattr(Window, _name)))\n\n\ndef pick_file(title="Choose a file", accept="", max_bytes=262144):\n    """Ask the user to choose a file. The page shows a small panel with a button (the browser or desktop file chooser opens when the user\n    presses it). Returns None when the user cancels, else {"name", "size", "mime", "data" (bytes), "path"} - path is the real path on the\n    desktop app and "" in the browser. accept is an html accept text such as "image/*" or ".txt,.md"; a file bigger than max_bytes\n    (default 256 KB, at most 8 MB) raises ValueError. To show a picture on a canvas use Window.image(canvas, data, mime) (at most 256 KB)."""\n    r = fa_bridge.call("gui.pickfile", {"title": str(title), "accept": str(accept), "max_bytes": int(max_bytes)}, timeout=330)\n    if not r:\n        return None\n    if r.get("error"):\n        raise ValueError(r["error"])\n    return {"name": r["name"], "size": int(r["size"]), "mime": r["mime"], "data": base64.b64decode(r["data"]), "path": r.get("path", "")}\n\n\ndef usertpl(action, id=None, jsonl=None, py=None):\n    """The user\'s own GUI templates kept by the page. "list" -> {id: {"jsonl", "py"}}; "save" stores one pair (id must be user/...);\n    "delete" removes one. Used by guitpl (catalog, run) and the design studio; there is no page behind a plain python run (it raises)."""\n    return fa_bridge.call("gui.usertpl", {"action": str(action), "id": id, "jsonl": jsonl, "py": py})\n\n\ndef _dialog(title, text, buttons, entry=None, width=340):\n    """A small modal window: shows text (and an entry when entry is a string), waits for one of the buttons. Returns (button index, entry text)\n    or (None, None) when the user closed the window."""\n    w = Window(title, width=width)\n    w.label(text)\n    box = w.entry(entry) if entry is not None else None\n    row = w.row()\n    ids = [w.button(b, parent=row) for b in buttons]\n    result = (None, None)\n    while True:\n        ev = w.wait(timeout=300)\n        if ev is None:\n            continue\n        if ev.get("event") == "close":\n            break\n        if ev.get("event") == "click" and ev.get("node") in ids:\n            result = (ids.index(ev["node"]), w.value(box) if box else None)\n            break\n    w.close()\n    return result\n\n\ndef message(text, title="Message", ok="OK"):\n    """Show a message in a small window and wait until the user presses the button (or closes it)."""\n    _dialog(title, text, [ok])\n\n\ndef confirm(text, title="Confirm", yes="Yes", no="No"):\n    """Ask a yes/no question in a small window. True for the first button; False for the second button or closing the window."""\n    return _dialog(title, text, [yes, no])[0] == 0\n\n\ndef ask(text, default="", title="Input", ok="OK", cancel="Cancel"):\n    """Ask for one line of text in a small window. Returns the text, or None when the user cancels or closes the window."""\n    index, value = _dialog(title, text, [ok, cancel], entry=str(default))\n    return value if index == 0 else None\n',"guitpl.py":'# -*- coding: utf-8 -*-\n"""\nguitpl -- GUI design templates: one `<name>.jsonl` (or `<name>.yaml`, a YAML subset, see guitpl_yaml.py) plus one `<name>.py` is a component (see DESIGN.gui-templates.md section 4).\n\n    import guitpl\n    guitpl.run("demo/hello", roots=["/templates"])           # load, resolve slots, check, build the window, run the events\n\nA JSONL file has one record per line; the first field `kind` says what it is:\n  meta     {"kind":"meta","id":"office/toolbar_basic","title":"..","keywords":[..],"entry":"build","extends":"other/id"}\n  param    {"kind":"param","name":"title","default":"..","ask":"question to ask the user"}   {{name}} in text is replaced\n  style    {"kind":"style","palette":{bg,fg,accent,danger,muted},"font":"..","size":14,"radius":4}\n  layout   {"kind":"layout","window":{"title":"..","width":400,"resizable":true},"tree":[nodes]}   a node {"slot":"toolbar"} is a hole\n  slot     {"kind":"slot","name":"toolbar","use":"office/toolbar_basic","params":{..}}          another component fills the hole\n  scene    {"kind":"scene","id":"main","title":"..","show":[names],"hide":[names],"on":{"click:next":"second"}}\n  shortcut {"kind":"shortcut","keys":"Ctrl+S","do":"save"}                                         handler key "shortcut:save"\n  call     {"kind":"call","on":"click:export","file":"user_ext.py","function":"on_export","args":{}}   a foreign call into any .py\n  require  {"kind":"require","module":"gui","source":"builtin|pyodide|micropip|file","version":"..","optional":false}\nThe `.py` of a component has `build(win, spec, slots)` (the name is meta.entry): it returns a dict, and a "handlers" entry\n{"click:save": fn(ctx)} wires events. Customizing a component = a new pair whose meta has "extends" and only the lines to\nchange (a line with the same key replaces the base\'s line). Every error is a GuiTplError with a Chinese message.\n"""\nimport ast\nimport importlib\nimport importlib.util\nimport json\nimport os\nimport sys\nimport time\n\nKINDS = ("meta", "param", "style", "layout", "slot", "scene", "shortcut", "call", "require")\nSOURCES = ("builtin", "pyodide", "micropip", "file")\n# the key of a record: a line with the same (kind, key) in an extending component replaces the base\'s line\nKEYS = {"param": "name", "slot": "name", "scene": "id", "shortcut": "keys", "require": "module", "call": "id"}\n# node kind -> (gui.Window method, positional props in order, keyword props)\nNODES = {\n    "column": ("column", [], []), "row": ("row", [], []),\n    "grid": ("grid", [], ["columns"]), "scroll": ("scroll", [], ["height"]),\n    "expander": ("expander", ["text"], ["expanded"]), "label": ("label", ["text"], []), "button": ("button", ["text"], ["icon"]),\n    "entry": ("entry", ["value"], []), "textarea": ("textarea", ["value"], ["rows", "placeholder"]),\n    "editor": ("editor", ["value"], ["lang", "rows", "numbers", "prose", "wrap"]),\n    "markdown": ("markdown", ["value"], []), "checkbox": ("checkbox", ["text"], ["checked"]),\n    "progress": ("progress", ["value"], ["max"]), "list": ("listbox", ["items"], ["selected"]),\n    "multilist": ("multilist", ["items"], ["selected"]), "table": ("table", ["columns", "rows"], []),\n    "canvas": ("canvas", [], ["width", "height", "fps", "fit"]),\n    "tabs": ("tabs", [], []), "tab": ("tab", ["title"], []), "split": ("split", [], ["direction", "ratio"]),\n    "menubar": ("menubar", [], []), "menu": ("menu", ["title"], []), "menuitem": ("menuitem", ["text"], ["keys"]),\n}\nDEFAULTS = {"text": "", "value": "", "items": [], "columns": [], "rows": [], "title": ""}\nAFTER = ("enabled", "visible")\n# look and layout hints any node may carry (see gui.py): grow fills free space, gap and pad are spacing, role is a design system look\nSTYLE_KEYS = ("grow", "gap", "pad", "role")\n# editor: also numbers (line numbers on or off)\nIGNORED_IMPORTS = ("__future__",)\n\n\nclass GuiTplError(Exception):\n    pass\n\n\ndef _stdlib(name):\n    names = getattr(sys, "stdlib_module_names", None)\n    if names is not None:\n        return name in names\n    return name in sys.builtin_module_names\n\n\ndef _subst(value, params):\n    """Replace {{name}} in every string of a JSON value."""\n    if isinstance(value, str):\n        for k, v in params.items():\n            value = value.replace("{{%s}}" % k, str(v))\n        return value\n    if isinstance(value, list):\n        return [_subst(v, params) for v in value]\n    if isinstance(value, dict):\n        return {k: _subst(v, params) for k, v in value.items()}\n    return value\n\n\ndef default_roots():\n    """The template library that ships with the app: the guitpl_lib folder next to this file (in the emulator, /fa_pybridge/guitpl_lib)."""\n    roots = [os.path.join(os.path.dirname(os.path.abspath(__file__)), "guitpl_lib")]\n    user = user_root()\n    if user:\n        roots.append(user)\n    return roots\n\n\n_USER_ROOT = [None, False]\n\n\ndef user_root():\n    """The user\'s own templates (saved from the design studio) as a folder: the page keeps them, and they are written out once per run of the\n    program. None when there are none or this program has no page behind it (tests, plain python)."""\n    if _USER_ROOT[1]:\n        return _USER_ROOT[0]\n    _USER_ROOT[1] = True\n    try:\n        import gui\n        found = gui.usertpl("list") or {}\n    except Exception:  # no page behind this program: only the shipped templates\n        return None\n    if not isinstance(found, dict) or not found:\n        return None\n    import tempfile\n    d = tempfile.mkdtemp()\n    for cid, files in found.items():\n        for ext, key in ((".jsonl", "jsonl"), (".yaml", "yaml"), (".py", "py")):\n            if files.get(key):\n                p = os.path.join(d, *cid.split("/")) + ext\n                os.makedirs(os.path.dirname(p), exist_ok=True)\n                with open(p, "w", encoding="utf-8") as f:\n                    f.write(files[key])\n    _USER_ROOT[0] = d\n    return d\n\n\nclass Library(object):\n    def __init__(self, roots=None):\n        if not roots:\n            roots = default_roots()\n        if isinstance(roots, str):\n            roots = [roots]\n        self.roots = [str(r) for r in roots]\n\n    def path(self, cid, ext):\n        for r in self.roots:\n            p = os.path.join(r, *cid.split("/")) + ext\n            if os.path.isfile(p):\n                return p\n        return None\n\n    def source_path(self, cid):\n        """The file that holds the records: <id>.jsonl, else <id>.yaml, else <id>.yml (the first root that has one wins)."""\n        for r in self.roots:\n            for ext in (".jsonl", ".yaml", ".yml"):\n                p = os.path.join(r, *cid.split("/")) + ext\n                if os.path.isfile(p):\n                    return p\n        return None\n\n    def read(self, cid):\n        """The checked records of a component\'s JSONL file (list of dicts)."""\n        p = self.source_path(cid)\n        if p is None:\n            raise GuiTplError("找不到範本 %s（找過：%s）" % (cid, "、".join(self.roots)))\n        records = []\n        if p.endswith(".jsonl"):\n            with open(p, encoding="utf-8") as f:\n                items = [(n, line.strip()) for n, line in enumerate(f, 1)]\n            for n, s in items:\n                if not s or s.startswith("#"):\n                    continue\n                try:\n                    rec = json.loads(s)\n                except ValueError as e:\n                    raise GuiTplError("%s 第 %d 行不是合法的 JSON：%s" % (cid, n, e))\n                records.append((n, rec))\n        else:  # .yaml / .yml: the same records, one YAML document each (see guitpl_yaml.py)\n            import guitpl_yaml\n            with open(p, encoding="utf-8") as f:\n                text = f.read()\n            try:\n                docs = guitpl_yaml.parse_documents(text)\n            except guitpl_yaml.YamlError as e:\n                raise GuiTplError("%s 的 YAML 寫法有問題：%s" % (cid, e))\n            records = [(i, rec) for i, rec in enumerate(docs, 1)]\n        checked = []\n        for n, rec in records:\n            if not isinstance(rec, dict) or rec.get("kind") not in KINDS:\n                raise GuiTplError("%s 第 %d 筆的 kind 必須是 %s 之一" % (cid, n, "、".join(KINDS)))\n            rec["_line"] = n\n            self._check(cid, n, rec)\n            checked.append(rec)\n        records = checked\n        if not any(r["kind"] == "meta" for r in records):\n            raise GuiTplError("%s 缺少 meta 紀錄" % cid)\n        return records\n\n    def _check(self, cid, n, rec):\n        k = rec["kind"]\n        def need(*fields):\n            for f in fields:\n                if f not in rec:\n                    raise GuiTplError("%s 第 %d 行（%s）缺少欄位 %s" % (cid, n, k, f))\n        if k == "meta":\n            need("id")\n        elif k == "param":\n            need("name", "default")\n        elif k == "slot":\n            need("name", "use")\n        elif k == "scene":\n            need("id", "title")\n        elif k == "shortcut":\n            need("keys", "do")\n        elif k == "call":\n            need("on", "file", "function")\n        elif k == "layout":\n            need("tree")\n            if not isinstance(rec["tree"], list):\n                raise GuiTplError("%s 第 %d 行 layout.tree 必須是陣列" % (cid, n))\n        elif k == "require":\n            need("module", "source")\n            if rec["source"] not in SOURCES:\n                raise GuiTplError("%s 第 %d 行 require.source 必須是 %s 之一" % (cid, n, "、".join(SOURCES)))\n\n    def load(self, cid, _stack=()):\n        """A component: its records with `extends` applied and every slot loaded (recursively, cycles refused)."""\n        if cid in _stack:\n            raise GuiTplError("循環引用：" + " → ".join(list(_stack) + [cid]))\n        stack = _stack + (cid,)\n        records = self.read(cid)\n        meta = [r for r in records if r["kind"] == "meta"][0]\n        if meta.get("extends"):\n            base = self.load_records(meta["extends"], stack)\n            records = self._override(base, records)\n            meta = dict(base["meta"], **{k: v for k, v in meta.items() if k != "_line"})\n        comp = {"id": cid, "meta": meta, "dir": os.path.dirname(self.source_path(cid)), "pyfile": self.path(cid, ".py"),\n                "params": {}, "style": {}, "layout": None, "slots": {}, "scenes": [], "shortcuts": [], "calls": [], "requires": [],\n                "records": records}\n        for r in records:\n            k = r["kind"]\n            if k == "param":\n                comp["params"][r["name"]] = r\n            elif k == "style":\n                comp["style"] = self._merge_style(comp["style"], r)\n            elif k == "layout":\n                comp["layout"] = r\n            elif k == "slot":\n                comp["slots"][r["name"]] = r\n            elif k == "scene":\n                comp["scenes"].append(r)\n            elif k == "shortcut":\n                comp["shortcuts"].append(r)\n            elif k == "call":\n                comp["calls"].append(r)\n            elif k == "require":\n                comp["requires"].append(r)\n        comp["children"] = {name: self.load(r["use"], stack) for name, r in comp["slots"].items()}\n        return comp\n\n    def load_records(self, cid, stack):\n        if cid in stack:\n            raise GuiTplError("循環引用（extends）：" + " → ".join(list(stack) + [cid]))\n        records = self.read(cid)\n        meta = [r for r in records if r["kind"] == "meta"][0]\n        if meta.get("extends"):\n            base = self.load_records(meta["extends"], stack + (cid,))\n            records = self._override(base, records)\n            meta = dict(base["meta"], **{k: v for k, v in meta.items() if k != "_line"})\n        return {"records": records, "meta": meta}\n\n    @staticmethod\n    def _merge_style(a, b):\n        out = dict(a)\n        for k, v in b.items():\n            if k in ("kind", "_line"):\n                continue\n            if k == "palette" and isinstance(v, dict):\n                out["palette"] = dict(out.get("palette", {}), **v)\n            else:\n                out[k] = v\n        return out\n\n    @staticmethod\n    def _override(base, own):\n        """base: {"records"}; own: records of the extending file. Same (kind, key) replaces; singular kinds (layout, style, meta) replace."""\n        def key(r):\n            k = r["kind"]\n            if k in KEYS:\n                v = r.get(KEYS[k])\n                return (k, v if v is not None else "#%d" % r["_line"])\n            return (k, None)\n        out = []\n        index = {}\n        for r in base["records"]:\n            if r["kind"] == "meta":\n                continue\n            index[key(r)] = len(out)\n            out.append(r)\n        for r in own:\n            if r["kind"] == "meta":\n                continue\n            kk = key(r)\n            if kk in index and r["kind"] != "style":\n                out[index[kk]] = r\n            elif kk in index:  # style: merge instead of replace\n                out[index[kk]] = dict(out[index[kk]], **{k: v for k, v in r.items() if k != "palette"})\n                if "palette" in r:\n                    out[index[kk]]["palette"] = dict(out[index[kk]].get("palette", {}), **r["palette"])\n            else:\n                index[kk] = len(out)\n                out.append(r)\n        meta = [r for r in own if r["kind"] == "meta"][0]\n        return [meta] + out\n\n\n# ---------- parameters, requirements, checks ----------\n\ndef bind_params(comp, given=None):\n    """The component\'s parameter values: defaults, overridden by `given` (unknown names are an error)."""\n    given = dict(given or {})\n    values = {}\n    for name, rec in comp["params"].items():\n        values[name] = given.pop(name, rec["default"])\n    if given:\n        raise GuiTplError("範本 %s 沒有這些參數：%s（有的參數：%s）" % (comp["id"], "、".join(sorted(given)), "、".join(comp["params"]) or "無"))\n    return values\n\n\ndef collect_requires(comp, seen=None):\n    """Every require of the component tree, one entry per module: {module: {"source","version","optional","by":[ids]}}."""\n    out = {} if seen is None else seen\n    for r in comp["requires"]:\n        m = r["module"]\n        cur = out.get(m)\n        if cur is None:\n            out[m] = {"source": r["source"], "version": r.get("version", ""), "optional": bool(r.get("optional", False)), "by": [comp["id"]]}\n        else:\n            cur["by"].append(comp["id"])\n            cur["optional"] = cur["optional"] and bool(r.get("optional", False))\n    for child in comp["children"].values():\n        collect_requires(child, out)\n    return out\n\n\ndef _imports_of(pyfile):\n    with open(pyfile, encoding="utf-8") as f:\n        tree = ast.parse(f.read(), pyfile)\n    mods = set()\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Import):\n            for a in node.names:\n                mods.add(a.name.split(".")[0])\n        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:\n            mods.add(node.module.split(".")[0])\n    return mods - set(IGNORED_IMPORTS)\n\n\ndef check(comp, available=None):\n    """Chinese error messages (empty when fine): a .py that imports what its JSONL does not declare, a declared module the\n    emulator does not have, a missing .py, a missing file-source module. `available(module, source)` may replace the default test."""\n    errors = []\n    def have(module, source):\n        if available is not None:\n            return available(module, source)\n        if module in sys.modules:\n            return True\n        try:\n            return importlib.util.find_spec(module) is not None\n        except (ImportError, ValueError):\n            return False\n    def walk(c):\n        if not c["pyfile"]:\n            errors.append("範本 %s 缺少同名的 .py 檔（一個 jsonl 要配一個 py）" % c["id"])\n        else:\n            try:\n                declared = set(r["module"] for r in c["requires"])\n                files = set(os.path.splitext(r["module"])[0] for r in c["requires"] if r["source"] == "file")\n                for m in sorted(_imports_of(c["pyfile"])):\n                    if m not in declared and m not in files:\n                        errors.append("範本 %s 的 %s 用了 %s，但 jsonl 沒有宣告（要加 require 紀錄）" % (c["id"], os.path.basename(c["pyfile"]), m))\n            except SyntaxError as e:\n                errors.append("範本 %s 的 .py 有語法錯誤：%s" % (c["id"], e))\n        for r in c["requires"]:\n            m, src = r["module"], r["source"]\n            if r.get("optional"):\n                continue\n            if src == "file":\n                f = os.path.join(c["dir"], m if m.endswith(".py") else m + ".py")\n                if not os.path.isfile(f):\n                    errors.append("範本 %s 需要自己的檔案 %s，但找不到" % (c["id"], os.path.basename(f)))\n            elif src == "builtin":\n                if not (_stdlib(m) or have(m, src)):\n                    errors.append("範本 %s 需要 %s（內建），但模擬器裡沒有" % (c["id"], m))\n            elif not have(m, src):\n                errors.append("範本 %s 需要套件 %s（來源 %s），目前模擬器裡沒有" % (c["id"], m, src))\n        for child in c["children"].values():\n            walk(child)\n    walk(comp)\n    return errors\n\n\n# ---------- run ----------\n\nclass Ctx(object):\n    def __init__(self, win, ids, state, scenes):\n        self.w = win\n        self.ids = ids\n        self.state = state\n        self.event = None\n        self.running = True\n        self._scenes = scenes\n        self.scene = None\n\n    def id(self, name):\n        return self.ids[name]\n\n    def get(self, name):\n        return self.w.value(self.ids[name])\n\n    def caret(self, name):\n        """The user\'s caret or selection in an editor: (start, end) character offsets into ctx.get(name)."""\n        return self.w.caret(self.ids[name])\n\n    def set(self, name, **props):\n        self.w.set(self.ids[name], **props)\n\n    def tone(self, freq=440, ms=120, wave="sine"):\n        self.w.tone(freq, ms, wave)\n\n    def pick_file(self, title="選擇檔案", accept="", max_bytes=262144):\n        """The user\'s file ({"name","size","mime","data","path"}) or None when cancelled (see gui.pick_file); too big raises ValueError."""\n        import gui\n        return gui.pick_file(title=title, accept=accept, max_bytes=max_bytes)\n\n    def message(self, text, title="訊息"):\n        """A small window with the text and one button; returns when the user answers (dialogs wait, so the program waits too)."""\n        import gui\n        gui.message(text, title=title, ok="確定")\n\n    def confirm(self, text, title="確認"):\n        """A yes/no window: True for 是, False for 否 or closing it."""\n        import gui\n        return gui.confirm(text, title=title, yes="是", no="否")\n\n    def ask(self, text, default="", title="輸入"):\n        """A one-line input window: the text, or None when cancelled."""\n        import gui\n        return gui.ask(text, default, title=title, ok="確定", cancel="取消")\n\n    def quit(self):\n        self.running = False\n\n    def goto(self, scene_id):\n        for s in self._scenes:\n            if s["id"] == scene_id:\n                self.scene = scene_id\n                for name in s.get("show", []):\n                    self.set(name, visible=True)\n                for name in s.get("hide", []):\n                    self.set(name, visible=False)\n                return\n        raise GuiTplError("沒有這個場景：%s" % scene_id)\n\n    def error(self, message):\n        sys.stderr.write("[guitpl] %s\\n" % message)\n\n\ndef _build_nodes(win, nodes, parent, ids, children, comp_params, slot_results, lib_children, builders):\n    for n in nodes:\n        if "slot" in n:\n            name = n["slot"]\n            holder = win.column(parent=parent, **{k: n[k] for k in STYLE_KEYS if k in n})\n            if name in lib_children:\n                builders.append((name, lib_children[name], holder))\n            continue\n        spec = NODES.get(n.get("kind"))\n        if spec is None:\n            raise GuiTplError("不認得的節點種類 %s" % n.get("kind"))\n        method, positional, keywords = spec\n        args = [n[p] if p in n else DEFAULTS.get(p, "") for p in positional]\n        kwargs = {k: n[k] for k in keywords + list(STYLE_KEYS) if k in n}\n        if parent:\n            kwargs["parent"] = parent\n        nid = getattr(win, method)(*args, **kwargs)\n        if n.get("kind") == "menuitem" and n.get("keys") and n.get("id"):\n            win.shortcut(n["keys"], "menu_" + n["id"])  # the hint beside the item is a real key that clicks it\n        if n.get("id"):\n            if n["id"] in ids:\n                raise GuiTplError("節點名稱重複：%s" % n["id"])\n            ids[n["id"]] = nid\n        extra = {k: n[k] for k in AFTER if k in n}\n        if extra:\n            win.set(nid, **extra)\n        if n.get("children"):\n            _build_nodes(win, n["children"], nid, ids, children, comp_params, slot_results, lib_children, builders)\n\n\ndef _entry(comp):\n    import_name = "guitpl_comp_" + comp["id"].replace("/", "_").replace("-", "_")\n    spec = importlib.util.spec_from_file_location(import_name, comp["pyfile"])\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    fn = getattr(mod, comp["meta"].get("entry", "build"), None)\n    if fn is None:\n        raise GuiTplError("範本 %s 的 %s 裡沒有進入函式 %s" % (comp["id"], os.path.basename(comp["pyfile"]), comp["meta"].get("entry", "build")))\n    return fn\n\n\ndef prepare(cid, params=None, roots=None, available=None):\n    """Load, bind parameters, and check. Returns the component (raises GuiTplError with every problem listed)."""\n    lib = Library(roots)\n    _ACTIVE[0] = lib.roots\n    comp = lib.load(cid)\n    errors = check(comp, available)\n    if errors:\n        raise GuiTplError("；".join(errors))\n    return comp\n\n\ndef catalog(roots=None, query=None):\n    """The ready-made templates: [{"id","title","keywords","standalone","params":[{"name","default","ask"}],"scenes":[ids]}] (standalone\n    ones are whole apps; the others are parts). With query, only those whose title, keywords or id share a word with it, best first."""\n    lib = Library(roots)\n    ids = []\n    for root in lib.roots:\n        for base, _dirs, files in os.walk(root):\n            for f in sorted(files):\n                if f.endswith((".jsonl", ".yaml", ".yml")):\n                    ids.append(os.path.relpath(os.path.join(base, f), root).rsplit(".", 1)[0].replace(os.sep, "/"))\n    out = []\n    for cid in sorted(set(ids)):\n        try:\n            comp = lib.load(cid)\n        except GuiTplError:\n            continue\n        out.append({"id": cid, "title": comp["meta"].get("title", cid), "keywords": comp["meta"].get("keywords", []),\n                    "standalone": bool(comp["meta"].get("standalone")),\n                    "params": [{"name": n, "default": r["default"], "ask": r.get("ask", "")} for n, r in comp["params"].items()],\n                    "scenes": [s["id"] for s in comp["scenes"]]})\n    if query:\n        q = str(query).lower()\n        scored = []\n        for e in out:\n            score = sum(1 for w in list(e["keywords"]) + [e["title"], e["id"].split("/")[0]] if str(w).lower() and str(w).lower() in q)\n            if score:\n                scored.append((-score, e["id"], e))\n        out = [e for _s, _i, e in sorted(scored)]\n    return out\n\n\ndef _calls_of(comp):\n    calls = {}\n    for c in comp["calls"]:\n        calls.setdefault(c["on"], []).append(c)\n    return calls\n\n\n_ACTIVE = [None]\n\n\ndef base_build(cid):\n    """The build function of another component (for a customized copy that only changes looks: its .py hands the work to the base)."""\n    lib = Library(_ACTIVE[0])\n    pyfile = lib.path(cid, ".py")\n    if pyfile is None:\n        raise GuiTplError("找不到範本 %s 的 .py（找過：%s）" % (cid, "、".join(lib.roots)))\n    comp = lib.load(cid)\n    return _entry(comp)\n\n\ndef storyboard_text(comp):\n    """The scenes as readable text: one block per scene, what it shows and hides, and where each event leads."""\n    lines = ["分鏡：%s（%s）" % (comp["meta"].get("title", comp["id"]), comp["id"])]\n    if not comp["scenes"]:\n        lines.append("（這個範本沒有場景，只有一個畫面）")\n    for i, s in enumerate(comp["scenes"], 1):\n        lines.append("%d. %s [%s]%s" % (i, s["title"], s["id"], "：" + s["note"] if s.get("note") else ""))\n        if s.get("show"):\n            lines.append("   顯示：" + "、".join(s["show"]))\n        if s.get("hide"):\n            lines.append("   隱藏：" + "、".join(s["hide"]))\n        for ev, target in (s.get("on") or {}).items():\n            lines.append("   %s → 換到 %s" % (ev, target))\n    return "\\n".join(lines)\n\n\ndef save_template(base_id, new_id, params=None, palette=None, font=None, size=None, radius=None, title=None, keywords=None, roots=None):\n    """Save a customized copy as the user\'s own template: a new jsonl+py pair under user/ that `extends` base_id and holds only the changed\n    lines (new defaults for params, a style line). The page keeps it (desktop: the user data area; web: persistent storage) and the next\n    catalog() lists it. Returns the new id."""\n    import gui\n    if not (isinstance(new_id, str) and new_id.startswith("user/") and len(new_id) > 5):\n        raise GuiTplError("我的範本的代號要寫成 user/名稱（小寫英數、底線、連字號）：%s" % (new_id,))\n    import re\n    if not re.match(r"^user(/[a-z0-9_][a-z0-9_\\-]*)+$", new_id):\n        raise GuiTplError("我的範本的代號只能用小寫英數、底線、連字號與斜線：%s" % new_id)\n    comp = Library(roots).load(base_id)\n    given = dict(params or {})\n    for name in given:\n        if name not in comp["params"]:\n            raise GuiTplError("範本 %s 沒有參數 %s" % (base_id, name))\n    meta = {"kind": "meta", "id": new_id, "title": title or ("我的" + comp["meta"].get("title", base_id)),\n            "keywords": list(keywords or []) + list(comp["meta"].get("keywords", [])), "extends": base_id, "standalone": True}\n    records = [meta]\n    records.append({"kind": "require", "module": "guitpl", "source": "builtin"})\n    for name, value in given.items():\n        records.append({"kind": "param", "name": name, "default": value, "ask": comp["params"][name].get("ask", "")})\n    st = {"kind": "style"}\n    if palette:\n        st["palette"] = dict(palette)\n    for k, v in (("font", font), ("size", size), ("radius", radius)):\n        if v is not None:\n            st[k] = v\n    if len(st) > 1:\n        records.append(st)\n    jsonl = "\\n".join(json.dumps(r, ensure_ascii=False) for r in records) + "\\n"\n    py = ("# -*- coding: utf-8 -*-\\n# 我的範本（由設計工作室存成）：只改外觀與預設值，行為交給 %s。\\nimport guitpl\\n\\n\\n"\n          "def build(win, spec, slots):\\n    return guitpl.base_build(%s)(win, spec, slots)\\n") % (base_id, json.dumps(base_id))\n    gui.usertpl("save", id=new_id, jsonl=jsonl, py=py)\n    _USER_ROOT[1] = False\n    return new_id\n\n\n_STANDALONE_HEAD = \'\'\'# -*- coding: utf-8 -*-\n# 單一檔案的程式（由 guitpl.compile_standalone 產生）：範本、引用、外部呼叫與執行器都在這個檔裡，只需要 gui（與標準函式庫）。\nimport gui  # noqa: F401 (the page runs programs that import gui as windows programs)\nimport json\nimport os\nimport sys\nimport tempfile\nimport types\n\n_FILES = json.loads(%s)\n_RUNTIME = json.loads(%s)\n_d = tempfile.mkdtemp()\nfor _name, _text in _FILES.items():\n    _p = os.path.join(_d, *_name.split("/"))\n    os.makedirs(os.path.dirname(_p), exist_ok=True)\n    with open(_p, "w", encoding="utf-8") as _f:\n        _f.write(_text)\nsys.path.insert(0, _d)\nguitpl = types.ModuleType("guitpl")\nguitpl.__file__ = os.path.join(_d, "guitpl.py")\nsys.modules["guitpl"] = guitpl\nexec(compile(_RUNTIME, "guitpl.py", "exec"), guitpl.__dict__)\n\nif __name__ == "__main__":\n    guitpl.run(%s, params=json.loads(%s), roots=[_d])\n\'\'\'\n\n\ndef compile_standalone(cid, params=None, roots=None):\n    """One self-contained python program for a template: the component tree (every slot, every extends base, every foreign-call file) and the\n    runtime are written into the text, so it needs only gui. Returns the program text; the same checks as run() are done first."""\n    lib = Library(roots)\n    comp = prepare(cid, params, roots)\n    values = bind_params(comp, params)\n    files = {}\n    todo = [cid]\n    seen = set()\n    while todo:\n        c = todo.pop()\n        if c in seen:\n            continue\n        seen.add(c)\n        recs = lib.read(c)\n        for p in (lib.source_path(c), lib.path(c, ".py")):\n            if p:\n                with open(p, encoding="utf-8") as f:\n                    files[c + os.path.splitext(p)[1]] = f.read()\n        base_dir = os.path.dirname(c)\n        for r in recs:\n            if r["kind"] == "meta" and r.get("extends"):\n                todo.append(r["extends"])\n            elif r["kind"] == "slot":\n                todo.append(r["use"])\n            elif r["kind"] == "call":\n                p = os.path.join(os.path.dirname(lib.source_path(c)), r["file"])\n                if os.path.isfile(p):\n                    with open(p, encoding="utf-8") as f:\n                        files[(base_dir + "/" if base_dir else "") + r["file"]] = f.read()\n    with open(os.path.abspath(__file__), encoding="utf-8") as f:\n        runtime = f.read()\n    if any(k.endswith((".yaml", ".yml")) for k in files):  # a YAML template needs its parser at run time\n        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "guitpl_yaml.py"), encoding="utf-8") as f:\n            files["guitpl_yaml.py"] = f.read()\n    q = lambda v: json.dumps(json.dumps(v, ensure_ascii=False), ensure_ascii=False)  # no escapes: an emoji would turn into two lone surrogates\n    return _STANDALONE_HEAD % (q(files), q(runtime), json.dumps(cid), q(values))\n\n\ndef storyboard(comp):\n    """The scenes of a component as plain data: [{"id","title","note","show","hide","on"}]."""\n    return [{"id": s["id"], "title": s["title"], "note": s.get("note", ""), "show": s.get("show", []), "hide": s.get("hide", []),\n             "on": s.get("on", {})} for s in comp["scenes"]]\n\n\ndef run(cid, params=None, roots=None, available=None, loop=True, window=None, style=None):\n    """Load a component, check it, build its window, wire shortcuts, scenes and handlers, and run the event loop.\n    Returns {"win","ids","state","component","scene"} when the window closes (or at once with loop=False)."""\n    comp = prepare(cid, params, roots, available)\n    import gui\n    values = bind_params(comp, params)\n    layout = comp["layout"]\n    if layout is None:\n        raise GuiTplError("範本 %s 沒有 layout 紀錄，不能執行" % cid)\n    layout = _subst(layout, values)\n    style = _subst(Library._merge_style(comp["style"], style or {}), values)\n    window_spec = layout.get("window", {})\n    win = window or gui.Window(window_spec.get("title", comp["meta"].get("title", cid)), width=window_spec.get("width", 360),\n                               resizable=bool(window_spec.get("resizable", False)), maximizable=bool(window_spec.get("maximizable", False)), height=window_spec.get("height"))\n    if style:\n        win.theme(palette=style.get("palette"), font=style.get("font"), size=style.get("size"), radius=style.get("radius"), density=style.get("density"))\n    ids = {}\n    builders = []\n    slot_names = {name: child for name, child in comp["children"].items()}\n    _build_nodes(win, layout["tree"], None, ids, None, values, None, slot_names, builders)\n    state = {}\n    handlers = {}\n    scenes = [dict(s) for s in comp["scenes"]]\n\n    # children: build their layout into the holders (recursively), then call every entry bottom-up\n    results = {}\n    def mount(c, c_values, parent_holder, c_builders):\n        child_results = {}\n        for (name, child, holder) in c_builders:\n            slot_rec = c["slots"][name]\n            child_values = bind_params(child, _subst(slot_rec.get("params", {}), c_values))\n            child_layout = _subst(child["layout"], child_values) if child["layout"] else {"tree": []}\n            sub = []\n            _build_nodes(win, child_layout["tree"], holder, ids, None, child_values, None, child["children"], sub)\n            child_results[name] = mount(child, child_values, holder, sub)\n        spec = {"id": c["id"], "params": c_values, "style": c["style"], "meta": c["meta"], "scenes": c["scenes"]}\n        for sc in c["shortcuts"]:\n            win.shortcut(sc["keys"], sc["do"])\n        out = {}\n        if c["pyfile"]:\n            out = _entry(c)(win, spec, child_results) or {}\n        for key, fn in (out.get("handlers") or {}).items():\n            handlers[key] = fn\n        return out\n    mount(comp, values, None, builders)\n    ctx = Ctx(win, ids, state, scenes)\n    if scenes:\n        ctx.goto(scenes[0]["id"])\n    if not loop:\n        return {"win": win, "ids": ids, "state": state, "component": comp, "scene": ctx.scene, "ctx": ctx, "handlers": handlers,\n                "calls": _calls_of(comp), "by_id": {v: k for k, v in ids.items()}}\n    by_id = {v: k for k, v in ids.items()}\n    calls = _calls_of(comp)\n    if "start" in handlers:  # 開窗後先呼叫一次「start」處理函式，讓畫布一開始就有畫面\n        try:\n            handlers["start"](ctx)\n        except Exception as e:\n            ctx.error("處理事件 start 出錯：%s: %s" % (type(e).__name__, e))\n    while ctx.running:\n        ev = win.poll()\n        if ev is None:\n            time.sleep(0.02)\n            continue\n        if ev.get("event") == "close":\n            break\n        key = _key_of(ev, by_id)\n        ctx.event = ev\n        try:\n            _dispatch(ctx, comp, key, handlers, calls)\n        except Exception as e:  # 一個事件處理出錯不能讓整個程式掛掉；視窗已經沒了就收工\n            if win.closed or "is not open" in str(e):\n                break\n            ctx.error("處理事件 %s 出錯：%s: %s" % (key, type(e).__name__, e))\n    try:\n        win.close()\n    except Exception:  # 視窗已經被使用者關掉\n        pass\n    return {"win": win, "ids": ids, "state": state, "component": comp, "scene": ctx.scene}\n\n\ndef _key_of(ev, by_id):\n    """The handler key of an event: "click:save" (node name), "shortcut:save"; a menu item\'s own shortcut counts as a click on it."""\n    if ev.get("event") == "shortcut":\n        v = str(ev.get("value"))\n        if v.startswith("menu_"):\n            return "click:" + v[5:]\n        return "shortcut:%s" % v\n    return "%s:%s" % (ev.get("event"), by_id.get(ev.get("node"), ev.get("node")))\n\n\ndef _dispatch(ctx, comp, key, handlers, calls):\n    for s in ctx._scenes:\n        if s["id"] == ctx.scene and key in s.get("on", {}):\n            ctx.goto(s["on"][key])\n    fn = handlers.get(key)\n    if fn is not None:\n        fn(ctx)\n    for c in calls.get(key, []):\n        path = os.path.join(comp["dir"], c["file"])\n        if not os.path.isfile(path):\n            ctx.error("外部呼叫找不到檔案 %s（範本 %s）" % (c["file"], comp["id"]))\n            continue\n        try:\n            spec = importlib.util.spec_from_file_location("guitpl_call_" + os.path.splitext(os.path.basename(path))[0], path)\n            mod = importlib.util.module_from_spec(spec)\n            spec.loader.exec_module(mod)\n            target = getattr(mod, c["function"], None)\n            if target is None:\n                ctx.error("外部呼叫的檔案 %s 裡沒有函式 %s" % (c["file"], c["function"]))\n                continue\n            target(ctx, **c.get("args", {}))\n        except Exception as e:  # 外部程式出錯不能讓整個程式掛掉\n            ctx.error("外部呼叫 %s:%s 出錯：%s: %s" % (c["file"], c["function"], type(e).__name__, e))\n\n\ndef studio(cid, params=None, roots=None, window=None):\n    """The design studio (a gui.Window): tweak a template\'s params, colors, font and size, preview it, see its storyboard, save it as\n    "my template" (user/<name>). See guitpl_studio.py."""\n    import guitpl_studio\n    return guitpl_studio.studio(cid, params, roots, window)\n',"guitpl_studio.py":'# -*- coding: utf-8 -*-\n"""\nguitpl_studio -- the GUI design studio, written with gui.Window itself.\n\n    import guitpl\n    guitpl.studio("office/main")        # a window to tweak the params, colors, font and size of a template, preview it live,\n                                        # read its storyboard, and save the result as "my template" (user/<name>)\n\nPreview opens (or reopens) the real window with the current settings; changing a field and pressing Preview again reruns it.\nSave writes a new jsonl+py pair that extends the template and keeps only the changed lines (see guitpl.save_template);\nthe next guitpl.catalog() and the AI\'s template search list it, and it is a reference case for the next design.\n"""\nimport re\nimport time\n\nimport gui\nimport guitpl\n\nPALETTE_KEYS = (("bg", "背景"), ("fg", "文字"), ("accent", "強調"), ("danger", "警示"), ("muted", "次要"))\nDEFAULT_PALETTE = {"bg": "#ffffff", "fg": "#222222", "accent": "#2563eb", "danger": "#dc2626", "muted": "#9ca3af"}\nCOLOR_RE = re.compile(r"^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$")\nFONTS = ("sans-serif", "serif", "monospace")\n\n\ndef _coerce(text, default):\n    """The text of an entry as the same type as the param\'s default (numbers and booleans stay numbers and booleans)."""\n    if isinstance(default, bool):\n        return str(text).strip().lower() in ("1", "true", "yes", "是", "開")\n    if isinstance(default, int):\n        return int(str(text).strip())\n    if isinstance(default, float):\n        return float(str(text).strip())\n    return str(text)\n\n\ndef studio(cid, params=None, roots=None, window=None):\n    comp = guitpl.prepare(cid, params, roots)\n    values = guitpl.bind_params(comp, params)\n    style = guitpl.Library._merge_style({"palette": dict(DEFAULT_PALETTE)}, comp["style"] or {})\n    palette = style.get("palette", {})\n    w = window or gui.Window("設計工作室：" + comp["meta"].get("title", cid), width=520, resizable=True)\n    w.label("範本：%s（%s）" % (comp["meta"].get("title", cid), cid))\n    page = w.scroll(height=420)\n    w.label("參數", parent=page)\n    param_ids = {}\n    for name, rec in comp["params"].items():\n        w.label(rec.get("ask") or name, parent=page)\n        param_ids[name] = w.entry(str(values[name]), parent=page)\n    w.label("配色（#rrggbb）", parent=page)\n    color_ids = {}\n    grid = w.grid(columns=2, parent=page)\n    for key, label in PALETTE_KEYS:\n        w.label(label, parent=grid)\n        color_ids[key] = w.entry(str(palette.get(key, DEFAULT_PALETTE[key])), parent=grid)\n    w.label("字型（sans-serif、serif、monospace）、文字大小（10-24）、圓角（0-16）", parent=page)\n    font_id = w.entry(str(style.get("font", "sans-serif")), parent=page)\n    size_id = w.entry(str(style.get("size", 14)), parent=page)\n    radius_id = w.entry(str(style.get("radius", 6)), parent=page)\n    w.label("我的範本名稱（user/名稱）", parent=page)\n    name_id = w.entry("user/my_" + cid.split("/")[-1].replace("-", "_"), parent=page)\n    bar = w.row()\n    preview_btn = w.button("預覽", parent=bar)\n    story_btn = w.button("分鏡", parent=bar)\n    save_btn = w.button("存成我的範本", parent=bar)\n    status = w.label("改完按「預覽」看效果；滿意再按「存成我的範本」。")\n    story = w.textarea("", rows=8, placeholder="分鏡會顯示在這裡")\n\n    def settings():\n        """The fields as (params, style, errors)."""\n        errors = []\n        given = {}\n        for name, rec in comp["params"].items():\n            try:\n                given[name] = _coerce(w.value(param_ids[name]), rec["default"])\n            except ValueError:\n                errors.append("參數 %s 的格式不對" % name)\n        pal = {}\n        for key, _label in PALETTE_KEYS:\n            c = str(w.value(color_ids[key])).strip()\n            if not COLOR_RE.match(c):\n                errors.append("配色 %s 要寫成 #rrggbb：%s" % (key, c))\n            pal[key] = c\n        font = str(w.value(font_id)).strip()\n        if font not in FONTS:\n            errors.append("字型要是 " + "、".join(FONTS))\n        try:\n            size = int(str(w.value(size_id)).strip())\n            radius = int(str(w.value(radius_id)).strip())\n            if not (10 <= size <= 24) or not (0 <= radius <= 16):\n                errors.append("文字大小要在 10-24、圓角要在 0-16")\n        except ValueError:\n            errors.append("文字大小與圓角要是整數")\n            size, radius = 14, 6\n        return given, {"palette": pal, "font": font, "size": size, "radius": radius}, errors\n\n    def say(text):\n        w.set(status, text=text)\n\n    pv = [None]\n\n    def close_preview():\n        if pv[0] is not None:\n            try:\n                pv[0]["win"].close()\n            except Exception:  # the user already closed it\n                pass\n            pv[0] = None\n\n    def preview():\n        given, st, errors = settings()\n        if errors:\n            say("；".join(errors))\n            return\n        close_preview()\n        try:\n            pv[0] = guitpl.run(cid, given, roots, loop=False, style=st)\n            say("預覽已開啟（再按一次「預覽」會用目前的設定重開）。")\n        except guitpl.GuiTplError as e:\n            say("預覽失敗：%s" % e)\n\n    def pump_preview():\n        """Dispatch the preview window\'s events with the template\'s own handlers (the same dispatch run() uses)."""\n        p = pv[0]\n        if p is None:\n            return False\n        ev = p["win"].poll()\n        if ev is None:\n            return False\n        if ev.get("event") == "close":\n            pv[0] = None\n            return True\n        key = guitpl._key_of(ev, p["by_id"])\n        p["ctx"].event = ev\n        try:\n            guitpl._dispatch(p["ctx"], p["component"], key, p["handlers"], p["calls"])\n        except Exception as e:  # one broken handler must not take the studio down\n            if p["win"].closed:\n                pv[0] = None\n            else:\n                p["ctx"].error("處理事件 %s 出錯：%s: %s" % (key, type(e).__name__, e))\n        return True\n\n    def save():\n        given, st, errors = settings()\n        if errors:\n            say("；".join(errors))\n            return\n        changed = {n: v for n, v in given.items() if v != comp["params"][n]["default"]}\n        base_pal = guitpl.Library._merge_style({"palette": dict(DEFAULT_PALETTE)}, comp["style"] or {})["palette"]\n        pal = {k: v for k, v in st["palette"].items() if v.lower() != str(base_pal.get(k, "")).lower()}\n        try:\n            new_id = guitpl.save_template(cid, str(w.value(name_id)).strip(), params=changed, palette=pal or None,\n                                          font=st["font"] if st["font"] != style.get("font", "sans-serif") else None,\n                                          size=st["size"] if st["size"] != style.get("size", 14) else None,\n                                          radius=st["radius"] if st["radius"] != style.get("radius", 6) else None, roots=roots)\n            say("已存成我的範本：%s（下次找範本時會出現，也會當參考案例）" % new_id)\n        except Exception as e:  # a name that is taken or malformed, or a full store\n            say("存不了：%s" % e)\n\n    while True:\n        ev = w.poll()\n        if ev is None:\n            if not pump_preview():\n                time.sleep(0.02)\n            continue\n        if ev.get("event") == "close":\n            break\n        if ev.get("event") == "click":\n            if ev["node"] == preview_btn:\n                preview()\n            elif ev["node"] == story_btn:\n                w.set(story, value=guitpl.storyboard_text(comp))\n            elif ev["node"] == save_btn:\n                save()\n    close_preview()\n    try:\n        w.close()\n    except Exception:  # already closed by the user\n        pass\n    return None\n',"guitpl_yaml.py":'# -*- coding: utf-8 -*-\n"""\nguitpl_yaml -- the YAML subset a template can be written in (the emulator is not guaranteed to have a YAML package).\n\nA YAML template is the same records as a .jsonl file, written as YAML documents separated by `---`; each document is one record:\n\n    kind: meta\n    id: demo/hello\n    title: 打招呼\n    standalone: true\n    ---\n    kind: layout\n    window: {title: "{{title}}", width: 320}\n    tree:\n      - kind: column\n        children:\n          - id: hi\n            kind: label\n            text: 哈囉\n\nSupported: block mappings and block sequences (spaces only, no tabs), `key: value`, `- item`, `- key: value` with more keys indented\nunder it, flow sequences `[a, b]` and flow mappings `{a: 1, b: [2, 3]}` (nested), double-quoted strings (JSON escapes), single-quoted\nstrings (\'\' for a quote), plain strings, integers, floats, true, false, null (also ~), comments (`#` at the start of a line or after a space,\noutside quotes). Not supported (clear error): anchors and aliases (&, *), tags (!), multi-line strings (| and >), `? ` complex keys,\nmerge keys (<<), tabs, a document that is not a mapping. The JavaScript twin is renderer/src/guitpl/yaml_core.js; both must give the same records.\n"""\nimport json\nimport re\n\nNUMBER_RE = re.compile(r"^[-+]?(\\d+)(\\.\\d+)?([eE][-+]?\\d+)?$")\n\n\nclass YamlError(ValueError):\n    pass\n\n\ndef _strip_comment(s):\n    q = None\n    i = 0\n    while i < len(s):\n        c = s[i]\n        if q:\n            if c == "\\\\" and q == \'"\':\n                i += 2\n                continue\n            if c == q:\n                if q == "\'" and s[i + 1:i + 2] == "\'":\n                    i += 2\n                    continue\n                q = None\n        elif c in "\\"\'" and (i == 0 or s[i - 1] in " \\t[{,:-"):\n            q = c\n        elif c == "#" and (i == 0 or s[i - 1] in " \\t"):\n            return s[:i]\n        i += 1\n    return s\n\n\ndef _split_key(s):\n    """(key, rest) when s is `key: rest` or `key:`; None when it is not a mapping line."""\n    if not s or s[0] in "[{\\"\'" and not _quoted_key(s):\n        return None\n    i = 0\n    if s[0] in "\\"\'":\n        q = s[0]\n        i = 1\n        while i < len(s):\n            if s[i] == "\\\\" and q == \'"\':\n                i += 2\n                continue\n            if s[i] == q:\n                if q == "\'" and s[i + 1:i + 2] == "\'":\n                    i += 2\n                    continue\n                break\n            i += 1\n        if i >= len(s) or s[i + 1:i + 2] != ":" or (len(s) > i + 2 and s[i + 2] != " "):\n            return None\n        return _scalar(s[:i + 1]), s[i + 2:].strip()\n    j = s.find(": ")\n    if j < 0:\n        if s.endswith(":"):\n            j = len(s) - 1\n        else:\n            return None\n    key = s[:j].strip()\n    if not key or key[0] in "&*!|>?%@`":\n        return None\n    return key, s[j + 1:].strip()\n\n\ndef _quoted_key(s):\n    return s[0] in "\\"\'"\n\n\ndef _scalar(s):\n    s = s.strip()\n    if s == "":\n        return None\n    if s[0] == \'"\':\n        try:\n            v, end = json.JSONDecoder().raw_decode(s)\n        except ValueError:\n            raise YamlError("雙引號字串沒有結尾或跳脫字元不對：%s" % s)\n        if s[end:].strip():\n            raise YamlError("字串後面還有多餘的字：%s" % s)\n        return v\n    if s[0] == "\'":\n        if not s.endswith("\'") or len(s) < 2:\n            raise YamlError("單引號字串沒有結尾：%s" % s)\n        return s[1:-1].replace("\'\'", "\'")\n    if s[0] in "&*!":\n        raise YamlError("不支援錨點、別名與標籤：%s" % s)\n    if s[0] in "|>":\n        raise YamlError("不支援多行字串（| 與 >）：請用雙引號字串加 \\\\n")\n    if s in ("true", "True"):\n        return True\n    if s in ("false", "False"):\n        return False\n    if s in ("null", "Null", "~"):\n        return None\n    if NUMBER_RE.match(s):\n        return float(s) if ("." in s or "e" in s or "E" in s) else int(s)\n    return s\n\n\nclass _Flow(object):\n    def __init__(self, s):\n        self.s = s\n        self.i = 0\n\n    def ws(self):\n        while self.i < len(self.s) and self.s[self.i] in " \\t":\n            self.i += 1\n\n    def value(self):\n        self.ws()\n        if self.i >= len(self.s):\n            raise YamlError("行內寫法沒有寫完：%s" % self.s)\n        c = self.s[self.i]\n        if c == "[":\n            self.i += 1\n            out = []\n            self.ws()\n            if self.s[self.i:self.i + 1] == "]":\n                self.i += 1\n                return out\n            while True:\n                out.append(self.value())\n                self.ws()\n                c2 = self.s[self.i:self.i + 1]\n                self.i += 1\n                if c2 == ",":\n                    self.ws()\n                    if self.s[self.i:self.i + 1] == "]":  # trailing comma\n                        self.i += 1\n                        return out\n                    continue\n                if c2 == "]":\n                    return out\n                raise YamlError("行內陣列要用逗號分隔、用 ] 結尾：%s" % self.s)\n        if c == "{":\n            self.i += 1\n            out = {}\n            self.ws()\n            if self.s[self.i:self.i + 1] == "}":\n                self.i += 1\n                return out\n            while True:\n                self.ws()\n                key = self.token(":")\n                self.ws()\n                if self.s[self.i:self.i + 1] != ":":\n                    raise YamlError("行內對照缺少冒號：%s" % self.s)\n                self.i += 1\n                out[key] = self.value()\n                self.ws()\n                c2 = self.s[self.i:self.i + 1]\n                self.i += 1\n                if c2 == ",":\n                    self.ws()\n                    if self.s[self.i:self.i + 1] == "}":\n                        self.i += 1\n                        return out\n                    continue\n                if c2 == "}":\n                    return out\n                raise YamlError("行內對照要用逗號分隔、用 } 結尾：%s" % self.s)\n        return self.token(",]}")\n\n    def token(self, stops):\n        self.ws()\n        c = self.s[self.i:self.i + 1]\n        if c in ("\\"", "\'"):\n            j = self.i + 1\n            while j < len(self.s):\n                if self.s[j] == "\\\\" and c == \'"\':\n                    j += 2\n                    continue\n                if self.s[j] == c:\n                    if c == "\'" and self.s[j + 1:j + 2] == "\'":\n                        j += 2\n                        continue\n                    break\n                j += 1\n            else:\n                raise YamlError("行內的引號字串沒有結尾：%s" % self.s)\n            lit = self.s[self.i:j + 1]\n            self.i = j + 1\n            return _scalar(lit)\n        j = self.i\n        while j < len(self.s) and self.s[j] not in stops:\n            j += 1\n        raw = self.s[self.i:j]\n        self.i = j\n        return _scalar(raw)\n\n\ndef _flow_or_scalar(s):\n    s = s.strip()\n    if s and s[0] in "[{":\n        f = _Flow(s)\n        v = f.value()\n        f.ws()\n        if f.i != len(s):\n            raise YamlError("行內寫法後面還有多餘的字：%s" % s)\n        return v\n    return _scalar(s)\n\n\ndef _lines(text):\n    out = []\n    for n, raw in enumerate(text.split("\\n"), 1):\n        raw = raw.rstrip("\\r")\n        if "\\t" in raw[:len(raw) - len(raw.lstrip())]:\n            raise YamlError("第 %d 行：縮排不能用 tab" % n)\n        body = _strip_comment(raw).rstrip()\n        if not body.strip():\n            continue\n        out.append((len(body) - len(body.lstrip(" ")), body.strip(), n))\n    return out\n\n\nclass _Parser(object):\n    def __init__(self, lines):\n        self.l = lines\n        self.i = 0\n\n    def block(self, indent):\n        ind, content, _n = self.l[self.i]\n        if content == "-" or content.startswith("- "):\n            return self.seq(indent)\n        return self.map(indent)\n\n    def map(self, indent):\n        out = {}\n        while self.i < len(self.l):\n            ind, content, n = self.l[self.i]\n            if ind < indent:\n                break\n            if ind > indent:\n                raise YamlError("第 %d 行：縮排對不上" % n)\n            if content == "-" or content.startswith("- "):\n                break\n            kv = _split_key(content)\n            if kv is None:\n                raise YamlError("第 %d 行：不是「鍵: 值」的寫法：%s" % (n, content))\n            key, rest = kv\n            if key == "<<":\n                raise YamlError("第 %d 行：不支援合併鍵 <<" % n)\n            if key in out:\n                raise YamlError("第 %d 行：鍵重複：%s" % (n, key))\n            self.i += 1\n            if rest:\n                out[key] = _flow_or_scalar(rest)\n            elif self.i < len(self.l) and (self.l[self.i][0] > indent or (self.l[self.i][0] == indent and (self.l[self.i][1] == "-" or self.l[self.i][1].startswith("- ")))):\n                out[key] = self.block(self.l[self.i][0])\n            else:\n                out[key] = None\n        return out\n\n    def seq(self, indent):\n        out = []\n        while self.i < len(self.l):\n            ind, content, n = self.l[self.i]\n            if ind < indent:\n                break\n            if ind > indent:\n                raise YamlError("第 %d 行：縮排對不上" % n)\n            if not (content == "-" or content.startswith("- ")):\n                break\n            rest = content[1:].lstrip(" ")\n            offset = len(content) - len(rest)\n            if not rest:\n                self.i += 1\n                if self.i < len(self.l) and self.l[self.i][0] > indent:\n                    out.append(self.block(self.l[self.i][0]))\n                else:\n                    out.append(None)\n            elif _split_key(rest) is not None and rest[0] not in "[{":\n                # "- key: value": the item is a mapping whose first line sits after the dash\n                self.l[self.i] = (indent + offset, rest, n)\n                out.append(self.map(indent + offset))\n            else:\n                self.i += 1\n                out.append(_flow_or_scalar(rest))\n        return out\n\n\ndef parse_documents(text):\n    """The records of a YAML template text: a list of dicts, one per document (separated by lines of ---)."""\n    docs = []\n    cur = []\n    for raw in str(text).replace("\\r\\n", "\\n").split("\\n"):\n        if raw.rstrip() == "---" or raw.startswith("--- "):\n            docs.append("\\n".join(cur))\n            cur = []\n        else:\n            cur.append(raw)\n    docs.append("\\n".join(cur))\n    records = []\n    first = 1\n    for d in docs:\n        lines = _lines(d)\n        if not lines:\n            continue\n        p = _Parser(lines)\n        v = p.block(lines[0][0])\n        if p.i < len(lines):\n            raise YamlError("第 %d 行：多出來的內容（縮排不對？）" % lines[p.i][2])\n        if not isinstance(v, dict):\n            raise YamlError("每份文件（以 --- 分開）要是一筆「鍵: 值」的紀錄")\n        records.append(v)\n    return records\n',"openai/__init__.py":'# -*- coding: utf-8 -*-\n"""\nopenai 的「轉接版」：Floating AI Assistant 在執行技能包的 Python 腳本時提供。\n\n腳本照原本的寫法（同步或 async 都可以）：\n    from openai import OpenAI, AsyncOpenAI\n    client = OpenAI(base_url=..., api_key=...)\n    client.chat.completions.create(model=..., messages=[...], tools=[...], stream=True)\n    client.responses.create(...); client.embeddings.create(...); client.images.generate(...); client.audio.transcriptions.create(...)\n\n但實際上不會連腳本設定的 base_url／金鑰，而是用 AI 助理「已設定的 LLM Model 清單」裡的 Model（腳本自己的 base_url、api_key、model 都忽略）：\n  * chat／responses／completions：用目前的 Model；有 tools 就挑支援工具呼叫的 Model，有圖片就挑支援讀圖的 Model（依序試）。\n  * embeddings、images、audio：不直接當不支援——從清單裡找有這個能力的 Model（依序試），所有 Model 都不支援才丟 openai.NotSupportedError。\n  * 串流（stream=True）：上游整段回來後分段送出（行為跟真的串流一樣，只是沒有逐字延遲）。\n  * moderations、files、batches、threads／runs、fine_tuning 等助理沒有對應的東西：用 fa_sim 的模擬回應（欄位正確、內容誠實、並通知助理「這是模擬的」）。\n"""\nimport json\nimport re\n\nimport fa_bridge\nimport fa_llm\nimport fa_sim\n\n__version__ = "1.99.0+fa-bridge"\n\n\n# ---------------------------------------------------------------- 錯誤（跟真的 openai 套件同名同繼承）\nclass OpenAIError(Exception):\n    pass\n\n\nclass APIError(OpenAIError):\n    def __init__(self, message="", request=None, body=None, **kw):\n        super(APIError, self).__init__(message)\n        self.message = message\n        self.request = request\n        self.body = body\n        self.code = (body or {}).get("code") if isinstance(body, dict) else None\n        self.param = None\n        self.type = None\n\n\nclass APIStatusError(APIError):\n    status_code = 500\n\n    def __init__(self, message="", response=None, body=None, status_code=None, **kw):\n        super(APIStatusError, self).__init__(message, body=body)\n        self.response = response\n        if status_code:\n            self.status_code = status_code\n        self.request_id = None\n\n\nclass APIConnectionError(APIError):\n    pass\n\n\nclass APITimeoutError(APIConnectionError):\n    pass\n\n\nclass BadRequestError(APIStatusError):\n    status_code = 400\n\n\nclass AuthenticationError(APIStatusError):\n    status_code = 401\n\n\nclass PermissionDeniedError(APIStatusError):\n    status_code = 403\n\n\nclass NotFoundError(APIStatusError):\n    status_code = 404\n\n\nclass ConflictError(APIStatusError):\n    status_code = 409\n\n\nclass UnprocessableEntityError(APIStatusError):\n    status_code = 422\n\n\nclass RateLimitError(APIStatusError):\n    status_code = 429\n\n\nclass InternalServerError(APIStatusError):\n    status_code = 500\n\n\nclass NotSupportedError(APIStatusError, NotImplementedError):\n    """助理已設定的所有 LLM Model 都沒有這個能力。"""\n    status_code = 501\n\n\n_STATUS_CLS = {400: BadRequestError, 401: AuthenticationError, 403: PermissionDeniedError, 404: NotFoundError, 409: ConflictError, 422: UnprocessableEntityError, 429: RateLimitError}\n\n\ndef _translate(e):\n    """把橋接的錯誤轉成 openai 套件的錯誤型別（腳本的 except 會照原本的寫法接得到）。"""\n    if isinstance(e, fa_bridge.NotSupported):\n        return NotSupportedError(str(e) or "沒有任何已設定的 LLM Model 支援這個功能")\n    msg = str(e)\n    m = re.search(r"API錯誤\\((\\d{3})\\)", msg)\n    if m:\n        code = int(m.group(1))\n        cls = _STATUS_CLS.get(code) or (InternalServerError if code >= 500 else APIStatusError)\n        return cls(msg, status_code=code)\n    if "逾時" in msg:\n        return APITimeoutError(msg)\n    return APIConnectionError(msg)\n\n\n# ---------------------------------------------------------------- 物件\nclass _Obj(object):\n    """dict 包成可以用屬性存取的物件（resp.choices[0].message.content），也可以用 resp["choices"]。"""\n\n    def __init__(self, d):\n        self.__dict__["_d"] = d\n\n    def __getattr__(self, k):\n        if k.startswith("__"):\n            raise AttributeError(k)\n        v = self.__dict__["_d"].get(k)\n        return _wrap(v)\n\n    def __getitem__(self, k):\n        return _wrap(self.__dict__["_d"][k])\n\n    def __contains__(self, k):\n        return k in self.__dict__["_d"]\n\n    def get(self, k, default=None):\n        return _wrap(self.__dict__["_d"].get(k, default))\n\n    def keys(self):\n        return self.__dict__["_d"].keys()\n\n    def to_dict(self, **kw):\n        return self.__dict__["_d"]\n\n    model_dump = to_dict\n\n    def to_json(self, **kw):\n        return json.dumps(self.__dict__["_d"], ensure_ascii=False)\n\n    model_dump_json = to_json\n\n    def __repr__(self):\n        return "<openai.%s %r>" % (self.__dict__["_d"].get("object", "obj"), self.__dict__["_d"])\n\n\ndef _wrap(v):\n    if isinstance(v, dict):\n        return _Obj(v)\n    if isinstance(v, list):\n        return [_wrap(x) for x in v]\n    return v\n\n\nclass Stream(object):\n    """串流回應（同步）：for chunk in stream:。"""\n\n    def __init__(self, gen):\n        self._gen = gen\n        self.response = None\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        return _wrap(next(self._gen))\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *a):\n        return False\n\n    def close(self):\n        pass\n\n\nclass AsyncStream(object):\n    def __init__(self, gen):\n        self._gen = gen\n\n    def __aiter__(self):\n        return self\n\n    async def __anext__(self):\n        try:\n            return _wrap(next(self._gen))\n        except StopIteration:\n            raise StopAsyncIteration\n\n    async def __aenter__(self):\n        return self\n\n    async def __aexit__(self, *a):\n        return False\n\n    async def close(self):\n        pass\n\n\nclass _Raw(object):\n    """with_raw_response 的結果：.parse() 取回物件，.headers／.http_response 給個樣子。"""\n\n    def __init__(self, obj):\n        self._obj = obj\n        self.headers = {"x-fa-bridge": "1"}\n        self.status_code = 200\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *a):\n        return False\n\n    def parse(self):\n        return self._obj\n\n    def __getattr__(self, k):\n        return getattr(self._obj, k)\n\n\n# ---------------------------------------------------------------- 執行：每個操作寫成 generator，yield 請求、收回結果，同步與 async 共用\ndef _drive(gen):\n    try:\n        req = next(gen)\n        while True:\n            try:\n                res = _do(req)\n            except Exception as e:\n                req = gen.throw(_translate(e))\n                continue\n            req = gen.send(res)\n    except StopIteration as stop:\n        return stop.value\n\n\nasync def _adrive(gen):\n    try:\n        req = next(gen)\n        while True:\n            try:\n                res = await _ado(req)\n            except Exception as e:\n                req = gen.throw(_translate(e))\n                continue\n            req = gen.send(res)\n    except StopIteration as stop:\n        return stop.value\n\n\ndef _do(req):\n    k = req[0]\n    if k == "complete":\n        return fa_llm.complete(req[1])\n    if k == "upstream":\n        return fa_llm.upstream(**req[1])\n    raise ValueError(k)\n\n\nasync def _ado(req):\n    k = req[0]\n    if k == "complete":\n        return await fa_llm.acomplete(req[1])\n    if k == "upstream":\n        return await fa_llm.aupstream(**req[1])\n    raise ValueError(k)\n\n\ndef _model(r, requested):\n    return (r or {}).get("model") or requested or "assistant"\n\n\n# ---------------------------------------------------------------- 各 API 的操作（generator）\ndef _op_chat(model=None, messages=None, stream=False, stream_options=None, **kw):\n    req = fa_llm.chat_request(model, messages, **kw)\n    r = yield ("complete", req)\n    r = dict(r or {})\n    r["model"] = _model(r, model)\n    if stream:\n        gen = fa_llm.chat_chunks(r, include_usage=bool((stream_options or {}).get("include_usage")))\n        return ("stream", gen)\n    r.setdefault("object", "chat.completion")\n    return ("obj", r)\n\n\ndef _op_completion(model=None, prompt=None, stream=False, **kw):\n    r = yield ("complete", fa_llm.completions_to_chat(prompt, model=model, **{k: v for k, v in kw.items() if k in ("temperature", "max_tokens", "top_p", "stop", "n", "seed")}))\n    d = fa_llm.chat_to_completion(r)\n    d["model"] = _model(r, model)\n    if stream:\n        def gen():\n            for c in d["choices"]:\n                text = c["text"]\n                for i in range(0, len(text), 24):\n                    yield {"id": d["id"], "object": "text_completion", "created": d["created"], "model": d["model"], "choices": [{"text": text[i:i + 24], "index": c["index"], "finish_reason": None}]}\n            yield {"id": d["id"], "object": "text_completion", "created": d["created"], "model": d["model"], "choices": [{"text": "", "index": 0, "finish_reason": "stop"}]}\n        return ("stream", gen())\n    return ("obj", d)\n\n\ndef _op_response(model=None, input=None, instructions=None, stream=False, **kw):\n    r = yield ("complete", fa_llm.responses_to_chat(model=model, input=input, instructions=instructions, **kw))\n    d = fa_llm.chat_to_response(r, model)\n    if stream:\n        return ("stream", fa_llm.response_events(d))\n    return ("obj", d)\n\n\ndef _op_embeddings(input=None, model=None, dimensions=None, encoding_format=None, **kw):\n    body = {"input": input, "model": model or "text-embedding-3-small"}\n    if dimensions:\n        body["dimensions"] = dimensions\n    if encoding_format:\n        body["encoding_format"] = encoding_format\n    r = yield ("upstream", {"cap": "embeddings", "path": "/embeddings", "json_body": body})\n    return ("obj", (r or {}).get("json") or {})\n\n\ndef _op_image(kind, **kw):\n    path = {"generate": "/images/generations", "edit": "/images/edits", "variation": "/images/variations"}[kind]\n    if kind == "generate":\n        body = {k: v for k, v in kw.items() if v is not None}\n        r = yield ("upstream", {"cap": "images", "path": path, "json_body": body})\n    else:\n        files, fields = [], {}\n        for k, v in kw.items():\n            if v is None:\n                continue\n            if k in ("image", "mask"):\n                for item in (v if isinstance(v, list) else [v]):\n                    files.append(fa_llm.file_part("image[]" if isinstance(v, list) else k, item, k + ".png", "image/png"))\n            else:\n                fields[k] = v\n        r = yield ("upstream", {"cap": "images", "path": path, "form": {"fields": fields, "files": files}})\n    return ("obj", (r or {}).get("json") or {})\n\n\ndef _op_audio(kind, **kw):\n    if kind == "speech":\n        body = {k: v for k, v in kw.items() if v is not None}\n        r = yield ("upstream", {"cap": "audio_speech", "path": "/audio/speech", "json_body": body, "want": "bytes"})\n        import base64\n        return ("bytes", base64.b64decode((r or {}).get("b64") or ""), (r or {}).get("content_type"))\n    path = "/audio/transcriptions" if kind == "transcriptions" else "/audio/translations"\n    files = [fa_llm.file_part("file", kw.pop("file"), "audio.wav", "audio/wav")]\n    fields = {k: v for k, v in kw.items() if v is not None}\n    fmt = fields.get("response_format")\n    r = yield ("upstream", {"cap": "audio_transcribe", "path": path, "form": {"fields": fields, "files": files}, "want": "bytes" if fmt in ("text", "srt", "vtt") else "json"})\n    if fmt in ("text", "srt", "vtt"):\n        import base64\n        return ("text", base64.b64decode((r or {}).get("b64") or "").decode("utf-8", "replace"))\n    return ("obj", (r or {}).get("json") or {})\n\n\ndef _finish(res):\n    k = res[0]\n    if k == "obj":\n        return _Obj(res[1])\n    if k == "stream":\n        return res[1]\n    if k == "bytes":\n        return fa_sim.SimBytes(res[1], res[2])\n    return res[1]\n\n\ndef _run(gen):\n    res = _drive(gen)\n    return Stream(res[1]) if res[0] == "stream" else _finish(res)\n\n\nasync def _arun(gen):\n    res = await _adrive(gen)\n    return AsyncStream(res[1]) if res[0] == "stream" else _finish(res)\n\n\n# ---------------------------------------------------------------- 資源（同步與 async 兩套，內容一致）\ndef _make_resources(A):\n    """A=True 產生 async 版。回傳 (client 屬性建立函式)。用 exec 風格太難讀，這裡用小工廠。"""\n    run = _arun if A else _run\n\n    def call(gen):\n        return run(gen)\n\n    class _Wrap(object):\n        def __init__(self, fn):\n            self._fn = fn\n\n        def __call__(self, *a, **kw):\n            return self._fn(*a, **kw)\n\n    def method(op):\n        if A:\n            async def m(self, *a, **kw):\n                return await run(op(*a, **kw))\n        else:\n            def m(self, *a, **kw):\n                return run(op(*a, **kw))\n        return m\n\n    def raw_method(op):\n        if A:\n            async def m(self, *a, **kw):\n                return _Raw(await run(op(*a, **kw)))\n        else:\n            def m(self, *a, **kw):\n                return _Raw(run(op(*a, **kw)))\n        return m\n\n    def simple(fn, wrap=True):\n        if A:\n            async def m(self, *a, **kw):\n                return _wrapx(fn(*a, **kw), wrap)\n        else:\n            def m(self, *a, **kw):\n                return _wrapx(fn(*a, **kw), wrap)\n        return m\n\n    def _wrapx(v, wrap):\n        return _Obj(v) if wrap and isinstance(v, dict) else v\n\n    class WithRaw(object):\n        def __init__(self, op):\n            self.create = raw_method(op).__get__(self)\n\n    class Completions(object):\n        create = method(_op_chat)\n\n        def __init__(self):\n            self.with_raw_response = WithRaw(_op_chat)\n            self.with_streaming_response = WithRaw(_op_chat)\n\n        def parse(self, *a, **kw):\n            fmt = kw.get("response_format")\n            kw2 = dict(kw)\n            if fmt is not None and not isinstance(fmt, dict):\n                kw2["response_format"] = {"type": "json_object"}\n            if A:\n                async def go():\n                    r = await self.create(*a, **kw2)\n                    return _parsed(r, fmt)\n                return go()\n            return _parsed(self.create(*a, **kw2), fmt)\n\n        def __getattr__(self, k):\n            raise NotSupportedError("chat.completions.%s 在 AI 助理的 openai 轉接版沒有支援" % k)\n\n    def _parsed(r, fmt):\n        try:\n            text = r.choices[0].message.content\n            data = json.loads(text)\n            if fmt is not None and hasattr(fmt, "model_validate"):\n                data = fmt.model_validate(data)\n            r.choices[0].message.__dict__["_d"]["parsed"] = data\n        except Exception:\n            pass\n        return r\n\n    class Chat(object):\n        def __init__(self):\n            self.completions = Completions()\n\n        def __getattr__(self, k):\n            raise NotSupportedError("chat.%s 在 AI 助理的 openai 轉接版沒有支援" % k)\n\n    class LegacyCompletions(object):\n        create = method(_op_completion)\n\n    class Responses(object):\n        create = method(_op_response)\n\n        def __init__(self):\n            self.with_raw_response = WithRaw(_op_response)\n\n        def __getattr__(self, k):\n            raise NotSupportedError("responses.%s 在 AI 助理的 openai 轉接版沒有支援（只有 create）" % k)\n\n    class Embeddings(object):\n        create = method(_op_embeddings)\n\n        def __init__(self):\n            self.with_raw_response = WithRaw(_op_embeddings)\n\n    class Images(object):\n        def generate(self, **kw):\n            return call(_op_image("generate", **kw)) if not A else _arun(_op_image("generate", **kw))\n\n        def edit(self, **kw):\n            return call(_op_image("edit", **kw)) if not A else _arun(_op_image("edit", **kw))\n\n        def create_variation(self, **kw):\n            return call(_op_image("variation", **kw)) if not A else _arun(_op_image("variation", **kw))\n\n    class _AudioSub(object):\n        def __init__(self, kind):\n            self.kind = kind\n            self.with_streaming_response = self\n\n        def create(self, **kw):\n            gen = _op_audio(self.kind, **kw)\n            return _arun(gen) if A else _run(gen)\n\n        def __enter__(self):\n            return self\n\n        def __exit__(self, *a):\n            return False\n\n    class Audio(object):\n        def __init__(self):\n            self.transcriptions = _AudioSub("transcriptions")\n            self.translations = _AudioSub("translations")\n            self.speech = _AudioSub("speech")\n\n    class Models(object):\n        list = simple(lambda: fa_sim.models(_current_model())[0])\n        retrieve = simple(lambda model: fa_sim.models(model)[1])\n\n    class Moderations(object):\n        create = simple(lambda **kw: fa_sim.moderation(**kw))\n\n    class Files(object):\n        create = simple(lambda **kw: fa_sim.file_create(**kw))\n        retrieve = simple(lambda fid: fa_sim.file_get(fid)[0])\n        list = simple(lambda **kw: fa_sim.file_list())\n        delete = simple(lambda fid: fa_sim.file_delete(fid))\n        content = simple(lambda fid: fa_sim.SimBytes(fa_sim.file_get(fid)[1]), wrap=False)\n        retrieve_content = content\n\n    class Batches(object):\n        create = simple(lambda **kw: fa_sim.batch_create(**kw))\n        retrieve = simple(lambda bid: fa_sim.batch_get(bid))\n\n    class _Jobs(object):\n        create = simple(lambda **kw: fa_sim.finetune_create(**kw))\n        retrieve = simple(lambda jid: fa_sim._STORE["jobs"][jid])\n\n    class FineTuning(object):\n        def __init__(self):\n            self.jobs = _Jobs()\n\n    class _Messages(object):\n        create = simple(lambda thread_id, **kw: fa_sim.message_create(thread_id, **kw))\n        list = simple(lambda thread_id, **kw: fa_sim.messages_list(thread_id, **kw))\n\n    class _Runs(object):\n        create = simple(lambda thread_id, **kw: fa_sim.run_create(thread_id, **kw))\n        create_and_poll = create\n        retrieve = simple(lambda thread_id, run_id: {"id": run_id, "object": "thread.run", "status": "completed"})\n\n    class _Threads(object):\n        create = simple(lambda **kw: fa_sim.thread_create(**kw))\n\n        def __init__(self):\n            self.messages = _Messages()\n            self.runs = _Runs()\n\n    class _Assistants(object):\n        create = simple(lambda **kw: fa_sim.assistant_create(**kw))\n\n    class _VectorStores(object):\n        create = simple(lambda **kw: fa_sim.vector_store_create(**kw))\n\n    class Beta(object):\n        def __init__(self):\n            self.chat = Chat()\n            self.threads = _Threads()\n            self.assistants = _Assistants()\n            self.vector_stores = _VectorStores()\n\n    return dict(Chat=Chat, Completions=LegacyCompletions, Responses=Responses, Embeddings=Embeddings, Images=Images, Audio=Audio, Models=Models,\n                Moderations=Moderations, Files=Files, Batches=Batches, FineTuning=FineTuning, Beta=Beta, VectorStores=_VectorStores)\n\n\n_CURRENT = {"model": None}\n\n\ndef _current_model():\n    if _CURRENT["model"] is None:\n        try:\n            _CURRENT["model"] = fa_bridge.call("llm.info", {}, timeout=10.0).get("model")\n        except Exception:\n            _CURRENT["model"] = "assistant"\n    return _CURRENT["model"]\n\n\ndef _client_class(A):\n    R = _make_resources(A)\n\n    class _Client(object):\n        def __init__(self, api_key=None, base_url=None, organization=None, project=None, timeout=None, max_retries=None, default_headers=None, http_client=None, **kw):\n            self.api_key = api_key\n            self.base_url = base_url\n            self.organization = organization\n            self.project = project\n            self.timeout = timeout\n            self.max_retries = max_retries\n            self.chat = R["Chat"]()\n            self.completions = R["Completions"]()\n            self.responses = R["Responses"]()\n            self.embeddings = R["Embeddings"]()\n            self.images = R["Images"]()\n            self.audio = R["Audio"]()\n            self.models = R["Models"]()\n            self.moderations = R["Moderations"]()\n            self.files = R["Files"]()\n            self.batches = R["Batches"]()\n            self.fine_tuning = R["FineTuning"]()\n            self.beta = R["Beta"]()\n            self.vector_stores = R["VectorStores"]()\n            self.with_raw_response = self\n            self.with_streaming_response = self\n\n        def with_options(self, **kw):\n            return self\n\n        copy = with_options\n\n        def close(self):\n            return None\n\n        def __enter__(self):\n            return self\n\n        def __exit__(self, *a):\n            return False\n\n        def __getattr__(self, k):\n            if k.startswith("__"):\n                raise AttributeError(k)\n            raise NotSupportedError("client.%s 在 AI 助理的 openai 轉接版沒有支援" % k)\n\n    return _Client\n\n\nclass OpenAI(_client_class(False)):\n    pass\n\n\nclass AsyncOpenAI(_client_class(True)):\n    async def close(self):\n        return None\n\n    async def __aenter__(self):\n        return self\n\n    async def __aexit__(self, *a):\n        return False\n\n\nAzureOpenAI = OpenAI\nAsyncAzureOpenAI = AsyncOpenAI\n\n# 舊版（0.x）的模組層級寫法：openai.ChatCompletion.create(...)、openai.Embedding.create(...)\n_default = OpenAI()\nchat = _default.chat\ncompletions = _default.completions\nresponses = _default.responses\nembeddings = _default.embeddings\nimages = _default.images\naudio = _default.audio\nmodels = _default.models\nmoderations = _default.moderations\nfiles = _default.files\napi_key = None\nbase_url = None\n\n\nclass ChatCompletion(object):\n    @staticmethod\n    def create(*a, **kw):\n        return _default.chat.completions.create(*a, **kw)\n\n\nclass Embedding(object):\n    @staticmethod\n    def create(*a, **kw):\n        return _default.embeddings.create(*a, **kw)\n\n\nclass Completion(object):\n    @staticmethod\n    def create(*a, **kw):\n        return _default.completions.create(*a, **kw)\n',"playwright/__init__.py":'# -*- coding: utf-8 -*-\n"""Floating AI Assistant 的 playwright 轉接版（見 sync_api.py）。"""\n',"playwright/sync_api.py":'# -*- coding: utf-8 -*-\n"""\nplaywright.sync_api 的「轉接版」：Floating AI Assistant 在執行技能包的 Python 腳本時提供。\n\n腳本照原本的寫法用 Playwright（connect_over_cdp／launch、new_page、goto、inner_text、locator、screenshot…），\n但這裡的每個動作實際上都是呼叫 AI 助理自己的瀏覽器控制工具（Chrome 擴充功能開的「AI Controlled」分頁），\n不需要 Chrome 遠端除錯埠、也不用安裝 Playwright。使用者的登入狀態就是他自己 Chrome 的登入狀態。\n\n支援的子集合：sync_playwright().start()/stop()/with、chromium|firefox|webkit .connect_over_cdp()/.launch()、\nbrowser.contexts/new_context/new_page/close、context.pages/new_page/close、\npage.goto/url/title/content/inner_text/text_content/evaluate/screenshot/wait_for_timeout/wait_for_load_state/\nwait_for_selector/locator/close、locator.first/count/inner_text/text_content/screenshot/click。\n其他功能會丟出說明清楚的 NotImplementedError——請改用 fa_bridge.tool(...) 或 fa_bridge.domain(...)。\n"""\nimport sys\nimport time\n\nimport fa_bridge\n\n_NOTED = [False]\n\n\ndef _note():\n    if not _NOTED[0]:\n        _NOTED[0] = True\n        sys.stderr.write("[fa-bridge] playwright is routed to the AI assistant browser tools (no Chrome debug port needed)\\n")\n\n\ndef _nyi(what):\n    raise NotImplementedError(\n        "%s 在 AI 助理的 playwright 轉接版沒有支援。可以改用 fa_bridge.tool(\'browser_…\', …) 呼叫助理的瀏覽器工具，"\n        "或 fa_bridge.domain(\'browser_control\', \'要做的事\') 委派給瀏覽器控制領域。" % what)\n\n\nclass Locator(object):\n    def __init__(self, page, selector, index=0):\n        self._page = page\n        self._sel = selector\n        self._idx = index\n\n    @property\n    def first(self):\n        return Locator(self._page, self._sel, 0)\n\n    @property\n    def last(self):\n        return Locator(self._page, self._sel, -1)\n\n    def nth(self, i):\n        return Locator(self._page, self._sel, i)\n\n    def locator(self, sub):\n        return Locator(self._page, self._sel + " " + sub, 0)\n\n    def count(self):\n        return int(fa_bridge.call("pw.count", {"tab": self._page._tab, "selector": self._sel}) or 0)\n\n    def inner_text(self, **kw):\n        return fa_bridge.call("pw.text", {"tab": self._page._tab, "selector": self._sel, "index": self._idx}) or ""\n\n    text_content = inner_text\n\n    def screenshot(self, path=None, **kw):\n        return self._page._shot(path, False, self._sel, self._idx)\n\n    def click(self, **kw):\n        fa_bridge.call("pw.click", {"tab": self._page._tab, "selector": self._sel, "index": self._idx})\n\n    def is_visible(self, **kw):\n        return self.count() > 0\n\n    def __getattr__(self, name):\n        _nyi("locator." + name)\n\n\nclass Page(object):\n    def __init__(self, tab=None):\n        self._tab = tab\n        self._url = ""\n        self.closed = False\n\n    @property\n    def url(self):\n        try:\n            self._url = fa_bridge.call("pw.url", {"tab": self._tab}) or self._url\n        except fa_bridge.BridgeError:\n            pass\n        return self._url\n\n    def goto(self, url, wait_until=None, timeout=None, **kw):\n        r = fa_bridge.call("pw.goto", {"tab": self._tab, "url": url})\n        if isinstance(r, dict) and r.get("tab"):\n            self._tab = r["tab"]\n        self._url = url\n        return None\n\n    def title(self):\n        return fa_bridge.call("pw.eval", {"tab": self._tab, "js": "document.title"}) or ""\n\n    def content(self):\n        return fa_bridge.call("pw.eval", {"tab": self._tab, "js": "document.documentElement.outerHTML"}) or ""\n\n    def inner_text(self, selector="body", **kw):\n        return fa_bridge.call("pw.text", {"tab": self._tab, "selector": selector}) or ""\n\n    text_content = inner_text\n\n    def evaluate(self, expression, arg=None):\n        js = expression\n        e = expression.lstrip()\n        is_fn = e.startswith(("function", "async function")) or ("=>" in e and e.startswith(("(", "async", "_", "x", "e", "el")) and not e.endswith(")"))\n        if arg is not None:\n            import json\n            js = "(" + expression + ")(" + json.dumps(arg) + ")"\n        elif is_fn:\n            js = "(" + expression + ")()"\n        return fa_bridge.call("pw.eval", {"tab": self._tab, "js": js})\n\n    def locator(self, selector, **kw):\n        return Locator(self, selector)\n\n    def query_selector(self, selector):\n        loc = Locator(self, selector)\n        return loc if loc.count() > 0 else None\n\n    def wait_for_timeout(self, ms):\n        fa_bridge.sleep(float(ms) / 1000.0)\n\n    def wait_for_load_state(self, *a, **kw):\n        fa_bridge.sleep(0.3)\n\n    def wait_for_selector(self, selector, timeout=30000, **kw):\n        t0 = time.time()\n        loc = Locator(self, selector)\n        while time.time() - t0 < timeout / 1000.0:\n            if loc.count() > 0:\n                return loc\n            fa_bridge.sleep(0.4)\n        raise TimeoutError("等不到元素：" + selector)\n\n    def set_viewport_size(self, *a, **kw):\n        pass\n\n    def bring_to_front(self):\n        pass\n\n    def screenshot(self, path=None, full_page=False, **kw):\n        return self._shot(path, full_page, None, 0)\n\n    def _shot(self, path, full_page, selector, index):\n        if path:\n            import os\n            path = os.path.abspath(path)\n            d = os.path.dirname(path)\n            if d and not os.path.isdir(d):\n                os.makedirs(d)\n        r = fa_bridge.call("pw.screenshot", {"tab": self._tab, "full_page": bool(full_page), "selector": selector, "index": index})\n        if not (isinstance(r, dict) and r.get("base64")):\n            raise RuntimeError("截圖失敗")\n        import base64\n        data = base64.b64decode(r["base64"])\n        if path:\n            with open(path, "wb") as f:\n                f.write(data)\n            return None\n        return data\n\n    def close(self, **kw):\n        if not self.closed:\n            self.closed = True\n            try:\n                fa_bridge.call("pw.close", {"tab": self._tab})\n            except fa_bridge.BridgeError:\n                pass\n\n    def __getattr__(self, name):\n        _nyi("page." + name)\n\n\nclass Context(object):\n    def __init__(self, browser):\n        self._browser = browser\n        self.pages = []\n\n    def new_page(self):\n        p = Page(None)\n        r = fa_bridge.call("pw.new_page", {})\n        p._tab = r.get("tab") if isinstance(r, dict) else None\n        self.pages.append(p)\n        return p\n\n    def close(self):\n        for p in list(self.pages):\n            p.close()\n\n    def __getattr__(self, name):\n        _nyi("context." + name)\n\n\nclass Browser(object):\n    def __init__(self):\n        self.contexts = [Context(self)]\n\n    def new_context(self, **kw):\n        c = Context(self)\n        self.contexts.append(c)\n        return c\n\n    def new_page(self, **kw):\n        return self.contexts[0].new_page()\n\n    def close(self):\n        for c in self.contexts:\n            c.close()\n\n    def is_connected(self):\n        return True\n\n    def __getattr__(self, name):\n        _nyi("browser." + name)\n\n\nclass BrowserType(object):\n    def connect_over_cdp(self, endpoint_url=None, **kw):\n        _note()\n        fa_bridge.call("pw.status", {})\n        return Browser()\n\n    connect = connect_over_cdp\n\n    def launch(self, **kw):\n        _note()\n        fa_bridge.call("pw.status", {})\n        return Browser()\n\n    def launch_persistent_context(self, user_data_dir=None, **kw):\n        return self.launch().contexts[0]\n\n\nclass Playwright(object):\n    def __init__(self):\n        self.chromium = BrowserType()\n        self.firefox = BrowserType()\n        self.webkit = BrowserType()\n\n    def stop(self):\n        pass\n\n\nclass _Manager(object):\n    def start(self):\n        return Playwright()\n\n    def __enter__(self):\n        return Playwright()\n\n    def __exit__(self, *a):\n        return False\n\n\ndef sync_playwright():\n    return _Manager()\n\n\n# 常見的型別名稱，讓 `from playwright.sync_api import Page, Browser, TimeoutError` 不會出錯\nTimeoutError = TimeoutError\nError = RuntimeError\n',"pygame.py":'# -*- coding: utf-8 -*-\n"""\npygame -- a small subset of pygame on top of a skill window (gui.py). The screen is a canvas: flip() sends the frame\'s drawing\ncommands in one message, and event.get() reads the keys and the close button from the window\'s queue.\n\n    import pygame\n    pygame.init()\n    screen = pygame.display.set_mode((320, 240))\n    x = 150\n    clock = pygame.time.Clock()\n    running = True\n    while running:\n        for ev in pygame.event.get():\n            if ev.type == pygame.QUIT:\n                running = False\n        if pygame.key.get_pressed()[pygame.K_LEFT]:\n            x -= 4\n        screen.fill((0, 0, 0))\n        pygame.draw.rect(screen, (0, 255, 0), pygame.Rect(x, 200, 60, 8))\n        pygame.display.flip()\n        clock.tick(30)\n    pygame.quit()\n\nSupported: display (set_mode, set_caption, flip, update, get_surface), draw (rect, circle, line), Rect, font (Font, SysFont,\nrender), image (load: PNG, JPEG, GIF, WebP), transform (scale), event (get; QUIT, KEYDOWN, KEYUP, MOUSEMOTION, MOUSEBUTTONDOWN,\nMOUSEBUTTONUP, MOUSEWHEEL, VIDEORESIZE; set_mode(size, RESIZABLE) makes the window resizable and maximizable), key (get_pressed), mouse (get_pos, get_pressed), time (Clock, get_ticks, wait), and the K_ key constants below.\nThe mouse positions are in the screen\'s pixels; button 1 is the left button, 2 the middle one, 3 the right one.\nLimits: the text size and font are the page\'s (the size argument is ignored); sound is a beep (mixer.Sound(...).play() and mixer.music.play() call the page\'s tone; no sample files); no offscreen Surface drawing (only the\nscreen, and a picture can be blitted onto it); line and circle widths other than 1 and 0 raise NotImplementedError; a frame has at\nmost 200 commands; a picture is at most 256 KB and at most 16 per window, and image.load needs set_mode first (the picture is\nregistered on the window\'s canvas). Pictures are drawn at their own size or the size transform.scale gives; their own alpha\nchannel shows, but there is no set_alpha / colorkey. The window\'s title is the one set_caption had before set_mode. Click the\nwindow once so it has the keyboard for key presses.\n"""\nimport time as _time\n\nimport gui\n\nerror = RuntimeError\n\nQUIT = 256\nKEYDOWN = 768\nKEYUP = 769\nMOUSEMOTION = 1024\nMOUSEBUTTONUP = 1025\nMOUSEBUTTONDOWN = 1026\nMOUSEWHEEL = 1027\nVIDEORESIZE = 32797\nRESIZABLE = 16                # set_mode flag: the window can be resized and maximized; a resize arrives as VIDEORESIZE (size=(w, h))\nK_RETURN = 13\nK_ESCAPE = 27\nK_SPACE = 32\nK_RIGHT = 1073741903\nK_LEFT = 1073741904\nK_DOWN = 1073741905\nK_UP = 1073741906\n_JS_KEYS = {"ArrowUp": K_UP, "ArrowDown": K_DOWN, "ArrowLeft": K_LEFT, "ArrowRight": K_RIGHT, " ": K_SPACE,\n            "Enter": K_RETURN, "Escape": K_ESCAPE}\n_NAMED = {"black": (0, 0, 0), "white": (255, 255, 255), "red": (255, 0, 0), "green": (0, 255, 0), "blue": (0, 0, 255),\n          "yellow": (255, 255, 0), "cyan": (0, 255, 255), "magenta": (255, 0, 255), "gray": (128, 128, 128),\n          "grey": (128, 128, 128)}\nMAX_OPS = 200\nMAX_PICTURE = 256 * 1024\n_PICTURE_TYPES = (("\\x89PNG", "image/png"), ("\\xff\\xd8\\xff", "image/jpeg"), ("GIF8", "image/gif"))\n\n# the window, its canvas and the screen Surface, plus the key state and the caption for the next set_mode\n_state = {"window": None, "canvas": None, "screen": None, "caption": "pygame", "keys": {}, "started": None,\n          "mouse": {"pos": (0, 0), "pressed": [False, False, False]}}\n\n\ndef _key_code(name):\n    """A page key name ("ArrowLeft", "a") as a pygame key code: letters and digits are their lowercase code point."""\n    if name in _JS_KEYS:\n        return _JS_KEYS[name]\n    if isinstance(name, str) and len(name) == 1:\n        return ord(name.lower())\n    return 0\n\n\ndef _hex(color):\n    """A pygame color (a name, an (r, g, b) tuple, or "#rrggbb") as the page\'s color text."""\n    if isinstance(color, str):\n        if color.startswith("#"):\n            return color\n        if color not in _NAMED:\n            raise ValueError("unknown color name " + repr(color))\n        color = _NAMED[color]\n    r, g, b = (max(0, min(255, int(c))) for c in tuple(color)[:3])\n    return "#%02x%02x%02x" % (r, g, b)\n\n\nclass Rect(object):\n    def __init__(self, x, y=None, w=None, h=None):\n        if y is None:\n            x, y, w, h = x\n        self.x, self.y, self.w, self.h = int(x), int(y), int(w), int(h)\n\n    @property\n    def width(self):\n        return self.w\n\n    @property\n    def height(self):\n        return self.h\n\n    @property\n    def left(self):\n        return self.x\n\n    @property\n    def top(self):\n        return self.y\n\n    @property\n    def right(self):\n        return self.x + self.w\n\n    @property\n    def bottom(self):\n        return self.y + self.h\n\n    def collidepoint(self, x, y=None):\n        if y is None:\n            x, y = x\n        return self.x <= x < self.right and self.y <= y < self.bottom\n\n    def colliderect(self, other):\n        return self.x < other.right and other.x < self.right and self.y < other.bottom and other.y < self.bottom\n\n    def move(self, dx, dy):\n        return Rect(self.x + dx, self.y + dy, self.w, self.h)\n\n    def copy(self):\n        return Rect(self.x, self.y, self.w, self.h)\n\n    def __iter__(self):\n        return iter((self.x, self.y, self.w, self.h))\n\n    def __eq__(self, other):\n        return tuple(self) == tuple(other)\n\n    def __repr__(self):\n        return "Rect(%d, %d, %d, %d)" % (self.x, self.y, self.w, self.h)\n\n\ndef _rect_args(rect):\n    return tuple(rect) if not isinstance(rect, Rect) else (rect.x, rect.y, rect.w, rect.h)\n\n\nclass _Text(object):\n    """What font.render returns: blit draws it as a text command on the screen."""\n\n    def __init__(self, text, color):\n        self.text = text\n        self.color = color\n\n\nclass _Picture(object):\n    """What image.load returns: a registered picture (name on the window\'s canvas) and its size. transform.scale gives a copy with\n    another size; blit draws it as an image command on the screen."""\n\n    def __init__(self, name, w, h):\n        self.name = name\n        self.w = w\n        self.h = h\n\n    def get_width(self):\n        return self.w\n\n    def get_height(self):\n        return self.h\n\n    def get_size(self):\n        return (self.w, self.h)\n\n    def get_rect(self):\n        return Rect(0, 0, self.w, self.h)\n\n\nclass Surface(object):\n    """The screen. Drawing calls add commands; display.flip() sends them as one frame."""\n\n    def __init__(self, size):\n        self.size = (int(size[0]), int(size[1]))\n        self.ops = []\n\n    def get_width(self):\n        return self.size[0]\n\n    def get_height(self):\n        return self.size[1]\n\n    def get_size(self):\n        return (self.size[0], self.size[1])\n\n    def get_rect(self):\n        return Rect(0, 0, self.size[0], self.size[1])\n\n    def fill(self, color, rect=None):\n        if rect is None:\n            self.ops.append(["clear", _hex(color)])\n        else:\n            x, y, w, h = _rect_args(rect)\n            self.ops.append(["rect", x, y, w, h, _hex(color)])\n\n    def blit(self, source, dest):\n        x, y = (dest.x, dest.y) if isinstance(dest, Rect) else (int(dest[0]), int(dest[1]))\n        if isinstance(source, _Picture):\n            self.ops.append(["image", source.name, x, y, source.w, source.h])\n        elif isinstance(source, _Text):\n            self.ops.append(["text", x, y, source.text, source.color])\n        else:\n            raise NotImplementedError("blit supports text from font.render and pictures from image.load")\n\n\nclass _Display(object):\n    def set_mode(self, size=(640, 480), flags=0, depth=0):\n        if _state["window"] is not None:\n            raise error("set_mode: the window is already open (one screen per program)")\n        w, h = int(size[0]), int(size[1])\n        # RESIZABLE lets the user resize and maximize the window; the program then gets VIDEORESIZE events with the new size\n        resizable = bool(int(flags) & RESIZABLE)\n        win = gui.Window(_state["caption"], width=max(160, w + 24), resizable=resizable, maximizable=resizable)\n        _state["canvas"] = win.canvas(width=w, height=h, fps=0)\n        _state["window"] = win\n        _state["screen"] = Surface((w, h))\n        return _state["screen"]\n\n    def set_caption(self, title, icontitle=None):\n        _state["caption"] = str(title)\n\n    def get_surface(self):\n        return _state["screen"]\n\n    def flip(self):\n        if _state["screen"] is None:\n            raise error("display.flip before display.set_mode")\n        ops = _state["screen"].ops\n        if len(ops) > MAX_OPS:\n            raise error("a frame has %d drawing commands, at most %d" % (len(ops), MAX_OPS))\n        _state["window"].draw(_state["canvas"], list(ops))\n        _state["screen"].ops = []\n\n    def update(self, rects=None):\n        self.flip()\n\n\nclass _Draw(object):\n    @staticmethod\n    def rect(surface, color, rect, width=0):\n        x, y, w, h = _rect_args(rect)\n        c = _hex(color)\n        if width == 0:\n            surface.ops.append(["rect", x, y, w, h, c])\n            return\n        t = int(width)\n        surface.ops.append(["rect", x, y, w, t, c])                # top\n        surface.ops.append(["rect", x, y + h - t, w, t, c])        # bottom\n        surface.ops.append(["rect", x, y, t, h, c])                # left\n        surface.ops.append(["rect", x + w - t, y, t, h, c])        # right\n\n    @staticmethod\n    def circle(surface, color, center, radius, width=0):\n        if width != 0:\n            raise NotImplementedError("draw.circle supports only a filled circle (width 0)")\n        surface.ops.append(["circle", int(center[0]), int(center[1]), int(radius), _hex(color)])\n\n    @staticmethod\n    def line(surface, color, start, end, width=1):\n        if width != 1:\n            raise NotImplementedError("draw.line supports only width 1")\n        surface.ops.append(["line", int(start[0]), int(start[1]), int(end[0]), int(end[1]), _hex(color)])\n\n\nclass _Font(object):\n    def __init__(self, name=None, size=14, bold=False, italic=False):\n        self.size = size\n\n    def render(self, text, antialias=True, color=(255, 255, 255), background=None):\n        if background is not None:\n            raise NotImplementedError("font.render supports no background color")\n        return _Text(str(text), _hex(color))\n\n\nclass _Event(object):\n    def __init__(self, type_, **fields):\n        self.type = type_\n        self.__dict__.update(fields)\n\n\nclass _Event_(object):\n    @staticmethod\n    def get():\n        win = _state["window"]\n        if win is None:\n            return []\n        out = []\n        while True:\n            ev = win.poll()           # never waits; the page answers from its queue\n            if ev is None:\n                break\n            kind = ev.get("event")\n            if kind == "close":\n                out.append(_Event(QUIT))\n            elif kind == "key":\n                v = ev.get("value") or {}\n                code = _key_code(v.get("key", ""))\n                _state["keys"][code] = bool(v.get("down"))\n                out.append(_Event(KEYDOWN if v.get("down") else KEYUP, key=code))\n            elif kind == "resize":\n                # the page resized the canvas (window resized or maximized): the screen takes the new size\n                v = ev.get("value") or {}\n                size = (int(v.get("width", 0)), int(v.get("height", 0)))\n                if _state["screen"] is not None:\n                    _state["screen"].size = size\n                out.append(_Event(VIDEORESIZE, size=size, w=size[0], h=size[1]))\n            elif kind == "wheel":\n                v = ev.get("value") or {}\n                pos = (int(v.get("x", 0)), int(v.get("y", 0)))\n                # pygame\'s y is positive when the wheel goes up, the browser\'s deltaY is positive when it goes down\n                out.append(_Event(MOUSEWHEEL, pos=pos, x=0, y=-1 if float(v.get("dy", 0)) > 0 else 1))\n            elif kind == "mouse":\n                v = ev.get("value") or {}\n                mouse = _state["mouse"]\n                pos = (int(v.get("x", 0)), int(v.get("y", 0)))\n                button = int(v.get("button", 0)) + 1          # pygame numbers the buttons from 1: left, middle, right\n                if v.get("kind") == "move":\n                    rel = (pos[0] - mouse["pos"][0], pos[1] - mouse["pos"][1])\n                    out.append(_Event(MOUSEMOTION, pos=pos, rel=rel, buttons=tuple(mouse["pressed"])))\n                else:\n                    down = v.get("kind") == "down"\n                    if 1 <= button <= 3:\n                        mouse["pressed"][button - 1] = down\n                    out.append(_Event(MOUSEBUTTONDOWN if down else MOUSEBUTTONUP, pos=pos, button=button))\n                mouse["pos"] = pos\n        return out\n\n\nclass _Pressed(object):\n    def __getitem__(self, code):\n        return bool(_state["keys"].get(code, False))\n\n\nclass _Key(object):\n    @staticmethod\n    def get_pressed():\n        return _Pressed()\n\n\nclass _Mouse(object):\n    @staticmethod\n    def get_pos():\n        return _state["mouse"]["pos"]\n\n    @staticmethod\n    def get_pressed(num_buttons=3):\n        return tuple(_state["mouse"]["pressed"])\n\n\nclass _Clock(object):\n    def __init__(self):\n        self._last = _time.time()\n        self._fps = 0.0\n\n    def tick(self, framerate=0):\n        now = _time.time()\n        if framerate and framerate > 0:\n            spent = now - self._last\n            if spent < 1.0 / framerate:\n                _time.sleep(1.0 / framerate - spent)\n        t = _time.time()\n        dt = t - self._last\n        self._last = t\n        self._fps = 1.0 / dt if dt > 0 else 0.0\n        return int(dt * 1000)\n\n    def get_fps(self):\n        return self._fps\n\n\nclass _Time(object):\n    Clock = _Clock\n\n    @staticmethod\n    def get_ticks():\n        started = _state["started"]\n        return int((_time.time() - started) * 1000) if started is not None else 0\n\n    @staticmethod\n    def wait(ms):\n        _time.sleep(max(0, int(ms)) / 1000.0)\n        return int(ms)\n\n    delay = wait\n\n\ndef _picture_type(data):\n    for magic, mime in _PICTURE_TYPES:\n        if data.startswith(magic.encode("latin-1")):\n            return mime\n    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":\n        return "image/webp"\n    raise error("image.load: the file is not a PNG, JPEG, GIF or WebP picture")\n\n\nclass _Image_(object):\n    @staticmethod\n    def load(path):\n        if _state["window"] is None:\n            raise error("image.load: call display.set_mode first (the picture is drawn on the screen\'s canvas)")\n        with open(path, "rb") as f:\n            data = f.read(MAX_PICTURE + 1)\n        if len(data) > MAX_PICTURE:\n            raise error("image.load: the picture is larger than %d KB" % (MAX_PICTURE // 1024))\n        name, w, h = _state["window"].image(_state["canvas"], data, _picture_type(data))\n        return _Picture(name, w, h)\n\n\nclass _Transform(object):\n    @staticmethod\n    def scale(surface, size):\n        if not isinstance(surface, _Picture):\n            raise NotImplementedError("transform.scale supports pictures from image.load only")\n        return _Picture(surface.name, max(1, int(size[0])), max(1, int(size[1])))\n\n\nclass _Font_(object):\n    Font = _Font\n\n    @staticmethod\n    def SysFont(name, size, bold=False, italic=False):\n        return _Font(name, size, bold, italic)\n\n    @staticmethod\n    def init():\n        return None\n\n\ndef init():\n    if _state["started"] is None:\n        _state["started"] = _time.time()\n    return (0, 0)\n\n\ndef quit():\n    if _state["window"] is not None:\n        _state["window"].close()\n    _state["window"] = None\n    _state["canvas"] = None\n    _state["screen"] = None\n\n\nclass _Sound(object):\n    """A sound is a short beep (the page plays tones, not sample files): the pitch comes from the file name or a given frequency, so the same\n    sound always has the same pitch. Sound("hit.wav").play() beeps; set_volume only keeps the number."""\n    def __init__(self, file=None, buffer=None, frequency=None, ms=150):\n        name = str(file if file is not None else (buffer if buffer is not None else "sound"))\n        self.frequency = float(frequency) if frequency is not None else 220.0 + (sum(ord(c) for c in name) * 31 % 660)\n        self.ms = int(ms)\n        self._volume = 1.0\n\n    def play(self, loops=0, maxtime=0, fade_ms=0):\n        win = _state["window"]\n        if win is not None and self._volume > 0:\n            ms = int(maxtime) if maxtime else self.ms\n            win.tone(self.frequency, max(10, min(2000, ms)))\n        return self\n\n    def stop(self):\n        return None\n\n    def set_volume(self, value):\n        self._volume = max(0.0, min(1.0, float(value)))\n\n    def get_volume(self):\n        return self._volume\n\n    def get_length(self):\n        return self.ms / 1000.0\n\n\nclass _Music(object):\n    def __init__(self):\n        self._sound = None\n        self._volume = 1.0\n\n    def load(self, file):\n        self._sound = _Sound(file)\n\n    def play(self, loops=0, start=0.0, fade_ms=0):\n        if self._sound is None:\n            raise error("music.play before music.load")\n        self._sound.set_volume(self._volume)\n        self._sound.play()\n\n    def stop(self):\n        return None\n\n    def set_volume(self, value):\n        self._volume = max(0.0, min(1.0, float(value)))\n\n    def get_busy(self):\n        return False\n\n\nclass _Mixer(object):\n    """pygame.mixer for the page: Sound(...).play() and music.play() turn into one short beep each (gui tone)."""\n    Sound = _Sound\n\n    def __init__(self):\n        self.music = _Music()\n        self._ready = False\n\n    def pre_init(self, *args, **kwargs):\n        return None\n\n    def init(self, *args, **kwargs):\n        self._ready = True\n\n    def quit(self):\n        self._ready = False\n\n    def get_init(self):\n        return (44100, -16, 2) if self._ready else None\n\n\nmixer = _Mixer()\n\ndisplay = _Display()\ndraw = _Draw()\nevent = _Event_()\nkey = _Key()\ntime = _Time()\nfont = _Font_()\nimage = _Image_()\nmouse = _Mouse()\ntransform = _Transform()\n',"guitpl_lib/beauty/main.jsonl":'{"kind":"meta","id":"beauty/main","title":"美顏拍貼（簡化版）","keywords":["美顏","拍貼","濾鏡","貼紙","自拍"],"entry":"build","standalone":true}\n{"kind":"param","name":"name","default":"美顏拍貼","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"strength","default":"50","ask":"美顏強度預設多少（0 到 100）？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fff7fb","fg":"#3b1d2a","accent":"#e11d74","danger":"#dc2626","muted":"#a8899a"},"font":"sans-serif","size":14,"radius":8}\n{"kind":"layout","window":{"title":"{{name}}","width":860,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"edit_panel","kind":"column","grow":1,"pad":16,"gap":12,"children":[{"kind":"row","grow":1,"gap":16,"children":[{"id":"view","kind":"canvas","width":300,"height":300,"fit":true,"grow":3},{"kind":"column","role":"card","children":[{"kind":"label","text":"濾鏡","role":"heading"},{"id":"filter_list","kind":"list","items":["原圖","柔焦","暖色","冷色","黑白"],"selected":"原圖"},{"kind":"label","text":"貼紙（可多選）","role":"heading"},{"id":"sticker_list","kind":"multilist","items":["星星","愛心","皇冠","貓"],"selected":[]}]}]},{"kind":"label","text":"美顏強度（0 到 100）","role":"muted"},{"kind":"row","children":[{"id":"strength_bar","kind":"progress","value":"{{strength}}","max":100,"grow":3},{"id":"strength_in","kind":"entry","value":"{{strength}}"}]},{"kind":"row","children":[{"id":"apply_btn","kind":"button","text":"套用","role":"primary"},{"id":"snap_btn","kind":"button","text":"拍照"}]}]},{"id":"result_panel","kind":"column","grow":1,"pad":16,"gap":12,"children":[{"id":"result_txt","kind":"label","text":"拍好了（簡化版：只示意，未存檔）","role":"title","grow":1},{"id":"again_btn","kind":"button","text":"再拍一張","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"beauty/toolbar","params":{"caption":"美顏工具"}}\n{"kind":"slot","name":"statusbar","use":"beauty/statusbar","params":{"hint":"選濾鏡與貼紙後按拍照"}}\n{"kind":"scene","id":"edit","title":"編輯中","note":"預覽、濾鏡、強度、貼紙","show":["edit_panel"],"hide":["result_panel"],"on":{"click:snap_btn":"result","shortcut:snap":"result"}}\n{"kind":"scene","id":"result","title":"已拍照","note":"只顯示完成訊息","show":["result_panel"],"hide":["edit_panel"],"on":{"click:again_btn":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+P","do":"snap"}\n{"kind":"shortcut","keys":"Ctrl+Right","do":"next_filter"}\n{"kind":"shortcut","keys":"Ctrl+R","do":"redraw"}\n',"guitpl_lib/beauty/main.py":'# -*- coding: utf-8 -*-\n# 美顏拍貼（簡化版）：用色塊與符號示意濾鏡、強度與貼紙，不做真的影像處理。\n# 畫布一幀最多 200 道繪圖指令，這裡每次約 15 道。\n\nFILTERS = {"原圖": ("#f2c7a5", "#555555"), "柔焦": ("#f7dcc9", "#e9d5e0"), "暖色": ("#f7b267", "#7a3e12"),\n           "冷色": ("#9bc4e2", "#1d3b57"), "黑白": ("#8a8a8a", "#222222")}\nFILTER_ORDER = ["原圖", "柔焦", "暖色", "冷色", "黑白"]\nSTICKERS = [("星星", "★", "#ffd700", (30, 40)), ("愛心", "♥", "#ff3b6b", (236, 40)),\n            ("皇冠", "♛", "#ffcc00", (140, 22)), ("貓", "貓", "#333333", (236, 250))]\n\n\ndef _strength(ctx):\n    return ctx.state.get("strength", 50)\n\n\ndef _redraw(ctx):\n    name = ctx.get("filter_list") or "原圖"\n    skin, bgc = FILTERS.get(name, FILTERS["原圖"])\n    ops = [\n        ["clear", bgc],\n        ["circle", 150, 150, 90, skin],\n        ["circle", 120, 130, 9, "#222222"],\n        ["circle", 180, 130, 9, "#222222"],\n        ["line", 125, 190, 175, 190, "#b03a48"],\n        ["text", 10, 290, "濾鏡 %s　美顏 %d" % (name, _strength(ctx)), "#ffffff"],\n    ]\n    chosen = ctx.get("sticker_list") or []\n    for label, sym, color, pos in STICKERS:\n        if label in chosen:\n            ops.append(["text", pos[0], pos[1], sym, color])\n    ctx.w.draw(ctx.id("view"), ops)\n\n\ndef build(win, spec, slots):\n    def set_strength(ctx):\n        text = ctx.get("strength_in")\n        try:\n            v = int(str(text).strip())\n        except ValueError:\n            v = -1\n        if not 0 <= v <= 100:\n            ctx.set("sb_text", text="美顏強度要是 0 到 100 的整數")\n            return\n        ctx.state["strength"] = v\n        ctx.set("strength_bar", value=v)\n        ctx.set("sb_text", text="美顏強度設為 %d" % v)\n        _redraw(ctx)\n\n    def next_filter(ctx):\n        cur = ctx.get("filter_list") or "原圖"\n        nxt = FILTER_ORDER[(FILTER_ORDER.index(cur) + 1) % len(FILTER_ORDER)] if cur in FILTER_ORDER else "原圖"\n        ctx.set("filter_list", selected=nxt)\n        _redraw(ctx)\n\n    def snap(ctx):\n        _redraw(ctx)\n        ctx.set("sb_text", text="已拍照（簡化版，未儲存）")\n\n    def reset(ctx):\n        ctx.set("filter_list", selected="原圖")\n        ctx.set("sticker_list", selected=[])\n        ctx.set("strength_in", value="50")\n        ctx.set("strength_bar", value=50)\n        ctx.state["strength"] = 50\n        ctx.set("sb_text", text="已重設")\n        _redraw(ctx)\n\n    return {"handlers": {\n        "input:strength_in": set_strength,\n        "select:filter_list": _redraw,\n        "select:sticker_list": _redraw,\n        "click:apply_btn": _redraw,\n        "shortcut:redraw": _redraw,\n        "shortcut:next_filter": next_filter,\n        "click:snap_btn": snap,\n        "shortcut:snap": snap,\n        "click:tb_reset": reset,\n        "start": _redraw,\n    }}\n',"guitpl_lib/beauty/main_dark.jsonl":'{"kind":"meta","id":"beauty/main_dark","title":"深色美顏拍貼（簡化版）","keywords":["深色美顏","夜間美顏"],"extends":"beauty/main"}\n{"kind":"param","name":"name","default":"夜間美顏拍貼","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#f3e8ee","accent":"#f472b6","muted":"#6b7280"},"font":"monospace"}\n',"guitpl_lib/beauty/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色變體：只覆寫 style 與視窗標題參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_beauty_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/beauty/main_light.jsonl":'{"kind":"meta","id":"beauty/main_light","title":"淺色美顏拍貼（簡化版）","keywords":["淺色美顏","明亮美顏"],"extends":"beauty/main"}\n{"kind":"param","name":"strength","default":"70","ask":"美顏強度預設多少（0 到 100）？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","accent":"#8b5cf6"},"radius":12}\n',"guitpl_lib/beauty/main_light.py":'# -*- coding: utf-8 -*-\n# 淺色變體：只覆寫 style 與預設強度參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_beauty_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/beauty/statusbar.jsonl":'{"kind":"meta","id":"beauty/statusbar","title":"美顏狀態列","keywords":["美顏狀態列","狀態列"],"entry":"build"}\n{"kind":"param","name":"hint","default":"選濾鏡與貼紙後按拍照","ask":"狀態列一開始要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"sb_text","kind":"label","text":"{{hint}}"}]}]}\n',"guitpl_lib/beauty/statusbar.py":"# -*- coding: utf-8 -*-\n# 狀態列沒有自己的行為：主畫面用 sb_text 這個名稱更新文字。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/beauty/toolbar.jsonl":'{"kind":"meta","id":"beauty/toolbar","title":"美顏工具列","keywords":["美顏工具列","工具列"],"entry":"build"}\n{"kind":"param","name":"caption","default":"美顏工具","ask":"工具列左邊要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"kind":"label","text":"{{caption}}"},{"id":"tb_reset","kind":"button","text":"全部重設","icon":"↺"}]}]}\n',"guitpl_lib/beauty/toolbar.py":"# -*- coding: utf-8 -*-\n# 工具列的「全部重設」由主畫面處理，因為要重設濾鏡、強度與貼紙並重畫預覽。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/common/toolbar_basic.jsonl":'{"kind":"meta","id":"common/toolbar_basic","title":"基本工具列（存檔、清除）","keywords":["工具列","存檔","清除"],"entry":"build"}\n{"kind":"param","name":"save_text","default":"存檔","ask":"存檔按鈕要寫什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"save","kind":"button","text":"{{save_text}}","icon":"⬇","role":"primary"},{"id":"clear","kind":"button","text":"清除","icon":"✖"}]}]}\n',"guitpl_lib/common/toolbar_basic.py":'# -*- coding: utf-8 -*-\n# 基本工具列的行為：存檔次數記在 ctx.state，狀態列用名稱 "status"（由使用這個工具列的範本提供）。\n\n\ndef build(win, spec, slots):\n    def save(ctx):\n        ctx.state["saved"] = ctx.state.get("saved", 0) + 1\n        ctx.set("status", text="已存 %d 次" % ctx.state["saved"])\n\n    def clear(ctx):\n        ctx.set("editor", value="")\n        ctx.set("status", text="已清除")\n\n    return {"handlers": {"click:save": save, "click:clear": clear}}\n',"guitpl_lib/demo/ext_export.py":'# -*- coding: utf-8 -*-\n# 外部呼叫範例：不是範本元件，只是被 jsonl 的 call 紀錄參考的函式。\n\n\ndef on_export(ctx, fmt="txt"):\n    ctx.set("status", text="已匯出為 %s（%d 字）" % (fmt, len(ctx.get("editor"))))\n',"guitpl_lib/demo/notes.jsonl":'{"kind":"meta","id":"demo/notes","title":"簡單筆記","keywords":["筆記","記事本"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"我的筆記","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"require","module":"time","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":560,"resizable":true,"height":460},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"column","grow":1,"pad":12,"gap":8,"children":[{"id":"editor","kind":"editor","value":"","lang":"text","rows":10,"grow":1},{"kind":"row","children":[{"id":"status","kind":"label","text":"就緒","role":"muted","grow":1},{"id":"help_btn","kind":"button","text":"說明","role":"outline"},{"id":"export","kind":"button","text":"匯出"}]},{"id":"help","kind":"label","text":"在上面寫字，按存檔。","role":"muted"},{"id":"back_btn","kind":"button","text":"回到編輯","role":"primary"}]}]}]}\n{"kind":"slot","name":"toolbar","use":"common/toolbar_basic","params":{"save_text":"儲存「{{title}}」"}}\n{"kind":"scene","id":"edit","title":"編輯中","note":"工具列、編輯區、狀態列","hide":["help","back_btn"],"show":["help_btn","editor"],"on":{"click:help_btn":"help"}}\n{"kind":"scene","id":"help","title":"說明","note":"只顯示說明文字","show":["help","back_btn"],"hide":["help_btn","editor"],"on":{"click:back_btn":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+S","do":"save"}\n{"kind":"call","on":"click:export","file":"ext_export.py","function":"on_export","args":{"fmt":"txt"}}\n',"guitpl_lib/demo/notes.py":'# -*- coding: utf-8 -*-\nimport time\n\n\ndef build(win, spec, slots):\n    # Ctrl+S 與工具列的存檔是同一個動作：直接用子元件的處理函式\n    save = slots["toolbar"]["handlers"]["click:save"]\n\n    def stamp(ctx):\n        ctx.state["opened"] = time.time()\n\n    return {"handlers": {"shortcut:save": save}, "stamp": stamp}\n',"guitpl_lib/demo/notes_dark.jsonl":'{"kind":"meta","id":"demo/notes_dark","title":"深色筆記","keywords":["深色筆記"],"extends":"demo/notes"}\n{"kind":"param","name":"title","default":"夜間筆記","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff"},"font":"monospace"}\n',"guitpl_lib/demo/notes_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 demo/notes 時，這個檔案取代原本的進入函式；沒有額外行為就委派給原本的。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_demo_notes_base", os.path.join(_here, "notes.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/demo/todo_yaml.py":'# -*- coding: utf-8 -*-\n# YAML 待辦示範的行為：新增一項（按鈕或 Ctrl+Enter），清單與狀態列跟著更新。\n\n\ndef build(win, spec, slots):\n    def add(ctx):\n        text = str(ctx.get("item") or "").strip()\n        if not text:\n            ctx.set("status", text="先輸入要做的事")\n            return\n        items = ctx.state.setdefault("items", [])\n        items.append(text)\n        ctx.set("items", items=list(items))\n        ctx.set("item", value="")\n        ctx.set("status", text="共 %d 項" % len(items))\n\n    return {"handlers": {"click:add": add, "shortcut:add": add}}\n',"guitpl_lib/demo/todo_yaml.yaml":'# 用 YAML 寫的範本（示範）：內容與 jsonl 範本的紀錄完全一樣，一筆紀錄一份文件，以 --- 分開。\n# {{參數}} 要加雙引號（不加的話 YAML 會把它當成行內對照）。\nkind: meta\nid: demo/todo_yaml\ntitle: YAML 待辦示範\nkeywords: [yaml待辦, 示範待辦]\nentry: build\nstandalone: true\n---\nkind: param\nname: title\ndefault: YAML 待辦\nask: 視窗標題要寫什麼？\n---\nkind: require\nmodule: gui\nsource: builtin\n---\nkind: style\npalette:\n  bg: "#ffffff"\n  fg: "#222222"\n  accent: "#2563eb"\n  danger: "#dc2626"\n  muted: "#9ca3af"\nfont: sans-serif\nsize: 14\nradius: 6\n---\nkind: layout\nwindow: {title: "{{title}}", width: 480, height: 460, resizable: true}\ntree:\n  - kind: column\n    role: page\n    children:\n      - id: heading\n        kind: label\n        text: "{{title}}"\n        role: title\n        pad: 16\n      - kind: row\n        role: toolbar\n        children:\n          - {id: item, kind: entry, value: "", placeholder: 要做的事}\n          - {id: add, kind: button, text: 新增, role: primary}\n      - kind: column\n        grow: 1\n        pad: 12\n        gap: 8\n        children:\n          - id: items\n            kind: list\n            items: []\n            grow: 1\n      - id: status\n        kind: label\n        text: 還沒有項目\n        role: muted\n        pad: 8\n---\nkind: shortcut\nkeys: Ctrl+Enter\ndo: add\n---\nkind: scene\nid: main\ntitle: 清單\nnote: 輸入、清單與狀態列\n',"guitpl_lib/document/main.jsonl":'{"kind":"meta","id":"document/main","title":"文件編輯（工具列、大綱側欄、整面編輯區、狀態列）","keywords":["文件","文件編輯","大綱","章節","文稿","段落","標題","word","document"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"文件編輯","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"doc_name","default":"未命名文件","ask":"文件名稱要寫什麼？（會顯示在編輯區上方）"}\n{"kind":"param","name":"doc_text","default":"# 未命名文件\\n\\n在這裡開始寫。用上方的按鈕設定標題、粗體、清單，按「插入段落」會在游標處加一段新的。\\n\\n## 第一節\\n\\n左邊的大綱會列出所有標題，點一下就跳到那一節。","ask":"文件一開始要寫什麼？（# 開頭的行是標題）"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2328","accent":"#2563eb","danger":"#dc2626","muted":"#6b7280"},"font":"serif","size":15,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":980,"height":700,"resizable":true},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"row","grow":1,"children":[{"slot":"sidebar","role":"sidebar"},{"id":"body","kind":"editor","value":"{{doc_text}}","lang":"markdown","rows":18,"numbers":false,"prose":true,"grow":1,"wrap":true},{"id":"view","kind":"markdown","value":"","visible":false,"grow":1}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"document/toolbar","params":{}}\n{"kind":"slot","name":"sidebar","use":"document/sidebar","params":{"doc_name":"{{doc_name}}"}}\n{"kind":"slot","name":"statusbar","use":"document/statusbar","params":{}}\n{"kind":"scene","id":"no_outline","title":"沒有大綱","note":"只顯示提示；用 # 開頭寫一行標題後，大綱就會出現","show":["outline_hint"],"hide":["outline"]}\n{"kind":"scene","id":"has_outline","title":"有大綱","note":"大綱側欄列出所有標題，縮排表示層級，點一下就跳到那一節","show":["outline"],"hide":["outline_hint"]}\n{"kind":"shortcut","keys":"Ctrl+S","do":"save"}\n{"kind":"shortcut","keys":"Ctrl+B","do":"bold"}\n{"kind":"shortcut","keys":"Ctrl+I","do":"italic"}\n{"kind":"shortcut","keys":"Ctrl+1","do":"h1"}\n{"kind":"shortcut","keys":"Ctrl+2","do":"h2"}\n{"kind":"shortcut","keys":"Ctrl+3","do":"h3"}\n{"kind":"shortcut","keys":"Ctrl+Enter","do":"insert_para"}\n{"kind":"shortcut","keys":"Ctrl+E","do":"preview_btn"}\n',"guitpl_lib/document/main.py":'# -*- coding: utf-8 -*-\n# 文件的主畫面：把工具列（標題、粗體、插入段落、存檔）、大綱側欄、狀態列接起來。\n# 內容一改動（打字或工具列改了文字）就更新大綱與字數；快捷鍵接到同一組處理函式。\n\n\ndef build(win, spec, slots):\n    tb = slots["toolbar"]["handlers"]\n    refresh_outline = slots["sidebar"]["refresh"]\n    refresh_count = slots["statusbar"]["refresh"]\n\n    def refresh(ctx):\n        refresh_outline(ctx)\n        refresh_count(ctx)\n\n    def after(fn):\n        def run(ctx):\n            fn(ctx)\n            refresh(ctx)\n        return run\n\n    handlers = {"input:body": refresh, "start": refresh}\n    for name in ("h1", "h2", "h3", "bold", "italic", "bullet", "quote", "insert_para"):\n        handlers["click:" + name] = after(tb["click:" + name])\n        handlers["shortcut:" + name] = handlers["click:" + name]\n    handlers["click:preview_btn"] = tb["click:preview_btn"]\n    handlers["shortcut:preview_btn"] = tb["click:preview_btn"]\n    handlers["click:save"] = tb["click:save"]\n    handlers["shortcut:save"] = tb["click:save"]\n    return {"handlers": handlers}\n',"guitpl_lib/document/main_dark.jsonl":'{"kind":"meta","id":"document/main_dark","title":"深色文件編輯","keywords":["深色文件","夜間文件"],"extends":"document/main"}\n{"kind":"param","name":"title","default":"夜間文件編輯","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","danger":"#e5534b","muted":"#888888"}}\n',"guitpl_lib/document/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色文件編輯：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_document_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/document/main_warm.jsonl":'{"kind":"meta","id":"document/main_warm","title":"暖色文件編輯","keywords":["暖色文件","護眼文件"],"extends":"document/main"}\n{"kind":"param","name":"title","default":"暖色文件編輯","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fbf4e6","fg":"#3b2f20","accent":"#d9822b","danger":"#b91c1c","muted":"#a8946b"}}\n',"guitpl_lib/document/main_warm.py":'# -*- coding: utf-8 -*-\n# 暖色文件編輯：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_document_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/document/sidebar.jsonl":'{"kind":"meta","id":"document/sidebar","title":"大綱側欄（依 # 標題列出章節，點一下跳過去）","keywords":["大綱","側欄","目錄","章節清單"],"entry":"build"}\n{"kind":"param","name":"doc_name","default":"未命名文件","ask":"文件名稱要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"column","grow":1,"gap":6,"children":[{"id":"doc_label","kind":"label","text":"{{doc_name}}","role":"muted"},{"id":"outline_title","kind":"label","text":"大綱","role":"heading"},{"id":"outline_hint","kind":"label","text":"還沒有章節：用 # 開頭的行會出現在這裡","role":"muted"},{"id":"outline","kind":"list","items":[],"grow":1}]}]}\n',"guitpl_lib/document/sidebar.py":'# -*- coding: utf-8 -*-\n# 大綱側欄：從內容抓出 # 開頭的標題（# 是一級，## 二級，最多六級），用縮排表示層級；點一下大綱的項目，編輯區的游標就跳到那一行（並選起來）。\n# 沒有標題就切到「沒有大綱」場景。內容一改動主畫面就呼叫 refresh；大綱沒變就不重畫。\n\nNBSP = " "  # 選單項目前面的空白會被網頁吃掉，縮排要用不斷行空白\n\n\ndef headings(text):\n    """[(level, title, offset of the line, line length)] for every heading line (a ``` code fence hides its lines)."""\n    out = []\n    pos = 0\n    fenced = False\n    for ln in text.split("\\n"):\n        s = ln.strip()\n        if s.startswith("```"):\n            fenced = not fenced\n        elif not fenced and s.startswith("#"):\n            level = len(s) - len(s.lstrip("#"))\n            title = s[level:].strip()\n            if 1 <= level <= 6 and title and (len(s) == level or s[level] == " "):\n                out.append((level, title, pos, len(ln)))\n        pos += len(ln) + 1\n    return out\n\n\ndef labels(items):\n    return [NBSP * 2 * (lv - 1) + title for lv, title, _off, _n in items]\n\n\ndef refresh(ctx):\n    items = headings(ctx.get("body"))\n    ctx.state["outline"] = items\n    names = labels(items)\n    if names != ctx.state.get("outline_names"):\n        ctx.state["outline_names"] = names\n        ctx.set("outline", items=names)\n    ctx.goto("has_outline" if items else "no_outline")\n\n\ndef jump(ctx):\n    items = ctx.state.get("outline") or []\n    names = labels(items)\n    picked = (ctx.event or {}).get("value")\n    if picked in names:\n        _lv, _title, off, n = items[names.index(picked)]\n        ctx.set("body", caret=off, caret_to=off + n)\n\n\ndef build(win, spec, slots):\n    return {"refresh": refresh, "handlers": {"select:outline": jump}}\n',"guitpl_lib/document/statusbar.jsonl":'{"kind":"meta","id":"document/statusbar","title":"文件狀態列（字數、游標位置與訊息）","keywords":["文件狀態列","字數","存檔訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"count","kind":"label","text":"0 字"},{"id":"pos","kind":"label","text":"第 1 行，第 1 欄"},{"id":"msg","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/document/statusbar.py":'# -*- coding: utf-8 -*-\n# 文件狀態列：字數（主畫面在內容改動後呼叫 refresh）與游標位置（頁面回報游標，這裡換成第幾行第幾欄）。\n\n\ndef refresh(ctx):\n    ctx.set("count", text="%d 字" % len(ctx.get("body")))\n    show_pos(ctx)\n\n\ndef show_pos(ctx):\n    a, _b = ctx.caret("body")\n    text = ctx.get("body")\n    line = text.count("\\n", 0, a) + 1\n    col = a - (text.rfind("\\n", 0, a) + 1) + 1\n    ctx.set("pos", text="第 %d 行，第 %d 欄" % (line, col))\n\n\ndef build(win, spec, slots):\n    return {"refresh": refresh, "handlers": {"caret:body": show_pos}}\n',"guitpl_lib/document/toolbar.jsonl":'{"kind":"meta","id":"document/toolbar","title":"文件工具列（標題、粗體斜體、清單引用、插入段落、預覽、存檔）","keywords":["文件工具列","標題","粗體","斜體","插入段落","存檔文件"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"h1","kind":"button","text":"標題 1","icon":"H1"},{"id":"h2","kind":"button","text":"標題 2","icon":"H2"},{"id":"h3","kind":"button","text":"標題 3","icon":"H3"},{"kind":"label","text":"","role":"divider"},{"id":"bold","kind":"button","text":"粗體","icon":"B"},{"id":"italic","kind":"button","text":"斜體","icon":"I"},{"kind":"label","text":"","role":"divider"},{"id":"bullet","kind":"button","text":"清單","icon":"•"},{"id":"quote","kind":"button","text":"引用","icon":"❝"},{"kind":"label","text":"","role":"divider"},{"id":"insert_para","kind":"button","text":"插入段落","icon":"＋"},{"id":"preview_btn","kind":"button","text":"預覽","icon":"◉"},{"id":"save","kind":"button","text":"存檔","icon":"⬇","role":"primary"}]}]}\n',"guitpl_lib/document/toolbar.py":'# -*- coding: utf-8 -*-\n# 文件工具列的行為：全部都是「在游標處」改編輯區的文字（Markdown 寫法），不會多出任何區塊：\n#   標題 1 到 3（再按一次同級就取消）、粗體與斜體（包住選取的字；沒選就放一個預設字並選起來）、清單與引用（每行加前綴，再按一次取消）、\n#   插入段落（在游標處切開，放一個空段落並選起來，直接打字就蓋掉預設字）、存檔。\n# 文字處理都是純函式（輸入文字與選取範圍，回傳新文字與新的選取範圍），好測試；處理函式只負責讀游標、寫回、把游標放到新位置。\n\n\ndef line_start(text, pos):\n    return text.rfind("\\n", 0, pos) + 1\n\n\ndef line_end(text, pos):\n    e = text.find("\\n", pos)\n    return len(text) if e < 0 else e\n\n\ndef heading_level(line):\n    n = len(line) - len(line.lstrip("#"))\n    if 1 <= n <= 6 and (len(line) == n or line[n] == " "):\n        return n\n    return 0\n\n\ndef apply_heading(text, a, b, level):\n    """The line at the caret becomes a heading of this level (the same level again takes it back to a plain line). Returns (text, start, end)."""\n    ls, le = line_start(text, a), line_end(text, a)\n    line = text[ls:le]\n    body = line.lstrip("#").lstrip() if heading_level(line) else line\n    prefix = "" if heading_level(line) == level else "#" * level + " "\n    new_line = prefix + body\n    out = text[:ls] + new_line + text[le:]\n    end = ls + len(new_line)\n    return out, end, end\n\n\ndef apply_wrap(text, a, b, mark, placeholder):\n    """Wraps the selection in mark (** for bold, * for italic); wrapped already takes it off again. No selection: the placeholder, selected."""\n    m = len(mark)\n    sel = text[a:b]\n    if len(sel) >= 2 * m and sel.startswith(mark) and sel.endswith(mark):\n        inner = sel[m:-m]\n        return text[:a] + inner + text[b:], a, a + len(inner)\n    if a >= m and text[a - m:a] == mark and text[b:b + m] == mark and sel:\n        return text[:a - m] + sel + text[b + m:], a - m, a - m + len(sel)\n    inner = sel or placeholder\n    return text[:a] + mark + inner + mark + text[b:], a + m, a + m + len(inner)\n\n\ndef apply_prefix(text, a, b, prefix):\n    """Puts prefix in front of every line the selection touches (all have it already: takes it off). Returns the changed block as the selection."""\n    ls = line_start(text, a)\n    le = line_end(text, b if b == a or text[b - 1:b] != "\\n" else b - 1)\n    lines = text[ls:le].split("\\n")\n    if all(l.startswith(prefix) for l in lines if l.strip() or len(lines) == 1):\n        new = [l[len(prefix):] if l.startswith(prefix) else l for l in lines]\n    else:\n        new = [l if l.startswith(prefix) else prefix + l for l in lines]\n    block = "\\n".join(new)\n    return text[:ls] + block + text[le:], ls, ls + len(block)\n\n\ndef apply_paragraph(text, a, b, placeholder="新段落"):\n    """Inserts a new paragraph at the caret: the text is split there, one blank line on each side, the placeholder selected."""\n    head = text[:b].rstrip(" \\t\\n")\n    tail = text[b:].lstrip(" \\t\\n")\n    before = "\\n\\n" if head else ""\n    after = "\\n\\n" if tail else "\\n"\n    start = len(head) + len(before)\n    return head + before + placeholder + after + tail, start, start + len(placeholder)\n\n\ndef _edit(ctx, fn):\n    if ctx.state.get("preview"):\n        return  # 預覽中不能改文字\n    a, b = ctx.caret("body")\n    text, s, e = fn(ctx.get("body"), a, b)\n    ctx.set("body", value=text, caret=s, caret_to=e)\n\n\ndef heading(level):\n    return lambda ctx: _edit(ctx, lambda t, a, b: apply_heading(t, a, b, level))\n\n\ndef bold(ctx):\n    _edit(ctx, lambda t, a, b: apply_wrap(t, a, b, "**", "粗體文字"))\n\n\ndef italic(ctx):\n    _edit(ctx, lambda t, a, b: apply_wrap(t, a, b, "*", "斜體文字"))\n\n\ndef bullet(ctx):\n    _edit(ctx, lambda t, a, b: apply_prefix(t, a, b, "- "))\n\n\ndef quote(ctx):\n    _edit(ctx, lambda t, a, b: apply_prefix(t, a, b, "> "))\n\n\ndef insert_para(ctx):\n    _edit(ctx, apply_paragraph)\n    ctx.set("msg", text="已在游標處插入新段落")\n\n\ndef toggle_preview(ctx):\n    """編輯與預覽切換：預覽把 Markdown 畫成排版後的樣子（標題變大變粗、粗體變粗、清單有項目符號）。"""\n    on = not ctx.state.get("preview", False)\n    ctx.state["preview"] = on\n    if on:\n        ctx.set("view", value=ctx.get("body"))\n        ctx.set("body", visible=False)\n        ctx.set("view", visible=True)\n        ctx.set("preview_btn", text="編輯", icon="✎")\n        ctx.set("msg", text="預覽：排版後的樣子（按「編輯」回去改）")\n    else:\n        ctx.set("view", visible=False)\n        ctx.set("body", visible=True)\n        a, b = ctx.caret("body")\n        ctx.set("body", caret=a, caret_to=b)\n        ctx.set("preview_btn", text="預覽", icon="◉")\n        ctx.set("msg", text="編輯")\n\n\ndef save(ctx):\n    ctx.state["saved"] = ctx.state.get("saved", 0) + 1\n    ctx.set("msg", text="已存 %d 次" % ctx.state["saved"])\n\n\ndef build(win, spec, slots):\n    return {"handlers": {\n        "click:h1": heading(1), "click:h2": heading(2), "click:h3": heading(3),\n        "click:bold": bold, "click:italic": italic, "click:bullet": bullet, "click:quote": quote,\n        "click:insert_para": insert_para, "click:save": save, "click:preview_btn": toggle_preview,\n    }}\n',"guitpl_lib/game/main.jsonl":'{"kind":"meta","id":"game/main","title":"打磚塊（畫布小遊戲）","keywords":["遊戲","打磚塊","小遊戲","畫布","canvas"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"打磚塊","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"lives","default":"3","ask":"一開始有幾條命？"}\n{"kind":"param","name":"rows","default":"4","ask":"磚塊有幾排（1 到 6）？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"require","module":"random","source":"builtin"}\n{"kind":"style","palette":{"bg":"#111827","fg":"#f9fafb","accent":"#22c55e","danger":"#ef4444","muted":"#6b7280"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":640,"resizable":true,"height":560},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"screen","kind":"canvas","width":400,"height":300,"fps":15,"fit":true,"grow":1},{"id":"over_box","kind":"label","text":"遊戲結束","role":"title","grow":1},{"slot":"statusbar"},{"id":"help","kind":"label","text":"左右鍵移動擋板，空白鍵發球。","role":"muted","pad":8}]}]}\n{"kind":"slot","name":"toolbar","use":"game/toolbar","params":{}}\n{"kind":"slot","name":"statusbar","use":"game/statusbar","params":{"lives":"{{lives}}"}}\n{"kind":"scene","id":"play","title":"進行中","note":"畫布與操作說明","show":["screen","help"],"hide":["over_box"],"on":{"click:restart":"play"}}\n{"kind":"scene","id":"over","title":"結束","note":"只顯示結束訊息，可重新開始","show":["over_box"],"hide":["screen","help"],"on":{"click:restart":"play"}}\n{"kind":"shortcut","keys":"Left","do":"left"}\n{"kind":"shortcut","keys":"Right","do":"right"}\n{"kind":"shortcut","keys":"Space","do":"serve"}\n',"guitpl_lib/game/main.py":'# -*- coding: utf-8 -*-\n# 打磚塊：下方擋板左右移動，球撞到磚塊就得分，掉下去扣一條命，磚塊全打完或命用完就結束。\n# 畫布每秒 15 格（frame:screen 事件）推進一格；按鈕與快捷鍵只改狀態，畫面每格重畫（一格不超過 200 道指令）。\nimport random\n\nW, H = 400, 300\nPADDLE_W, PADDLE_H, PADDLE_Y = 70, 8, 276\nPADDLE_SPEED = 12\nBALL_R = 4\nBRICK_W, BRICK_H, GAP = 40, 14, 6\nROW_COLORS = ["#ef4444", "#f59e0b", "#22c55e", "#3b82f6", "#a855f7", "#14b8a6"]\n\n\ndef _fresh(lives, rows):\n    bricks = []\n    for r in range(rows):\n        for c in range(8):\n            bricks.append([14 + c * (BRICK_W + GAP), 40 + r * (BRICK_H + GAP), r])\n    return {"paddle": (W - PADDLE_W) / 2.0, "ball": [W / 2.0, PADDLE_Y - 20.0], "vel": [0.0, 0.0],\n            "bricks": bricks, "lives": lives, "score": 0, "running": True, "over": False, "shown": None}\n\n\ndef _step(G):\n    x, y = G["ball"]\n    vx, vy = G["vel"]\n    x += vx\n    y += vy\n    if x - BALL_R < 0 or x + BALL_R > W:\n        vx = -vx\n        x = min(max(x, BALL_R), W - BALL_R)\n    if y - BALL_R < 0:\n        vy = -vy\n        y = BALL_R\n    p = G["paddle"]\n    if vy > 0 and PADDLE_Y - BALL_R <= y <= PADDLE_Y + PADDLE_H and p - BALL_R <= x <= p + PADDLE_W + BALL_R:\n        vy = -abs(vy)\n        vx = (x - (p + PADDLE_W / 2.0)) / 10.0      # 撞在擋板的哪裡，決定球往哪邊飛\n    for b in G["bricks"]:\n        bx, by = b[0], b[1]\n        if bx - BALL_R <= x <= bx + BRICK_W + BALL_R and by - BALL_R <= y <= by + BRICK_H + BALL_R:\n            G["bricks"].remove(b)\n            G["score"] += 1\n            vy = -vy\n            break\n    if y > H:                                       # 球掉下去：扣一條命，球回到擋板上\n        G["lives"] -= 1\n        x, y = p + PADDLE_W / 2.0, PADDLE_Y - 20.0\n        vx, vy = 0.0, 0.0\n    G["ball"] = [x, y]\n    G["vel"] = [vx, vy]\n\n\ndef _end(ctx, G, message):\n    G["over"] = True\n    G["running"] = False\n    ctx.set("over_box", text=message)\n    ctx.goto("over")\n\n\ndef _show(ctx, G):\n    now = (G["score"], G["lives"])\n    if now != G["shown"]:\n        G["shown"] = now\n        ctx.set("score_text", text="分數 %d" % G["score"])\n        ctx.set("lives_text", text="命 %d" % G["lives"])\n\n\ndef _tick(ctx, G, pal):\n    if G["running"] and not G["over"]:\n        if G["vel"] == [0.0, 0.0]:                  # 還沒發球：球跟著擋板走\n            G["ball"] = [G["paddle"] + PADDLE_W / 2.0, PADDLE_Y - 20.0]\n        else:\n            _step(G)\n        if G["lives"] <= 0:\n            _end(ctx, G, "命用完了，分數 %d" % G["score"])\n        elif not G["bricks"]:\n            _end(ctx, G, "全部打完！分數 %d" % G["score"])\n    _show(ctx, G)\n    ops = [["clear", pal.get("bg", "#000000")]]\n    for bx, by, row in G["bricks"]:\n        ops.append(["rect", bx, by, BRICK_W, BRICK_H, ROW_COLORS[row % len(ROW_COLORS)]])\n    ops.append(["rect", int(G["paddle"]), PADDLE_Y, PADDLE_W, PADDLE_H, pal.get("fg", "#ffffff")])\n    ops.append(["circle", int(G["ball"][0]), int(G["ball"][1]), BALL_R, pal.get("accent", "#22c55e")])\n    ctx.w.draw(ctx.id("screen"), ops)\n\n\ndef build(win, spec, slots):\n    lives = max(1, int(spec["params"].get("lives", 3)))\n    rows = max(1, min(6, int(spec["params"].get("rows", 4))))\n    pal = spec["style"].get("palette", {})\n    G = _fresh(lives, rows)\n\n    def move(d):\n        def handler(ctx):\n            G["paddle"] = min(max(0.0, G["paddle"] + d), W - PADDLE_W)\n        return handler\n\n    def serve(ctx):\n        if G["over"]:\n            return\n        if G["vel"] == [0.0, 0.0]:\n            G["vel"] = [random.choice((-2.5, 2.5)), -3.5]\n        G["running"] = True\n\n    def pause(ctx):\n        if G["over"]:\n            return\n        G["running"] = not G["running"]\n        ctx.set("pause", text="繼續" if not G["running"] else "暫停")\n\n    def restart(ctx):\n        G.update(_fresh(lives, rows))\n        ctx.set("pause", text="暫停")\n        ctx.goto("play")\n        _show(ctx, G)\n\n    def frame(ctx):\n        _tick(ctx, G, pal)\n\n    return {"handlers": {\n        "frame:screen": frame,\n        "shortcut:left": move(-PADDLE_SPEED),\n        "shortcut:right": move(PADDLE_SPEED),\n        "shortcut:serve": serve,\n        "click:serve": serve,\n        "click:pause": pause,\n        "click:restart": restart,\n    }}\n',"guitpl_lib/game/main_dark.jsonl":'{"kind":"meta","id":"game/main_dark","title":"打磚塊（夜間）","keywords":["遊戲","打磚塊","深色","夜間"],"extends":"game/main"}\n{"kind":"param","name":"title","default":"打磚塊（夜間）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#000000","fg":"#e5e7eb","accent":"#4ade80","danger":"#f87171","muted":"#4b5563"}}\n',"guitpl_lib/game/main_dark.py":'# -*- coding: utf-8 -*-\n# 夜間版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_game_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/game/main_light.jsonl":'{"kind":"meta","id":"game/main_light","title":"打磚塊（明亮）","keywords":["遊戲","打磚塊","淺色","明亮"],"extends":"game/main"}\n{"kind":"param","name":"title","default":"打磚塊（明亮）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#f8fafc","fg":"#0f172a","accent":"#2563eb","danger":"#dc2626","muted":"#94a3b8"}}\n',"guitpl_lib/game/main_light.py":'# -*- coding: utf-8 -*-\n# 明亮版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_game_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/game/statusbar.jsonl":'{"kind":"meta","id":"game/statusbar","title":"遊戲狀態列（分數、剩餘命數）","keywords":["狀態列","分數","命數","遊戲"],"entry":"build"}\n{"kind":"param","name":"lives","default":"3","ask":"剩幾條命？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"score_text","kind":"label","text":"分數 0"},{"id":"lives_text","kind":"label","text":"命 {{lives}}"}]}]}\n',"guitpl_lib/game/statusbar.py":"# -*- coding: utf-8 -*-\n# 遊戲狀態列只顯示：分數與命數由 main.py 用名稱 score_text、lives_text 更新。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/game/toolbar.jsonl":'{"kind":"meta","id":"game/toolbar","title":"遊戲工具列（發球、暫停、重新開始）","keywords":["工具列","遊戲","發球","暫停"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"serve","kind":"button","text":"發球","icon":"▶","role":"primary"},{"id":"pause","kind":"button","text":"暫停","icon":"⏸"},{"id":"restart","kind":"button","text":"重新開始","icon":"↻"}]}]}\n',"guitpl_lib/game/toolbar.py":"# -*- coding: utf-8 -*-\n# 遊戲工具列只負責按鈕：按下後的事件（click:serve、click:pause、click:restart）由 main.py 處理。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/idphoto/main.jsonl":'{"kind":"meta","id":"idphoto/main","title":"證件照（簡化版）","keywords":["證件照","大頭照","證件","照片","背景色"],"entry":"build","standalone":true}\n{"kind":"param","name":"name","default":"證件照","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"bg","default":"白","ask":"預設背景色要選哪一個（白、淺藍、淺灰、紅）？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{name}}","width":840,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"main_row","kind":"row","grow":1,"pad":16,"gap":16,"children":[{"id":"choose_panel","kind":"column","role":"card","children":[{"kind":"label","text":"尺寸","role":"heading"},{"id":"size_list","kind":"list","items":["一吋 2.5×3.5 公分","二吋 3.5×5.3 公分","護照 3.3×4.8 公分"],"selected":"一吋 2.5×3.5 公分"},{"kind":"label","text":"背景色","role":"heading"},{"id":"bg_list","kind":"list","items":["白","淺藍","淺灰","紅"],"selected":"{{bg}}"},{"kind":"row","children":[{"id":"preview_btn","kind":"button","text":"預覽","role":"primary"},{"id":"open_btn","kind":"button","text":"開啟照片"},{"id":"finish_btn","kind":"button","text":"輸出"}]}]},{"id":"view","kind":"canvas","width":240,"height":300,"fit":true,"grow":1}]},{"id":"info","kind":"label","text":"尺寸與背景色","role":"muted","pad":8},{"id":"done_panel","kind":"column","grow":1,"pad":16,"gap":12,"children":[{"id":"done_txt","kind":"label","text":"已輸出（簡化版：只示意，未存檔）","role":"title","grow":1},{"id":"back_btn","kind":"button","text":"重新選擇","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"idphoto/toolbar","params":{"caption":"證件照工具"}}\n{"kind":"slot","name":"statusbar","use":"idphoto/statusbar","params":{"hint":"請選尺寸與背景色"}}\n{"kind":"scene","id":"choose","title":"選擇中","note":"選尺寸與背景色，預覽框顯示裁切線示意","show":["choose_panel","view","info","main_row"],"hide":["done_panel"],"on":{"click:finish_btn":"done","shortcut:finish":"done"}}\n{"kind":"scene","id":"done","title":"已輸出","note":"只顯示完成訊息","show":["done_panel"],"hide":["choose_panel","view","info","main_row"],"on":{"click:back_btn":"choose"}}\n{"kind":"shortcut","keys":"Ctrl+R","do":"redraw"}\n{"kind":"shortcut","keys":"Ctrl+E","do":"finish"}\n',"guitpl_lib/idphoto/main.py":'# -*- coding: utf-8 -*-\n# 證件照（簡化版）：只畫尺寸與背景色的示意圖與裁切線，不做人臉偵測與真的裁切。\n# 畫布一幀最多 200 道繪圖指令，這裡每次約 15 道。\n\nSIZE_ORDER = ["一吋 2.5×3.5 公分", "二吋 3.5×5.3 公分", "護照 3.3×4.8 公分"]\nSIZE_CM = {"一吋 2.5×3.5 公分": (2.5, 3.5), "二吋 3.5×5.3 公分": (3.5, 5.3), "護照 3.3×4.8 公分": (3.3, 4.8)}\nBG = {"白": "#ffffff", "淺藍": "#9ec9ff", "淺灰": "#d9d9d9", "紅": "#e0343a"}\nCW, CH = 240, 300  # 要和 jsonl 裡 view 畫布的寬高一致\n\n\ndef _redraw(ctx):\n    size = ctx.get("size_list") or SIZE_ORDER[0]\n    bg = ctx.get("bg_list") or "白"\n    guide = ctx.state.get("guide", True)\n    w_cm, h_cm = SIZE_CM.get(size, SIZE_CM[SIZE_ORDER[0]])\n    # 等比例縮放：寬不超過 200、高不超過 280\n    scale = min(200.0 / w_cm, 280.0 / h_cm)\n    bw, bh = w_cm * scale, h_cm * scale\n    x0, y0 = (CW - bw) / 2.0, (CH - bh) / 2.0\n    cx = CW / 2.0\n    x1, y1 = x0 + bw, y0 + bh\n    ops = [\n        ["clear", "#444444"],\n        ["rect", int(x0), int(y0), int(bw), int(bh), BG.get(bg, "#ffffff")],\n    ]\n    photo = ctx.state.get("photo")\n    if photo:  # 使用者開啟的照片：縮放塞進裁切框（簡化版：不做人臉偵測，也不去背）\n        ops.append(["image", photo, int(x0), int(y0), int(bw), int(bh)])\n    else:\n        ops += [\n            ["circle", int(cx), int(y0 + bh * 0.35), int(bh * 0.14), "#e8b48a"],\n            ["rect", int(cx - bw * 0.3), int(y0 + bh * 0.52), int(bw * 0.6), int(bh * 0.4), "#3b4a6b"],\n        ]\n    ops.append(["text", 8, 16, size, "#ffffff"])\n    if guide:\n        eye = int(y0 + bh * 0.3)\n        ops += [\n            ["line", int(x0), eye, int(x1), eye, "#00c853"],\n            ["line", int(cx), int(y0), int(cx), int(y1), "#00c853"],\n            ["line", int(x0), int(y0), int(x1), int(y0), "#ff3b30"],\n            ["line", int(x0), int(y1), int(x1), int(y1), "#ff3b30"],\n            ["line", int(x0), int(y0), int(x0), int(y1), "#ff3b30"],\n            ["line", int(x1), int(y0), int(x1), int(y1), "#ff3b30"],\n        ]\n    ctx.w.draw(ctx.id("view"), ops)\n    ctx.set("info", text="尺寸 %s、背景%s%s" % (size, bg, "（顯示裁切線）" if guide else ""))\n\n\ndef build(win, spec, slots):\n    def reset(ctx):\n        ctx.set("size_list", selected=SIZE_ORDER[0])\n        ctx.set("bg_list", selected="白")\n        ctx.state["guide"] = True\n        _redraw(ctx)\n\n    def open_photo(ctx):\n        try:\n            f = ctx.pick_file("開啟照片", accept="image/*", max_bytes=256 * 1024)\n        except ValueError as e:\n            ctx.set("info", text=str(e))\n            return\n        if f is None:\n            return\n        try:\n            name, w, h = ctx.w.image(ctx.id("view"), f["data"], f["mime"])\n        except Exception as e:  # 瀏覽器解不開的圖片\n            ctx.set("info", text="開不了這張照片：%s" % e)\n            return\n        ctx.state["photo"] = name\n        _redraw(ctx)\n        ctx.set("info", text="已開啟 %s（%d×%d），縮放進裁切框" % (f["name"], w, h))\n\n    def toggle_guide(ctx):\n        ctx.state["guide"] = not ctx.state.get("guide", True)\n        _redraw(ctx)\n\n    def finish(ctx):\n        size = ctx.get("size_list") or SIZE_ORDER[0]\n        ctx.set("done_txt", text="已輸出 %s（簡化版：只示意，未存檔）" % size)\n        _redraw(ctx)\n\n    return {"handlers": {\n        "select:size_list": _redraw,\n        "select:bg_list": _redraw,\n        "click:preview_btn": _redraw,\n        "click:open_btn": open_photo,\n        "shortcut:redraw": _redraw,\n        "click:tb_guide": toggle_guide,\n        "click:tb_reset": reset,\n        "click:finish_btn": finish,\n        "shortcut:finish": finish,\n    }}\n',"guitpl_lib/idphoto/main_dark.jsonl":'{"kind":"meta","id":"idphoto/main_dark","title":"深色證件照（簡化版）","keywords":["深色證件照","夜間證件照"],"extends":"idphoto/main"}\n{"kind":"param","name":"name","default":"夜間證件照","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","muted":"#6b7280"},"font":"monospace"}\n',"guitpl_lib/idphoto/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色變體：只覆寫 style 與視窗標題參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_idphoto_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/idphoto/main_light.jsonl":'{"kind":"meta","id":"idphoto/main_light","title":"淺色證件照（簡化版）","keywords":["淺色證件照","明亮證件照"],"extends":"idphoto/main"}\n{"kind":"param","name":"bg","default":"淺藍","ask":"預設背景色要選哪一個（白、淺藍、淺灰、紅）？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#f8fafc","fg":"#0f172a","accent":"#059669"},"font":"sans-serif","radius":10}\n',"guitpl_lib/idphoto/main_light.py":'# -*- coding: utf-8 -*-\n# 淺色變體：只覆寫 style 與背景色參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_idphoto_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/idphoto/statusbar.jsonl":'{"kind":"meta","id":"idphoto/statusbar","title":"證件照狀態列","keywords":["證件照狀態列","狀態列"],"entry":"build"}\n{"kind":"param","name":"hint","default":"請選尺寸與背景色","ask":"狀態列一開始要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"sb_text","kind":"label","text":"{{hint}}"}]}]}\n',"guitpl_lib/idphoto/statusbar.py":"# -*- coding: utf-8 -*-\n# 狀態列沒有自己的行為：主畫面用 sb_text 這個名稱更新文字。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/idphoto/toolbar.jsonl":'{"kind":"meta","id":"idphoto/toolbar","title":"證件照工具列","keywords":["證件照工具列","工具列"],"entry":"build"}\n{"kind":"param","name":"caption","default":"證件照工具","ask":"工具列左邊要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"kind":"label","text":"{{caption}}"},{"id":"tb_reset","kind":"button","text":"重設","icon":"↺"},{"id":"tb_guide","kind":"button","text":"裁切線開關","icon":"⌗"}]}]}\n',"guitpl_lib/idphoto/toolbar.py":"# -*- coding: utf-8 -*-\n# 工具列的按鈕（重設、裁切線開關）由主畫面處理，因為要重畫預覽框。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/image/main.jsonl":'{"kind":"meta","id":"image/main","title":"影像處理（簡化版）","keywords":["影像","濾鏡","圖層","處理","反相","灰階"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"影像處理","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"layer_max","default":"8","ask":"圖層最多可以疊幾層？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2937","accent":"#2563eb","danger":"#dc2626","muted":"#6b7280"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":900,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"row","grow":1,"children":[{"id":"left","kind":"column","role":"sidebar","children":[{"kind":"label","text":"工具（點選後加入圖層）","role":"heading"},{"id":"tools","kind":"list","items":["反相","灰階","提亮","變暗","紅色通道"],"selected":"反相","grow":1},{"id":"add","kind":"button","text":"加入圖層","role":"primary"}]},{"id":"right","kind":"column","grow":1,"pad":16,"gap":10,"children":[{"id":"preview","kind":"canvas","width":312,"height":208,"fit":true,"grow":3},{"kind":"label","text":"圖層（由下往上套用）","role":"heading"},{"id":"layers","kind":"list","items":[],"grow":1}]}]},{"id":"actions","kind":"row","pad":10,"children":[{"id":"open_img","kind":"button","text":"開啟圖片"},{"id":"orig","kind":"button","text":"看原圖比對"},{"id":"note","kind":"label","text":"原圖（未套用任何圖層）","role":"muted"},{"id":"back","kind":"button","text":"回到編輯","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"image/toolbar"}\n{"kind":"slot","name":"statusbar","use":"image/statusbar"}\n{"kind":"scene","id":"edit","title":"編輯中","note":"工具、圖層與預覽","show":["left","right","orig","open_img"],"hide":["note","back"],"on":{"click:orig":"compare"}}\n{"kind":"scene","id":"compare","title":"比對原圖","note":"只顯示原圖","show":["right","note","back"],"hide":["left","orig","open_img"],"on":{"click:back":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+Enter","do":"add"}\n{"kind":"shortcut","keys":"Ctrl+Z","do":"undo"}\n',"guitpl_lib/image/main.py":'# -*- coding: utf-8 -*-\n# 影像處理（簡化版）：畫布用 12x8 的小方格當作一張小圖，每個方格的顏色依序套用圖層的效果。\n# 撤銷與清空由工具列子元件處理；這裡包住它們的處理函式並重畫。\n\nW = 12\nH = 8\nCELL = 26\n\n\ndef clamp(v):\n    return max(0, min(255, int(v)))\n\n\ndef gray(c):\n    g = int(0.3 * c[0] + 0.59 * c[1] + 0.11 * c[2])\n    return (g, g, g)\n\n\nEFFECTS = {\n    "反相": lambda c: (255 - c[0], 255 - c[1], 255 - c[2]),\n    "灰階": gray,\n    "提亮": lambda c: (clamp(c[0] + 40), clamp(c[1] + 40), clamp(c[2] + 40)),\n    "變暗": lambda c: (clamp(c[0] - 40), clamp(c[1] - 40), clamp(c[2] - 40)),\n    "紅色通道": lambda c: (c[0], 0, 0),\n}\n\n\ndef base(x, y):\n    return (x * 255 // (W - 1), y * 255 // (H - 1), 128)\n\n\ndef pixel(x, y, layers):\n    c = base(x, y)\n    for name in layers:\n        c = EFFECTS[name](c)\n    return c\n\n\ndef hexcolor(c):\n    return "#%02x%02x%02x" % c\n\n\ndef draw(ctx, colors):\n    layers = ctx.state.get("layers", [])\n    original = ctx.scene == "compare"\n    ops = [["clear", colors["bg"]]]\n    photo = ctx.state.get("photo")\n    if photo:  # 使用者開啟的圖片：整張畫在畫布上（簡化版：圖層效果只套在示範小圖，不套在開啟的圖片）\n        ops.append(["image", photo, 0, 0, W * CELL, H * CELL])\n        ctx.w.draw(ctx.id("preview"), ops)\n        ctx.set("layers", items=["%d. %s" % (i + 1, n) for i, n in enumerate(layers)])\n        return\n    for y in range(H):\n        for x in range(W):\n            c = base(x, y) if original else pixel(x, y, layers)\n            ops.append(["rect", x * CELL, y * CELL, CELL, CELL, hexcolor(c)])\n    ctx.w.draw(ctx.id("preview"), ops)\n    ctx.set("layers", items=["%d. %s" % (i + 1, n) for i, n in enumerate(layers)])\n\n\ndef int_param(value, default):\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        return default\n\n\ndef build(win, spec, slots):\n    pal = (spec.get("style") or {}).get("palette") or {}\n    colors = {\n        "bg": pal.get("bg", "#ffffff"), "fg": pal.get("fg", "#1f2937"), "accent": pal.get("accent", "#2563eb"),\n        "danger": pal.get("danger", "#dc2626"), "muted": pal.get("muted", "#6b7280"),\n    }\n    max_layers = max(1, min(32, int_param(spec["params"].get("layer_max"), 8)))\n    tb = slots["toolbar"]["handlers"]\n\n    def add(ctx):\n        layers = ctx.state.setdefault("layers", [])\n        name = ctx.get("tools")\n        if name not in EFFECTS:\n            name = next(iter(EFFECTS))\n        if len(layers) >= max_layers:\n            ctx.set("status", text="圖層已達上限 %d 層" % max_layers)\n            return\n        layers.append(name)\n        ctx.set("status", text="已加入「%s」" % name)\n        draw(ctx, colors)\n\n    def open_image(ctx):\n        try:\n            f = ctx.pick_file("開啟圖片", accept="image/*", max_bytes=256 * 1024)\n        except ValueError as e:\n            ctx.set("status", text=str(e))\n            return\n        if f is None:\n            ctx.set("status", text="沒有選檔案")\n            return\n        try:\n            name, w, h = ctx.w.image(ctx.id("preview"), f["data"], f["mime"])\n        except Exception as e:  # 瀏覽器解不開的圖片\n            ctx.set("status", text="開不了這張圖片：%s" % e)\n            return\n        ctx.state["photo"] = name\n        ctx.set("status", text="已開啟 %s（%d×%d；簡化版：圖層效果不套在開啟的圖片上）" % (f["name"], w, h))\n        draw(ctx, colors)\n\n    def redraw_after(fn):\n        def handler(ctx):\n            fn(ctx)\n            draw(ctx, colors)\n        return handler\n\n    handlers = {key: redraw_after(fn) for key, fn in tb.items()}\n    handlers["click:add"] = add\n    handlers["click:open_img"] = open_image\n    handlers["shortcut:add"] = add\n    handlers["start"] = lambda ctx: draw(ctx, colors)\n    handlers["click:orig"] = redraw_after(lambda ctx: None)\n    handlers["click:back"] = redraw_after(lambda ctx: None)\n    return {"handlers": handlers}\n',"guitpl_lib/image/main_dark.jsonl":'{"kind":"meta","id":"image/main_dark","title":"深色影像處理（簡化版）","keywords":["深色","夜間","影像"],"extends":"image/main"}\n{"kind":"param","name":"title","default":"夜間影像處理","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#e5e7eb","accent":"#4aa3ff","danger":"#ef4444","muted":"#9ca3af"},"font":"monospace"}\n',"guitpl_lib/image/main_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 image/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_image_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/image/main_light.jsonl":'{"kind":"meta","id":"image/main_light","title":"淺色影像處理（簡化版）","keywords":["淺色","明亮","影像"],"extends":"image/main"}\n{"kind":"param","name":"title","default":"淺色影像處理","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#111827","accent":"#7c3aed","danger":"#e11d48","muted":"#6b7280"}}\n',"guitpl_lib/image/main_light.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 image/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_image_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/image/statusbar.jsonl":'{"kind":"meta","id":"image/statusbar","title":"狀態列","keywords":["狀態列","狀態","訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/image/statusbar.py":'# -*- coding: utf-8 -*-\n# 狀態列只負責顯示；其他元件用名稱 "status" 寫入訊息。\n\n\ndef build(win, spec, slots):\n    return {}\n',"guitpl_lib/image/toolbar.jsonl":'{"kind":"meta","id":"image/toolbar","title":"圖層工具列（復原、清空）","keywords":["工具列","復原","清空","圖層"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"undo","kind":"button","text":"復原一層","icon":"↶"},{"id":"clear","kind":"button","text":"清空圖層","icon":"✖"}]}]}\n',"guitpl_lib/image/toolbar.py":'# -*- coding: utf-8 -*-\n# 圖層工具列：復原最上面一層、清空全部圖層。圖層資料在 ctx.state["layers"]，畫面重畫由主元件負責。\n\n\ndef build(win, spec, slots):\n    def undo(ctx):\n        layers = ctx.state.setdefault("layers", [])\n        if layers:\n            name = layers.pop()\n            ctx.set("status", text="已復原「%s」" % name)\n        else:\n            ctx.set("status", text="沒有可以復原的圖層")\n\n    def clear(ctx):\n        ctx.state["layers"] = []\n        ctx.set("status", text="已清空圖層")\n\n    return {"handlers": {"click:undo": undo, "click:clear": clear, "shortcut:undo": undo}}\n',"guitpl_lib/inventory/main.jsonl":'{"kind":"meta","id":"inventory/main","title":"進銷存","keywords":["進銷存","庫存","進貨","銷貨","商品"],"entry":"build","standalone":true}\n{"kind":"param","name":"shop","default":"我的小店","ask":"店名要寫什麼？"}\n{"kind":"param","name":"low","default":"5","ask":"庫存低於幾件要警示？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{shop}} 進銷存","width":780,"resizable":true,"height":600},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"edit_panel","kind":"row","grow":1,"pad":16,"gap":16,"children":[{"kind":"column","grow":1,"gap":8,"children":[{"kind":"label","text":"選商品與數量","role":"heading"},{"id":"prod_pick","kind":"list","items":["紙杯","吸管","湯匙"],"selected":"紙杯","grow":1}]},{"kind":"column","role":"card","children":[{"kind":"label","text":"數量","role":"muted"},{"id":"qty","kind":"entry","value":"1"},{"kind":"row","children":[{"id":"stock_in","kind":"button","text":"進貨","role":"primary"},{"id":"stock_out","kind":"button","text":"銷貨"},{"id":"stats_btn","kind":"button","text":"統計","role":"outline"}]},{"id":"msg","kind":"label","text":"就緒","role":"muted"}]}]},{"id":"stats_panel","kind":"column","grow":1,"pad":16,"gap":8,"children":[{"kind":"label","text":"庫存統計","role":"heading"},{"id":"stock_table","kind":"table","columns":["商品","庫存"],"rows":[["紙杯","12"],["吸管","30"],["湯匙","8"]],"grow":1},{"id":"stat_total","kind":"label","text":"共 50 件、3 種商品"},{"id":"stat_low","kind":"label","text":"低於警示門檻的商品","role":"danger"},{"id":"low_hint","kind":"label","text":"警示門檻：低於 {{low}} 件","role":"muted"},{"id":"back_btn","kind":"button","text":"回到進銷","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"inventory/toolbar","params":{"caption":"進銷"}}\n{"kind":"slot","name":"statusbar","use":"inventory/statusbar","params":{"hint":"歡迎使用 {{shop}}"}}\n{"kind":"scene","id":"edit","title":"進貨與銷貨","note":"選商品、輸入數量、按進貨或銷貨","show":["edit_panel"],"hide":["stats_panel"],"on":{"click:stats_btn":"stats","click:tb_stats":"stats"}}\n{"kind":"scene","id":"stats","title":"庫存統計","note":"顯示商品庫存表與警示","show":["stats_panel"],"hide":["edit_panel"],"on":{"click:back_btn":"edit","click:tb_form":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+I","do":"stock_in"}\n{"kind":"shortcut","keys":"Ctrl+O","do":"stock_out"}\n',"guitpl_lib/inventory/main.py":'# -*- coding: utf-8 -*-\n# 進銷存主畫面：庫存記在 ctx.state["stock"]（第一次用到才建立），統計場景打開時重新整理表格與警示。\n# 表格初始資料與 layout 裡的 stock_table 相同。\n\nPRODUCTS = [("紙杯", 12), ("吸管", 30), ("湯匙", 8)]\n\n\ndef _to_int(text, default):\n    try:\n        return int(str(text).strip())\n    except ValueError:\n        return default\n\n\ndef _stock(ctx):\n    if "stock" not in ctx.state:\n        ctx.state["stock"] = dict(PRODUCTS)\n    return ctx.state["stock"]\n\n\ndef _msg(ctx, text):\n    ctx.set("msg", text=text)\n    ctx.set("sb_text", text=text)\n\n\ndef _move(ctx, sign):\n    # sign +1 是進貨，-1 是銷貨\n    stock = _stock(ctx)\n    name = ctx.get("prod_pick")\n    qty = _to_int(ctx.get("qty"), 0)\n    if name not in stock:\n        _msg(ctx, "請先選一個商品")\n        return\n    if qty <= 0:\n        _msg(ctx, "數量要是大於 0 的整數")\n        return\n    if sign < 0 and stock[name] < qty:\n        _msg(ctx, "%s 庫存不足，只剩 %d 件" % (name, stock[name]))\n        ctx.tone(220, 200, "square")\n        return\n    stock[name] += sign * qty\n    _msg(ctx, "%s%s %d 件，現有 %d 件" % (name, "進貨" if sign > 0 else "銷貨", qty, stock[name]))\n\n\ndef build(win, spec, slots):\n    low = _to_int(spec["params"].get("low"), 5)\n\n    def show_stats(ctx):\n        stock = _stock(ctx)\n        ctx.set("stock_table", rows=[[k, str(v)] for k, v in sorted(stock.items())])\n        ctx.set("stat_total", text="共 %d 件、%d 種商品" % (sum(stock.values()), len(stock)))\n        names = [k for k, v in sorted(stock.items()) if v < low]\n        ctx.set("stat_low", text="低於 %d 件的商品：%s" % (low, "、".join(names) or "無"))\n\n    def stock_in(ctx):\n        _move(ctx, 1)\n\n    def stock_out(ctx):\n        _move(ctx, -1)\n\n    return {"handlers": {\n        "click:stock_in": stock_in,\n        "click:stock_out": stock_out,\n        "shortcut:stock_in": stock_in,\n        "shortcut:stock_out": stock_out,\n        "click:stats_btn": show_stats,\n        "click:tb_stats": show_stats,\n    }}\n',"guitpl_lib/inventory/main_dark.jsonl":'{"kind":"meta","id":"inventory/main_dark","title":"深色進銷存","keywords":["深色進銷存","夜間進銷存"],"extends":"inventory/main"}\n{"kind":"param","name":"shop","default":"夜間小店","ask":"店名要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","muted":"#6b7280"},"font":"monospace"}\n',"guitpl_lib/inventory/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色變體：只覆寫 style 與店名參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_inventory_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/inventory/main_light.jsonl":'{"kind":"meta","id":"inventory/main_light","title":"淺色進銷存","keywords":["淺色進銷存","明亮進銷存"],"extends":"inventory/main"}\n{"kind":"param","name":"shop","default":"明亮小店","ask":"店名要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#f8fafc","fg":"#0f172a","accent":"#059669"},"font":"sans-serif","radius":10}\n',"guitpl_lib/inventory/main_light.py":'# -*- coding: utf-8 -*-\n# 淺色變體：只覆寫 style 與店名參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_inventory_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/inventory/statusbar.jsonl":'{"kind":"meta","id":"inventory/statusbar","title":"狀態列","keywords":["狀態列","狀態"],"entry":"build"}\n{"kind":"param","name":"hint","default":"就緒","ask":"狀態列一開始要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"sb_text","kind":"label","text":"{{hint}}"}]}]}\n',"guitpl_lib/inventory/statusbar.py":"# -*- coding: utf-8 -*-\n# 狀態列沒有自己的行為：主畫面用 sb_text 這個名稱更新文字。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/inventory/toolbar.jsonl":'{"kind":"meta","id":"inventory/toolbar","title":"進銷存工具列","keywords":["工具列","進銷存"],"entry":"build"}\n{"kind":"param","name":"caption","default":"進銷","ask":"工具列左邊要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"kind":"label","text":"{{caption}}"},{"id":"tb_form","kind":"button","text":"進銷","icon":"▤"},{"id":"tb_stats","kind":"button","text":"統計","icon":"▥"},{"kind":"label","text":"","role":"divider"},{"id":"tb_clear","kind":"button","text":"清除訊息","icon":"✖"}]}]}\n',"guitpl_lib/inventory/toolbar.py":'# -*- coding: utf-8 -*-\n# 工具列：清除訊息只動主畫面的訊息列與狀態列（名稱由主畫面提供）。\n\n\ndef build(win, spec, slots):\n    def clear(ctx):\n        ctx.set("msg", text="")\n        ctx.set("sb_text", text="")\n\n    return {"handlers": {"click:tb_clear": clear}}\n',"guitpl_lib/media/main.jsonl":'{"kind":"meta","id":"media/main","title":"多媒體播放與編碼（簡化版）","keywords":["多媒體","影片","音訊","播放","編碼","解碼","格式"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"多媒體播放器","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"bitrate","default":"1500","ask":"預設編碼位元率要設多少 kbps？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2937","accent":"#2563eb","danger":"#dc2626","muted":"#6b7280"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":900,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"kind":"row","grow":1,"children":[{"kind":"column","role":"sidebar","children":[{"kind":"label","text":"播放清單","role":"heading"},{"id":"playlist","kind":"list","items":["片段 A（30 秒）","片段 B（45 秒）","片段 C（20 秒）"],"selected":"片段 A（30 秒）","grow":1}]},{"kind":"column","grow":1,"pad":16,"gap":12,"children":[{"id":"screen","kind":"canvas","width":240,"height":135,"fps":10,"fit":true,"grow":1},{"id":"progress","kind":"progress","value":0,"max":100},{"slot":"transport"}]}]},{"kind":"row","role":"toolbar","children":[{"kind":"label","text":"格式"},{"id":"fmt","kind":"list","items":["MP4","WebM","MP3"],"selected":"MP4"},{"kind":"label","text":"位元率 kbps"},{"id":"bitrate","kind":"entry","value":"{{bitrate}}"},{"id":"encode","kind":"button","text":"編碼","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"transport","use":"media/transport"}\n{"kind":"slot","name":"statusbar","use":"media/statusbar"}\n{"kind":"scene","id":"idle","title":"停止中","note":"按播放開始；清單可切換片段","show":["play"],"hide":["pause"],"on":{"click:play":"playing"}}\n{"kind":"scene","id":"playing","title":"播放中","note":"進度條與畫面隨時間前進","show":["pause"],"hide":["play"],"on":{"click:pause":"idle"}}\n{"kind":"shortcut","keys":"Space","do":"toggle"}\n{"kind":"shortcut","keys":"Ctrl+E","do":"encode"}\n',"guitpl_lib/media/main.py":'# -*- coding: utf-8 -*-\n# 多媒體播放與編碼（簡化版）：不真的解碼，用畫布畫出模擬的畫面，進度與時間依播放頭計算；\n# 編碼只估算輸出大小。播放、暫停、停止與切換在 transport 子元件與這裡的處理函式。\n# 畫布每秒 10 個 frame 事件，每個 frame 前進 0.1 秒。\n\nTRACKS = [("片段 A（30 秒）", 30), ("片段 B（45 秒）", 45), ("片段 C（20 秒）", 20)]\nBAR_COLORS = ["#2563eb", "#16a34a", "#dc2626"]\nFORMATS = ("MP4", "WebM", "MP3")\nSTEP = 0.1\n\n\ndef mmss(sec):\n    sec = int(sec)\n    return "%d:%02d" % (sec // 60, sec % 60)\n\n\ndef draw_screen(ctx, track, pos):\n    name, total = TRACKS[track]\n    ops = [["clear", "#111827"]]\n    for i in range(8):\n        h = 20 + (int(pos * 10) + i * 17) % 60\n        ops.append(["rect", 10 + i * 28, 135 - h - 30, 20, h, BAR_COLORS[track]])\n    ops.append(["text", 10, 10, name, "#ffffff"])\n    ops.append(["text", 10, 28, mmss(pos) + " / " + mmss(total), "#d1d5db"])\n    ctx.w.draw(ctx.id("screen"), ops)\n\n\ndef on_frame(ctx):\n    st = ctx.state\n    track = st.get("track", 0)\n    total = TRACKS[track][1]\n    if not st.get("playing") and not st.get("dirty", True):\n        return\n    if st.get("playing"):\n        st["pos"] = st.get("pos", 0.0) + STEP\n        if st["pos"] >= total:\n            st.update(playing=False, pos=float(total))\n            ctx.goto("idle")\n            ctx.set("status", text="播放完畢")\n    st["dirty"] = False\n    pos = st.get("pos", 0.0)\n    draw_screen(ctx, track, pos)\n    ctx.set("progress", value=int(pos * 100 / total))\n    ctx.set("time", text="%s / %s" % (mmss(pos), mmss(total)))\n\n\ndef select_track(ctx):\n    ctx.set("playlist", selected=TRACKS[ctx.state.get("track", 0)][0])\n\n\ndef change(ctx, step):\n    st = ctx.state\n    st["track"] = (st.get("track", 0) + step) % len(TRACKS)\n    st.update(pos=0.0, dirty=True)\n    select_track(ctx)\n    ctx.set("status", text="切換到 %s" % TRACKS[st["track"]][0])\n\n\ndef on_select(ctx):\n    names = [name for name, _ in TRACKS]\n    value = ctx.get("playlist")\n    if value in names:\n        ctx.state.update(track=names.index(value), pos=0.0, dirty=True)\n\n\ndef encode(ctx):\n    name, total = TRACKS[ctx.state.get("track", 0)]\n    try:\n        kbps = int(ctx.get("bitrate"))\n    except (TypeError, ValueError):\n        kbps = 0\n    if not 64 <= kbps <= 20000:\n        ctx.set("status", text="位元率要在 64 到 20000 kbps 之間")\n        return\n    fmt = ctx.get("fmt")\n    if fmt not in FORMATS:\n        fmt = "MP4"\n    size_kb = total * kbps / 8.0\n    ctx.set("status", text="已輸出 %s（%s，約 %d KB，模擬）" % (fmt, name, size_kb))\n\n\ndef build(win, spec, slots):\n    return {"handlers": {\n        "frame:screen": on_frame,\n        "click:prev": lambda ctx: change(ctx, -1),\n        "click:next": lambda ctx: change(ctx, 1),\n        "select:playlist": on_select,\n        "click:encode": encode,\n        "shortcut:encode": encode,\n    }}\n',"guitpl_lib/media/main_dark.jsonl":'{"kind":"meta","id":"media/main_dark","title":"深色多媒體播放器（簡化版）","keywords":["深色","夜間","播放器"],"extends":"media/main"}\n{"kind":"param","name":"title","default":"夜間播放器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#e5e7eb","accent":"#4aa3ff","danger":"#ef4444","muted":"#9ca3af"},"font":"monospace"}\n',"guitpl_lib/media/main_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 media/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_media_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/media/main_light.jsonl":'{"kind":"meta","id":"media/main_light","title":"淺色多媒體播放器（簡化版）","keywords":["淺色","明亮","播放器"],"extends":"media/main"}\n{"kind":"param","name":"title","default":"淺色播放器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#111827","accent":"#7c3aed","danger":"#e11d48","muted":"#6b7280"}}\n',"guitpl_lib/media/main_light.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 media/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_media_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/media/statusbar.jsonl":'{"kind":"meta","id":"media/statusbar","title":"狀態列（時間與訊息）","keywords":["狀態列","時間","進度","訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"time","kind":"label","text":"0:00 / 0:30"},{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/media/statusbar.py":'# -*- coding: utf-8 -*-\n# 狀態列只負責顯示；時間由主元件用名稱 "time" 寫入，訊息用 "status"。\n\n\ndef build(win, spec, slots):\n    return {}\n',"guitpl_lib/media/transport.jsonl":'{"kind":"meta","id":"media/transport","title":"播放控制列（上一首、播放、暫停、停止、下一首）","keywords":["播放","暫停","停止","上一首","下一首"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"prev","kind":"button","text":"上一首","icon":"⏮"},{"id":"play","kind":"button","text":"播放","icon":"▶","role":"primary"},{"id":"pause","kind":"button","text":"暫停","icon":"⏸"},{"id":"stop","kind":"button","text":"停止","icon":"■"},{"id":"next","kind":"button","text":"下一首","icon":"⏭"}]}]}\n',"guitpl_lib/media/transport.py":'# -*- coding: utf-8 -*-\n# 播放控制：播放、暫停、停止與空白鍵切換。只改播放狀態與場景；畫面與進度由主元件的 frame 處理負責。\n\n\ndef build(win, spec, slots):\n    def play(ctx):\n        ctx.state["playing"] = True\n        ctx.goto("playing")\n        ctx.set("status", text="播放中")\n\n    def pause(ctx):\n        ctx.state["playing"] = False\n        ctx.goto("idle")\n        ctx.set("status", text="已暫停")\n\n    def stop(ctx):\n        ctx.state.update(playing=False, pos=0.0, dirty=True)\n        ctx.goto("idle")\n        ctx.set("status", text="已停止")\n\n    def toggle(ctx):\n        if ctx.state.get("playing"):\n            pause(ctx)\n        else:\n            play(ctx)\n\n    return {"handlers": {"click:play": play, "click:pause": pause, "click:stop": stop, "shortcut:toggle": toggle}}\n',"guitpl_lib/midi/main.jsonl":'{"kind":"meta","id":"midi/main","title":"鋼琴卷簾編曲器","keywords":["MIDI","鋼琴卷簾","音符","編曲","播放"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"鋼琴卷簾","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"bpm","default":"120","ask":"速度要設幾 BPM（每分鐘拍數，20 到 300）？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":780,"resizable":true,"height":580},"tree":[{"kind":"column","role":"page","children":[{"slot":"transport"},{"kind":"column","grow":1,"pad":16,"gap":12,"children":[{"id":"roll","kind":"canvas","width":320,"height":168,"fps":20,"fit":true,"grow":2},{"id":"notes","kind":"table","columns":["音高","起拍","長度（拍）"],"rows":[["C4","0","1"],["E4","1","1"],["G4","2","1"],["C5","3","1"],["B4","4","0.5"],["A4","4.5","0.5"],["G4","5","2"]],"grow":1}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"transport","use":"midi/transport","params":{"bpm":"{{bpm}}"}}\n{"kind":"slot","name":"statusbar","use":"midi/statusbar"}\n{"kind":"scene","id":"stopped","title":"停止","note":"可以改速度、按播放","show":["play","bpm"],"hide":["stop"],"on":{"click:play":"playing"}}\n{"kind":"scene","id":"playing","title":"播放中","note":"播放頭移動、按停止結束","show":["stop"],"hide":["play","bpm"],"on":{"click:stop":"stopped"}}\n{"kind":"shortcut","keys":"Ctrl+P","do":"play"}\n{"kind":"shortcut","keys":"Esc","do":"stop"}\n',"guitpl_lib/midi/main.py":'# -*- coding: utf-8 -*-\n# 鋼琴卷簾：每個 frame 事件推進播放頭、觸發音符聲音，並重畫卷簾。播放與停止在 transport 子元件。\n\nPITCH_HI = 71\nPITCH_LO = 60\nBEATS = 8\nFPS = 20\nKEY_W = 40\nROW_H = 14\nBEAT_W = 35\nBLACK = (1, 3, 6, 8, 10)\n# (音高, 起拍, 長度)，依起拍排序\nNOTES = [(60, 0, 1), (64, 1, 1), (67, 2, 1), (72, 3, 1), (71, 4, 0.5), (69, 4.5, 0.5), (67, 5, 2)]\n\n\ndef freq(pitch):\n    return 440.0 * 2 ** ((pitch - 69) / 12.0)\n\n\ndef draw(ctx, colors, beat=None):\n    ops = [["clear", colors["bg"]]]\n    for i, p in enumerate(range(PITCH_HI, PITCH_LO - 1, -1)):\n        y = i * ROW_H\n        ops.append(["rect", 0, y, KEY_W, ROW_H, colors["fg"] if p % 12 in BLACK else colors["bg"]])\n        ops.append(["line", KEY_W, y + ROW_H, KEY_W + BEATS * BEAT_W, y + ROW_H, colors["muted"]])\n    for pitch, start, length in NOTES:\n        y = (PITCH_HI - pitch) * ROW_H\n        ops.append(["rect", int(KEY_W + start * BEAT_W), y + 1, int(length * BEAT_W) - 2, ROW_H - 2, colors["accent"]])\n    if beat is not None:\n        x = int(KEY_W + beat * BEAT_W)\n        ops.append(["line", x, 0, x, (PITCH_HI - PITCH_LO + 1) * ROW_H, colors["danger"]])\n    ctx.w.draw(ctx.id("roll"), ops)\n\n\ndef make_frame(colors):\n    def on_frame(ctx):\n        st = ctx.state\n        if st.get("playing"):\n            st["beat"] = st.get("beat", 0.0) + st["bpm"] / 60.0 / FPS\n            while st["next"] < len(NOTES) and NOTES[st["next"]][1] <= st["beat"]:\n                pitch, _start, length = NOTES[st["next"]]\n                ctx.tone(freq(pitch), int(length * 60000.0 / st["bpm"]))\n                st["next"] += 1\n            if st["beat"] >= BEATS:\n                st["playing"] = False\n                st["dirty"] = True\n                ctx.goto("stopped")\n                ctx.set("status", text="播放完畢")\n            else:\n                draw(ctx, colors, st["beat"])\n        elif st.get("dirty", True):\n            st["dirty"] = False\n            draw(ctx, colors)\n    return on_frame\n\n\ndef build(win, spec, slots):\n    pal = (spec.get("style") or {}).get("palette") or {}\n    colors = {\n        "bg": pal.get("bg", "#ffffff"), "fg": pal.get("fg", "#222222"), "accent": pal.get("accent", "#2563eb"),\n        "danger": pal.get("danger", "#dc2626"), "muted": pal.get("muted", "#9ca3af"),\n    }\n    return {"handlers": {"frame:roll": make_frame(colors)}}\n',"guitpl_lib/midi/main_dark.jsonl":'{"kind":"meta","id":"midi/main_dark","title":"深色鋼琴卷簾","keywords":["深色","夜間","鋼琴卷簾"],"extends":"midi/main"}\n{"kind":"param","name":"title","default":"夜間鋼琴卷簾","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","danger":"#ef4444","muted":"#555555"},"font":"monospace"}\n',"guitpl_lib/midi/main_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 midi/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_midi_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/midi/main_light.jsonl":'{"kind":"meta","id":"midi/main_light","title":"淺色鋼琴卷簾","keywords":["淺色","明亮","鋼琴卷簾"],"extends":"midi/main"}\n{"kind":"param","name":"title","default":"淺色鋼琴卷簾","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#111827","accent":"#7c3aed","danger":"#e11d48","muted":"#d1d5db"}}\n',"guitpl_lib/midi/main_light.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 midi/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_midi_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/midi/statusbar.jsonl":'{"kind":"meta","id":"midi/statusbar","title":"狀態列","keywords":["狀態列","狀態","訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/midi/statusbar.py":'# -*- coding: utf-8 -*-\n# 狀態列只負責顯示；其他元件用名稱 "status" 寫入訊息。\n\n\ndef build(win, spec, slots):\n    return {}\n',"guitpl_lib/midi/transport.jsonl":'{"kind":"meta","id":"midi/transport","title":"播放控制列（播放、停止、速度）","keywords":["播放","停止","速度","控制"],"entry":"build"}\n{"kind":"param","name":"bpm","default":"120","ask":"速度要設幾 BPM？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"play","kind":"button","text":"播放","icon":"▶","role":"primary"},{"id":"stop","kind":"button","text":"停止","icon":"■"},{"kind":"label","text":"速度 BPM"},{"id":"bpm","kind":"entry","value":"{{bpm}}"}]}]}\n',"guitpl_lib/midi/transport.py":'# -*- coding: utf-8 -*-\n# 播放控制：只改狀態（播放中、速度、起始拍）與場景；播放頭的推進與卷簾重畫由主元件的 frame 處理負責。\n\n\ndef build(win, spec, slots):\n    def play(ctx):\n        if ctx.state.get("playing"):\n            return\n        try:\n            bpm = float(ctx.get("bpm"))\n        except (TypeError, ValueError):\n            bpm = 120.0\n        if not 20 <= bpm <= 300:\n            bpm = 120.0\n        ctx.state.update(playing=True, beat=0.0, bpm=bpm, next=0)\n        ctx.goto("playing")\n        ctx.set("status", text="播放中（%g BPM）" % bpm)\n\n    def stop(ctx):\n        ctx.state.update(playing=False, beat=0.0, dirty=True)\n        ctx.goto("stopped")\n        ctx.set("status", text="已停止")\n\n    return {"handlers": {"click:play": play, "click:stop": stop, "shortcut:play": play, "shortcut:stop": stop}}\n',"guitpl_lib/office/main.jsonl":'{"kind":"meta","id":"office/main","title":"待辦清單","keywords":["待辦","待辦清單","todo","清單","任務"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"待辦清單","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"owner","default":"我","ask":"這份清單是誰的？（會顯示在清單最上方）"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":560,"resizable":true,"height":560},"tree":[{"kind":"column","role":"page","children":[{"id":"heading","kind":"label","text":"{{owner}} 的待辦","role":"title","pad":16},{"slot":"toolbar"},{"kind":"column","grow":1,"pad":12,"gap":8,"children":[{"id":"hint","kind":"label","text":"還沒有待辦。在上面輸入內容後按「新增」（或 Ctrl+Enter）。","role":"muted"},{"id":"tasks","kind":"editor","value":"","lang":"text","rows":12,"numbers":false,"grow":1}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"office/toolbar","params":{}}\n{"kind":"slot","name":"statusbar","use":"office/statusbar","params":{}}\n{"kind":"scene","id":"empty","title":"沒有待辦","note":"只顯示提示文字","show":["hint"],"hide":["tasks"],"on":{"click:add":"list"}}\n{"kind":"scene","id":"list","title":"有待辦","note":"顯示清單編輯區與件數","show":["tasks"],"hide":["hint"]}\n{"kind":"shortcut","keys":"Ctrl+Enter","do":"add_task"}\n{"kind":"shortcut","keys":"Ctrl+L","do":"clear_done"}\n',"guitpl_lib/office/main.py":'# -*- coding: utf-8 -*-\n# 待辦清單的主畫面：「新增」與「清除已完成」由工具列負責；這裡把它們包一層，做完之後再更新件數與場景，\n# 快捷鍵也接到同一組處理函式。\n\n\ndef build(win, spec, slots):\n    tb = slots["toolbar"]["handlers"]\n    refresh = slots["statusbar"]["refresh"]\n\n    def add(ctx):\n        tb["click:add"](ctx)\n        refresh(ctx)\n\n    def clear_done(ctx):\n        tb["click:clear_done"](ctx)\n        refresh(ctx)\n\n    return {\n        "handlers": {\n            "click:add": add,\n            "click:clear_done": clear_done,\n            "shortcut:add_task": add,\n            "shortcut:clear_done": clear_done,\n        }\n    }\n',"guitpl_lib/office/main_dark.jsonl":'{"kind":"meta","id":"office/main_dark","title":"深色待辦清單","keywords":["深色待辦","夜間待辦"],"extends":"office/main"}\n{"kind":"param","name":"title","default":"夜間待辦清單","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","danger":"#e5534b","muted":"#888888"}}\n',"guitpl_lib/office/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色待辦清單：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_office_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/office/main_warm.jsonl":'{"kind":"meta","id":"office/main_warm","title":"暖色待辦清單","keywords":["暖色待辦","護眼待辦"],"extends":"office/main"}\n{"kind":"param","name":"title","default":"暖色待辦清單","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fbf4e6","fg":"#3b2f20","accent":"#d9822b","danger":"#b91c1c","muted":"#a8946b"}}\n',"guitpl_lib/office/main_warm.py":'# -*- coding: utf-8 -*-\n# 暖色待辦清單：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_office_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/office/statusbar.jsonl":'{"kind":"meta","id":"office/statusbar","title":"待辦狀態列（件數與訊息）","keywords":["狀態列","件數","待辦件數"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"count","kind":"label","text":"0 件未完成，0 件已完成"},{"id":"msg","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/office/statusbar.py":'# -*- coding: utf-8 -*-\n# 待辦狀態列：顯示未完成與已完成件數；清單有內容時切到「有待辦」場景，清空後切回「沒有待辦」場景。\n\n\ndef counts(text):\n    lines = [ln for ln in text.split("\\n") if ln.strip()]\n    done = len([ln for ln in lines if ln.startswith("[x] ")])\n    return len(lines) - done, done\n\n\ndef refresh(ctx):\n    text = ctx.get("tasks")\n    open_n, done_n = counts(text)\n    ctx.set("count", text="%d 件未完成，%d 件已完成" % (open_n, done_n))\n    ctx.goto("list" if open_n + done_n else "empty")\n\n\ndef build(win, spec, slots):\n    return {"handlers": {"input:tasks": refresh}, "refresh": refresh}\n',"guitpl_lib/office/toolbar.jsonl":'{"kind":"meta","id":"office/toolbar","title":"待辦工具列（輸入、新增、清除已完成）","keywords":["待辦工具列","新增待辦","清除已完成"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"task","kind":"entry","value":""},{"id":"add","kind":"button","text":"新增","icon":"＋","role":"primary"},{"id":"clear_done","kind":"button","text":"清除已完成","icon":"✔"}]}]}\n',"guitpl_lib/office/toolbar.py":'# -*- coding: utf-8 -*-\n# 待辦工具列的行為。清單一行一筆：未完成是「[ ] 內容」，已完成是「[x] 內容」。\n# 件數與場景由狀態列的 refresh 更新（主畫面包住這兩個動作）。\n\n\ndef add(ctx):\n    text = ctx.get("task").strip()\n    if not text:\n        ctx.set("msg", text="請先輸入待辦內容")\n        return\n    body = ctx.get("tasks").rstrip("\\n")\n    body = (body + "\\n" if body else "") + "[ ] " + text\n    ctx.set("tasks", value=body)\n    ctx.set("task", value="")\n    ctx.set("msg", text="已新增")\n\n\ndef clear_done(ctx):\n    lines = ctx.get("tasks").split("\\n")\n    kept = [ln for ln in lines if not ln.startswith("[x] ")]\n    removed = len(lines) - len(kept)\n    ctx.set("tasks", value="\\n".join(kept).strip("\\n"))\n    ctx.set("msg", text="已清除 %d 件" % removed)\n\n\ndef build(win, spec, slots):\n    return {"handlers": {"click:add": add, "click:clear_done": clear_done}}\n',"guitpl_lib/project/main.jsonl":'{"kind":"meta","id":"project/main","title":"專案任務板（任務表與進度）","keywords":["專案","任務","進度","表格","專案管理"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"專案任務板","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"project","default":"嗨投資改版","ask":"專案名稱要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#f9fafb","fg":"#111827","accent":"#0d9488","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":900,"resizable":true,"height":640},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"column","grow":1,"pad":16,"gap":10,"children":[{"kind":"row","children":[{"id":"task_name","kind":"entry","value":""},{"id":"add_hint","kind":"label","text":"在左邊輸入新任務名稱，按「新增任務」","role":"muted"}]},{"kind":"row","children":[{"id":"pct_input","kind":"entry","value":"50"},{"id":"set_pct","kind":"button","text":"設定所選任務進度","role":"primary"}]},{"id":"task_pick","kind":"list","items":["1. 規劃需求","2. 設計畫面"],"selected":"1. 規劃需求"},{"id":"tasks","kind":"table","columns":["任務","負責人","狀態","進度(%)"],"rows":[["規劃需求","小王","進行中","40"],["設計畫面","小李","未開始","0"]],"grow":1},{"id":"overall","kind":"progress","value":20,"max":100},{"id":"overall_text","kind":"label","text":"整體進度 20%（2 項任務）"},{"id":"report_text","kind":"label","text":"","grow":1},{"id":"back","kind":"button","text":"返回任務板","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"project/toolbar","params":{}}\n{"kind":"slot","name":"statusbar","use":"project/statusbar","params":{"project":"{{project}}"}}\n{"kind":"scene","id":"board","title":"任務板","note":"任務表、所選任務的進度、整體進度","show":["task_name","add_hint","pct_input","set_pct","task_pick","tasks","overall","overall_text"],"hide":["report_text","back"],"on":{"click:report":"report","shortcut:report":"report"}}\n{"kind":"scene","id":"report","title":"進度報告","note":"只顯示文字報告","show":["report_text","back"],"hide":["task_name","add_hint","pct_input","set_pct","task_pick","tasks","overall","overall_text"],"on":{"click:back":"board"}}\n{"kind":"shortcut","keys":"Ctrl+N","do":"add"}\n{"kind":"shortcut","keys":"F6","do":"report"}\n',"guitpl_lib/project/main.py":'# -*- coding: utf-8 -*-\n# 專案任務板：任務表（任務、負責人、狀態、進度%）、選擇要操作的任務、設定進度、整體進度與文字報告。\n# 任務資料放在 G（本函式的閉包）：{"rows": [[任務, 負責人, 狀態, 進度字串]], "cur": 目前所選任務的索引}。\n# 起始資料要和 main.jsonl 的 layout（tasks、task_pick、overall）一致。\n# 表格的文字是 gui 的 table：程式改內容用 set(value=...)，這樣 value() 也跟著更新，使用者編輯走 cell 事件。\n\n\ndef _pct(text):\n    try:\n        return max(0, min(100, int(str(text).strip())))\n    except ValueError:\n        return 0\n\n\ndef _status(p):\n    return "未開始" if p == 0 else ("完成" if p == 100 else "進行中")\n\n\ndef _labels(G):\n    return ["%d. %s" % (i + 1, r[0] or "（未命名）") for i, r in enumerate(G["rows"])]\n\n\ndef _overall(G):\n    if not G["rows"]:\n        return 0\n    return sum(_pct(r[3]) for r in G["rows"]) // len(G["rows"])\n\n\ndef _sync(ctx, G):\n    rows = [list(r) for r in G["rows"]]\n    labels = _labels(G)\n    ctx.set("tasks", rows=rows)\n    ctx.set("task_pick", items=labels, selected=labels[G["cur"]] if labels else "")\n    avg = _overall(G)\n    ctx.set("overall", value=avg)\n    ctx.set("overall_text", text="整體進度 %d%%（%d 項任務）" % (avg, len(G["rows"])))\n    ctx.set("count_text", text="任務 %d 項" % len(G["rows"]))\n\n\ndef build(win, spec, slots):\n    G = {"rows": [["規劃需求", "小王", "進行中", "40"], ["設計畫面", "小李", "未開始", "0"]], "cur": 0}\n\n    def set_pct(ctx, p):\n        if not G["rows"]:\n            return\n        row = G["rows"][G["cur"]]\n        row[3] = str(p)\n        row[2] = _status(p)\n        _sync(ctx, G)\n\n    def add(ctx):\n        name = str(ctx.get("task_name") or "").strip()\n        if not name:\n            ctx.set("add_hint", text="請先輸入任務名稱")\n            return\n        G["rows"].append([name, "未指派", "未開始", "0"])\n        G["cur"] = len(G["rows"]) - 1\n        ctx.set("task_name", value="")\n        ctx.set("add_hint", text="已新增「%s」" % name)\n        _sync(ctx, G)\n\n    def done(ctx):\n        set_pct(ctx, 100)\n\n    def remove(ctx):\n        if not G["rows"]:\n            return\n        del G["rows"][G["cur"]]\n        G["cur"] = max(0, min(G["cur"], len(G["rows"]) - 1))\n        _sync(ctx, G)\n\n    def apply_pct(ctx):\n        try:\n            p = int(str(ctx.get("pct_input") or "").strip())\n        except ValueError:\n            ctx.set("add_hint", text="進度要填 0 到 100 的整數")\n            return\n        set_pct(ctx, max(0, min(100, p)))\n\n    def select(ctx):\n        try:\n            i = int(str(ctx.get("task_pick") or "").split(".")[0]) - 1\n        except ValueError:\n            return\n        if 0 <= i < len(G["rows"]):\n            G["cur"] = i\n            _sync(ctx, G)\n\n    def cell_edited(ctx):\n        # 使用者直接改表格：ctx.event["value"] 是 {"row","col","text"}\n        cell = (ctx.event or {}).get("value") or {}\n        try:\n            r, c = int(cell["row"]), int(cell["col"])\n            G["rows"][r][c] = str(cell.get("text") or "")\n        except (KeyError, IndexError, TypeError, ValueError):\n            return\n        if c == 3:\n            G["rows"][r][2] = _status(_pct(G["rows"][r][3]))\n        _sync(ctx, G)\n\n    def report(ctx):\n        lines = ["%s｜%s｜%s%%" % (r[0], r[2], _pct(r[3])) for r in G["rows"]]\n        ctx.set("report_text", text="專案進度報告：整體 %d%%\\n" % _overall(G) + "\\n".join(lines))\n\n    return {"handlers": {\n        "click:add": add,\n        "shortcut:add": add,\n        "click:done": done,\n        "click:remove": remove,\n        "click:set_pct": apply_pct,\n        "select:task_pick": select,\n        "cell:tasks": cell_edited,\n        "click:report": report,\n        "shortcut:report": report,\n    }}\n',"guitpl_lib/project/main_dark.jsonl":'{"kind":"meta","id":"project/main_dark","title":"專案任務板（深色）","keywords":["專案","任務","深色","進度"],"extends":"project/main"}\n{"kind":"param","name":"title","default":"專案任務板（深色）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#0f172a","fg":"#e2e8f0","accent":"#2dd4bf","danger":"#f87171","muted":"#64748b"}}\n',"guitpl_lib/project/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_project_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/project/main_light.jsonl":'{"kind":"meta","id":"project/main_light","title":"專案任務板（明亮）","keywords":["專案","任務","淺色","明亮","進度"],"extends":"project/main"}\n{"kind":"param","name":"title","default":"專案任務板（明亮）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#0f172a","accent":"#0f766e","danger":"#b91c1c","muted":"#94a3b8"}}\n',"guitpl_lib/project/main_light.py":'# -*- coding: utf-8 -*-\n# 明亮版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_project_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/project/statusbar.jsonl":'{"kind":"meta","id":"project/statusbar","title":"專案狀態列（專案名稱、任務數）","keywords":["狀態列","專案","任務數"],"entry":"build"}\n{"kind":"param","name":"project","default":"新專案","ask":"專案名稱要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"project_name","kind":"label","text":"{{project}}"},{"id":"count_text","kind":"label","text":"任務 2 項"}]}]}\n',"guitpl_lib/project/statusbar.py":"# -*- coding: utf-8 -*-\n# 專案狀態列只顯示：任務數由 main.py 用名稱 count_text 更新。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/project/toolbar.jsonl":'{"kind":"meta","id":"project/toolbar","title":"任務工具列（新增、標記完成、刪除、報告）","keywords":["工具列","任務","新增","報告"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"add","kind":"button","text":"新增任務","icon":"＋","role":"primary"},{"id":"done","kind":"button","text":"標記完成","icon":"✔"},{"id":"remove","kind":"button","text":"刪除所選","icon":"✖"},{"kind":"label","text":"","role":"divider"},{"id":"report","kind":"button","text":"進度報告","icon":"≣"}]}]}\n',"guitpl_lib/project/toolbar.py":"# -*- coding: utf-8 -*-\n# 任務工具列只負責按鈕：click:add、click:done、click:remove、click:report 由 main.py 處理。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/slides/main.jsonl":'{"kind":"meta","id":"slides/main","title":"投影片編輯器（清單、編輯、備忘稿）","keywords":["投影片","簡報","編輯器","備忘稿","放映"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"投影片編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"deck_name","default":"我的簡報","ask":"簡報名稱要寫什麼？"}\n{"kind":"param","name":"first_title","default":"歡迎","ask":"第一張投影片的標題要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2937","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":980,"resizable":true,"height":660},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"row","grow":1,"children":[{"id":"side","kind":"column","role":"sidebar","children":[{"kind":"label","text":"投影片","role":"heading"},{"id":"slide_list","kind":"list","items":["1. {{first_title}}"],"selected":"1. {{first_title}}","grow":1}]},{"kind":"column","grow":1,"pad":16,"gap":10,"children":[{"id":"slide_title","kind":"entry","value":"{{first_title}}"},{"id":"slide_body","kind":"editor","value":"在這裡寫投影片內容。","lang":"text","rows":8,"numbers":false,"grow":2},{"id":"present_view","kind":"label","text":"","role":"title","grow":1},{"id":"back","kind":"button","text":"返回編輯","role":"primary"}]}]},{"kind":"column","pad":12,"gap":6,"children":[{"id":"notes_label","kind":"label","text":"備忘稿（只給講者看）","role":"muted"},{"id":"speaker_notes","kind":"textarea","value":"","rows":3,"placeholder":"講者要說的話"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"slides/toolbar","params":{}}\n{"kind":"slot","name":"statusbar","use":"slides/statusbar","params":{"deck":"{{deck_name}}"}}\n{"kind":"scene","id":"edit","title":"編輯中","note":"左邊清單、中間編輯區、下方備忘稿","show":["slide_list","slide_title","slide_body","notes_label","speaker_notes","side"],"hide":["present_view","back"],"on":{"click:present":"present","shortcut:present":"present"}}\n{"kind":"scene","id":"present","title":"放映中","note":"只顯示這張投影片的標題與內容","show":["present_view","back"],"hide":["slide_list","slide_title","slide_body","notes_label","speaker_notes","side"],"on":{"click:back":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+M","do":"new"}\n{"kind":"shortcut","keys":"F5","do":"present"}\n',"guitpl_lib/slides/main.py":'# -*- coding: utf-8 -*-\n# 投影片編輯器：左邊是投影片清單，中間編輯這張的標題與內容，下方是講者備忘稿。\n# 投影片資料放在 G（本函式的閉包）：{"slides": [{"title","body","notes"}], "cur": 目前張的索引}。\n# 放映的切換在 jsonl 的場景（click:present、shortcut:present、click:back）；這裡只負責內容。\n\n\ndef _labels(G):\n    return ["%d. %s" % (i + 1, s["title"] or "（未命名）") for i, s in enumerate(G["slides"])]\n\n\ndef _refresh(ctx, G):\n    cur = G["slides"][G["cur"]]\n    labels = _labels(G)\n    ctx.set("slide_list", items=labels, selected=labels[G["cur"]])\n    ctx.set("slide_title", value=cur["title"])\n    ctx.set("slide_body", value=cur["body"])\n    ctx.set("speaker_notes", value=cur["notes"])\n    ctx.set("page_info", text="第 %d 張／共 %d 張" % (G["cur"] + 1, len(G["slides"])))\n\n\ndef build(win, spec, slots):\n    G = {"slides": [{"title": spec["params"]["first_title"], "body": "在這裡寫投影片內容。", "notes": ""}], "cur": 0}\n\n    def cur():\n        return G["slides"][G["cur"]]\n\n    def add(ctx):\n        G["slides"].append({"title": "新投影片 %d" % (len(G["slides"]) + 1), "body": "", "notes": ""})\n        G["cur"] = len(G["slides"]) - 1\n        _refresh(ctx, G)\n\n    def delete(ctx):\n        if len(G["slides"]) <= 1:\n            ctx.set("page_info", text="至少要留一張投影片")\n            return\n        del G["slides"][G["cur"]]\n        G["cur"] = min(G["cur"], len(G["slides"]) - 1)\n        _refresh(ctx, G)\n\n    def present(ctx):\n        s = cur()\n        ctx.set("present_view", text="【%s】\\n%s" % (s["title"], s["body"]))\n\n    def back(ctx):\n        _refresh(ctx, G)\n\n    def select(ctx):\n        # 清單的文字是「次序. 標題」，前面的次序就是索引\n        try:\n            i = int(str(ctx.get("slide_list") or "").split(".")[0]) - 1\n        except ValueError:\n            return\n        if 0 <= i < len(G["slides"]) and i != G["cur"]:\n            G["cur"] = i\n            _refresh(ctx, G)\n\n    def typed_title(ctx):\n        cur()["title"] = str(ctx.get("slide_title") or "")\n        labels = _labels(G)\n        ctx.set("slide_list", items=labels, selected=labels[G["cur"]])\n\n    def typed_body(ctx):\n        cur()["body"] = str(ctx.get("slide_body") or "")\n\n    def typed_notes(ctx):\n        cur()["notes"] = str(ctx.get("speaker_notes") or "")\n\n    return {"handlers": {\n        "click:add": add,\n        "shortcut:new": add,\n        "click:del": delete,\n        "click:present": present,\n        "shortcut:present": present,\n        "click:back": back,\n        "select:slide_list": select,\n        "input:slide_title": typed_title,\n        "input:slide_body": typed_body,\n        "input:speaker_notes": typed_notes,\n    }}\n',"guitpl_lib/slides/main_dark.jsonl":'{"kind":"meta","id":"slides/main_dark","title":"投影片編輯器（深色）","keywords":["投影片","簡報","深色","編輯器"],"extends":"slides/main"}\n{"kind":"param","name":"title","default":"投影片編輯器（深色）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1f2937","fg":"#f3f4f6","accent":"#60a5fa","danger":"#f87171","muted":"#6b7280"}}\n',"guitpl_lib/slides/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_slides_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/slides/main_light.jsonl":'{"kind":"meta","id":"slides/main_light","title":"投影片編輯器（明亮）","keywords":["投影片","簡報","淺色","明亮","編輯器"],"extends":"slides/main"}\n{"kind":"param","name":"title","default":"投影片編輯器（明亮）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#1c1917","accent":"#7c3aed","danger":"#dc2626","muted":"#a8a29e"}}\n',"guitpl_lib/slides/main_light.py":'# -*- coding: utf-8 -*-\n# 明亮版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_slides_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/slides/statusbar.jsonl":'{"kind":"meta","id":"slides/statusbar","title":"投影片狀態列（簡報名稱、頁碼）","keywords":["狀態列","投影片","頁碼","簡報名稱"],"entry":"build"}\n{"kind":"param","name":"deck","default":"我的簡報","ask":"簡報名稱要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"deck_name","kind":"label","text":"{{deck}}"},{"id":"page_info","kind":"label","text":"第 1 張／共 1 張"}]}]}\n',"guitpl_lib/slides/statusbar.py":"# -*- coding: utf-8 -*-\n# 投影片狀態列只顯示：頁碼由 main.py 用名稱 page_info 更新。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/slides/toolbar.jsonl":'{"kind":"meta","id":"slides/toolbar","title":"投影片工具列（新增、刪除、放映）","keywords":["工具列","投影片","新增","放映"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"add","kind":"button","text":"新增投影片","icon":"＋","role":"primary"},{"id":"del","kind":"button","text":"刪除投影片","icon":"✖"},{"kind":"label","text":"","role":"divider"},{"id":"present","kind":"button","text":"放映","icon":"▶"}]}]}\n',"guitpl_lib/slides/toolbar.py":"# -*- coding: utf-8 -*-\n# 投影片工具列只負責按鈕：click:add、click:del、click:present 由 main.py 與場景處理。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/text-editor/main.jsonl":'{"kind":"meta","id":"text-editor/main","title":"文字編輯器（上方工具列、中間編輯區、下方狀態列）","keywords":["文字編輯","編輯器","記事本","筆記","日記","notepad","editor"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"文字編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"sound","default":"no","ask":"存檔與新增要有提示音嗎？（yes 或 no）"}\n{"kind":"param","name":"lang","default":"python","ask":"文字要用哪種語法上色？（text 不上色，或 python、javascript、json、markdown、html、css）"}\n{"kind":"param","name":"content","default":"# 範例：整理購物清單\\nimport json\\nfrom datetime import date\\n\\n\\nclass Item:\\n    \\"\\"\\"一項商品：名稱、單價、數量。\\"\\"\\"\\n\\n    def __init__(self, name, price, qty=1):\\n        self.name = name\\n        self.price = price\\n        self.qty = qty\\n\\n    def total(self):\\n        return self.price * self.qty\\n\\n\\ndef load(path):\\n    with open(path, encoding=\\"utf-8\\") as f:\\n        data = json.load(f)\\n    return [Item(**row) for row in data[\\"items\\"]]\\n\\n\\ndef summary(items):\\n    lines = []\\n    for i, item in enumerate(items, start=1):\\n        lines.append(f\\"{i:>2}. {item.name:<8} {item.qty} x {item.price} = {item.total()}\\")\\n    total = sum(item.total() for item in items)\\n    lines.append(\\"-\\" * 32)\\n    lines.append(f\\"合計 {total} 元（{date.today()}）\\")\\n    return \\"\\\\n\\".join(lines)\\n\\n\\nif __name__ == \\"__main__\\":\\n    items = [Item(\\"紙杯\\", 3, 50), Item(\\"吸管\\", 1, 100), Item(\\"湯匙\\", 2, 30)]\\n    print(summary(items))\\n    for n in range(3):\\n        if n % 2 == 0:\\n            print(\\"偶數\\", n)\\n        else:\\n            print(\\"奇數\\", n, None, True)\\n","ask":"編輯器一開始要放什麼內容？（預設是一段 Python 範例，可以清空）"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":900,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"editor","kind":"editor","value":"{{content}}","lang":"{{lang}}","rows":16,"grow":1},{"id":"saved_tip","kind":"label","text":"已存檔","role":"muted","pad":6},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"text-editor/toolbar","params":{"sound":"{{sound}}","lang":"{{lang}}"}}\n{"kind":"slot","name":"statusbar","use":"text-editor/statusbar","params":{}}\n{"kind":"scene","id":"edit","title":"編輯中","note":"工具列、編輯區、狀態列；存檔後切到「存檔後」","show":["editor"],"hide":["saved_tip"],"on":{"click:save":"saved"}}\n{"kind":"scene","id":"saved","title":"存檔後","note":"顯示「已存檔」；再輸入文字就切回編輯中","show":["saved_tip"],"hide":[],"on":{"input:editor":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+S","do":"save_file"}\n{"kind":"shortcut","keys":"Ctrl+N","do":"new_file"}\n',"guitpl_lib/text-editor/main.py":'# -*- coding: utf-8 -*-\n# 文字編輯器的主畫面：存檔與新增由工具列負責，字數由狀態列負責；這裡只把快捷鍵接到工具列的同一組處理函式\n# （Ctrl+S 與存檔按鈕、Ctrl+N 與新增按鈕，行為完全一樣）。\n\n\ndef build(win, spec, slots):\n    tb = slots["toolbar"]["handlers"]\n    return {\n        "handlers": {\n            "shortcut:save_file": tb["click:save"],\n            "shortcut:new_file": tb["click:new"],\n        }\n    }\n',"guitpl_lib/text-editor/main_contrast.jsonl":'{"kind":"meta","id":"text-editor/main_contrast","title":"高對比文字編輯器（黑底、黃色重點）","keywords":["高對比","弱視","高對比編輯器"],"extends":"text-editor/main"}\n{"kind":"param","name":"title","default":"高對比文字編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#000000","fg":"#ffffff","accent":"#ffd400","danger":"#ff5c5c","muted":"#bbbbbb"}}\n',"guitpl_lib/text-editor/main_contrast.py":'# -*- coding: utf-8 -*-\n# 高對比文字編輯器：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_text_editor_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/text-editor/main_dark.jsonl":'{"kind":"meta","id":"text-editor/main_dark","title":"深色文字編輯器（深灰底、亮藍重點）","keywords":["深色編輯器","夜間編輯","深色記事本"],"extends":"text-editor/main"}\n{"kind":"param","name":"title","default":"夜間文字編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","danger":"#e5534b","muted":"#888888"}}\n',"guitpl_lib/text-editor/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色文字編輯器：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_text_editor_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/text-editor/main_warm.jsonl":'{"kind":"meta","id":"text-editor/main_warm","title":"暖色文字編輯器（米色底、橘色重點）","keywords":["暖色編輯器","護眼編輯","米色記事本"],"extends":"text-editor/main"}\n{"kind":"param","name":"title","default":"暖色文字編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fbf4e6","fg":"#3b2f20","accent":"#d9822b","danger":"#b91c1c","muted":"#a8946b"}}\n',"guitpl_lib/text-editor/main_warm.py":'# -*- coding: utf-8 -*-\n# 暖色文字編輯器：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_text_editor_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/text-editor/statusbar.jsonl":'{"kind":"meta","id":"text-editor/statusbar","title":"文字編輯狀態列（字數與訊息）","keywords":["文字編輯狀態列","字數"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/text-editor/statusbar.py":'# -*- coding: utf-8 -*-\n# 文字編輯狀態列：內容一改動就顯示行數與字數。\n\n\ndef count_words(ctx):\n    text = ctx.get("editor")\n    ctx.set("status", text="%d 行，%d 字" % (text.count("\\n") + 1, len(text)))\n\n\ndef build(win, spec, slots):\n    return {"handlers": {"input:editor": count_words}}\n',"guitpl_lib/text-editor/toolbar.jsonl":'{"kind":"meta","id":"text-editor/toolbar","title":"文字編輯工具列（新增、存檔、語法、自動換行）","keywords":["文字編輯工具列","新增","存檔","語法上色","自動換行"],"entry":"build"}\n{"kind":"param","name":"sound","default":"no","ask":"提示音要開嗎？（yes 或 no）"}\n{"kind":"param","name":"lang","default":"text","ask":"程式碼語法要上色嗎？（text 不上色，或 python、javascript、json、markdown、html、css）"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"new","kind":"button","text":"新增","icon":"＋"},{"id":"save","kind":"button","text":"存檔","icon":"⬇","role":"primary"},{"kind":"label","text":"","role":"divider"},{"id":"lang_btn","kind":"button","text":"語法：純文字","icon":"</>","role":"outline"},{"id":"wrap","kind":"checkbox","text":"自動換行","checked":false}]}]}\n',"guitpl_lib/text-editor/toolbar.py":'# -*- coding: utf-8 -*-\n# 文字編輯工具列的行為：新增、存檔，以及「語法」按鈕（每按一次換下一種語法上色，文字不會丟）。\n# 提示音由參數 sound 決定（yes 才響）；起始語法由參數 lang 決定。\n\nLANGS = [("text", "純文字"), ("python", "Python"), ("javascript", "JavaScript"), ("json", "JSON"),\n         ("markdown", "Markdown"), ("html", "HTML"), ("css", "CSS")]\n\n\ndef lang_label(code):\n    for c, label in LANGS:\n        if c == code:\n            return label\n    return "純文字"\n\n\ndef save_file(ctx, sound):\n    ctx.state["saved"] = ctx.state.get("saved", 0) + 1\n    text = ctx.get("editor")\n    ctx.set("status", text="已存 %d 次，%d 字" % (ctx.state["saved"], len(text)))\n    if sound:\n        ctx.tone(880, 90, "sine")\n\n\ndef new_file(ctx, sound):\n    ctx.set("editor", value="")\n    ctx.set("status", text="新文件")\n    if sound:\n        ctx.tone(220, 60, "square")\n\n\ndef next_lang(ctx):\n    codes = [c for c, _ in LANGS]\n    now = ctx.state.get("lang", "text")\n    nxt = codes[(codes.index(now) + 1) % len(codes)] if now in codes else codes[0]\n    ctx.state["lang"] = nxt\n    ctx.set("editor", lang=nxt)  # 版面重畫，輸入的文字會保留\n    ctx.set("lang_btn", text="語法：" + lang_label(nxt))\n    ctx.set("status", text="語法：" + lang_label(nxt))\n\n\ndef toggle_wrap(ctx):\n    on = bool(ctx.get("wrap"))\n    ctx.set("editor", wrap=on)  # 版面重畫，輸入的文字會保留\n    ctx.set("status", text="自動換行：" + ("開" if on else "關"))\n\n\ndef build(win, spec, slots):\n    sound = spec["params"].get("sound") == "yes"\n    start_lang = spec["params"].get("lang") or "text"\n\n    def start(ctx):\n        ctx.state["lang"] = start_lang\n        ctx.set("lang_btn", text="語法：" + lang_label(start_lang))\n\n    return {\n        "handlers": {\n            "start": start,\n            "click:save": lambda ctx: save_file(ctx, sound),\n            "click:new": lambda ctx: new_file(ctx, sound),\n            "click:lang_btn": next_lang,\n            "change:wrap": toggle_wrap,\n        }\n    }\n',"guitpl_lib/web-design/main.jsonl":'{"kind":"meta","id":"web-design/main","title":"網頁版面設計器","keywords":["網頁","設計","HTML","版面","元件"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"網頁設計","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"page_title","default":"我的網頁","ask":"匯出的網頁標題要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2937","accent":"#2563eb","danger":"#dc2626","muted":"#6b7280"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":1000,"resizable":true,"height":680},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"main_row","kind":"row","grow":1,"children":[{"id":"left","kind":"column","role":"sidebar","children":[{"kind":"label","text":"元件","role":"heading"},{"id":"comp_list","kind":"list","items":[],"grow":1},{"id":"apply","kind":"button","text":"套用屬性","role":"primary"}]},{"id":"right","kind":"column","grow":1,"pad":16,"gap":10,"children":[{"id":"preview","kind":"canvas","width":320,"height":200,"fit":true,"grow":1},{"id":"attr_text","kind":"entry","value":""},{"id":"attr_color","kind":"entry","value":""}]}]},{"kind":"row","pad":8,"children":[{"id":"to_code","kind":"button","text":"看 HTML 程式碼"},{"id":"to_visual","kind":"button","text":"回到設計"}]},{"id":"code","kind":"editor","value":"","lang":"html","rows":12,"grow":1},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"web-design/toolbar","params":{"page_title":"{{page_title}}"}}\n{"kind":"slot","name":"statusbar","use":"web-design/statusbar"}\n{"kind":"scene","id":"visual","title":"設計","note":"元件列表、預覽與屬性","show":["left","right","to_code","main_row"],"hide":["code","to_visual"],"on":{"click:to_code":"code"}}\n{"kind":"scene","id":"code","title":"程式碼","note":"匯出後的 HTML，可以直接改","show":["code","to_visual"],"hide":["left","right","to_code","main_row"],"on":{"click:to_visual":"visual"}}\n{"kind":"shortcut","keys":"Ctrl+N","do":"add"}\n{"kind":"shortcut","keys":"Delete","do":"remove"}\n',"guitpl_lib/web-design/main.py":'# -*- coding: utf-8 -*-\n# 網頁版面設計器主元件：預覽畫布、屬性編輯與選取。工具列的新增／刪除／匯出由子元件處理，\n# 這裡包住它們的處理函式，每次動作後重畫預覽與元件清單。\n\nTYPE_H = 40\n\n\ndef valid_color(s):\n    if not isinstance(s, str) or len(s) != 7 or s[0] != "#":\n        return False\n    return all(ch in "0123456789abcdefABCDEF" for ch in s[1:])\n\n\ndef labels(cs):\n    return ["%d. %s：%s" % (i + 1, c["type"], c["text"]) for i, c in enumerate(cs)]\n\n\ndef draw(ctx, colors):\n    cs = ctx.state.get("comps", [])\n    sel = ctx.state.get("sel")\n    ops = [["clear", colors["bg"]]]\n    if not cs:\n        ops.append(["text", 10, 12, "尚無元件：從工具列新增", colors["fg"]])\n    for i, c in enumerate(cs[:6]):\n        y = i * TYPE_H + 4\n        custom = c.get("color") if valid_color(c.get("color")) else None\n        if c["type"] == "按鈕":\n            ops.append(["rect", 10, y, 140, 28, custom or colors["accent"]])\n            ops.append(["text", 20, y + 8, c["text"], colors["bg"]])\n        else:\n            ops.append(["text", 10, y + 8, c["text"], custom or colors["fg"]])\n        if i == sel:\n            ops.append(["line", 0, y + TYPE_H - 4, 320, y + TYPE_H - 4, colors["danger"]])\n    ctx.w.draw(ctx.id("preview"), ops)\n    ctx.set("comp_list", items=labels(cs))\n\n\ndef make(colors, toolbar):\n    def redraw_after(fn):\n        def handler(ctx):\n            fn(ctx)\n            draw(ctx, colors)\n        return handler\n\n    def on_select(ctx):\n        cs = ctx.state.get("comps", [])\n        try:\n            i = int(str(ctx.get("comp_list")).split(".")[0]) - 1\n        except ValueError:\n            i = None\n        ctx.state["sel"] = i if i is not None and 0 <= i < len(cs) else None\n        if ctx.state["sel"] is not None:\n            c = cs[ctx.state["sel"]]\n            ctx.set("attr_text", value=c["text"])\n            ctx.set("attr_color", value=c.get("color", ""))\n        draw(ctx, colors)\n\n    def apply(ctx):\n        cs = ctx.state.get("comps", [])\n        i = ctx.state.get("sel")\n        if i is None or i >= len(cs):\n            ctx.set("status", text="請先在清單選一個元件")\n            return\n        text = ctx.get("attr_text")\n        if text:\n            cs[i]["text"] = str(text)[:40]\n        col = ctx.get("attr_color") or ""\n        if col and not valid_color(col):\n            ctx.set("status", text="顏色格式錯誤，要像 #2563eb")\n            return\n        cs[i]["color"] = col\n        draw(ctx, colors)\n        ctx.set("status", text="已套用到第 %d 個元件" % (i + 1))\n\n    handlers = {key: redraw_after(fn) for key, fn in toolbar.items()}\n    handlers["select:comp_list"] = on_select\n    handlers["click:apply"] = apply\n    handlers["start"] = lambda ctx: draw(ctx, colors)\n    return handlers\n\n\ndef build(win, spec, slots):\n    pal = (spec.get("style") or {}).get("palette") or {}\n    colors = {\n        "bg": pal.get("bg", "#ffffff"), "fg": pal.get("fg", "#1f2937"), "accent": pal.get("accent", "#2563eb"),\n        "danger": pal.get("danger", "#dc2626"), "muted": pal.get("muted", "#6b7280"),\n    }\n    return {"handlers": make(colors, slots["toolbar"]["handlers"])}\n',"guitpl_lib/web-design/main_dark.jsonl":'{"kind":"meta","id":"web-design/main_dark","title":"深色網頁設計器","keywords":["深色","夜間","網頁設計"],"extends":"web-design/main"}\n{"kind":"param","name":"title","default":"夜間網頁設計","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#e5e7eb","accent":"#4aa3ff","danger":"#ef4444","muted":"#9ca3af"},"font":"monospace"}\n',"guitpl_lib/web-design/main_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 web-design/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_web_design_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/web-design/main_light.jsonl":'{"kind":"meta","id":"web-design/main_light","title":"淺色網頁設計器","keywords":["淺色","明亮","網頁設計"],"extends":"web-design/main"}\n{"kind":"param","name":"title","default":"淺色網頁設計","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#111827","accent":"#7c3aed","danger":"#e11d48","muted":"#6b7280"}}\n',"guitpl_lib/web-design/main_light.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 web-design/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_web_design_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/web-design/statusbar.jsonl":'{"kind":"meta","id":"web-design/statusbar","title":"狀態列","keywords":["狀態列","狀態","訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/web-design/statusbar.py":'# -*- coding: utf-8 -*-\n# 狀態列只負責顯示；其他元件用名稱 "status" 寫入訊息。\n\n\ndef build(win, spec, slots):\n    return {}\n',"guitpl_lib/web-design/toolbar.jsonl":'{"kind":"meta","id":"web-design/toolbar","title":"元件工具列（新增、刪除、匯出）","keywords":["工具列","新增","刪除","匯出"],"entry":"build"}\n{"kind":"param","name":"page_title","default":"我的網頁","ask":"匯出的網頁標題要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"require","module":"html","source":"builtin"}\n{"kind":"require","module":"re","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"add","kind":"button","text":"新增元件","icon":"＋","role":"primary"},{"id":"remove","kind":"button","text":"刪除","icon":"✖"},{"kind":"label","text":"","role":"divider"},{"id":"export","kind":"button","text":"匯出 HTML","icon":"⇪"}]}]}\n',"guitpl_lib/web-design/toolbar.py":'# -*- coding: utf-8 -*-\n# 元件工具列：新增、刪除、匯出。元件資料放在 ctx.state["comps"]；畫面重畫由主元件包住這些處理函式負責。\nimport html\nimport re\n\nTYPES = ["標題", "段落", "按鈕"]\nHEX = re.compile(r"^#[0-9a-fA-F]{6}$")\n\n\ndef to_html(title, comps):\n    parts = []\n    for c in comps:\n        color = c.get("color") or ""\n        style = \' style="color:%s"\' % color if HEX.match(color) else ""\n        text = html.escape(c["text"], quote=True)\n        if c["type"] == "標題":\n            parts.append("<h1%s>%s</h1>" % (style, text))\n        elif c["type"] == "段落":\n            parts.append("<p%s>%s</p>" % (style, text))\n        else:\n            parts.append("<button%s>%s</button>" % (style, text))\n    return (\'<!doctype html>\\n<html lang="zh-Hant">\\n<head>\\n<meta charset="utf-8">\\n<title>%s</title>\\n</head>\\n\'\n            \'<body>\\n%s\\n</body>\\n</html>\\n\' % (html.escape(title, quote=True), "\\n".join(parts)))\n\n\ndef build(win, spec, slots):\n    def comps_of(ctx):\n        return ctx.state.setdefault("comps", [])\n\n    def add(ctx):\n        cs = comps_of(ctx)\n        n = len(cs) + 1\n        kind = TYPES[(n - 1) % len(TYPES)]\n        cs.append({"type": kind, "text": "%s %d" % (kind, n), "color": ""})\n        ctx.state["sel"] = len(cs) - 1\n        ctx.set("status", text="已新增「%s」，共 %d 個元件" % (kind, len(cs)))\n\n    def remove(ctx):\n        cs = comps_of(ctx)\n        i = ctx.state.get("sel")\n        if isinstance(i, int) and 0 <= i < len(cs):\n            del cs[i]\n            ctx.state["sel"] = None\n            ctx.set("status", text="已刪除，剩 %d 個元件" % len(cs))\n        else:\n            ctx.set("status", text="請先在清單選一個元件")\n\n    def export(ctx):\n        ctx.set("code", value=to_html(spec["params"]["page_title"], comps_of(ctx)))\n        ctx.goto("code")\n        ctx.set("status", text="已匯出 %d 個元件的 HTML" % len(comps_of(ctx)))\n\n    return {"handlers": {"click:add": add, "click:remove": remove, "click:export": export,\n                         "shortcut:add": add, "shortcut:remove": remove}}\n'},FA_GUI_BRIDGE_SRC="// GUI bridge core (pure, no DOM): the wire protocol between a skill program (shell, JavaScript, Python, later SDL / GTK# / XAML / QML hosts)\n// and the window the AI Chat page draws for it. The program never touches the DOM: it writes one JSON message per line, prefixed \"@gui \",\n// and the page validates each message and keeps a small widget tree per window. The DOM renderer (ai_chat_gui_render.js, a later batch) only\n// reads this tree, so every rule that matters for safety (kinds, props, sizes, ids, text-only values) is enforced here and is testable in node.\n//\n//   program -> page   @gui {\"v\":1,\"op\":\"open\",\"id\":\"w1\",\"title\":\"Hello\",\"width\":420}\n//                     @gui {\"v\":1,\"op\":\"add\",\"id\":\"w1\",\"parent\":\"root\",\"node\":{\"id\":\"b1\",\"kind\":\"button\",\"text\":\"OK\"}}\n//                     @gui {\"v\":1,\"op\":\"set\",\"id\":\"w1\",\"node\":\"b1\",\"props\":{\"text\":\"Done\"}}\n//                     @gui {\"v\":1,\"op\":\"remove\",\"id\":\"w1\",\"node\":\"b1\"}   /  {\"v\":1,\"op\":\"close\",\"id\":\"w1\"}\n//   page -> program   {\"v\":1,\"event\":\"click\",\"id\":\"w1\",\"node\":\"b1\"}, {\"v\":1,\"event\":\"input\",\"id\":\"w1\",\"node\":\"e1\",\"value\":\"...\"}\n//                     (event \"close\" when the user closes the window; \"select\" for list, \"change\" for checkbox)\n//\n//                     @gui {\"v\":1,\"op\":\"draw\",\"id\":\"w1\",\"node\":\"c1\",\"ops\":[[\"clear\",\"#000\"],[\"rect\",10,10,20,4,\"#0f0\"]]}\n//                     (a draw replaces the whole frame of a canvas; a canvas answers \"key\" and \"frame\" events)\n//                     @gui {\"v\":1,\"op\":\"image\",\"id\":\"w1\",\"node\":\"c1\",\"name\":\"ship\",\"data\":\"data:image/png;base64,...\"}\n//                     (a picture is registered once per canvas; a frame draws it by name: [\"image\",\"ship\",x,y,w,h]. data null removes it.\n//                      Only the Python / JavaScript route sends pictures: the program-output route refuses them, since its lines are short.)\n//\n// Kinds: column, row, expander (containers, children added with parent), label, button, entry, textarea, editor, checkbox, progress, list, multilist, table, canvas.\n// Values are always plain text: no HTML and no script ever reaches the page through this protocol.\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatGuiBridge = factory(); }\n}(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n  var VERSION = 1, PREFIX = '@gui ';\n  var MAX_LINE = 8192, MAX_WINDOWS = 4, MAX_NODES = 200, MAX_TEXT = 2000, MAX_ITEMS = 500, MAX_DEPTH = 8;\n  var ID_RE = /^[A-Za-z0-9_-]{1,40}$/;\n  var OPS = ['open', 'add', 'set', 'remove', 'close', 'draw', 'image', 'theme', 'shortcut', 'tone'];\n  // window-level look: palette (five named colors), font family, size, corner radius; shortcuts: \"Ctrl+Shift+Alt+<key>\" -> a name the\n  // program gets back as a \"shortcut\" event; tone: a short beep played by the page (nothing is stored)\n  var PALETTE_KEYS = ['bg', 'fg', 'accent', 'danger', 'muted'];\n  var FONTS = ['sans-serif', 'serif', 'monospace'];\n  var WAVES = ['sine', 'square', 'triangle', 'sawtooth'];\n  var SHORTCUT_RE = /^(Ctrl\\+)?(Shift\\+)?(Alt\\+)?([A-Z0-9]|F([1-9]|1[0-2])|Enter|Esc|Space|Up|Down|Left|Right|Delete|Backspace|Tab)$/;\n  var MAX_SHORTCUTS = 40;\n  var CONTAINERS = ['column', 'row', 'expander', 'grid', 'scroll', 'tabs', 'tab', 'split', 'menubar', 'menu'];\n  // where a kind may be added: tab pages only inside tabs (and tabs hold only tab pages); menus only in a menubar, menu items only in a menu\n  var PARENT_OF = { tab: 'tabs', menu: 'menubar', menuitem: 'menu' };\n  var ONLY_CHILDREN = { tabs: ['tab'], menubar: ['menu'], menu: ['menuitem'] };\n  var MAX_COLUMNS = 30, MAX_DRAW = 200, MAX_CANVAS = 1200, MAX_FPS = 60;\n  var MAX_IMAGES = 16, MAX_IMAGE_BYTES = 256 * 1024;\n  var COLOR_RE = /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/;\n  var IMAGE_RE = /^data:image\\/(png|jpeg|gif|webp);base64,([A-Za-z0-9+/]+={0,2})$/;\n  // a draw command and its length (name included): every command ends with its color, except clear, which is only the color\n  var DRAW_LENGTH = { clear: 2, rect: 6, circle: 5, line: 6, text: 5 };\n  var KINDS = {\n    column: { props: [] },\n    row: { props: [] },\n    expander: { props: ['text', 'expanded'], events: ['toggle'] },\n    // grid: children fill a table of `columns` equal columns, row by row; scroll: a column at most `height` pixels high that scrolls\n    grid: { props: ['columns'] },\n    scroll: { props: ['height'] },\n    // tabs: its children are tab pages (kind tab, text = the title); selected is the page's node id (the first page when empty); the user's click comes\n    // back as select with the page id. split: two or more children side by side (direction row) or stacked (column), the first one ratio percent wide.\n    // menubar > menu (text) > menuitem (text, keys = the shortcut hint shown beside it, e.g. Ctrl+S; click event)\n    tabs: { props: ['selected'], events: ['select'] },\n    tab: { props: ['text'] },\n    split: { props: ['direction', 'ratio'] },\n    menubar: { props: [] },\n    menu: { props: ['text'] },\n    menuitem: { props: ['text', 'keys', 'enabled'], events: ['click'] },\n    label: { props: ['text'] },\n    // button icon: a short symbol or emoji shown before the text (the toolbar look: icon plus text)\n    button: { props: ['text', 'enabled', 'icon'], events: ['click'] },\n    entry: { props: ['value', 'placeholder', 'enabled', 'secret'], events: ['input'] },\n    textarea: { props: ['value', 'placeholder', 'rows', 'enabled'], events: ['input'] },\n    // editor: a code or text editing surface with line numbers (numbers), syntax colors for lang (python, javascript, json, markdown, html, css; anything else is plain), scrollbars\n    // prose: a proportional reading font and roomier lines (documents); caret / caret_to (set only, not stored): move the caret (and select to caret_to)\n    // and focus the editor; the user's caret and selection come back as the \"caret\" event {start, end} (character offsets)\n    // wrap: long lines wrap at the editor's width (no line numbers then); markdown: a read-only view of Markdown text drawn with real headings, bold, lists, quotes and code\n    editor: { props: ['value', 'lang', 'rows', 'enabled', 'numbers', 'prose', 'wrap'], events: ['input', 'caret'] },\n    markdown: { props: ['value'] },\n    checkbox: { props: ['text', 'checked', 'enabled'], events: ['change'] },\n    progress: { props: ['value', 'max'] },\n    list: { props: ['items', 'selected', 'enabled'], events: ['select'] },\n    multilist: { props: ['items', 'selected', 'enabled'], events: ['select'] },\n    table: { props: ['columns', 'rows', 'enabled'], events: ['cell'] },\n    // a canvas is drawn by whole frames (op \"draw\" replaces the frame); fps > 0 makes the page send \"frame\" events, key presses come as \"key\",\n    // the pointer as \"mouse\" ({kind: down | up | move, x, y, button} with x and y inside the canvas), the wheel as \"wheel\" ({x, y, dy}),\n    // and \"resize\" ({width, height}: the canvas's new size in pixels when its window is resized or maximized)\n    // fit: the canvas keeps its width x height as the drawing space and is scaled (centered, whole picture visible) to fill the area it is given (grow)\n    canvas: { props: ['width', 'height', 'fps', 'fit'], events: ['key', 'frame', 'mouse', 'wheel', 'resize'] }\n  };\n  // layout and look hints every node may carry: grow = share of the free space in its parent (0 none, 1-10 weight; a row grows sideways,\n  // a column downwards), gap = space between its children and pad = inner space (pixels), role = a named look from the design system\n  var ROLES = ['toolbar', 'sidebar', 'statusbar', 'card', 'panel', 'heading', 'title', 'muted', 'primary', 'danger', 'surface', 'group', 'divider', 'outline', 'page'];\n  var COMMON = ['visible', 'grow', 'gap', 'pad', 'role'];\n\n  function fail(error) { return { ok: false, error: error }; }\n  function isObj(v) { return v !== null && typeof v === 'object' && !Array.isArray(v); }\n  function text(v, field) {\n    if (typeof v !== 'string') { throw new Error(field + ' must be a string'); }\n    if (v.length > MAX_TEXT) { throw new Error(field + ' is longer than ' + MAX_TEXT + ' characters'); }\n    return v;\n  }\n  function id(v, field) {\n    if (typeof v !== 'string' || !ID_RE.test(v)) { throw new Error(field + ' must be 1-40 letters, digits, _ or -'); }\n    return v;\n  }\n  function num(v, field, lo, hi) {\n    if (typeof v !== 'number' || !isFinite(v) || v < lo || v > hi) { throw new Error(field + ' must be a number from ' + lo + ' to ' + hi); }\n    return v;\n  }\n  function bool(v, field) { if (typeof v !== 'boolean') { throw new Error(field + ' must be true or false'); } return v; }\n\n  // one prop, checked by its name; the same rules serve add (node props) and set\n  function prop(kind, name, v) {\n    switch (name) {\n      case 'text': case 'value': case 'placeholder': case 'lang': case 'keys': return text(v, name);\n      case 'icon': if (typeof v !== 'string' || v.length > 8) { throw new Error('icon must be a short text (a symbol or emoji, at most 8 characters)'); } return v;\n      case 'enabled': case 'checked': case 'visible': case 'secret': case 'expanded': case 'numbers': case 'fit': case 'prose': case 'wrap': return bool(v, name);\n      case 'rows': return num(v, name, 1, 30);\n      case 'grow': return num(v, name, 0, 10);\n      case 'gap': case 'pad': return num(v, name, 0, 32);\n      case 'role': if (ROLES.indexOf(v) < 0) { throw new Error('role must be one of ' + ROLES.join(', ')); } return v;\n      case 'max': return num(v, name, 0, 1e12);\n      case 'selected': return text(v, name);\n      case 'items':\n        if (!Array.isArray(v) || v.length > MAX_ITEMS) { throw new Error('items must be an array of at most ' + MAX_ITEMS + ' strings'); }\n        return v.map(function (s, i) { return text(s, 'items[' + i + ']'); });\n    }\n    throw new Error('prop \"' + name + '\" is not allowed on ' + kind);\n  }\n\n  // progress takes a number for value; everything else with a value is text\n  function propValue(kind, name, v) {\n    if (kind === 'progress' && name === 'value') { return num(v, 'value', 0, 1e12); }\n    if (kind === 'grid' && name === 'columns') { return num(v, name, 1, 12); }\n    if (kind === 'split' && name === 'ratio') { return num(v, name, 10, 90); }\n    if (kind === 'split' && name === 'direction') { if (v !== 'row' && v !== 'column') { throw new Error('direction must be row or column'); } return v; }\n    if (kind === 'menuitem' && name === 'keys') { return text(v, name); }\n    if (kind === 'scroll' && name === 'height') { return num(v, name, 40, 1200); }\n    if (kind === 'canvas' && (name === 'width' || name === 'height')) { return num(v, name, 1, MAX_CANVAS); }\n    if (kind === 'canvas' && name === 'fps') { return num(v, name, 0, MAX_FPS); }\n    if (kind === 'table' && name === 'columns') { return cellList(v, 'columns', 1, MAX_COLUMNS); }\n    if (kind === 'table' && name === 'rows') { return tableRows(v); }\n    if (kind === 'multilist' && name === 'selected') { return cellList(v, 'selected', 0, MAX_ITEMS); }\n    return prop(kind, name, v);\n  }\n\n  // an array of text values (table columns, multilist selection)\n  function cellList(v, field, min, max) {\n    if (!Array.isArray(v) || v.length < min || v.length > max) { throw new Error(field + ' must be an array of ' + min + ' to ' + max + ' strings'); }\n    return v.map(function (s, i) { return text(s, field + '[' + i + ']'); });\n  }\n\n  // table rows: an array of rows, each with one text value per column\n  function tableRows(v) {\n    if (!Array.isArray(v) || v.length > MAX_ITEMS) { throw new Error('rows must be an array of at most ' + MAX_ITEMS + ' rows'); }\n    return v.map(function (r, i) { return cellList(r, 'rows[' + i + ']', 0, MAX_COLUMNS); });\n  }\n\n  // a picture registered on the canvas: data is a PNG, JPEG, GIF or WebP data URL of at most MAX_IMAGE_BYTES (decoded)\n  function imageData(v) {\n    var bad = 'data must be a data:image/png, jpeg, gif or webp;base64 URL';\n    if (typeof v !== 'string') { throw new Error(bad); }\n    var m = IMAGE_RE.exec(v);\n    if (!m) { throw new Error(bad); }\n    var b64 = m[2], pad = (b64.match(/=+$/) || [''])[0].length;\n    if (b64.length % 4 !== 0) { throw new Error('data is not valid base64'); }\n    if (b64.length / 4 * 3 - pad > MAX_IMAGE_BYTES) { throw new Error('image is larger than ' + (MAX_IMAGE_BYTES / 1024) + ' KB'); }\n    return v;\n  }\n\n  // draw [\"image\", name, x, y] or [\"image\", name, x, y, w, h]: the name must be a picture of this canvas\n  function imageCommand(op, what, images) {\n    if (op.length !== 4 && op.length !== 6) { throw new Error(what + ' image needs a name, x, y and optionally w, h'); }\n    var name = id(op[1], what + '[1]');\n    if (!Object.prototype.hasOwnProperty.call(images, name)) { throw new Error(what + ' image \"' + name + '\" is not loaded on this canvas'); }\n    var out = ['image', name, num(op[2], what + '[2]', -1e5, 1e5), num(op[3], what + '[3]', -1e5, 1e5)];\n    if (op.length === 6) { out.push(num(op[4], what + '[4]', 0, 1e5), num(op[5], what + '[5]', 0, 1e5)); }\n    return out;\n  }\n\n  // one draw command: [\"rect\", x, y, w, h, \"#rrggbb\"] and the rest of DRAW_LENGTH. Coordinates are checked, never clipped here.\n  function drawCommand(op, what, images) {\n    if (Array.isArray(op) && op[0] === 'image') { return imageCommand(op, what, images); }\n    if (!Array.isArray(op) || !Object.prototype.hasOwnProperty.call(DRAW_LENGTH, op[0])) { throw new Error(what + ' must be [name, ...] with name clear, rect, circle, line, text or image'); }\n    var name = op[0];\n    if (op.length !== DRAW_LENGTH[name]) { throw new Error(what + ' ' + name + ' needs ' + (DRAW_LENGTH[name] - 1) + ' values after the name'); }\n    var color = op[op.length - 1];\n    if (typeof color !== 'string' || !COLOR_RE.test(color)) { throw new Error(what + ' color must be #rgb or #rrggbb'); }\n    var c = function (i) { return num(op[i], what + '[' + i + ']', -1e5, 1e5); };\n    if (name === 'clear') { return [name, color]; }\n    if (name === 'rect') { return [name, c(1), c(2), num(op[3], what + '[3]', 0, 1e5), num(op[4], what + '[4]', 0, 1e5), color]; }\n    if (name === 'circle') { return [name, c(1), c(2), num(op[3], what + '[3]', 0, 1e4), color]; }\n    if (name === 'line') { return [name, c(1), c(2), c(3), c(4), color]; }\n    return [name, c(1), c(2), text(op[3], what + '[3]'), color];\n  }\n\n  function drawOps(v, images) {\n    if (!Array.isArray(v) || v.length > MAX_DRAW) { throw new Error('ops must be an array of at most ' + MAX_DRAW + ' drawing commands'); }\n    return v.map(function (op, i) { return drawCommand(op, 'ops[' + i + ']', images); });\n  }\n\n  function checkNode(n, what) {\n    if (!isObj(n)) { throw new Error(what + ' must be an object'); }\n    var kind = n.kind;\n    if (!Object.prototype.hasOwnProperty.call(KINDS, kind)) { throw new Error(what + ' kind \"' + kind + '\" is not supported'); }\n    var out = { id: id(n.id, what + '.id'), kind: kind, children: [] };\n    if (n.id === 'root') { throw new Error('\"root\" is reserved for the window'); }\n    var allowed = KINDS[kind].props.concat(COMMON);\n    Object.keys(n).forEach(function (k) 