,"luatz.strptime"]}},user_kernel_boundary:{label:"Linux kernel user/kernel memory boundary crossing",description:"THE canonical taint boundary inside Linux kernel code: copy_from_user/get_user bring untrusted userspace data INTO the kernel (a source); copy_to_user/put_user send kernel data OUT to userspace (a sink - an info-leak if the wrong buffer reaches it). Deliberately its own category rather than folded into file_io/memory_management, because THIS boundary is the one that actually matters for kernel security auditing - wired into tools.dataflow_tools as both a SOURCE and a SINK category.\n",languages:{c:["copy_from_user","copy_to_user","get_user","put_user","__copy_from_user","__copy_to_user","access_ok","strncpy_from_user","clear_user","syscall","strnlen_user","ioctl","unlocked_ioctl","compat_ioctl","kmalloc","kzalloc","kfree","vmalloc","vfree","capable","ns_capable"],java:[],python:[],javascript:[],html:[],rust:["libc::syscall","libc::read","libc::write","libc::open","libc::close","libc::mmap","libc::munmap","libc::ioctl","libc::fork","libc::execve","libc::kill","libc::socket","libc::bind","libc::listen","libc::accept","libc::connect","libc::getpid","libc::mprotect","nix::unistd::fork","nix::unistd::read","nix::unistd::write","nix::sys::mman::mmap","nix::sys::signal::kill","nix::sys::signal::sigaction","nix::sys::socket::socket","nix::ioctl_read!","nix::ioctl_write_ptr!","nix::mount::mount","rustix::fs::open","rustix::io::read","io_uring::IoUring::new","windows_sys::Win32::System::Threading::CreateProcessW","winapi::um::fileapi::CreateFileW"],go:["syscall.Syscall","syscall.Syscall6","syscall.RawSyscall","syscall.RawSyscall6","syscall.Read","syscall.Write","syscall.Open","syscall.Close","syscall.Ioctl","syscall.Socket","syscall.Bind","syscall.Listen","syscall.Accept","syscall.Connect","syscall.Getpid","syscall.Mprotect","syscall.Ptrace","syscall.Reboot","syscall.Sethostname","syscall.Setuid","syscall.Setgid","syscall.Setrlimit","syscall.Getrlimit","syscall.Pr