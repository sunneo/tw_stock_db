\': 0x1182, \'LOG\': 0x1183, \'BINARY_TYPE\': 0x1184, \'GLOBAL_VARIABLE_TOTAL_SIZE\': 0x1185})\nprogram_binary_type = _enum(\'program_binary_type\', {\'NONE\': 0, \'COMPILED_OBJECT\': 1, \'LIBRARY\': 2, \'EXECUTABLE\': 4})\nkernel_info = _enum(\'kernel_info\', {\'FUNCTION_NAME\': 0x1190, \'NUM_ARGS\': 0x1191, \'REFERENCE_COUNT\': 0x1192, \'CONTEXT\': 0x1193, \'PROGRAM\': 0x1194, \'ATTRIBUTES\': 0x1195})\nkernel_arg_info = _enum(\'kernel_arg_info\', {\'ADDRESS_QUALIFIER\': 0x1196, \'ACCESS_QUALIFIER\': 0x1197, \'TYPE_NAME\': 0x1198, \'TYPE_QUALIFIER\': 0x1199, \'NAME\': 0x119a})\nkernel_arg_address_qualifier = _enum(\'kernel_arg_address_qualifier\', {\'GLOBAL\': 0x119b, \'LOCAL\': 0x119c, \'CONSTANT\': 0x119d, \'PRIVATE\': 0x119e})\nkernel_arg_access_qualifier = _enum(\'kernel_arg_access_qualifier\', {\'READ_ONLY\': 0x11a0, \'WRITE_ONLY\': 0x11a1, \'READ_WRITE\': 0x11a2, \'NONE\': 0x11a3})\nkernel_arg_type_qualifier = _enum(\'kernel_arg_type_qualifier\', {\'NONE\': 0, \'CONST\': 1, \'RESTRICT\': 2, \'VOLATILE\': 4, \'PIPE\': 8})\nkernel_work_group_info = _enum(\'kernel_work_group_info\', {\'WORK_GROUP_SIZE\': 0x11b0, \'COMPILE_WORK_GROUP_SIZE\': 0x11b1, \'LOCAL_MEM_SIZE\': 0x11b2, \'PREFERRED_WORK_GROUP_SIZE_MULTIPLE\': 0x11b3, \'PRIVATE_MEM_SIZE\': 0x11b4, \'GLOBAL_WORK_SIZE\': 0x11b5})\nkernel_sub_group_info = _enum(\'kernel_sub_group_info\', {\'MAX_SUB_GROUP_SIZE_FOR_NDRANGE\': 0x2033, \'SUB_GROUP_COUNT_FOR_NDRANGE\': 0x2034, \'LOCAL_SIZE_FOR_SUB_GROUP_COUNT\': 0x11b8, \'MAX_NUM_SUB_GROUPS\': 0x11b9, \'COMPILE_NUM_SUB_GROUPS\': 0x11ba})\nevent_info = _enum(\'event_info\', {\'COMMAND_QUEUE\': 0x11d0, \'COMMAND_TYPE\': 0x11d1, \'REFERENCE_COUNT\': 0x11d2, \'COMMAND_EXECUTION_STATUS\': 0x11d3, \'CONTEXT\': 0x11d4})\ncommand_type = _enum(\'command_type\', {\'NDRANGE_KERNEL\': 0x11f0, \'TASK\': 0x11f1, \'NATIVE_KERNEL\': 0x11f2, \'READ_BUFFER\': 0x11f3, \'WRITE_BUFFER\': 0x11f4, \'COPY_BUFFER\': 0x11f5, \'READ_IMAGE\': 0x11f6, \'WRITE_IMAGE\': 0x11f7, \'COPY_IMAGE\': 0x11f8, \'COPY_IMAGE_TO_BUFFER\': 0x11f9, \'COPY_BUFFER_TO_IMAGE\': 0x11fa, \'MAP_BUFFER\': 0x11fb, \'MAP_IMAGE\': 0x11fc, \'UNMAP_MEM_OBJECT\': 0x11fd, \'MARKER\': 0x11fe, \'ACQUIRE_GL_OBJECTS\': 0x11ff, \'RELEASE_GL_OBJECTS\': 0x1200, \'READ_BUFFER_RECT\': 0x1201, \'WRITE_BUFFER_RECT\': 0x1202, \'COPY_BUFFER_RECT\': 0x1203, \'USER\': 0x1204, \'BARRIER\': 0x1205, \'MIGRATE_MEM_OBJECTS\': 0x1206, \'FILL_BUFFER\': 0x1207, \'FILL_IMAGE\': 0x1208, \'SVM_FREE\': 0x1209, \'SVM_MEMCPY\': 0x120a, \'SVM_MEMFILL\': 0x120b, \'SVM_MAP\': 0x120c, \'SVM_UNMAP\': 0x120d, \'SVM_MIGRATE_MEM\': 0x120e})\ncommand_execution_status = _enum(\'command_execution_status\', {\'COMPLETE\': 0, \'RUNNING\': 1, \'SUBMITTED\': 2, \'QUEUED\': 3})\nprofiling_info = _enum(\'profiling_info\', {\'QUEUED\': 0x1280, \'SUBMIT\': 0x1281, \'START\': 0x1282, \'END\': 0x1283, \'COMPLETE\': 0x1284})\nmem_migration_flags = _enum(\'mem_migration_flags\', {\'HOST\': 1, \'CONTENT_UNDEFINED\': 2})\ndevice_partition_property = _enum(\'device_partition_property\', {\'EQUALLY\': 0x1086, \'BY_COUNTS\': 0x1087, \'BY_COUNTS_LIST_END\': 0, \'BY_AFFINITY_DOMAIN\': 0x1088})\ndevice_affinity_domain = _enum(\'device_affinity_domain\', {\'NUMA\': 1, \'L4_CACHE\': 2, \'L3_CACHE\': 4, \'L2_CACHE\': 8, \'L1_CACHE\': 16, \'NEXT_PARTITIONABLE\': 32})\ndevice_atomic_capabilities = _enum(\'device_atomic_capabilities\', {\'ORDER_RELAXED\': 1, \'ORDER_ACQ_REL\': 2, \'ORDER_SEQ_CST\': 4, \'SCOPE_WORK_ITEM\': 8, \'SCOPE_WORK_GROUP\': 16, \'SCOPE_DEVICE\': 32, \'SCOPE_ALL_DEVICES\': 64})\ndevice_device_enqueue_capabilities = _enum(\'device_device_enqueue_capabilities\', {\'SUPPORTED\': 1, \'REPLACEABLE_DEFAULT\': 2})\nversion_bits = _enum(\'version_bits\', {\'MAJOR_BITS\': 10, \'MINOR_BITS\': 10, \'PATCH_BITS\': 12, \'MAJOR_MASK\': 0x3ff, \'MINOR_MASK\': 0x3ff, \'PATCH_MASK\': 0xfff})\nkhronos_vendor_id = _enum(\'khronos_vendor_id\', {\'CODEPLAY\': 0x10004})\ngl_object_type = _enum(\'gl_object_type\', {\'BUFFER\': 0x2000, \'TEXTURE2D\': 0x2001, \'TEXTURE3D\': 0x2002, \'RENDERBUFFER\': 0x2003})\ngl_texture_info = _enum(\'gl_texture_info\', {\'TEXTURE_TARGET\': 0x2004, \'MIPMAP_LEVEL\': 0x2005})\nprogram_kind = _enum(\'program_kind\', {\'UNKNOWN\': 0, \'SOURCE\': 0x1164, \'BINARY\': 2, \'IL\': 0x1169})\n# 對不到標頭的成員（多半在 cl_ext.h／cl_gl.h，這些標頭沒下載）；沒有編造數值，所以這些成員在 _cl 裡不存在：\n_UNRESOLVED = {\'device_info\': [\'ATTRIBUTE_ASYNC_ENGINE_COUNT_NV\', \'PCI_BUS_ID_NV\', \'PCI_SLOT_ID_NV\', \'PCI_DOMAIN_ID_NV\', \'MAX_ATOMIC_COUNTERS_EXT\'], \'device_topology_type_amd\': [\'PCIE\'], \'context_properties\': [\'OFFLINE_DEVICES_AMD\'], \'mem_flags\': [\'USE_PERSISTENT_MEM_AMD\'], \'channel_order\': [\'Rx\', \'RGx\', \'RGBx\']}\n# GENERATED ENUMS>>>\n\n_CMD = {"kernel": command_type.NDRANGE_KERNEL, "read": command_type.READ_BUFFER, "write": command_type.WRITE_BUFFER,\n        "copy": command_type.COPY_BUFFER}\n\n# ---------------------------------------------------------------------------------------------\n# 例外\n# ---------------------------------------------------------------------------------------------\n\n\nclass _ErrorRecord:\n    def __init__(self, msg, code, routine):\n        self._msg, self._code, self._routine = msg, int(code), routine\n\n    def routine(self):\n        return self._routine\n\n    def code(self):\n        return self._code\n\n    def what(self):\n        return self._msg\n\n    def is_out_of_memory(self):\n        return self._code in (status_code.MEM_OBJECT_ALLOCATION_FAILURE, status_code.OUT_OF_HOST_MEMORY, status_code.OUT_OF_RESOURCES)\n\n\nclass Error(Exception):\n    """真 pyopencl 的 _monkeypatch 假設 args[0] 是 _ErrorRecord，並替 code／routine／what 裝唯讀屬性、替 __str__ 換成它自己的版本；\n    所以這裡不能把它們存成實例屬性（否則裝上唯讀屬性後建構會失敗），一律從 args[0] 讀。"""\n\n    def __init__(self, *args):\n        # 真的建構子只收一個 _ErrorRecord（pyopencl 的 Program._build_and_catch_errors 就這樣重建例外）；(routine, code, msg) 是內部方便寫法\n        if len(args) == 1 and isinstance(args[0], _ErrorRecord):\n            Exception.__init__(self, args[0])\n        elif len(args) == 3:\n            Exception.__init__(self, _ErrorRecord(args[2], args[1], args[0]))\n        else:\n            Exception.__init__(self, _ErrorRecord(" ".join(str(a) for a in args), 0, ""))\n\n    @property\n    def code(self):\n        return self.args[0].code()\n\n    @property\n    def routine(self):\n        return self.args[0].routine()\n\n    @property\n    def what(self):\n        return self.args[0]\n\n    def __str__(self):\n        r = self.args[0]\n        name = status_code.to_string(r.code(), "<unknown error %d>") if r.code() != 0 else ""\n        head = ("%s failed: %s" % (r.routine(), name)) if r.routine() else name\n        m = r.what()\n        return head + ((" - " if head else "") + m if m else "")\n\n\nclass MemoryError(Error):\n    pass\n\n\nclass LogicError(Error):\n    pass\n\n\nclass RuntimeError(Error):\n    pass\n\n\ndef _raise(routine, name, msg="", code=None):\n    c = code if code is not None else getattr(status_code, name, -9999)\n    if c in (status_code.MEM_OBJECT_ALLOCATION_FAILURE, status_code.OUT_OF_HOST_MEMORY, status_code.OUT_OF_RESOURCES):\n        cls = MemoryError\n    elif c <= -30:   # INVALID_VALUE（-30）以下一律 LogicError，含 KHR 擴充的 -1000／-1001（與真 pyopencl 一樣：常見的 LogicError: clGetPlatformIDs failed: PLATFORM_NOT_FOUND_KHR）\n        cls = LogicError\n    else:\n        cls = RuntimeError\n    raise cls(routine, c, msg)\n\n\n# ---------------------------------------------------------------------------------------------\n# 傳輸\n# ---------------------------------------------------------------------------------------------\n\nclass _StdioTransport(object):\n    """一般 Python 用：啟動 `node cl_host_stdio.js`，以框架（4 位元組 JSON 長度、4 位元組資料長度、JSON、資料）收發。"""\n\n    def __init__(self, script, node="node"):\n        self._p = subprocess.Popen([node, script], stdin=subprocess.PIPE, stdout=subprocess.PIPE)\n        self._id = 0\n\n    def _read(self, n):\n        out = b""\n        while len(out) < n:\n            c = self._p.stdout.read(n - len(out))\n            if not c:\n                raise RuntimeError("clHost", status_code.OUT_OF_RESOURCES, "後端程序結束了")\n            out += c\n        return out\n\n    def call(self, op, args=None, data=None):\n        import json\n        self._id += 1\n        h = json.dumps({"id": self._id, "op": op, "args": args or {}}).encode("utf-8")\n        d = bytes(data) if data is not None else b""\n        self._p.stdin.write(struct.pack("<II", len(h), len(d)) + h + d)\n        self._p.stdin.flush()\n        hl, dl = struct.unpack("<II", self._read(8))\n        res = json.loads(self._read(hl).decode("utf-8"))\n        payload = self._read(dl) if dl else None\n        return res["result"], payload\n\n    def close(self):\n        try:\n            self._p.stdin.close()\n            self._p.wait(timeout=5)\n        except Exception:\n            self._p.kill()\n\n\nclass _PyodideTransport(object):\n    """Pyodide 裡：_fa_opencl.call(op, jsonString, Uint8Array|undefined) → Promise<{json, data}>。（尚未在 Pyodide 實測。）"""\n\n    def call(self, op, args=None, data=None):\n        import json\n        from pyodide.ffi import run_sync, to_js\n        import _fa_opencl\n        r = run_sync(_fa_opencl.call(op, json.dumps(args or {}), to_js(bytes(data)) if data is not None else None))\n        payload = bytes(r.data.to_py()) if getattr(r, "data", None) is not None else None\n        return json.loads(str(r.json)), payload\n\n\n_transport = None\n\n\ndef _set_transport(t):\n    global _transport\n    _transport = t\n\n\ndef _get_transport():\n    global _transport\n    if _transport is None:\n        if sys.platform == "emscripten":\n            _transport = _PyodideTransport()\n        elif os.environ.get("FA_OPENCL_HOST"):\n            _transport = _StdioTransport(os.environ["FA_OPENCL_HOST"], os.environ.get("FA_OPENCL_NODE", "node"))\n    return _transport\n\n\n_ROUTINE = {"platforms": "clGetPlatformIDs", "devices": "clGetDeviceIDs", "ctx_create": "clCreateContext", "queue_create": "clCreateCommandQueue",\n            "buf_create": "clCreateBuffer", "buf_write": "clEnqueueWriteBuffer", "buf_read": "clEnqueueReadBuffer", "buf_copy": "clEnqueueCopyBuffer",\n            "buf_fill": "clEnqueueFillBuffer", "prog_create": "clCreateProgramWithSource", "prog_build": "clBuildProgram",\n            "kernel_create": "clCreateKernel", "kernel_set_arg": "clSetKernelArg", "nd_range": "clEnqueueNDRangeKernel", "finish": "clFinish"}\n\n\ndef _call(op, args=None, data=None):\n    t = _get_transport()\n    if t is None:\n        _raise("clGetPlatformIDs", "PLATFORM_NOT_FOUND_KHR", "沒有 OpenCL 後端（Pyodide 以外請設 FA_OPENCL_HOST 指向 cl_host_stdio.js）")\n    res, payload = t.call(op, args or {}, data)\n    err = res.get("error") if isinstance(res, dict) else None\n    if err:\n        _raise(_ROUTINE.get(op, op), err.get("name", "OUT_OF_RESOURCES"), err.get("msg", ""), err.get("code"))\n    return res, payload\n\n\n# ---------------------------------------------------------------------------------------------\n# 物件\n# ---------------------------------------------------------------------------------------------\n\nclass _Handle(object):\n    """所有物件的共同部分：控制代碼 h、相等與雜湊、release、屬性後備（真 pyopencl 的 _monkeypatch 會替類別加上唯讀屬性，所以這裡只在屬性缺少時才查 get_info）。"""\n    _info_enums = ()\n    _h = None\n\n    @property\n    def int_ptr(self):\n        return self._h\n\n    def __eq__(self, other):\n        return type(other) is type(self) and other._h == self._h\n\n    def __ne__(self, other):\n        return not self.__eq__(other)\n\n    def __hash__(self):\n        return hash((type(self).__name__, self._h))\n\n    @staticmethod\n    def from_int_ptr(int_ptr_value, retain=True):\n        _raise("from_int_ptr", "INVALID_VALUE", "這個後端不支援 from_int_ptr（物件在宿主那邊，不是真的指標）")\n\n    def release(self):\n        h, self._h = self._h, None\n        if h is not None:\n            try:\n                _call("release", {"h": h})\n            except Exception:\n                pass\n\n    def __getattr__(self, name):\n        if not name.startswith("_"):\n            up = name.upper()\n            for en in type(self)._info_enums:\n                if up in en.__dict__:\n                    return self.get_info(en.__dict__[up])\n        raise AttributeError(name)\n\n\ndef _info_error(routine, param):\n    _raise(routine, "INVALID_VALUE", "不支援的查詢參數 0x%x" % int(param))\n\n\nclass Platform(_Handle):\n    _info_enums = (platform_info,)\n\n    def __init__(self, rec):\n        self._h, self._rec = rec["h"], rec\n\n    def get_info(self, param):\n        key = {platform_info.PROFILE: "profile", platform_info.VERSION: "version", platform_info.NAME: "name", platform_info.VENDOR: "vendor",\n               platform_info.EXTENSIONS: "extensions"}.get(int(param))\n        if key is None:\n            _info_error("clGetPlatformInfo", param)\n        return self._rec[key]\n\n    def get_devices(self, device_type=device_type.ALL):\n        dt = int(device_type)\n        name = "ALL" if dt == device_type_ALL else {1: "DEFAULT", 2: "CPU", 4: "GPU", 8: "ACCELERATOR"}.get(dt)\n        if name is None:\n            _raise("clGetDeviceIDs", "INVALID_DEVICE_TYPE")\n        res, _ = _call("devices", {"platform": self._h, "type": name})\n        return [Device(d, self) for d in res["devices"]]\n\n    def __repr__(self):\n        return "<pyopencl.Platform \'%s\' holding <fa-icd %d>>" % (self._rec["name"], self._h)\n\n\ndevice_type_ALL = int(device_type.ALL)\n\n\nclass Device(_Handle):\n    _info_enums = (device_info,)\n\n    def __init__(self, rec, platform):\n        self._h, self._rec, self._platform = rec["h"], rec, platform\n\n    def get_info(self, param):\n        p, r = int(param), self._rec\n        simple = {device_info.NAME: "name", device_info.VENDOR: "vendor", device_info.VERSION: "version", device_info.DRIVER_VERSION: "driver_version",\n                  device_info.PROFILE: "profile", device_info.EXTENSIONS: "extensions", device_info.MAX_WORK_GROUP_SIZE: "max_work_group_size",\n                  device_info.MAX_WORK_ITEM_SIZES: "max_work_item_sizes", device_info.MAX_WORK_ITEM_DIMENSIONS: "max_work_item_dimensions",\n                  device_info.MAX_COMPUTE_UNITS: "max_compute_units", device_info.GLOBAL_MEM_SIZE: "global_mem_size",\n                  device_info.MAX_MEM_ALLOC_SIZE: "max_mem_alloc_size", device_info.AVAILABLE: "available",\n                  device_info.COMPILER_AVAILABLE: "compiler_available", device_info.ADDRESS_BITS: "address_bits",\n                  device_info.LOCAL_MEM_SIZE: "local_mem_size", device_info.LOCAL_MEM_TYPE: "local_mem_type", device_info.MAX_PARAMETER_SIZE: "max_parameter_size",\n                  device_info.MAX_CLOCK_FREQUENCY: "max_clock_frequency", device_info.MAX_CONSTANT_BUFFER_SIZE: "max_constant_buffer_size",\n                  device_info.ENDIAN_LITTLE: "endian_little", device_info.IMAGE_SUPPORT: "image_support",\n                  device_info.ERROR_CORRECTION_SUPPORT: "error_correction_support", device_info.GLOBAL_MEM_CACHELINE_SIZE: "global_mem_cacheline_size",\n                  device_info.GLOBAL_MEM_CACHE_SIZE: "global_mem_cache_size", device_info.GLOBAL_MEM_CACHE_TYPE: "global_mem_cache_type",\n                  device_info.MEM_BASE_ADDR_ALIGN: "mem_base_addr_align", device_info.MIN_DATA_TYPE_ALIGN_SIZE: "min_data_type_align_size",\n                  device_info.PROFILING_TIMER_RESOLUTION: "profiling_timer_resolution", device_info.MAX_CONSTANT_ARGS: "max_constant_args",\n                  device_info.MAX_SAMPLERS: "max_samplers", device_info.SVM_CAPABILITIES: "svm_capabilities", device_info.MAX_PIPE_ARGS: "max_pipe_args",\n                  device_info.IMAGE2D_MAX_WIDTH: "image2d_max_width", device_info.IMAGE2D_MAX_HEIGHT: "image2d_max_height", device_info.IMAGE3D_MAX_WIDTH: "image3d_max_width",\n                  device_info.IMAGE3D_MAX_HEIGHT: "image3d_max_height", device_info.IMAGE3D_MAX_DEPTH: "image3d_max_depth", device_info.IMAGE_MAX_BUFFER_SIZE: "image_max_buffer_size",\n                  device_info.IMAGE_MAX_ARRAY_SIZE: "image_max_array_size", device_info.MAX_READ_IMAGE_ARGS: "max_read_image_args", device_info.MAX_WRITE_IMAGE_ARGS: "max_write_image_args",\n                  device_info.MAX_READ_WRITE_IMAGE_ARGS: "max_read_write_image_args", device_info.IMAGE_PITCH_ALIGNMENT: "image_pitch_alignment", device_info.IMAGE_BASE_ADDRESS_ALIGNMENT: "image_base_address_alignment",\n                  device_info.PIPE_MAX_ACTIVE_RESERVATIONS: "pipe_max_active_reservations", device_info.PIPE_MAX_PACKET_SIZE: "pipe_max_packet_size", device_info.PIPE_SUPPORT: "pipe_support"}\n        if p in simple:\n            return r[simple[p]]\n        if p == device_info.TYPE:\n            return {"CPU": device_type.CPU, "GPU": device_type.GPU}.get(r["type"], device_type.DEFAULT)\n        if p == device_info.PLATFORM:\n            return self._platform\n        if p == device_info.VENDOR_ID:\n            return 0\n        if p == device_info.OPENCL_C_VERSION:\n            return "OpenCL C 1.2"\n        _info_error("clGetDeviceInfo", param)\n\n    def __repr__(self):\n        return "<pyopencl.Device \'%s\' on \'%s\'>" % (self._rec["name"], self._platform._rec["name"])\n\n\ndef _parse_context_properties(properties):\n    """cl.Context 的 properties：[(鍵, 值), …]（或攤平的 [鍵, 值, …]）。PLATFORM 取平台；GL_CONTEXT_KHR 等 GL 屬性要與目前 GL 上下文相符\n    （值來自 pyopencl.tools.get_gl_sharing_context_properties，在網頁上由 fa_pyopencl 用我們的 GL 上下文回應），不符＝INVALID_GL_SHAREGROUP_REFERENCE_KHR。"""\n    if not properties:\n        return [], None, False\n    items = list(properties)\n    if items and not isinstance(items[0], (tuple, list)):\n        items = [(items[k], items[k + 1]) for k in range(0, len(items) - 1, 2) if items[k] != 0]\n    props, platform, gl = [], None, False\n    gl_keys = tuple(getattr(context_properties, n) for n in ("GL_CONTEXT_KHR", "EGL_DISPLAY_KHR", "GLX_DISPLAY_KHR", "WGL_HDC_KHR", "CGL_SHAREGROUP_KHR")\n                    if hasattr(context_properties, n))   # CGL_SHAREGROUP_KHR 在 cl_gl_ext.h（沒下載），有就用\n    ctx_handle = None\n    for k, v in items:\n        k = int(k)\n        if k == context_properties.PLATFORM:\n            if not isinstance(v, Platform):\n                _raise("clCreateContext", "INVALID_PLATFORM", "PLATFORM 屬性的值要是 Platform 物件")\n            platform = v\n        elif k in gl_keys:\n            gl = True\n            if k == context_properties.GL_CONTEXT_KHR:\n                ctx_handle = int(v)\n        else:\n            _raise("clCreateContext", "INVALID_PROPERTY", "不認得的 context 屬性 0x%x" % k)\n        props.append((k, v))\n    if gl:\n        try:\n            import fa_opengl_platform as P\n            cur = P.interop_context_handle()\n        except ImportError:\n            cur = 0\n        if not cur or ctx_handle != cur:\n            _raise("clCreateContext", "INVALID_GL_SHAREGROUP_REFERENCE_KHR", "GL_CONTEXT_KHR（%s）不是目前的 GL 上下文（%s）——要先建立 GL 上下文，並用 get_gl_sharing_context_properties() 取得屬性" % (ctx_handle, cur or "沒有"))\n    return props, platform, gl\n\n\nclass Context(_Handle):\n    _info_enums = (context_info,)\n\n    def __init__(self, devices=None, properties=None, dev_type=None):\n        props, want_platform, gl_shared = _parse_context_properties(properties)\n        if devices is None:   # 與真 pyopencl 一樣：依 dev_type（預設全部）找第一個有裝置的平台（properties 有 PLATFORM 就用它），用它的第一個裝置\n            devices = []\n            for p in ([want_platform] if want_platform is not None else get_platforms()):\n                try:\n                    devices = p.get_devices(device_type.ALL if dev_type is None else dev_type)[:1]\n                except Error:\n                    devices = []\n                if devices:\n                    break\n            if not devices:\n                _raise("clCreateContext", "DEVICE_NOT_FOUND", "沒有可用的裝置")\n        if not devices:\n            _raise("clCreateContext", "INVALID_VALUE", "devices 是空的")\n        if want_platform is not None and any(d._platform != want_platform for d in devices):\n            _raise("clCreateContext", "INVALID_PLATFORM", "properties 的 PLATFORM 與 devices 不是同一個平台")\n        res, _ = _call("ctx_create", {"devices": [d._h for d in devices]})\n        self._h, self._devices, self._props, self._gl_shared = res["h"], list(devices), props, gl_shared\n\n    def get_info(self, param):\n        p = int(param)\n        if p == context_info.DEVICES:\n            return list(self._devices)\n        if p == context_info.NUM_DEVICES:\n            return len(self._devices)\n        if p == context_info.REFERENCE_COUNT:\n            return 1\n        if p == context_info.PROPERTIES:   # 與真的一樣：[鍵, 值, 鍵, 值, …, 0]\n            flat = []\n            for k, v in self._props:\n                flat += [k, v._h if isinstance(v, Platform) else int(v)]\n            return flat + [0] if flat else []\n        _info_error("clGetContextInfo", param)\n\n    def set_default_device_command_queue(self, device, queue):\n        if queue._ctx is not self and queue._ctx != self:\n            _raise("clSetDefaultDeviceCommandQueue", "INVALID_COMMAND_QUEUE", "佇列不屬於這個內容")\n        self._default_queues = getattr(self, "_default_queues", {})\n        self._default_queues[device._h] = queue   # 沒有裝置端的 enqueue（OpenCL 2.0 的 device-side queue），所以只記下來\n\n    def __repr__(self):\n        return "<pyopencl.Context at fa-icd %s on %s>" % (self._h, ", ".join("<%s>" % d._rec["name"] for d in self._devices))\n\n\nclass CommandQueue(_Handle):\n    _info_enums = (command_queue_info,)\n\n    def __init__(self, context, device=None, properties=0):\n        props = int(properties or 0)\n        if props & command_queue_properties.OUT_OF_ORDER_EXEC_MODE_ENABLE:\n            _raise("clCreateCommandQueue", "INVALID_QUEUE_PROPERTIES", "這個後端只有循序佇列")\n        if device is None:\n            device = context._devices[0]\n        res, _ = _call("queue_create", {"ctx": context._h, "device": device._h, "profiling": bool(props & command_queue_properties.PROFILING_ENABLE)})\n        self._h, self._ctx, self._dev, self._props = res["h"], context, device, props\n\n    def get_info(self, param):\n        p = int(param)\n        if p == command_queue_info.CONTEXT:\n            return self._ctx\n        if p == command_queue_info.DEVICE:\n            return self._dev\n        if p == command_queue_info.REFERENCE_COUNT:\n            return 1\n        if p == command_queue_info.PROPERTIES:\n            return self._props\n        _info_error("clGetCommandQueueInfo", param)\n\n    def flush(self):\n        return None\n\n    def finish(self):\n        _call("finish", {"queue": self._h})\n\n    def _finalize(self):\n        self.release()\n\n    def __del__(self):\n        try:\n            self.release()\n        except Exception:\n            pass\n\n\nclass Event(_Handle):\n    _info_enums = (event_info,)\n\n    def __init__(self, rec, queue):\n        self._h, self._rec, self._queue = rec["h"], rec, queue\n\n    def wait(self):\n        return None   # 這個後端的操作都已完成\n\n    def get_info(self, param):\n        p = int(param)\n        if p == event_info.COMMAND_EXECUTION_STATUS:\n            return command_execution_status.COMPLETE\n        if p == event_info.COMMAND_QUEUE:\n            return self._queue\n        if p == event_info.COMMAND_TYPE:\n            return _CMD.get(self._rec["cmd"], command_type.MARKER)\n        if p == event_info.REFERENCE_COUNT:\n            return 1\n        if p == event_info.CONTEXT:\n            return self._queue._ctx\n        _info_error("clGetEventInfo", param)\n\n    def get_profiling_info(self, param):\n        if not (self._queue._props & command_queue_properties.PROFILING_ENABLE):\n            _raise("clGetEventProfilingInfo", "PROFILING_INFO_NOT_AVAILABLE", "佇列沒有開 PROFILING_ENABLE")\n        key = {profiling_info.QUEUED: "queued", profiling_info.SUBMIT: "queued", profiling_info.START: "start", profiling_info.END: "end"}.get(int(param))\n        if key is None:\n            _info_error("clGetEventProfilingInfo", param)\n        return int(self._rec[key])\n\n    @property\n    def profile(self):\n        ev = self\n\n        class _P(object):\n            def __getattr__(self, n):\n                return ev.get_profiling_info(getattr(profiling_info, n.upper()))\n        return _P()\n\n    def set_callback(self, command_exec_callback_type, pfn_event_notify):\n        pfn_event_notify(command_execution_status.COMPLETE)\n\n    def __del__(self):\n        try:\n            self.release()\n        except Exception:\n            pass\n\n\nNannyEvent = Event\n\n\ndef wait_for_events(events):\n    return None\n\n\nclass MemoryObjectHolder(_Handle):\n    _info_enums = (mem_info,)\n\n    def get_info(self, param):\n        p = int(param)\n        if p == mem_info.SIZE:\n            return self._size\n        if p == mem_info.FLAGS:\n            return self._flags\n        if p == mem_info.CONTEXT:\n            return self._ctx\n        if p == mem_info.TYPE:\n            return getattr(self, "_mtype", mem_object_type.BUFFER)   # 圖像在 __init__ 設 _mtype（真 pyopencl 層的屬性綁在基底類別的 get_info 上，所以要在這裡判斷）\n        if p == mem_info.MAP_COUNT or p == 0:\n            return 0\n        if hasattr(mem_info, "OFFSET") and p == mem_info.OFFSET:\n            return self._offset\n        if hasattr(mem_info, "ASSOCIATED_MEMOBJECT") and p == mem_info.ASSOCIATED_MEMOBJECT:\n            return self._parent\n        if p == mem_info.REFERENCE_COUNT:\n            return 1\n        _info_error("clGetMemObjectInfo", param)\n\n    def get_host_array(self, shape, dtype, order="C"):\n        _raise("get_host_array", "INVALID_VALUE", "USE_HOST_PTR 不與主機記憶體別名，這個後端沒有主機陣列")\n\n    def __del__(self):\n        try:\n            self.release()\n        except Exception:\n            pass\n\n\nclass MemoryObject(MemoryObjectHolder):\n    pass\n\n\ndef _byte_view(buf):\n    """主機緩衝的位元組視圖（可寫就可寫）。接受任何「連續」的陣列——C 連續、或 F 連續（pyopencl.array 轉置後自己配的接收陣列就是 F 連續）；\n    真的不連續（有跨步間隙）丟 INVALID_HOST_PTR，與真 C++ 層（PyBUF_ANY_CONTIGUOUS）一樣。"""\n    try:\n        return memoryview(buf).cast("B")\n    except (TypeError, ValueError):\n        a = np.asarray(buf)\n        if a.flags.f_contiguous:\n            return memoryview(a.T).cast("B")   # F 連續的轉置是 C 連續，同一塊記憶體\n        _raise("clEnqueueCopy", "INVALID_HOST_PTR", "主機陣列不是連續的記憶體（shape %s、strides %s）" % (a.shape, a.strides))\n\n\ndef _as_bytes(buf):\n    return bytes(_byte_view(buf))\n\n\nclass Buffer(MemoryObject):\n    def __init__(self, context, flags, size=0, hostbuf=None, properties=None):\n        flags = int(flags)\n        if properties:\n            _raise("clCreateBufferWithProperties", "INVALID_PROPERTY", "不支援緩衝區 properties")\n        data = None\n        if hostbuf is not None:\n            data = _as_bytes(hostbuf)\n            if not size:\n                size = len(data)\n            if len(data) < size:\n                _raise("clCreateBuffer", "INVALID_HOST_PTR", "hostbuf（%d 位元組）比 size（%d）小" % (len(data), size))\n            data = data[:size]\n        elif flags & (mem_flags.COPY_HOST_PTR | mem_flags.USE_HOST_PTR):\n            _raise("clCreateBuffer", "INVALID_HOST_PTR", "COPY_HOST_PTR／USE_HOST_PTR 需要 hostbuf")\n        if not size:\n            _raise("clCreateBuffer", "INVALID_BUFFER_SIZE", "size 要大於 0")\n        res, _ = _call("buf_create", {"ctx": context._h, "flags": flags, "size": int(size)}, data)\n        self._h, self._ctx, self._size, self._flags = res["h"], context, int(size), flags\n\n    _parent = None\n    _offset = 0\n\n    def get_sub_region(self, origin, size, flags=0):\n        """子緩衝區：與父緩衝區共用同一塊記憶體（寫一邊另一邊看得到）。可以當核心參數、可以 enqueue_copy。"""\n        if self._parent is not None:\n            _raise("clCreateSubBuffer", "INVALID_MEM_OBJECT", "子緩衝區的子緩衝區不合法")\n        res, _ = _call("buf_sub", {"mem": self._h, "origin": int(origin), "size": int(size), "flags": int(flags)})\n        sub = Buffer.__new__(Buffer)\n        sub._h, sub._ctx, sub._size, sub._flags = res["h"], self._ctx, int(size), int(flags) or self._flags\n        sub._parent, sub._offset = self, int(origin)\n        return sub\n\n    def __getitem__(self, arg):\n        if not isinstance(arg, slice):\n            _raise("clCreateSubBuffer", "INVALID_VALUE", "要用切片，例如 buf[16:48]")\n        start, stop, step = arg.indices(self._size)\n        if step != 1:\n            _raise("clCreateSubBuffer", "INVALID_VALUE", "切片的步長要是 1")\n        return self.get_sub_region(start, stop - start)\n\n    def __repr__(self):\n        return "<pyopencl.Buffer of size %d at fa-icd %s>" % (self._size, self._h)\n\n\ndef _include_dirs(options):\n    import shlex\n    toks = shlex.split(options) if options else []\n    dirs = []\n    for k, tk in enumerate(toks):\n        if tk == "-I" and k + 1 < len(toks):\n            dirs.append(toks[k + 1])\n        elif tk.startswith("-I") and len(tk) > 2:\n            dirs.append(tk[2:])\n    return dirs\n\n\ndef _expand_includes(src, options, _depth=0, _once=None):\n    """把 `#include <x>`／`#include "x"` 依 -I 目錄內嵌進原始碼。前端（宿主）沒有檔案系統，所以由 Python 端做，\n    與真的 OpenCL 驅動「在 build 時依 -I 讀標頭」同一個語意。`#pragma once` 只展開一次；標頭沒找到＝BUILD_PROGRAM_FAILURE。"""\n    import re\n    if "#include" not in src and "# include" not in src:\n        return src\n    if _depth > 16:\n        _raise("clBuildProgram", "BUILD_PROGRAM_FAILURE", "#include 巢狀太深（遞迴？）")\n    dirs = _include_dirs(options)\n    once = _once if _once is not None else set()\n    out = []\n    for line in src.split("\\n"):\n        m = re.match(r\'\\s*#\\s*include\\s*([<"])([^>"]+)[>"]\', line)\n        if not m:\n            out.append(line)\n            continue\n        name, found = m.group(2), None\n        for d in dirs:\n            cand = os.path.join(d, name)\n            if os.path.isfile(cand):\n                found = cand\n                break\n        if found is None:\n            _raise("clBuildProgram", "BUILD_PROGRAM_FAILURE", "找不到標頭 %s（-I 路徑：%s）" % (name, ", ".join(dirs) or "沒有"))\n        real = os.path.realpath(found)\n        if real in once:\n            continue\n        with open(found, encoding="utf-8", errors="replace") as f:\n            text = f.read()\n        if re.search(r"^\\s*#\\s*pragma\\s+once", text, re.M):\n            once.add(real)\n        out.append(_expand_includes(text, options, _depth + 1, once))\n    return "\\n".join(out)\n\n\n_BIN_MAGIC = b"FAKIR1\\n"   # 這個後端的「二進位」＝魔術標頭＋OpenCL C 原始碼（JIT 後端的可攜表示，像 SPIR／PTX 文字）；讓 pyopencl 的磁碟編譯快取能運作\n\n\nclass _Program(_Handle):\n    def __init__(self, context, src, binaries=None):\n        # 兩種建構：_Program(ctx, 原始碼) 與 _Program(ctx, devices, binaries)（pyopencl 的編譯快取從磁碟讀回時用；src 在這裡是 devices）\n        self._from_binary = False\n        if binaries is not None:\n            bins = list(binaries)\n            if not bins or any(not bytes(b).startswith(_BIN_MAGIC) for b in bins):\n                _raise("clCreateProgramWithBinary", "INVALID_BINARY", "不是這個後端產生的二進位（要以 %r 開頭）" % _BIN_MAGIC)\n            src = bytes(bins[0])[len(_BIN_MAGIC):]\n            self._from_binary = True\n        if isinstance(src, (bytes, bytearray)):\n            src = bytes(src).decode("utf-8")\n        res, _ = _call("prog_create", {"ctx": context._h, "src": src})\n        self._h, self._ctx, self._src, self._built, self._log, self._options, self._kernels = res["h"], context, src, False, "", "", []\n\n    @staticmethod\n    def create_with_built_in_kernels(context, devices, kernel_names):\n        _raise("clCreateProgramWithBuiltInKernels", "INVALID_VALUE", "這個後端沒有內建核心")\n\n    def kind(self):\n        return program_kind.BINARY if self._from_binary else program_kind.SOURCE\n\n    def _build(self, options=b"", devices=None):\n        opt = options.decode("utf-8") if isinstance(options, (bytes, bytearray)) else str(options or "")\n        self._options = opt\n        try:\n            expanded = _expand_includes(self._src, opt)   # 真的驅動也是在 build 時依 -I 讀標頭\n        except Error:\n            self._built = False\n            raise\n        try:\n            res, _ = _call("prog_build", {"prog": self._h, "options": opt, "src": expanded if expanded != self._src else None})\n        except Error:\n            self._built = False\n            info, _ = _call("prog_info", {"prog": self._h})   # build log 給 get_build_info(LOG)（真 pyopencl 的 Program.build 會讀它）\n            self._log = info.get("log", "")\n            raise\n        self._built, self._log, self._kernels = True, res.get("log", ""), list(res["kernels"])\n\n    def get_build_info(self, device, param):\n        p = int(param)\n        if p == program_build_info.LOG:\n            return self._log\n        if p == program_build_info.OPTIONS:\n            return self._options\n        if p == program_build_info.STATUS:\n            return 0 if self._built else -2\n        _info_error("clGetProgramBuildInfo", param)\n\n    def get_info(self, param):\n        p = int(param)\n        if p == program_info.KERNEL_NAMES:\n            if not self._built:\n                _raise("clGetProgramInfo", "INVALID_PROGRAM_EXECUTABLE", "程式還沒有 build")\n            return ";".join(self._kernels)\n        if p == program_info.NUM_KERNELS:\n            return len(self._kernels)\n        if p == program_info.BINARIES:\n            if not self._built:\n                _raise("clGetProgramInfo", "INVALID_PROGRAM_EXECUTABLE", "程式還沒有 build")\n            return [_BIN_MAGIC + self._src.encode("utf-8") for _ in self._ctx._devices]\n        if p == program_info.BINARY_SIZES:\n            return [len(_BIN_MAGIC) + len(self._src.encode("utf-8")) for _ in self._ctx._devices]\n        if p == program_info.SOURCE:\n            return self._src\n        if p == program_info.CONTEXT:\n            return self._ctx\n        if p == program_info.DEVICES:\n            return list(self._ctx._devices)\n        if p == program_info.NUM_DEVICES:\n            return len(self._ctx._devices)\n        if p == program_info.REFERENCE_COUNT:\n            return 1\n        _info_error("clGetProgramInfo", param)\n\n    def compile(self, options=b"", devices=None, headers=[]):\n        """分開編譯：headers＝[(名稱, Program), …]，源碼裡的 #include <名稱> 以那個程式的源碼取代；之後用 link 連結成可執行程式。\n        這個後端的「編譯物件」就是展開 #include 之後的源碼（連結時合併）；語法與型別錯誤在 compile 就回報（與真的編譯器一樣）。"""\n        opt = options.decode("utf-8") if isinstance(options, (bytes, bytearray)) else str(options or "")\n        src = self._src\n        for name, hp in headers:   # 先換掉 headers 提供的標頭，剩下的 #include 再依 -I 找\n            hsrc = hp._src if isinstance(hp, _Program) else getattr(hp, "_prg", hp)._src\n            import re as _re\n            src = _re.sub(r\'^\\s*#\\s*include\\s*[<"]%s[>"].*$\' % _re.escape(name), lambda m: hsrc, src, flags=_re.M)\n        src = _expand_includes(src, opt)\n        probe, err = _Program(self._ctx, src), None\n        try:\n            probe._build(opt.encode())   # 試編譯：錯誤在這裡就回報\n        except Error as e:\n            err = e\n        if err is not None:\n            self._built = False\n            self._log = probe._log\n            _raise("clCompileProgram", "COMPILE_PROGRAM_FAILURE", probe._log)\n        self._compiled_src, self._log = src, probe._log\n        self._compiled = True\n\n    @staticmethod\n    def link(context, programs, options=b"", devices=None):\n        """連結：把幾個已 compile 的程式合併成一個可執行程式（源碼串接；同名核心重複會在 build 時報錯）。"""\n        parts = []\n        for pr in programs:\n            if not isinstance(pr, _Program):\n                pr = getattr(pr, "_prg", pr)\n            parts.append(getattr(pr, "_compiled_src", None) or pr._src)\n        linked = _Program(context, "\\n".join(parts))\n        try:\n            linked._build(options)\n        except Error:\n            _raise("clLinkProgram", "LINK_PROGRAM_FAILURE", linked._log)\n        return linked\n\n    def set_specialization_constant(self, spec_id, buffer):\n        _raise("clSetProgramSpecializationConstant", "INVALID_OPERATION", "OpenCL 2.2 的功能")\n\n    def all_kernels(self):\n        return [Kernel(self, n) for n in self._kernels]\n\n    def __del__(self):\n        try:\n            self.release()\n        except Exception:\n            pass\n\n\ndef _create_program_with_il(context, il):\n    _raise("clCreateProgramWithIL", "INVALID_VALUE", "不支援 IL（SPIR-V）程式")\n\n\ndef _is_vector_type(t):\n    import re\n    return re.match(r"^(char|uchar|short|ushort|int|uint|long|ulong|float|double)(2|3|4|8|16)$", t) is not None\n\n\n# 核心純量參數的型別名（KIR 驅動用 i32／f32；clc 驅動用 OpenCL C 的型別名）→ (整數或浮點, 位元組數, numpy 型別名)\n_SCALAR_DTYPE = {"i32": ("i", 4, "int32"), "f32": ("f", 4, "float32"), "int": ("i", 4, "int32"), "uint": ("i", 4, "uint32"), "long": ("i", 8, "int64"),\n                 "ulong": ("i", 8, "uint64"), "short": ("i", 2, "int16"), "ushort": ("i", 2, "uint16"), "char": ("i", 1, "int8"), "uchar": ("i", 1, "uint8"),\n                 "float": ("f", 4, "float32"), "double": ("f", 8, "float64")}\n\n\n_VEC_BASE_NP = {"char": "i1", "uchar": "u1", "short": "i2", "ushort": "u2", "int": "i4", "uint": "u4", "long": "i8", "ulong": "u8", "float": "f4", "double": "f8"}\n\n\ndef _vector_arg_values(spec, arg):\n    """核心的向量純量參數（float2、int4…）：接受 numpy 向量 dtype 的純量（np.void，例如 cltypes.float4）、複數（complex64 → float2）、\n    numpy 陣列、位元組（pyopencl 的呼叫器用 struct.pack 出來的）、list／tuple；回傳 [元素, …]。"""\n    import re\n    m = re.match(r"^(char|uchar|short|ushort|int|uint|long|ulong|float|double)(2|3|4|8|16)$", spec["type"])\n    base, n = m.group(1), int(m.group(2))\n    dt = np.dtype(_VEC_BASE_NP[base])\n    if isinstance(arg, (list, tuple)):\n        vals = np.array(arg, dtype=dt)\n    else:\n        raw = bytes(arg) if isinstance(arg, (bytes, bytearray)) else np.asarray(arg).tobytes()\n        if len(raw) < n * dt.itemsize:\n            _raise("clSetKernelArg", "INVALID_ARG_SIZE", "參數 %s 要 %d 個 %s（%d 位元組），得到 %d 位元組" % (spec["name"], n, base, n * dt.itemsize, len(raw)))\n        vals = np.frombuffer(raw[:n * dt.itemsize], dtype=dt)\n    if len(vals) != n:\n        _raise("clSetKernelArg", "INVALID_ARG_SIZE", "參數 %s 要 %d 個元素，得到 %d" % (spec["name"], n, len(vals)))\n    return vals.tolist()\n\n\nclass LocalMemory(object):\n    def __init__(self, size):\n        self.size = size\n\n\n# struct 風格的型別字元（pyopencl 的呼叫器用 pack(\'f\', x) 與 BUF_PACK_TYPECHARS）→ numpy 型別\n_PACK_DTYPE = {"c": "S1", "b": "i1", "B": "u1", "h": "i2", "H": "u2", "i": "i4", "I": "u4", "l": "l", "L": "L", "q": "i8", "Q": "u8", "f": "f4", "d": "f8"}\n\n\nclass Kernel(_Handle):\n    _info_enums = (kernel_info,)\n    _gen_enqueue = None\n    _gen_set_args = None\n\n    def __init__(self, program, name):\n        prog = getattr(program, "_prg", program)\n        res, _ = _call("kernel_create", {"prog": prog._h, "name": name})\n        self._h, self._prog, self._name, self._args = res["h"], prog, name, res["args"]\n        self._program_obj = program\n\n    def get_info(self, param):\n        p = int(param)\n        if p == kernel_info.FUNCTION_NAME:\n            return self._name\n        if p == kernel_info.NUM_ARGS:\n            return len(self._args)\n        if p == kernel_info.CONTEXT:\n            return self._prog._ctx\n        if p == kernel_info.PROGRAM:\n            return self._program_obj\n        if p == kernel_info.ATTRIBUTES:\n            return ""\n        if p == kernel_info.REFERENCE_COUNT:\n            return 1\n        _info_error("clGetKernelInfo", param)\n\n    def get_work_group_info(self, param, device):\n        """（真 pyopencl 的 _monkeypatch 會包一層快取。）這個後端是一維逐元素核心：不分工作群，數值是保守的固定值。"""\n        p = int(param)\n        d = device\n        if p == kernel_work_group_info.WORK_GROUP_SIZE:\n            return d._rec["max_work_group_size"]\n        if p == kernel_work_group_info.PREFERRED_WORK_GROUP_SIZE_MULTIPLE:\n            return 1\n        if p in (kernel_work_group_info.LOCAL_MEM_SIZE, kernel_work_group_info.PRIVATE_MEM_SIZE):\n            return 0\n        if p in (kernel_work_group_info.COMPILE_WORK_GROUP_SIZE, kernel_work_group_info.GLOBAL_WORK_SIZE):\n            return [0, 0, 0]\n        _info_error("clGetKernelWorkGroupInfo", param)\n\n    def clone(self):\n        k = Kernel(self._program_obj, self._name)\n        k._gen_enqueue, k._gen_set_args = self._gen_enqueue, self._gen_set_args\n        return k\n\n    def set_arg(self, index, arg):\n        if not (0 <= index < len(self._args)):\n            _raise("clSetKernelArg", "INVALID_ARG_INDEX", "核心 %s 只有 %d 個參數" % (self._name, len(self._args)))\n        spec = self._args[index]\n        svm_map = self.__dict__.setdefault("_svm", {})\n        svm_map.pop(index, None)\n        if isinstance(arg, SVMPointer):\n            if spec["kind"] != "buf":\n                _raise("clSetKernelArgSVMPointer", "INVALID_ARG_VALUE", "參數 %s 不是指標，不能傳 SVM 指標" % spec["name"])\n            a, off = _svm_resolve(int(arg.svm_ptr), "clSetKernelArgSVMPointer")\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "mem": a._as_buffer(off, a._size - off) if off else a._buf_h})\n            svm_map[index] = a\n            return\n        if isinstance(arg, LocalMemory):\n            if spec["kind"] != "local":\n                _raise("clSetKernelArg", "INVALID_ARG_VALUE", "參數 %s 不是 __local 指標，不能傳 LocalMemory（這個驅動只有 OpenCL C 前端支援 __local）" % spec["name"])\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "local": int(arg.size)})\n            return\n        if spec["kind"] == "local":\n            _raise("clSetKernelArg", "INVALID_ARG_SIZE", "參數 %s 是 __local 指標，要傳 LocalMemory(位元組數)" % spec["name"])\n        if spec["kind"] == "pipe":\n            if not isinstance(arg, Pipe):\n                _raise("clSetKernelArg", "INVALID_MEM_OBJECT", "參數 %s 要傳 Pipe，得到 %s" % (spec["name"], type(arg).__name__))\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "mem": arg._h})\n            return\n        if isinstance(arg, Pipe):\n            _raise("clSetKernelArg", "INVALID_MEM_OBJECT", "參數 %s 不是 pipe，不能傳 Pipe" % spec["name"])\n        if spec["kind"] == "image":\n            if not isinstance(arg, Image):\n                _raise("clSetKernelArg", "INVALID_MEM_OBJECT", "參數 %s 要傳 Image，得到 %s" % (spec["name"], type(arg).__name__))\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "mem": arg._h})\n            return\n        if spec["kind"] == "buf":\n            if isinstance(arg, Image):\n                _raise("clSetKernelArg", "INVALID_MEM_OBJECT", "參數 %s 是緩衝區指標，不能傳圖像" % spec["name"])\n            if not isinstance(arg, MemoryObjectHolder):\n                _raise("clSetKernelArg", "INVALID_MEM_OBJECT", "參數 %s 要傳 Buffer，得到 %s" % (spec["name"], type(arg).__name__))\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "mem": arg._h})\n            return\n        if isinstance(arg, MemoryObjectHolder):\n            _raise("clSetKernelArg", "INVALID_ARG_SIZE", "參數 %s 是純量，不能傳緩衝區" % spec["name"])\n        if isinstance(arg, Sampler):\n            if spec["type"] != "uint":\n                _raise("clSetKernelArg", "INVALID_SAMPLER", "參數 %s（%s）不是 sampler_t" % (spec["name"], spec["type"]))\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "scalar": arg._bits})\n            return\n        if _is_vector_type(spec["type"]):\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "scalar": _vector_arg_values(spec, arg)})\n            return\n        if spec["type"] == "struct":   # struct 傳值（例如複數 cfloat_t）：numpy 純量（complex64、結構化 np.void）或位元組\n            raw = bytes(arg) if isinstance(arg, (bytes, bytearray)) else np.asarray(arg).tobytes()\n            if spec.get("size") and len(raw) != spec["size"]:\n                _raise("clSetKernelArg", "INVALID_ARG_SIZE", "參數 %s（struct）要 %d 位元組，得到 %d" % (spec["name"], spec["size"], len(raw)))\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "scalar": list(raw)})\n            return\n        a = np.asarray(arg)\n        if a.ndim != 0 and a.size != 1:\n            _raise("clSetKernelArg", "INVALID_ARG_SIZE", "純量參數 %s 要傳單一個 numpy 純量" % spec["name"])\n        want = _SCALAR_DTYPE.get(spec["type"])\n        if want is None:\n            _raise("clSetKernelArg", "INVALID_ARG_VALUE", "參數 %s 的型別 %s 這個後端不認得" % (spec["name"], spec["type"]))\n        wk, wsz, wname = want\n        if a.dtype.itemsize != wsz or (a.dtype.kind in "iub") != (wk == "i"):   # 大小要對；整數與浮點不能混（真 OpenCL 只看大小，但會把位元重新解讀，這裡寧可明確報錯）\n            _raise("clSetKernelArg", "INVALID_ARG_SIZE", "參數 %s 要是 %s（%d 位元組），得到 %s——請用 numpy.%s(...)" % (spec["name"], wname, wsz, a.dtype, wname))\n        _call("kernel_set_arg", {"kernel": self._h, "index": index, "scalar": a.item()})\n\n    def set_args(self, *args):\n        if self._gen_set_args is not None:\n            return self._gen_set_args(self, *args)\n        for i, a in enumerate(args):\n            self.set_arg(i, a)\n\n    # ---- pyopencl 的 set_scalar_arg_dtypes 產生的呼叫器用到的私有方法（真 _cl 的 C++ 類別提供）----\n    def _set_enqueue_and_set_args(self, enqueue, set_args):   # pyopencl.invoker.generate_enqueue_and_set_args 回傳的兩個產生出來的函式\n        self._gen_enqueue, self._gen_set_args = enqueue, set_args\n\n    def _set_arg_multi(self, seq):   # (idx, 物件, idx, 物件, …)\n        for k in range(0, len(seq), 2):\n            self.set_arg(seq[k], seq[k + 1])\n\n    def _set_arg_buf(self, index, data):   # 原始位元組（pack 的結果）→ 依核心參數的型別解讀\n        spec = self._args[index]\n        if spec["kind"] == "scalar" and spec["type"] == "struct":\n            if spec.get("size") and len(data) != spec["size"]:\n                _raise("clSetKernelArg", "INVALID_ARG_SIZE", "參數 %s（struct）要 %d 位元組，得到 %d" % (spec["name"], spec["size"], len(data)))\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "scalar": list(bytes(data))})\n            return\n        if spec["kind"] == "scalar" and _is_vector_type(spec["type"]):\n            _call("kernel_set_arg", {"kernel": self._h, "index": index, "scalar": _vector_arg_values(spec, bytes(data))})\n            return\n        want = _SCALAR_DTYPE.get(spec["type"]) if spec["kind"] == "scalar" else None\n        if want is None:\n            _raise("clSetKernelArg", "INVALID_ARG_VALUE", "參數 %s 不是純量" % spec["name"])\n        if len(data) != want[1]:\n            _raise("clSetKernelArg", "INVALID_ARG_SIZE", "參數 %s 要 %d 位元組，得到 %d" % (spec["name"], want[1], len(data)))\n        self.set_arg(index, np.frombuffer(bytes(data), dtype=want[2])[0])\n\n    def _set_arg_buf_multi(self, seq):   # (idx, 位元組, idx, 位元組, …)\n        for k in range(0, len(seq), 2):\n            self._set_arg_buf(seq[k], seq[k + 1])\n\n    def _set_arg_buf_pack_multi(self, seq):   # (idx, 型別字元(bytes), 值, …)\n        for k in range(0, len(seq), 3):\n            tc = seq[k + 1].decode() if isinstance(seq[k + 1], (bytes, bytearray)) else seq[k + 1]\n            self.set_arg(seq[k], np.array(seq[k + 2], dtype=_PACK_DTYPE[tc])[()])\n\n    def get_arg_info(self, index, param_name):\n        if not (0 <= index < len(self._args)):\n            _raise("clGetKernelArgInfo", "INVALID_ARG_INDEX", "核心 %s 只有 %d 個參數" % (self._name, len(self._args)))\n        spec, p = self._args[index], int(param_name)\n        if p == kernel_arg_info.NAME:\n            return spec["name"]\n        if p == kernel_arg_info.ADDRESS_QUALIFIER:\n            return {"buf": kernel_arg_address_qualifier.GLOBAL, "local": kernel_arg_address_qualifier.LOCAL}.get(spec["kind"], kernel_arg_address_qualifier.PRIVATE)\n        if p == kernel_arg_info.ACCESS_QUALIFIER:\n            return kernel_arg_access_qualifier.NONE\n        if p == kernel_arg_info.TYPE_NAME:\n            tn = {"i32": "int", "f32": "float"}.get(spec["type"], spec["type"])   # KIR 驅動用 i32／f32，其餘用 OpenCL C 的型別名\n            return tn + "*" if spec["kind"] != "scalar" else tn\n        if p == kernel_arg_info.TYPE_QUALIFIER:\n            return kernel_arg_type_qualifier.CONST if spec.get("access") == "in" else kernel_arg_type_qualifier.NONE\n        _info_error("clGetKernelArgInfo", param_name)\n\n    def get_sub_group_info(self, device, param, input_value=None):\n        """沒有 SIMD 子群組：每個子群組就是 1 個工作項（OpenCL 規定的合法最小值）。"""\n        p = int(param)\n        if p == kernel_sub_group_info.MAX_SUB_GROUP_SIZE_FOR_NDRANGE:\n            return 1\n        if p == kernel_sub_group_info.SUB_GROUP_COUNT_FOR_NDRANGE:\n            n = 1\n            for x in (input_value if input_value is not None else ()):\n                n *= int(x)\n            return n\n        if p == kernel_sub_group_info.LOCAL_SIZE_FOR_SUB_GROUP_COUNT:\n            return [int(input_value), 1, 1]\n        if p == kernel_sub_group_info.MAX_NUM_SUB_GROUPS:\n            return device._rec["max_work_group_size"]\n        if p == kernel_sub_group_info.COMPILE_NUM_SUB_GROUPS:\n            return 0\n        _info_error("clGetKernelSubGroupInfo", param)\n\n    def __call__(self, queue, global_work_size, local_work_size, *args, **kwargs):\n        if self._gen_enqueue is not None:   # 呼叫過 set_scalar_arg_dtypes：用 pyopencl 產生的呼叫器\n            return self._gen_enqueue(self, queue, global_work_size, local_work_size, *args, **kwargs)\n        wait_for = kwargs.pop("wait_for", None)\n        g_times_l = kwargs.pop("g_times_l", False)\n        allow_empty_ndrange = kwargs.pop("allow_empty_ndrange", False)\n        global_offset = kwargs.pop("global_offset", None)\n        if kwargs:\n            raise TypeError("不認得的參數：%s" % ", ".join(kwargs))\n        self.set_args(*args)\n        return enqueue_nd_range_kernel(queue, self, global_work_size, local_work_size, global_offset, wait_for,\n                                       g_times_l=g_times_l, allow_empty_ndrange=allow_empty_ndrange)\n\n    def __del__(self):\n        try:\n            self.release()\n        except Exception:\n            pass\n\n\n# ---------------------------------------------------------------------------------------------\n# 模組函式\n# ---------------------------------------------------------------------------------------------\n\ndef get_platforms():\n    res, _ = _call("platforms")\n    if not res["platforms"]:\n        _raise("clGetPlatformIDs", "PLATFORM_NOT_FOUND_KHR")\n    return [Platform(p) for p in res["platforms"]]\n\n\ndef get_cl_header_version():\n    return (2, 0)   # 真 pyopencl 層只拿它決定要不要啟用 SVM 的程式碼（_monkeypatch／array／tools）；執行期版本照裝置回報\n\n\ndef have_gl():\n    return True   # GL 互通（cl_khr_gl_sharing 的 GLBuffer）：緩衝區走 fa_opengl_platform 的 interop 鉤子；圖像與紋理不支援\n\n\ndef _sizeof_size_t():\n    return 8   # 這個後端的 OpenCL C 前端把 size_t 當 64 位元（ulong）\n\n\ndef bitlog2(x):\n    return int(x).bit_length() - 1\n\n\ndef enqueue_nd_range_kernel(queue, kernel, global_work_size, local_work_size, global_offset=None, wait_for=None,\n                            g_times_l=False, allow_empty_ndrange=False):   # pyi 寫成關鍵字專用，但 pyopencl 的呼叫器是位置傳入\n    gws = [int(x) for x in global_work_size]\n    lws = None if local_work_size is None else [int(x) for x in local_work_size]\n    goff = None if global_offset is None else [int(x) for x in global_offset]\n    if lws is not None and len(lws) != len(gws):\n        _raise("clEnqueueNDRangeKernel", "INVALID_WORK_DIMENSION", "global 與 local 的維度不同")\n    if g_times_l and lws is not None:\n        gws = [g * l for g, l in zip(gws, lws)]\n    if any(g == 0 for g in gws):\n        if allow_empty_ndrange:\n            return Event({"h": -1, "cmd": "kernel", "queued": 0, "start": 0, "end": 0}, queue)\n        _raise("clEnqueueNDRangeKernel", "INVALID_GLOBAL_WORK_SIZE", "global size 不能是 0")\n    svms = list(dict.fromkeys(getattr(kernel, "_svm", {}).values()))   # 帶 SVM 參數：啟動前推、啟動後拉（見 SVM 區塊說明）\n    for a in svms:\n        a._push(queue)\n    res, _ = _call("nd_range", {"queue": queue._h, "kernel": kernel._h, "global": gws, "local": lws, "offset": goff})\n    for a in svms:\n        a._pull(queue)\n    return Event(res["event"], queue)\n\n\ndef _wr(queue, res):\n    return Event(res["event"], queue)\n\n\ndef _enqueue_read_buffer(queue, mem, hostbuf, src_offset=0, wait_for=None, is_blocking=True):\n    mv = _byte_view(hostbuf)\n    res, payload = _call("buf_read", {"queue": queue._h, "mem": mem._h, "offset": int(src_offset), "size": len(mv)})\n    mv[:] = payload\n    return _wr(queue, res)\n\n\ndef _enqueue_write_buffer(queue, mem, hostbuf, dst_offset=0, wait_for=None, is_blocking=True):\n    res, _ = _call("buf_write", {"queue": queue._h, "mem": mem._h, "offset": int(dst_offset)}, _as_bytes(hostbuf))\n    return _wr(queue, res)\n\n\ndef _enqueue_copy_buffer(queue, src, dst, byte_count=-1, src_offset=0, dst_offset=0, wait_for=None):\n    size = None if byte_count in (-1, None) else int(byte_count)\n    if size is None:\n        size = min(src._size - int(src_offset), dst._size - int(dst_offset))\n    res, _ = _call("buf_copy", {"queue": queue._h, "src": src._h, "dst": dst._h, "size": size, "src_offset": int(src_offset), "dst_offset": int(dst_offset)})\n    return _wr(queue, res)\n\n\ndef _enqueue_fill_buffer(queue, mem, pattern, offset, size, wait_for=None):\n    res, _ = _call("buf_fill", {"queue": queue._h, "mem": mem._h, "offset": int(offset), "size": int(size)}, _as_bytes(pattern))\n    return _wr(queue, res)\n\n\n# ---------------------------------------------------------------------------------------------\n# 配置器與記憶體池（pyopencl.array 與 tools 靠它們配置緩衝區）\n# ---------------------------------------------------------------------------------------------\n\nclass NameVersion(object):\n    def __init__(self, version=0, name=""):\n        self.version, self.name = version, name\n\n\nclass AllocatorBase(object):\n    def __call__(self, size):\n        raise NotImplementedError\n\n\nclass DeferredAllocator(AllocatorBase):\n    """每次呼叫配置一個 Buffer（真 pyopencl 的 DeferredAllocator：不保證配置當下就有實體記憶體）。"""\n\n    def __init__(self, context, mem_flags=mem_flags.READ_WRITE):\n        self._context, self._flags = context, mem_flags\n\n    def __call__(self, size):\n        return Buffer(self._context, self._flags, size)\n\n\nclass ImmediateAllocator(AllocatorBase):\n    """同 DeferredAllocator，但接受佇列（真的會在配置時確保記憶體可用；這個後端的緩衝區本來就是配置時建立，所以行為相同）。"""\n\n    def __init__(self, queue, mem_flags=mem_flags.READ_WRITE):\n        self._queue, self._context, self._flags = queue, queue._ctx, mem_flags\n\n    def __call__(self, size):\n        return Buffer(self._context, self._flags, size)\n\n\nclass PooledBuffer(MemoryObjectHolder):\n    """MemoryPool 配置出來的區塊。release() 把區塊還給池子（留著重用），不是真的釋放。"""\n\n    def __init__(self, pool, buf, bin_nr):\n        self._pool, self._buf, self._bin = pool, buf, bin_nr\n        self._h, self._ctx, self._size, self._flags = buf._h, buf._ctx, buf._size, buf._flags\n\n    def release(self):\n        pool, self._pool = self._pool, None\n        if pool is None:\n            _raise("PooledBuffer.release", "INVALID_VALUE", "區塊已經還給池子了")\n        pool._return(self._buf, self._bin)\n\n    def bind_to_queue(self, queue):\n        return None\n\n    def unbind_from_queue(self):\n        return None\n\n    def __del__(self):\n        if getattr(self, "_pool", None) is not None:\n            try:\n                self.release()\n            except Exception:\n                pass\n\n\nclass MemoryPool(AllocatorBase):\n    """依大小分箱的緩衝區池（與真 pyopencl 的 MemoryPool 同一個分箱規則：指數加 leading_bits_in_bin_id 位元的尾數；\n    箱號與 alloc_size 的算法照 pyopencl／pycuda 的 memory_pool.hpp 憑記憶寫，**沒有對照原始碼逐值驗證**，測試只驗不變式）。\n    執行期優化：被還回來的區塊留在池裡，下次同一箱的配置直接重用（裝置端緩衝區與其內容狀態一併重用，省掉重新配置）。"""\n\n    def __init__(self, allocator, leading_bits_in_bin_id=4):\n        self._alloc, self._mb = allocator, int(leading_bits_in_bin_id)\n        self._free, self._active, self._held_bytes, self._active_bytes, self._holding = {}, 0, 0, 0, True\n\n    @staticmethod\n    def _shl(x, s):\n        return x << s if s >= 0 else x >> -s\n\n    def bin_number(self, size):\n        size = int(size)\n        if size <= 0:\n            return 0\n        mb = self._mb\n        l = bitlog2(size)\n        shifted = self._shl(size, mb - l)\n        return (l << mb) | (shifted & ((1 << mb) - 1))\n\n    def alloc_size(self, bin_nr):\n        mb = self._mb\n        exponent, mantissa = bin_nr >> mb, bin_nr & ((1 << mb) - 1)\n        ones = self._shl(1, exponent - mb)\n        if ones:\n            ones -= 1\n        head = self._shl((1 << mb) | mantissa, exponent - mb)\n        return head | ones\n\n    def allocate(self, size):\n        size = int(size)\n        b = self.bin_number(size)\n        lst = self._free.get(b)\n        if lst:\n            buf = lst.pop()\n            self._held_bytes -= buf._size\n        else:\n            buf = self._alloc(self.alloc_size(b))\n        self._active += 1\n        self._active_bytes += buf._size\n        return PooledBuffer(self, buf, b)\n\n    __call__ = allocate\n\n    def _return(self, buf, b):\n        self._active -= 1\n        self._active_bytes -= buf._size\n        if self._holding:\n            self._free.setdefault(b, []).append(buf)\n            self._held_bytes += buf._size\n        else:\n            buf.release()\n\n    @property\n    def held_blocks(self):\n        return sum(len(v) for v in self._free.values())\n\n    @property\n    def active_blocks(self):\n        return self._active\n\n    @property\n    def managed_bytes(self):\n        return self._held_bytes + self._active_bytes\n\n    @property\n    def active_bytes(self):\n        return self._active_bytes\n\n    def free_held(self):\n        for lst in self._free.values():\n            for buf in lst:\n                buf.release()\n        self._free, self._held_bytes = {}, 0\n\n    def stop_holding(self):\n        self._holding = False\n        self.free_held()\n\n    def __del__(self):\n        try:\n            self.free_held()\n        except Exception:\n            pass\n\n\nclass UserEvent(Event):\n    def __init__(self, context):\n        self._h, self._rec, self._queue, self._status = -1, {"h": -1, "cmd": "user", "queued": 0, "start": 0, "end": 0}, None, command_execution_status.QUEUED\n\n    def set_status(self, status):\n        self._status = status\n\n    def get_info(self, param):\n        if int(param) == event_info.COMMAND_EXECUTION_STATUS:\n            return self._status\n        return Event.get_info(self, param)\n\n\n# ---------------------------------------------------------------------------------------------\n# 圖像與取樣器（OpenCL C 前端的 read_image*／write_image*）。圖像在載入器裡是一塊緊密排列的緩衝區加格式描述；核心只走主機路線（clc）。\n# 支援：IMAGE1D／1D_ARRAY／2D／2D_ARRAY／3D；所有「非打包」的通道型別（UNORM／SNORM 8／16、SIGNED／UNSIGNED 8／16／32、HALF_FLOAT、FLOAT）\n# 與通道順序（R A RG RA RGBA BGRA ARGB INTENSITY LUMINANCE Rx RGx），以及打包型別 565／555／101010（配 RGB／RGBx）；IMAGE1D_BUFFER 與緩衝區共用記憶體。\n# 不支援（如實回報，不假裝）：mip 層級與多重取樣。\n# ---------------------------------------------------------------------------------------------\n_CH_ORDER_NAMES = ["R", "A", "RG", "RA", "RGB", "RGBA", "BGRA", "ARGB", "INTENSITY", "LUMINANCE", "Rx", "RGx", "RGBx"]\n_CH_TYPE_NAMES = ["SNORM_INT8", "SNORM_INT16", "UNORM_INT8", "UNORM_INT16", "UNORM_SHORT_565", "UNORM_SHORT_555", "UNORM_INT_101010",\n                  "SIGNED_INT8", "SIGNED_INT16", "SIGNED_INT32", "UNSIGNED_INT8", "UNSIGNED_INT16", "UNSIGNED_INT32", "HALF_FLOAT", "FLOAT"]\n_CH_COUNT = {"R": 1, "A": 1, "RG": 2, "RA": 2, "RGB": 3, "RGBA": 4, "BGRA": 4, "ARGB": 4, "INTENSITY": 1, "LUMINANCE": 1, "Rx": 2, "RGx": 3, "RGBx": 4}\n_CH_BYTES = {"SNORM_INT8": 1, "UNORM_INT8": 1, "SIGNED_INT8": 1, "UNSIGNED_INT8": 1, "SNORM_INT16": 2, "UNORM_INT16": 2, "SIGNED_INT16": 2,\n             "UNSIGNED_INT16": 2, "HALF_FLOAT": 2, "SIGNED_INT32": 4, "UNSIGNED_INT32": 4, "FLOAT": 4,\n             "UNORM_SHORT_565": 2, "UNORM_SHORT_555": 2, "UNORM_INT_101010": 4}\n_CH_PACKED = ("UNORM_SHORT_565", "UNORM_SHORT_555", "UNORM_INT_101010")\n\n\ndef _elem_size(order, ctype):\n    if ctype in _CH_PACKED:\n        return _CH_BYTES[ctype]\n    return _CH_COUNT.get(order, 0) * _CH_BYTES.get(ctype, 0)\n_IMG_TYPE_NAME = {0x10f1: "image2d", 0x10f2: "image3d", 0x10f3: "image2d_array", 0x10f4: "image1d", 0x10f5: "image1d_array", 0x10f6: "image1d_buffer"}\n\n\ndef _order_name(v):\n    i = int(v) - 0x10b0\n    return _CH_ORDER_NAMES[i] if 0 <= i < len(_CH_ORDER_NAMES) else None\n\n\ndef _type_name(v):\n    i = int(v) - 0x10d0\n    return _CH_TYPE_NAMES[i] if 0 <= i < len(_CH_TYPE_NAMES) else None\n\n\nclass ImageFormat(object):\n    def __init__(self, channel_order=0, channel_data_type=0):\n        self.channel_order, self.channel_data_type = int(channel_order), int(channel_data_type)\n\n    @property\n    def channel_count(self):\n        return _CH_COUNT.get(_order_name(self.channel_order), 0)\n\n    @property\n    def dtype_size(self):\n        return _CH_BYTES.get(_type_name(self.channel_data_type), 0)\n\n    @property\n    def itemsize(self):\n        return _elem_size(_order_name(self.channel_order), _type_name(self.channel_data_type))\n\n\nclass ImageDescriptor(object):\n    def __init__(self):\n        self.image_type, self._shape, self._pitches = mem_object_type.IMAGE2D, (0, 0, 0), (0, 0)\n        self.num_mip_levels, self.num_samples, self.buffer = 0, 0, None\n\n    @property\n    def shape(self):\n        return tuple(self._shape) + (0,) * (3 - len(self._shape))\n\n    @shape.setter\n    def shape(self, value):\n        value = tuple(int(x) for x in value)\n        if not 1 <= len(value) <= 3:\n            _raise("ImageDescriptor", "INVALID_VALUE", "shape 要有 1–3 個元素")\n        self._shape = value\n\n    @property\n    def array_size(self):\n        t = int(self.image_type)\n        return self._shape[-1] if t in (mem_object_type.IMAGE1D_ARRAY, mem_object_type.IMAGE2D_ARRAY) and len(self._shape) else 0\n\n    @array_size.setter\n    def array_size(self, value):\n        pass\n\n    @property\n    def pitches(self):\n        return self._pitches\n\n    @pitches.setter\n    def pitches(self, value):\n        self._pitches = (tuple(int(x) for x in value) + (0, 0))[:2]\n\n\ndef _image_geometry(desc):\n    """描述 → (載入器的型別名, w, h, d)。陣列型別的層數放在最後一維（1D 陣列在 h、2D 陣列在 d）。"""\n    t = int(desc.image_type)\n    name = _IMG_TYPE_NAME.get(t)\n    sh = tuple(desc._shape)\n    if name is None:\n        _raise("clCreateImage", "INVALID_IMAGE_DESCRIPTOR", "不認得的圖像型別 0x%x" % t)\n    if name == "image1d_buffer" and desc.buffer is None:\n        _raise("clCreateImage", "INVALID_IMAGE_DESCRIPTOR", "IMAGE1D_BUFFER 要給 buffer")\n    need = {"image1d": 1, "image1d_buffer": 1, "image2d": 2, "image3d": 3, "image1d_array": 2, "image2d_array": 3}[name]\n    if len(sh) != need or any(x <= 0 for x in sh):\n        _raise("clCreateImage", "INVALID_IMAGE_SIZE", "%s 需要 %d 個正整數的尺寸，得到 %s" % (name, need, sh))\n    return name, sh[0], (sh[1] if need >= 2 else 1), (sh[2] if need == 3 else 1)\n\n\ndef _region3(v, default):\n    v = tuple(int(x) for x in v)\n    return v + (default,) * (3 - len(v))\n\n\ndef _pack_region(hostmv, region, elem, row_pitch, slice_pitch):\n    """主機陣列（可能有 row／slice pitch）→ 緊密排列的 region 位元組（x 最快）"""\n    w, h, d = region\n    rowb = w * elem\n    rp = int(row_pitch) or rowb\n    sp = int(slice_pitch) or rp * h\n    if rp == rowb and sp == rowb * h:\n        n = rowb * h * d\n        if len(hostmv) < n:\n            _raise("clEnqueueWriteImage", "INVALID_VALUE", "主機緩衝（%d 位元組）比 region（%d）小" % (len(hostmv), n))\n        return bytes(hostmv[:n])\n    out = bytearray()\n    for z in range(d):\n        for y in range(h):\n            o = z * sp + y * rp\n            if o + rowb > len(hostmv):\n                _raise("clEnqueueWriteImage", "INVALID_VALUE", "主機緩衝太小（pitch 之下 region 需要更多位元組）")\n            out += hostmv[o:o + rowb]\n    return bytes(out)\n\n\ndef _unpack_region(hostmv, data, region, elem, row_pitch, slice_pitch):\n    w, h, d = region\n    rowb = w * elem\n    rp = int(row_pitch) or rowb\n    sp = int(slice_pitch) or rp * h\n    if rp == rowb and sp == rowb * h:\n        if len(hostmv) < len(data):\n            _raise("clEnqueueReadImage", "INVALID_VALUE", "主機緩衝（%d 位元組）比 region（%d）小" % (len(hostmv), len(data)))\n        hostmv[:len(data)] = data\n        return\n    for z in range(d):\n        for y in range(h):\n            o, i = z * sp + y * rp, (z * h + y) * rowb\n            if o + rowb > len(hostmv):\n                _raise("clEnqueueReadImage", "INVALID_VALUE", "主機緩衝太小（pitch 之下 region 需要更多位元組）")\n            hostmv[o:o + rowb] = data[i:i + rowb]\n\n\nclass Image(MemoryObject):\n    _info_enums = (mem_info, image_info)\n    _parent = None\n    _offset = 0\n\n    def __init__(self, context, flags, format, shape=None, pitches=None, hostbuf=None, is_array=False, buffer=None, *, desc=None, _through_create_image=False):\n        if desc is None:\n            if shape is None:\n                if hostbuf is None:\n                    _raise("clCreateImage", "INVALID_VALUE", "\'shape\' 沒給時要給 hostbuf")\n                shape = tuple(hostbuf.shape)\n            shape = tuple(int(x) for x in shape)\n            desc = ImageDescriptor()\n            desc.buffer = buffer\n            desc.image_type = {1: mem_object_type.IMAGE1D_BUFFER if buffer is not None else mem_object_type.IMAGE1D, 2: mem_object_type.IMAGE1D_ARRAY if is_array else mem_object_type.IMAGE2D,\n                               3: mem_object_type.IMAGE2D_ARRAY if is_array else mem_object_type.IMAGE3D}.get(len(shape))\n            if desc.image_type is None:\n                _raise("clCreateImage", "INVALID_IMAGE_DESCRIPTOR", "圖像不能有 %d 維" % len(shape))\n            desc.shape = shape\n            desc.pitches = pitches or (0, 0)\n        self._init_from(context, flags, format, desc, hostbuf)\n\n    @staticmethod\n    def _custom_init(h, context, flags, format, a, b=None, c=None):\n        if isinstance(a, ImageDescriptor):\n            h._init_from(context, flags, format, a, b)\n        else:   # 舊式：(shape, pitches, hostbuf)\n            d = ImageDescriptor()\n            a = tuple(a)\n            d.image_type = {2: mem_object_type.IMAGE2D, 3: mem_object_type.IMAGE3D}.get(len(a))\n            if d.image_type is None:\n                _raise("clCreateImage2D", "INVALID_IMAGE_DESCRIPTOR", "舊式建構只支援 2D／3D")\n            d.shape, d.pitches = a, (b or (0, 0))\n            h._init_from(context, flags, format, d, c)\n\n    def _init_from(self, context, flags, format, desc, hostbuf):\n        flags = int(flags)\n        name, w, h, d = _image_geometry(desc)\n        if (desc.buffer is not None) != (name == "image1d_buffer"):\n            _raise("clCreateImage", "INVALID_IMAGE_DESCRIPTOR", "只有 IMAGE1D_BUFFER 帶 buffer")\n        order, ctype = _order_name(format.channel_order), _type_name(format.channel_data_type)\n        data = None\n        if hostbuf is not None or flags & (mem_flags.COPY_HOST_PTR | mem_flags.USE_HOST_PTR):\n            if hostbuf is None:\n                _raise("clCreateImage", "INVALID_HOST_PTR", "COPY_HOST_PTR／USE_HOST_PTR 需要 hostbuf")\n            elem = _elem_size(order, ctype)\n            data = _pack_region(_byte_view(hostbuf), (w, h, d), elem, *(tuple(desc.pitches) + (0, 0))[:2]) if elem else None\n        res, _ = _call("img_create", {"ctx": context._h, "flags": flags, "type": name, "w": w, "h": h, "d": d, "order": order, "chType": ctype, "buffer": desc.buffer._h if desc.buffer is not None else None}, data)\n        self._h, self._ctx, self._flags, self._size = res["h"], context, flags, int(res["size"])\n        self._format, self._elem, self._name, self._dims = ImageFormat(format.channel_order, format.channel_data_type), int(res["elem"]), name, (w, h, d)\n        self._mtype, self._buffer = {v: k for k, v in _IMG_TYPE_NAME.items()}[name], desc.buffer\n\n    def get_info(self, param):\n        if int(param) == mem_info.TYPE:\n            return self._mtype\n        if 0x1110 <= int(param) <= 0x111a:   # image_info 的範圍：`.width` 之類的屬性後備走 get_info\n            return self.get_image_info(param)\n        return MemoryObjectHolder.get_info(self, param)\n\n    def get_image_info(self, param):\n        p, (w, h, d) = int(param), self._dims\n        arr = self._name.endswith("_array")\n        if p == image_info.FORMAT:\n            return self._format\n        if p == image_info.ELEMENT_SIZE:\n            return self._elem\n        if p == image_info.ROW_PITCH:\n            return w * self._elem\n        if p == image_info.SLICE_PITCH:\n            return w * h * self._elem if self._name in ("image3d", "image2d_array", "image1d_array") else 0\n        if p == image_info.WIDTH:\n            return w\n        if p == image_info.HEIGHT:\n            return h if self._name in ("image2d", "image3d", "image2d_array") else 0\n        if p == image_info.DEPTH:\n            return d if self._name == "image3d" else 0\n        if p == image_info.ARRAY_SIZE:\n            return (h if self._name == "image1d_array" else d) if arr else 0\n        if p == image_info.BUFFER:\n            return self._buffer\n        if p in (image_info.NUM_MIP_LEVELS, image_info.NUM_SAMPLES):\n            return 0\n        _info_error("clGetImageInfo", param)\n\n    def __repr__(self):\n        return "<pyopencl.Image %s %dx%dx%d %s>" % (self._name, self._dims[0], self._dims[1], self._dims[2], self._format)\n\n\nclass Sampler(_Handle):\n    """取樣器是一個位元欄位（正規化座標｜定址模式｜過濾模式），核心端的 sampler_t 就是 uint——不需要宿主端的物件。"""\n    _ADDR = {int(addressing_mode.NONE): 0, int(addressing_mode.CLAMP_TO_EDGE): 2, int(addressing_mode.CLAMP): 4, int(addressing_mode.REPEAT): 6, int(addressing_mode.MIRRORED_REPEAT): 8}\n    _FILT = {int(filter_mode.NEAREST): 16, int(filter_mode.LINEAR): 32}\n    _info_enums = (sampler_info,)\n\n    def __init__(self, context, *args):\n        if len(args) == 1:\n            props = list(args[0])\n            if props and props[-1] == 0:\n                props = props[:-1]\n            if len(props) % 2:\n                _raise("clCreateSamplerWithProperties", "INVALID_VALUE", "properties 要是（鍵, 值）成對")\n            kv = {int(props[i]): props[i + 1] for i in range(0, len(props), 2)}\n            norm = kv.get(int(sampler_properties.NORMALIZED_COORDS), True)\n            addr = kv.get(int(sampler_properties.ADDRESSING_MODE), addressing_mode.CLAMP)\n            filt = kv.get(int(sampler_properties.FILTER_MODE), filter_mode.NEAREST)\n        elif len(args) == 3:\n            norm, addr, filt = args\n        else:\n            _raise("clCreateSampler", "INVALID_VALUE", "Sampler(context, normalized_coords, addressing_mode, filter_mode) 或 Sampler(context, properties)")\n        if int(addr) not in self._ADDR or int(filt) not in self._FILT:\n            _raise("clCreateSampler", "INVALID_VALUE", "不認得的定址或過濾模式")\n        self._ctx, self._norm, self._addr, self._filt = context, bool(norm), int(addr), int(filt)\n        self._bits = (1 if self._norm else 0) | self._ADDR[self._addr] | self._FILT[self._filt]\n        self._h = -3\n\n    def release(self):\n        pass\n\n    def get_info(self, param):\n        p = int(param)\n        if p == sampler_info.REFERENCE_COUNT:\n            return 1\n        if p == sampler_info.CONTEXT:\n            return self._ctx\n        if p == sampler_info.NORMALIZED_COORDS:\n            return self._norm\n        if p == sampler_info.ADDRESSING_MODE:\n            return self._addr\n        if p == sampler_info.FILTER_MODE:\n            return self._filt\n        _info_error("clGetSamplerInfo", param)\n\n    def __eq__(self, other):\n        return isinstance(other, Sampler) and (other._bits, other._ctx) == (self._bits, self._ctx)\n\n    def __hash__(self):\n        return hash(("Sampler", self._bits))\n\n\nclass Pipe(MemoryObject):\n    """OpenCL 2.0 的 Pipe：只有核心能讀寫（規格也是）；核心用 read_pipe／write_pipe（含 reserve 版本）。"""\n    _info_enums = (mem_info, pipe_info)\n\n    def __init__(self, context, flags, packet_size, max_packets, properties=()):\n        _svm_check_pipe(context)\n        res, _ = _call("pipe_create", {"ctx": context._h, "flags": int(flags), "packet_size": int(packet_size), "max_packets": int(max_packets)})\n        self._h, self._ctx, self._flags, self._size = res["h"], context, int(flags), int(res["size"])\n        self._packet_size, self._max_packets, self._mtype = int(packet_size), int(max_packets), mem_object_type.PIPE\n\n    def get_pipe_info(self, param):\n        p = int(param)\n        if p == pipe_info.PACKET_SIZE:\n            return self._packet_size\n        if p == pipe_info.MAX_PACKETS:\n            return self._max_packets\n        if p == pipe_info.PROPERTIES:\n            return []\n        _info_error("clGetPipeInfo", param)\n\n    def get_info(self, param):\n        if 0x1120 <= int(param) <= 0x1122:\n            return self.get_pipe_info(param)\n        return MemoryObjectHolder.get_info(self, param)\n\n\ndef _svm_check_pipe(context):\n    if not any(d.get_info(device_info.MAX_PIPE_ARGS) > 0 for d in context.devices):\n        _raise("clCreatePipe", "INVALID_OPERATION", "這個裝置不支援 Pipe（max_pipe_args＝0；用 clc 或 GPU 驅動的裝置）")\n\n\ndef _need_image(m, routine):\n    if not isinstance(m, Image):\n        _raise(routine, "INVALID_MEM_OBJECT", "要傳圖像（Image），得到 %s" % type(m).__name__)\n    return m\n\n\ndef _enqueue_read_image(queue, mem, origin, region, hostbuf, row_pitch=0, slice_pitch=0, wait_for=None, is_blocking=True):\n    _need_image(mem, "clEnqueueReadImage")\n    rg = _region3(region, 1)\n    res, data = _call("img_read", {"queue": queue._h, "mem": mem._h, "origin": list(_region3(origin, 0)), "region": list(rg)})\n    _unpack_region(_byte_view(hostbuf), data, rg, mem._elem, row_pitch, slice_pitch)\n    return _wr(queue, res)\n\n\ndef _enqueue_write_image(queue, mem, origin, region, hostbuf, row_pitch=0, slice_pitch=0, wait_for=None, is_blocking=True):\n    _need_image(mem, "clEnqueueWriteImage")\n    rg = _region3(region, 1)\n    res, _ = _call("img_write", {"queue": queue._h, "mem": mem._h, "origin": list(_region3(origin, 0)), "region": list(rg)},\n                   _pack_region(_byte_view(hostbuf), rg, mem._elem, row_pitch, slice_pitch))\n    return _wr(queue, res)\n\n\ndef _enqueue_copy_image(queue, src, dest, src_origin, dest_origin, region, wait_for=None):\n    _need_image(src, "clEnqueueCopyImage")\n    _need_image(dest, "clEnqueueCopyImage")\n    res, _ = _call("img_copy", {"queue": queue._h, "src": src._h, "dst": dest._h, "src_origin": list(_region3(src_origin, 0)),\n                                "dst_origin": list(_region3(dest_origin, 0)), "region": list(_region3(region, 1))})\n    return _wr(queue, res)\n\n\ndef _enqueue_copy_image_to_buffer(queue, src, dest, origin, region, offset, wait_for=None):\n    _need_image(src, "clEnqueueCopyImageToBuffer")\n    res, _ = _call("img_to_buf", {"queue": queue._h, "img": src._h, "buf": dest._h, "origin": list(_region3(origin, 0)), "region": list(_region3(region, 1)), "offset": int(offset)})\n    return _wr(queue, res)\n\n\ndef _enqueue_copy_buffer_to_image(queue, src, dest, offset, origin, region, wait_for=None):\n    _need_image(dest, "clEnqueueCopyBufferToImage")\n    res, _ = _call("buf_to_img", {"queue": queue._h, "buf": src._h, "img": dest._h, "origin": list(_region3(origin, 0)), "region": list(_region3(region, 1)), "offset": int(offset)})\n    return _wr(queue, res)\n\n\ndef enqueue_fill_image(queue, mem, color, origin, region, wait_for=None):\n    _need_image(mem, "clEnqueueFillImage")\n    c = np.asarray(color).reshape(-1)\n    if c.size != 4:\n        _raise("clEnqueueFillImage", "INVALID_VALUE", "color 要有 4 個分量（RGBA），得到 %d 個" % c.size)\n    kind = "f" if c.dtype.kind == "f" else ("i" if c.dtype.kind == "i" else "ui")\n    res, _ = _call("img_fill", {"queue": queue._h, "mem": mem._h, "origin": list(_region3(origin, 0)), "region": list(_region3(region, 1)), "color": [x.item() for x in c], "kind": kind})\n    return _wr(queue, res)\n\n\nclass _ImageMap(bytearray):\n    """enqueue_map_image 的 base：release 時若 map 帶寫入旗標，把內容寫回圖像"""\n\n    def _init(self, queue, mem, origin, region, flags):\n        self._queue, self._mem, self._origin, self._region, self._flags, self._released = queue, mem, origin, region, int(flags), False\n        return self\n\n    def release(self, queue=None, wait_for=None):\n        if self._released:\n            _raise("clEnqueueUnmapMemObject", "INVALID_VALUE", "這個 map 已經 release 過了")\n        self._released = True\n        q = queue or self._queue\n        if self._flags & (map_flags.WRITE | map_flags.WRITE_INVALIDATE_REGION):\n            res, _ = _call("img_write", {"queue": q._h, "mem": self._mem._h, "origin": list(self._origin), "region": list(self._region)}, bytes(self))\n            return Event(res["event"], q)\n        return _done_event(q, "unmap")\n\n\ndef enqueue_map_image(queue, img, flags, origin, region, shape, dtype, order="C", strides=None, wait_for=None, is_blocking=True):\n    _need_image(img, "clEnqueueMapImage")\n    dt, org, rg, flags = np.dtype(dtype), _region3(origin, 0), _region3(region, 1), int(flags)\n    nbytes = rg[0] * rg[1] * rg[2] * img._elem\n    shape = tuple(int(x) for x in (shape if hasattr(shape, "__iter__") else (shape,)))\n    if int(np.prod(shape, dtype=np.int64)) * dt.itemsize > nbytes:\n        _raise("clEnqueueMapImage", "INVALID_VALUE", "shape × dtype 比 region 大")\n    mm = _ImageMap(nbytes)._init(queue, img, org, rg, flags)\n    if not (flags & map_flags.WRITE_INVALIDATE_REGION):\n        res, data = _call("img_read", {"queue": queue._h, "mem": img._h, "origin": list(org), "region": list(rg)})\n        mm[:] = data\n        ev = Event(res["event"], queue)\n    else:\n        ev = _done_event(queue, "map")\n    row_pitch = rg[0] * img._elem\n    arr = np.ndarray(shape, dtype=dt, buffer=mm, order=order, strides=strides)\n    return arr, ev, row_pitch, row_pitch * rg[1]\n\n\ndef get_supported_image_formats(context, flags, image_type):\n    if not any(d.get_info(device_info.IMAGE_SUPPORT) for d in context.devices):\n        return []   # 沒有圖像支援的裝置（KIR 驅動）：真的 OpenCL 也是回空清單\n    res, _ = _call("img_formats", {"type": int(image_type)})\n    return [ImageFormat(0x10b0 + _CH_ORDER_NAMES.index(o), 0x10d0 + _CH_TYPE_NAMES.index(t)) for o, t in res["formats"]]\n\n\n# ---------------------------------------------------------------------------------------------\n# OpenGL 互通（cl_khr_gl_sharing 的 GLBuffer、GLTexture［GL_TEXTURE_2D］、GLRenderBuffer）\n# GL 的緩衝區在 WebGL2（GPU）裡，OpenCL 的緩衝區在載入器的驅動裡，兩邊是兩塊記憶體；acquire／release 就是兩者之間的同步點（與標準的語意相同：\n# 核心只能在 acquire 與 release 之間使用 GL 緩衝區）。優化：GL 端用修訂號、CL 端用內容版本號，沒變的方向不傳輸——連續多幀「acquire、核心、release」\n# 只有第一次 acquire 會把 GL 內容讀進來，之後只有 CL 真的寫過才寫回 GL。\n# 需要 fa_opengl_platform（PyOpenGL 的平台後端）；沒有就明確報錯。pyopencl.tools.get_gl_sharing_context_properties() 在 Pyodide 上（sys.platform 是\n# emscripten）會丟 NotImplementedError、在 Linux 要 GLX：這個後端的 Context 不需要 GL 屬性，直接 Context(devices=[dev]) 即可（DESIGN.pyopencl.md §9）。\n# ---------------------------------------------------------------------------------------------\n\ndef _gl_platform():\n    try:\n        import fa_opengl_platform as P\n    except ImportError:\n        _raise("clCreateFromGLBuffer", "INVALID_OPERATION", "GL 互通需要 fa_opengl_platform（PyOpenGL 的平台後端）；沒有 GL 上下文")\n    return P\n\n\nclass GLBuffer(MemoryObject):\n    def __init__(self, context, flags, bufobj):\n        P = _gl_platform()\n        info = P.interop_buffer_info(int(bufobj))\n        if info is None:\n            _raise("clCreateFromGLBuffer", "INVALID_GL_OBJECT", "GL 緩衝區 %s 不存在（要是 glGenBuffers 回傳的名字）" % bufobj)\n        if info[0] <= 0:\n            _raise("clCreateFromGLBuffer", "INVALID_GL_OBJECT", "GL 緩衝區 %s 還沒有資料（先 glBufferData）" % bufobj)\n        res, _ = _call("buf_create", {"ctx": context._h, "flags": int(flags), "size": int(info[0])})\n        self._h, self._ctx, self._size, self._flags = res["h"], context, int(info[0]), int(flags)\n        self._gl_name, self._gl_rev, self._cl_ver, self._acquired = int(bufobj), None, None, False\n\n    def get_gl_object_info(self):\n        return (gl_object_type.BUFFER, self._gl_name)\n\n    def __repr__(self):\n        return "<pyopencl.GLBuffer of GL buffer %d, size %d>" % (self._gl_name, self._size)\n\n\n_GL_FMT_NUM = lambda f: (0x10b0 + _CH_ORDER_NAMES.index(f[0]), 0x10d0 + _CH_TYPE_NAMES.index(f[1]))   # noqa: E731\n\n\nclass _GLImage(Image):\n    """GL 紋理／renderbuffer 對應的 CL 圖像：一般的 Image，外加 acquire／release 時與 GL 端同步（見上方的修訂號機制）"""\n\n    def _gl_setup(self, context, flags, info, kind, name, level):\n        P = _gl_platform()\n        fmt = P.GL_INTEROP_FORMATS.get(info[2])\n        if fmt is None:\n            _raise("clCreateFromGL" + kind, "INVALID_IMAGE_FORMAT_DESCRIPTOR", "GL 內部格式 0x%x 沒有對應的 CL 圖像格式（支援 RGBA8／RGBA16F／RGBA32F／R8／R32F／RG8／RG32F）" % info[2])\n        desc = ImageDescriptor()\n        desc.image_type, desc.shape = mem_object_type.IMAGE2D, (info[0], info[1])\n        self._init_from(context, flags, ImageFormat(*_GL_FMT_NUM(fmt)), desc, None)\n        self._gl_name, self._gl_level, self._gl_internal, self._gl_rev, self._cl_ver, self._acquired = int(name), int(level), info[2], None, None, False\n\n    def _gl_info(self, P):\n        raise NotImplementedError\n\n\nclass GLTexture(_GLImage):\n    def __init__(self, context, flags, texture_target, miplevel, texture, dims=2):\n        P = _gl_platform()\n        if int(texture_target) != 0x0DE1 or int(dims) != 2:\n            _raise("clCreateFromGLTexture", "INVALID_VALUE", "只支援 GL_TEXTURE_2D（texture_target＝0x0DE1、dims＝2）；得到 target 0x%x、dims %s" % (int(texture_target), dims))\n        info = P.interop_texture_info(int(texture), int(miplevel))\n        if info is None:\n            _raise("clCreateFromGLTexture", "INVALID_GL_OBJECT", "GL 紋理 %s 的第 %s 層不存在或還沒有資料（先 glTexImage2D）" % (texture, miplevel))\n        self._gl_setup(context, flags, info, "Texture", texture, miplevel)\n\n    def _gl_info(self, P):\n        return P.interop_texture_info(self._gl_name, self._gl_level)\n\n    def _gl_read(self, P):\n        return P.interop_texture_read(self._gl_name, self._gl_level)\n\n    def _gl_write(self, P, data):\n        return P.interop_texture_write(self._gl_name, data, self._gl_level)\n\n    def get_gl_object_info(self):\n        return (gl_object_type.TEXTURE2D, self._gl_name)\n\n    def get_gl_texture_info(self, param):\n        p = int(param)\n        if p == gl_texture_info.TEXTURE_TARGET:\n            return 0x0DE1\n        if p == gl_texture_info.MIPMAP_LEVEL:\n            return self._gl_level\n        _info_error("clGetGLTextureInfo", param)\n\n    def __repr__(self):\n        return "<pyopencl.GLTexture of GL texture %d level %d, %dx%d>" % (self._gl_name, self._gl_level, self._dims[0], self._dims[1])\n\n\nclass GLRenderBuffer(_GLImage):\n    def __init__(self, context, flags, renderbuffer):\n        P = _gl_platform()\n        info = P.interop_renderbuffer_info(int(renderbuffer))\n        if info is None:\n            _raise("clCreateFromGLRenderbuffer", "INVALID_GL_OBJECT", "GL renderbuffer %s 不存在或還沒有 glRenderbufferStorage" % renderbuffer)\n        self._gl_setup(context, flags, info, "Renderbuffer", renderbuffer, 0)\n\n    def _gl_info(self, P):\n        return P.interop_renderbuffer_info(self._gl_name)\n\n    def _gl_read(self, P):\n        return P.interop_renderbuffer_read(self._gl_name)\n\n    def _gl_write(self, P, data):\n        return P.interop_renderbuffer_write(self._gl_name, data)\n\n    def get_gl_object_info(self):\n        return (gl_object_type.RENDERBUFFER, self._gl_name)\n\n    def __repr__(self):\n        return "<pyopencl.GLRenderBuffer of GL renderbuffer %d, %dx%d>" % (self._gl_name, self._dims[0], self._dims[1])\n\n\ndef _gl_event(queue, name):\n    return Event({"h": -1, "cmd": name, "queued": 0, "start": 0, "end": 0}, queue)\n\n\n_GL_OBJECTS = (GLBuffer, GLTexture, GLRenderBuffer)\n\n\ndef enqueue_acquire_gl_objects(queue, mem_objects, wait_for=None):\n    P = _gl_platform()\n    for m in mem_objects:\n        if not isinstance(m, _GL_OBJECTS):\n            _raise("clEnqueueAcquireGLObjects", "INVALID_GL_OBJECT", "只有 GLBuffer／GLTexture／GLRenderBuffer 能 acquire（得到 %s）" % type(m).__name__)\n        if m._acquired:\n            _raise("clEnqueueAcquireGLObjects", "INVALID_OPERATION", "這個 %s 已經 acquire 過了（要先 release）" % type(m).__name__)\n        if isinstance(m, GLBuffer):\n            info = P.interop_buffer_info(m._gl_name)\n            if info is None:\n                _raise("clEnqueueAcquireGLObjects", "INVALID_GL_OBJECT", "GL 緩衝區 %d 已被刪除" % m._gl_name)\n            if info[0] != m._size:\n                _raise("clEnqueueAcquireGLObjects", "INVALID_GL_OBJECT", "GL 緩衝區 %d 的大小從 %d 變成 %d（glBufferData 重新指定過），要重新建立 GLBuffer" % (m._gl_name, m._size, info[0]))\n            if m._gl_rev != info[1]:   # GL 端有新內容（或第一次）：從 GPU 讀進來；沒變就跳過\n                _call("buf_write", {"queue": queue._h, "mem": m._h, "offset": 0}, P.interop_read(m._gl_name))\n                m._gl_rev = info[1]\n        else:\n            info = m._gl_info(P)\n            if info is None:\n                _raise("clEnqueueAcquireGLObjects", "INVALID_GL_OBJECT", "GL 物件 %d 已被刪除或沒有資料" % m._gl_name)\n            if (info[0], info[1]) != tuple(m._dims[:2]) or info[2] != m._gl_internal:\n                _raise("clEnqueueAcquireGLObjects", "INVALID_GL_OBJECT", "GL 物件 %d 的尺寸或格式改變了（重新指定過儲存），要重新建立 %s" % (m._gl_name, type(m).__name__))\n            if m._gl_rev != info[3]:\n                _call("img_write", {"queue": queue._h, "mem": m._h, "origin": [0, 0, 0], "region": [info[0], info[1], 1]}, m._gl_read(P))\n                m._gl_rev = info[3]\n        m._cl_ver = _call("buf_version", {"mem": m._h})[0]["ver"]\n        m._acquired = True\n    return _gl_event(queue, "acquire_gl")\n\n\ndef enqueue_release_gl_objects(queue, mem_objects, wait_for=None):\n    P = _gl_platform()\n    for m in mem_objects:\n        if not isinstance(m, _GL_OBJECTS):\n            _raise("clEnqueueReleaseGLObjects", "INVALID_GL_OBJECT", "只有 GLBuffer／GLTexture／GLRenderBuffer 能 release（得到 %s）" % type(m).__name__)\n        if not m._acquired:\n            _raise("clEnqueueReleaseGLObjects", "INVALID_OPERATION", "這個 %s 沒有 acquire 過" % type(m).__name__)\n        if _call("buf_version", {"mem": m._h})[0]["ver"] != m._cl_ver:   # CL 端真的寫過：寫回 GL；沒寫過就不傳輸\n            if isinstance(m, GLBuffer):\n                _, data = _call("buf_read", {"queue": queue._h, "mem": m._h, "offset": 0, "size": m._size})\n                m._gl_rev = P.interop_write(m._gl_name, data)\n            else:\n                _, data = _call("img_read", {"queue": queue._h, "mem": m._h, "origin": [0, 0, 0], "region": [m._dims[0], m._dims[1], 1]})\n                m._gl_rev = m._gl_write(P, data)\n        m._acquired = False\n    return _gl_event(queue, "release_gl")\n\n\ndef _unsupported_class(name, why):\n    def __init__(self, *a, **k):\n        _raise(name, "INVALID_OPERATION", why)\n\n    def _info(self, *a, **k):   # 真 pyopencl 的 _monkeypatch 要求這些類別有 get_info 類方法才能替它們裝屬性\n        _raise(name, "INVALID_OPERATION", why)\n    ns = {"__init__": __init__, "__module__": __name__, "get_info": _info}\n    if name == "Image":\n        ns["get_image_info"] = _info\n    if name == "Pipe":\n        ns["get_pipe_info"] = _info\n    return type(name, (MemoryObject,) if name in ("Image", "Pipe") else (object,), ns)\n\n\nfor _n, _why in (("DevicePointerEXT", "不支援 cl_ext_buffer_device_address"),\n                 ("DeviceTopologyAmd", "AMD 擴充，不支援"), ("_TestMemoryPool", "pyopencl 內部測試用")):\n    globals()[_n] = _unsupported_class(_n, _why)\n\n\n# ---------------------------------------------------------------------------------------------\n# SVM（共享虛擬記憶體，粗粒度緩衝區等級）。實作方式：SVM 區塊的「主機端」是真的記憶體（ctypes 配置，svm_ptr 是它的位址，numpy 直接建在上面，\n# 所以 pyopencl 的 svm_empty／csvm_empty／SVM(...) 與 __array_interface__ 都照常運作）；裝置端是載入器裡的一塊緩衝區。\n# 同步：核心帶 SVM 參數的那次啟動前，若主機端內容變了（crc32）就推上去；啟動後若裝置端版本變了就拉回來。佇列循序且同步，所以主機端在每次\n# 啟動完成後都是最新的——這滿足（也超過）粗粒度 SVM 的契約（map／unmap 之間才能存取）；裝置回報的能力只有 COARSE_GRAIN_BUFFER。\n# 不支援：細粒度（FINE_GRAIN_*）與 SVM 原子（裝置不回報這些能力）。\n# ---------------------------------------------------------------------------------------------\nimport ctypes as _ct\nimport zlib as _zlib\n\n_SVM_REGISTRY = {}   # 起始位址 → SVMAllocation\n\n\ndef _svm_check_device(context, routine):\n    if not any(d.get_info(device_info.SVM_CAPABILITIES) & device_svm_capabilities.COARSE_GRAIN_BUFFER for d in context.devices):\n        _raise(routine, "INVALID_OPERATION", "這個裝置不支援 SVM（svm_capabilities＝0；用 clc 或 GPU 驅動的裝置）")\n\n\ndef _svm_resolve(ptr, routine):\n    """位址 → (SVMAllocation, 位元組偏移)；不在任何 SVM 區塊內就是 INVALID_ARG_VALUE（沒有細粒度系統 SVM）"""\n    for base, a in _SVM_REGISTRY.items():\n        if base <= ptr < base + a._size:\n            return a, ptr - base\n    _raise(routine, "INVALID_ARG_VALUE", "位址 0x%x 不在任何 SVM 區塊裡（這個裝置只有粗粒度 SVM，沒有 FINE_GRAIN_SYSTEM）" % ptr)\n\n\nclass SVMPointer(object):\n    @property\n    def svm_ptr(self):\n        raise NotImplementedError\n\n    @property\n    def size(self):\n        return None\n\n    @property\n    def buf(self):\n        n = self.size\n        if n is None:\n            _raise("SVMPointer.buf", "INVALID_VALUE", "這個 SVM 指標沒有大小")\n        return np.frombuffer((_ct.c_uint8 * n).from_address(int(self.svm_ptr)), dtype=np.uint8)\n\n    def map(self, queue, *, flags, is_blocking=True, wait_for=None, size=None):\n        from pyopencl import SVMMap\n        return SVMMap(self, np.asarray(self.buf), queue, _enqueue_svm_map(queue, is_blocking, flags, self, wait_for, size))\n\n    def map_ro(self, queue, *, is_blocking=True, wait_for=None, size=None):\n        return self.map(queue, flags=map_flags.READ, is_blocking=is_blocking, wait_for=wait_for, size=size)\n\n    def map_rw(self, queue, *, is_blocking=True, wait_for=None, size=None):\n        return self.map(queue, flags=map_flags.READ | map_flags.WRITE, is_blocking=is_blocking, wait_for=wait_for, size=size)\n\n    def _enqueue_unmap(self, queue, wait_for=None):\n        return _enqueue_svm_unmap(queue, self, wait_for)\n\n    def as_buffer(self, ctx, flags=None, size=None):\n        a, off = _svm_resolve(int(self.svm_ptr), "as_buffer")\n        return a._as_buffer(off, size if size is not None else (self.size or a._size - off))\n\n\nclass SVM(SVMPointer):\n    def __init__(self, arg):\n        self._mem = arg\n        a = np.asarray(arg)\n        if not (a.flags.c_contiguous or a.flags.f_contiguous):\n            _raise("SVM", "INVALID_VALUE", "SVM(...) 要連續的記憶體")\n        self._ptr, self._nbytes = int(a.__array_interface__["data"][0]), int(a.nbytes)\n\n    @property\n    def mem(self):\n        return self._mem\n\n    @property\n    def svm_ptr(self):\n        return self._ptr\n\n    @property\n    def size(self):\n        return self._nbytes\n\n    def map(self, queue, *, flags, is_blocking=True, wait_for=None, size=None):\n        from pyopencl import SVMMap\n        return SVMMap(self, self._mem, queue, _enqueue_svm_map(queue, is_blocking, flags, self, wait_for, size))\n\n    def map_ro(self, queue, *, is_blocking=True, wait_for=None, size=None):\n        return self.map(queue, flags=map_flags.READ, is_blocking=is_blocking, wait_for=wait_for, size=size)\n\n    def map_rw(self, queue, *, is_blocking=True, wait_for=None, size=None):\n        return self.map(queue, flags=map_flags.READ | map_flags.WRITE, is_blocking=is_blocking, wait_for=wait_for, size=size)\n\n    def __eq__(self, other):\n        return isinstance(other, SVM) and other._ptr == self._ptr and other._nbytes == self._nbytes\n\n    def __hash__(self):\n        return hash(("SVM", self._ptr, self._nbytes))\n\n\nclass SVMAllocation(SVMPointer):\n    def __init__(self, context, size, alignment, flags, queue=None):\n        _svm_check_device(context, "clSVMAlloc")\n        size, alignment = int(size), max(int(alignment or 0), 16)\n        if size <= 0:\n            _raise("clSVMAlloc", "INVALID_VALUE", "size 要大於 0")\n        if alignment & (alignment - 1):\n            _raise("clSVMAlloc", "INVALID_VALUE", "alignment 要是 2 的次方")\n        if int(flags) & (svm_mem_flags.SVM_FINE_GRAIN_BUFFER | svm_mem_flags.SVM_ATOMICS):\n            _raise("clSVMAlloc", "INVALID_VALUE", "裝置只有粗粒度 SVM，沒有 SVM_FINE_GRAIN_BUFFER／SVM_ATOMICS")\n        self._raw = (_ct.c_char * (size + alignment))()   # 零初始化\n        self._ptr = (_ct.addressof(self._raw) + alignment - 1) & ~(alignment - 1)\n        self._size, self._ctx, self._flags, self._queue_bound = size, context, int(flags), queue\n        res, _ = _call("buf_create", {"ctx": context._h, "flags": int(mem_flags.READ_WRITE), "size": size})\n        self._buf_h, self._crc, self._ver, self._subs, self._live = res["h"], None, None, {}, True\n        _SVM_REGISTRY[self._ptr] = self\n\n    @property\n    def svm_ptr(self):\n        return self._ptr\n\n    @property\n    def size(self):\n        return self._size\n\n    @property\n    def _queue(self):\n        return self._queue_bound\n\n    def bind_to_queue(self, queue):\n        self._queue_bound = queue\n\n    def unbind_from_queue(self):\n        self._queue_bound = None\n\n    def release(self):\n        if not self._live:\n            return\n        self._live = False\n        _SVM_REGISTRY.pop(self._ptr, None)\n        for h in [self._buf_h] + list(self._subs.values()):\n            try:\n                _call("release", {"h": h})\n            except Exception:  # noqa: BLE001\n                pass\n\n    def enqueue_release(self, queue=None, wait_for=None):\n        self.release()\n        return _done_event(queue or self._queue_bound, "svm_free")\n\n    def __del__(self):\n        try:\n            self.release()\n        except Exception:  # noqa: BLE001\n            pass\n\n    def __eq__(self, other):\n        return isinstance(other, SVMAllocation) and other._ptr == self._ptr\n\n    def __hash__(self):\n        return hash(("SVMAllocation", self._ptr))\n\n    # ---- 同步（見檔頭說明）\n    def _cur_ver(self):\n        return _call("buf_version", {"mem": self._buf_h})[0]["ver"]\n\n    def _push(self, queue):\n        data = _ct.string_at(self._ptr, self._size)\n        crc = _zlib.crc32(data)\n        if crc != self._crc:\n            _call("buf_write", {"queue": queue._h, "mem": self._buf_h, "offset": 0}, data)\n            self._crc, self._ver = crc, self._cur_ver()\n\n    def _pull(self, queue):\n        v = self._cur_ver()\n        if v != self._ver:\n            _, data = _call("buf_read", {"queue": queue._h, "mem": self._buf_h, "offset": 0, "size": self._size})\n            _ct.memmove(self._ptr, data, self._size)\n            self._crc, self._ver = _zlib.crc32(data), v\n\n    def _as_buffer(self, off, size):\n        if off == 0 and size == self._size:\n            return self._buf_h\n        key = (off, size)\n        if key not in self._subs:\n            self._subs[key] = _call("buf_sub", {"mem": self._buf_h, "origin": off, "size": size, "flags": 0})[0]["h"]\n        return self._subs[key]\n\n\nclass SVMAllocator(object):\n    def __init__(self, context, alignment=0, flags=1, queue=None):\n        _svm_check_device(context, "SVMAllocator")\n        self._ctx, self._alignment, self._flags, self._queue = context, alignment, flags, queue\n\n    def __call__(self, size):\n        return SVMAllocation(self._ctx, size, self._alignment, self._flags, self._queue)\n\n\nclass PooledSVM(SVMPointer):\n    def __init__(self, pool, alloc, req):\n        self._pool, self._alloc, self._req, self._out = pool, alloc, int(req), True\n\n    @property\n    def svm_ptr(self):\n        return self._alloc._ptr\n\n    @property\n    def size(self):\n        return self._req\n\n    def release(self):\n        if self._out:\n            self._out = False\n            self._pool._give_back(self._alloc)\n\n    def enqueue_release(self):\n        self.release()\n\n    def bind_to_queue(self, queue):\n        self._alloc.bind_to_queue(queue)\n\n    def unbind_from_queue(self):\n        self._alloc.unbind_from_queue()\n\n    def __eq__(self, other):\n        return isinstance(other, PooledSVM) and other._alloc is self._alloc\n\n    def __hash__(self):\n        return hash(("PooledSVM", self._alloc._ptr))\n\n    def __del__(self):\n        try:\n            self.release()\n        except Exception:  # noqa: BLE001\n            pass\n\n\nclass SVMPool(object):\n    """依 2 的次方分箱的簡單池：釋放的區塊留在池裡（held），同箱的下次配置直接重用。"""\n\n    def __init__(self, allocator, leading_bits_in_bin_id=4):\n        self._alloc_fn, self._held, self._active = allocator, {}, {}\n        self._stopped = False\n\n    def bin_number(self, size):\n        return max(int(size) - 1, 1).bit_length()\n\n    def alloc_size(self, bin_nr):\n        return 1 << int(bin_nr)\n\n    def __call__(self, size):\n        b = self.bin_number(size)\n        lst = self._held.get(b)\n        a = lst.pop() if lst else self._alloc_fn(self.alloc_size(b))\n        self._active[id(a)] = (a, b)\n        return PooledSVM(self, a, size)\n\n    def _give_back(self, a):\n        _, b = self._active.pop(id(a), (None, self.bin_number(a._size)))\n        if self._stopped:\n            a.release()\n        else:\n            self._held.setdefault(b, []).append(a)\n\n    @property\n    def held_blocks(self):\n        return sum(len(v) for v in self._held.values())\n\n    @property\n    def active_blocks(self):\n        return len(self._active)\n\n    @property\n    def managed_bytes(self):\n        return sum(a._size for a, _ in self._active.values()) + sum(a._size for v in self._held.values() for a in v)\n\n    @property\n    def active_bytes(self):\n        return sum(a._size for a, _ in self._active.values())\n\n    def free_held(self):\n        for v in self._held.values():\n            for a in v:\n                a.release()\n        self._held = {}\n\n    def stop_holding(self):\n        self._stopped = True\n        self.free_held()\n\n\ndef _svm_n(dst_or_src, byte_count, others=()):\n    n = byte_count\n    if n is None:\n        sizes = [x.size for x in (dst_or_src,) + tuple(others) if x.size is not None]\n        n = min(sizes) if sizes else None\n    if n is None:\n        _raise("clEnqueueSVMMemcpy", "INVALID_VALUE", "要給 byte_count（兩邊都沒有大小）")\n    return int(n)\n\n\ndef _enqueue_svm_memcpy(queue, is_blocking, dst, src, wait_for=None, byte_count=None):\n    n = _svm_n(dst, byte_count, (src,))\n    for p in (dst, src):\n        if p.size is not None and n > p.size:\n            _raise("clEnqueueSVMMemcpy", "INVALID_VALUE", "byte_count %d 超過區塊大小 %d" % (n, p.size))\n    _ct.memmove(int(dst.svm_ptr), int(src.svm_ptr), n)\n    return _done_event(queue, "svm_memcpy")\n\n\ndef _enqueue_svm_memfill(queue, dst, pattern, byte_count=None, wait_for=None):\n    pat = _as_bytes(pattern)\n    n = _svm_n(dst, byte_count)\n    if not pat or n % len(pat):\n        _raise("clEnqueueSVMMemFill", "INVALID_VALUE", "byte_count 要是 pattern 長度的整數倍")\n    _ct.memmove(int(dst.svm_ptr), pat * (n // len(pat)), n)\n    return _done_event(queue, "svm_memfill")\n\n\ndef _enqueue_svm_map(queue, is_blocking, flags, svm, wait_for=None, size=None):\n    return _done_event(queue, "svm_map")   # 主機端永遠是最新的（見檔頭），map 不需要傳輸\n\n\ndef _enqueue_svm_unmap(queue, svm, wait_for=None):\n    return _done_event(queue, "svm_unmap")   # 下次核心啟動前會依 crc32 把主機端的改動推上裝置\n\n\ndef _enqueue_svm_migrate_mem(queue, svms, flags=None, wait_for=None):\n    return _done_event(queue, "svm_migrate")\n\n\n# ---------------------------------------------------------------------------------------------\n# 標記、屏障、等待、遷移：這個後端的佇列是循序、操作都已完成，所以這些只是回傳一個已完成的事件（語意上就是「前面的都做完了」）\n# ---------------------------------------------------------------------------------------------\n\ndef _done_event(queue, name):\n    return Event({"h": -1, "cmd": name, "queued": 0, "start": 0, "end": 0}, queue)\n\n\ndef _enqueue_marker_with_wait_list(queue, wait_for=None):\n    return _done_event(queue, "marker")\n\n\ndef _enqueue_marker(queue):\n    return _done_event(queue, "marker")\n\n\ndef _enqueue_wait_for_events(queue, wait_for=None):\n    return None\n\n\ndef _enqueue_barrier_with_wait_list(queue, wait_for=None):\n    return _done_event(queue, "barrier")\n\n\ndef _enqueue_barrier(queue):\n    return _done_event(queue, "barrier")\n\n\ndef enqueue_migrate_mem_objects(queue, mem_objects, flags=0, wait_for=None):\n    for m in mem_objects:\n        if not isinstance(m, MemoryObjectHolder):\n            _raise("clEnqueueMigrateMemObjects", "INVALID_MEM_OBJECT", "要傳記憶體物件")\n    return _done_event(queue, "migrate")   # 裝置駐留由載入器依需要決定；這裡只是提示，沒有可遷移的獨立裝置記憶體\n\n\n# ---------------------------------------------------------------------------------------------\n# map：緩衝區（沒有真的映射；讀進一份主機記憶體，release 時寫回——語意與 map／unmap 相同，成本是兩次複製）\n# ---------------------------------------------------------------------------------------------\n\nclass MemoryMap(bytearray):\n    """enqueue_map_buffer 回傳的陣列的 base（numpy 陣列建在它上面）。release()（或離開 with）時，若 map 時帶了寫入旗標就寫回緩衝區。"""\n\n    def _init(self, queue, mem, offset, flags):\n        self._queue, self._mem, self._offset, self._flags, self._released = queue, mem, int(offset), int(flags), False\n        return self\n\n    def release(self, queue=None, wait_for=None):\n        if self._released:\n            _raise("clEnqueueUnmapMemObject", "INVALID_VALUE", "這個 map 已經 release 過了")\n        self._released = True\n        q = queue or self._queue\n        if self._flags & (map_flags.WRITE | map_flags.WRITE_INVALIDATE_REGION):\n            res, _ = _call("buf_write", {"queue": q._h, "mem": self._mem._h, "offset": self._offset}, bytes(self))\n            return Event(res["event"], q)\n        return _done_event(q, "unmap")\n\n\ndef enqueue_map_buffer(queue, buf, flags, offset, shape, dtype, order="C", strides=None, wait_for=None, is_blocking=True):\n    dt = np.dtype(dtype)\n    shape = tuple(int(x) for x in (shape if hasattr(shape, "__iter__") else (shape,)))\n    nbytes = int(np.prod(shape, dtype=np.int64)) * dt.itemsize\n    if offset < 0 or offset + nbytes > buf._size:\n        _raise("clEnqueueMapBuffer", "INVALID_VALUE", "map 的範圍（offset %d + %d 位元組）超出緩衝區（%d）" % (offset, nbytes, buf._size))\n    flags = int(flags)\n    mm = MemoryMap(nbytes)._init(queue, buf, offset, flags)\n    if not (flags & map_flags.WRITE_INVALIDATE_REGION):   # 要讀的內容才從緩衝區取；INVALIDATE 表示整段會被覆寫，不必讀\n        res, data = _call("buf_read", {"queue": queue._h, "mem": buf._h, "offset": int(offset), "size": nbytes})\n        mm[:] = data\n        ev = Event(res["event"], queue)\n    else:\n        ev = _done_event(queue, "map")\n    arr = np.ndarray(shape, dtype=dt, buffer=mm, order=order, strides=strides)   # base 直接是 MemoryMap（與真 pyopencl 一樣：arr.base.release()）\n    return arr, ev\n\n\n# ---------------------------------------------------------------------------------------------\n# 矩形（3D）緩衝區讀寫與複製：origin／region 的第一維是位元組；pitches＝(row_pitch, slice_pitch)，沒給就是緊密排列\n# ---------------------------------------------------------------------------------------------\n\ndef _rect_rows(origin, region, pitches):\n    origin = tuple(int(x) for x in origin) + (0,) * (3 - len(origin))\n    region = tuple(int(x) for x in region) + (1,) * (3 - len(region))\n    rp = int(pitches[0]) if pitches and pitches[0] else region[0]\n    sp = int(pitches[1]) if pitches and len(pitches) > 1 and pitches[1] else region[1] * rp\n    rows = []\n    for z in range(region[2]):\n        for y in range(region[1]):\n            rows.append((origin[0] + (origin[1] + y) * rp + (origin[2] + z) * sp, region[0]))\n    return rows\n\n\ndef _rect_check(mem_size, rows, what):\n    for off, n in rows:\n        if off < 0 or off + n > mem_size:\n            _raise("clEnqueueBufferRect", "INVALID_VALUE", "%s：矩形超出範圍（位元組 %d..%d，大小 %d）" % (what, off, off + n, mem_size))\n\n\ndef _enqueue_read_buffer_rect(queue, mem, hostbuf, buffer_origin, host_origin, region, buffer_pitches=None, host_pitches=None, wait_for=None, is_blocking=True):\n    mv = _byte_view(hostbuf)\n    brows, hrows = _rect_rows(buffer_origin, region, buffer_pitches), _rect_rows(host_origin, region, host_pitches)\n    _rect_check(mem._size, brows, "緩衝區")\n    _rect_check(len(mv), hrows, "主機陣列")\n    res, data = _call("buf_read", {"queue": queue._h, "mem": mem._h, "offset": 0, "size": mem._size})\n    for (bo, n), (ho, _) in zip(brows, hrows):\n        mv[ho:ho + n] = data[bo:bo + n]\n    return Event(res["event"], queue)\n\n\ndef _enqueue_write_buffer_rect(queue, mem, hostbuf, buffer_origin, host_origin, region, buffer_pitches=None, host_pitches=None, wait_for=None, is_blocking=True):\n    src = bytes(_byte_view(hostbuf))\n    brows, hrows = _rect_rows(buffer_origin, region, buffer_pitches), _rect_rows(host_origin, region, host_pitches)\n    _rect_check(mem._size, brows, "緩衝區")\n    _rect_check(len(src), hrows, "主機陣列")\n    _, cur = _call("buf_read", {"queue": queue._h, "mem": mem._h, "offset": 0, "size": mem._size})   # 讀－改－寫：只覆蓋矩形，其餘保留\n    cur = bytearray(cur)\n    for (bo, n), (ho, _) in zip(brows, hrows):\n        cur[bo:bo + n] = src[ho:ho + n]\n    res, _ = _call("buf_write", {"queue": queue._h, "mem": mem._h, "offset": 0}, bytes(cur))\n    return Event(res["event"], queue)\n\n\ndef _enqueue_copy_buffer_rect(queue, src, dst, src_origin, dst_origin, region, src_pitches=None, dst_pitches=None, wait_for=None):\n    srows, drows = _rect_rows(src_origin, region, src_pitches), _rect_rows(dst_origin, region, dst_pitches)\n    _rect_check(src._size, srows, "來源")\n    _rect_check(dst._size, drows, "目的")\n    _, sdata = _call("buf_read", {"queue": queue._h, "mem": src._h, "offset": 0, "size": src._size})\n    _, ddata = _call("buf_read", {"queue": queue._h, "mem": dst._h, "offset": 0, "size": dst._size}) if dst is not src else (None, sdata)\n    out = bytearray(ddata)\n    for (so, n), (do, _) in zip(srows, drows):\n        out[do:do + n] = sdata[so:so + n]\n    res, _ = _call("buf_write", {"queue": queue._h, "mem": dst._h, "offset": 0}, bytes(out))\n    return Event(res["event"], queue)\n\n\ndef enqueue_copy_buffer_p2p_amd(platform, queue, src, dst, size=None, wait_for=None):\n    return _enqueue_copy_buffer(queue, src, dst, -1 if size is None else size, 0, 0, wait_for)   # 這個後端只有一個裝置，點對點就是一般的緩衝區複製\n\n\ndef unload_platform_compiler(platform):\n    return None   # 編譯器常駐在載入器裡，沒有可卸載的東西\n\n\ndef _unsupported(name):\n    def f(*a, **k):\n        _raise(name, "INVALID_OPERATION", "這個後端（第一批）不支援 %s" % name)\n    f.__name__ = name\n    return f\n\n\nfor _n in ("get_gl_context_info_khr", "get_apple_cgl_share_group"):\n    globals()[_n] = _unsupported(_n)\n',"pyopencl_backend/test_support/siphash24.py":'# -*- coding: utf-8 -*-\n"""siphash24 的純 Python 後備（只給測試與之後的 Pyodide 路徑評估用）。\n\n真的 `siphash24` 是 C 擴充套件，pytools 在 import 時就需要它（`from siphash24 import siphash13`），而 pyopencl 一定會載入 pytools。\n這裡只實作 pytools／pyopencl 用到的介面：siphash13(data=b"", key=16 位元組) 回傳有 update／digest／hexdigest／intdigest／copy 的物件。\npyopencl 只用它算快取鍵（不跨行程比對、不與真套件交換雜湊值），所以只要同一個程式內一致即可；但核心的 SipHash 演算法仍照規格實作，\n並用 SipHash 論文附錄的官方測試向量（SipHash-2-4）驗證過（見 siphash24_test.py），1-3 只是輪數不同。\n是否要在產品（Pyodide）路徑出貨這個後備，是使用者要決定的事（DESIGN.pyopencl.md §7.2）。"""\nimport struct\n\n_M = 0xFFFFFFFFFFFFFFFF\n\n\ndef _rotl(x, b):\n    return ((x << b) | (x >> (64 - b))) & _M\n\n\ndef siphash(data, key=b"\\0" * 16, c=1, d=3):\n    """SipHash-c-d，回傳 64 位元整數。"""\n    if len(key) != 16:\n        raise ValueError("key 要是 16 位元組")\n    k0, k1 = struct.unpack("<QQ", key)\n    v0, v1 = k0 ^ 0x736f6d6570736575, k1 ^ 0x646f72616e646f6d\n    v2, v3 = k0 ^ 0x6c7967656e657261, k1 ^ 0x7465646279746573\n\n    def rounds(n, v0, v1, v2, v3):\n        for _ in range(n):\n            v0 = (v0 + v1) & _M; v1 = _rotl(v1, 13); v1 ^= v0; v0 = _rotl(v0, 32)\n            v2 = (v2 + v3) & _M; v3 = _rotl(v3, 16); v3 ^= v2\n            v0 = (v0 + v3) & _M; v3 = _rotl(v3, 21); v3 ^= v0\n            v2 = (v2 + v1) & _M; v1 = _rotl(v1, 17); v1 ^= v2; v2 = _rotl(v2, 32)\n        return v0, v1, v2, v3\n\n    n = len(data)\n    end = n - (n % 8)\n    for i in range(0, end, 8):\n        m, = struct.unpack_from("<Q", data, i)\n        v3 ^= m\n        v0, v1, v2, v3 = rounds(c, v0, v1, v2, v3)\n        v0 ^= m\n    last = (n & 0xFF) << 56\n    for j, byte in enumerate(data[end:]):\n        last |= byte << (8 * j)\n    v3 ^= last\n    v0, v1, v2, v3 = rounds(c, v0, v1, v2, v3)\n    v0 ^= last\n    v2 ^= 0xFF\n    v0, v1, v2, v3 = rounds(d, v0, v1, v2, v3)\n    return v0 ^ v1 ^ v2 ^ v3\n\n\nclass _Hash(object):\n    digest_size = 8\n    block_size = 8\n\n    def __init__(self, data=b"", key=b"\\0" * 16, c=1, d=3, name="siphash13"):\n        self._buf, self._key, self._c, self._d, self.name = bytearray(), key, c, d, name\n        self.update(data)\n\n    def update(self, data):\n        self._buf += bytes(data)\n        return self\n\n    def copy(self):\n        h = _Hash(bytes(self._buf), self._key, self._c, self._d, self.name)\n        return h\n\n    def intdigest(self):\n        return siphash(bytes(self._buf), self._key, self._c, self._d)\n\n    def digest(self):\n        return struct.pack("<Q", self.intdigest())\n\n    def hexdigest(self):\n        return self.digest().hex()\n\n\nclass siphash13(_Hash):\n    """真的 siphash24.siphash13 是 C 型別（類別）；pytools 把它放在類別屬性上當 new_hash，所以這裡也必須是類別（函式會被綁成方法、收到 self）。"""\n\n    def __init__(self, data=b"", key=b"\\0" * 16):\n        _Hash.__init__(self, data, key, 1, 3, "siphash13")\n\n\nclass siphash24(_Hash):\n    def __init__(self, data=b"", key=b"\\0" * 16):\n        _Hash.__init__(self, data, key, 2, 4, "siphash24")\n',"torch/__init__.py":'# -*- coding: utf-8 -*-\n"""\ntorch 墊片（GPU 相容層，第一階段）：只給「真的 torch 不存在」時使用（見 fa_gpu 的尋找器）。\n\n- 資料容器是 numpy float32；Tensor 有小型自動微分（反向傳播用各運算的閉包），足以訓練小型 MLP。\n- .to(\'cuda\')／.cuda() 會標記裝置；cuda 裝置上的二維 matmul 前向走 GPU 橋接（cudaweb），失敗就退回 numpy。\n- 反向傳播一律在 numpy 做（第一階段），所以只有前向的 matmul 會經過 GPU。\n- 不支援的名稱呼叫時丟 TorchCompatError，訊息格式：「未支援：torch.<名稱>，建議 <替代>」。\n\n子模組：torch.nn（Module、Linear、ReLU、Sigmoid、Tanh、Softmax、LayerNorm、Sequential、MSELoss、CrossEntropyLoss）、\ntorch.nn.functional、torch.optim（SGD、AdamW）、torch.cuda。\n"""\nimport math\n\nimport numpy as np\n\nimport fa_gpu\n\n__version__ = "0.0.0+fa-gpu-shim"\nfloat32 = np.float32  # 注意：不在這個模組裡遮蓋內建的 float／bool（下面的程式會用到內建的）\nint64 = np.int64\n_GRAD = [True]\n\n\nclass TorchCompatError(RuntimeError):\n    pass\n\n\ndef _unsupported(name, hint):\n    return TorchCompatError("未支援：torch.%s，建議 %s" % (name, hint))\n\n\n# ---------------------------------------------------------------- Tensor 與自動微分\nclass Tensor(object):\n    __array_priority__ = 1000\n\n    def __init__(self, data, requires_grad=False, device="cpu"):\n        self.data = np.array(data, dtype=np.float32, copy=True)\n        self.requires_grad = bool(requires_grad)\n        self.grad = None\n        self.device = device\n        self._prev = ()\n        self._bw = None\n        self._op = "leaf"\n\n    # 基本資訊\n    @property\n    def shape(self):\n        return tuple(self.data.shape)\n\n    def size(self, dim=None):\n        return self.shape if dim is None else self.shape[dim]\n\n    def dim(self):\n        return self.data.ndim\n\n    def numel(self):\n        return int(self.data.size)\n\n    def item(self):\n        return float(self.data.reshape(-1)[0])\n\n    def numpy(self):\n        return np.array(self.data, copy=True)\n\n    def tolist(self):\n        return self.data.tolist()\n\n    def detach(self):\n        return Tensor(self.data, device=self.device)\n\n    def __len__(self):\n        return len(self.data)\n\n    def __repr__(self):\n        g = ", grad_fn=<%s>" % self._op if self._op != "leaf" and self._prev else ""\n        return "tensor(%s%s, device=\'%s\'%s)" % (self.data.tolist(), "", self.device, g + (", requires_grad=True" if self.requires_grad and not g else ""))\n\n    def __getitem__(self, idx):\n        return Tensor(self.data[idx], device=self.device)\n\n    # 裝置\n    def to(self, device=None, *a, **k):\n        dev = str(device) if device is not None else self.device\n        out = Tensor(self.data, requires_grad=self.requires_grad, device=dev)\n        out.grad = self.grad\n        return out\n\n    def cuda(self, device=None):\n        return self.to("cuda")\n\n    def cpu(self):\n        return self.to("cpu")\n\n    # 反向傳播\n    def backward(self, gradient=None):\n        if gradient is None:\n            if self.data.size != 1:\n                raise TorchCompatError("backward() 只能用在純量上（或指定 gradient）")\n            gradient = np.ones_like(self.data)\n        g0 = np.asarray(gradient, dtype=np.float32).reshape(self.data.shape)\n        order, seen = [], set()\n\n        def build(v):\n            if id(v) in seen:\n                return\n            seen.add(id(v))\n            for p in v._prev:\n                build(p)\n            order.append(v)\n\n        build(self)\n        self.grad = g0 if self.grad is None else self.grad + g0\n        for node in reversed(order):\n            if node._bw is None or node.grad is None:\n                continue\n            pgrads = node._bw(node.grad)\n            for p, pg in zip(node._prev, pgrads):\n                if pg is None or not p.requires_grad:\n                    continue\n                pg = np.asarray(pg, dtype=np.float32).reshape(p.data.shape)\n                p.grad = pg if p.grad is None else p.grad + pg\n\n    # 運算\n    def __add__(self, o):\n        o = _t(o)\n        a, b = self.data, o.data\n        return _mk(a + b, [self, o], "add", lambda g: [_unb(g, a.shape), _unb(g, b.shape)])\n\n    __radd__ = __add__\n\n    def __neg__(self):\n        return self * -1.0\n\n    def __sub__(self, o):\n        return self + (-_t(o))\n\n    def __rsub__(self, o):\n        return _t(o) + (-self)\n\n    def __mul__(self, o):\n        o = _t(o)\n        a, b = self.data, o.data\n        return _mk(a * b, [self, o], "mul", lambda g: [_unb(g * b, a.shape), _unb(g * a, b.shape)])\n\n    __rmul__ = __mul__\n\n    def __truediv__(self, o):\n        return self * (_t(o) ** -1.0)\n\n    def __pow__(self, p):\n        a = self.data\n        out = a ** float(p)\n        return _mk(out, [self], "pow", lambda g: [g * float(p) * a ** (float(p) - 1.0)])\n\n    def __matmul__(self, o):\n        o = _t(o)\n        a, b = self.data, o.data\n        if a.ndim != 2 or b.ndim != 2:\n            raise _unsupported("matmul（非二維）", "把輸入 reshape 成二維後再相乘")\n        out = _matmul_data(a, b, self.device)\n        return _mk(out, [self, o], "matmul", lambda g: [g @ b.T, a.T @ g])\n\n    def matmul(self, o):\n        return self @ o\n\n    def t(self):\n        a = self.data\n        return _mk(a.T, [self], "t", lambda g: [g.T])\n\n    @property\n    def T(self):\n        return self.t()\n\n    def reshape(self, *shape):\n        a = self.data\n        return _mk(a.reshape(*shape), [self], "reshape", lambda g: [g.reshape(a.shape)])\n\n    def view(self, *shape):\n        return self.reshape(*shape)\n\n    def sum(self, dim=None, keepdim=False):\n        a = self.data\n        out = a.sum(axis=dim, keepdims=keepdim)\n        return _mk(out, [self], "sum", lambda g: [_expand(g, a.shape, dim, keepdim)])\n\n    def mean(self, dim=None, keepdim=False):\n        a = self.data\n        n = a.size if dim is None else a.shape[dim]\n        out = a.mean(axis=dim, keepdims=keepdim)\n        return _mk(out, [self], "mean", lambda g: [_expand(g, a.shape, dim, keepdim) / float(n)])\n\n    def exp(self):\n        out = np.exp(self.data)\n        return _mk(out, [self], "exp", lambda g: [g * out])\n\n    def log(self):\n        a = self.data\n        return _mk(np.log(a), [self], "log", lambda g: [g / a])\n\n    def sqrt(self):\n        return self ** 0.5\n\n    def rsqrt(self):\n        return self ** -0.5\n\n    def relu(self):\n        a = self.data\n        return _mk(np.maximum(a, 0), [self], "relu", lambda g: [g * (a > 0)])\n\n    def sigmoid(self):\n        s = 1.0 / (1.0 + np.exp(-self.data))\n        return _mk(s, [self], "sigmoid", lambda g: [g * s * (1.0 - s)])\n\n    def tanh(self):\n        th = np.tanh(self.data)\n        return _mk(th, [self], "tanh", lambda g: [g * (1.0 - th * th)])\n\n    def softmax(self, dim=-1):\n        a = self.data\n        e = np.exp(a - a.max(axis=dim, keepdims=True))\n        y = e / e.sum(axis=dim, keepdims=True)\n\n        def bw(g):\n            return [y * (g - (g * y).sum(axis=dim, keepdims=True))]\n\n        return _mk(y, [self], "softmax", bw)\n\n    def __gt__(self, o):\n        return Tensor(self.data > _t(o).data)\n\n    def __lt__(self, o):\n        return Tensor(self.data < _t(o).data)\n\n\ndef _t(x):\n    return x if isinstance(x, Tensor) else Tensor(x)\n\n\ndef _matmul_data(a, b, device):\n    """前向矩陣乘：cuda 裝置上的二維相乘先走 GPU 橋接，失敗就退回 numpy。"""\n    if device == "cuda" and a.ndim == 2 and b.ndim == 2 and a.shape[1] == b.shape[0] and np.all(np.isfinite(a)) and np.all(np.isfinite(b)):\n        try:\n            r = fa_gpu.call("matmul", {"a": a.reshape(-1).tolist(), "b": b.reshape(-1).tolist(),\n                                       "m": int(a.shape[0]), "k": int(a.shape[1]), "n": int(b.shape[1])})\n            return np.asarray(r, dtype=np.float32).reshape(a.shape[0], b.shape[1])\n        except fa_gpu.GpuCompatError as e:\n            fa_gpu.note_cpu("GPU 橋接不可用，matmul 改用 numpy：%s" % e)\n    return a @ b\n\n\ndef _unb(g, shape):\n    """廣播的反向：把梯度加總回原本的形狀。"""\n    g = np.asarray(g)\n    while g.ndim > len(shape):\n        g = g.sum(axis=0)\n    for i, s in enumerate(shape):\n        if s == 1 and g.shape[i] != 1:\n            g = g.sum(axis=i, keepdims=True)\n    return g.reshape(shape)\n\n\ndef _expand(g, shape, dim, keepdim):\n    g = np.asarray(g)\n    if dim is None:\n        return np.broadcast_to(g.reshape([1] * len(shape)) if g.ndim == 0 else g, shape).astype(np.float32)\n    if not keepdim:\n        g = np.expand_dims(g, dim)\n    return np.broadcast_to(g, shape).astype(np.float32)\n\n\ndef _mk(data, parents, op, bw):\n    rg = _GRAD[0] and any(p.requires_grad for p in parents)\n    dev = parents[0].device if parents else "cpu"\n    out = Tensor(data, requires_grad=rg, device=dev)\n    if rg:\n        out._prev = tuple(parents)\n        out._bw = bw\n        out._op = op\n    return out\n\n\nclass no_grad(object):\n    def __enter__(self):\n        self._p = _GRAD[0]\n        _GRAD[0] = False\n        return self\n\n    def __exit__(self, *a):\n        _GRAD[0] = self._p\n        return False\n\n    def __call__(self, fn):\n        def wrapper(*a, **k):\n            with no_grad():\n                return fn(*a, **k)\n        return wrapper\n\n\ndef _is_param(x):\n    return isinstance(x, Tensor) and getattr(x, "_is_param", False)\n\n\ndef tensor(data, dtype=None, device=None, requires_grad=False):\n    t = Tensor(data, requires_grad=requires_grad, device=str(device) if device else "cpu")\n    return t\n\n\ndef as_tensor(data, dtype=None, device=None):\n    return tensor(data, device=device)\n\n\ndef from_numpy(a):\n    return Tensor(a)\n\n\ndef zeros(*shape, requires_grad=False, device=None, dtype=None):\n    return Tensor(np.zeros(_shape(shape)), requires_grad=requires_grad, device=str(device) if device else "cpu")\n\n\ndef ones(*shape, requires_grad=False, device=None, dtype=None):\n    return Tensor(np.ones(_shape(shape)), requires_grad=requires_grad, device=str(device) if device else "cpu")\n\n\ndef randn(*shape, requires_grad=False, device=None, dtype=None, generator=None):\n    return Tensor(np.random.randn(*_shape(shape)), requires_grad=requires_grad, device=str(device) if device else "cpu")\n\n\ndef rand(*shape, requires_grad=False, device=None, dtype=None):\n    return Tensor(np.random.rand(*_shape(shape)), requires_grad=requires_grad, device=str(device) if device else "cpu")\n\n\ndef arange(*a, dtype=None, device=None, requires_grad=False):\n    return Tensor(np.arange(*a), requires_grad=requires_grad, device=str(device) if device else "cpu")\n\n\ndef manual_seed(seed):\n    np.random.seed(int(seed) % (2 ** 32))\n    return None\n\n\ndef _shape(shape):\n    if len(shape) == 1 and isinstance(shape[0], (list, tuple)):\n        return tuple(shape[0])\n    return tuple(int(s) for s in shape)\n\n\ndef matmul(a, b):\n    return _t(a) @ _t(b)\n\n\ndef mm(a, b):\n    return _t(a) @ _t(b)\n\n\ndef bmm(a, b):\n    raise _unsupported("bmm", "對每個 batch 用 torch.matmul 迴圈，或改用 @ 搭配 reshape")\n\n\ndef softmax(x, dim=-1):\n    return _t(x).softmax(dim)\n\n\ndef relu(x):\n    return _t(x).relu()\n\n\ndef sigmoid(x):\n    return _t(x).sigmoid()\n\n\ndef tanh(x):\n    return _t(x).tanh()\n\n\ndef exp(x):\n    return _t(x).exp()\n\n\ndef log(x):\n    return _t(x).log()\n\n\ndef sqrt(x):\n    return _t(x).sqrt()\n\n\ndef cat(tensors, dim=0):\n    raise _unsupported("cat", "用 numpy 組好再 torch.tensor(...)，或把資料一次建立")\n\n\nclass device(object):\n    def __init__(self, kind="cpu", index=None):\n        self.type = str(kind).split(":")[0]\n        self.index = index\n\n    def __str__(self):\n        return self.type\n\n    def __repr__(self):\n        return "device(type=\'%s\')" % self.type\n\n\ndef __getattr__(name):\n    # 其他 torch 名稱第一階段未支援；dunder 照常丟 AttributeError（給 import 機制用）\n    if name.startswith("__"):\n        raise AttributeError(name)\n    raise _unsupported(name, "只用本墊片支援的子集（Tensor、nn、optim、cuda），或改用 numpy 與 numba.cuda")\n\n\n# 子模組用 importlib 載入：from . import x 會先 getattr，而模組的 __getattr__ 會對未支援的名稱丟 TorchCompatError\nimport importlib as _importlib  # noqa: E402\n\ncuda = _importlib.import_module(__name__ + ".cuda")\nnn = _importlib.import_module(__name__ + ".nn")\noptim = _importlib.import_module(__name__ + ".optim")\n',"torch/cuda.py":'# -*- coding: utf-8 -*-\n"""torch.cuda 墊片：裝置查詢來自 GPU 相容層的 info()。"""\nimport fa_gpu\n\n\ndef is_available():\n    try:\n        info = fa_gpu.info()\n    except Exception:\n        return False\n    return bool(info.get("hasAdapter")) if isinstance(info, dict) else False\n\n\ndef device_count():\n    return 1 if is_available() else 0\n\n\ndef current_device():\n    return 0\n\n\ndef get_device_name(device=None):\n    return "WebGPU（瀏覽器介面卡，非真 CUDA）"\n\n\ndef synchronize(device=None):\n    fa_gpu.synchronize_all()\n\n\ndef empty_cache():\n    return None\n',"torch/nn/__init__.py":'# -*- coding: utf-8 -*-\n"""torch.nn 墊片：Module、Parameter、Linear、ReLU、Sigmoid、Tanh、Softmax、LayerNorm、Sequential、MSELoss、CrossEntropyLoss。"""\nimport numpy as np\n\nimport importlib as _importlib\n\nfrom .. import Tensor, _unsupported\n\nfunctional = _importlib.import_module(__name__ + ".functional")  # 見 torch/__init__.py：不用 from . import（會先 getattr）\n\n__all__ = ["Module", "Parameter", "Linear", "ReLU", "Sigmoid", "Tanh", "Softmax", "LayerNorm",\n           "Sequential", "MSELoss", "CrossEntropyLoss", "functional"]\n\n\nclass Parameter(Tensor):\n    def __init__(self, data, requires_grad=True):\n        Tensor.__init__(self, data, requires_grad=requires_grad)\n        self._is_param = True\n\n\nclass Module(object):\n    def __init__(self):\n        object.__setattr__(self, "_parameters", {})\n        object.__setattr__(self, "_modules", {})\n        object.__setattr__(self, "training", True)\n\n    def __setattr__(self, name, value):\n        if isinstance(value, Parameter):\n            self._parameters[name] = value\n        elif isinstance(value, Module):\n            self._modules[name] = value\n        object.__setattr__(self, name, value)\n\n    def parameters(self):\n        for p in self._parameters.values():\n            yield p\n        for m in self._modules.values():\n            for p in m.parameters():\n                yield p\n\n    def named_parameters(self, prefix=""):\n        for k, p in self._parameters.items():\n            yield prefix + k, p\n        for mk, m in self._modules.items():\n            for n, p in m.named_parameters(prefix + mk + "."):\n                yield n, p\n\n    def children(self):\n        return iter(self._modules.values())\n\n    def zero_grad(self, set_to_none=True):\n        for p in self.parameters():\n            p.grad = None\n\n    def to(self, device=None, *a, **k):\n        for p in self.parameters():\n            p.device = str(device) if device is not None else p.device\n        return self\n\n    def cuda(self, device=None):\n        return self.to("cuda")\n\n    def cpu(self):\n        return self.to("cpu")\n\n    def train(self, mode=True):\n        object.__setattr__(self, "training", mode)\n        for m in self._modules.values():\n            m.train(mode)\n        return self\n\n    def eval(self):\n        return self.train(False)\n\n    def __call__(self, *a, **k):\n        return self.forward(*a, **k)\n\n    def forward(self, *a, **k):\n        raise NotImplementedError("子類別要實作 forward")\n\n\nclass Linear(Module):\n    def __init__(self, in_features, out_features, bias=True, device=None, dtype=None):\n        Module.__init__(self)\n        k = 1.0 / np.sqrt(in_features)\n        self.weight = Parameter(np.random.uniform(-k, k, (out_features, in_features)))\n        self.bias = Parameter(np.random.uniform(-k, k, (out_features,))) if bias else None\n        if device is not None:\n            self.to(device)\n\n    def forward(self, x):\n        y = x @ self.weight.t()\n        if self.bias is not None:\n            y = y + self.bias\n        return y\n\n\nclass ReLU(Module):\n    def forward(self, x):\n        return x.relu()\n\n\nclass Sigmoid(Module):\n    def forward(self, x):\n        return x.sigmoid()\n\n\nclass Tanh(Module):\n    def forward(self, x):\n        return x.tanh()\n\n\nclass Softmax(Module):\n    def __init__(self, dim=-1):\n        Module.__init__(self)\n        self.dim = dim\n\n    def forward(self, x):\n        return x.softmax(self.dim)\n\n\nclass LayerNorm(Module):\n    def __init__(self, normalized_shape, eps=1e-5, elementwise_affine=True, device=None, dtype=None):\n        Module.__init__(self)\n        shape = (normalized_shape,) if isinstance(normalized_shape, int) else tuple(normalized_shape)\n        if len(shape) != 1:\n            raise _unsupported("LayerNorm（多維 normalized_shape）", "只對最後一維做正規化（normalized_shape 用整數）")\n        self.eps = eps\n        self.weight = Parameter(np.ones(shape)) if elementwise_affine else None\n        self.bias = Parameter(np.zeros(shape)) if elementwise_affine else None\n\n    def forward(self, x):\n        return functional.layer_norm(x, None, self.weight, self.bias, self.eps)\n\n\nclass Sequential(Module):\n    def __init__(self, *mods):\n        Module.__init__(self)\n        for i, m in enumerate(mods):\n            setattr(self, str(i), m)\n        self._order = list(mods)\n\n    def forward(self, x):\n        for m in self._order:\n            x = m(x)\n        return x\n\n    def __len__(self):\n        return len(self._order)\n\n    def __getitem__(self, i):\n        return self._order[i]\n\n\nclass MSELoss(Module):\n    def __init__(self, reduction="mean"):\n        Module.__init__(self)\n        self.reduction = reduction\n\n    def forward(self, input, target):\n        return functional.mse_loss(input, target, self.reduction)\n\n\nclass CrossEntropyLoss(Module):\n    def __init__(self, reduction="mean"):\n        Module.__init__(self)\n        self.reduction = reduction\n\n    def forward(self, input, target):\n        return functional.cross_entropy(input, target, self.reduction)\n\n\ndef __getattr__(name):\n    if name.startswith("__"):\n        raise AttributeError(name)\n    raise _unsupported("nn." + name, "第一階段只支援 Module、Parameter、Linear、ReLU、Sigmoid、Tanh、Softmax、LayerNorm、Sequential、MSELoss、CrossEntropyLoss")\n',"torch/nn/functional.py":'# -*- coding: utf-8 -*-\n"""torch.nn.functional 墊片：softmax、relu、sigmoid、tanh、silu、gelu（tanh 近似）、layer_norm、rms_norm、mse_loss、cross_entropy。"""\nimport math\n\nimport numpy as np\n\nfrom .. import Tensor, _mk, _t, _unsupported\n\n_names = ["softmax", "relu", "sigmoid", "tanh", "silu", "gelu", "layer_norm", "rms_norm", "mse_loss", "cross_entropy"]\n\n\ndef softmax(x, dim=-1, dtype=None):\n    return _t(x).softmax(dim)\n\n\ndef relu(x, inplace=False):\n    return _t(x).relu()\n\n\ndef sigmoid(x):\n    return _t(x).sigmoid()\n\n\ndef tanh(x):\n    return _t(x).tanh()\n\n\ndef silu(x, inplace=False):\n    x = _t(x)\n    return x * x.sigmoid()\n\n\ndef gelu(x, approximate="tanh"):\n    if approximate != "tanh":\n        raise _unsupported("F.gelu(approximate=\'none\')", "approximate=\'tanh\'（近似版，誤差很小）")\n    x = _t(x)\n    inner = (x + (x * x * x) * 0.044715) * math.sqrt(2.0 / math.pi)\n    return x * 0.5 * (inner.tanh() + 1.0)\n\n\ndef layer_norm(x, normalized_shape, weight=None, bias=None, eps=1e-5):\n    x = _t(x)\n    mu = x.mean(-1, keepdim=True)\n    c = x - mu\n    var = (c * c).mean(-1, keepdim=True)\n    y = c * (var + eps) ** -0.5\n    if weight is not None:\n        y = y * weight\n    if bias is not None:\n        y = y + bias\n    return y\n\n\ndef rms_norm(x, normalized_shape, weight=None, eps=1e-6):\n    x = _t(x)\n    ms = (x * x).mean(-1, keepdim=True)\n    y = x * (ms + eps) ** -0.5\n    if weight is not None:\n        y = y * weight\n    return y\n\n\ndef mse_loss(input, target, reduction="mean"):\n    d = _t(input) - _t(target)\n    sq = d * d\n    if reduction == "mean":\n        return sq.mean()\n    if reduction == "sum":\n        return sq.sum()\n    raise _unsupported("mse_loss(reduction=%r)" % reduction, "reduction=\'mean\' 或 \'sum\'")\n\n\ndef cross_entropy(input, target, reduction="mean"):\n    if reduction != "mean":\n        raise _unsupported("cross_entropy(reduction=%r)" % reduction, "reduction=\'mean\'")\n    lg = _t(input)\n    a = lg.data\n    if a.ndim != 2:\n        raise _unsupported("cross_entropy（非 [N, C] 形狀）", "把 logits 整理成 [N, C]")\n    y = np.asarray(_t(target).data).astype(np.int64).reshape(-1)\n    n = a.shape[0]\n    m = a.max(axis=-1, keepdims=True)\n    e = np.exp(a - m)\n    s = e.sum(axis=-1, keepdims=True)\n    p = e / s\n    logp = (a - m) - np.log(s)\n    loss = -logp[np.arange(n), y].mean()\n\n    def bw(g):\n        dl = p.copy()\n        dl[np.arange(n), y] -= 1.0\n        return [dl * (g / float(n))]\n\n    return _mk(np.array(loss, dtype=np.float32), [lg], "cross_entropy", bw)\n\n\ndef __getattr__(name):\n    if name.startswith("__"):\n        raise AttributeError(name)\n    raise _unsupported("nn.functional." + name, "第一階段只支援：" + "、".join(_names))\n',"torch/optim.py":'# -*- coding: utf-8 -*-\n"""torch.optim 墊片：SGD（可選 momentum、weight_decay）與 AdamW。"""\nimport numpy as np\n\nfrom . import _unsupported\n\n\nclass Optimizer(object):\n    def __init__(self, params, defaults):\n        self.defaults = dict(defaults)\n        self.param_groups = [dict(defaults, params=list(params))]\n        self.state = {}\n\n    def zero_grad(self, set_to_none=True):\n        for g in self.param_groups:\n            for p in g["params"]:\n                p.grad = None\n\n    def _params(self):\n        for g in self.param_groups:\n            for p in g["params"]:\n                yield g, p\n\n\nclass SGD(Optimizer):\n    def __init__(self, params, lr=1e-3, momentum=0.0, weight_decay=0.0, **kw):\n        if kw:\n            raise _unsupported("SGD(%s)" % ", ".join(kw), "只用 lr、momentum、weight_decay")\n        Optimizer.__init__(self, params, {"lr": lr, "momentum": momentum, "weight_decay": weight_decay})\n\n    def step(self, closure=None):\n        for g, p in self._params():\n            if p.grad is None:\n                continue\n            grad = p.grad + g["weight_decay"] * p.data\n            if g["momentum"]:\n                st = self.state.setdefault(id(p), {})\n                buf = st.get("momentum_buffer")\n                buf = grad.copy() if buf is None else g["momentum"] * buf + grad\n                st["momentum_buffer"] = buf\n                grad = buf\n            p.data -= (g["lr"] * grad).astype(p.data.dtype)\n\n\nclass AdamW(Optimizer):\n    def __init__(self, params, lr=1e-3, betas=(0.9, 0.999), eps=1e-8, weight_decay=0.01, **kw):\n        if kw:\n            raise _unsupported("AdamW(%s)" % ", ".join(kw), "只用 lr、betas、eps、weight_decay")\n        Optimizer.__init__(self, params, {"lr": lr, "betas": tuple(betas), "eps": eps, "weight_decay": weight_decay})\n\n    def step(self, closure=None):\n        for g, p in self._params():\n            if p.grad is None:\n                continue\n            b1, b2 = g["betas"]\n            st = self.state.setdefault(id(p), {"t": 0, "m": np.zeros_like(p.data), "v": np.zeros_like(p.data)})\n            st["t"] += 1\n            t = st["t"]\n            grad = p.grad\n            st["m"] = b1 * st["m"] + (1 - b1) * grad\n            st["v"] = b2 * st["v"] + (1 - b2) * grad * grad\n            mhat = st["m"] / (1 - b1 ** t)\n            vhat = st["v"] / (1 - b2 ** t)\n            p.data -= (g["lr"] * (mhat / (np.sqrt(vhat) + g["eps"]) + g["weight_decay"] * p.data)).astype(p.data.dtype)\n',"guitpl_lib/beauty/main.jsonl":'{"kind":"meta","id":"beauty/main","title":"美顏拍貼（簡化版）","keywords":["美顏","拍貼","濾鏡","貼紙","自拍"],"entry":"build","standalone":true}\n{"kind":"param","name":"name","default":"美顏拍貼","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"strength","default":"50","ask":"美顏強度預設多少（0 到 100）？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fff7fb","fg":"#3b1d2a","accent":"#e11d74","danger":"#dc2626","muted":"#a8899a"},"font":"sans-serif","size":14,"radius":8}\n{"kind":"layout","window":{"title":"{{name}}","width":860,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"edit_panel","kind":"column","grow":1,"pad":16,"gap":12,"children":[{"kind":"row","grow":1,"gap":16,"children":[{"id":"view","kind":"canvas","width":300,"height":300,"fit":true,"grow":3},{"kind":"column","role":"card","children":[{"kind":"label","text":"濾鏡","role":"heading"},{"id":"filter_list","kind":"list","items":["原圖","柔焦","暖色","冷色","黑白"],"selected":"原圖"},{"kind":"label","text":"貼紙（可多選）","role":"heading"},{"id":"sticker_list","kind":"multilist","items":["星星","愛心","皇冠","貓"],"selected":[]}]}]},{"kind":"label","text":"美顏強度（0 到 100）","role":"muted"},{"kind":"row","children":[{"id":"strength_bar","kind":"progress","value":"{{strength}}","max":100,"grow":3},{"id":"strength_in","kind":"entry","value":"{{strength}}"}]},{"kind":"row","children":[{"id":"apply_btn","kind":"button","text":"套用","role":"primary"},{"id":"snap_btn","kind":"button","text":"拍照"}]}]},{"id":"result_panel","kind":"column","grow":1,"pad":16,"gap":12,"children":[{"id":"result_txt","kind":"label","text":"拍好了（簡化版：只示意，未存檔）","role":"title","grow":1},{"id":"again_btn","kind":"button","text":"再拍一張","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"beauty/toolbar","params":{"caption":"美顏工具"}}\n{"kind":"slot","name":"statusbar","use":"beauty/statusbar","params":{"hint":"選濾鏡與貼紙後按拍照"}}\n{"kind":"scene","id":"edit","title":"編輯中","note":"預覽、濾鏡、強度、貼紙","show":["edit_panel"],"hide":["result_panel"],"on":{"click:snap_btn":"result","shortcut:snap":"result"}}\n{"kind":"scene","id":"result","title":"已拍照","note":"只顯示完成訊息","show":["result_panel"],"hide":["edit_panel"],"on":{"click:again_btn":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+P","do":"snap"}\n{"kind":"shortcut","keys":"Ctrl+Right","do":"next_filter"}\n{"kind":"shortcut","keys":"Ctrl+R","do":"redraw"}\n',"guitpl_lib/beauty/main.py":'# -*- coding: utf-8 -*-\n# 美顏拍貼（簡化版）：用色塊與符號示意濾鏡、強度與貼紙，不做真的影像處理。\n# 畫布一幀最多 200 道繪圖指令，這裡每次約 15 道。\n\nFILTERS = {"原圖": ("#f2c7a5", "#555555"), "柔焦": ("#f7dcc9", "#e9d5e0"), "暖色": ("#f7b267", "#7a3e12"),\n           "冷色": ("#9bc4e2", "#1d3b57"), "黑白": ("#8a8a8a", "#222222")}\nFILTER_ORDER = ["原圖", "柔焦", "暖色", "冷色", "黑白"]\nSTICKERS = [("星星", "★", "#ffd700", (30, 40)), ("愛心", "♥", "#ff3b6b", (236, 40)),\n            ("皇冠", "♛", "#ffcc00", (140, 22)), ("貓", "貓", "#333333", (236, 250))]\n\n\ndef _strength(ctx):\n    return ctx.state.get("strength", 50)\n\n\ndef _redraw(ctx):\n    name = ctx.get("filter_list") or "原圖"\n    skin, bgc = FILTERS.get(name, FILTERS["原圖"])\n    ops = [\n        ["clear", bgc],\n        ["circle", 150, 150, 90, skin],\n        ["circle", 120, 130, 9, "#222222"],\n        ["circle", 180, 130, 9, "#222222"],\n        ["line", 125, 190, 175, 190, "#b03a48"],\n        ["text", 10, 290, "濾鏡 %s　美顏 %d" % (name, _strength(ctx)), "#ffffff"],\n    ]\n    chosen = ctx.get("sticker_list") or []\n    for label, sym, color, pos in STICKERS:\n        if label in chosen:\n            ops.append(["text", pos[0], pos[1], sym, color])\n    ctx.w.draw(ctx.id("view"), ops)\n\n\ndef build(win, spec, slots):\n    def set_strength(ctx):\n        text = ctx.get("strength_in")\n        try:\n            v = int(str(text).strip())\n        except ValueError:\n            v = -1\n        if not 0 <= v <= 100:\n            ctx.set("sb_text", text="美顏強度要是 0 到 100 的整數")\n            return\n        ctx.state["strength"] = v\n        ctx.set("strength_bar", value=v)\n        ctx.set("sb_text", text="美顏強度設為 %d" % v)\n        _redraw(ctx)\n\n    def next_filter(ctx):\n        cur = ctx.get("filter_list") or "原圖"\n        nxt = FILTER_ORDER[(FILTER_ORDER.index(cur) + 1) % len(FILTER_ORDER)] if cur in FILTER_ORDER else "原圖"\n        ctx.set("filter_list", selected=nxt)\n        _redraw(ctx)\n\n    def snap(ctx):\n        _redraw(ctx)\n        ctx.set("sb_text", text="已拍照（簡化版，未儲存）")\n\n    def reset(ctx):\n        ctx.set("filter_list", selected="原圖")\n        ctx.set("sticker_list", selected=[])\n        ctx.set("strength_in", value="50")\n        ctx.set("strength_bar", value=50)\n        ctx.state["strength"] = 50\n        ctx.set("sb_text", text="已重設")\n        _redraw(ctx)\n\n    return {"handlers": {\n        "input:strength_in": set_strength,\n        "select:filter_list": _redraw,\n        "select:sticker_list": _redraw,\n        "click:apply_btn": _redraw,\n        "shortcut:redraw": _redraw,\n        "shortcut:next_filter": next_filter,\n        "click:snap_btn": snap,\n        "shortcut:snap": snap,\n        "click:tb_reset": reset,\n        "start": _redraw,\n    }}\n',"guitpl_lib/beauty/main_dark.jsonl":'{"kind":"meta","id":"beauty/main_dark","title":"深色美顏拍貼（簡化版）","keywords":["深色美顏","夜間美顏"],"extends":"beauty/main"}\n{"kind":"param","name":"name","default":"夜間美顏拍貼","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#f3e8ee","accent":"#f472b6","muted":"#6b7280"},"font":"monospace"}\n',"guitpl_lib/beauty/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色變體：只覆寫 style 與視窗標題參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_beauty_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/beauty/main_light.jsonl":'{"kind":"meta","id":"beauty/main_light","title":"淺色美顏拍貼（簡化版）","keywords":["淺色美顏","明亮美顏"],"extends":"beauty/main"}\n{"kind":"param","name":"strength","default":"70","ask":"美顏強度預設多少（0 到 100）？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","accent":"#8b5cf6"},"radius":12}\n',"guitpl_lib/beauty/main_light.py":'# -*- coding: utf-8 -*-\n# 淺色變體：只覆寫 style 與預設強度參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_beauty_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/beauty/statusbar.jsonl":'{"kind":"meta","id":"beauty/statusbar","title":"美顏狀態列","keywords":["美顏狀態列","狀態列"],"entry":"build"}\n{"kind":"param","name":"hint","default":"選濾鏡與貼紙後按拍照","ask":"狀態列一開始要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"sb_text","kind":"label","text":"{{hint}}"}]}]}\n',"guitpl_lib/beauty/statusbar.py":"# -*- coding: utf-8 -*-\n# 狀態列沒有自己的行為：主畫面用 sb_text 這個名稱更新文字。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/beauty/toolbar.jsonl":'{"kind":"meta","id":"beauty/toolbar","title":"美顏工具列","keywords":["美顏工具列","工具列"],"entry":"build"}\n{"kind":"param","name":"caption","default":"美顏工具","ask":"工具列左邊要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"kind":"label","text":"{{caption}}"},{"id":"tb_reset","kind":"button","text":"全部重設","icon":"↺"}]}]}\n',"guitpl_lib/beauty/toolbar.py":"# -*- coding: utf-8 -*-\n# 工具列的「全部重設」由主畫面處理，因為要重設濾鏡、強度與貼紙並重畫預覽。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/common/toolbar_basic.jsonl":'{"kind":"meta","id":"common/toolbar_basic","title":"基本工具列（存檔、清除）","keywords":["工具列","存檔","清除"],"entry":"build"}\n{"kind":"param","name":"save_text","default":"存檔","ask":"存檔按鈕要寫什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"save","kind":"button","text":"{{save_text}}","icon":"⬇","role":"primary"},{"id":"clear","kind":"button","text":"清除","icon":"✖"}]}]}\n',"guitpl_lib/common/toolbar_basic.py":'# -*- coding: utf-8 -*-\n# 基本工具列的行為：存檔次數記在 ctx.state，狀態列用名稱 "status"（由使用這個工具列的範本提供）。\n\n\ndef build(win, spec, slots):\n    def save(ctx):\n        ctx.state["saved"] = ctx.state.get("saved", 0) + 1\n        ctx.set("status", text="已存 %d 次" % ctx.state["saved"])\n\n    def clear(ctx):\n        ctx.set("editor", value="")\n        ctx.set("status", text="已清除")\n\n    return {"handlers": {"click:save": save, "click:clear": clear}}\n',"guitpl_lib/demo/ext_export.py":'# -*- coding: utf-8 -*-\n# 外部呼叫範例：不是範本元件，只是被 jsonl 的 call 紀錄參考的函式。\n\n\ndef on_export(ctx, fmt="txt"):\n    ctx.set("status", text="已匯出為 %s（%d 字）" % (fmt, len(ctx.get("editor"))))\n',"guitpl_lib/demo/notes.jsonl":'{"kind":"meta","id":"demo/notes","title":"簡單筆記","keywords":["筆記","記事本"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"我的筆記","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"require","module":"time","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":560,"resizable":true,"height":460},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"column","grow":1,"pad":12,"gap":8,"children":[{"id":"editor","kind":"editor","value":"","lang":"text","rows":10,"grow":1},{"kind":"row","children":[{"id":"status","kind":"label","text":"就緒","role":"muted","grow":1},{"id":"help_btn","kind":"button","text":"說明","role":"outline"},{"id":"export","kind":"button","text":"匯出"}]},{"id":"help","kind":"label","text":"在上面寫字，按存檔。","role":"muted"},{"id":"back_btn","kind":"button","text":"回到編輯","role":"primary"}]}]}]}\n{"kind":"slot","name":"toolbar","use":"common/toolbar_basic","params":{"save_text":"儲存「{{title}}」"}}\n{"kind":"scene","id":"edit","title":"編輯中","note":"工具列、編輯區、狀態列","hide":["help","back_btn"],"show":["help_btn","editor"],"on":{"click:help_btn":"help"}}\n{"kind":"scene","id":"help","title":"說明","note":"只顯示說明文字","show":["help","back_btn"],"hide":["help_btn","editor"],"on":{"click:back_btn":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+S","do":"save"}\n{"kind":"call","on":"click:export","file":"ext_export.py","function":"on_export","args":{"fmt":"txt"}}\n',"guitpl_lib/demo/notes.py":'# -*- coding: utf-8 -*-\nimport time\n\n\ndef build(win, spec, slots):\n    # Ctrl+S 與工具列的存檔是同一個動作：直接用子元件的處理函式\n    save = slots["toolbar"]["handlers"]["click:save"]\n\n    def stamp(ctx):\n        ctx.state["opened"] = time.time()\n\n    return {"handlers": {"shortcut:save": save}, "stamp": stamp}\n',"guitpl_lib/demo/notes_dark.jsonl":'{"kind":"meta","id":"demo/notes_dark","title":"深色筆記","keywords":["深色筆記"],"extends":"demo/notes"}\n{"kind":"param","name":"title","default":"夜間筆記","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff"},"font":"monospace"}\n',"guitpl_lib/demo/notes_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 demo/notes 時，這個檔案取代原本的進入函式；沒有額外行為就委派給原本的。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_demo_notes_base", os.path.join(_here, "notes.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/demo/todo_yaml.py":'# -*- coding: utf-8 -*-\n# YAML 待辦示範的行為：新增一項（按鈕或 Ctrl+Enter），清單與狀態列跟著更新。\n\n\ndef build(win, spec, slots):\n    def add(ctx):\n        text = str(ctx.get("item") or "").strip()\n        if not text:\n            ctx.set("status", text="先輸入要做的事")\n            return\n        items = ctx.state.setdefault("items", [])\n        items.append(text)\n        ctx.set("items", items=list(items))\n        ctx.set("item", value="")\n        ctx.set("status", text="共 %d 項" % len(items))\n\n    return {"handlers": {"click:add": add, "shortcut:add": add}}\n',"guitpl_lib/demo/todo_yaml.yaml":'# 用 YAML 寫的範本（示範）：內容與 jsonl 範本的紀錄完全一樣，一筆紀錄一份文件，以 --- 分開。\n# {{參數}} 要加雙引號（不加的話 YAML 會把它當成行內對照）。\nkind: meta\nid: demo/todo_yaml\ntitle: YAML 待辦示範\nkeywords: [yaml待辦, 示範待辦]\nentry: build\nstandalone: true\n---\nkind: param\nname: title\ndefault: YAML 待辦\nask: 視窗標題要寫什麼？\n---\nkind: require\nmodule: gui\nsource: builtin\n---\nkind: style\npalette:\n  bg: "#ffffff"\n  fg: "#222222"\n  accent: "#2563eb"\n  danger: "#dc2626"\n  muted: "#9ca3af"\nfont: sans-serif\nsize: 14\nradius: 6\n---\nkind: layout\nwindow: {title: "{{title}}", width: 480, height: 460, resizable: true}\ntree:\n  - kind: column\n    role: page\n    children:\n      - id: heading\n        kind: label\n        text: "{{title}}"\n        role: title\n        pad: 16\n      - kind: row\n        role: toolbar\n        children:\n          - {id: item, kind: entry, value: "", placeholder: 要做的事}\n          - {id: add, kind: button, text: 新增, role: primary}\n      - kind: column\n        grow: 1\n        pad: 12\n        gap: 8\n        children:\n          - id: items\n            kind: list\n            items: []\n            grow: 1\n      - id: status\n        kind: label\n        text: 還沒有項目\n        role: muted\n        pad: 8\n---\nkind: shortcut\nkeys: Ctrl+Enter\ndo: add\n---\nkind: scene\nid: main\ntitle: 清單\nnote: 輸入、清單與狀態列\n',"guitpl_lib/document/main.jsonl":'{"kind":"meta","id":"document/main","title":"文件編輯（工具列、大綱側欄、整面編輯區、狀態列）","keywords":["文件","文件編輯","大綱","章節","文稿","段落","標題","word","document"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"文件編輯","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"doc_name","default":"未命名文件","ask":"文件名稱要寫什麼？（會顯示在編輯區上方）"}\n{"kind":"param","name":"doc_text","default":"# 未命名文件\\n\\n在這裡開始寫。用上方的按鈕設定標題、粗體、清單，按「插入段落」會在游標處加一段新的。\\n\\n## 第一節\\n\\n左邊的大綱會列出所有標題，點一下就跳到那一節。","ask":"文件一開始要寫什麼？（# 開頭的行是標題）"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2328","accent":"#2563eb","danger":"#dc2626","muted":"#6b7280"},"font":"serif","size":15,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":980,"height":700,"resizable":true},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"row","grow":1,"children":[{"slot":"sidebar","role":"sidebar"},{"id":"body","kind":"editor","value":"{{doc_text}}","lang":"markdown","rows":18,"numbers":false,"prose":true,"grow":1,"wrap":true},{"id":"view","kind":"markdown","value":"","visible":false,"grow":1}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"document/toolbar","params":{}}\n{"kind":"slot","name":"sidebar","use":"document/sidebar","params":{"doc_name":"{{doc_name}}"}}\n{"kind":"slot","name":"statusbar","use":"document/statusbar","params":{}}\n{"kind":"scene","id":"no_outline","title":"沒有大綱","note":"只顯示提示；用 # 開頭寫一行標題後，大綱就會出現","show":["outline_hint"],"hide":["outline"]}\n{"kind":"scene","id":"has_outline","title":"有大綱","note":"大綱側欄列出所有標題，縮排表示層級，點一下就跳到那一節","show":["outline"],"hide":["outline_hint"]}\n{"kind":"shortcut","keys":"Ctrl+S","do":"save"}\n{"kind":"shortcut","keys":"Ctrl+B","do":"bold"}\n{"kind":"shortcut","keys":"Ctrl+I","do":"italic"}\n{"kind":"shortcut","keys":"Ctrl+1","do":"h1"}\n{"kind":"shortcut","keys":"Ctrl+2","do":"h2"}\n{"kind":"shortcut","keys":"Ctrl+3","do":"h3"}\n{"kind":"shortcut","keys":"Ctrl+Enter","do":"insert_para"}\n{"kind":"shortcut","keys":"Ctrl+E","do":"preview_btn"}\n',"guitpl_lib/document/main.py":'# -*- coding: utf-8 -*-\n# 文件的主畫面：把工具列（標題、粗體、插入段落、存檔）、大綱側欄、狀態列接起來。\n# 內容一改動（打字或工具列改了文字）就更新大綱與字數；快捷鍵接到同一組處理函式。\n\n\ndef build(win, spec, slots):\n    tb = slots["toolbar"]["handlers"]\n    refresh_outline = slots["sidebar"]["refresh"]\n    refresh_count = slots["statusbar"]["refresh"]\n\n    def refresh(ctx):\n        refresh_outline(ctx)\n        refresh_count(ctx)\n\n    def after(fn):\n        def run(ctx):\n            fn(ctx)\n            refresh(ctx)\n        return run\n\n    handlers = {"input:body": refresh, "start": refresh}\n    for name in ("h1", "h2", "h3", "bold", "italic", "bullet", "quote", "insert_para"):\n        handlers["click:" + name] = after(tb["click:" + name])\n        handlers["shortcut:" + name] = handlers["click:" + name]\n    handlers["click:preview_btn"] = tb["click:preview_btn"]\n    handlers["shortcut:preview_btn"] = tb["click:preview_btn"]\n    handlers["click:save"] = tb["click:save"]\n    handlers["shortcut:save"] = tb["click:save"]\n    return {"handlers": handlers}\n',"guitpl_lib/document/main_dark.jsonl":'{"kind":"meta","id":"document/main_dark","title":"深色文件編輯","keywords":["深色文件","夜間文件"],"extends":"document/main"}\n{"kind":"param","name":"title","default":"夜間文件編輯","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","danger":"#e5534b","muted":"#888888"}}\n',"guitpl_lib/document/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色文件編輯：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_document_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/document/main_warm.jsonl":'{"kind":"meta","id":"document/main_warm","title":"暖色文件編輯","keywords":["暖色文件","護眼文件"],"extends":"document/main"}\n{"kind":"param","name":"title","default":"暖色文件編輯","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fbf4e6","fg":"#3b2f20","accent":"#d9822b","danger":"#b91c1c","muted":"#a8946b"}}\n',"guitpl_lib/document/main_warm.py":'# -*- coding: utf-8 -*-\n# 暖色文件編輯：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_document_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/document/sidebar.jsonl":'{"kind":"meta","id":"document/sidebar","title":"大綱側欄（依 # 標題列出章節，點一下跳過去）","keywords":["大綱","側欄","目錄","章節清單"],"entry":"build"}\n{"kind":"param","name":"doc_name","default":"未命名文件","ask":"文件名稱要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"column","grow":1,"gap":6,"children":[{"id":"doc_label","kind":"label","text":"{{doc_name}}","role":"muted"},{"id":"outline_title","kind":"label","text":"大綱","role":"heading"},{"id":"outline_hint","kind":"label","text":"還沒有章節：用 # 開頭的行會出現在這裡","role":"muted"},{"id":"outline","kind":"list","items":[],"grow":1}]}]}\n',"guitpl_lib/document/sidebar.py":'# -*- coding: utf-8 -*-\n# 大綱側欄：從內容抓出 # 開頭的標題（# 是一級，## 二級，最多六級），用縮排表示層級；點一下大綱的項目，編輯區的游標就跳到那一行（並選起來）。\n# 沒有標題就切到「沒有大綱」場景。內容一改動主畫面就呼叫 refresh；大綱沒變就不重畫。\n\nNBSP = " "  # 選單項目前面的空白會被網頁吃掉，縮排要用不斷行空白\n\n\ndef headings(text):\n    """[(level, title, offset of the line, line length)] for every heading line (a ``` code fence hides its lines)."""\n    out = []\n    pos = 0\n    fenced = False\n    for ln in text.split("\\n"):\n        s = ln.strip()\n        if s.startswith("```"):\n            fenced = not fenced\n        elif not fenced and s.startswith("#"):\n            level = len(s) - len(s.lstrip("#"))\n            title = s[level:].strip()\n            if 1 <= level <= 6 and title and (len(s) == level or s[level] == " "):\n                out.append((level, title, pos, len(ln)))\n        pos += len(ln) + 1\n    return out\n\n\ndef labels(items):\n    return [NBSP * 2 * (lv - 1) + title for lv, title, _off, _n in items]\n\n\ndef refresh(ctx):\n    items = headings(ctx.get("body"))\n    ctx.state["outline"] = items\n    names = labels(items)\n    if names != ctx.state.get("outline_names"):\n        ctx.state["outline_names"] = names\n        ctx.set("outline", items=names)\n    ctx.goto("has_outline" if items else "no_outline")\n\n\ndef jump(ctx):\n    items = ctx.state.get("outline") or []\n    names = labels(items)\n    picked = (ctx.event or {}).get("value")\n    if picked in names:\n        _lv, _title, off, n = items[names.index(picked)]\n        ctx.set("body", caret=off, caret_to=off + n)\n\n\ndef build(win, spec, slots):\n    return {"refresh": refresh, "handlers": {"select:outline": jump}}\n',"guitpl_lib/document/statusbar.jsonl":'{"kind":"meta","id":"document/statusbar","title":"文件狀態列（字數、游標位置與訊息）","keywords":["文件狀態列","字數","存檔訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"count","kind":"label","text":"0 字"},{"id":"pos","kind":"label","text":"第 1 行，第 1 欄"},{"id":"msg","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/document/statusbar.py":'# -*- coding: utf-8 -*-\n# 文件狀態列：字數（主畫面在內容改動後呼叫 refresh）與游標位置（頁面回報游標，這裡換成第幾行第幾欄）。\n\n\ndef refresh(ctx):\n    ctx.set("count", text="%d 字" % len(ctx.get("body")))\n    show_pos(ctx)\n\n\ndef show_pos(ctx):\n    a, _b = ctx.caret("body")\n    text = ctx.get("body")\n    line = text.count("\\n", 0, a) + 1\n    col = a - (text.rfind("\\n", 0, a) + 1) + 1\n    ctx.set("pos", text="第 %d 行，第 %d 欄" % (line, col))\n\n\ndef build(win, spec, slots):\n    return {"refresh": refresh, "handlers": {"caret:body": show_pos}}\n',"guitpl_lib/document/toolbar.jsonl":'{"kind":"meta","id":"document/toolbar","title":"文件工具列（標題、粗體斜體、清單引用、插入段落、預覽、存檔）","keywords":["文件工具列","標題","粗體","斜體","插入段落","存檔文件"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"h1","kind":"button","text":"標題 1","icon":"H1"},{"id":"h2","kind":"button","text":"標題 2","icon":"H2"},{"id":"h3","kind":"button","text":"標題 3","icon":"H3"},{"kind":"label","text":"","role":"divider"},{"id":"bold","kind":"button","text":"粗體","icon":"B"},{"id":"italic","kind":"button","text":"斜體","icon":"I"},{"kind":"label","text":"","role":"divider"},{"id":"bullet","kind":"button","text":"清單","icon":"•"},{"id":"quote","kind":"button","text":"引用","icon":"❝"},{"kind":"label","text":"","role":"divider"},{"id":"insert_para","kind":"button","text":"插入段落","icon":"＋"},{"id":"preview_btn","kind":"button","text":"預覽","icon":"◉"},{"id":"save","kind":"button","text":"存檔","icon":"⬇","role":"primary"}]}]}\n',"guitpl_lib/document/toolbar.py":'# -*- coding: utf-8 -*-\n# 文件工具列的行為：全部都是「在游標處」改編輯區的文字（Markdown 寫法），不會多出任何區塊：\n#   標題 1 到 3（再按一次同級就取消）、粗體與斜體（包住選取的字；沒選就放一個預設字並選起來）、清單與引用（每行加前綴，再按一次取消）、\n#   插入段落（在游標處切開，放一個空段落並選起來，直接打字就蓋掉預設字）、存檔。\n# 文字處理都是純函式（輸入文字與選取範圍，回傳新文字與新的選取範圍），好測試；處理函式只負責讀游標、寫回、把游標放到新位置。\n\n\ndef line_start(text, pos):\n    return text.rfind("\\n", 0, pos) + 1\n\n\ndef line_end(text, pos):\n    e = text.find("\\n", pos)\n    return len(text) if e < 0 else e\n\n\ndef heading_level(line):\n    n = len(line) - len(line.lstrip("#"))\n    if 1 <= n <= 6 and (len(line) == n or line[n] == " "):\n        return n\n    return 0\n\n\ndef apply_heading(text, a, b, level):\n    """The line at the caret becomes a heading of this level (the same level again takes it back to a plain line). Returns (text, start, end)."""\n    ls, le = line_start(text, a), line_end(text, a)\n    line = text[ls:le]\n    body = line.lstrip("#").lstrip() if heading_level(line) else line\n    prefix = "" if heading_level(line) == level else "#" * level + " "\n    new_line = prefix + body\n    out = text[:ls] + new_line + text[le:]\n    end = ls + len(new_line)\n    return out, end, end\n\n\ndef apply_wrap(text, a, b, mark, placeholder):\n    """Wraps the selection in mark (** for bold, * for italic); wrapped already takes it off again. No selection: the placeholder, selected."""\n    m = len(mark)\n    sel = text[a:b]\n    if len(sel) >= 2 * m and sel.startswith(mark) and sel.endswith(mark):\n        inner = sel[m:-m]\n        return text[:a] + inner + text[b:], a, a + len(inner)\n    if a >= m and text[a - m:a] == mark and text[b:b + m] == mark and sel:\n        return text[:a - m] + sel + text[b + m:], a - m, a - m + len(sel)\n    inner = sel or placeholder\n    return text[:a] + mark + inner + mark + text[b:], a + m, a + m + len(inner)\n\n\ndef apply_prefix(text, a, b, prefix):\n    """Puts prefix in front of every line the selection touches (all have it already: takes it off). Returns the changed block as the selection."""\n    ls = line_start(text, a)\n    le = line_end(text, b if b == a or text[b - 1:b] != "\\n" else b - 1)\n    lines = text[ls:le].split("\\n")\n    if all(l.startswith(prefix) for l in lines if l.strip() or len(lines) == 1):\n        new = [l[len(prefix):] if l.startswith(prefix) else l for l in lines]\n    else:\n        new = [l if l.startswith(prefix) else prefix + l for l in lines]\n    block = "\\n".join(new)\n    return text[:ls] + block + text[le:], ls, ls + len(block)\n\n\ndef apply_paragraph(text, a, b, placeholder="新段落"):\n    """Inserts a new paragraph at the caret: the text is split there, one blank line on each side, the placeholder selected."""\n    head = text[:b].rstrip(" \\t\\n")\n    tail = text[b:].lstrip(" \\t\\n")\n    before = "\\n\\n" if head else ""\n    after = "\\n\\n" if tail else "\\n"\n    start = len(head) + len(before)\n    return head + before + placeholder + after + tail, start, start + len(placeholder)\n\n\ndef _edit(ctx, fn):\n    if ctx.state.get("preview"):\n        return  # 預覽中不能改文字\n    a, b = ctx.caret("body")\n    text, s, e = fn(ctx.get("body"), a, b)\n    ctx.set("body", value=text, caret=s, caret_to=e)\n\n\ndef heading(level):\n    return lambda ctx: _edit(ctx, lambda t, a, b: apply_heading(t, a, b, level))\n\n\ndef bold(ctx):\n    _edit(ctx, lambda t, a, b: apply_wrap(t, a, b, "**", "粗體文字"))\n\n\ndef italic(ctx):\n    _edit(ctx, lambda t, a, b: apply_wrap(t, a, b, "*", "斜體文字"))\n\n\ndef bullet(ctx):\n    _edit(ctx, lambda t, a, b: apply_prefix(t, a, b, "- "))\n\n\ndef quote(ctx):\n    _edit(ctx, lambda t, a, b: apply_prefix(t, a, b, "> "))\n\n\ndef insert_para(ctx):\n    _edit(ctx, apply_paragraph)\n    ctx.set("msg", text="已在游標處插入新段落")\n\n\ndef toggle_preview(ctx):\n    """編輯與預覽切換：預覽把 Markdown 畫成排版後的樣子（標題變大變粗、粗體變粗、清單有項目符號）。"""\n    on = not ctx.state.get("preview", False)\n    ctx.state["preview"] = on\n    if on:\n        ctx.set("view", value=ctx.get("body"))\n        ctx.set("body", visible=False)\n        ctx.set("view", visible=True)\n        ctx.set("preview_btn", text="編輯", icon="✎")\n        ctx.set("msg", text="預覽：排版後的樣子（按「編輯」回去改）")\n    else:\n        ctx.set("view", visible=False)\n        ctx.set("body", visible=True)\n        a, b = ctx.caret("body")\n        ctx.set("body", caret=a, caret_to=b)\n        ctx.set("preview_btn", text="預覽", icon="◉")\n        ctx.set("msg", text="編輯")\n\n\ndef save(ctx):\n    ctx.state["saved"] = ctx.state.get("saved", 0) + 1\n    ctx.set("msg", text="已存 %d 次" % ctx.state["saved"])\n\n\ndef build(win, spec, slots):\n    return {"handlers": {\n        "click:h1": heading(1), "click:h2": heading(2), "click:h3": heading(3),\n        "click:bold": bold, "click:italic": italic, "click:bullet": bullet, "click:quote": quote,\n        "click:insert_para": insert_para, "click:save": save, "click:preview_btn": toggle_preview,\n    }}\n',"guitpl_lib/game/main.jsonl":'{"kind":"meta","id":"game/main","title":"打磚塊（畫布小遊戲）","keywords":["遊戲","打磚塊","小遊戲","畫布","canvas"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"打磚塊","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"lives","default":"3","ask":"一開始有幾條命？"}\n{"kind":"param","name":"rows","default":"4","ask":"磚塊有幾排（1 到 6）？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"require","module":"random","source":"builtin"}\n{"kind":"style","palette":{"bg":"#111827","fg":"#f9fafb","accent":"#22c55e","danger":"#ef4444","muted":"#6b7280"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":640,"resizable":true,"height":560},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"screen","kind":"canvas","width":400,"height":300,"fps":15,"fit":true,"grow":1},{"id":"over_box","kind":"label","text":"遊戲結束","role":"title","grow":1},{"slot":"statusbar"},{"id":"help","kind":"label","text":"左右鍵移動擋板，空白鍵發球。","role":"muted","pad":8}]}]}\n{"kind":"slot","name":"toolbar","use":"game/toolbar","params":{}}\n{"kind":"slot","name":"statusbar","use":"game/statusbar","params":{"lives":"{{lives}}"}}\n{"kind":"scene","id":"play","title":"進行中","note":"畫布與操作說明","show":["screen","help"],"hide":["over_box"],"on":{"click:restart":"play"}}\n{"kind":"scene","id":"over","title":"結束","note":"只顯示結束訊息，可重新開始","show":["over_box"],"hide":["screen","help"],"on":{"click:restart":"play"}}\n{"kind":"shortcut","keys":"Left","do":"left"}\n{"kind":"shortcut","keys":"Right","do":"right"}\n{"kind":"shortcut","keys":"Space","do":"serve"}\n',"guitpl_lib/game/main.py":'# -*- coding: utf-8 -*-\n# 打磚塊：下方擋板左右移動，球撞到磚塊就得分，掉下去扣一條命，磚塊全打完或命用完就結束。\n# 畫布每秒 15 格（frame:screen 事件）推進一格；按鈕與快捷鍵只改狀態，畫面每格重畫（一格不超過 200 道指令）。\nimport random\n\nW, H = 400, 300\nPADDLE_W, PADDLE_H, PADDLE_Y = 70, 8, 276\nPADDLE_SPEED = 12\nBALL_R = 4\nBRICK_W, BRICK_H, GAP = 40, 14, 6\nROW_COLORS = ["#ef4444", "#f59e0b", "#22c55e", "#3b82f6", "#a855f7", "#14b8a6"]\n\n\ndef _fresh(lives, rows):\n    bricks = []\n    for r in range(rows):\n        for c in range(8):\n            bricks.append([14 + c * (BRICK_W + GAP), 40 + r * (BRICK_H + GAP), r])\n    return {"paddle": (W - PADDLE_W) / 2.0, "ball": [W / 2.0, PADDLE_Y - 20.0], "vel": [0.0, 0.0],\n            "bricks": bricks, "lives": lives, "score": 0, "running": True, "over": False, "shown": None}\n\n\ndef _step(G):\n    x, y = G["ball"]\n    vx, vy = G["vel"]\n    x += vx\n    y += vy\n    if x - BALL_R < 0 or x + BALL_R > W:\n        vx = -vx\n        x = min(max(x, BALL_R), W - BALL_R)\n    if y - BALL_R < 0:\n        vy = -vy\n        y = BALL_R\n    p = G["paddle"]\n    if vy > 0 and PADDLE_Y - BALL_R <= y <= PADDLE_Y + PADDLE_H and p - BALL_R <= x <= p + PADDLE_W + BALL_R:\n        vy = -abs(vy)\n        vx = (x - (p + PADDLE_W / 2.0)) / 10.0      # 撞在擋板的哪裡，決定球往哪邊飛\n    for b in G["bricks"]:\n        bx, by = b[0], b[1]\n        if bx - BALL_R <= x <= bx + BRICK_W + BALL_R and by - BALL_R <= y <= by + BRICK_H + BALL_R:\n            G["bricks"].remove(b)\n            G["score"] += 1\n            vy = -vy\n            break\n    if y > H:                                       # 球掉下去：扣一條命，球回到擋板上\n        G["lives"] -= 1\n        x, y = p + PADDLE_W / 2.0, PADDLE_Y - 20.0\n        vx, vy = 0.0, 0.0\n    G["ball"] = [x, y]\n    G["vel"] = [vx, vy]\n\n\ndef _end(ctx, G, message):\n    G["over"] = True\n    G["running"] = False\n    ctx.set("over_box", text=message)\n    ctx.goto("over")\n\n\ndef _show(ctx, G):\n    now = (G["score"], G["lives"])\n    if now != G["shown"]:\n        G["shown"] = now\n        ctx.set("score_text", text="分數 %d" % G["score"])\n        ctx.set("lives_text", text="命 %d" % G["lives"])\n\n\ndef _tick(ctx, G, pal):\n    if G["running"] and not G["over"]:\n        if G["vel"] == [0.0, 0.0]:                  # 還沒發球：球跟著擋板走\n            G["ball"] = [G["paddle"] + PADDLE_W / 2.0, PADDLE_Y - 20.0]\n        else:\n            _step(G)\n        if G["lives"] <= 0:\n            _end(ctx, G, "命用完了，分數 %d" % G["score"])\n        elif not G["bricks"]:\n            _end(ctx, G, "全部打完！分數 %d" % G["score"])\n    _show(ctx, G)\n    ops = [["clear", pal.get("bg", "#000000")]]\n    for bx, by, row in G["bricks"]:\n        ops.append(["rect", bx, by, BRICK_W, BRICK_H, ROW_COLORS[row % len(ROW_COLORS)]])\n    ops.append(["rect", int(G["paddle"]), PADDLE_Y, PADDLE_W, PADDLE_H, pal.get("fg", "#ffffff")])\n    ops.append(["circle", int(G["ball"][0]), int(G["ball"][1]), BALL_R, pal.get("accent", "#22c55e")])\n    ctx.w.draw(ctx.id("screen"), ops)\n\n\ndef build(win, spec, slots):\n    lives = max(1, int(spec["params"].get("lives", 3)))\n    rows = max(1, min(6, int(spec["params"].get("rows", 4))))\n    pal = spec["style"].get("palette", {})\n    G = _fresh(lives, rows)\n\n    def move(d):\n        def handler(ctx):\n            G["paddle"] = min(max(0.0, G["paddle"] + d), W - PADDLE_W)\n        return handler\n\n    def serve(ctx):\n        if G["over"]:\n            return\n        if G["vel"] == [0.0, 0.0]:\n            G["vel"] = [random.choice((-2.5, 2.5)), -3.5]\n        G["running"] = True\n\n    def pause(ctx):\n        if G["over"]:\n            return\n        G["running"] = not G["running"]\n        ctx.set("pause", text="繼續" if not G["running"] else "暫停")\n\n    def restart(ctx):\n        G.update(_fresh(lives, rows))\n        ctx.set("pause", text="暫停")\n        ctx.goto("play")\n        _show(ctx, G)\n\n    def frame(ctx):\n        _tick(ctx, G, pal)\n\n    return {"handlers": {\n        "frame:screen": frame,\n        "shortcut:left": move(-PADDLE_SPEED),\n        "shortcut:right": move(PADDLE_SPEED),\n        "shortcut:serve": serve,\n        "click:serve": serve,\n        "click:pause": pause,\n        "click:restart": restart,\n    }}\n',"guitpl_lib/game/main_dark.jsonl":'{"kind":"meta","id":"game/main_dark","title":"打磚塊（夜間）","keywords":["遊戲","打磚塊","深色","夜間"],"extends":"game/main"}\n{"kind":"param","name":"title","default":"打磚塊（夜間）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#000000","fg":"#e5e7eb","accent":"#4ade80","danger":"#f87171","muted":"#4b5563"}}\n',"guitpl_lib/game/main_dark.py":'# -*- coding: utf-8 -*-\n# 夜間版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_game_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/game/main_light.jsonl":'{"kind":"meta","id":"game/main_light","title":"打磚塊（明亮）","keywords":["遊戲","打磚塊","淺色","明亮"],"extends":"game/main"}\n{"kind":"param","name":"title","default":"打磚塊（明亮）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#f8fafc","fg":"#0f172a","accent":"#2563eb","danger":"#dc2626","muted":"#94a3b8"}}\n',"guitpl_lib/game/main_light.py":'# -*- coding: utf-8 -*-\n# 明亮版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_game_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/game/statusbar.jsonl":'{"kind":"meta","id":"game/statusbar","title":"遊戲狀態列（分數、剩餘命數）","keywords":["狀態列","分數","命數","遊戲"],"entry":"build"}\n{"kind":"param","name":"lives","default":"3","ask":"剩幾條命？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"score_text","kind":"label","text":"分數 0"},{"id":"lives_text","kind":"label","text":"命 {{lives}}"}]}]}\n',"guitpl_lib/game/statusbar.py":"# -*- coding: utf-8 -*-\n# 遊戲狀態列只顯示：分數與命數由 main.py 用名稱 score_text、lives_text 更新。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/game/toolbar.jsonl":'{"kind":"meta","id":"game/toolbar","title":"遊戲工具列（發球、暫停、重新開始）","keywords":["工具列","遊戲","發球","暫停"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"serve","kind":"button","text":"發球","icon":"▶","role":"primary"},{"id":"pause","kind":"button","text":"暫停","icon":"⏸"},{"id":"restart","kind":"button","text":"重新開始","icon":"↻"}]}]}\n',"guitpl_lib/game/toolbar.py":"# -*- coding: utf-8 -*-\n# 遊戲工具列只負責按鈕：按下後的事件（click:serve、click:pause、click:restart）由 main.py 處理。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/idphoto/main.jsonl":'{"kind":"meta","id":"idphoto/main","title":"證件照（簡化版）","keywords":["證件照","大頭照","證件","照片","背景色"],"entry":"build","standalone":true}\n{"kind":"param","name":"name","default":"證件照","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"bg","default":"白","ask":"預設背景色要選哪一個（白、淺藍、淺灰、紅）？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{name}}","width":840,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"main_row","kind":"row","grow":1,"pad":16,"gap":16,"children":[{"id":"choose_panel","kind":"column","role":"card","children":[{"kind":"label","text":"尺寸","role":"heading"},{"id":"size_list","kind":"list","items":["一吋 2.5×3.5 公分","二吋 3.5×5.3 公分","護照 3.3×4.8 公分"],"selected":"一吋 2.5×3.5 公分"},{"kind":"label","text":"背景色","role":"heading"},{"id":"bg_list","kind":"list","items":["白","淺藍","淺灰","紅"],"selected":"{{bg}}"},{"kind":"row","children":[{"id":"preview_btn","kind":"button","text":"預覽","role":"primary"},{"id":"open_btn","kind":"button","text":"開啟照片"},{"id":"finish_btn","kind":"button","text":"輸出"}]}]},{"id":"view","kind":"canvas","width":240,"height":300,"fit":true,"grow":1}]},{"id":"info","kind":"label","text":"尺寸與背景色","role":"muted","pad":8},{"id":"done_panel","kind":"column","grow":1,"pad":16,"gap":12,"children":[{"id":"done_txt","kind":"label","text":"已輸出（簡化版：只示意，未存檔）","role":"title","grow":1},{"id":"back_btn","kind":"button","text":"重新選擇","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"idphoto/toolbar","params":{"caption":"證件照工具"}}\n{"kind":"slot","name":"statusbar","use":"idphoto/statusbar","params":{"hint":"請選尺寸與背景色"}}\n{"kind":"scene","id":"choose","title":"選擇中","note":"選尺寸與背景色，預覽框顯示裁切線示意","show":["choose_panel","view","info","main_row"],"hide":["done_panel"],"on":{"click:finish_btn":"done","shortcut:finish":"done"}}\n{"kind":"scene","id":"done","title":"已輸出","note":"只顯示完成訊息","show":["done_panel"],"hide":["choose_panel","view","info","main_row"],"on":{"click:back_btn":"choose"}}\n{"kind":"shortcut","keys":"Ctrl+R","do":"redraw"}\n{"kind":"shortcut","keys":"Ctrl+E","do":"finish"}\n',"guitpl_lib/idphoto/main.py":'# -*- coding: utf-8 -*-\n# 證件照（簡化版）：只畫尺寸與背景色的示意圖與裁切線，不做人臉偵測與真的裁切。\n# 畫布一幀最多 200 道繪圖指令，這裡每次約 15 道。\n\nSIZE_ORDER = ["一吋 2.5×3.5 公分", "二吋 3.5×5.3 公分", "護照 3.3×4.8 公分"]\nSIZE_CM = {"一吋 2.5×3.5 公分": (2.5, 3.5), "二吋 3.5×5.3 公分": (3.5, 5.3), "護照 3.3×4.8 公分": (3.3, 4.8)}\nBG = {"白": "#ffffff", "淺藍": "#9ec9ff", "淺灰": "#d9d9d9", "紅": "#e0343a"}\nCW, CH = 240, 300  # 要和 jsonl 裡 view 畫布的寬高一致\n\n\ndef _redraw(ctx):\n    size = ctx.get("size_list") or SIZE_ORDER[0]\n    bg = ctx.get("bg_list") or "白"\n    guide = ctx.state.get("guide", True)\n    w_cm, h_cm = SIZE_CM.get(size, SIZE_CM[SIZE_ORDER[0]])\n    # 等比例縮放：寬不超過 200、高不超過 280\n    scale = min(200.0 / w_cm, 280.0 / h_cm)\n    bw, bh = w_cm * scale, h_cm * scale\n    x0, y0 = (CW - bw) / 2.0, (CH - bh) / 2.0\n    cx = CW / 2.0\n    x1, y1 = x0 + bw, y0 + bh\n    ops = [\n        ["clear", "#444444"],\n        ["rect", int(x0), int(y0), int(bw), int(bh), BG.get(bg, "#ffffff")],\n    ]\n    photo = ctx.state.get("photo")\n    if photo:  # 使用者開啟的照片：縮放塞進裁切框（簡化版：不做人臉偵測，也不去背）\n        ops.append(["image", photo, int(x0), int(y0), int(bw), int(bh)])\n    else:\n        ops += [\n            ["circle", int(cx), int(y0 + bh * 0.35), int(bh * 0.14), "#e8b48a"],\n            ["rect", int(cx - bw * 0.3), int(y0 + bh * 0.52), int(bw * 0.6), int(bh * 0.4), "#3b4a6b"],\n        ]\n    ops.append(["text", 8, 16, size, "#ffffff"])\n    if guide:\n        eye = int(y0 + bh * 0.3)\n        ops += [\n            ["line", int(x0), eye, int(x1), eye, "#00c853"],\n            ["line", int(cx), int(y0), int(cx), int(y1), "#00c853"],\n            ["line", int(x0), int(y0), int(x1), int(y0), "#ff3b30"],\n            ["line", int(x0), int(y1), int(x1), int(y1), "#ff3b30"],\n            ["line", int(x0), int(y0), int(x0), int(y1), "#ff3b30"],\n            ["line", int(x1), int(y0), int(x1), int(y1), "#ff3b30"],\n        ]\n    ctx.w.draw(ctx.id("view"), ops)\n    ctx.set("info", text="尺寸 %s、背景%s%s" % (size, bg, "（顯示裁切線）" if guide else ""))\n\n\ndef build(win, spec, slots):\n    def reset(ctx):\n        ctx.set("size_list", selected=SIZE_ORDER[0])\n        ctx.set("bg_list", selected="白")\n        ctx.state["guide"] = True\n        _redraw(ctx)\n\n    def open_photo(ctx):\n        try:\n            f = ctx.pick_file("開啟照片", accept="image/*", max_bytes=256 * 1024)\n        except ValueError as e:\n            ctx.set("info", text=str(e))\n            return\n        if f is None:\n            return\n        try:\n            name, w, h = ctx.w.image(ctx.id("view"), f["data"], f["mime"])\n        except Exception as e:  # 瀏覽器解不開的圖片\n            ctx.set("info", text="開不了這張照片：%s" % e)\n            return\n        ctx.state["photo"] = name\n        _redraw(ctx)\n        ctx.set("info", text="已開啟 %s（%d×%d），縮放進裁切框" % (f["name"], w, h))\n\n    def toggle_guide(ctx):\n        ctx.state["guide"] = not ctx.state.get("guide", True)\n        _redraw(ctx)\n\n    def finish(ctx):\n        size = ctx.get("size_list") or SIZE_ORDER[0]\n        ctx.set("done_txt", text="已輸出 %s（簡化版：只示意，未存檔）" % size)\n        _redraw(ctx)\n\n    return {"handlers": {\n        "select:size_list": _redraw,\n        "select:bg_list": _redraw,\n        "click:preview_btn": _redraw,\n        "click:open_btn": open_photo,\n        "shortcut:redraw": _redraw,\n        "click:tb_guide": toggle_guide,\n        "click:tb_reset": reset,\n        "click:finish_btn": finish,\n        "shortcut:finish": finish,\n    }}\n',"guitpl_lib/idphoto/main_dark.jsonl":'{"kind":"meta","id":"idphoto/main_dark","title":"深色證件照（簡化版）","keywords":["深色證件照","夜間證件照"],"extends":"idphoto/main"}\n{"kind":"param","name":"name","default":"夜間證件照","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","muted":"#6b7280"},"font":"monospace"}\n',"guitpl_lib/idphoto/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色變體：只覆寫 style 與視窗標題參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_idphoto_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/idphoto/main_light.jsonl":'{"kind":"meta","id":"idphoto/main_light","title":"淺色證件照（簡化版）","keywords":["淺色證件照","明亮證件照"],"extends":"idphoto/main"}\n{"kind":"param","name":"bg","default":"淺藍","ask":"預設背景色要選哪一個（白、淺藍、淺灰、紅）？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#f8fafc","fg":"#0f172a","accent":"#059669"},"font":"sans-serif","radius":10}\n',"guitpl_lib/idphoto/main_light.py":'# -*- coding: utf-8 -*-\n# 淺色變體：只覆寫 style 與背景色參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_idphoto_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/idphoto/statusbar.jsonl":'{"kind":"meta","id":"idphoto/statusbar","title":"證件照狀態列","keywords":["證件照狀態列","狀態列"],"entry":"build"}\n{"kind":"param","name":"hint","default":"請選尺寸與背景色","ask":"狀態列一開始要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"sb_text","kind":"label","text":"{{hint}}"}]}]}\n',"guitpl_lib/idphoto/statusbar.py":"# -*- coding: utf-8 -*-\n# 狀態列沒有自己的行為：主畫面用 sb_text 這個名稱更新文字。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/idphoto/toolbar.jsonl":'{"kind":"meta","id":"idphoto/toolbar","title":"證件照工具列","keywords":["證件照工具列","工具列"],"entry":"build"}\n{"kind":"param","name":"caption","default":"證件照工具","ask":"工具列左邊要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"kind":"label","text":"{{caption}}"},{"id":"tb_reset","kind":"button","text":"重設","icon":"↺"},{"id":"tb_guide","kind":"button","text":"裁切線開關","icon":"⌗"}]}]}\n',"guitpl_lib/idphoto/toolbar.py":"# -*- coding: utf-8 -*-\n# 工具列的按鈕（重設、裁切線開關）由主畫面處理，因為要重畫預覽框。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/image/main.jsonl":'{"kind":"meta","id":"image/main","title":"影像處理（簡化版）","keywords":["影像","濾鏡","圖層","處理","反相","灰階"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"影像處理","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"layer_max","default":"8","ask":"圖層最多可以疊幾層？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2937","accent":"#2563eb","danger":"#dc2626","muted":"#6b7280"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":900,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"row","grow":1,"children":[{"id":"left","kind":"column","role":"sidebar","children":[{"kind":"label","text":"工具（點選後加入圖層）","role":"heading"},{"id":"tools","kind":"list","items":["反相","灰階","提亮","變暗","紅色通道"],"selected":"反相","grow":1},{"id":"add","kind":"button","text":"加入圖層","role":"primary"}]},{"id":"right","kind":"column","grow":1,"pad":16,"gap":10,"children":[{"id":"preview","kind":"canvas","width":312,"height":208,"fit":true,"grow":3},{"kind":"label","text":"圖層（由下往上套用）","role":"heading"},{"id":"layers","kind":"list","items":[],"grow":1}]}]},{"id":"actions","kind":"row","pad":10,"children":[{"id":"open_img","kind":"button","text":"開啟圖片"},{"id":"orig","kind":"button","text":"看原圖比對"},{"id":"note","kind":"label","text":"原圖（未套用任何圖層）","role":"muted"},{"id":"back","kind":"button","text":"回到編輯","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"image/toolbar"}\n{"kind":"slot","name":"statusbar","use":"image/statusbar"}\n{"kind":"scene","id":"edit","title":"編輯中","note":"工具、圖層與預覽","show":["left","right","orig","open_img"],"hide":["note","back"],"on":{"click:orig":"compare"}}\n{"kind":"scene","id":"compare","title":"比對原圖","note":"只顯示原圖","show":["right","note","back"],"hide":["left","orig","open_img"],"on":{"click:back":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+Enter","do":"add"}\n{"kind":"shortcut","keys":"Ctrl+Z","do":"undo"}\n',"guitpl_lib/image/main.py":'# -*- coding: utf-8 -*-\n# 影像處理（簡化版）：畫布用 12x8 的小方格當作一張小圖，每個方格的顏色依序套用圖層的效果。\n# 撤銷與清空由工具列子元件處理；這裡包住它們的處理函式並重畫。\n\nW = 12\nH = 8\nCELL = 26\n\n\ndef clamp(v):\n    return max(0, min(255, int(v)))\n\n\ndef gray(c):\n    g = int(0.3 * c[0] + 0.59 * c[1] + 0.11 * c[2])\n    return (g, g, g)\n\n\nEFFECTS = {\n    "反相": lambda c: (255 - c[0], 255 - c[1], 255 - c[2]),\n    "灰階": gray,\n    "提亮": lambda c: (clamp(c[0] + 40), clamp(c[1] + 40), clamp(c[2] + 40)),\n    "變暗": lambda c: (clamp(c[0] - 40), clamp(c[1] - 40), clamp(c[2] - 40)),\n    "紅色通道": lambda c: (c[0], 0, 0),\n}\n\n\ndef base(x, y):\n    return (x * 255 // (W - 1), y * 255 // (H - 1), 128)\n\n\ndef pixel(x, y, layers):\n    c = base(x, y)\n    for name in layers:\n        c = EFFECTS[name](c)\n    return c\n\n\ndef hexcolor(c):\n    return "#%02x%02x%02x" % c\n\n\ndef draw(ctx, colors):\n    layers = ctx.state.get("layers", [])\n    original = ctx.scene == "compare"\n    ops = [["clear", colors["bg"]]]\n    photo = ctx.state.get("photo")\n    if photo:  # 使用者開啟的圖片：整張畫在畫布上（簡化版：圖層效果只套在示範小圖，不套在開啟的圖片）\n        ops.append(["image", photo, 0, 0, W * CELL, H * CELL])\n        ctx.w.draw(ctx.id("preview"), ops)\n        ctx.set("layers", items=["%d. %s" % (i + 1, n) for i, n in enumerate(layers)])\n        return\n    for y in range(H):\n        for x in range(W):\n            c = base(x, y) if original else pixel(x, y, layers)\n            ops.append(["rect", x * CELL, y * CELL, CELL, CELL, hexcolor(c)])\n    ctx.w.draw(ctx.id("preview"), ops)\n    ctx.set("layers", items=["%d. %s" % (i + 1, n) for i, n in enumerate(layers)])\n\n\ndef int_param(value, default):\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        return default\n\n\ndef build(win, spec, slots):\n    pal = (spec.get("style") or {}).get("palette") or {}\n    colors = {\n        "bg": pal.get("bg", "#ffffff"), "fg": pal.get("fg", "#1f2937"), "accent": pal.get("accent", "#2563eb"),\n        "danger": pal.get("danger", "#dc2626"), "muted": pal.get("muted", "#6b7280"),\n    }\n    max_layers = max(1, min(32, int_param(spec["params"].get("layer_max"), 8)))\n    tb = slots["toolbar"]["handlers"]\n\n    def add(ctx):\n        layers = ctx.state.setdefault("layers", [])\n        name = ctx.get("tools")\n        if name not in EFFECTS:\n            name = next(iter(EFFECTS))\n        if len(layers) >= max_layers:\n            ctx.set("status", text="圖層已達上限 %d 層" % max_layers)\n            return\n        layers.append(name)\n        ctx.set("status", text="已加入「%s」" % name)\n        draw(ctx, colors)\n\n    def open_image(ctx):\n        try:\n            f = ctx.pick_file("開啟圖片", accept="image/*", max_bytes=256 * 1024)\n        except ValueError as e:\n            ctx.set("status", text=str(e))\n            return\n        if f is None:\n            ctx.set("status", text="沒有選檔案")\n            return\n        try:\n            name, w, h = ctx.w.image(ctx.id("preview"), f["data"], f["mime"])\n        except Exception as e:  # 瀏覽器解不開的圖片\n            ctx.set("status", text="開不了這張圖片：%s" % e)\n            return\n        ctx.state["photo"] = name\n        ctx.set("status", text="已開啟 %s（%d×%d；簡化版：圖層效果不套在開啟的圖片上）" % (f["name"], w, h))\n        draw(ctx, colors)\n\n    def redraw_after(fn):\n        def handler(ctx):\n            fn(ctx)\n            draw(ctx, colors)\n        return handler\n\n    handlers = {key: redraw_after(fn) for key, fn in tb.items()}\n    handlers["click:add"] = add\n    handlers["click:open_img"] = open_image\n    handlers["shortcut:add"] = add\n    handlers["start"] = lambda ctx: draw(ctx, colors)\n    handlers["click:orig"] = redraw_after(lambda ctx: None)\n    handlers["click:back"] = redraw_after(lambda ctx: None)\n    return {"handlers": handlers}\n',"guitpl_lib/image/main_dark.jsonl":'{"kind":"meta","id":"image/main_dark","title":"深色影像處理（簡化版）","keywords":["深色","夜間","影像"],"extends":"image/main"}\n{"kind":"param","name":"title","default":"夜間影像處理","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#e5e7eb","accent":"#4aa3ff","danger":"#ef4444","muted":"#9ca3af"},"font":"monospace"}\n',"guitpl_lib/image/main_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 image/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_image_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/image/main_light.jsonl":'{"kind":"meta","id":"image/main_light","title":"淺色影像處理（簡化版）","keywords":["淺色","明亮","影像"],"extends":"image/main"}\n{"kind":"param","name":"title","default":"淺色影像處理","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#111827","accent":"#7c3aed","danger":"#e11d48","muted":"#6b7280"}}\n',"guitpl_lib/image/main_light.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 image/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_image_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/image/statusbar.jsonl":'{"kind":"meta","id":"image/statusbar","title":"狀態列","keywords":["狀態列","狀態","訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/image/statusbar.py":'# -*- coding: utf-8 -*-\n# 狀態列只負責顯示；其他元件用名稱 "status" 寫入訊息。\n\n\ndef build(win, spec, slots):\n    return {}\n',"guitpl_lib/image/toolbar.jsonl":'{"kind":"meta","id":"image/toolbar","title":"圖層工具列（復原、清空）","keywords":["工具列","復原","清空","圖層"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"undo","kind":"button","text":"復原一層","icon":"↶"},{"id":"clear","kind":"button","text":"清空圖層","icon":"✖"}]}]}\n',"guitpl_lib/image/toolbar.py":'# -*- coding: utf-8 -*-\n# 圖層工具列：復原最上面一層、清空全部圖層。圖層資料在 ctx.state["layers"]，畫面重畫由主元件負責。\n\n\ndef build(win, spec, slots):\n    def undo(ctx):\n        layers = ctx.state.setdefault("layers", [])\n        if layers:\n            name = layers.pop()\n            ctx.set("status", text="已復原「%s」" % name)\n        else:\n            ctx.set("status", text="沒有可以復原的圖層")\n\n    def clear(ctx):\n        ctx.state["layers"] = []\n        ctx.set("status", text="已清空圖層")\n\n    return {"handlers": {"click:undo": undo, "click:clear": clear, "shortcut:undo": undo}}\n',"guitpl_lib/inventory/main.jsonl":'{"kind":"meta","id":"inventory/main","title":"進銷存","keywords":["進銷存","庫存","進貨","銷貨","商品"],"entry":"build","standalone":true}\n{"kind":"param","name":"shop","default":"我的小店","ask":"店名要寫什麼？"}\n{"kind":"param","name":"low","default":"5","ask":"庫存低於幾件要警示？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{shop}} 進銷存","width":780,"resizable":true,"height":600},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"edit_panel","kind":"row","grow":1,"pad":16,"gap":16,"children":[{"kind":"column","grow":1,"gap":8,"children":[{"kind":"label","text":"選商品與數量","role":"heading"},{"id":"prod_pick","kind":"list","items":["紙杯","吸管","湯匙"],"selected":"紙杯","grow":1}]},{"kind":"column","role":"card","children":[{"kind":"label","text":"數量","role":"muted"},{"id":"qty","kind":"entry","value":"1"},{"kind":"row","children":[{"id":"stock_in","kind":"button","text":"進貨","role":"primary"},{"id":"stock_out","kind":"button","text":"銷貨"},{"id":"stats_btn","kind":"button","text":"統計","role":"outline"}]},{"id":"msg","kind":"label","text":"就緒","role":"muted"}]}]},{"id":"stats_panel","kind":"column","grow":1,"pad":16,"gap":8,"children":[{"kind":"label","text":"庫存統計","role":"heading"},{"id":"stock_table","kind":"table","columns":["商品","庫存"],"rows":[["紙杯","12"],["吸管","30"],["湯匙","8"]],"grow":1},{"id":"stat_total","kind":"label","text":"共 50 件、3 種商品"},{"id":"stat_low","kind":"label","text":"低於警示門檻的商品","role":"danger"},{"id":"low_hint","kind":"label","text":"警示門檻：低於 {{low}} 件","role":"muted"},{"id":"back_btn","kind":"button","text":"回到進銷","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"inventory/toolbar","params":{"caption":"進銷"}}\n{"kind":"slot","name":"statusbar","use":"inventory/statusbar","params":{"hint":"歡迎使用 {{shop}}"}}\n{"kind":"scene","id":"edit","title":"進貨與銷貨","note":"選商品、輸入數量、按進貨或銷貨","show":["edit_panel"],"hide":["stats_panel"],"on":{"click:stats_btn":"stats","click:tb_stats":"stats"}}\n{"kind":"scene","id":"stats","title":"庫存統計","note":"顯示商品庫存表與警示","show":["stats_panel"],"hide":["edit_panel"],"on":{"click:back_btn":"edit","click:tb_form":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+I","do":"stock_in"}\n{"kind":"shortcut","keys":"Ctrl+O","do":"stock_out"}\n',"guitpl_lib/inventory/main.py":'# -*- coding: utf-8 -*-\n# 進銷存主畫面：庫存記在 ctx.state["stock"]（第一次用到才建立），統計場景打開時重新整理表格與警示。\n# 表格初始資料與 layout 裡的 stock_table 相同。\n\nPRODUCTS = [("紙杯", 12), ("吸管", 30), ("湯匙", 8)]\n\n\ndef _to_int(text, default):\n    try:\n        return int(str(text).strip())\n    except ValueError:\n        return default\n\n\ndef _stock(ctx):\n    if "stock" not in ctx.state:\n        ctx.state["stock"] = dict(PRODUCTS)\n    return ctx.state["stock"]\n\n\ndef _msg(ctx, text):\n    ctx.set("msg", text=text)\n    ctx.set("sb_text", text=text)\n\n\ndef _move(ctx, sign):\n    # sign +1 是進貨，-1 是銷貨\n    stock = _stock(ctx)\n    name = ctx.get("prod_pick")\n    qty = _to_int(ctx.get("qty"), 0)\n    if name not in stock:\n        _msg(ctx, "請先選一個商品")\n        return\n    if qty <= 0:\n        _msg(ctx, "數量要是大於 0 的整數")\n        return\n    if sign < 0 and stock[name] < qty:\n        _msg(ctx, "%s 庫存不足，只剩 %d 件" % (name, stock[name]))\n        ctx.tone(220, 200, "square")\n        return\n    stock[name] += sign * qty\n    _msg(ctx, "%s%s %d 件，現有 %d 件" % (name, "進貨" if sign > 0 else "銷貨", qty, stock[name]))\n\n\ndef build(win, spec, slots):\n    low = _to_int(spec["params"].get("low"), 5)\n\n    def show_stats(ctx):\n        stock = _stock(ctx)\n        ctx.set("stock_table", rows=[[k, str(v)] for k, v in sorted(stock.items())])\n        ctx.set("stat_total", text="共 %d 件、%d 種商品" % (sum(stock.values()), len(stock)))\n        names = [k for k, v in sorted(stock.items()) if v < low]\n        ctx.set("stat_low", text="低於 %d 件的商品：%s" % (low, "、".join(names) or "無"))\n\n    def stock_in(ctx):\n        _move(ctx, 1)\n\n    def stock_out(ctx):\n        _move(ctx, -1)\n\n    return {"handlers": {\n        "click:stock_in": stock_in,\n        "click:stock_out": stock_out,\n        "shortcut:stock_in": stock_in,\n        "shortcut:stock_out": stock_out,\n        "click:stats_btn": show_stats,\n        "click:tb_stats": show_stats,\n    }}\n',"guitpl_lib/inventory/main_dark.jsonl":'{"kind":"meta","id":"inventory/main_dark","title":"深色進銷存","keywords":["深色進銷存","夜間進銷存"],"extends":"inventory/main"}\n{"kind":"param","name":"shop","default":"夜間小店","ask":"店名要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","muted":"#6b7280"},"font":"monospace"}\n',"guitpl_lib/inventory/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色變體：只覆寫 style 與店名參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_inventory_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/inventory/main_light.jsonl":'{"kind":"meta","id":"inventory/main_light","title":"淺色進銷存","keywords":["淺色進銷存","明亮進銷存"],"extends":"inventory/main"}\n{"kind":"param","name":"shop","default":"明亮小店","ask":"店名要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#f8fafc","fg":"#0f172a","accent":"#059669"},"font":"sans-serif","radius":10}\n',"guitpl_lib/inventory/main_light.py":'# -*- coding: utf-8 -*-\n# 淺色變體：只覆寫 style 與店名參數，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_inventory_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/inventory/statusbar.jsonl":'{"kind":"meta","id":"inventory/statusbar","title":"狀態列","keywords":["狀態列","狀態"],"entry":"build"}\n{"kind":"param","name":"hint","default":"就緒","ask":"狀態列一開始要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"sb_text","kind":"label","text":"{{hint}}"}]}]}\n',"guitpl_lib/inventory/statusbar.py":"# -*- coding: utf-8 -*-\n# 狀態列沒有自己的行為：主畫面用 sb_text 這個名稱更新文字。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/inventory/toolbar.jsonl":'{"kind":"meta","id":"inventory/toolbar","title":"進銷存工具列","keywords":["工具列","進銷存"],"entry":"build"}\n{"kind":"param","name":"caption","default":"進銷","ask":"工具列左邊要顯示什麼字？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"kind":"label","text":"{{caption}}"},{"id":"tb_form","kind":"button","text":"進銷","icon":"▤"},{"id":"tb_stats","kind":"button","text":"統計","icon":"▥"},{"kind":"label","text":"","role":"divider"},{"id":"tb_clear","kind":"button","text":"清除訊息","icon":"✖"}]}]}\n',"guitpl_lib/inventory/toolbar.py":'# -*- coding: utf-8 -*-\n# 工具列：清除訊息只動主畫面的訊息列與狀態列（名稱由主畫面提供）。\n\n\ndef build(win, spec, slots):\n    def clear(ctx):\n        ctx.set("msg", text="")\n        ctx.set("sb_text", text="")\n\n    return {"handlers": {"click:tb_clear": clear}}\n',"guitpl_lib/media/main.jsonl":'{"kind":"meta","id":"media/main","title":"多媒體播放與編碼（簡化版）","keywords":["多媒體","影片","音訊","播放","編碼","解碼","格式"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"多媒體播放器","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"bitrate","default":"1500","ask":"預設編碼位元率要設多少 kbps？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2937","accent":"#2563eb","danger":"#dc2626","muted":"#6b7280"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":900,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"kind":"row","grow":1,"children":[{"kind":"column","role":"sidebar","children":[{"kind":"label","text":"播放清單","role":"heading"},{"id":"playlist","kind":"list","items":["片段 A（30 秒）","片段 B（45 秒）","片段 C（20 秒）"],"selected":"片段 A（30 秒）","grow":1}]},{"kind":"column","grow":1,"pad":16,"gap":12,"children":[{"id":"screen","kind":"canvas","width":240,"height":135,"fps":10,"fit":true,"grow":1},{"id":"progress","kind":"progress","value":0,"max":100},{"slot":"transport"}]}]},{"kind":"row","role":"toolbar","children":[{"kind":"label","text":"格式"},{"id":"fmt","kind":"list","items":["MP4","WebM","MP3"],"selected":"MP4"},{"kind":"label","text":"位元率 kbps"},{"id":"bitrate","kind":"entry","value":"{{bitrate}}"},{"id":"encode","kind":"button","text":"編碼","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"transport","use":"media/transport"}\n{"kind":"slot","name":"statusbar","use":"media/statusbar"}\n{"kind":"scene","id":"idle","title":"停止中","note":"按播放開始；清單可切換片段","show":["play"],"hide":["pause"],"on":{"click:play":"playing"}}\n{"kind":"scene","id":"playing","title":"播放中","note":"進度條與畫面隨時間前進","show":["pause"],"hide":["play"],"on":{"click:pause":"idle"}}\n{"kind":"shortcut","keys":"Space","do":"toggle"}\n{"kind":"shortcut","keys":"Ctrl+E","do":"encode"}\n',"guitpl_lib/media/main.py":'# -*- coding: utf-8 -*-\n# 多媒體播放與編碼（簡化版）：不真的解碼，用畫布畫出模擬的畫面，進度與時間依播放頭計算；\n# 編碼只估算輸出大小。播放、暫停、停止與切換在 transport 子元件與這裡的處理函式。\n# 畫布每秒 10 個 frame 事件，每個 frame 前進 0.1 秒。\n\nTRACKS = [("片段 A（30 秒）", 30), ("片段 B（45 秒）", 45), ("片段 C（20 秒）", 20)]\nBAR_COLORS = ["#2563eb", "#16a34a", "#dc2626"]\nFORMATS = ("MP4", "WebM", "MP3")\nSTEP = 0.1\n\n\ndef mmss(sec):\n    sec = int(sec)\n    return "%d:%02d" % (sec // 60, sec % 60)\n\n\ndef draw_screen(ctx, track, pos):\n    name, total = TRACKS[track]\n    ops = [["clear", "#111827"]]\n    for i in range(8):\n        h = 20 + (int(pos * 10) + i * 17) % 60\n        ops.append(["rect", 10 + i * 28, 135 - h - 30, 20, h, BAR_COLORS[track]])\n    ops.append(["text", 10, 10, name, "#ffffff"])\n    ops.append(["text", 10, 28, mmss(pos) + " / " + mmss(total), "#d1d5db"])\n    ctx.w.draw(ctx.id("screen"), ops)\n\n\ndef on_frame(ctx):\n    st = ctx.state\n    track = st.get("track", 0)\n    total = TRACKS[track][1]\n    if not st.get("playing") and not st.get("dirty", True):\n        return\n    if st.get("playing"):\n        st["pos"] = st.get("pos", 0.0) + STEP\n        if st["pos"] >= total:\n            st.update(playing=False, pos=float(total))\n            ctx.goto("idle")\n            ctx.set("status", text="播放完畢")\n    st["dirty"] = False\n    pos = st.get("pos", 0.0)\n    draw_screen(ctx, track, pos)\n    ctx.set("progress", value=int(pos * 100 / total))\n    ctx.set("time", text="%s / %s" % (mmss(pos), mmss(total)))\n\n\ndef select_track(ctx):\n    ctx.set("playlist", selected=TRACKS[ctx.state.get("track", 0)][0])\n\n\ndef change(ctx, step):\n    st = ctx.state\n    st["track"] = (st.get("track", 0) + step) % len(TRACKS)\n    st.update(pos=0.0, dirty=True)\n    select_track(ctx)\n    ctx.set("status", text="切換到 %s" % TRACKS[st["track"]][0])\n\n\ndef on_select(ctx):\n    names = [name for name, _ in TRACKS]\n    value = ctx.get("playlist")\n    if value in names:\n        ctx.state.update(track=names.index(value), pos=0.0, dirty=True)\n\n\ndef encode(ctx):\n    name, total = TRACKS[ctx.state.get("track", 0)]\n    try:\n        kbps = int(ctx.get("bitrate"))\n    except (TypeError, ValueError):\n        kbps = 0\n    if not 64 <= kbps <= 20000:\n        ctx.set("status", text="位元率要在 64 到 20000 kbps 之間")\n        return\n    fmt = ctx.get("fmt")\n    if fmt not in FORMATS:\n        fmt = "MP4"\n    size_kb = total * kbps / 8.0\n    ctx.set("status", text="已輸出 %s（%s，約 %d KB，模擬）" % (fmt, name, size_kb))\n\n\ndef build(win, spec, slots):\n    return {"handlers": {\n        "frame:screen": on_frame,\n        "click:prev": lambda ctx: change(ctx, -1),\n        "click:next": lambda ctx: change(ctx, 1),\n        "select:playlist": on_select,\n        "click:encode": encode,\n        "shortcut:encode": encode,\n    }}\n',"guitpl_lib/media/main_dark.jsonl":'{"kind":"meta","id":"media/main_dark","title":"深色多媒體播放器（簡化版）","keywords":["深色","夜間","播放器"],"extends":"media/main"}\n{"kind":"param","name":"title","default":"夜間播放器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#e5e7eb","accent":"#4aa3ff","danger":"#ef4444","muted":"#9ca3af"},"font":"monospace"}\n',"guitpl_lib/media/main_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 media/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_media_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/media/main_light.jsonl":'{"kind":"meta","id":"media/main_light","title":"淺色多媒體播放器（簡化版）","keywords":["淺色","明亮","播放器"],"extends":"media/main"}\n{"kind":"param","name":"title","default":"淺色播放器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#111827","accent":"#7c3aed","danger":"#e11d48","muted":"#6b7280"}}\n',"guitpl_lib/media/main_light.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 media/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_media_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/media/statusbar.jsonl":'{"kind":"meta","id":"media/statusbar","title":"狀態列（時間與訊息）","keywords":["狀態列","時間","進度","訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"time","kind":"label","text":"0:00 / 0:30"},{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/media/statusbar.py":'# -*- coding: utf-8 -*-\n# 狀態列只負責顯示；時間由主元件用名稱 "time" 寫入，訊息用 "status"。\n\n\ndef build(win, spec, slots):\n    return {}\n',"guitpl_lib/media/transport.jsonl":'{"kind":"meta","id":"media/transport","title":"播放控制列（上一首、播放、暫停、停止、下一首）","keywords":["播放","暫停","停止","上一首","下一首"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"prev","kind":"button","text":"上一首","icon":"⏮"},{"id":"play","kind":"button","text":"播放","icon":"▶","role":"primary"},{"id":"pause","kind":"button","text":"暫停","icon":"⏸"},{"id":"stop","kind":"button","text":"停止","icon":"■"},{"id":"next","kind":"button","text":"下一首","icon":"⏭"}]}]}\n',"guitpl_lib/media/transport.py":'# -*- coding: utf-8 -*-\n# 播放控制：播放、暫停、停止與空白鍵切換。只改播放狀態與場景；畫面與進度由主元件的 frame 處理負責。\n\n\ndef build(win, spec, slots):\n    def play(ctx):\n        ctx.state["playing"] = True\n        ctx.goto("playing")\n        ctx.set("status", text="播放中")\n\n    def pause(ctx):\n        ctx.state["playing"] = False\n        ctx.goto("idle")\n        ctx.set("status", text="已暫停")\n\n    def stop(ctx):\n        ctx.state.update(playing=False, pos=0.0, dirty=True)\n        ctx.goto("idle")\n        ctx.set("status", text="已停止")\n\n    def toggle(ctx):\n        if ctx.state.get("playing"):\n            pause(ctx)\n        else:\n            play(ctx)\n\n    return {"handlers": {"click:play": play, "click:pause": pause, "click:stop": stop, "shortcut:toggle": toggle}}\n',"guitpl_lib/midi/main.jsonl":'{"kind":"meta","id":"midi/main","title":"鋼琴卷簾編曲器","keywords":["MIDI","鋼琴卷簾","音符","編曲","播放"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"鋼琴卷簾","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"bpm","default":"120","ask":"速度要設幾 BPM（每分鐘拍數，20 到 300）？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":780,"resizable":true,"height":580},"tree":[{"kind":"column","role":"page","children":[{"slot":"transport"},{"kind":"column","grow":1,"pad":16,"gap":12,"children":[{"id":"roll","kind":"canvas","width":320,"height":168,"fps":20,"fit":true,"grow":2},{"id":"notes","kind":"table","columns":["音高","起拍","長度（拍）"],"rows":[["C4","0","1"],["E4","1","1"],["G4","2","1"],["C5","3","1"],["B4","4","0.5"],["A4","4.5","0.5"],["G4","5","2"]],"grow":1}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"transport","use":"midi/transport","params":{"bpm":"{{bpm}}"}}\n{"kind":"slot","name":"statusbar","use":"midi/statusbar"}\n{"kind":"scene","id":"stopped","title":"停止","note":"可以改速度、按播放","show":["play","bpm"],"hide":["stop"],"on":{"click:play":"playing"}}\n{"kind":"scene","id":"playing","title":"播放中","note":"播放頭移動、按停止結束","show":["stop"],"hide":["play","bpm"],"on":{"click:stop":"stopped"}}\n{"kind":"shortcut","keys":"Ctrl+P","do":"play"}\n{"kind":"shortcut","keys":"Esc","do":"stop"}\n',"guitpl_lib/midi/main.py":'# -*- coding: utf-8 -*-\n# 鋼琴卷簾：每個 frame 事件推進播放頭、觸發音符聲音，並重畫卷簾。播放與停止在 transport 子元件。\n\nPITCH_HI = 71\nPITCH_LO = 60\nBEATS = 8\nFPS = 20\nKEY_W = 40\nROW_H = 14\nBEAT_W = 35\nBLACK = (1, 3, 6, 8, 10)\n# (音高, 起拍, 長度)，依起拍排序\nNOTES = [(60, 0, 1), (64, 1, 1), (67, 2, 1), (72, 3, 1), (71, 4, 0.5), (69, 4.5, 0.5), (67, 5, 2)]\n\n\ndef freq(pitch):\n    return 440.0 * 2 ** ((pitch - 69) / 12.0)\n\n\ndef draw(ctx, colors, beat=None):\n    ops = [["clear", colors["bg"]]]\n    for i, p in enumerate(range(PITCH_HI, PITCH_LO - 1, -1)):\n        y = i * ROW_H\n        ops.append(["rect", 0, y, KEY_W, ROW_H, colors["fg"] if p % 12 in BLACK else colors["bg"]])\n        ops.append(["line", KEY_W, y + ROW_H, KEY_W + BEATS * BEAT_W, y + ROW_H, colors["muted"]])\n    for pitch, start, length in NOTES:\n        y = (PITCH_HI - pitch) * ROW_H\n        ops.append(["rect", int(KEY_W + start * BEAT_W), y + 1, int(length * BEAT_W) - 2, ROW_H - 2, colors["accent"]])\n    if beat is not None:\n        x = int(KEY_W + beat * BEAT_W)\n        ops.append(["line", x, 0, x, (PITCH_HI - PITCH_LO + 1) * ROW_H, colors["danger"]])\n    ctx.w.draw(ctx.id("roll"), ops)\n\n\ndef make_frame(colors):\n    def on_frame(ctx):\n        st = ctx.state\n        if st.get("playing"):\n            st["beat"] = st.get("beat", 0.0) + st["bpm"] / 60.0 / FPS\n            while st["next"] < len(NOTES) and NOTES[st["next"]][1] <= st["beat"]:\n                pitch, _start, length = NOTES[st["next"]]\n                ctx.tone(freq(pitch), int(length * 60000.0 / st["bpm"]))\n                st["next"] += 1\n            if st["beat"] >= BEATS:\n                st["playing"] = False\n                st["dirty"] = True\n                ctx.goto("stopped")\n                ctx.set("status", text="播放完畢")\n            else:\n                draw(ctx, colors, st["beat"])\n        elif st.get("dirty", True):\n            st["dirty"] = False\n            draw(ctx, colors)\n    return on_frame\n\n\ndef build(win, spec, slots):\n    pal = (spec.get("style") or {}).get("palette") or {}\n    colors = {\n        "bg": pal.get("bg", "#ffffff"), "fg": pal.get("fg", "#222222"), "accent": pal.get("accent", "#2563eb"),\n        "danger": pal.get("danger", "#dc2626"), "muted": pal.get("muted", "#9ca3af"),\n    }\n    return {"handlers": {"frame:roll": make_frame(colors)}}\n',"guitpl_lib/midi/main_dark.jsonl":'{"kind":"meta","id":"midi/main_dark","title":"深色鋼琴卷簾","keywords":["深色","夜間","鋼琴卷簾"],"extends":"midi/main"}\n{"kind":"param","name":"title","default":"夜間鋼琴卷簾","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","danger":"#ef4444","muted":"#555555"},"font":"monospace"}\n',"guitpl_lib/midi/main_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 midi/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_midi_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/midi/main_light.jsonl":'{"kind":"meta","id":"midi/main_light","title":"淺色鋼琴卷簾","keywords":["淺色","明亮","鋼琴卷簾"],"extends":"midi/main"}\n{"kind":"param","name":"title","default":"淺色鋼琴卷簾","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#111827","accent":"#7c3aed","danger":"#e11d48","muted":"#d1d5db"}}\n',"guitpl_lib/midi/main_light.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 midi/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_midi_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/midi/statusbar.jsonl":'{"kind":"meta","id":"midi/statusbar","title":"狀態列","keywords":["狀態列","狀態","訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/midi/statusbar.py":'# -*- coding: utf-8 -*-\n# 狀態列只負責顯示；其他元件用名稱 "status" 寫入訊息。\n\n\ndef build(win, spec, slots):\n    return {}\n',"guitpl_lib/midi/transport.jsonl":'{"kind":"meta","id":"midi/transport","title":"播放控制列（播放、停止、速度）","keywords":["播放","停止","速度","控制"],"entry":"build"}\n{"kind":"param","name":"bpm","default":"120","ask":"速度要設幾 BPM？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"play","kind":"button","text":"播放","icon":"▶","role":"primary"},{"id":"stop","kind":"button","text":"停止","icon":"■"},{"kind":"label","text":"速度 BPM"},{"id":"bpm","kind":"entry","value":"{{bpm}}"}]}]}\n',"guitpl_lib/midi/transport.py":'# -*- coding: utf-8 -*-\n# 播放控制：只改狀態（播放中、速度、起始拍）與場景；播放頭的推進與卷簾重畫由主元件的 frame 處理負責。\n\n\ndef build(win, spec, slots):\n    def play(ctx):\n        if ctx.state.get("playing"):\n            return\n        try:\n            bpm = float(ctx.get("bpm"))\n        except (TypeError, ValueError):\n            bpm = 120.0\n        if not 20 <= bpm <= 300:\n            bpm = 120.0\n        ctx.state.update(playing=True, beat=0.0, bpm=bpm, next=0)\n        ctx.goto("playing")\n        ctx.set("status", text="播放中（%g BPM）" % bpm)\n\n    def stop(ctx):\n        ctx.state.update(playing=False, beat=0.0, dirty=True)\n        ctx.goto("stopped")\n        ctx.set("status", text="已停止")\n\n    return {"handlers": {"click:play": play, "click:stop": stop, "shortcut:play": play, "shortcut:stop": stop}}\n',"guitpl_lib/office/main.jsonl":'{"kind":"meta","id":"office/main","title":"待辦清單","keywords":["待辦","待辦清單","todo","清單","任務"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"待辦清單","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"owner","default":"我","ask":"這份清單是誰的？（會顯示在清單最上方）"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":560,"resizable":true,"height":560},"tree":[{"kind":"column","role":"page","children":[{"id":"heading","kind":"label","text":"{{owner}} 的待辦","role":"title","pad":16},{"slot":"toolbar"},{"kind":"column","grow":1,"pad":12,"gap":8,"children":[{"id":"hint","kind":"label","text":"還沒有待辦。在上面輸入內容後按「新增」（或 Ctrl+Enter）。","role":"muted"},{"id":"tasks","kind":"editor","value":"","lang":"text","rows":12,"numbers":false,"grow":1}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"office/toolbar","params":{}}\n{"kind":"slot","name":"statusbar","use":"office/statusbar","params":{}}\n{"kind":"scene","id":"empty","title":"沒有待辦","note":"只顯示提示文字","show":["hint"],"hide":["tasks"],"on":{"click:add":"list"}}\n{"kind":"scene","id":"list","title":"有待辦","note":"顯示清單編輯區與件數","show":["tasks"],"hide":["hint"]}\n{"kind":"shortcut","keys":"Ctrl+Enter","do":"add_task"}\n{"kind":"shortcut","keys":"Ctrl+L","do":"clear_done"}\n',"guitpl_lib/office/main.py":'# -*- coding: utf-8 -*-\n# 待辦清單的主畫面：「新增」與「清除已完成」由工具列負責；這裡把它們包一層，做完之後再更新件數與場景，\n# 快捷鍵也接到同一組處理函式。\n\n\ndef build(win, spec, slots):\n    tb = slots["toolbar"]["handlers"]\n    refresh = slots["statusbar"]["refresh"]\n\n    def add(ctx):\n        tb["click:add"](ctx)\n        refresh(ctx)\n\n    def clear_done(ctx):\n        tb["click:clear_done"](ctx)\n        refresh(ctx)\n\n    return {\n        "handlers": {\n            "click:add": add,\n            "click:clear_done": clear_done,\n            "shortcut:add_task": add,\n            "shortcut:clear_done": clear_done,\n        }\n    }\n',"guitpl_lib/office/main_dark.jsonl":'{"kind":"meta","id":"office/main_dark","title":"深色待辦清單","keywords":["深色待辦","夜間待辦"],"extends":"office/main"}\n{"kind":"param","name":"title","default":"夜間待辦清單","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","danger":"#e5534b","muted":"#888888"}}\n',"guitpl_lib/office/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色待辦清單：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_office_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/office/main_warm.jsonl":'{"kind":"meta","id":"office/main_warm","title":"暖色待辦清單","keywords":["暖色待辦","護眼待辦"],"extends":"office/main"}\n{"kind":"param","name":"title","default":"暖色待辦清單","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fbf4e6","fg":"#3b2f20","accent":"#d9822b","danger":"#b91c1c","muted":"#a8946b"}}\n',"guitpl_lib/office/main_warm.py":'# -*- coding: utf-8 -*-\n# 暖色待辦清單：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_office_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/office/statusbar.jsonl":'{"kind":"meta","id":"office/statusbar","title":"待辦狀態列（件數與訊息）","keywords":["狀態列","件數","待辦件數"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"count","kind":"label","text":"0 件未完成，0 件已完成"},{"id":"msg","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/office/statusbar.py":'# -*- coding: utf-8 -*-\n# 待辦狀態列：顯示未完成與已完成件數；清單有內容時切到「有待辦」場景，清空後切回「沒有待辦」場景。\n\n\ndef counts(text):\n    lines = [ln for ln in text.split("\\n") if ln.strip()]\n    done = len([ln for ln in lines if ln.startswith("[x] ")])\n    return len(lines) - done, done\n\n\ndef refresh(ctx):\n    text = ctx.get("tasks")\n    open_n, done_n = counts(text)\n    ctx.set("count", text="%d 件未完成，%d 件已完成" % (open_n, done_n))\n    ctx.goto("list" if open_n + done_n else "empty")\n\n\ndef build(win, spec, slots):\n    return {"handlers": {"input:tasks": refresh}, "refresh": refresh}\n',"guitpl_lib/office/toolbar.jsonl":'{"kind":"meta","id":"office/toolbar","title":"待辦工具列（輸入、新增、清除已完成）","keywords":["待辦工具列","新增待辦","清除已完成"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"task","kind":"entry","value":""},{"id":"add","kind":"button","text":"新增","icon":"＋","role":"primary"},{"id":"clear_done","kind":"button","text":"清除已完成","icon":"✔"}]}]}\n',"guitpl_lib/office/toolbar.py":'# -*- coding: utf-8 -*-\n# 待辦工具列的行為。清單一行一筆：未完成是「[ ] 內容」，已完成是「[x] 內容」。\n# 件數與場景由狀態列的 refresh 更新（主畫面包住這兩個動作）。\n\n\ndef add(ctx):\n    text = ctx.get("task").strip()\n    if not text:\n        ctx.set("msg", text="請先輸入待辦內容")\n        return\n    body = ctx.get("tasks").rstrip("\\n")\n    body = (body + "\\n" if body else "") + "[ ] " + text\n    ctx.set("tasks", value=body)\n    ctx.set("task", value="")\n    ctx.set("msg", text="已新增")\n\n\ndef clear_done(ctx):\n    lines = ctx.get("tasks").split("\\n")\n    kept = [ln for ln in lines if not ln.startswith("[x] ")]\n    removed = len(lines) - len(kept)\n    ctx.set("tasks", value="\\n".join(kept).strip("\\n"))\n    ctx.set("msg", text="已清除 %d 件" % removed)\n\n\ndef build(win, spec, slots):\n    return {"handlers": {"click:add": add, "click:clear_done": clear_done}}\n',"guitpl_lib/project/main.jsonl":'{"kind":"meta","id":"project/main","title":"專案任務板（任務表與進度）","keywords":["專案","任務","進度","表格","專案管理"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"專案任務板","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"project","default":"嗨投資改版","ask":"專案名稱要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#f9fafb","fg":"#111827","accent":"#0d9488","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":900,"resizable":true,"height":640},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"column","grow":1,"pad":16,"gap":10,"children":[{"kind":"row","children":[{"id":"task_name","kind":"entry","value":""},{"id":"add_hint","kind":"label","text":"在左邊輸入新任務名稱，按「新增任務」","role":"muted"}]},{"kind":"row","children":[{"id":"pct_input","kind":"entry","value":"50"},{"id":"set_pct","kind":"button","text":"設定所選任務進度","role":"primary"}]},{"id":"task_pick","kind":"list","items":["1. 規劃需求","2. 設計畫面"],"selected":"1. 規劃需求"},{"id":"tasks","kind":"table","columns":["任務","負責人","狀態","進度(%)"],"rows":[["規劃需求","小王","進行中","40"],["設計畫面","小李","未開始","0"]],"grow":1},{"id":"overall","kind":"progress","value":20,"max":100},{"id":"overall_text","kind":"label","text":"整體進度 20%（2 項任務）"},{"id":"report_text","kind":"label","text":"","grow":1},{"id":"back","kind":"button","text":"返回任務板","role":"primary"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"project/toolbar","params":{}}\n{"kind":"slot","name":"statusbar","use":"project/statusbar","params":{"project":"{{project}}"}}\n{"kind":"scene","id":"board","title":"任務板","note":"任務表、所選任務的進度、整體進度","show":["task_name","add_hint","pct_input","set_pct","task_pick","tasks","overall","overall_text"],"hide":["report_text","back"],"on":{"click:report":"report","shortcut:report":"report"}}\n{"kind":"scene","id":"report","title":"進度報告","note":"只顯示文字報告","show":["report_text","back"],"hide":["task_name","add_hint","pct_input","set_pct","task_pick","tasks","overall","overall_text"],"on":{"click:back":"board"}}\n{"kind":"shortcut","keys":"Ctrl+N","do":"add"}\n{"kind":"shortcut","keys":"F6","do":"report"}\n',"guitpl_lib/project/main.py":'# -*- coding: utf-8 -*-\n# 專案任務板：任務表（任務、負責人、狀態、進度%）、選擇要操作的任務、設定進度、整體進度與文字報告。\n# 任務資料放在 G（本函式的閉包）：{"rows": [[任務, 負責人, 狀態, 進度字串]], "cur": 目前所選任務的索引}。\n# 起始資料要和 main.jsonl 的 layout（tasks、task_pick、overall）一致。\n# 表格的文字是 gui 的 table：程式改內容用 set(value=...)，這樣 value() 也跟著更新，使用者編輯走 cell 事件。\n\n\ndef _pct(text):\n    try:\n        return max(0, min(100, int(str(text).strip())))\n    except ValueError:\n        return 0\n\n\ndef _status(p):\n    return "未開始" if p == 0 else ("完成" if p == 100 else "進行中")\n\n\ndef _labels(G):\n    return ["%d. %s" % (i + 1, r[0] or "（未命名）") for i, r in enumerate(G["rows"])]\n\n\ndef _overall(G):\n    if not G["rows"]:\n        return 0\n    return sum(_pct(r[3]) for r in G["rows"]) // len(G["rows"])\n\n\ndef _sync(ctx, G):\n    rows = [list(r) for r in G["rows"]]\n    labels = _labels(G)\n    ctx.set("tasks", rows=rows)\n    ctx.set("task_pick", items=labels, selected=labels[G["cur"]] if labels else "")\n    avg = _overall(G)\n    ctx.set("overall", value=avg)\n    ctx.set("overall_text", text="整體進度 %d%%（%d 項任務）" % (avg, len(G["rows"])))\n    ctx.set("count_text", text="任務 %d 項" % len(G["rows"]))\n\n\ndef build(win, spec, slots):\n    G = {"rows": [["規劃需求", "小王", "進行中", "40"], ["設計畫面", "小李", "未開始", "0"]], "cur": 0}\n\n    def set_pct(ctx, p):\n        if not G["rows"]:\n            return\n        row = G["rows"][G["cur"]]\n        row[3] = str(p)\n        row[2] = _status(p)\n        _sync(ctx, G)\n\n    def add(ctx):\n        name = str(ctx.get("task_name") or "").strip()\n        if not name:\n            ctx.set("add_hint", text="請先輸入任務名稱")\n            return\n        G["rows"].append([name, "未指派", "未開始", "0"])\n        G["cur"] = len(G["rows"]) - 1\n        ctx.set("task_name", value="")\n        ctx.set("add_hint", text="已新增「%s」" % name)\n        _sync(ctx, G)\n\n    def done(ctx):\n        set_pct(ctx, 100)\n\n    def remove(ctx):\n        if not G["rows"]:\n            return\n        del G["rows"][G["cur"]]\n        G["cur"] = max(0, min(G["cur"], len(G["rows"]) - 1))\n        _sync(ctx, G)\n\n    def apply_pct(ctx):\n        try:\n            p = int(str(ctx.get("pct_input") or "").strip())\n        except ValueError:\n            ctx.set("add_hint", text="進度要填 0 到 100 的整數")\n            return\n        set_pct(ctx, max(0, min(100, p)))\n\n    def select(ctx):\n        try:\n            i = int(str(ctx.get("task_pick") or "").split(".")[0]) - 1\n        except ValueError:\n            return\n        if 0 <= i < len(G["rows"]):\n            G["cur"] = i\n            _sync(ctx, G)\n\n    def cell_edited(ctx):\n        # 使用者直接改表格：ctx.event["value"] 是 {"row","col","text"}\n        cell = (ctx.event or {}).get("value") or {}\n        try:\n            r, c = int(cell["row"]), int(cell["col"])\n            G["rows"][r][c] = str(cell.get("text") or "")\n        except (KeyError, IndexError, TypeError, ValueError):\n            return\n        if c == 3:\n            G["rows"][r][2] = _status(_pct(G["rows"][r][3]))\n        _sync(ctx, G)\n\n    def report(ctx):\n        lines = ["%s｜%s｜%s%%" % (r[0], r[2], _pct(r[3])) for r in G["rows"]]\n        ctx.set("report_text", text="專案進度報告：整體 %d%%\\n" % _overall(G) + "\\n".join(lines))\n\n    return {"handlers": {\n        "click:add": add,\n        "shortcut:add": add,\n        "click:done": done,\n        "click:remove": remove,\n        "click:set_pct": apply_pct,\n        "select:task_pick": select,\n        "cell:tasks": cell_edited,\n        "click:report": report,\n        "shortcut:report": report,\n    }}\n',"guitpl_lib/project/main_dark.jsonl":'{"kind":"meta","id":"project/main_dark","title":"專案任務板（深色）","keywords":["專案","任務","深色","進度"],"extends":"project/main"}\n{"kind":"param","name":"title","default":"專案任務板（深色）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#0f172a","fg":"#e2e8f0","accent":"#2dd4bf","danger":"#f87171","muted":"#64748b"}}\n',"guitpl_lib/project/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_project_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/project/main_light.jsonl":'{"kind":"meta","id":"project/main_light","title":"專案任務板（明亮）","keywords":["專案","任務","淺色","明亮","進度"],"extends":"project/main"}\n{"kind":"param","name":"title","default":"專案任務板（明亮）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#0f172a","accent":"#0f766e","danger":"#b91c1c","muted":"#94a3b8"}}\n',"guitpl_lib/project/main_light.py":'# -*- coding: utf-8 -*-\n# 明亮版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_project_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/project/statusbar.jsonl":'{"kind":"meta","id":"project/statusbar","title":"專案狀態列（專案名稱、任務數）","keywords":["狀態列","專案","任務數"],"entry":"build"}\n{"kind":"param","name":"project","default":"新專案","ask":"專案名稱要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"project_name","kind":"label","text":"{{project}}"},{"id":"count_text","kind":"label","text":"任務 2 項"}]}]}\n',"guitpl_lib/project/statusbar.py":"# -*- coding: utf-8 -*-\n# 專案狀態列只顯示：任務數由 main.py 用名稱 count_text 更新。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/project/toolbar.jsonl":'{"kind":"meta","id":"project/toolbar","title":"任務工具列（新增、標記完成、刪除、報告）","keywords":["工具列","任務","新增","報告"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"add","kind":"button","text":"新增任務","icon":"＋","role":"primary"},{"id":"done","kind":"button","text":"標記完成","icon":"✔"},{"id":"remove","kind":"button","text":"刪除所選","icon":"✖"},{"kind":"label","text":"","role":"divider"},{"id":"report","kind":"button","text":"進度報告","icon":"≣"}]}]}\n',"guitpl_lib/project/toolbar.py":"# -*- coding: utf-8 -*-\n# 任務工具列只負責按鈕：click:add、click:done、click:remove、click:report 由 main.py 處理。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/slides/main.jsonl":'{"kind":"meta","id":"slides/main","title":"投影片編輯器（清單、編輯、備忘稿）","keywords":["投影片","簡報","編輯器","備忘稿","放映"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"投影片編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"deck_name","default":"我的簡報","ask":"簡報名稱要寫什麼？"}\n{"kind":"param","name":"first_title","default":"歡迎","ask":"第一張投影片的標題要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2937","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":980,"resizable":true,"height":660},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"kind":"row","grow":1,"children":[{"id":"side","kind":"column","role":"sidebar","children":[{"kind":"label","text":"投影片","role":"heading"},{"id":"slide_list","kind":"list","items":["1. {{first_title}}"],"selected":"1. {{first_title}}","grow":1}]},{"kind":"column","grow":1,"pad":16,"gap":10,"children":[{"id":"slide_title","kind":"entry","value":"{{first_title}}"},{"id":"slide_body","kind":"editor","value":"在這裡寫投影片內容。","lang":"text","rows":8,"numbers":false,"grow":2},{"id":"present_view","kind":"label","text":"","role":"title","grow":1},{"id":"back","kind":"button","text":"返回編輯","role":"primary"}]}]},{"kind":"column","pad":12,"gap":6,"children":[{"id":"notes_label","kind":"label","text":"備忘稿（只給講者看）","role":"muted"},{"id":"speaker_notes","kind":"textarea","value":"","rows":3,"placeholder":"講者要說的話"}]},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"slides/toolbar","params":{}}\n{"kind":"slot","name":"statusbar","use":"slides/statusbar","params":{"deck":"{{deck_name}}"}}\n{"kind":"scene","id":"edit","title":"編輯中","note":"左邊清單、中間編輯區、下方備忘稿","show":["slide_list","slide_title","slide_body","notes_label","speaker_notes","side"],"hide":["present_view","back"],"on":{"click:present":"present","shortcut:present":"present"}}\n{"kind":"scene","id":"present","title":"放映中","note":"只顯示這張投影片的標題與內容","show":["present_view","back"],"hide":["slide_list","slide_title","slide_body","notes_label","speaker_notes","side"],"on":{"click:back":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+M","do":"new"}\n{"kind":"shortcut","keys":"F5","do":"present"}\n',"guitpl_lib/slides/main.py":'# -*- coding: utf-8 -*-\n# 投影片編輯器：左邊是投影片清單，中間編輯這張的標題與內容，下方是講者備忘稿。\n# 投影片資料放在 G（本函式的閉包）：{"slides": [{"title","body","notes"}], "cur": 目前張的索引}。\n# 放映的切換在 jsonl 的場景（click:present、shortcut:present、click:back）；這裡只負責內容。\n\n\ndef _labels(G):\n    return ["%d. %s" % (i + 1, s["title"] or "（未命名）") for i, s in enumerate(G["slides"])]\n\n\ndef _refresh(ctx, G):\n    cur = G["slides"][G["cur"]]\n    labels = _labels(G)\n    ctx.set("slide_list", items=labels, selected=labels[G["cur"]])\n    ctx.set("slide_title", value=cur["title"])\n    ctx.set("slide_body", value=cur["body"])\n    ctx.set("speaker_notes", value=cur["notes"])\n    ctx.set("page_info", text="第 %d 張／共 %d 張" % (G["cur"] + 1, len(G["slides"])))\n\n\ndef build(win, spec, slots):\n    G = {"slides": [{"title": spec["params"]["first_title"], "body": "在這裡寫投影片內容。", "notes": ""}], "cur": 0}\n\n    def cur():\n        return G["slides"][G["cur"]]\n\n    def add(ctx):\n        G["slides"].append({"title": "新投影片 %d" % (len(G["slides"]) + 1), "body": "", "notes": ""})\n        G["cur"] = len(G["slides"]) - 1\n        _refresh(ctx, G)\n\n    def delete(ctx):\n        if len(G["slides"]) <= 1:\n            ctx.set("page_info", text="至少要留一張投影片")\n            return\n        del G["slides"][G["cur"]]\n        G["cur"] = min(G["cur"], len(G["slides"]) - 1)\n        _refresh(ctx, G)\n\n    def present(ctx):\n        s = cur()\n        ctx.set("present_view", text="【%s】\\n%s" % (s["title"], s["body"]))\n\n    def back(ctx):\n        _refresh(ctx, G)\n\n    def select(ctx):\n        # 清單的文字是「次序. 標題」，前面的次序就是索引\n        try:\n            i = int(str(ctx.get("slide_list") or "").split(".")[0]) - 1\n        except ValueError:\n            return\n        if 0 <= i < len(G["slides"]) and i != G["cur"]:\n            G["cur"] = i\n            _refresh(ctx, G)\n\n    def typed_title(ctx):\n        cur()["title"] = str(ctx.get("slide_title") or "")\n        labels = _labels(G)\n        ctx.set("slide_list", items=labels, selected=labels[G["cur"]])\n\n    def typed_body(ctx):\n        cur()["body"] = str(ctx.get("slide_body") or "")\n\n    def typed_notes(ctx):\n        cur()["notes"] = str(ctx.get("speaker_notes") or "")\n\n    return {"handlers": {\n        "click:add": add,\n        "shortcut:new": add,\n        "click:del": delete,\n        "click:present": present,\n        "shortcut:present": present,\n        "click:back": back,\n        "select:slide_list": select,\n        "input:slide_title": typed_title,\n        "input:slide_body": typed_body,\n        "input:speaker_notes": typed_notes,\n    }}\n',"guitpl_lib/slides/main_dark.jsonl":'{"kind":"meta","id":"slides/main_dark","title":"投影片編輯器（深色）","keywords":["投影片","簡報","深色","編輯器"],"extends":"slides/main"}\n{"kind":"param","name":"title","default":"投影片編輯器（深色）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1f2937","fg":"#f3f4f6","accent":"#60a5fa","danger":"#f87171","muted":"#6b7280"}}\n',"guitpl_lib/slides/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_slides_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/slides/main_light.jsonl":'{"kind":"meta","id":"slides/main_light","title":"投影片編輯器（明亮）","keywords":["投影片","簡報","淺色","明亮","編輯器"],"extends":"slides/main"}\n{"kind":"param","name":"title","default":"投影片編輯器（明亮）","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#1c1917","accent":"#7c3aed","danger":"#dc2626","muted":"#a8a29e"}}\n',"guitpl_lib/slides/main_light.py":'# -*- coding: utf-8 -*-\n# 明亮版：只換調色盤（在 jsonl 的 style），行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_slides_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/slides/statusbar.jsonl":'{"kind":"meta","id":"slides/statusbar","title":"投影片狀態列（簡報名稱、頁碼）","keywords":["狀態列","投影片","頁碼","簡報名稱"],"entry":"build"}\n{"kind":"param","name":"deck","default":"我的簡報","ask":"簡報名稱要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"deck_name","kind":"label","text":"{{deck}}"},{"id":"page_info","kind":"label","text":"第 1 張／共 1 張"}]}]}\n',"guitpl_lib/slides/statusbar.py":"# -*- coding: utf-8 -*-\n# 投影片狀態列只顯示：頁碼由 main.py 用名稱 page_info 更新。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/slides/toolbar.jsonl":'{"kind":"meta","id":"slides/toolbar","title":"投影片工具列（新增、刪除、放映）","keywords":["工具列","投影片","新增","放映"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"add","kind":"button","text":"新增投影片","icon":"＋","role":"primary"},{"id":"del","kind":"button","text":"刪除投影片","icon":"✖"},{"kind":"label","text":"","role":"divider"},{"id":"present","kind":"button","text":"放映","icon":"▶"}]}]}\n',"guitpl_lib/slides/toolbar.py":"# -*- coding: utf-8 -*-\n# 投影片工具列只負責按鈕：click:add、click:del、click:present 由 main.py 與場景處理。\n\n\ndef build(win, spec, slots):\n    return {}\n","guitpl_lib/text-editor/main.jsonl":'{"kind":"meta","id":"text-editor/main","title":"文字編輯器（上方工具列、中間編輯區、下方狀態列）","keywords":["文字編輯","編輯器","記事本","筆記","日記","notepad","editor"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"文字編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"sound","default":"no","ask":"存檔與新增要有提示音嗎？（yes 或 no）"}\n{"kind":"param","name":"lang","default":"python","ask":"文字要用哪種語法上色？（text 不上色，或 python、javascript、json、markdown、html、css）"}\n{"kind":"param","name":"content","default":"# 範例：整理購物清單\\nimport json\\nfrom datetime import date\\n\\n\\nclass Item:\\n    \\"\\"\\"一項商品：名稱、單價、數量。\\"\\"\\"\\n\\n    def __init__(self, name, price, qty=1):\\n        self.name = name\\n        self.price = price\\n        self.qty = qty\\n\\n    def total(self):\\n        return self.price * self.qty\\n\\n\\ndef load(path):\\n    with open(path, encoding=\\"utf-8\\") as f:\\n        data = json.load(f)\\n    return [Item(**row) for row in data[\\"items\\"]]\\n\\n\\ndef summary(items):\\n    lines = []\\n    for i, item in enumerate(items, start=1):\\n        lines.append(f\\"{i:>2}. {item.name:<8} {item.qty} x {item.price} = {item.total()}\\")\\n    total = sum(item.total() for item in items)\\n    lines.append(\\"-\\" * 32)\\n    lines.append(f\\"合計 {total} 元（{date.today()}）\\")\\n    return \\"\\\\n\\".join(lines)\\n\\n\\nif __name__ == \\"__main__\\":\\n    items = [Item(\\"紙杯\\", 3, 50), Item(\\"吸管\\", 1, 100), Item(\\"湯匙\\", 2, 30)]\\n    print(summary(items))\\n    for n in range(3):\\n        if n % 2 == 0:\\n            print(\\"偶數\\", n)\\n        else:\\n            print(\\"奇數\\", n, None, True)\\n","ask":"編輯器一開始要放什麼內容？（預設是一段 Python 範例，可以清空）"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#222222","accent":"#2563eb","danger":"#dc2626","muted":"#9ca3af"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":900,"resizable":true,"height":620},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"editor","kind":"editor","value":"{{content}}","lang":"{{lang}}","rows":16,"grow":1},{"id":"saved_tip","kind":"label","text":"已存檔","role":"muted","pad":6},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"text-editor/toolbar","params":{"sound":"{{sound}}","lang":"{{lang}}"}}\n{"kind":"slot","name":"statusbar","use":"text-editor/statusbar","params":{}}\n{"kind":"scene","id":"edit","title":"編輯中","note":"工具列、編輯區、狀態列；存檔後切到「存檔後」","show":["editor"],"hide":["saved_tip"],"on":{"click:save":"saved"}}\n{"kind":"scene","id":"saved","title":"存檔後","note":"顯示「已存檔」；再輸入文字就切回編輯中","show":["saved_tip"],"hide":[],"on":{"input:editor":"edit"}}\n{"kind":"shortcut","keys":"Ctrl+S","do":"save_file"}\n{"kind":"shortcut","keys":"Ctrl+N","do":"new_file"}\n',"guitpl_lib/text-editor/main.py":'# -*- coding: utf-8 -*-\n# 文字編輯器的主畫面：存檔與新增由工具列負責，字數由狀態列負責；這裡只把快捷鍵接到工具列的同一組處理函式\n# （Ctrl+S 與存檔按鈕、Ctrl+N 與新增按鈕，行為完全一樣）。\n\n\ndef build(win, spec, slots):\n    tb = slots["toolbar"]["handlers"]\n    return {\n        "handlers": {\n            "shortcut:save_file": tb["click:save"],\n            "shortcut:new_file": tb["click:new"],\n        }\n    }\n',"guitpl_lib/text-editor/main_contrast.jsonl":'{"kind":"meta","id":"text-editor/main_contrast","title":"高對比文字編輯器（黑底、黃色重點）","keywords":["高對比","弱視","高對比編輯器"],"extends":"text-editor/main"}\n{"kind":"param","name":"title","default":"高對比文字編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#000000","fg":"#ffffff","accent":"#ffd400","danger":"#ff5c5c","muted":"#bbbbbb"}}\n',"guitpl_lib/text-editor/main_contrast.py":'# -*- coding: utf-8 -*-\n# 高對比文字編輯器：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_text_editor_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/text-editor/main_dark.jsonl":'{"kind":"meta","id":"text-editor/main_dark","title":"深色文字編輯器（深灰底、亮藍重點）","keywords":["深色編輯器","夜間編輯","深色記事本"],"extends":"text-editor/main"}\n{"kind":"param","name":"title","default":"夜間文字編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#dddddd","accent":"#4aa3ff","danger":"#e5534b","muted":"#888888"}}\n',"guitpl_lib/text-editor/main_dark.py":'# -*- coding: utf-8 -*-\n# 深色文字編輯器：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_text_editor_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/text-editor/main_warm.jsonl":'{"kind":"meta","id":"text-editor/main_warm","title":"暖色文字編輯器（米色底、橘色重點）","keywords":["暖色編輯器","護眼編輯","米色記事本"],"extends":"text-editor/main"}\n{"kind":"param","name":"title","default":"暖色文字編輯器","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fbf4e6","fg":"#3b2f20","accent":"#d9822b","danger":"#b91c1c","muted":"#a8946b"}}\n',"guitpl_lib/text-editor/main_warm.py":'# -*- coding: utf-8 -*-\n# 暖色文字編輯器：只換配色，行為委派給 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_text_editor_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/text-editor/statusbar.jsonl":'{"kind":"meta","id":"text-editor/statusbar","title":"文字編輯狀態列（字數與訊息）","keywords":["文字編輯狀態列","字數"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/text-editor/statusbar.py":'# -*- coding: utf-8 -*-\n# 文字編輯狀態列：內容一改動就顯示行數與字數。\n\n\ndef count_words(ctx):\n    text = ctx.get("editor")\n    ctx.set("status", text="%d 行，%d 字" % (text.count("\\n") + 1, len(text)))\n\n\ndef build(win, spec, slots):\n    return {"handlers": {"input:editor": count_words}}\n',"guitpl_lib/text-editor/toolbar.jsonl":'{"kind":"meta","id":"text-editor/toolbar","title":"文字編輯工具列（新增、存檔、語法、自動換行）","keywords":["文字編輯工具列","新增","存檔","語法上色","自動換行"],"entry":"build"}\n{"kind":"param","name":"sound","default":"no","ask":"提示音要開嗎？（yes 或 no）"}\n{"kind":"param","name":"lang","default":"text","ask":"程式碼語法要上色嗎？（text 不上色，或 python、javascript、json、markdown、html、css）"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"new","kind":"button","text":"新增","icon":"＋"},{"id":"save","kind":"button","text":"存檔","icon":"⬇","role":"primary"},{"kind":"label","text":"","role":"divider"},{"id":"lang_btn","kind":"button","text":"語法：純文字","icon":"</>","role":"outline"},{"id":"wrap","kind":"checkbox","text":"自動換行","checked":false}]}]}\n',"guitpl_lib/text-editor/toolbar.py":'# -*- coding: utf-8 -*-\n# 文字編輯工具列的行為：新增、存檔，以及「語法」按鈕（每按一次換下一種語法上色，文字不會丟）。\n# 提示音由參數 sound 決定（yes 才響）；起始語法由參數 lang 決定。\n\nLANGS = [("text", "純文字"), ("python", "Python"), ("javascript", "JavaScript"), ("json", "JSON"),\n         ("markdown", "Markdown"), ("html", "HTML"), ("css", "CSS")]\n\n\ndef lang_label(code):\n    for c, label in LANGS:\n        if c == code:\n            return label\n    return "純文字"\n\n\ndef save_file(ctx, sound):\n    ctx.state["saved"] = ctx.state.get("saved", 0) + 1\n    text = ctx.get("editor")\n    ctx.set("status", text="已存 %d 次，%d 字" % (ctx.state["saved"], len(text)))\n    if sound:\n        ctx.tone(880, 90, "sine")\n\n\ndef new_file(ctx, sound):\n    ctx.set("editor", value="")\n    ctx.set("status", text="新文件")\n    if sound:\n        ctx.tone(220, 60, "square")\n\n\ndef next_lang(ctx):\n    codes = [c for c, _ in LANGS]\n    now = ctx.state.get("lang", "text")\n    nxt = codes[(codes.index(now) + 1) % len(codes)] if now in codes else codes[0]\n    ctx.state["lang"] = nxt\n    ctx.set("editor", lang=nxt)  # 版面重畫，輸入的文字會保留\n    ctx.set("lang_btn", text="語法：" + lang_label(nxt))\n    ctx.set("status", text="語法：" + lang_label(nxt))\n\n\ndef toggle_wrap(ctx):\n    on = bool(ctx.get("wrap"))\n    ctx.set("editor", wrap=on)  # 版面重畫，輸入的文字會保留\n    ctx.set("status", text="自動換行：" + ("開" if on else "關"))\n\n\ndef build(win, spec, slots):\n    sound = spec["params"].get("sound") == "yes"\n    start_lang = spec["params"].get("lang") or "text"\n\n    def start(ctx):\n        ctx.state["lang"] = start_lang\n        ctx.set("lang_btn", text="語法：" + lang_label(start_lang))\n\n    return {\n        "handlers": {\n            "start": start,\n            "click:save": lambda ctx: save_file(ctx, sound),\n            "click:new": lambda ctx: new_file(ctx, sound),\n            "click:lang_btn": next_lang,\n            "change:wrap": toggle_wrap,\n        }\n    }\n',"guitpl_lib/web-design/main.jsonl":'{"kind":"meta","id":"web-design/main","title":"網頁版面設計器","keywords":["網頁","設計","HTML","版面","元件"],"entry":"build","standalone":true}\n{"kind":"param","name":"title","default":"網頁設計","ask":"視窗標題要寫什麼？"}\n{"kind":"param","name":"page_title","default":"我的網頁","ask":"匯出的網頁標題要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"style","palette":{"bg":"#ffffff","fg":"#1f2937","accent":"#2563eb","danger":"#dc2626","muted":"#6b7280"},"font":"sans-serif","size":14,"radius":6}\n{"kind":"layout","window":{"title":"{{title}}","width":1000,"resizable":true,"height":680},"tree":[{"kind":"column","role":"page","children":[{"slot":"toolbar"},{"id":"main_row","kind":"row","grow":1,"children":[{"id":"left","kind":"column","role":"sidebar","children":[{"kind":"label","text":"元件","role":"heading"},{"id":"comp_list","kind":"list","items":[],"grow":1},{"id":"apply","kind":"button","text":"套用屬性","role":"primary"}]},{"id":"right","kind":"column","grow":1,"pad":16,"gap":10,"children":[{"id":"preview","kind":"canvas","width":320,"height":200,"fit":true,"grow":1},{"id":"attr_text","kind":"entry","value":""},{"id":"attr_color","kind":"entry","value":""}]}]},{"kind":"row","pad":8,"children":[{"id":"to_code","kind":"button","text":"看 HTML 程式碼"},{"id":"to_visual","kind":"button","text":"回到設計"}]},{"id":"code","kind":"editor","value":"","lang":"html","rows":12,"grow":1},{"slot":"statusbar"}]}]}\n{"kind":"slot","name":"toolbar","use":"web-design/toolbar","params":{"page_title":"{{page_title}}"}}\n{"kind":"slot","name":"statusbar","use":"web-design/statusbar"}\n{"kind":"scene","id":"visual","title":"設計","note":"元件列表、預覽與屬性","show":["left","right","to_code","main_row"],"hide":["code","to_visual"],"on":{"click:to_code":"code"}}\n{"kind":"scene","id":"code","title":"程式碼","note":"匯出後的 HTML，可以直接改","show":["code","to_visual"],"hide":["left","right","to_code","main_row"],"on":{"click:to_visual":"visual"}}\n{"kind":"shortcut","keys":"Ctrl+N","do":"add"}\n{"kind":"shortcut","keys":"Delete","do":"remove"}\n',"guitpl_lib/web-design/main.py":'# -*- coding: utf-8 -*-\n# 網頁版面設計器主元件：預覽畫布、屬性編輯與選取。工具列的新增／刪除／匯出由子元件處理，\n# 這裡包住它們的處理函式，每次動作後重畫預覽與元件清單。\n\nTYPE_H = 40\n\n\ndef valid_color(s):\n    if not isinstance(s, str) or len(s) != 7 or s[0] != "#":\n        return False\n    return all(ch in "0123456789abcdefABCDEF" for ch in s[1:])\n\n\ndef labels(cs):\n    return ["%d. %s：%s" % (i + 1, c["type"], c["text"]) for i, c in enumerate(cs)]\n\n\ndef draw(ctx, colors):\n    cs = ctx.state.get("comps", [])\n    sel = ctx.state.get("sel")\n    ops = [["clear", colors["bg"]]]\n    if not cs:\n        ops.append(["text", 10, 12, "尚無元件：從工具列新增", colors["fg"]])\n    for i, c in enumerate(cs[:6]):\n        y = i * TYPE_H + 4\n        custom = c.get("color") if valid_color(c.get("color")) else None\n        if c["type"] == "按鈕":\n            ops.append(["rect", 10, y, 140, 28, custom or colors["accent"]])\n            ops.append(["text", 20, y + 8, c["text"], colors["bg"]])\n        else:\n            ops.append(["text", 10, y + 8, c["text"], custom or colors["fg"]])\n        if i == sel:\n            ops.append(["line", 0, y + TYPE_H - 4, 320, y + TYPE_H - 4, colors["danger"]])\n    ctx.w.draw(ctx.id("preview"), ops)\n    ctx.set("comp_list", items=labels(cs))\n\n\ndef make(colors, toolbar):\n    def redraw_after(fn):\n        def handler(ctx):\n            fn(ctx)\n            draw(ctx, colors)\n        return handler\n\n    def on_select(ctx):\n        cs = ctx.state.get("comps", [])\n        try:\n            i = int(str(ctx.get("comp_list")).split(".")[0]) - 1\n        except ValueError:\n            i = None\n        ctx.state["sel"] = i if i is not None and 0 <= i < len(cs) else None\n        if ctx.state["sel"] is not None:\n            c = cs[ctx.state["sel"]]\n            ctx.set("attr_text", value=c["text"])\n            ctx.set("attr_color", value=c.get("color", ""))\n        draw(ctx, colors)\n\n    def apply(ctx):\n        cs = ctx.state.get("comps", [])\n        i = ctx.state.get("sel")\n        if i is None or i >= len(cs):\n            ctx.set("status", text="請先在清單選一個元件")\n            return\n        text = ctx.get("attr_text")\n        if text:\n            cs[i]["text"] = str(text)[:40]\n        col = ctx.get("attr_color") or ""\n        if col and not valid_color(col):\n            ctx.set("status", text="顏色格式錯誤，要像 #2563eb")\n            return\n        cs[i]["color"] = col\n        draw(ctx, colors)\n        ctx.set("status", text="已套用到第 %d 個元件" % (i + 1))\n\n    handlers = {key: redraw_after(fn) for key, fn in toolbar.items()}\n    handlers["select:comp_list"] = on_select\n    handlers["click:apply"] = apply\n    handlers["start"] = lambda ctx: draw(ctx, colors)\n    return handlers\n\n\ndef build(win, spec, slots):\n    pal = (spec.get("style") or {}).get("palette") or {}\n    colors = {\n        "bg": pal.get("bg", "#ffffff"), "fg": pal.get("fg", "#1f2937"), "accent": pal.get("accent", "#2563eb"),\n        "danger": pal.get("danger", "#dc2626"), "muted": pal.get("muted", "#6b7280"),\n    }\n    return {"handlers": make(colors, slots["toolbar"]["handlers"])}\n',"guitpl_lib/web-design/main_dark.jsonl":'{"kind":"meta","id":"web-design/main_dark","title":"深色網頁設計器","keywords":["深色","夜間","網頁設計"],"extends":"web-design/main"}\n{"kind":"param","name":"title","default":"夜間網頁設計","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#1e1e1e","fg":"#e5e7eb","accent":"#4aa3ff","danger":"#ef4444","muted":"#9ca3af"},"font":"monospace"}\n',"guitpl_lib/web-design/main_dark.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 web-design/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_web_design_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/web-design/main_light.jsonl":'{"kind":"meta","id":"web-design/main_light","title":"淺色網頁設計器","keywords":["淺色","明亮","網頁設計"],"extends":"web-design/main"}\n{"kind":"param","name":"title","default":"淺色網頁設計","ask":"視窗標題要寫什麼？"}\n{"kind":"require","module":"importlib","source":"builtin"}\n{"kind":"require","module":"os","source":"builtin"}\n{"kind":"style","palette":{"bg":"#fafaf9","fg":"#111827","accent":"#7c3aed","danger":"#e11d48","muted":"#6b7280"}}\n',"guitpl_lib/web-design/main_light.py":'# -*- coding: utf-8 -*-\n# 客製化的 .py：延伸 web-design/main，沒有額外行為就委派給原本的 main.py。\nimport importlib.util\nimport os\n\n_here = os.path.dirname(os.path.abspath(__file__))\n\n\ndef build(win, spec, slots):\n    spec_ = importlib.util.spec_from_file_location("guitpl_web_design_main_base", os.path.join(_here, "main.py"))\n    mod = importlib.util.module_from_spec(spec_)\n    spec_.loader.exec_module(mod)\n    return mod.build(win, spec, slots)\n',"guitpl_lib/web-design/statusbar.jsonl":'{"kind":"meta","id":"web-design/statusbar","title":"狀態列","keywords":["狀態列","狀態","訊息"],"entry":"build"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"statusbar","children":[{"id":"status","kind":"label","text":"就緒"}]}]}\n',"guitpl_lib/web-design/statusbar.py":'# -*- coding: utf-8 -*-\n# 狀態列只負責顯示；其他元件用名稱 "status" 寫入訊息。\n\n\ndef build(win, spec, slots):\n    return {}\n',"guitpl_lib/web-design/toolbar.jsonl":'{"kind":"meta","id":"web-design/toolbar","title":"元件工具列（新增、刪除、匯出）","keywords":["工具列","新增","刪除","匯出"],"entry":"build"}\n{"kind":"param","name":"page_title","default":"我的網頁","ask":"匯出的網頁標題要寫什麼？"}\n{"kind":"require","module":"gui","source":"builtin"}\n{"kind":"require","module":"html","source":"builtin"}\n{"kind":"require","module":"re","source":"builtin"}\n{"kind":"layout","tree":[{"kind":"row","role":"toolbar","children":[{"id":"add","kind":"button","text":"新增元件","icon":"＋","role":"primary"},{"id":"remove","kind":"button","text":"刪除","icon":"✖"},{"kind":"label","text":"","role":"divider"},{"id":"export","kind":"button","text":"匯出 HTML","icon":"⇪"}]}]}\n',"guitpl_lib/web-design/toolbar.py":'# -*- coding: utf-8 -*-\n# 元件工具列：新增、刪除、匯出。元件資料放在 ctx.state["comps"]；畫面重畫由主元件包住這些處理函式負責。\nimport html\nimport re\n\nTYPES = ["標題", "段落", "按鈕"]\nHEX = re.compile(r"^#[0-9a-fA-F]{6}$")\n\n\ndef to_html(title, comps):\n    parts = []\n    for c in comps:\n        color = c.get("color") or ""\n        style = \' style="color:%s"\' % color if HEX.match(color) else ""\n        text = html.escape(c["text"], quote=True)\n        if c["type"] == "標題":\n            parts.append("<h1%s>%s</h1>" % (style, text))\n        elif c["type"] == "段落":\n            parts.append("<p%s>%s</p>" % (style, text))\n        else:\n            parts.append("<button%s>%s</button>" % (style, text))\n    return (\'<!doctype html>\\n<html lang="zh-Hant">\\n<head>\\n<meta charset="utf-8">\\n<title>%s</title>\\n</head>\\n\'\n            \'<body>\\n%s\\n</body>\\n</html>\\n\' % (html.escape(title, quote=True), "\\n".join(parts)))\n\n\ndef build(win, spec, slots):\n    def comps_of(ctx):\n        return ctx.state.setdefault("comps", [])\n\n    def add(ctx):\n        cs = comps_of(ctx)\n        n = len(cs) + 1\n        kind = TYPES[(n - 1) % len(TYPES)]\n        cs.append({"type": kind, "text": "%s %d" % (kind, n), "color": ""})\n        ctx.state["sel"] = len(cs) - 1\n        ctx.set("status", text="已新增「%s」，共 %d 個元件" % (kind, len(cs)))\n\n    def remove(ctx):\n        cs = comps_of(ctx)\n        i = ctx.state.get("sel")\n        if isinstance(i, int) and 0 <= i < len(cs):\n            del cs[i]\n            ctx.state["sel"] = None\n            ctx.set("status", text="已刪除，剩 %d 個元件" % len(cs))\n        else:\n            ctx.set("status", text="請先在清單選一個元件")\n\n    def export(ctx):\n        ctx.set("code", value=to_html(spec["params"]["page_title"], comps_of(ctx)))\n        ctx.goto("code")\n        ctx.set("status", text="已匯出 %d 個元件的 HTML" % len(comps_of(ctx)))\n\n    return {"handlers": {"click:add": add, "click:remove": remove, "click:export": export,\n                         "shortcut:add": add, "shortcut:remove": remove}}\n'},FA_PY_EXAMPLES={"llc/README.md":"# LLVM IR（llc）範例\n\n這些是手寫的 LLVM IR（`.ll`，不透明指標寫法，LLVM 15 以上），呼叫 **SDL2、OpenGL、GTK3、OpenCL** 的 C API。**同一份 `.ll` 兩邊都能跑**：\n\n## ① 在 run terminal（或 job_run）裡直接跑\n\n    cd examples/llc\n    lli game/sdl2_pong.ll          # 乒乓球（SDL2）：w/s、方向鍵、滑鼠；第一個參數＝跑幾幀後離開\n    lli gui/gtk3_widgets.ll        # GTK3 widget；參數 3＝自己按 3 次按鈕後離開\n    lli gui/sdl2_gl_triangle.ll    # SDL2＋OpenGL 三角形：滑鼠左鍵拖曳旋轉、滾輪縮放\n\nIR 裡 `declare` 了 SDL2／OpenGL／GTK3／printf 的函式、又沒有自己定義，編譯器就把它們編成 wasm 匯入（模組 `env`），由 `uml/llvm_host.js` 用 JS 實作：\n視窗、畫布、鍵盤、滑鼠經 GUI 橋接（跟 python 的 `gui`／`pygame`／`gl3d`、node 的 `gui` 同一套協定）；OpenGL 固定管線收成頂點批次，在 WebGL2 畫布上用 `flat` 程式畫；\n會等事件的函式（`SDL_Delay`、`SDL_PollEvent`、`SDL_RenderPresent`、`gtk_main`）用 JSPI 暫停 wasm，不會卡住頁面（需要 Chrome／Edge 137 以上或桌面版）。\n程式結束或 Ctrl+C 會收掉它開的視窗。\n\n編譯器為此新增：`float`（f32）、`fpext`／`fptrunc`、可變參數呼叫（`call i32 (ptr, ...) @printf(...)`，額外引數放進 8 位元組對齊的緩衝區）、函式指標當值（只能傳給主機函式當回呼，不能在 wasm 裡間接呼叫）、`main(argc, argv)`。\n**仍然不支援**：`phi`（用 alloca／load／store）、定義可變參數函式、wasm 內的間接呼叫。全域陣列的初始值支援整數與浮點的一維陣列（`[i32 1, i32 2]`）。\n**音訊**：SDL 的音訊裝置對應頁面端的一個串流（`gui.audio` 的 `stream_*`，見 `DESIGN.pygame-opengl-standard.md`「音訊」）；裝置一開始是暫停的（SDL 的規則）、`SDL_PauseAudioDevice(dev, 0)` 才開始播；暫停時新資料先留著、繼續才排程（暫停中已排程的不會倒回）。callback 模式需要主機在 wasm 記憶體配置緩衝區，目前辦不到。簽名要跟 C 原型一致（`SDL_SetRenderDrawColor` 的 `Uint8` 是 `i8`；`snprintf` 的 `size_t` 可以是 `i32` 或 `i64`；GTK 的 `g_signal_connect_data` 回傳值宣告成 `i32`）；宣告了沒實作的函式，檢查階段會明確說「沒有實作」。\n\n| 檔案 | 表現方式 | 實作範圍 |\n|---|---|---|\n| `game/sdl2_piano.ll` | SDL2 音訊＋影像＋鍵盤：8 鍵小鋼琴（A S D F G H J K），方波 PCM 經 `SDL_QueueAudio` | `SDL_OpenAudioDevice／QueueAudio／GetQueuedAudioSize／ClearQueuedAudio／PauseAudioDevice／CloseAudioDevice`、`SDL_OpenAudio／PauseAudio／CloseAudio`；**只支援佇列模式**（`SDL_AudioSpec` 的 callback 要是 NULL，否則回 0 並說明）；格式 U8、S8、U16LSB、S16LSB、S32LSB、F32LSB，1 或 2 聲道；第一個參數＝自動彈奏並跑幾幀 |\n| `game/sdl2_pong.ll` | SDL2：視窗、渲染器、填色矩形、鍵盤、滑鼠、計時 | `SDL_Init／CreateWindow／CreateRenderer／SetRenderDrawColor／RenderClear／RenderFillRect／RenderDrawRect／RenderDrawLine／RenderDrawPoint／RenderPresent／PollEvent（QUIT、KEYDOWN／UP、MOUSEMOTION、MOUSEBUTTONDOWN／UP、MOUSEWHEEL）／Delay／GetTicks`；一幀最多 200 道繪圖指令（橋接上限） |\n| `gui/gtk3_widgets.ll` | GTK3 widget：視窗、盒子、標籤、輸入框、勾選框、按鈕、進度條、訊號、計時器 | `gtk_init／window／box／label／entry／button／check_button／progress_bar／container_add／widget_show_all／main／main_quit／g_signal_connect_data（clicked、changed、toggled、destroy、delete-event）／g_timeout_add` |\n| `gui/sdl2_gl_triangle.ll` | SDL2＋OpenGL 固定管線 | `SDL_GL_CreateContext／SwapWindow`、`glBegin／End／Vertex2f／3f／Color3f／4f`、矩陣（`glMatrixMode／LoadIdentity／Push／Pop／Translatef／Rotatef／Scalef／Ortho／Frustum／gluPerspective`）、`glClearColor／Clear／Enable(DEPTH_TEST)`；沒有光照、紋理、著色器 |\n| `gpgpu/nbody3d.ll` | 照 Python 版（sdlmm/exams/nbody3d.c）：`lli nbody3d.ll [N=3072] [LOOP] [frames]`；O(N²) 引力、加法混色發光點精靈、HUD 點陣字（7×13）、滑桿；拖曳旋轉、滾輪縮放、空白暫停、R 重置、C 追蹤 | `glBlendFunc`、`glPointParameterfv`、`gluLookAt`、`gluPerspective`；**計算在 wasm 的 CPU 上**（GPU 按鈕要等 OpenCL 墊片）。**推薦改跑 `gpgpu/nbody3d_cl.ll`**（OpenCL 版，預設 GPU；GPU 不可用時自動退回 CPU 並在狀態行說明）。|\n| `gpgpu/nbody3d_cl.ll` | **推薦**：nbody3d 的 OpenCL 版（由 `_gen/_gen_nbody3d_cl.py` 產生，與 CPU 版同一份物理與畫面）。預設在 GPU（OpenCL 核心，WebGL2 後端）；按 CPU／GPU 按鈕切換計算來源；GPU 不可用時自動退回 CPU，狀態行會寫出原因。整個物理步留在裝置上（速度不回傳主機）。 |\n| `gpgpu/fluid3d.ll` | 照 Python 版（fluid3d.py）：1000 顆 SPH（H=0.1、ρ0=1000、K=200、μ=3、dt=0.003、反射牆），依速度上色的球形點精靈＋外框＋資訊列；拖曳旋轉、滾輪縮放、空白＝晃一下、P 暫停、R 重置 | `glPointSize`、`gluPerspective`、`glOrtho`；**計算在 wasm 的 CPU 上**（GPU 要等 OpenCL 墊片） |\n| `gpgpu/fluid3d_cl.ll` | fluid3d 的 OpenCL 版（由 `_gen/_gen_fluid3d_cl.py` 產生）：密度與力用 OpenCL 核心（float32），預設 GPU；底部 CPU／GPU 按鈕切換（選中是綠色）；GPU 不可用時自動退回 CPU，狀態行寫出原因。`fluid3d.ll` 維持純 CPU 版。 |\n| `gpgpu/interop_cl_gl.ll` | **OpenCL 與 OpenGL 的標準互通**（`cl_khr_gl_sharing`）：OpenCL 核心每幀把 N 個點的位置寫進與 OpenGL 共享的頂點緩衝區，`glDrawArrays(GL_POINTS)` 直接畫；`lli interop_cl_gl.ll [點數=4096] [幀數]`，結束時印 `interop OK frames=… n=… checksum=…`。**完全是標準呼叫**（`glGenBuffers／BindBuffer／BufferData／VertexPointer／DrawArrays`、`clCreateFromGLBuffer／clEnqueueAcquireGLObjects／clEnqueueReleaseGLObjects`），給你抄用與驗證；加速不用你改寫——框架在執行期看到「共享緩衝區由 WebGPU 核心寫入、再 `glDrawArrays(GL_POINTS)` 加法混合畫出」就跳過讀回直接畫，條件不吻合（光照、紋理、其他屬性、非 WebGPU 後端）退回「Release 時把內容交給 GL」的標準語意，像素相同。 |\n| `gui/music_player.ll` | 音樂盒：內建〈歡樂頌〉即時合成（方波／三角／正弦），兩個八度的琴鍵與進度；空白暫停、↑↓速度、1 2 3 波形、R 從頭 | `SDL_QueueAudio` 佇列模式；`pow／floor／sin`；合成的音高用 FFT 驗證（E4 量到 330.8 Hz） |\n| `gui/midi_player.ll` | MIDI 播放器：在 IR 裡解析標準 MIDI（SMF 0／1、變長時間、running status、tempo 表），12 聲部正弦合成，捲動的 piano roll | **檔案**：`lli gui/midi_player.ll gui/demo.mid`（用 `fopen／fread` 讀終端機沙盒，`/mnt/<名稱>` 也行）；參數 `-` 或不給＝內嵌示範曲；第二個參數＝跑幾幀後離開 |\n| `gpgpu/opencl_vecadd.ll` | OpenCL：執行時編譯核心字串、buffer、NDRange、讀回驗證 | **CPU 後備**（`llvm_host.js` 的 OpenCL 墊片）：run terminal／job 內可跑，`lli opencl_vecadd.ll [N]` 印 `vadd OK`；真機器有驅動時同一份 IR 也能跑。限制見 `DESIGN.run-terminal.md` §21 |\n| `gpgpu/opencl_icd_reduce.ll` | OpenCL：`__local`＋`barrier` 的樹狀歸約（4 個工作群各 64 個 float）。第一行註解 `; fa-opencl: icd` 讓 cl* 呼叫改走 ICD 載入器（完整 OpenCL C；預設墊片不支援 `__local`） | **ICD 模式**（`llvm_cl_icd.js`；見 DESIGN.pyopencl.md §12）：run terminal 內可跑；真機器照常連結 libOpenCL |\n\n## ② 在真機器上編成原生執行檔\n\n    llc -filetype=obj -relocation-model=pic game/sdl2_pong.ll -o pong.o\n    clang pong.o -o pong $(sdl2-config --libs)            # 或 gcc；GTK 用 pkg-config --libs gtk+-3.0；GL 加 -lGL；OpenCL 加 -lOpenCL\n\n驗證現況：原生（llvmlite 編成物件檔、gcc 連結）pong、GTK3、GL 在 Xvfb 實跑通過（SDL2 在無頭環境要設 `SDL_IM_MODULE=none`，否則初始化輸入法就段錯誤，純 C 也一樣）；\nwasm 版在真 Electron 驗證（`scripts/eval/llc_host.eval.js`）：pong 開視窗、注入鍵盤與滑鼠、截圖、跑完 150 幀；GTK3 的輸入／勾選／點擊讓標籤更新、關視窗後程式結束；GL 視窗與滑鼠事件、跑完 400 幀。\n**沒驗證**：OpenGL 的畫面內容在 wasm 版（只確認沒有 trap 與 glerror）、真 GPU、網頁版、影片（沒有範例）、實際聽到聲音（驗證環境沒有音訊輸出裝置，只驗證到頁面的串流與排程）。\n\n## 檔案系統（stdio）\n\n`lli` 跑的程式可以用 `fopen／fclose／fread／fwrite／fgets／fputs／fgetc／fputc／fseek／ftell／rewind／feof／fflush／remove／rename／access`，接到**這個終端機的沙盒檔案系統**（相對路徑從目前目錄起算；`/mnt/<名稱>` 是即時的 File Access Point 檔案系統，程式結束時寫回）。\n開啟時整個檔案讀進記憶體；寫入在 `fclose／fflush`／程式結束時才寫回。`size_t`、`long` 在 x86_64 的 IR 宣告成 `i64`、wasm32 宣告成 `i32`，兩種都收。\n注意：`/mnt/<名稱>` 要先被指令提到過才會掛載（例如先 `ls /mnt/<名稱>`）；程式內自己組出的 `/mnt` 路徑不會觸發掛載。\n\n## 範例的產生器\n\n`_gen/_irb.py` 是一個極小的 IR 產生器（運算子重載的 `V`、變數、迴圈、if；不是編譯器），`_gen/_gen_*.py` 用它寫出上面的 `.ll`（輸出是普通的 `.ll`，原生與 wasm 都能用）。改範例請改產生器再重新產生。\n（教訓：產生器曾在 `+=` 時多算了一個除法，原生編譯器最佳化掉了，但我們的 wasm 編譯器照單全收，除數是 0 就 trap——原生通過不代表 wasm 沒問題，所以每個範例兩邊都要驗。）\n","llc/conformance/README.md":"# OpenCL 一致性套件\n\n同一組標準 OpenCL C 核心，在框架的每個後端上跑，與 double 精度的參考解（及有解析解的案例的解析解）比對。**誤差超標就修框架，不放寬容差**。\n這裡的東西是給你「照標準寫、拿來驗證」用的：`kernels.cl` 是全部核心的原始碼，沒有任何框架專屬寫法，可以直接抄進你的 OpenCL 程式。\n\n## 比哪些後端\n\n| 後端 | 說明 |\n|---|---|\n| `js` | KIR 的 JS 參考後端（每個 f32 運算都包 `Math.fround`），當對照基準 |\n| `webgpu-t` | WebGPU，workgroup 共享記憶體分塊（tile）開啟 |\n| `webgpu-u` | WebGPU，未分塊 |\n| `webgl2` | WebGL2（RGBA32F 紋理＋全螢幕三角形） |\n\n共 47 個案例、137 個（案例×規模）組合；邊界規模 N＝1、63、64、65、255、256、257、1000。\n\n## 怎麼跑\n\n**node（不需要 GPU，一秒內；只驗 JS 參考後端與案例本身的自洽）**\n\n    node renderer/src/gpu/kir_conformance_test.js\n\n**真 Electron（一個頁面，約 2 到 3 秒，四個後端全跑）**\n\n    node scripts/eval/kir_conformance.build.js /tmp/kc.eval.js\n    FA_EVAL_GL=gpu FA_EVAL_TIMEOUT_MS=600000 node scripts/eval/run_eval.js /tmp/kc.eval.js 17994\n\n沒有真 GPU 的機器：`FA_EVAL_GL=swiftshader` 只有 WebGL2（沒有 WebGPU）；要連 WebGPU 一起測，用軟體 Vulkan（`--enable-unsafe-webgpu --enable-features=Vulkan --use-angle=swiftshader --enable-unsafe-swiftshader`）。\n結果印在 `KCONF {…}`：`backends.<後端>.pass／total／fails`、`perCase`（每個案例每個後端的最大誤差）、`allPass`。\n\n## 判定規則\n\n每個輸出元素的「誤差 ÷ 該元素的量級」要 ≤ 容差；容差與 `gpu_core.tolerance` 同形式：8·√k·2⁻²³（k 是該案例累加的項數，見下表）。\n標「逐位元相同」的案例（單一 IEEE 加、乘、比較、min、max）要求誤差恰為 0。簡諧振子另外對解析解（cos 與 sin 的閉式解）比。\n\n## 案例\n\n| 案例 | 群組 | 規模（N 或步數 S） | 判定 | 說明 |\n|---|---|---|---|---|\n| `vecadd` | elem | 1、63、64、65、255、256、257、1000 | 逐位元相同 | o = a + b（單一加法，應逐位元相同） |\n| `saxpy` | elem | 1、63、64、65、255、256、257、1000 | 逐位元相同 | o = s·x + y（s 為純量；應逐位元相同：WGSL 不做 FMA 融合） |\n| `sqrt` | elem | 1、63、64、65、255、256、257、1000 | 誤差／量級 ≤ 8·√1·2⁻²³ | o = √x（x ∈ [0, 100]） |\n| `rsqrt` | elem | 1、63、64、65、255、256、257、1000 | 誤差／量級 ≤ 8·√1·2⁻²³ | o = 1/√x（x ∈ [0.01, 100]） |\n| `sin` | elem | 1、63、64、65、255、256、257、1000 | 誤差／量級 ≤ 8·√1·2⁻²³ | o = sin x（x ∈ [-10, 10]） |\n| `cos` | elem | 1、63、64、65、255、256、257、1000 | 誤差／量級 ≤ 8·√1·2⁻²³ | o = cos x（x ∈ [-10, 10]） |\n| `exp` | elem | 1、63、64、65、255、256、257、1000 | 誤差／量級 ≤ 8·√1·2⁻²³ | o = eˣ（x ∈ [-5, 5]） |\n| `floor` | elem | 1、63、64、65、255、256、257、1000 | 逐位元相同 | o = ⌊x⌋（x ∈ [-50, 50]，應逐位元相同） |\n| `select` | elem | 1、63、64、65、255、256、257、1000 | 逐位元相同 | o = x > 0.5 ? x : −x（三元運算子，應逐位元相同） |\n| `pow` | elem | 1、63、64、65、255、256、257、1000 | 誤差／量級 ≤ 8·√1·2⁻²³ | o = pow(x, y)（x ∈ [0.1, 10]，y ∈ [-2, 3]） |\n| `min` | elem | 1、63、64、65、255、256、257、1000 | 逐位元相同 | o = min(a, b) |\n| `max` | elem | 1、63、64、65、255、256、257、1000 | 逐位元相同 | o = max(a, b) |\n| `bound_vecadd_N1` | bound | 1 | 逐位元相同 | vecadd，N＝1（應逐位元相同） |\n| `bound_vecadd_N63` | bound | 63 | 逐位元相同 | vecadd，N＝63（應逐位元相同） |\n| `bound_vecadd_N64` | bound | 64 | 逐位元相同 | vecadd，N＝64（應逐位元相同） |\n| `bound_vecadd_N65` | bound | 65 | 逐位元相同 | vecadd，N＝65（應逐位元相同） |\n| `bound_vecadd_N255` | bound | 255 | 逐位元相同 | vecadd，N＝255（應逐位元相同） |\n| `bound_vecadd_N256` | bound | 256 | 逐位元相同 | vecadd，N＝256（應逐位元相同） |\n| `bound_vecadd_N257` | bound | 257 | 逐位元相同 | vecadd，N＝257（應逐位元相同） |\n| `bound_vecadd_N1000` | bound | 1000 | 逐位元相同 | vecadd，N＝1000（應逐位元相同） |\n| `bound_empty` | bound | 0 | 逐位元相同 | N＝0（空輸入）：不派送、不報錯，輸出長度 0 |\n| `loop_rowsum_n1` | loop | 1 | 誤差／量級 ≤ 8·√16·2⁻²³ | for 迴圈求和：每列 16 個元素，n＝1 |\n| `loop_rowsum_n64` | loop | 64 | 誤差／量級 ≤ 8·√16·2⁻²³ | for 迴圈求和：每列 16 個元素，n＝64 |\n| `loop_rowsum_n1000` | loop | 1000 | 誤差／量級 ≤ 8·√16·2⁻²³ | for 迴圈求和：每列 16 個元素，n＝1000 |\n| `reduce2_N1` | loop | 1 | 誤差／量級 ≤ 8·√1·2⁻²³ | 兩階段歸約（部分和 ch＝32，再加總），N＝1 |\n| `reduce2_N100` | loop | 100 | 誤差／量級 ≤ 8·√100·2⁻²³ | 兩階段歸約（部分和 ch＝32，再加總），N＝100 |\n| `reduce2_N1000` | loop | 1000 | 誤差／量級 ≤ 8·√1000·2⁻²³ | 兩階段歸約（部分和 ch＝32，再加總），N＝1000 |\n| `allpairs_N1` | tile | 1 | 誤差／量級 ≤ 8·√1·2⁻²³ | 全對全引力核心，N＝1（分塊版與未分塊版都要對） |\n| `allpairs_N31` | tile | 31 | 誤差／量級 ≤ 8·√31·2⁻²³ | 全對全引力核心，N＝31（分塊版與未分塊版都要對） |\n| `allpairs_N32` | tile | 32 | 誤差／量級 ≤ 8·√32·2⁻²³ | 全對全引力核心，N＝32（分塊版與未分塊版都要對） |\n| `allpairs_N33` | tile | 33 | 誤差／量級 ≤ 8·√33·2⁻²³ | 全對全引力核心，N＝33（分塊版與未分塊版都要對） |\n| `allpairs_N64` | tile | 64 | 誤差／量級 ≤ 8·√64·2⁻²³ | 全對全引力核心，N＝64（分塊版與未分塊版都要對） |\n| `allpairs_N65` | tile | 65 | 誤差／量級 ≤ 8·√65·2⁻²³ | 全對全引力核心，N＝65（分塊版與未分塊版都要對） |\n| `allpairs_N1000` | tile | 1000 | 誤差／量級 ≤ 8·√1000·2⁻²³ | 全對全引力核心，N＝1000（分塊版與未分塊版都要對） |\n| `ho_leapfrog_S1` | integrator | 1 | 誤差／量級 ≤ 8·√1·2⁻²³ | 簡諧振子 leapfrog，步數 1（dt＝0.01；對照 double 同公式） |\n| `ho_leapfrog_S2` | integrator | 2 | 誤差／量級 ≤ 8·√2·2⁻²³ | 簡諧振子 leapfrog，步數 2（dt＝0.01；對照 double 同公式） |\n| `ho_leapfrog_S5` | integrator | 5 | 誤差／量級 ≤ 8·√5·2⁻²³ | 簡諧振子 leapfrog，步數 5（dt＝0.01；對照 double 同公式） |\n| `ho_leapfrog_S10` | integrator | 10 | 誤差／量級 ≤ 8·√10·2⁻²³ | 簡諧振子 leapfrog，步數 10（dt＝0.01；對照 double 同公式） |\n| `ho_leapfrog_S100` | integrator | 100 | 誤差／量級 ≤ 8·√100·2⁻²³ | 簡諧振子 leapfrog，步數 100（dt＝0.01；對照 double 同公式） |\n| `ho_leapfrog_S1000` | integrator | 1000 | 誤差／量級 ≤ 8·√1000·2⁻²³ | 簡諧振子 leapfrog，步數 1000（dt＝0.01；對照 double 同公式） |\n| `nbody16_S1` | integrator | 1 | 誤差／量級 ≤ 8·√4·2⁻²³ | 16 體引力（f32x4）leapfrog，步數 1（逐步對照 double） |\n| `nbody16_S2` | integrator | 2 | 誤差／量級 ≤ 8·√8·2⁻²³ | 16 體引力（f32x4）leapfrog，步數 2（逐步對照 double） |\n| `nbody16_S5` | integrator | 5 | 誤差／量級 ≤ 8·√20·2⁻²³ | 16 體引力（f32x4）leapfrog，步數 5（逐步對照 double） |\n| `nbody16_S10` | integrator | 10 | 誤差／量級 ≤ 8·√40·2⁻²³ | 16 體引力（f32x4）leapfrog，步數 10（逐步對照 double） |\n| `nbody16_S100` | integrator | 100 | 誤差／量級 ≤ 8·√400·2⁻²³ | 16 體引力（f32x4）leapfrog，步數 100（逐步對照 double） |\n| `f32x4_vec4` | vec | 1、64、1000 | 逐位元相同 | f32x4：out.x＝in.x＋in.w，out.y＝in.y·2，out.z＝in.z−1，out.w＝in.w（應逐位元相同） |\n| `multi_out` | vec | 1、63、64、65、1000 | 逐位元相同 | 多輸出核心：s＝a＋b、d＝a−b（兩個輸出都要對） |\n\n## 目前結果（誠實的範圍）\n\n- node：JS 參考後端 137／137 通過。\n- 真 Electron（軟體 GL／軟體 Vulkan，**這台機器沒有真 GPU**）：`js`、`webgpu-t`、`webgpu-u`、`webgl2` 四個後端都 137／137 通過，頁面總計約 2 到 3 秒。\n- **沒在真 GPU 上跑過這一版**（上一版在 NVIDIA 實跑過 nbody／fluid 的整合，不是這個套件）。有真 GPU 的人請跑上面的指令，結果貼回來。\n\n## 這個套件抓到並修掉的框架問題\n\n1. WebGL2 路徑：輸入紋理的寬度 uniform（`u_W_<名字>`）沒有設定（預設 0，取模為 0），N＞1 的核心全部算錯（137 項只過 16 項）。已在 `kir_webgl2.js`（`runGl` 與 `dispatchOne`）設定；同時放寬「輸入可以比輸出長」（例如 `a[i*k+j]`），與 WebGPU 一致。\n2. `sin`／`cos`：GLSL 與 WGSL 內建函式的精度依驅動而不同（軟體實作的誤差約 2×10⁻⁴，超過容差約 200 倍）。`kir_gen.js` 改成自己做範圍縮減（Cody-Waite 三段 π/4）加 cephes 的 sinf／cosf 多項式，只用加減乘，各後端結果一致（|x|＞8192 才退回內建函式）。\n","llc/game/sdl2_piano.ll":'; SDL2 音訊＋影像＋鍵盤：8 鍵小鋼琴。A S D F G H J K 彈 C4~C5，視窗亮起對應的琴鍵，Esc 離開。\n; 聲音：用方波合成 16 位元單聲道 PCM（22050 Hz、150 ms），經 SDL_QueueAudio 送出（佇列模式：SDL_AudioSpec 的 callback 是 NULL）。\n; 命令列第一個參數 N＝自動彈奏並在 N 幀後結束（測試用：每 20 幀換下一個音）。\n; SDL_AudioSpec 的欄位偏移：freq 0、format 4（AUDIO_S16LSB＝0x8010）、channels 6、samples 8、callback 16。\n; SDL_Event：type +0、鍵盤 scancode +16。\ntarget triple = "x86_64-pc-linux-gnu"\n\n@title = private constant [14 x i8] c"IR SDL piano\\00\\00"\n@fmt_end = private constant [23 x i8] c"notes=%d queued=%d ok\\0A\\00"\n@fmt_noaudio = private constant [18 x i8] c"no audio device\\0A\\00\\00"\n@freqs = private constant [8 x i32] [i32 262, i32 294, i32 330, i32 349, i32 392, i32 440, i32 494, i32 523]\n@scs = private constant [8 x i32] [i32 4, i32 22, i32 7, i32 9, i32 10, i32 11, i32 13, i32 14]\n\ndeclare i32 @SDL_Init(i32)\ndeclare void @SDL_Quit()\ndeclare ptr @SDL_CreateWindow(ptr, i32, i32, i32, i32, i32)\ndeclare ptr @SDL_CreateRenderer(ptr, i32, i32)\ndeclare i32 @SDL_PollEvent(ptr)\ndeclare i32 @SDL_SetRenderDrawColor(ptr, i8, i8, i8, i8)\ndeclare i32 @SDL_RenderClear(ptr)\ndeclare i32 @SDL_RenderFillRect(ptr, ptr)\ndeclare void @SDL_RenderPresent(ptr)\ndeclare void @SDL_Delay(i32)\ndeclare void @SDL_DestroyRenderer(ptr)\ndeclare void @S