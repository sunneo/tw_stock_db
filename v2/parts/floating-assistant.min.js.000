 dy, n, I, O, need) => [need[0] ? unb(g, g.div(dy, I[1]), I[0].shape) : null, need[1] ? unb(g, g.neg(g.div(g.mul(dy, I[0]), g.mul(I[1], I[1]))), I[1].shape) : null],\n        Neg: (g, dy) => [g.neg(dy)],\n        Sqrt: (g, dy, n, I, O) => [g.div(dy, g.mul(O[0], g.scalar(2)))],\n        Reciprocal: (g, dy, n, I, O) => [g.neg(g.mul(dy, g.mul(O[0], O[0])))],\n        Log: (g, dy, n, I) => [g.div(dy, I[0])],\n        Exp: (g, dy, n, I, O) => [g.mul(dy, O[0])],\n        Cast: (g, dy, n, I, O) => { if (I[0].dtype !== 'f32') throw new Error('Cast 的輸入不是浮點，不能求梯度（凍結常數不需要）'); return [dy]; },\n        Sigmoid: (g, dy, n, I, O) => [g.mul(dy, g.mul(O[0], g.sub(g.scalar(1), O[0])))],\n        Softmax: (g, dy, n, I, O) => { const ax = n.attrs.axis; const s = g.reduceSum(g.mul(dy, O[0]), [ax], true); return [g.mul(O[0], g.sub(dy, s))]; },\n        MatMul: (g, dy, n, I, O, need) => {\n            const a = I[0], b = I[1], ra = a.shape.length, rb = b.shape.length;\n            return [need[0] ? unb(g, g.matmul(dy, g.transpose(fresh(g, b), lastTwoPerm(rb))), a.shape) : null, need[1] ? unb(g, g.matmul(g.transpose(a, lastTwoPerm(ra)), dy), b.shape) : null];\n        },\n        Transpose: (g, dy, n) => { const p = n.attrs.perm, inv = new Array(p.length); p.forEach((v, i) => { inv[v] = i; }); return [g.transpose(dy, inv)]; },\n        Reshape: (g, dy, n, I) => [g.reshape(dy, I[0].shape), null],\n        ReduceSum: (g, dy, n, I) => [g.expand(n.attrs.keepdims ? dy : g.reshape(dy, keepShape(I[0].shape, n._axes)), I[0].shape), null],\n        ReduceMean: (g, dy, n, I) => { const ax = n.attrs.axes; const cnt = ax.reduce((a, i) => a * I[0].shape[i], 1); const k = n.attrs.keepdims ? dy : g.reshape(dy, keepShape(I[0].shape, ax)); return [g.expand(g.mul(k, g.scalar(1 / cnt)), I[0].shape)]; },\n        Expand: (g, dy, n, I) => [unb(g, dy, I[0].shape), null],\n        Gather: (g, dy, n, I, O, need) => { if (need[0]) throw new Error('Gather 對資料求梯度尚未實作（嵌入表是凍結常數時不需要）'); return [null, null]; },\n        DequantizeLinear: (g, dy, n, I, O, need) => { if (need.some(Boolean)) throw new Error('DequantizeLinear 的輸入必須是凍結常數（直通估計的做法是：權重凍結，只對激活求梯度）'); return []; },\n    };\n    function keepShape(shape, axes) { return shape.map((d, i) => (axes.includes(i) ? 1 : d)); }\n\n    // 反向：回傳 Map<paramName, gradTensor>\n    // seed：外部給的上游梯度張量（形狀同 loss）；沒給時 loss 必須是純量，以 1 起算。wrtNames 可包含非參數的輸入（例如層輸入 x，用來取得 dx）\n    function grad(g, loss, wrtNames, seed) {\n        const need = new Set(wrtNames);                       // 需要梯度的張量（沿前向傳播）\n        const fwd = g.nodes.slice();\n        for (const n of fwd) if (n.inputs.some((x) => need.has(x))) for (const o of n.outputs) need.add(o);\n        const grads = new Map(); grads.set(loss.name, seed || g.scalar(1));\n        const add = (name, t) => { if (grads.has(name)) grads.set(name, g.add(grads.get(name), t)); else grads.set(name, t); };\n        for (let i = fwd.length - 1; i >= 0; i--) {\n            const n = fwd[i]; const dy = grads.get(n.outputs[0]); if (!dy || !n.outputs.some((o) => need.has(o))) continue;\n            const rule = RULES[n.op]; if (!rule) throw new Error('沒有反向規則的運算子：' + n.op);\n            if (n.op === 'ReduceSum') n._axes = g.tensors.get(n.inputs[1]).data ? Array.from(g.tensors.get(n.inputs[1]).data) : [];\n            const I = n.inputs.map((x) => g.tensors.get(x)), O = n.outputs.map((x) => g.tensors.get(x));\n            const nd = n.inputs.map((x) => need.has(x));\n            const res = rule(g, dy, n, I, O, nd);\n            n.inputs.forEach((x, k) => { if (nd[k] && res[k]) add(x, res[k]); });\n        }\n        const out = new Map(); for (const w of wrtNames) { if (!grads.has(w)) throw new Error('參數沒有梯度路徑：' + w); out.set(w, grads.get(w)); } return out;\n    }\n\n    // Adam：alpha = lr/(1-b1^t) 與 c2 = 1/(1-b2^t) 由呼叫端每步當純量輸入餵入\n    function adam(g, params, grads, opt) {\n        opt = opt || {}; const b1 = opt.b1 || 0.9, b2 = opt.b2 || 0.999, eps = opt.eps || 1e-8;\n        const alpha = g.input('adam_alpha', []), c2 = g.input('adam_c2', []);\n        const cb1 = g.scalar(b1), cb1c = g.scalar(1 - b1), cb2 = g.scalar(b2), cb2c = g.scalar(1 - b2), ce = g.scalar(eps);\n        const state = [];\n        for (const p of params) {\n            const gr = grads.get(p.name); const m = g.input(p.name + '.m', p.shape), v = g.input(p.name + '.v', p.shape);\n            const m2 = g.add(g.mul(m, cb1), g.mul(gr, cb1c)), v2 = g.add(g.mul(v, cb2), g.mul(g.mul(gr, gr), cb2c));\n            const p2 = g.sub(p, g.mul(alpha, g.div(m2, g.add(g.sqrt(g.mul(v2, c2)), ce))));\n            g.output(p2); g.output(m2); g.output(v2); state.push({ param: p.name, p: p2.name, m: m.name, m2: m2.name, v: v.name, v2: v2.name });\n        }\n        return state;\n    }\n\n    // ───────── 直譯器（Float64） ─────────\n    function bIter(shape, outShape, fn) { // 對輸出每個索引，呼叫 fn(outIdx, srcOffset)\n        const r = outShape.length, st = strides(shape), lead = r - shape.length; const idx = new Array(r).fill(0), n = prod(outShape);\n        for (let o = 0; o < n; o++) {\n            let off = 0; for (let d = lead; d < r; d++) if (shape[d - lead] !== 1) off += idx[d] * st[d - lead];\n            fn(o, off);\n            for (let d = r - 1; d >= 0; d--) { if (++idx[d] < outShape[d]) break; idx[d] = 0; }\n        }\n    }\n    const UN = { Neg: (x) => -x, Sqrt: Math.sqrt, Reciprocal: (x) => 1 / x, Log: Math.log, Exp: Math.exp, Sigmoid: (x) => 1 / (1 + Math.exp(-x)) };\n    const BIN = { Add: (a, b) => a + b, Sub: (a, b) => a - b, Mul: (a, b) => a * b, Div: (a, b) => a / b };\n    const sc0 = (t) => t.shape.length === 0;\n    function execNode(n, vals, g) {\n        const I = n.inputs.map((x) => vals.get(x)); const outT = g.tensors.get(n.outputs[0]); const os = outT.shape; const out = new Float64Array(prod(os));\n        const op = n.op;\n        if (BIN[op]) { const f = BIN[op]; const ia = new Int32Array(out.length), ib = new Int32Array(out.length); bIter(I[0].shape, os, (o, off) => { ia[o] = off; }); bIter(I[1].shape, os, (o, off) => { ib[o] = off; }); for (let o = 0; o < out.length; o++) out[o] = f(I[0].data[ia[o]], I[1].data[ib[o]]); }\n        else if (UN[op]) { const f = UN[op]; for (let i = 0; i < out.length; i++) out[i] = f(I[0].data[i]); }\n        else if (op === 'MatMul') {\n            const a = I[0], b = I[1], m = a.shape[a.shape.length - 2], k = a.shape[a.shape.length - 1], nn = b.shape[b.shape.length - 1]; const bs = os.slice(0, -2), nb = prod(bs);\n            const ia = new Int32Array(nb), ib = new Int32Array(nb); const as = a.shape.slice(0, -2), bsh = b.shape.slice(0, -2);\n            if (nb > 0) { bIter(as, bs, (o, off) => { ia[o] = off; }); bIter(bsh, bs, (o, off) => { ib[o] = off; }); }\n            const bsz = m * nn; for (let q = 0; q < Math.max(nb, 1); q++) { const ao = (nb ? ia[q] : 0) * m * k, bo = (nb ? ib[q] : 0) * k * nn, co = q * bsz; for (let i = 0; i < m; i++) for (let p = 0; p < k; p++) { const av = a.data[ao + i * k + p]; if (av === 0) continue; for (let j = 0; j < nn; j++) out[co + i * nn + j] += av * b.data[bo + p * nn + j]; } }\n        }\n        else if (op === 'Transpose') { const p = n.attrs.perm, ish = I[0].shape, ist = strides(ish); const idx = new Array(os.length).fill(0); for (let o = 0; o < out.length; o++) { let off = 0; for (let d = 0; d < os.length; d++) off += idx[d] * ist[p[d]]; out[o] = I[0].data[off]; for (let d = os.length - 1; d >= 0; d--) { if (++idx[d] < os[d]) break; idx[d] = 0; } } }\n        else if (op === 'Reshape' || op === 'Cast') out.set(I[0].data);\n        else if (op === 'Expand') { bIter(I[0].shape, os, (o, off) => { out[o] = I[0].data[off]; }); }\n        else if (op === 'Softmax') { const ax = n.attrs.axis, sh = I[0].shape, st = strides(sh), len = sh[ax], tot = out.length; const done = new Uint8Array(tot); for (let s = 0; s < tot; s++) { if (done[s]) continue; const base = s - (Math.floor(s / st[ax]) % len) * st[ax]; let mx = -Infinity; for (let j = 0; j < len; j++) mx = Math.max(mx, I[0].data[base + j * st[ax]]); let sum = 0; for (let j = 0; j < len; j++) { const e = Math.exp(I[0].data[base + j * st[ax]] - mx); out[base + j * st[ax]] = e; sum += e; done[base + j * st[ax]] = 1; } for (let j = 0; j < len; j++) out[base + j * st[ax]] /= sum; } }\n        else if (op === 'ReduceSum' || op === 'ReduceMean') {\n            const axes = op === 'ReduceSum' ? Array.from(I[1].data) : n.attrs.axes; const sh = I[0].shape; const keepS = sh.map((d, i) => (axes.includes(i) ? 1 : d)); const cnt = axes.reduce((a, i) => a * sh[i], 1);\n            const oidx = new Int32Array(I[0].data.length); bIter(keepS, sh, (o, off) => { oidx[o] = off; }); for (let i = 0; i < oidx.length; i++) out[oidx[i]] += I[0].data[i]; if (op === 'ReduceMean') for (let i = 0; i < out.length; i++) out[i] /= cnt;\n        }\n        else if (op === 'Gather') { const d = I[0], ix = I[1], row = d.data.length / d.shape[0]; for (let i = 0; i < ix.data.length; i++) { const r = ix.data[i]; for (let j = 0; j < row; j++) out[i * row + j] = d.data[r * row + j]; } }\n        else if (op === 'DequantizeLinear' && sc0(I[1])) { const q = I[0], s0 = I[1].data[0], z0 = I[2] ? I[2].data[0] : 0; for (let i = 0; i < out.length; i++) out[i] = (q.data[i] - z0) * s0; }\n        else if (op === 'DequantizeLinear') { const q = I[0], sc = I[1], zp = I[2]; const ax = n.attrs.axis, st = strides(q.shape); for (let i = 0; i < out.length; i++) { const c = Math.floor(i / st[ax]) % q.shape[ax]; out[i] = (q.data[i] - (zp ? zp.data[c] : 0)) * sc.data[c]; } }\n        else throw new Error('直譯器沒有實作：' + op);\n        vals.set(n.outputs[0], { shape: os, data: out });\n    }\n    function run(g, feeds) {\n        const vals = new Map(); for (const [k, t] of g.tensors) if (t.isConst) vals.set(k, { shape: t.shape, data: t.data instanceof Float64Array ? t.data : Float64Array.from(t.data) });\n        for (const t of g.inputs) { const f = feeds[t.name]; if (!f) throw new Error('缺少輸入：' + t.name); vals.set(t.name, { shape: t.shape, data: Float64Array.from(f) }); }\n        for (const n of g.nodes) execNode(n, vals, g);\n        return vals;\n    }\n\n    // ───────── ONNX 序列化 ─────────\n    const TE = typeof TextEncoder !== 'undefined' ? new TextEncoder() : { encode: (s) => Uint8Array.from(Buffer.from(s, 'utf8')) };\n    function vb(v) { const o = []; while (v >= 128) { o.push((v % 128) | 128); v = Math.floor(v / 128); } o.push(v); return o; }\n    const cat = (arrs) => { let n = 0; for (const a of arrs) n += a.length; const o = new Uint8Array(n); let p = 0; for (const a of arrs) { o.set(a, p); p += a.length; } return o; };\n    const fVar = (f, v) => Uint8Array.from([...vb(f * 8), ...vb(v)]);\n    const fLen = (f, b) => cat([Uint8Array.from([...vb(f * 8 + 2), ...vb(b.length)]), b]);\n    const fStr = (f, s) => fLen(f, TE.encode(s));\n    function rawOf(dt, data) {\n        if (dt === 'f32') { const a = new Float32Array(data.length); for (let i = 0; i < a.length; i++) a[i] = data[i]; return new Uint8Array(a.buffer); }\n        if (dt === 'i64') { const a = new BigInt64Array(data.length); for (let i = 0; i < a.length; i++) a[i] = BigInt(Math.round(data[i])); return new Uint8Array(a.buffer); }\n        if (dt === 'i32') { const a = new Int32Array(data.length); for (let i = 0; i < a.length; i++) a[i] = data[i]; return new Uint8Array(a.buffer); }\n        if (dt === 'u8') return data instanceof Uint8Array ? data : Uint8Array.from(data); if (dt === 'i8') return new Uint8Array(Int8Array.from(data).buffer);\n        throw new Error('未知 dtype ' + dt);\n    }\n    function tensorProto(name, shape, dt, data) { return cat([...shape.map((d) => fVar(1, d)), fVar(2, DT[dt]), fStr(8, name), fLen(9, rawOf(dt, data))]); }\n    function attrProto(k, v) {\n        if (Array.isArray(v)) return cat([fStr(1, k), ...v.map((x) => fVar(8, x)), fVar(20, 7)]);\n        if (Number.isInteger(v)) return cat([fStr(1, k), fVar(3, v), fVar(20, 2)]);\n        throw new Error('不支援的屬性型別 ' + k);\n    }\n    function valueInfo(t) { const dims = cat(t.shape.map((d) => fLen(1, fVar(1, d)))); const tt = cat([fVar(1, DT[t.dtype]), fLen(2, dims)]); return cat([fStr(1, t.name), fLen(2, fLen(1, tt))]); }\n    function toOnnx(g, opts) {\n        opts = opts || {}; const parts = [];\n        for (const n of g.nodes) parts.push(fLen(1, cat([...n.inputs.map((x) => fStr(1, x)), ...n.outputs.map((x) => fStr(2, x)), fStr(3, n.outputs[0] + '_n'), fStr(4, n.op), ...Object.keys(n.attrs).filter((k) => n.attrs[k] !== undefined).map((k) => fLen(5, attrProto(k, n.attrs[k])))])));\n        parts.push(fStr(2, opts.name || 'train_graph'));\n        for (const [, t] of g.tensors) if (t.isConst) parts.push(fLen(5, tensorProto(t.name, t.shape, t.dtype, t.data)));\n        for (const t of g.inputs) parts.push(fLen(11, valueInfo(t)));\n        for (const t of g.outputs) parts.push(fLen(12, valueInfo(t)));\n        const opset = cat([fStr(1, ''), fVar(2, 17)]);\n        return cat([fVar(1, 8), fLen(8, opset), fLen(7, cat(parts))]);\n    }\n\n    return { G, RULES, grad, adam, run, toOnnx, DT, prod };\n});\n\n};\nMODS[\"qwen3_graph\"] = function (module, exports, require) {\n/* 從真的 Qwen3 ONNX（ORT-GenAI 風格的 q8 融合圖，例如 model_quantized.onnx）讀出權重，建成 onnx_grad_core 的「無快取、固定序列長度」訓練圖。\n *  這是型樣辨識式的降級（不是通用轉換）：把\n *    DynamicQuantizeLinear＋MatMulInteger＋Cast＋縮放 Mul → DequantizeLinear(uint8 權重, 整張量縮放, 零點)＋MatMul（激活不量化＝直通估計）\n *    SimplifiedLayerNormalization／SkipSimplifiedLayerNormalization → RMSNorm 基本運算子\n *    RotaryEmbedding(interleaved=0，rotate-half) → x*cos + (x·R)*sin\n *    GroupQueryAttention(16 個查詢頭、8 個 KV 頭、scale=1/√128) → 無快取版：KV 頭重複（Expand）、因果遮罩、Softmax\n *  LoRA 加在每層 7 個線性層（q／k／v／o／gate／up／down，與 196 = 28×7 一致）。\n *  讀不到的欄位一律丟明確錯誤。 */\n'use strict';\nconst Gm = require('./onnx_grad_core.js');\nconst P = require('./onnx_patch_core.js');\n\nfunction openModel(bytes) { return { bytes, ix: P.indexModel(bytes) }; }\nfunction initOf(M, name) { const t = M.ix.inits.get(name); if (!t) throw new Error('模型沒有初始值：' + name); return t; }\nfunction f32Of(M, name) { const t = initOf(M, name); if (t.dataType !== 1) throw new Error(name + ' 不是 float32'); if (t.rawStart >= 0) { const raw = M.bytes.slice(t.rawStart, t.rawEnd); return { dims: t.dims, data: Float64Array.from(new Float32Array(raw.buffer, raw.byteOffset, raw.byteLength / 4)) }; } if (t.floatData) return { dims: t.dims, data: Float64Array.from(t.floatData) }; throw new Error(name + ' 讀不到資料'); }\nfunction u8Of(M, name) { const t = initOf(M, name); if (t.dataType !== 2 || t.rawStart < 0) throw new Error(name + ' 不是 raw uint8'); return { dims: t.dims, data: M.bytes.subarray(t.rawStart, t.rawEnd) }; }\nfunction scalarOf(M, name) { const t = initOf(M, name); if (t.dataType === 1) return t.floatData ? t.floatData[0] : f32Of(M, name).data[0]; if (t.int32Data) return t.int32Data[0]; if (t.rawStart >= 0) return M.bytes[t.rawStart]; throw new Error(name + ' 讀不到純量'); }\n\n// 讀一個量化線性層：回傳 {q(uint8 as f64), dims, scale, zp}\nfunction qLinear(M, prefix) {\n    const w = u8Of(M, prefix + '.weight_quantized');\n    return { q: w.data, dims: w.dims, scale: scalarOf(M, prefix + '.weight_scale'), zp: scalarOf(M, prefix + '.weight_zero_point') };\n}\n\nfunction ropeTables(M, T, hd) {\n    const cos = f32Of(M, 'cos_cache'), sin = f32Of(M, 'sin_cache'), half = hd / 2; if (cos.dims[1] !== half) throw new Error('cos_cache 維度不是 head_dim/2');\n    const C = new Float64Array(T * hd), S = new Float64Array(T * hd), R = new Float64Array(hd * hd);\n    for (let t = 0; t < T; t++) for (let i = 0; i < half; i++) { C[t * hd + i] = C[t * hd + half + i] = cos.data[t * half + i]; S[t * hd + i] = S[t * hd + half + i] = sin.data[t * half + i]; }\n    for (let i = 0; i < half; i++) { R[(i + half) * hd + i] = -1; R[i * hd + half + i] = 1; }\n    return { C, S, R };\n}\n\n// 反量化寫成 Cast＋Sub＋Mul：WebGPU 後端的 DequantizeLinear 對 uint8／int8 會算錯（逐算子實測，相對誤差 1e7 倍），而 Cast／Sub／Mul 與 uint8 的 Gather 都正確\nconst dq = (g, x, s, z) => g.mul(g.sub(g.cast(x, 'f32'), z), s);\nconst D = 1024, H = 16, KV = 8, HD = 128, FF = 3072;\n// 共用常數（rope 表、遮罩、純量）\nfunction sharedConsts(g, M, T, rank, alpha) {\n    const { C, S, R } = ropeTables(M, T, HD);\n    const mask = new Float64Array(T * T); for (let i = 0; i < T; i++) for (let j = i + 1; j < T; j++) mask[i * T + j] = -1e9;\n    return { Ct: g.const('rope_c', [T, 1, HD], C), St: g.const('rope_s', [T, 1, HD], S), Rt: g.const('rope_r', [HD, HD], R), maskT: g.const('mask', [T, T], mask), epsT: g.scalar(1e-6), scale: g.scalar(1 / Math.sqrt(HD)), sS: g.scalar((alpha || 2 * rank) / rank) };\n}\nfunction rmsOf(g, M, c, h, gname, dim) { const gain = f32Of(M, gname); if (gain.data.length !== dim) throw new Error(gname + ' 長度不符'); const gt = g.const(gname, [dim], gain.data); const ss = g.reduceMean(g.mul(h, h), [-1], true); return g.mul(g.mul(h, g.recip(g.sqrt(g.add(ss, c.epsT)))), gt); }\n// 加一層（前向）；回傳 {out, k, v}；LoRA 的 A/B 以 'l<層>.<目標>.A|B' 命名並加入 params\nfunction addLayer(g, M, c, layer, x, T, rank, params) {\n    const pre = 'model.layers.' + layer + '.', ln = 'l' + layer + '.';\n    const lin = (key, fname, din, dout, h) => {\n        const ql = qLinear(M, pre + fname + '.MatMul'); if (ql.dims[0] !== din || ql.dims[1] !== dout) throw new Error(fname + ' 形狀不符 ' + ql.dims);\n        const q = g.const(ln + key + '.q', [din, dout], ql.q, 'u8'), sc = g.const(ln + key + '.s', [], Float64Array.of(ql.scale)), zp = g.const(ln + key + '.z', [], Float64Array.of(ql.zp));\n        const W = dq(g, q, sc, zp);\n        const A = g.input(ln + key + '.A', [din, rank], 'f32', true), B = g.input(ln + key + '.B', [rank, dout], 'f32', true); params.push(A, B);\n        return g.add(g.matmul(h, W), g.mul(c.sS, g.matmul(g.matmul(h, A), B)));\n    };\n    const DB = (t) => { if (c.dbgList && layer === 0) c.dbgList.push(g.output(t)); return t; };\n    const rope = (h) => g.add(g.mul(h, c.Ct), g.mul(g.matmul(h, c.Rt), c.St));\n    const n1 = rmsOf(g, M, c, x, pre + 'input_layernorm.weight', D);\n    const q0 = lin('q', 'attn.q_proj', D, H * HD, n1), k0 = lin('k', 'attn.k_proj', D, KV * HD, n1), v0 = lin('v', 'attn.v_proj', D, KV * HD, n1);\n    const q = rope(rmsOf(g, M, c, g.reshape(q0, [T, H, HD]), pre + 'attn.q_norm.layernorm.weight', HD)), k = rope(rmsOf(g, M, c, g.reshape(k0, [T, KV, HD]), pre + 'attn.k_norm.layernorm.weight', HD));\n    const v = g.reshape(v0, [T, KV, HD]); DB(q); DB(v);\n    const rep = (t) => g.reshape(g.expand(g.reshape(g.transpose(t, [1, 0, 2]), [KV, 1, T, HD]), [KV, H / KV, T, HD]), [H, T, HD]);\n    const sc = g.add(g.mul(g.matmul(g.transpose(q, [1, 0, 2]), g.transpose(rep(k), [0, 2, 1])), c.scale), c.maskT);\n    const P = DB(g.softmax(DB(sc), -1)); const ctx = DB(g.reshape(g.transpose(g.matmul(P, DB(rep(v))), [1, 0, 2]), [T, H * HD]));\n    const h1 = DB(g.add(x, DB(lin('o', 'attn.o_proj', H * HD, D, ctx))));\n    const n2 = rmsOf(g, M, c, h1, pre + 'post_attention_layernorm.weight', D);\n    DB(n2); const gg = DB(lin('gate', 'mlp.gate_proj', D, FF, n2)), uu = DB(lin('up', 'mlp.up_proj', D, FF, n2));\n    const out = g.add(h1, lin('down', 'mlp.down_proj', FF, D, g.mul(g.mul(gg, g.sigmoid(gg)), uu)));\n    return { out, k, v };\n}\n// 單一區塊（對拍用）：輸入 x [T,d]；loss = mean(out ⊙ probe)\nfunction buildBlock(M, layer, T, rank, probe, opts) {\n    opts = opts || {}; const g = new Gm.G(); const x = g.input('x', [T, D]); const c = sharedConsts(g, M, T, rank, opts.alpha); const params = [];\n    const L = addLayer(g, M, c, layer, x, T, rank, params); g.output(L.k); g.output(L.v);\n    const loss = g.reduceMean(g.mul(L.out, g.const('probe', [T, D], probe)), [0, 1], false); g.output(loss);\n    return { g, loss, params, k: L.k, v: L.v, out: L.out };\n}\n// 全模型：token id → 28 層 → 最終 RMSNorm → 綁定嵌入的輸出頭 → 交叉熵（onehot 的整列為 0 代表該位置不計損失）\nfunction buildFull(M, T, rank, opts) {\n    opts = opts || {}; const nl = opts.layers === undefined ? 28 : opts.layers; const g = new Gm.G(); const c = sharedConsts(g, M, T, rank, opts.alpha); const params = [];\n    c.dbgList = opts.debug ? [] : null;\n    const et = initOf(M, 'model.embed_tokens.weight_quantized'); const V = et.dims[0];\n    const embQ = g.const('emb.q', [V, D], M.bytes.subarray(et.rawStart, et.rawEnd), 'u8'), embS = g.scalar(scalarOf(M, 'model.embed_tokens.weight_scale')), embZ = g.const('emb.z', [], Float64Array.of(scalarOf(M, 'model.embed_tokens.weight_zero_point')));\n    const ids = g.input('ids', [T], 'i64'); const rowmask = g.input('rowmask', [T]);   // rowmask[t] = 該位置權重（1/有效位置數；0＝不計損失）\n    let h = opts.hostEmbed ? g.input('x', [T, D]) : dq(g, g.gather(embQ, ids), embS, embZ);   // hostEmbed：嵌入查表在圖外做（WebGPU 後端的 uint8 Gather 實測會輸出全 0）\n    const dbg = c.dbgList || []; if (opts.debug) dbg.push(g.output(h));\n    for (let l = 0; l < nl; l++) { const L = addLayer(g, M, c, l, h, T, rank, params); h = L.out; if (opts.debug) { dbg.push(g.output(L.k)); dbg.push(g.output(L.out)); } }\n    const nf = rmsOf(g, M, c, h, 'model.layers.28.final_norm_layernorm.weight', D);\n    // 輸出頭分塊：詞表切成 C 塊（列連續，零拷貝切片），任何時刻只展開 1/C 的 fp32 權重；\n    // loss_t = log Σ_c Σ_j exp(logit) − logit[target]（不減最大值：綁定嵌入的 logit 實測在數十以內，f32 的 exp 上限約 88；超過會變 inf，由呼叫端的 loss 檢查攔下）\n    const C = opts.headChunks || 8; if (V % C) throw new Error('詞表大小不能被分塊數整除'); const Vc = V / C; let Z = null, TL = null;\n    for (let k = 0; k < C; k++) {\n        const cq = g.const('head.q' + k, [Vc, D], M.bytes.subarray(et.rawStart + k * Vc * D, et.rawStart + (k + 1) * Vc * D), 'u8'); const oh = g.input('onehot' + k, [T, Vc]);\n        const lg = g.matmul(nf, dq(g, g.transpose(cq, [1, 0]), embS, embZ));\n        if (opts.debug && k === 0) { dbg.push(g.output(nf)); dbg.push(g.output(lg)); }\n        const z = g.reduceSum(g.exp(lg), [1], false), tl = g.reduceSum(g.mul(lg, oh), [1], false);\n        Z = Z ? g.add(Z, z) : z; TL = TL ? g.add(TL, tl) : tl;\n    }\n    const loss = g.reduceSum(g.mul(g.sub(g.log(Z), TL), rowmask), [0], false); g.output(loss);\n    return { g, loss, params, V, C, Vc, dbg: dbg.map((t) => t.name) };\n}\n\n// 把 token id 經量化嵌入表取成 float 隱藏狀態 [T,d]\nfunction embed(M, ids) { const t = initOf(M, 'model.embed_tokens.weight_quantized'); if (t.dataType !== 2 || t.rawStart < 0) throw new Error('嵌入表不是 raw uint8'); const sc = scalarOf(M, 'model.embed_tokens.weight_scale'), zp = scalarOf(M, 'model.embed_tokens.weight_zero_point'); const d = t.dims[1]; const o = new Float64Array(ids.length * d); ids.forEach((id, i) => { for (let j = 0; j < d; j++) o[i * d + j] = (M.bytes[t.rawStart + id * d + j] - zp) * sc; }); return o; }\n\n// ───────── 逐層圖（網頁版逐層訓練用）─────────\n// 前向圖 F：x、本層 LoRA 參數 → y；\n// 反向圖 B：x、dy、本層 LoRA 參數 → y（前向重算，等於 activation checkpointing）、dx、本層 14 個梯度；\n// 頭部圖：h → loss、dh。每張圖只含一層的權重（約 15MB），所以任何時刻 WASM 記憶體都遠低於 4GB。\nfunction layerParamNames(layer) { const o = []; for (const k of ['q', 'k', 'v', 'o', 'gate', 'up', 'down']) { o.push('l' + layer + '.' + k + '.A', 'l' + layer + '.' + k + '.B'); } return o; }\nfunction buildLayerF(M, layer, T, rank, opts) {\n    opts = opts || {}; const g = new Gm.G(); const x = g.input('x', [T, D]); const c = sharedConsts(g, M, T, rank, opts.alpha); const params = [];\n    const L = addLayer(g, M, c, layer, x, T, rank, params); g.output(L.out); return { g, params, out: L.out };\n}\nfunction buildLayerB(M, layer, T, rank, opts) {\n    opts = opts || {}; const g = new Gm.G(); const x = g.input('x', [T, D]); const dy = g.input('dy', [T, D]); const c = sharedConsts(g, M, T, rank, opts.alpha); const params = [];\n    const L = addLayer(g, M, c, layer, x, T, rank, params);\n    const gr = Gm.grad(g, L.out, ['x'].concat(params.map((p) => p.name)), dy);\n    g.output(gr.get('x')); const names = params.map((p) => { g.output(gr.get(p.name)); return p.name; });\n    return { g, params, dx: gr.get('x'), gradNames: names, gradOuts: params.map((p) => gr.get(p.name).name) };\n}\nfunction buildHead(M, T, opts) {\n    opts = opts || {}; const g = new Gm.G(); const h = g.input('h', [T, D]); const c = sharedConsts(g, M, T, 1, opts.alpha); const chunks = opts.headChunks || 8;\n    const et = initOf(M, 'model.embed_tokens.weight_quantized'); const V = et.dims[0], Vc = V / chunks; if (V % chunks) throw new Error('詞表大小不能被分塊數整除');\n    const embS = g.scalar(scalarOf(M, 'model.embed_tokens.weight_scale')), embZ = g.const('emb.z', [], Float64Array.of(scalarOf(M, 'model.embed_tokens.weight_zero_point')));\n    const rowmask = g.input('rowmask', [T]); const nf = rmsOf(g, M, c, h, 'model.layers.28.final_norm_layernorm.weight', D); let Z = null, TL = null;\n    for (let k = 0; k < chunks; k++) {\n        const cq = g.const('head.q' + k, [Vc, D], M.bytes.subarray(et.rawStart + k * Vc * D, et.rawStart + (k + 1) * Vc * D), 'u8'); const oh = g.input('onehot' + k, [T, Vc]);\n        const lg = g.matmul(nf, dq(g, g.transpose(cq, [1, 0]), embS, embZ)); const z = g.reduceSum(g.exp(lg), [1], false), tl = g.reduceSum(g.mul(lg, oh), [1], false);\n        Z = Z ? g.add(Z, z) : z; TL = TL ? g.add(TL, tl) : tl;\n    }\n    const loss = g.reduceSum(g.mul(g.sub(g.log(Z), TL), rowmask), [0], false);\n    const gr = Gm.grad(g, loss, ['h']); g.output(loss); g.output(gr.get('h'));\n    return { g, loss, dh: gr.get('h'), V, Vc, chunks };\n}\n\nmodule.exports = { layerParamNames, buildLayerF, buildLayerB, buildHead, openModel, buildBlock, buildFull, embed, f32Of, scalarOf, ropeTables };\n\n};\nMODS[\"qwen3_layered_engine\"] = function (module, exports, require) {\n/* 網頁版逐層 LoRA 訓練引擎（DESIGN.TODO.offline-training-studio.md §5.6）。\n *  為什麼逐層：整個 28 層訓練圖放進一個 onnxruntime-web 工作階段時，WASM 的 32 位元位址空間（4GB）會被「模型複本＋常數折疊＋激活」吃滿；\n *  逐層則任何時刻只有一層的權重（約 15MB）在算，激活只留每層的輸入（activation checkpointing，反向時在反向圖裡重算本層前向）。\n *  一步 = 嵌入（圖外）→ 28 次前向圖 F → 頭部圖 H（loss、dh）→ 28 次反向圖 B（dx、本層 14 個梯度）→ 圖外 Adam。\n *  依賴注入：ort（onnxruntime-web 模組）、模型位元組由 qwen3_graph.openModel 提供。後端 ep 可選 'wasm' 或 'webgpu'。\n *  這裡不含檔案系統／IndexedDB；層圖的位元組來源 layerSource 可替換（預設即時由模型建圖；交換空間版從 IndexedDB 取）。 */\n'use strict';\nconst Gm = require('./onnx_grad_core.js');\nconst Q = require('./qwen3_graph.js');\n\nfunction randnFn(seed) { let s = seed >>> 0 || 1; const u = () => { s ^= s << 13; s >>>= 0; s ^= s >> 17; s ^= s << 5; s >>>= 0; return s / 4294967296; }; return () => Math.sqrt(-2 * Math.log(u() + 1e-12)) * Math.cos(2 * Math.PI * u()); }\nconst DIMS = { q: [1024, 2048], k: [1024, 1024], v: [1024, 1024], o: [2048, 1024], gate: [1024, 3072], up: [1024, 3072], down: [3072, 1024] };\n\nclass LayeredEngine {\n    constructor(o) {\n        this.ort = o.ort; this.ep = o.ep || 'wasm'; this.M = o.M; this.T = o.T; this.rank = o.rank; this.layers = o.layers === undefined ? 28 : o.layers; this.chunks = o.headChunks || 8;\n        this.graphOpt = o.graphOpt || (this.ep === 'webgpu' ? 'basic' : 'disabled');   // WebGPU 後端在最佳化全關時會算錯（逐算子實測），WASM 要關掉常數折疊以免 fp32 權重複本\n        this.lr = o.lr === undefined ? 0.001 : o.lr; this.b1 = 0.9; this.b2 = 0.999; this.eps = 1e-8;\n        this.keep = o.keepSessions !== false; this.sess = new Map(); this.layerSource = o.layerSource || null; this.stats = { created: 0, runMs: 0, createMs: 0 };\n        this.V = this.M.ix.inits.get('model.embed_tokens.weight_quantized').dims[0]; this.Vc = this.V / this.chunks; this.phase = ''; this.params = new Map(); this.m = new Map(); this.v = new Map(); this.t = 0; this.shapes = new Map();\n        for (let l = 0; l < this.layers; l++) for (const k of Object.keys(DIMS)) { const [din, dout] = DIMS[k]; this.shapes.set('l' + l + '.' + k + '.A', [din, this.rank]); this.shapes.set('l' + l + '.' + k + '.B', [this.rank, dout]); }\n    }\n    // 初始化：A 為 N(0,1/din)，B 為 0；也可傳入 Map<name, Float32Array>（續訓／與別的實作對拍）\n    initParams(init, seed) {\n        const rn = randnFn(seed || 7);\n        for (const [name, shape] of this.shapes) {\n            const n = shape[0] * shape[1]; let a;\n            if (init && init.has(name)) { a = Float32Array.from(init.get(name)); if (a.length !== n) throw new Error('初始值大小不符：' + name); }\n            else { a = new Float32Array(n); if (/\\.A$/.test(name)) { const sd = 1 / Math.sqrt(shape[0]); for (let i = 0; i < n; i++) a[i] = rn() * sd; } }\n            this.params.set(name, a); this.m.set(name, new Float32Array(n)); this.v.set(name, new Float32Array(n));\n        }\n        this.t = 0;\n    }\n    async _session(kind, layer) {\n        const key = kind + layer; if (this.sess.has(key)) return this.sess.get(key);\n        const t0 = Date.now(); let bytes;\n        if (this.layerSource) bytes = await this.layerSource(kind, layer);\n        else { const b = kind === 'F' ? Q.buildLayerF(this.M, layer, this.T, this.rank) : kind === 'B' ? Q.buildLayerB(this.M, layer, this.T, this.rank) : Q.buildHead(this.M, this.T, { headChunks: this.chunks }); bytes = Gm.toOnnx(b.g, { name: key }); }\n        const s = await this.ort.InferenceSession.create(bytes, { executionProviders: [this.ep], graphOptimizationLevel: this.graphOpt, logSeverityLevel: 3 });\n        this.stats.created++; this.stats.createMs += Date.now() - t0;\n        if (this.keep) this.sess.set(key, s);\n        return s;\n    }\n    _layerFeeds(layer, feeds) { for (const k of Object.keys(DIMS)) for (const w of ['A', 'B']) { const name = 'l' + layer + '.' + k + '.' + w; feeds[name] = new this.ort.Tensor('float32', this.params.get(name), this.shapes.get(name)); } return feeds; }\n    async _release(s) { if (!this.keep && s.release) await s.release(); }\n    async _forward(ids) {\n        const T = this.T, d = 1024; const x0 = Float32Array.from(Q.embed(this.M, ids)); const acts = [x0];\n        for (let l = 0; l < this.layers; l++) {\n            this.phase = '前向 ' + (l + 1) + '/' + this.layers; const s = await this._session('F', l); const t0 = Date.now();\n            const out = await s.run(this._layerFeeds(l, { x: new this.ort.Tensor('float32', acts[l], [T, d]) })); this.stats.runMs += Date.now() - t0;\n            acts.push(Float32Array.from(out[s.outputNames[0]].data)); await this._release(s);\n        }\n        return acts;\n    }\n    async _head(h, tgt, withGrad, mask) {\n        const T = this.T; const s = await this._session('H', 0); const loss = s.outputNames[0], dh = s.outputNames[1], chunks = this.chunks, Vc = this.Vc;   // 輸出順序固定：loss、dh\n        const feeds = { h: new this.ort.Tensor('float32', h, [T, 1024]), rowmask: new this.ort.Tensor('float32', LayeredEngine.rowMask(mask, T), [T]) };\n        for (let k = 0; k < chunks; k++) { const oh = new Float32Array(T * Vc); tgt.forEach((id, t) => { if (id >= k * Vc && id < (k + 1) * Vc) oh[t * Vc + id - k * Vc] = 1; }); feeds['onehot' + k] = new this.ort.Tensor('float32', oh, [T, Vc]); }\n        const t0 = Date.now(); const out = await s.run(feeds); this.stats.runMs += Date.now() - t0; await this._release(s);\n        return { loss: out[loss].data[0], dh: withGrad ? Float32Array.from(out[dh].data) : null };\n    }\n    static rowMask(mask, T) { const r = new Float32Array(T); if (!mask) return r.fill(1 / T); let n = 0; for (let i = 0; i < T; i++) if (mask[i]) n++; if (!n) throw new Error('這一筆沒有任何要算損失的位置（答案 token 為 0）'); for (let i = 0; i < T; i++) r[i] = mask[i] ? 1 / n : 0; return r; }\n    async evalLoss(ids, tgt, mask) { const acts = await this._forward(ids); const r = await this._head(acts[this.layers], tgt, false, mask); return { loss: r.loss }; }\n    // 一個訓練步；回傳 {loss, gradNorm, ms}\n    async step(ids, tgt, lr, mask) {\n        const t0 = Date.now(); const T = this.T, d = 1024; const acts = await this._forward(ids); const hd = await this._head(acts[this.layers], tgt, true, mask);\n        let dh = hd.dh; this.t++; const lr_ = lr === undefined ? this.lr : lr; const c1 = 1 - Math.pow(this.b1, this.t), c2 = 1 - Math.pow(this.b2, this.t); let gn = 0;\n        for (let l = this.layers - 1; l >= 0; l--) {\n            this.phase = '反向 ' + (this.layers - l) + '/' + this.layers; const s = await this._session('B', l); const t1 = Date.now();\n            const out = await s.run(this._layerFeeds(l, { x: new this.ort.Tensor('float32', acts[l], [T, d]), dy: new this.ort.Tensor('float32', dh, [T, d]) })); this.stats.runMs += Date.now() - t1;\n            const names = Q.layerParamNames(l), dx = s.outputNames[0];   // 輸出順序固定：dx，然後本層 14 個梯度（q,k,v,o,gate,up,down 各 A、B）\n            names.forEach((name, i) => {\n                const g = out[s.outputNames[1 + i]].data, p = this.params.get(name), m = this.m.get(name), v = this.v.get(name);\n                for (let j = 0; j < p.length; j++) { const gj = g[j]; gn += gj * gj; m[j] = this.b1 * m[j] + (1 - this.b1) * gj; v[j] = this.b2 * v[j] + (1 - this.b2) * gj * gj; p[j] -= lr_ * (m[j] / c1) / (Math.sqrt(v[j] / c2) + this.eps); }\n            });\n            dh = Float32Array.from(out[dx].data); await this._release(s);\n        }\n        return { loss: hd.loss, gradNorm: Math.sqrt(gn), ms: Date.now() - t0 };\n    }\n    // 取出／放回完整訓練狀態（供規範化檢查點）\n    exportState() { return { t: this.t, shapes: this.shapes, params: this.params, m: this.m, v: this.v }; }\n    importState(st) { for (const [k, a] of st.params) { this.params.get(k).set(a); this.m.get(k).set(st.m.get(k)); this.v.get(k).set(st.v.get(k)); } this.t = st.t; }\n    async dispose() { for (const s of this.sess.values()) if (s.release) await s.release(); this.sess.clear(); }\n}\n\nmodule.exports = { LayeredEngine, DIMS };\n\n};\nMODS[\"swap_store\"] = function (module, exports, require) {\n'use strict';\n/* 訓練交換空間（網頁版逐層訓練用，DESIGN.TODO.offline-training-studio.md §5.6）。\n *  為什麼要有：WebAssembly 只有 4GB 位址空間；逐層引擎把每層的圖（含該層凍結權重，約 15MB）存在這裡，\n *  需要時才取出建立工作階段，用完釋放，所以 WASM 記憶體只需容納「一層」。\n *  和 aiDoc 的 FileCache／KVStore 不同的地方（刻意）：\n *   - 專屬資料庫與物件庫（fa-train-swap），不和專案索引共用；\n *   - 沒有 LRU 淘汰：訓練中的層圖被悄悄淘汰會讓訓練在下一步失敗或用錯權重；\n *   - 有明確配額，超過就丟 SwapFullError（帶用量與配額）並停止，不靜默遺失；\n *   - 每筆記錄帶長度與 FNV-1a 校驗，讀回不符就丟 SwapCorruptError。\n *  後端：createIdbSwap({indexedDB, quotaBytes})（瀏覽器）與 createMemorySwap({quotaBytes})（測試／無 IndexedDB 時）。 */\n\nclass SwapFullError extends Error { constructor(used, add, quota) { super('交換空間已滿：已用 ' + mb(used) + '，要再存 ' + mb(add) + '，配額 ' + mb(quota) + '。訓練已停止（不會悄悄淘汰舊資料）；請調大配額或清理交換空間'); this.name = 'SwapFullError'; this.used = used; this.add = add; this.quota = quota; } }\nclass SwapCorruptError extends Error { constructor(key) { super('交換空間資料損毀：' + key + '（長度或校驗不符），請清理後重建'); this.name = 'SwapCorruptError'; this.key = key; } }\nconst mb = (x) => (x >= 1048576 ? (x / 1048576).toFixed(0) + 'MB' : (x / 1024).toFixed(0) + 'KB');\nfunction fnv1a(u8) { let h = 0x811c9dc5; const step = u8.length > 4194304 ? 17 : 1; for (let i = 0; i < u8.length; i += step) { h ^= u8[i]; h = Math.imul(h, 0x01000193) >>> 0; } return (h ^ u8.length) >>> 0; }   // 大檔抽樣校驗（每 17 位元組取 1），小檔全檢；目的是抓截斷與寫壞，不是密碼學\n\nfunction createMemorySwap(o) {\n    o = o || {}; const quota = o.quotaBytes || 4 * 1073741824, m = new Map(); let used = 0; const stats = { puts: 0, gets: 0, deletes: 0, putMs: 0, getMs: 0 };\n    return {\n        kind: 'memory', stats, quota,\n        async put(key, u8) { const t0 = Date.now(); const old = m.get(key); const delta = u8.length - (old ? old.u8.length : 0); if (used + delta > quota) throw new SwapFullError(used, delta, quota); m.set(key, { u8: Uint8Array.from(u8), sum: fnv1a(u8) }); used += delta; stats.puts++; stats.putMs += Date.now() - t0; },\n        async get(key) { const t0 = Date.now(); const r = m.get(key); stats.gets++; stats.getMs += Date.now() - t0; if (!r) return null; if (fnv1a(r.u8) !== r.sum) throw new SwapCorruptError(key); return r.u8; },\n        async has(key) { return m.has(key); },\n        async delete(key) { const r = m.get(key); if (r) { used -= r.u8.length; m.delete(key); stats.deletes++; } },\n        async clear() { m.clear(); used = 0; }, async usage() { return { used, quota, count: m.size }; },\n        _corrupt(key) { const r = m.get(key); if (r) r.u8[0] ^= 1; },\n    };\n}\n\nfunction createIdbSwap(o) {\n    o = o || {}; const idb = o.indexedDB || (typeof indexedDB !== 'undefined' ? indexedDB : null); if (!idb) throw new Error('這個環境沒有 IndexedDB'); const quota = o.quotaBytes || 4 * 1073741824; const dbName = o.dbName || 'fa-train-swap', store = 'blobs', meta = 'meta';\n    const stats = { puts: 0, gets: 0, deletes: 0, putMs: 0, getMs: 0 }; let dbp = null;\n    const open = () => dbp || (dbp = new Promise((res, rej) => { const r = idb.open(dbName, 1); r.onupgradeneeded = () => { const d = r.result; d.createObjectStore(store); d.createObjectStore(meta); }; r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); }));\n    const tx = async (names, mode, fn) => { const db = await open(); return new Promise((res, rej) => { const t = db.transaction(names, mode); let out; t.oncomplete = () => res(out); t.onerror = () => rej(t.error); t.onabort = () => rej(t.error || new Error('交易中止')); out = fn(t); }); };\n    const req = (r) => new Promise((res, rej) => { r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); });\n    async function index() { const db = await open(); return new Promise((res, rej) => { const t = db.transaction([meta], 'readonly'); const r = t.objectStore(meta).getAll(); const k = t.objectStore(meta).getAllKeys(); t.oncomplete = () => { const o2 = {}; k.result.forEach((kk, i) => { o2[kk] = r.result[i]; }); res(o2); }; t.onerror = () => rej(t.error); }); }\n    return {\n        kind: 'indexeddb', stats, quota,\n        async put(key, u8) {\n            const t0 = Date.now(); const idx = await index(); let used = 0; for (const k of Object.keys(idx)) used += idx[k].len; const old = idx[key] ? idx[key].len : 0; const delta = u8.length - old;\n            if (used + delta > quota) throw new SwapFullError(used, delta, quota);\n            const sum = fnv1a(u8); const copy = u8.buffer && u8.byteOffset === 0 && u8.byteLength === u8.buffer.byteLength ? u8 : Uint8Array.from(u8);\n            await tx([store, meta], 'readwrite', (t) => { t.objectStore(store).put(copy, key); t.objectStore(meta).put({ len: u8.length, sum }, key); });\n            stats.puts++; stats.putMs += Date.now() - t0;\n        },\n        async get(key) {\n            const t0 = Date.now(); const db = await open(); const [data, m] = await new Promise((res, rej) => { const t = db.transaction([store, meta], 'readonly'); const a = t.objectStore(store).get(key), b = t.objectStore(meta).get(key); t.oncomplete = () => res([a.result, b.result]); t.onerror = () => rej(t.error); });\n            stats.gets++; stats.getMs += Date.now() - t0; if (!data) return null;\n            const u8 = data instanceof Uint8Array ? data : new Uint8Array(data); if (!m || u8.length !== m.len || fnv1a(u8) !== m.sum) throw new SwapCorruptError(key); return u8;\n        },\n        async has(key) { const idx = await index(); return !!idx[key]; },\n        async delete(key) { await tx([store, meta], 'readwrite', (t) => { t.objectStore(store).delete(key); t.objectStore(meta).delete(key); }); stats.deletes++; },\n        async clear() { await tx([store, meta], 'readwrite', (t) => { t.objectStore(store).clear(); t.objectStore(meta).clear(); }); },\n        async usage() { const idx = await index(); let used = 0, count = 0; for (const k of Object.keys(idx)) { used += idx[k].len; count++; } return { used, quota, count }; },\n        close() { if (dbp) dbp.then((d) => d.close()); dbp = null; },\n    };\n}\n\n// 逐層引擎的 layerSource：第一次建圖並存入交換空間，之後直接從交換空間取位元組（不再讀 0.6B 模型、不再建圖）\nfunction createSwapLayerSource(store, buildBytes, keyPrefix) {\n    return async function layerSource(kind, layer) {\n        const key = (keyPrefix || '') + kind + layer; let b = await store.get(key);\n        if (!b) { b = await buildBytes(kind, layer); await store.put(key, b); }\n        return b;\n    };\n}\n\nmodule.exports = { SwapFullError, SwapCorruptError, fnv1a, createMemorySwap, createIdbSwap, createSwapLayerSource };\n\n};\nMODS[\"checkpoint_core\"] = function (module, exports, require) {\n'use strict';\n// 規範化 float32 檢查點（DESIGN.TODO.offline-training-studio.md §3.1）：與後端無關的暫停／續訓格式。\n// 純核心、不碰 window／檔案系統：檔案以 { 檔名: Buffer } 表示，由呼叫端決定存到記憶體或資料夾。\n// 瀏覽器可用：不再硬依賴 Node 的 crypto／Buffer（網頁版 wasm-web 後端要在頁面內存取檢查點）。Node 下仍優先用 crypto 與 Buffer，行為不變。\nlet crypto = null; try { crypto = require('crypto'); } catch (e) { crypto = null; }\nlet Asset = null; try { Asset = require('./asset_core.js'); } catch (e) { Asset = null; }   // 只有沒有 Node crypto 時（瀏覽器）才用它的純 JS sha256；主行程嵌入版可以沒有這個檔\nconst hasBuf = typeof Buffer !== 'undefined';\nconst newBytes = (n) => (hasBuf ? Buffer.alloc(n) : new Uint8Array(n));\nconst u8of = (x) => (x instanceof Uint8Array ? x : new Uint8Array(x));\nconst textBytes = (str) => (hasBuf ? Buffer.from(str, 'utf8') : new TextEncoder().encode(str));\n\nconst FORMAT = 'fa-ckpt', VERSION = 1;\nconst TENSOR_FILES = ['lora_A.f32', 'lora_B.f32', 'opt_m.f32', 'opt_v.f32'];\n// 續訓相容欄位：任一不符就拒絕續訓、提示以新資產 fork（後端與裝置不在其中，允許不同，只記錄）\nconst COMPAT_FIELDS = ['base', 'base_sha256', 'rank', 'alpha', 'target_modules', 'prompt_format_version', 'tool_catalog_sha256'];\nconst TOL = { sameBackend: 1e-5, crossBackend: 0.02, crossBackendFp16: 0.05 };\n\nconst sha256 = (buf) => (crypto && crypto.createHash ? crypto.createHash('sha256').update(buf).digest('hex') : (function () { if (!Asset) throw new Error('沒有可用的 sha256（需要 Node crypto 或 asset_core.js）'); return Asset.sha256Hex(u8of(buf)); })());\n\n// ---- 與後端無關的亂數：PCG32（標準 XSH-RR 輸出，64 位元狀態用 BigInt） ----\nconst M64 = (1n << 64n) - 1n, MULT = 6364136223846793005n;\nclass PCG32 {\n  constructor(seed, seq) {\n    this.inc = ((BigInt(seq === undefined ? 54 : seq) << 1n) | 1n) & M64; this.state = 0n; this._adv();\n    this.state = (this.state + BigInt.asUintN(64, BigInt(seed))) & M64; this._adv();\n  }\n  _adv() { this.state = (this.state * MULT + this.inc) & M64; }\n  nextU32() {\n    const old = this.state; this._adv();\n    const xs = Number((((old >> 18n) ^ old) >> 27n) & 0xffffffffn), rot = Number(old >> 59n);\n    return ((xs >>> rot) | (xs << ((32 - rot) & 31))) >>> 0;\n  }\n  nextFloat() { return this.nextU32() / 4294967296; }                       // [0,1)\n  nextBelow(n) { const th = (4294967296 - n) % n; for (;;) { const r = this.nextU32(); if (r >= th) return r % n; } }   // 無偏差\n  nextNormal() { const u = this.nextFloat() || 1e-12, v = this.nextFloat(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); }\n  snapshot() { return { algo: 'pcg32', state: this.state.toString(), inc: this.inc.toString() }; }\n  static fromSnapshot(s) { const g = new PCG32(0, 0); g.state = BigInt(s.state); g.inc = BigInt(s.inc); return g; }\n}\nfunction shuffleIndices(n, seed) {\n  const a = Array.from({ length: n }, (_, i) => i), g = new PCG32(seed, 7);\n  for (let i = n - 1; i > 0; i--) { const j = g.nextBelow(i + 1); const t = a[i]; a[i] = a[j]; a[j] = t; }\n  return a;\n}\n\n// ---- 資料游標：順序由 order_seed＋epoch 決定，可重現 ----\nfunction createCursor(orderSeed) { return { shard: 0, offset: 0, order_seed: orderSeed, epoch: 0, consumed_tokens: 0 }; }\nfunction nextIndices(cursor, n, batchSize) {      // 回傳 {indices, cursor}（不改原物件）\n  const c = Object.assign({}, cursor), out = [];\n  let order = shuffleIndices(n, c.order_seed + c.epoch * 1000003);\n  for (let k = 0; k < batchSize; k++) {\n    if (c.offset >= n) { c.epoch++; c.offset = 0; order = shuffleIndices(n, c.order_seed + c.epoch * 1000003); }\n    out.push(order[c.offset++]);\n  }\n  return { indices: out, cursor: c };\n}\n\n// ---- 張量檔：4 位元組小端檔頭長度＋JSON 檔頭（依名稱排序的 shape 表）＋小端 float32 資料 ----\nfunction encodeTensors(list) {\n  const sorted = list.slice().sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));\n  let off = 0;\n  const meta = sorted.map((t) => { const len = t.data.length, m = { name: t.name, shape: t.shape || [len], offset: off, length: len }; off += len; return m; });\n  const head = textBytes(JSON.stringify({ format: 'fa-f32', tensors: meta }));\n  const out = newBytes(4 + head.length + off * 4); const dv = new DataView(out.buffer, out.byteOffset, out.byteLength); dv.setUint32(0, head.length, true); out.set(head, 4);\n  let p = 4 + head.length; sorted.forEach((t) => { for (let i = 0; i < t.data.length; i++) { dv.setFloat32(p, t.data[i], true); p += 4; } });\n  return out;\n}\nfunction decodeTensors(buf) {\n  const u = u8of(buf), dv = new DataView(u.buffer, u.byteOffset, u.byteLength);\n  const hl = dv.getUint32(0, true), head = JSON.parse(new TextDecoder('utf-8').decode(u.subarray(4, 4 + hl))), base = 4 + hl;\n  if (head.format !== 'fa-f32') throw new Error('不是 fa-f32 張量檔');\n  return head.tensors.map((m) => { const d = new Float32Array(m.length); for (let i = 0; i < m.length; i++) d[i] = dv.getFloat32(base + (m.offset + i) * 4, true); return { name: m.name, shape: m.shape, data: d }; });\n}\n\n// ---- 組裝／驗證 ----\n// tensors: { 'lora_A.f32': [{name,shape,data}], ... }；缺的檔（例如 cpu-py 拿不到優化器張量）寫進 missing_files，不假裝有\nfunction makeCheckpoint(o) {\n  const files = {}, missing = [];\n  TENSOR_FILES.forEach((f) => { const t = o.tensors && o.tensors[f]; if (t && t.length) files[f] = encodeTensors(t); else missing.push(f); });\n  const sha = {}; Object.keys(files).forEach((f) => { sha[f] = sha256(files[f]); });\n  const ckpt = {\n    format: FORMAT, version: VERSION, step: o.step, epoch: o.epoch || 0, dtype: 'float32',\n    cursor: o.cursor, rng: o.rng, optimizer: o.optimizer, data_sha256: o.data_sha256, compat: o.compat,\n    produced_by: o.produced_by, loss_tail: (o.loss_tail || []).slice(-50), eval_check: o.eval_check || null, sha256: sha, missing_files: missing,\n  };\n  return { ckpt, files };\n}\nfunction verifyChecksums(cp) {\n  const bad = [];\n  Object.keys(cp.ckpt.sha256 || {}).forEach((f) => { if (!cp.files[f]) bad.push(f + '（檔案不見）'); else if (sha256(cp.files[f]) !== cp.ckpt.sha256[f]) bad.push(f + '（sha256 不符）'); });\n  return { ok: bad.length === 0, bad };\n}\nfunction validateCkptJson(c) {\n  const errs = [];\n  if (!c || c.format !== FORMAT) errs.push('format 不是 ' + FORMAT);\n  else if (c.version !== VERSION) errs.push('version ' + c.version + ' 不是 ' + VERSION + '（舊版要先遷移，目前沒有遷移器）');\n  ['step', 'cursor', 'rng', 'optimizer', 'data_sha256', 'compat', 'produced_by'].forEach((k) => { if (c && c[k] === undefined) errs.push('缺欄位 ' + k); });\n  if (c && c.dtype !== 'float32') errs.push('dtype 必須是 float32');\n  if (c && c.rng && c.rng.algo !== 'pcg32') errs.push('rng.algo 必須是 pcg32');\n  return { ok: errs.length === 0, errors: errs };\n}\nconst same = (a, b) => JSON.stringify(a) === JSON.stringify(b);\n// 相容性：不符一律拒絕、提示 fork。cur = { compat, data_sha256, optimizer:{kind} }\nfunction checkCompat(ckpt, cur) {\n  const v = validateCkptJson(ckpt);\n  if (!v.ok) return { ok: false, mismatches: v.errors.map((e) => ({ field: 'format', detail: e })), action: 'reject', message: '檢查點格式不合：' + v.errors.join('；') };\n  const m = [];\n  COMPAT_FIELDS.forEach((f) => { if (!same(ckpt.compat[f], (cur.compat || {})[f])) m.push({ field: 'compat.' + f, checkpoint: ckpt.compat[f], current: (cur.compat || {})[f] }); });\n  if (ckpt.data_sha256 !== cur.data_sha256) m.push({ field: 'data_sha256', checkpoint: ckpt.data_sha256, current: cur.data_sha256 });\n  if ((ckpt.optimizer && ckpt.optimizer.kind) !== (cur.optimizer && cur.optimizer.kind)) m.push({ field: 'optimizer.kind', checkpoint: ckpt.optimizer && ckpt.optimizer.kind, current: cur.optimizer && cur.optimizer.kind });\n  return m.length\n    ? { ok: false, mismatches: m, action: 'fork', message: '相容欄位不符（' + m.map((x) => x.field).join('、') + '）：不能續訓，請以新資產 fork（parent 記來源）' }\n    : { ok: true, mismatches: [], action: 'resume' };\n}\n\n// ---- 數值比對 ----\nconst rel = (a, b) => Math.abs(a - b) / Math.max(Math.abs(b), 1e-12);\nfunction compareLoss(a, b, o) {                       // 跨後端：續訓前以 eval_batch 比對；半精度放寬到 5%\n  o = o || {}; const tol = o.tol !== undefined ? o.tol : (o.fp16 ? TOL.crossBackendFp16 : TOL.crossBackend);\n  const relErr = rel(a, b); return { ok: Number.isFinite(relErr) && relErr <= tol, relErr, tol };\n}\nfunction maxRelDiff(xs, ys) { if (xs.length !== ys.length) return Infinity; let m = 0; for (let i = 0; i < xs.length; i++) m = Math.max(m, rel(xs[i], ys[i])); return m; }\nfunction compareSameBackendRun(xs, ys, tol) { tol = tol === undefined ? TOL.sameBackend : tol; const d = maxRelDiff(xs, ys); return { ok: d <= tol, maxRelErr: d, tol }; }\nfunction trendWarning(lossTail, newLosses) {          // 只警示，不當拒絕條件\n  if (!lossTail || !lossTail.length || !newLosses || !newLosses.length) return { warn: false };\n  const mean = (a) => a.reduce((s, x) => s + x, 0) / a.length, a = mean(lossTail), b = mean(newLosses);\n  return { warn: !(b <= a * 1.5), tailMean: a, newMean: b };\n}\n// 續訓紀錄（§3.1 第 3 點）\nfunction resumeRecord(ckpt, toBackend, evalResult) {\n  return { at: 'resume', from: ckpt.produced_by.backend, to: toBackend, step: ckpt.step, sameBackend: ckpt.produced_by.backend === toBackend, evalCheck: evalResult || null,\n    text: '由 ' + ckpt.produced_by.backend + ' 後端暫停、' + toBackend + ' 後端續訓（step=' + ckpt.step + '）' };\n}\n\nmodule.exports = { FORMAT, VERSION, TENSOR_FILES, COMPAT_FIELDS, TOL, sha256, PCG32, shuffleIndices, createCursor, nextIndices, encodeTensors, decodeTensors, makeCheckpoint, verifyChecksums, validateCkptJson, checkCompat, rel, compareLoss, maxRelDiff, compareSameBackendRun, trendWarning, resumeRecord };\n\n};\nMODS[\"backend_core\"] = function (module, exports, require) {\n'use strict';\n// 運算後端統一介面與登錄表（DESIGN.TODO.offline-training-studio.md §5.3）。純核心、依賴注入、不碰 window。\nconst BACKEND_IDS = ['cpu-js', 'cpu-py', 'wasm-web', 'webgpu', 'directml', 'vulkan'];\nconst SYMBOLIC_KINDS = ['trainer', 'colu', 'uml', 'blockly', 'matrix'];\n// 每個 kind 宣告支援的後端；lora 的清單是「可能」，實際是否點亮由 probe＋基準測試決定。符號式五類只有 cpu-js。\nconst KIND_BACKENDS = { trainer: ['cpu-js'], colu: ['cpu-js'], uml: ['cpu-js'], blockly: ['cpu-js'], matrix: ['cpu-js'], lora: ['cpu-py', 'wasm-web', 'webgpu', 'directml', 'vulkan'] };\n// 「自動」同速（差 <10%）時偏好較成熟者：cpu-py > vulkan > directml > webgpu（cpu-js 只服務符號式，排最前）\nconst MATURITY = ['cpu-js', 'cpu-py', 'wasm-web', 'vulkan', 'directml', 'webgpu'];   // wasm-web：網頁版處理器訓練，慢但正確、可搬檢查點（§5.6）\n\nconst REQUIRED_METHODS = ['probe', 'benchmark', 'init', 'step', 'evalLoss', 'saveCheckpoint', 'loadCheckpoint', 'dispose'];\n\n// probe 結果形狀：不丟例外；available 為 false 時 reason 必須是給使用者看的具體原因\nfunction probeResult(available, reason, device, fingerprint) {\n  const r = { available: !!available, device: device || { name: '' }, fingerprint: fingerprint || {} };\n  if (reason) r.reason = String(reason);\n  return r;\n}\nfunction validateProbeResult(r) {\n  const errs = [];\n  if (!r || typeof r !== 'object') return ['probe 沒回物件'];\n  if (typeof r.available !== 'boolean') errs.push('available 必須是 boolean');\n  if (!r.available && (typeof r.reason !== 'string' || !r.reason)) errs.push('不可用時必須有 reason');\n  if (!r.device || typeof r.device !== 'object') errs.push('缺 device');\n  if (!r.fingerprint || typeof r.fingerprint !== 'object') errs.push('缺 fingerprint');\n  return errs;\n}\n// 介面型別檢查：id 合法、方法齊全；capabilities 標明「逐步呼叫」或「整段子行程」\nfunction validateBackend(b) {\n  const errs = [];\n  if (!b || typeof b !== 'object') return ['不是物件'];\n  if (BACKEND_IDS.indexOf(b.id) < 0) errs.push('id 不在 ' + BACKEND_IDS.join('／'));\n  REQUIRED_METHODS.forEach((m) => { if (typeof b[m] !== 'function') errs.push('缺方法 ' + m); });\n  if (!b.capabilities || typeof b.capabilities.perStep !== 'boolean') errs.push('缺 capabilities.perStep');\n  return errs;\n}\n// 保證 probe 不丟例外（後端自己寫壞時也不拖垮 UI）\nasync function safeProbe(b, ctx) {\n  try { const r = await b.probe(ctx); const e = validateProbeResult(r); return e.length ? probeResult(false, '後端 ' + b.id + ' 的 probe 回傳格式不合：' + e.join('；')) : r; }\n  catch (e) { return probeResult(false, '後端 ' + b.id + ' 的 probe 發生例外：' + (e && e.message || e)); }\n}\n\nclass BackendRegistry {\n  constructor() { this.map = new Map(); }\n  register(b) { const e = validateBackend(b); if (e.length) throw new Error('後端不合介面：' + e.join('；')); this.map.set(b.id, b); return this; }\n  get(id) { return this.map.get(id) || null; }\n  ids() { return Array.from(this.map.keys()); }\n  supportedFor(kind) { return (KIND_BACKENDS[kind] || []).slice(); }\n  // 某 kind 的後端清單（含未登錄者的說明，供 UI 灰掉並顯示原因）\n  async listFor(kind, ctx) {\n    const out = [];\n    for (const id of this.supportedFor(kind)) {\n      const b = this.get(id);\n      if (!b) { out.push({ id, available: false, reason: '後端 ' + id + ' 沒有登錄', probe: null }); continue; }\n      const p = await safeProbe(b, ctx); out.push({ id, available: p.available, reason: p.reason || '', probe: p });\n    }\n    return out;\n  }\n}\nconst isSymbolicKind = (k) => SYMBOLIC_KINDS.indexOf(k) >= 0;\nconst maturityRank = (id) => { const i = MATURITY.indexOf(id); return i < 0 ? 99 : i; };\n\nmodule.exports = { BACKEND_IDS, SYMBOLIC_KINDS, KIND_BACKENDS, MATURITY, REQUIRED_METHODS, probeResult, validateProbeResult, validateBackend, safeProbe, BackendRegistry, isSymbolicKind, maturityRank };\n\n};\nMODS[\"bench_core\"] = function (module, exports, require) {\n'use strict';\n// 基準測試、一致性檢查、結果快取與自動選擇（DESIGN.TODO.offline-training-studio.md §4.1、§5.8）。純核心、依賴注入（時鐘、儲存、記錄都由呼叫端給）。\nlet crypto = null; try { crypto = require('crypto'); } catch (e) { crypto = null; }   // Worker／瀏覽器沒有 Node crypto 時用純 JS 的 FNV 雜湊（只拿來比對指紋是否改變）\nconst B = require('./backend_core.js');\n\n// §5.8 設計初值（階段 2 以真實測量校準後才固定）\nconst BENCH = { warmup: 3, steps: 30, samples: 16, seqLen: 256, batch: 1, deadlineMs: 60000, abortWithinMs: 3000 };\nconst CONSIST = { loss1: 1e-3, gradNorm1: 1e-2, loss30: 0.03, loss30Fp16: 0.05 };\nconst TIE = 0.10;       // 同速：差 <10%\n\n// 基準本身也要遵守「電腦保持可用」：核心數上限 N−1，至少 1\nconst benchThreads = (cores) => Math.max(1, (cores | 0) - 1);\n\nconst rel = (a, b) => Math.abs(a - b) / Math.max(Math.abs(b), 1e-12);\nfunction percentile(sorted, p) { if (!sorted.length) return 0; const i = Math.min(sorted.length - 1, Math.max(0, Math.ceil(p * sorted.length) - 1)); return sorted[i]; }\nconst finite = (x) => typeof x === 'number' && Number.isFinite(x);\n\n// ---- 一致性檢查四項（以參考後端的 trace 為準）----\n// trace = { loss1, gradNorm1, loss30, hasNonFinite }\nfunction consistencyCheck(ref, cand, o) {\n  o = o || {}; const fp16 = !!o.fp16;\n  const items = [\n    { name: '第1步loss', value: rel(cand.loss1, ref.loss1), tol: CONSIST.loss1 },\n    { name: '第1步梯度範數', value: rel(cand.gradNorm1, ref.gradNorm1), tol: CONSIST.gradNorm1 },\n    { name: '30步後loss', value: rel(cand.loss30, ref.loss30), tol: fp16 ? CONSIST.loss30Fp16 : CONSIST.loss30 },\n  ].map((x) => Object.assign(x, { pass: finite(x.value) && x.value <= x.tol }));\n  items.push({ name: '全程無NaN或Inf', value: cand.hasNonFinite ? 1 : 0, tol: 0, pass: !cand.hasNonFinite });\n  const failed = items.filter((x) => !x.pass).map((x) => x.name);\n  return { pass: failed.length === 0, items, failed, fp16, maxRelErr: Math.max(items[0].value, items[1].value), lossDelta: items[2].value };\n}\n\n// ---- 可中斷的逐步基準（perStep 後端共用）----\n// opts: { signal, now(), reference(trace), fp16, isReference, deadlineMs, warmup, steps, tokensPerStep }\n// cfg.makeBatch(i) 給第 i 步的批次（固定種子的 16 筆樣本由呼叫端決定）\nasync function stepBenchmark(backend, cfg, opts) {\n  opts = opts || {}; const now = opts.now || (typeof performance !== 'undefined' ? () => performance.now() : () => Date.now()), signal = opts.signal || null;\n  const warm = opts.warmup === undefined ? BENCH.warmup : opts.warmup, steps = opts.steps === undefined ? BENCH.steps : opts.steps;\n  const deadline = opts.deadlineMs === undefined ? BENCH.deadlineMs : opts.deadlineMs, tokens = opts.tokensPerStep || (BENCH.seqLen * BENCH.batch);\n  const t0 = now(); let abortedAt = null, handle = null, tooSlow = false;\n  let abortReject; const abortP = new Promise((_, rej) => { abortReject = rej; });\n  abortP.catch(() => {});\n  const onAbort = () => { if (abortedAt === null) abortedAt = now(); abortReject(new Error('__aborted__')); };\n  if (signal) { if (signal.aborted) onAbort(); else if (signal.addEventListener) signal.addEventListener('abort', onAbort, { once: true }); }\n  const guard = (p) => Promise.race([Promise.resolve(p), abortP]);       // 單步卡住也能在中斷後立刻返回\n  const times = [], losses = []; let gn1 = null, nonFinite = false, peak = 0, err = null;\n  try {\n    handle = await guard(backend.init(null, Object.assign({}, cfg, { threads: cfg.threads || benchThreads(cfg.cores || 2) })));\n    for (let i = 0; i < warm + steps; i++) {\n      if (abortedAt !== null) break;\n      if (now() - t0 > deadline) { tooSlow = true; break; }\n      const s0 = now(); const r = await guard(backend.step(handle, cfg.makeBatch ? cfg.makeBatch(i) : { index: i })); const dt = now() - s0;\n      if (!finite(r.loss) || (r.gradNorm !== undefined && !finite(r.gradNorm))) nonFinite = true;\n      if (i === 0) gn1 = r.gradNorm;\n      if (i >= warm) { times.push(dt); losses.push(r.loss); }\n      else if (i === 0) losses.unshift(r.loss);   // 第 1 步 loss 放最前面當 loss1（暖機的其餘步不計入速度）\n      if (backend.peakMemBytes) { try { peak = Math.max(peak, backend.peakMemBytes(handle) || 0); } catch (e) {} }\n    }\n  } catch (e) { if (!(e && e.message === '__aborted__')) err = e; }\n  finally {\n    if (signal && signal.removeEventListener) signal.removeEventListener('abort', onAbort);\n    if (handle) { try { await Promise.race([Promise.resolve(backend.dispose(handle)), new Promise((r) => setTimeout(r, 2000))]); } catch (e) {} }\n  }\n  const stoppedAfterMs = abortedAt === null ? null : now() - abortedAt;\n  if (abortedAt !== null) return { ok: false, aborted: true, stoppedAfterMs, elapsedMs: now() - t0, reason: '使用者中斷' };\n  if (err) return { ok: false, error: String(err && err.message || err), reason: '基準測試失敗：' + (err && err.message || err), elapsedMs: now() - t0 };\n  if (tooSlow) return { ok: false, tooSlow: true, reason: '太慢：超過 ' + Math.round(deadline / 1000) + ' 秒仍未跑完 ' + (warm + steps) + ' 步', elapsedMs: now() - t0 };\n  const sorted = times.slice().sort((a, b) => a - b), med = percentile(sorted, 0.5);\n  const trace = { loss1: losses[0], gradNorm1: gn1, loss30: losses[losses.length - 1], hasNonFinite: nonFinite };\n  const res = { ok: true, tokPerSec: med > 0 ? tokens / (med / 1000) : 0, peakMemBytes: peak || null, stepMsP50: med, stepMsP95: percentile(sorted, 0.95), samples: times.length, trace, elapsedMs: now() - t0, threads: cfg.threads || benchThreads(cfg.cores || 2), fp16: !!opts.fp16 };\n  if (opts.isReference) res.numericCheck = { pass: !nonFinite, maxRelErr: 0, lossDelta: 0, reference: true, items: [], failed: nonFinite ? ['全程無NaN或Inf'] : [] };\n  else if (opts.reference) { const c = consistencyCheck(opts.reference, trace, { fp16: opts.fp16 }); res.numericCheck = { pass: c.pass, maxRelErr: c.maxRelErr, lossDelta: c.lossDelta, items: c.items, failed: c.failed }; }\n  else res.numericCheck = { pass: false, maxRelErr: null, lossDelta: null, items: [], failed: ['沒有參考後端的結果可比對'] };\n  return res;\n}\n// 通過門檻：四項全過、沒超時、沒錯誤才算通過（才可被「自動」選用）\nconst benchPassed = (r) => !!(r && r.ok && !r.tooSlow && r.numericCheck && r.numericCheck.pass);\n\n// ---- 快取：以硬體指紋為鍵 ----\nfunction stableStringify(o) { if (o === null || typeof o !== 'object') return JSON.stringify(o); if (Array.isArray(o)) return '[' + o.map(stableStringify).join(',') + ']'; return '{' + Object.keys(o).sort().map((k) => JSON.stringify(k) + ':' + stableStringify(o[k])).join(',') + '}'; }\nconst fnvHex = (s) => { let h1 = 0x811c9dc5, h2 = 0x1000193; for (let i = 0; i < s.length; i++) { h1 = Math.imul(h1 ^ s.charCodeAt(i), 0x01000193) >>> 0; h2 = Math.imul(h2 + s.charCodeAt(i), 0x85ebca6b) >>> 0; } return (h1.toString(16).padStart(8, '0') + h2.toString(16).padStart(8, '0')); };\nconst hashFingerprint = (fp) => (crypto ? crypto.createHash('sha256').update(stableStringify(fp || {})).digest('hex').slice(0, 16) : fnvHex(stableStringify(fp || {})));\nfunction diffFingerprint(a, b) { const keys = new Set(Object.keys(a || {}).concat(Object.keys(b || {}))), out = []; keys.forEach((k) => { if (stableStringify((a || {})[k]) !== stableStringify((b || {})[k])) out.push(k); }); return out; }\n// store: { load() -> obj|null, save(obj) }（可非同步）；沒給就用記憶體\nfunction createBenchCache(store, now) {\n  now = now || (() => Date.now()); let mem = null;\n  const load = async () => { if (mem) return mem; let d = null; try { d = store ? await store.load() : null; } catch (e) {} mem = d && d.version === 1 ? d : { version: 1, entries: {}, latest: {} }; return mem; };\n  const persist = async () => { if (store) try { await store.save(mem); } catch (e) {} };\n  return {\n    // 回傳 {status:'hit'|'stale'|'none', result?, changed?}\n    async lookup(id, fp) {\n      const d = await load(), h = hashFingerprint(fp), e = d.entries[id + '|' + h];\n      if (e) return { status: 'hit', result: e.result, at: e.at };\n      const last = d.latest[id]; return last ? { status: 'stale', changed: diffFingerprint(last.fingerprint, fp), previous: last } : { status: 'none' };\n    },\n    async store(id, fp, result) { const d = await load(), h = hashFingerprint(fp); const slim = Object.assign({}, result); d.entries[id + '|' + h] = { result: slim, at: now(), fingerprint: fp }; d.latest[id] = { hash: h, fingerprint: fp }; await persist(); },\n    async clear() { mem = { version: 1, entries: {}, latest: {} }; await persist(); },\n  };\n}\n\n// ---- 自動選擇 ----\n// o: { kind, registry, cache, ctx(傳給 probe；ctx.modelSha256 併入指紋), pin, skipBench, runBench(id, signal)->結果, signal, log(rec) }\nasync function autoSelect(o) {\n  const log = o.log || (() => {}), events = [];\n  const ev = (rec) => { events.push(rec); log(rec); };\n  if (B.isSymbolicKind(o.kind)) return { chosen: 'cpu-js', order: ['cpu-js'], source: 'symbolic', needsRebench: false, stale: [], events, reason: '符號式訓練只需處理器（cpu-js）' };\n  const ids = o.registry.supportedFor(o.kind), probes = {}, fps = {};\n  for (const id of ids) {\n    const b = o.registry.get(id);\n    probes[id] = b ? await B.safeProbe(b, o.ctx) : B.probeResult(false, '後端 ' + id + ' 沒有登錄');\n    fps[id] = Object.assign({}, probes[id].fingerprint, { model_sha256: (o.ctx && o.ctx.modelSha256) || null, backend: id });\n  }\n  const avail = ids.filter((id) => probes[id].available);\n  // 釘選：不自動換；不可用就停下詢問\n  if (o.pin) {\n    if (probes[o.pin] && probes[o.pin].available) {\n      const c = await o.cache.lookup(o.pin, fps[o.pin]);\n      return { chosen: o.pin, order: [o.pin], pinned: true, stopOnFail: true, source: 'pin', needsRebench: c.status !== 'hit', stale: [], warning: c.status === 'hit' && !benchPassed(c.result) ? '釘選的後端未通過一致性檢查：' + ((c.result.numericCheck && c.result.numericCheck.failed) || [c.result.reason]).join('、') : '', events };\n    }\n    return { chosen: null, order: [], pinned: true, ask: true, source: 'pin', needsRebench: false, stale: [], events, reason: '釘選的後端 ' + o.pin + ' 不可用：' + ((probes[o.pin] && probes[o.pin].reason) || '沒有這個後端') + '；要改用別的後端嗎？' };\n  }\n  if (!avail.length) return { chosen: null, order: [], source: 'none', needsRebench: false, stale: [], events, reason: '沒有可用的後端：' + ids.map((i) => i + '＝' + probes[i].reason).join('；') };\n  const results = {}, stale = []; const missing = [];\n  for (const id of avail) {\n    const c = await o.cache.lookup(id, fps[id]);\n    if (c.status === 'hit') results[id] = c.result;\n    else { missing.push(id); if (c.status === 'stale') { stale.push({ id, changed: c.changed }); ev({ at: 'cache_stale', backend: id, changed: c.changed, text: id + ' 的硬體指紋改變（' + c.changed.join('、') + '），快取失效，需重新跑基準測試' }); } }\n  }\n  let source = missing.length ? 'benchmark' : 'cache';\n  if (missing.length && o.skipBench) {\n    // 略過基準：用 cpu-py（沒有就停下詢問，不拿未驗證的後端硬上）\n    ev({ at: 'bench_skipped', text: '略過基準測試，使用 cpu-py' });\n    if (probes['cpu-py'] && probes['cpu-py'].available) return { chosen: 'cpu-py', order: ['cpu-py'], source: 'skip-bench', needsRebench: true, stale, events };\n    return { chosen: null, order: [], ask: true, source: 'skip-bench', needsRebench: true, stale, events, reason: '略過基準測試時預設用 cpu-py，但它不可用：' + probes['cpu-py'].reason };\n  }\n  for (const id of missing) {\n    if (o.signal && o.signal.aborted) { ev({ at: 'bench_aborted', backend: id, text: '基準測試被中斷' }); return { chosen: null, order: [], aborted: true, source: 'benchmark', needsRebench: true, stale, events, reason: '基準測試被使用者中斷' }; }\n    let r; try { r = await o.runBench(id, o.signal); } catch (e) { r = { ok: false, error: String(e && e.message || e), reason: '基準測試丟出例外：' + (e && e.message || e) }; }\n    if (r && r.aborted) { ev({ at: 'bench_aborted', backend: id, text: '基準測試被中斷' }); return { chosen: null, order: [], aborted: true, source: 'benchmark', needsRebench: true, stale, events, reason: '基準測試被使用者中斷' }; }\n    if (!benchPassed(r)) ev({ at: 'bench_failed', backend: id, text: id + ' 基準測試未通過：' + (r && (r.reason || (r.numericCheck && r.numericCheck.failed && r.numericCheck.failed.join('、'))) || '未知原因') });\n    results[id] = r; await o.cache.store(id, fps[id], r);\n  }\n  const cands = avail.filter((id) => benchPassed(results[id]));\n  if (!cands.length) return { chosen: null, order: [], source, needsRebench: false, stale, events, reason: '可用的後端都沒通過基準測試／一致性檢查：' + avail.map((i) => i + '＝' + ((results[i] && (results[i].reason || (results[i].numericCheck && results[i].numericCheck.failed.join('、')))) || '無結果')).join('；') };\n  const speed = (id) => results[id].tokPerSec || 0, top = Math.max.apply(null, cands.map(speed));\n  const cmp = (a, b) => { const na = speed(a) >= top * (1 - TIE), nb = speed(b) >= top * (1 - TIE); if (na && nb) return B.maturityRank(a) - B.maturityRank(b) || speed(b) - speed(a); if (na !== nb) return na ? -1 : 1; return speed(b) - speed(a); };\n  const order = cands.slice().sort(cmp);\n  return { chosen: order[0], order, source, needsRebench: false, stale, events, table: avail.map((id) => ({ id, result: results[id], passed: benchPassed(results[id]) })) };\n}\n\n// ---- 失敗自動降級（訓練中後端失敗：已存檢查點，換下一個候選）----\nfunction degrade(o) {   // o: { order, failed, step, reason, pinned, log }\n  const log = o.log || (() => {});\n  if (o.pinned) { const m = '釘選的後端 ' + o.failed + ' 失敗（' + o.reason + '，step=' + o.step + '），已停下；要換成別的後端嗎？'; log({ at: 'pinned_failed', backend: o.failed, step: o.step, reason: o.reason, text: m }); return { stop: true, ask: m }; }\n  const rest = (o.order || []).filter((x) => x !== o.failed), to = rest[0];\n  if (!to) { const m = '後端 ' + o.failed + ' 失敗（' + o.reason + '，step=' + o.step + '），沒有可降級的候選'; log({ at: 'degrade_none', backend: o.failed, step: o.step, reason: o.reason, text: m }); return { stop: true, message: m }; }\n  const text = '由 ' + o.failed + ' 後端失敗降級到 ' + to + '，原因：' + o.reason + '，降級時 step=' + o.step;\n  log({ at: 'degrade', from: o.failed, to, step: o.step, reason: o.reason, text });\n  return { stop: false, to, order: rest, message: text, needsCrossBackendCheck: true };\n}\n\nmodule.exports = { BENCH, CONSIST, TIE, benchThreads, percentile, consistencyCheck, stepBenchmark, benchPassed, stableStringify, hashFingerprint, diffFingerprint, createBenchCache, autoSelect, degrade };\n\n};\nMODS[\"backend_wasm_web\"] = function (module, exports, require) {\n'use strict';\n// wasm-web 後端：網頁版（也可用於桌面版渲染行程）的 WebAssembly 處理器 LoRA 訓練（DESIGN.TODO.offline-training-studio.md §5.6）。\n// 真引擎是 qwen3_layered_engine.js（逐層圖＋onnxruntime-web）；本檔只做「後端介面」與「規範化 float32 檢查點」的轉接，\n// 所以能暫停 → 匯出 .fatrain → 在別台（桌面版 cpu-py 或另一台網頁）續訓。引擎由 engineFactory 注入（測試用假引擎，產品用真引擎）。\n// 速度不是門檻（使用者 2026-11-11）：正確、可暫停、可搬到別台續訓才是。\nconst C = require('./checkpoint_core.js');\nconst B = require('./backend_core.js');\nconst BC = require('./bench_core.js');\n\nfunction eachNamed(map, suffix) { const out = []; for (const [k, a] of map) if (!suffix || k.endsWith(suffix)) out.push(k); return out.sort(); }\nfunction T(map, shapes, names) { return names.map((n) => ({ name: n, shape: shapes.get(n), data: map.get(n) })); }\n\n// 引擎介面（注入）：{ shapes:Map, exportState():{t,params,m,v}, importState(st), step(ids,tgt,lr)->{loss,gradNorm}, evalLoss(ids,tgt)->{loss}, dispose() }\nfunction createWasmWebBackend(o) {\n  o = o || {};\n  const produced = Object.assign({ backend: 'wasm-web', device_fingerprint: 'wasm', engine_version: 'layered-1', precision: 'float32' }, o.produced || {});\n  const b = {\n    id: 'wasm-web', capabilities: { perStep: true, run: false, fp16: false }, kinds: B.KIND_BACKENDS,\n    async probe(ctx) {\n      const hw = (ctx && ctx.hw) || {};\n      if (typeof WebAssembly !== 'object') return B.probeResult(false, '這個環境沒有 WebAssembly', { name: '' }, { backend: 'wasm-web' });\n      const g = typeof self !== 'undefined' ? self : (typeof globalThis !== 'undefined' ? globalThis : {});\n      const isolated = !!g.crossOriginIsolated, sab = typeof SharedArrayBuffer !== 'undefined';\n      let simd = null; try { simd = WebAssembly.validate(new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0, 1, 5, 1, 96, 0, 1, 123, 3, 2, 1, 0, 10, 10, 1, 8, 0, 65, 0, 253, 15, 253, 98, 11])); } catch (e) { simd = null; }\n      return B.probeResult(true, '', { name: 'WebAssembly 處理器（onnxruntime-web，逐層）', vendor: 'wasm', fp16: false },\n        { backend: 'wasm-web', cpu: hw.cpuModel || null, cores: hw.cores || null, engine_version: produced.engine_version, simd, crossOriginIsolated: isolated, sharedArrayBuffer: sab, threadsPossible: isolated && sab });\n    },\n    async benchmark(cfg, opts) {\n      const c = Object.assign({}, cfg, { makeBatch: (cfg && cfg.makeBatch) || ((i) => { const T = (cfg && cfg.seqLen) || 32; const ids = [], tgt = []; for (let k = 0; k < T; k++) { ids.push(1000 + ((i * 131 + k * 7919) % 50000)); tgt.push(1000 + ((i * 131 + (k + 1) * 7919) % 50000)); } return { ids, tgt }; }) });\n      return BC.stepBenchmark(b, c, Object.assign({}, opts, { isReference: !(opts && opts.reference), tokensPerStep: (cfg && cfg.seqLen) || 32 }));\n    },\n    async init(assetState, cfg) {\n      if (!o.engineFactory) throw new Error('wasm-web 後端沒有注入引擎（engineFactory）');\n      const eng = await o.engineFactory(cfg || {}); const h = { eng, cfg: cfg || {}, step: 0, cursor: C.createCursor((cfg && cfg.orderSeed) || 7), rng: new C.PCG32((cfg && cfg.seed) || 1234, 11), lossTail: [], disposed: false };\n      if (assetState && assetState.ckpt) await b.loadCheckpoint(h, assetState);\n      return h;\n    },\n    async step(h, batch) {\n      if (h.disposed) throw new Error('handle 已釋放');\n      const r = await h.eng.step(batch.ids, batch.tgt, batch.lr, batch.mask); h.step++; h.cursor.consumed_tokens += batch.ids.length; h.lossTail.push(r.loss); if (h.lossTail.length > 50) h.lossTail.shift();\n      return { loss: r.loss, gradNorm: r.gradNorm };\n    },\n    async evalLoss(h, batch) { return h.eng.evalLoss(batch.ids, batch.tgt, batch.mask); },\n    async saveCheckpoint(h) {\n      const st = h.eng.exportState(), sh = h.eng.shapes, cfg = h.cfg;\n      const A = eachNamed(st.params, '.A'), Bn = eachNamed(st.params, '.B'), all = A.concat(Bn);\n      const ev = (cfg.evalBatch && h.eng.evalLoss) ? await h.eng.evalLoss(cfg.evalBatch.ids, cfg.evalBatch.tgt) : null;\n      return C.makeCheckpoint({\n        step: h.step, epoch: h.cursor.epoch, cursor: Object.assign({}, h.cursor), rng: h.rng.snapshot(),\n        optimizer: { kind: 'adam', lr: cfg.lr, betas: [0.9, 0.999], eps: 1e-8, wd: 0, step_count: st.t, schedule: { type: 'const' } },\n        data_sha256: cfg.data_sha256 || 'none', compat: cfg.compat || { base: 'qwen3-0.6b-q8', base_sha256: 'unknown', rank: cfg.rank, alpha: cfg.alpha, target_modules: ['q', 'k', 'v', 'o', 'gate', 'up', 'down'], prompt_format_version: 1, tool_catalog_sha256: 'none' },\n        loss_tail: h.lossTail.slice(), eval_check: ev ? { batch: 'eval', loss: ev.loss } : null, produced_by: produced,\n        tensors: { 'lora_A.f32': T(st.params, sh, A), 'lora_B.f32': T(st.params, sh, Bn), 'opt_m.f32': T(st.m, sh, all), 'opt_v.f32': T(st.v, sh, all) },\n      });\n    },\n    async loadCheckpoint(h, cp) {\n      const v = C.verifyChecksums(cp); if (!v.ok) throw new Error('檢查點驗證失敗：' + v.bad.join('、'));\n      const cc = C.checkCompat(cp.ckpt, { compat: h.cfg.compat || cp.ckpt.compat, data_sha256: h.cfg.data_sha256 || cp.ckpt.data_sha256, optimizer: { kind: 'adam' } });\n      if (!cc.ok) { const e = new Error(cc.message); e.compat = cc; throw e; }\n      const d = (f) => new Map(C.decodeTensors(cp.files[f]).map((t) => [t.name, t.data]));\n      const a = d('lora_A.f32'), bb = d('lora_B.f32'), m = d('opt_m.f32'), vv = d('opt_v.f32'); const params = new Map([...a, ...bb]);\n      h.eng.importState({ t: cp.ckpt.optimizer.step_count, params, m, v: vv });\n      h.step = cp.ckpt.step; h.cursor = Object.assign({}, cp.ckpt.cursor); h.rng = C.PCG32.fromSnapshot(cp.ckpt.rng); h.lossTail = (cp.ckpt.loss_tail || []).slice();\n    },\n    async dispose(h) { h.disposed = true; if (h.eng && h.eng.dispose) await h.eng.dispose(); },\n    peakMemBytes() { return (typeof performance !== 'undefined' && performance.memory) ? performance.memory.usedJSHeapSize : (typeof process !== 'undefined' && process.memoryUsage ? process.memoryUsage().rss : 0); },\n  };\n  return b;\n}\n\nmodule.exports = { createWasmWebBackend };\n\n};\nMODS[\"web_train_core\"] = function (module, exports, require) {\n'use strict';\n/* 網頁版訓練服務（頁內，沒有子行程）：把 wasm-web 後端包成「開始／狀態／暫停／續訓／停止／匯出檢查點／匯入檢查點」。\n *  純核心、依賴注入（不碰 window／indexedDB）；產品把 backend、資料提供者、檢查點儲存（IndexedDB 專屬 store）注入進來。\n *  資料提供者 makeData(cfg) → { total, batch(i) → {ids, tgt}, sha }：把訓練資料轉成 token 序列的工作在宿主（分詞器＋提示格式）。\n *  檢查點儲存 store：{ put(key,u8), get(key), delete(key) }（swap_store 的 createIdbSwap／createMemorySwap；滿了會丟 SwapFullError，這裡原樣往外丟並停止）。\n *  檢查點匯出容器：zip（fatrain_core.writeZip 存放式），內容 = ckpt.json＋四個張量檔；副檔名 .fackpt（和 .fatrain 同容器技術，內容是續訓狀態不是資產）。 */\nconst Fat = require('./fatrain_core.js');\nconst C = require('./checkpoint_core.js');\n\nconst enc = (s) => new TextEncoder().encode(s), dec = (u) => new TextDecoder('utf-8').decode(u);\nconst sleep0 = () => new Promise((r) => setTimeout(r, 0));\n\nfunction packCheckpoint(cp) {\n  const entries = [{ name: 'ckpt.json', data: enc(JSON.stringify(cp.ckpt)) }];\n  Object.keys(cp.files).sort().forEach((f) => entries.push({ name: f, data: cp.files[f] instanceof Uint8Array ? cp.files[f] : new Uint8Array(cp.files[f]) }));\n  return Fat.writeZip(entries);\n}\nfunction unpackCheckpoint(bytes) {\n  const es = Fat.readZip(bytes, {}); const by = {}; es.forEach((e) => { by[e.name] = e.data; });\n  if (!by['ckpt.json']) throw new Error('不是續訓檢查點（缺少 ckpt.json）');\n  const ckpt = JSON.parse(dec(by['ckpt.json'])); const files = {}; Object.keys(by).forEach((n) => { if (n !== 'ckpt.json') files[n] = by[n]; });\n  return { ckpt, files };\n}\n\nfunction createWebTrainService(o) {\n  const backend = o.backend, makeData = o.makeData, store = o.store, now = o.now || (() => Date.now()), yieldFn = o.yieldFn || sleep0;\n  const jobs = new Map(); let seq = 0, activeId = null;\n  const keyOf = (name) => 'ckpt:' + name;\n\n  async function saveCkpt(job) {\n    const cp = await backend.saveCheckpoint(job.h); const bytes = packCheckpoint(cp);\n    await store.put(keyOf(job.name), bytes);              // 滿了：SwapFullError 原樣往外丟，不吞\n    job.lastCkptStep = job.h.step; return { step: job.h.step, bytes: bytes.length };\n  }\n  async function loop(job) {\n    try {\n      while (job.state === 'running' && job.h.step < job.total) {\n        const t0 = now(); const b = job.data.batch(job.h.step % job.data.total); const r = await backend.step(job.h, Object.assign({ lr: job.cfg.lr }, b));\n        job.loss = r.loss; job.gradNorm = r.gradNorm; job.losses.push(r.loss); if (job.losses.length > 200) job.losses.shift(); job.tokens += b.ids.length; job.ms += now() - t0;\n        if (job.cfg.saveSteps && job.h.step % job.cfg.saveSteps === 0) await saveCkpt(job);\n        await yieldFn();\n      }\n      if (job.state === 'running') { await saveCkpt(job); job.state = 'done'; }\n      else if (job.state === 'pausing') { await saveCkpt(job); job.state = 'paused'; }\n      else if (job.state === 'stopping') job.state = 'stopped';\n    } catch (e) { job.state = 'error'; job.error = String((e && e.message) || e); job.errorName = e && e.name; }\n    finally { job.idle = true; if (job.waiters) job.waiters.forEach((w) => w()); }\n  }\n\n  const svc = {\n    packCheckpoint, unpackCheckpoint,\n    async start(p) {\n      if (activeId && jobs.get(activeId) && ['running', 'pausing'].indexOf(jobs.get(activeId).state) >= 0) return { ok: false, error: '已有一個訓練在跑（' + activeId + '），請先暫停或停止' };\n      const cfg = Object.assign({ steps: 100, lr: 0.001, rank: 8, alpha: 16, saveSteps: 0 }, p.cfg || {});\n      let data; try { data = await makeData(cfg); } catch (e) { return { ok: false, error: '無法準備訓練資料：' + String((e && e.message) || e) }; }\n      if (!data || !(data.total > 0)) return { ok: false, error: '訓練資料是空的（沒有可用的 token 序列）' };\n      cfg.data_sha256 = data.sha;\n      let assetState = null;\n      if (p.resume) {\n        let u = null; try { u = await store.get(keyOf(p.name)); } catch (e) { return { ok: false, error: '讀取檢查點失敗：' + String((e && e.message) || e) }; }\n        if (!u) return { ok: false, error: '沒有 ' + p.name + ' 的檢查點可續訓（先暫停一次，或匯入 .fackpt）' };\n        try { assetState = unpackCheckpoint(u); } catch (e) { return { ok: false, error: '檢查點損毀：' + String((e && e.message) || e) }; }\n      }\n      let h; try { h = await backend.init(assetState, cfg); } catch (e) { return { ok: false, error: String((e && e.message) || e), compat: e && e.compat }; }\n      const job = { id: 'web' + (++seq) + '_' + now().toString(36), name: p.name, cfg, data, h, total: cfg.steps, state: 'running', loss: null, gradNorm: null, losses: [], tokens: 0, ms: 0, idle: false, startedAt: now(), resumedFrom: assetState ? h.step : 0 };\n      jobs.set(job.id, job); activeId = job.id; job.promise = loop(job);\n      return { ok: true, jobId: job.id, resumedFromStep: job.resumedFrom };\n    },\n    status(id) {\n      const j = jobs.get(id || activeId); if (!j) return { ok: false, error: '沒有這個訓練工作' };\n      return { ok: true, jobId: j.id, name: j.name, state: j.state, step: j.h.step, total: j.total, loss: j.loss, gradNorm: j.gradNorm, lossTail: j.losses.slice(-50), tokPerSec: j.ms > 0 ? j.tokens / (j.ms / 1000) : null, error: j.error || null, errorName: j.errorName || null, lastCkptStep: j.lastCkptStep === undefined ? null : j.lastCkptStep, backend: 'wasm-web', engPhase: (j.h.eng && j.h.eng.phase) || '' };\n    },\n    async _settle(j) { if (!j.idle) await new Promise((r) => { (j.waiters = j.waiters || []).push(r); }); },\n    async pause(id) {\n      const j = jobs.get(id || activeId); if (!j) return { ok: false, error: '沒有這個訓練工作' };\n      if (j.state === 'paused') return { ok: true, step: j.h.step, checkpoint: true };\n      if (j.state !== 'running') return { ok: false, error: '目前狀態（' + j.state + '）不能暫停' };\n      j.state = 'pausing'; await svc._settle(j);\n      if (j.state === 'error') return { ok: false, error: j.error, errorName: j.errorName };\n      return { ok: true, step: j.h.step, checkpoint: true };\n    },\n    async stop(id) {\n      const j = jobs.get(id || activeId); if (!j) return { ok: true };\n      if (j.state === 'running' || j.state === 'pausing') { j.state = 'stopping'; await svc._settle(j); }\n      return { ok: true, state: j.state };\n    },\n    // 匯出：取該名稱最新的檢查點（暫停或完成時存的）\n    async exportCheckpoint(name) { const u = await store.get(keyOf(name)); if (!u) return { ok: false, error: '沒有 ' + name + ' 的檢查點可匯出（先暫停或等訓練完成）' }; return { ok: true, name: name + '.fackpt', bytes: u }; },\n    // 匯入：先驗證容器與校驗和再存；name 缺省用檢查點內記的資產名稱沒有就用 imported\n    async importCheckpoint(bytes, name) {\n      let cp; try { cp = unpackCheckpoint(bytes); } catch (e) { return { ok: false, error: '不是有效的 .fackpt：' + String((e && e.message) || e) }; }\n      const v = C.verifyChecksums(cp); if (!v.ok) return { ok: false, error: '檢查點驗證失敗：' + v.bad.join('、') };\n      const nm = name || 'imported'; await store.put(keyOf(nm), bytes);\n      return { ok: true, name: nm, step: cp.ckpt.step, produced_by: cp.ckpt.produced_by, compat: cp.ckpt.compat, loss_tail: (cp.ckpt.loss_tail || []).slice(-5) };\n    },\n  };\n  return svc;\n}\n\nmodule.exports = { createWebTrainService, packCheckpoint, unpackCheckpoint };\n\n};\nMODS[\"webtrain_worker_core\"] = function (module, exports, require) {\n'use strict';\n/* 網頁版頁內訓練的 Worker 端邏輯（DESIGN.TODO.offline-training-studio.md §5.6）。純核心、依賴注入，能在 Node 測試也能在 Worker 內跑。\n *  做的事：取得基底模型（Qwen3-0.6B 的 q8 ONNX）→ 載入 onnxruntime-web → 用逐層引擎訓練；訓練資料的分詞與遮罩、檢查點（IndexedDB 專屬庫）、\n *  暫停／續訓／停止／匯出匯入、進度回報。\n *  基底權重來源（不新增託管）：和網頁版 AI 助理載入同一個模型（transformers.js 的瀏覽器快取 'transformers-cache' 裡的\n *  https://huggingface.co/onnx-community/Qwen3-0.6B-ONNX/resolve/main/onnx/model_quantized.onnx）；快取沒有才由使用者的瀏覽器向同一個網址下載（約 617MB，並寫回同一個快取，之後 AI 助理也能用）。\n *  找不到時回具體原因，不假裝。\n *  env 注入：importModule(url)、caches、indexedDB、fetch、now。 */\nconst Q = require('./qwen3_graph.js'), E = require('./qwen3_layered_engine.js'), SW = require('./swap_store.js'), BW = require('./backend_wasm_web.js'), WT = require('./web_train_core.js'), Asset = require('./asset_core.js');\n\nconst MODEL_REPO = 'onnx-community/Qwen3-0.6B-ONNX', MODEL_URL = 'https://huggingface.co/' + MODEL_REPO + '/resolve/main/onnx/model_quantized.onnx';\nconst ORT_VERSION = '1.22.0', ORT_URL = 'https://cdn.jsdelivr.net/npm/onnxruntime-web@' + ORT_VERSION + '/dist/ort.wasm.min.mjs', ORT_BASE = 'https://cdn.jsdelivr.net/npm/onnxruntime-web@' + ORT_VERSION + '/dist/';\nconst TF_URL = 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.7.5/+esm';\nconst CACHE_NAME = 'transformers-cache';\nconst mb = (x) => (x / 1048576).toFixed(0) + 'MB';\n\n// 一筆資料 → {ids, tgt, mask}（長度固定 T；只對答案 token 算損失，提示部分與補齊的位置 mask=0；太長就保留尾端）\nfunction layoutRow(promptIds, answerIds, T) {\n  const all = promptIds.concat(answerIds); let input = all.slice(0, -1), tgt = all.slice(1), mask = tgt.map((_, i) => (i + 1 >= promptIds.length ? 1 : 0));\n  if (input.length > T) { input = input.slice(-T); tgt = tgt.slice(-T); mask = mask.slice(-T); }\n  while (input.length < T) { input.push(0); tgt.push(0); mask.push(0); }\n  return { ids: input, tgt, mask };\n}\n\nfunction createWorkerHost(env) {\n  const state = { phase: '', modelBytes: 0 }; let ort = null, model = null, tokP = null, svc = null, modelMeta = null;\n  const ckptStore = SW.createIdbSwap({ indexedDB: env.indexedDB, quotaBytes: 2 * 1073741824, dbName: 'fa-train-ckpt' });\n  const setPhase = (s) => { state.phase = s; };\n\n  const openCache = async () => { try { return env.caches ? await env.caches.open(CACHE_NAME) : null; } catch (e) { return null; } };   // file:// 頁面等環境沒有可用的 Cache Storage 時回 null\n  async function cachedModel() { try { const c = await openCache(); return !!(c && await c.match(MODEL_URL)); } catch (e) { return false; } }\n  async function loadModelBytes(urlOverride) {\n    if (model) return model;\n    let bytes = null; const cache = await openCache(); const hit = cache ? await cache.match(MODEL_URL) : null;\n    if (hit) { setPhase('讀取瀏覽器快取裡的 Qwen3 q8 模型'); bytes = new Uint8Array(await hit.arrayBuffer()); }\n    else {\n      setPhase('下載 Qwen3-0.6B q8 模型（約 617MB，來源與 AI 助理相同）');\n      let res; try { res = await env.fetch(urlOverride || MODEL_URL); } catch (e) { throw new Error('下載失敗：' + String((e && e.message) || e)); }\n      if (!res.ok) throw new Error('下載失敗：HTTP ' + res.status);\n      const total = +res.headers.get('content-length') || 0; const rd = res.body && res.body.getReader ? res.body.getReader() : null;\n      if (rd) { const chunks = []; let got = 0; for (;;) { const { done, value } = await rd.read(); if (done) break; chunks.push(value); got += value.length; setPhase('下載 Qwen3 q8 模型 ' + mb(got) + (total ? ' / ' + mb(total) : '')); } bytes = new Uint8Array(got); let o = 0; for (const c of chunks) { bytes.set(c, o); o += c.length; } }\n      else bytes = new Uint8Array(await res.arrayBuffer());\n      if (cache) { try { await cache.put(MODEL_URL, new Response(bytes)); } catch (e) { /* 快取寫不進去（配額）不影響這次訓練 */ } }\n    }\n    model = Q.openModel(bytes); state.modelBytes = bytes.length;\n    let h = 2166136261; for (let i = 0; i < bytes.length; i += 4099) { h ^= bytes[i]; h = Math.imul(h, 16777619) >>> 0; }\n    modelMeta = { base: 'Qwen/Qwen3-0.6B（' + MODEL_REPO + ' q8）', base_sha256: 'q8-' + bytes.length + '-' + h.toString(16) };\n    return model;\n  }\n  async function loadOrt() { if (!ort) { setPhase('載入 onnxruntime-web ' + ORT_VERSION); ort = await env.importModule(ORT_URL); ort.env.wasm.wasmPaths = ORT_BASE; ort.env.wasm.numThreads = 1; } return ort; }\n  let remoteHost = null;   // 測試掛鉤：分詞器檔案改從這個主機取（預設 huggingface.co）\n  async function getTok() {\n    if (!tokP) tokP = (async () => { setPhase('載入分詞器'); const tf = await env.importModule(TF_URL); tf.env.allowLocalModels = false; if (remoteHost) tf.env.remoteHost = remoteHost; return tf.AutoTokenizer.from_pretrained(MODEL_REPO); })();\n    return tokP;\n  }\n\n  async function makeData(cfg) {\n    const rows = cfg.rows || []; delete cfg.rows; const T = cfg.seqLen; const out = [];\n    const fit = (r) => { let ids = r.ids.slice(-T), tgt = r.tgt.slice(-T), mask = (r.mask || r.ids.map(() => 1)).slice(-T); while (ids.length < T) { ids.push(0); tgt.push(0); mask.push(0); } return { ids, tgt, mask }; };\n    if (rows.length && rows.every((r) => r && Array.isArray(r.ids) && Array.isArray(r.tgt))) rows.forEach((r) => out.push(fit(r)));      // 已經是 token 的資料（測試／匯入）\n    else {\n      const tok = await getTok(); setPhase('分詞 ' + rows.length + ' 筆');\n      for (const r of rows) {\n        const ans = r.completion !== undefined ? r.completion : (r.chosen !== undefined ? r.chosen : r.answer); if (!r.messages || ans === undefined) continue;\n        const prompt = tok.apply_chat_template(r.messages, { tools: r.tools || undefined, add_generation_prompt: true, enable_thinking: false, tokenize: false }) + (r.prefill || '');\n        const enc = (s) => { const x = tok.encode(s, { add_special_tokens: false }); return Array.from(x.input_ids ? x.input_ids : x).map(Number); };\n        out.push(layoutRow(enc(prompt), enc(String(ans) + '<|im_end|>'), T));\n      }\n    }\n    if (!out.length) throw new Error('資料裡沒有可用的列（需要 messages＋completion，或已分詞的 ids／tgt）');\n    const sha = Asset.sha256Hex(new TextEncoder().encode(JSON.stringify(out.map((x) => [x.ids, x.tgt, x.mask]))));\n    return { total: out.length, sha, batch: (i) => out[i % out.length] };\n  }\n\n  async function start(p) {\n    if (svc) { const s = svc.status(); if (s.ok && (s.state === 'running' || s.state === 'pausing')) return { ok: false, error: '已有一個訓練在跑，請先暫停或停止' }; }\n    const cfg = Object.assign({ seqLen: 64, rank: 8, steps: 100, lr: 0.001, swap: true }, p.cfg || {}); cfg.alpha = 2 * cfg.rank; cfg.rows = p.rows;\n    if (p.testHooks && p.testHooks.remoteHost) remoteHost = p.testHooks.remoteHost;\n    let M; try { M = await loadModelBytes(p.testHooks && p.testHooks.modelUrl); } catch (e) { setPhase(''); return { ok: false, error: '找不到可用的 Qwen3-0.6B q8 模型：' + String((e && e.message) || e) + '。網頁版訓練使用 AI 助理載入的同一個模型來源（' + MODEL_URL + '）；請先到 AI 助理載入 Qwen3 0.6B 一次，或檢查網路後重試' }; }\n    let O; try { O = await loadOrt(); } catch (e) { setPhase(''); return { ok: false, error: '無法載入 onnxruntime-web（' + ORT_URL + '）：' + String((e && e.message) || e) }; }\n    cfg.compat = { base: modelMeta.base, base_sha256: modelMeta.base_sha256, rank: cfg.rank, alpha: cfg.alpha, target_modules: ['q', 'k', 'v', 'o', 'gate', 'up', 'down'], prompt_format_version: 1, tool_catalog_sha256: 'none' };\n    const layerStore = cfg.swap ? SW.createIdbSwap({ indexedDB: env.indexedDB, quotaBytes: 3 * 1073741824, dbName: 'fa-train-swap' }) : null;\n    const backend = BW.createWasmWebBackend({ engineFactory: async (c) => {\n      const eng = new E.LayeredEngine({ ort: O, ep: 'wasm', M, T: c.seqLen, rank: c.rank, layers: 28, lr: c.lr, keepSessions: !layerStore, headChunks: 8,\n        layerSource: layerStore ? SW.createSwapLayerSource(layerStore, async (kind, l) => { const G = require('./onnx_grad_core.js'); const b = kind === 'F' ? Q.buildLayerF(M, l, c.seqLen, c.rank) : kind === 'B' ? Q.buildLayerB(M, l, c.seqLen, c.rank) : Q.buildHead(M, c.seqLen, { headChunks: 8 }); return G.toOnnx(b.g, { name: kind + l }); }, 'k:' + modelMeta.base_sha256 + ':' + c.seqLen + ':' + c.rank + ':') : null });\n      eng.initParams(null, c.seed || 7); return eng;\n    } });\n    svc = WT.createWebTrainService({ backend, store: ckptStore, makeData, yieldFn: () => new Promise((r) => setTimeout(r, 0)) });\n    setPhase('準備訓練'); const r = await svc.start({ name: p.name, cfg, resume: !!p.resume }); if (!r.ok) setPhase(''); else setPhase('訓練中');\n    return r;\n  }\n\n  const api = {\n    async probe() {\n      if (typeof WebAssembly !== 'object') return { available: false, reason: '這個瀏覽器沒有 WebAssembly', device: { name: '' }, fingerprint: { backend: 'wasm-web' } };\n      const cached = await cachedModel();\n      return { available: true, reason: '', device: { name: 'WebAssembly 處理器（onnxruntime-web ' + ORT_VERSION + '，逐層訓練）', vendor: 'wasm', fp16: false }, fingerprint: { backend: 'wasm-web', ort: ORT_VERSION }, note: cached ? '基底模型已在瀏覽器快取' : '基底模型（約 617MB）還沒有在瀏覽器快取；開始訓練時會向 ' + MODEL_URL + ' 下載' };\n    },\n    start,\n    status(p) { if (!svc) return { ok: true, state: 'idle', phase: state.phase }; const s = svc.status(p && p.jobId); if (s.ok) s.phase = (s.engPhase ? s.engPhase + '　' : '') + state.phase; return s; },\n    async pause(p) { if (!svc) return { ok: false, error: '沒有訓練工作' }; return svc.pause(p && p.jobId); },\n    async stop(p) { if (!svc) return { ok: true }; return svc.stop(p && p.jobId); },\n    async exportCheckpoint(p) { const s = svc || WT.createWebTrainService({ backend: null, store: ckptStore, makeData: null }); return s.exportCheckpoint(p.name); },\n    async importCheckpoint(p) { const s = svc || WT.createWebTrainService({ backend: null, store: ckptStore, makeData: null }); return s.importCheckpoint(p.bytes, p.name); },\n  };\n  return { handle: async (op, p) => { if (!api[op]) throw new Error('未知操作 ' + op); return api[op](p || {}); }, layoutRow, state };\n}\n\nmodule.exports = { createWorkerHost, layoutRow, MODEL_URL, MODEL_REPO, ORT_URL };\n\n};\nconst CACHE = {}; function req(p) { const n = String(p).replace(/^\\.\\//, '').replace(/\\.js$/, ''); if (CACHE[n]) return CACHE[n].exports; if (!MODS[n]) throw new Error('Worker 內沒有模組 ' + p); const m = { exports: {} }; CACHE[n] = m; MODS[n].call(m.exports, m, m.exports, req); return m.exports; }\nconst WH = req('webtrain_worker_core').createWorkerHost({ importModule: (u) => import(u), caches: self.caches, indexedDB: self.indexedDB, fetch: self.fetch.bind(self) });\nself.onmessage = async (ev) => { const d = ev.data || {}; try { const r = await WH.handle(d.op, d.p); const tr = []; if (r && r.bytes && r.bytes.buffer) tr.push(r.bytes.buffer); self.postMessage({ id: d.id, r }, tr); } catch (e) { self.postMessage({ id: d.id, err: String((e && e.message) || e) }); } };\n",FA_STUDIO_HOST_FILES={"backend_core.js":"'use strict';\n// 運算後端統一介面與登錄表（DESIGN.TODO.offline-training-studio.md §5.3）。純核心、依賴注入、不碰 window。\nconst BACKEND_IDS = ['cpu-js', 'cpu-py', 'wasm-web', 'webgpu', 'directml', 'vulkan'];\nconst SYMBOLIC_KINDS = ['trainer', 'colu', 'uml', 'blockly', 'matrix'];\n// 每個 kind 宣告支援的後端；lora 的清單是「可能」，實際是否點亮由 probe＋基準測試決定。符號式五類只有 cpu-js。\nconst KIND_BACKENDS = { trainer: ['cpu-js'], colu: ['cpu-js'], uml: ['cpu-js'], blockly: ['cpu-js'], matrix: ['cpu-js'], lora: ['cpu-py', 'wasm-web', 'webgpu', 'directml', 'vulkan'] };\n// 「自動」同速（差 <10%）時偏好較成熟者：cpu-py > vulkan > directml > webgpu（cpu-js 只服務符號式，排最前）\nconst MATURITY = ['cpu-js', 'cpu-py', 'wasm-web', 'vulkan', 'directml', 'webgpu'];   // wasm-web：網頁版處理器訓練，慢但正確、可搬檢查點（§5.6）\n\nconst REQUIRED_METHODS = ['probe', 'benchmark', 'init', 'step', 'evalLoss', 'saveCheckpoint', 'loadCheckpoint', 'dispose'];\n\n// probe 結果形狀：不丟例外；available 為 false 時 reason 必須是給使用者看的具體原因\nfunction probeResult(available, reason, device, fingerprint) {\n  const r = { available: !!available, device: device || { name: '' }, fingerprint: fingerprint || {} };\n  if (reason) r.reason = String(reason);\n  return r;\n}\nfunction validateProbeResult(r) {\n  const errs = [];\n  if (!r || typeof r !== 'object') return ['probe 沒回物件'];\n  if (typeof r.available !== 'boolean') errs.push('available 必須是 boolean');\n  if (!r.available && (typeof r.reason !== 'string' || !r.reason)) errs.push('不可用時必須有 reason');\n  if (!r.device || typeof r.device !== 'object') errs.push('缺 device');\n  if (!r.fingerprint || typeof r.fingerprint !== 'object') errs.push('缺 fingerprint');\n  return errs;\n}\n// 介面型別檢查：id 合法、方法齊全；capabilities 標明「逐步呼叫」或「整段子行程」\nfunction validateBackend(b) {\n  const errs = [];\n  if (!b || typeof b !== 'object') return ['不是物件'];\n  if (BACKEND_IDS.indexOf(b.id) < 0) errs.push('id 不在 ' + BACKEND_IDS.join('／'));\n  REQUIRED_METHODS.forEach((m) => { if (typeof b[m] !== 'function') errs.push('缺方法 ' + m); });\n  if (!b.capabilities || typeof b.capabilities.perStep !== 'boolean') errs.push('缺 capabilities.perStep');\n  return errs;\n}\n// 保證 probe 不丟例外（後端自己寫壞時也不拖垮 UI）\nasync function safeProbe(b, ctx) {\n  try { const r = await b.probe(ctx); const e = validateProbeResult(r); return e.length ? probeResult(false, '後端 ' + b.id + ' 的 probe 回傳格式不合：' + e.join('；')) : r; }\n  catch (e) { return probeResult(false, '後端 ' + b.id + ' 的 probe 發生例外：' + (e && e.message || e)); }\n}\n\nclass BackendRegistry {\n  constructor() { this.map = new Map(); }\n  register(b) { const e = validateBackend(b); if (e.length) throw new Error('後端不合介面：' + e.join('；')); this.map.set(b.id, b); return this; }\n  get(id) { return this.map.get(id) || null; }\n  ids() { return Array.from(this.map.keys()); }\n  supportedFor(kind) { return (KIND_BACKENDS[kind] || []).slice(); }\n  // 某 kind 的後端清單（含未登錄者的說明，供 UI 灰掉並顯示原因）\n  async listFor(kind, ctx) {\n    const out = [];\n    for (const id of this.supportedFor(kind)) {\n      const b = this.get(id);\n      if (!b) { out.push({ id, available: false, reason: '後端 ' + id + ' 沒有登錄', probe: null }); continue; }\n      const p = await safeProbe(b, ctx); out.push({ id, available: p.available, reason: p.reason || '', probe: p });\n    }\n    return out;\n  }\n}\nconst isSymbolicKind = (k) => SYMBOLIC_KINDS.indexOf(k) >= 0;\nconst maturityRank = (id) => { const i = MATURITY.indexOf(id); return i < 0 ? 99 : i; };\n\nmodule.exports = { BACKEND_IDS, SYMBOLIC_KINDS, KIND_BACKENDS, MATURITY, REQUIRED_METHODS, probeResult, validateProbeResult, validateBackend, safeProbe, BackendRegistry, isSymbolicKind, maturityRank };\n","bench_core.js":"'use strict';\n// 基準測試、一致性檢查、結果快取與自動選擇（DESIGN.TODO.offline-training-studio.md §4.1、§5.8）。純核心、依賴注入（時鐘、儲存、記錄都由呼叫端給）。\nlet crypto = null; try { crypto = require('crypto'); } catch (e) { crypto = null; }   // Worker／瀏覽器沒有 Node crypto 時用純 JS 的 FNV 雜湊（只拿來比對指紋是否改變）\nconst B = require('./backend_core.js');\n\n// §5.8 設計初值（階段 2 以真實測量校準後才固定）\nconst BENCH = { warmup: 3, steps: 30, samples: 16, seqLen: 256, batch: 1, deadlineMs: 60000, abortWithinMs: 3000 };\nconst CONSIST = { loss1: 1e-3, gradNorm1: 1e-2, loss30: 0.03, loss30Fp16: 0.05 };\nconst TIE = 0.10;       // 同速：差 <10%\n\n// 基準本身也要遵守「電腦保持可用」：核心數上限 N−1，至少 1\nconst benchThreads = (cores) => Math.max(1, (cores | 0) - 1);\n\nconst rel = (a, b) => Math.abs(a - b) / Math.max(Math.abs(b), 1e-12);\nfunction percentile(sorted, p) { if (!sorted.length) return 0; const i = Math.min(sorted.length - 1, Math.max(0, Math.ceil(p * sorted.length) - 1)); return sorted[i]; }\nconst finite = (x) => typeof x === 'number' && Number.isFinite(x);\n\n// ---- 一致性檢查四項（以參考後端的 trace 為準）----\n// trace = { loss1, gradNorm1, loss30, hasNonFinite }\nfunction consistencyCheck(ref, cand, o) {\n  o = o || {}; const fp16 = !!o.fp16;\n  const items = [\n    { name: '第1步loss', value: rel(cand.loss1, ref.loss1), tol: CONSIST.loss1 },\n    { name: '第1步梯度範數', value: rel(cand.gradNorm1, ref.gradNorm1), tol: CONSIST.gradNorm1 },\n    { name: '30步後loss', value: rel(cand.loss30, ref.loss30), tol: fp16 ? CONSIST.loss30Fp16 : CONSIST.loss30 },\n  ].map((x) => Object.assign(x, { pass: finite(x.value) && x.value <= x.tol }));\n  items.push({ name: '全程無NaN或Inf', value: cand.hasNonFinite ? 1 : 0, tol: 0, pass: !cand.hasNonFinite });\n  const failed = items.filter((x) => !x.pass).map((x) => x.name);\n  return { pass: failed.length === 0, items, failed, fp16, maxRelErr: Math.max(items[0].value, items[1].value), lossDelta: items[2].value };\n}\n\n// ---- 可中斷的逐步基準（perStep 後端共用）----\n// opts: { signal, now(), reference(trace), fp16, isReference, deadlineMs, warmup, steps, tokensPerStep }\n// cfg.makeBatch(i) 給第 i 步的批次（固定種子的 16 筆樣本由呼叫端決定）\nasync function stepBenchmark(backend, cfg, opts) {\n  opts = opts || {}; const now = opts.now || (typeof performance !== 'undefined' ? () => performance.now() : () => Date.now()), signal = opts.signal || null;\n  const warm = opts.warmup === undefined ? BENCH.warmup : opts.warmup, steps = opts.steps === undefined ? BENCH.steps : opts.steps;\n  const deadline = opts.deadlineMs === undefined ? BENCH.deadlineMs : opts.deadlineMs, tokens = opts.tokensPerStep || (BENCH.seqLen * BENCH.batch);\n  const t0 = now(); let abortedAt = null, handle = null, tooSlow = false;\n  let abortReject; const abortP = new Promise((_, rej) => { abortReject = rej; });\n  abortP.catch(() => {});\n  const onAbort = () => { if (abortedAt === null) abortedAt = now(); abortReject(new Error('__aborted__')); };\n  if (signal) { if (signal.aborted) onAbort(); else if (signal.addEventListener) signal.addEventListener('abort', onAbort, { once: true }); }\n  const guard = (p) => Promise.race([Promise.resolve(p), abortP]);       // 單步卡住也能在中斷後立刻返回\n  const times = [], losses = []; let gn1 = null, nonFinite = false, peak = 0, err = null;\n  try {\n    handle = await guard(backend.init(null, Object.assign({}, cfg, { threads: cfg.threads || benchThreads(cfg.cores || 2) })));\n    for (let i = 0; i < warm + steps; i++) {\n      if (abortedAt !== null) break;\n      if (now() - t0 > deadline) { tooSlow = true; break; }\n      const s0 = now(); const r = await guard(backend.step(handle, cfg.makeBatch ? cfg.makeBatch(i) : { index: i })); const dt = now() - s0;\n      if (!finite(r.loss) || (r.gradNorm !== undefined && !finite(r.gradNorm))) nonFinite = true;\n      if (i === 0) gn1 = r.gradNorm;\n      if (i >= warm) { times.push(dt); losses.push(r.loss); }\n      else if (i === 0) losses.unshift(r.loss);   // 第 1 步 loss 放最前面當 loss1（暖機的其餘步不計入速度）\n      if (backend.peakMemBytes) { try { peak = Math.max(peak, backend.peakMemBytes(handle) || 0); } catch (e) {} }\n    }\n  } catch (e) { if (!(e && e.message === '__aborted__')) err = e; }\n  finally {\n    if (signal && signal.removeEventListener) signal.removeEventListener('abort', onAbort);\n    if (handle) { try { await Promise.race([Promise.resolve(backend.dispose(handle)), new Promise((r) => setTimeout(r, 2000))]); } catch (e) {} }\n  }\n  const stoppedAfterMs = abortedAt === null ? null : now() - abortedAt;\n  if (abortedAt !== null) return { ok: false, aborted: true, stoppedAfterMs, elapsedMs: now() - t0, reason: '使用者中斷' };\n  if (err) return { ok: false, error: String(err && err.message || err), reason: '基準測試失敗：' + (err && err.message || err), elapsedMs: now() - t0 };\n  if (tooSlow) return { ok: false, tooSlow: true, reason: '太慢：超過 ' + Math.round(deadline / 1000) + ' 秒仍未跑完 ' + (warm + steps) + ' 步', elapsedMs: now() - t0 };\n  const sorted = times.slice().sort((a, b) => a - b), med = percentile(sorted, 0.5);\n  const trace = { loss1: losses[0], gradNorm1: gn1, loss30: losses[losses.length - 1], hasNonFinite: nonFinite };\n  const res = { ok: true, tokPerSec: med > 0 ? tokens / (med / 1000) : 0, peakMemBytes: peak || null, stepMsP50: med, stepMsP95: percentile(sorted, 0.95), samples: times.length, trace, elapsedMs: now() - t0, threads: cfg.threads || benchThreads(cfg.cores || 2), fp16: !!opts.fp16 };\n  if (opts.isReference) res.numericCheck = { pass: !nonFinite, maxRelErr: 0, lossDelta: 0, reference: true, items: [], failed: nonFinite ? ['全程無NaN或Inf'] : [] };\n  else if (opts.reference) { const c = consistencyCheck(opts.reference, trace, { fp16: opts.fp16 }); res.numericCheck = { pass: c.pass, maxRelErr: c.maxRelErr, lossDelta: c.lossDelta, items: c.items, failed: c.failed }; }\n  else res.numericCheck = { pass: false, maxRelErr: null, lossDelta: null, items: [], failed: ['沒有參考後端的結果可比對'] };\n  return res;\n}\n// 通過門檻：四項全過、沒超時、沒錯誤才算通過（才可被「自動」選用）\nconst benchPassed = (r) => !!(r && r.ok && !r.tooSlow && r.numericCheck && r.numericCheck.pass);\n\n// ---- 快取：以硬體指紋為鍵 ----\nfunction stableStringify(o) { if (o === null || typeof o !== 'object') return JSON.stringify(o); if (Array.isArray(o)) return '[' + o.map(stableStringify).join(',') + ']'; return '{' + Object.keys(o).sort().map((k) => JSON.stringify(k) + ':' + stableStringify(o[k])).join(',') + '}'; }\nconst fnvHex = (s) => { let h1 = 0x811c9dc5, h2 = 0x1000193; for (let i = 0; i < s.length; i++) { h1 = Math.imul(h1 ^ s.charCodeAt(i), 0x01000193) >>> 0; h2 = Math.imul(h2 + s.charCodeAt(i), 0x85ebca6b) >>> 0; } return (h1.toString(16).padStart(8, '0') + h2.toString(16).padStart(8, '0')); };\nconst hashFingerprint = (fp) => (crypto ? crypto.createHash('sha256').update(stableStringify(fp || {})).digest('hex').slice(0, 16) : fnvHex(stableStringify(fp || {})));\nfunction diffFingerprint(a, b) { const keys = new Set(Object.keys(a || {}).concat(Object.keys(b || {}))), out = []; keys.forEach((k) => { if (stableStringify((a || {})[k]) !== stableStringify((b || {})[k])) out.push(k); }); return out; }\n// store: { load() -> obj|null, save(obj) }（可非同步）；沒給就用記憶體\nfunction createBenchCache(store, now) {\n  now = now || (() => Date.now()); let mem = null;\n  const load = async () => { if (mem) return mem; let d = null; try { d = store ? await store.load() : null; } catch (e) {} mem = d && d.version === 1 ? d : { version: 1, entries: {}, latest: {} }; return mem; };\n  const persist = async () => { if (store) try { await store.save(mem); } catch (e) {} };\n  return {\n    // 回傳 {status:'hit'|'stale'|'none', result?, changed?}\n    async lookup(id, fp) {\n      const d = await load(), h = hashFingerprint(fp), e = d.entries[id + '|' + h];\n      if (e) return { status: 'hit', result: e.result, at: e.at };\n      const last = d.latest[id]; return last ? { status: 'stale', changed: diffFingerprint(last.fingerprint, fp), previous: last } : { status: 'none' };\n    },\n    async store(id, fp, result) { const d = await load(), h = hashFingerprint(fp); const slim = Object.assign({}, result); d.entries[id + '|' + h] = { result: slim, at: now(), fingerprint: fp }; d.latest[id] = { hash: h, fingerprint: fp }; await persist(); },\n    async clear() { mem = { version: 1, entries: {}, latest: {} }; await persist(); },\n  };\n}\n\n// ---- 自動選擇 ----\n// o: { kind, registry, cache, ctx(傳給 probe；ctx.modelSha256 併入指紋), pin, skipBench, runBench(id, signal)->結果, signal, log(rec) }\nasync function autoSelect(o) {\n  const log = o.log || (() => {}), events = [];\n  const ev = (rec) => { events.push(rec); log(rec); };\n  if (B.isSymbolicKind(o.kind)) return { chosen: 'cpu-js', order: ['cpu-js'], source: 'symbolic', needsRebench: false, stale: [], events, reason: '符號式訓練只需處理器（cpu-js）' };\n  const ids = o.registry.supportedFor(o.kind), probes = {}, fps = {};\n  for (const id of ids) {\n    const b = o.registry.get(id);\n    probes[id] = b ? await B.safeProbe(b, o.ctx) : B.probeResult(false, '後端 ' + id + ' 沒有登錄');\n    fps[id] = Object.assign({}, probes[id].fingerprint, { model_sha256: (o.ctx && o.ctx.modelSha256) || null, backend: id });\n  }\n  const avail = ids.filter((id) => probes[id].available);\n  // 釘選：不自動換；不可用就停下詢問\n  if (o.pin) {\n    if (probes[o.pin] && probes[o.pin].available) {\n      const c = await o.cache.lookup(o.pin, fps[o.pin]);\n      return { chosen: o.pin, order: [o.pin], pinned: true, stopOnFail: true, source: 'pin', needsRebench: c.status !== 'hit', stale: [], warning: c.status === 'hit' && !benchPassed(c.result) ? '釘選的後端未通過一致性檢查：' + ((c.result.numericCheck && c.result.numericCheck.failed) || [c.result.reason]).join('、') : '', events };\n    }\n    return { chosen: null, order: [], pinned: true, ask: true, source: 'pin', needsRebench: false, stale: [], events, reason: '釘選的後端 ' + o.pin + ' 不可用：' + ((probes[o.pin] && probes[o.pin].reason) || '沒有這個後端') + '；要改用別的後端嗎？' };\n  }\n  if (!avail.length) return { chosen: null, order: [], source: 'none', needsRebench: false, stale: [], events, reason: '沒有可用的後端：' + ids.map((i) => i + '＝' + probes[i].reason).join('；') };\n  const results = {}, stale = []; const missing = [];\n  for (const id of avail) {\n    const c = await o.cache.lookup(id, fps[id]);\n    if (c.status === 'hit') results[id] = c.result;\n    else { missing.push(id); if (c.status === 'stale') { stale.push({ id, changed: c.changed }); ev({ at: 'cache_stale', backend: id, changed: c.changed, text: id + ' 的硬體指紋改變（' + c.changed.join('、') + '），快取失效，需重新跑基準測試' }); } }\n  }\n  let source = missing.length ? 'benchmark' : 'cache';\n  if (missing.length && o.skipBench) {\n    // 略過基準：用 cpu-py（沒有就停下詢問，不拿未驗證的後端硬上）\n    ev({ at: 'bench_skipped', text: '略過基準測試，使用 cpu-py' });\n    if (probes['cpu-py'] && probes['cpu-py'].available) return { chosen: 'cpu-py', order: ['cpu-py'], source: 'skip-bench', needsRebench: true, stale, events };\n    return { chosen: null, order: [], ask: true, source: 'skip-bench', needsRebench: true, stale, events, reason: '略過基準測試時預設用 cpu-py，但它不可用：' + probes['cpu-py'].reason };\n  }\n  for (const id of missing) {\n    if (o.signal && o.signal.aborted) { ev({ at: 'bench_aborted', backend: id, text: '基準測試被中斷' }); return { chosen: null, order: [], aborted: true, source: 'benchmark', needsRebench: true, stale, events, reason: '基準測試被使用者中斷' }; }\n    let r; try { r = await o.runBench(id, o.signal); } catch (e) { r = { ok: false, error: String(e && e.message || e), reason: '基準測試丟出例外：' + (e && e.message || e) }; }\n    if (r && r.aborted) { ev({ at: 'bench_aborted', backend: id, text: '基準測試被中斷' }); return { chosen: null, order: [], aborted: true, source: 'benchmark', needsRebench: true, stale, events, reason: '基準測試被使用者中斷' }; }\n    if (!benchPassed(r)) ev({ at: 'bench_failed', backend: id, text: id + ' 基準測試未通過：' + (r && (r.reason || (r.numericCheck && r.numericCheck.failed && r.numericCheck.failed.join('、'))) || '未知原因') });\n    results[id] = r; await o.cache.store(id, fps[id], r);\n  }\n  const cands = avail.filter((id) => benchPassed(results[id]));\n  if (!cands.length) return { chosen: null, order: [], source, needsRebench: false, stale, events, reason: '可用的後端都沒通過基準測試／一致性檢查：' + avail.map((i) => i + '＝' + ((results[i] && (results[i].reason || (results[i].numericCheck && results[i].numericCheck.failed.join('、')))) || '無結果')).join('；') };\n  const speed = (id) => results[id].tokPerSec || 0, top = Math.max.apply(null, cands.map(speed));\n  const cmp = (a, b) => { const na = speed(a) >= top * (1 - TIE), nb = speed(b) >= top * (1 - TIE); if (na && nb) return B.maturityRank(a) - B.maturityRank(b) || speed(b) - speed(a); if (na !== nb) return na ? -1 : 1; return speed(b) - speed(a); };\n  const order = cands.slice().sort(cmp);\n  return { chosen: order[0], order, source, needsRebench: false, stale, events, table: avail.map((id) => ({ id, result: results[id], passed: benchPassed(results[id]) })) };\n}\n\n// ---- 失敗自動降級（訓練中後端失敗：已存檢查點，換下一個候選）----\nfunction degrade(o) {   // o: { order, failed, step, reason, pinned, log }\n  const log = o.log || (() => {});\n  if (o.pinned) { const m = '釘選的後端 ' + o.failed + ' 失敗（' + o.reason + '，step=' + o.step + '），已停下；要換成別的後端嗎？'; log({ at: 'pinned_failed', backend: o.failed, step: o.step, reason: o.reason, text: m }); return { stop: true, ask: m }; }\n  const rest = (o.order || []).filter((x) => x !== o.failed), to = rest[0];\n  if (!to) { const m = '後端 ' + o.failed + ' 失敗（' + o.reason + '，step=' + o.step + '），沒有可降級的候選'; log({ at: 'degrade_none', backend: o.failed, step: o.step, reason: o.reason, text: m }); return { stop: true, message: m }; }\n  const text = '由 ' + o.failed + ' 後端失敗降級到 ' + to + '，原因：' + o.reason + '，降級時 step=' + o.step;\n  log({ at: 'degrade', from: o.failed, to, step: o.step, reason: o.reason, text });\n  return { stop: false, to, order: rest, message: text, needsCrossBackendCheck: true };\n}\n\nmodule.exports = { BENCH, CONSIST, TIE, benchThreads, percentile, consistencyCheck, stepBenchmark, benchPassed, stableStringify, hashFingerprint, diffFingerprint, createBenchCache, autoSelect, degrade };\n","backend_cpu_js.js":"'use strict';\n// cpu-js 後端：純 JS 處理器計算（DESIGN.TODO.offline-training-studio.md §5.2、§5.3）。\n// 符號式五類（trainer／colu／uml／blockly／matrix）本來就是純 JS，只宣告這個後端；真正的訓練引擎由呼叫端用 engineFactory 注入。\n// 內建的「迷你訓練器」是真的 AdamW＋PCG32＋資料游標＋規範化檢查點計算（float32），但它是縮小版的 LoRA 形狀（pred = (x·A)·B），\n// 不是 Qwen3 的訓練：用途是 (1) 基準測試與一致性檢查的參考引擎、(2) 暫停／續訓與檢查點往返的模擬驗證。\nconst C = require('./checkpoint_core.js');\nconst B = require('./backend_core.js');\nconst BC = require('./bench_core.js');\nconst f = Math.fround;\n\nconst DEFAULTS = { dim: 8, rank: 2, nSamples: 16, batch: 1, lr: 0.01, betas: [0.9, 0.999], eps: 1e-8, wd: 0.01, warmup: 3, total: 200, dropout: 0.1, seed: 1234, dataSeed: 99, orderSeed: 7, seqLen: 256, evalBatch: [0, 1, 2, 3] };\n\nfunction makeData(cfg) {\n  const g = new C.PCG32(cfg.dataSeed, 3), w = []; for (let i = 0; i < cfg.dim; i++) w.push(g.nextNormal());\n  const X = [], Y = [];\n  for (let n = 0; n < cfg.nSamples; n++) { const x = []; let y = 0; for (let i = 0; i < cfg.dim; i++) { const v = f(g.nextNormal()); x.push(v); y += w[i] * v; } X.push(x); Y.push(f(y + 0.05 * g.nextNormal())); }\n  const sha = C.sha256(Buffer.from(JSON.stringify({ X, Y }))); return { X, Y, sha };\n}\nconst lrAt = (cfg, t) => cfg.warmup > 0 && t < cfg.warmup ? cfg.lr * (t + 1) / cfg.warmup : cfg.lr * Math.max(0.1, 1 - (t - cfg.warmup) / Math.max(1, cfg.total - cfg.warmup));\n\nfunction createTinyEngine(userCfg) {\n  const cfg = Object.assign({}, DEFAULTS, userCfg || {}), data = makeData(cfg), D = cfg.dim, R = cfg.rank;\n  const rng = new C.PCG32(cfg.seed, 11);\n  const A = new Float32Array(D * R).map(() => f(0.3 * rng.nextNormal())), Bm = new Float32Array(R);   // B 為零（LoRA 慣例）\n  const z = (n) => new Float32Array(n);\n  const st = { cfg, data, A, B: Bm, m: { A: z(D * R), B: z(R) }, v: { A: z(D * R), B: z(R) }, step: 0, cursor: C.createCursor(cfg.orderSeed), rng, lossTail: [], disposed: false };\n  return st;\n}\nfunction forward(st, xs, drop) {         // 回傳 pred 與中間量\n  const D = st.cfg.dim, R = st.cfg.rank, h = new Float32Array(R);\n  for (let j = 0; j < R; j++) { let s = 0; for (let i = 0; i < D; i++) if (i !== drop) s = f(s + f(xs[i] * st.A[i * R + j])); h[j] = s; }\n  let p = 0; for (let j = 0; j < R; j++) p = f(p + f(h[j] * st.B[j])); return { p, h };\n}\nfunction lossOver(st, idx) { let s = 0; idx.forEach((k) => { const e = forward(st, st.data.X[k], -1).p - st.data.Y[k]; s += e * e; }); return f(s / idx.length); }\nfunction tinyStep(st, batch) {\n  const cfg = st.cfg, D = cfg.dim, R = cfg.rank; let idx = batch && batch.indices;\n  if (!idx) { const r = C.nextIndices(st.cursor, cfg.nSamples, cfg.batch); idx = r.indices; st.cursor = r.cursor; }\n  st.cursor.consumed_tokens += cfg.seqLen * idx.length;\n  const drop = st.rng.nextFloat() < cfg.dropout ? st.rng.nextBelow(D) : -1;      // 亂數狀態會影響結果：續訓若沒還原就會偏掉\n  const gA = new Float32Array(D * R), gB = new Float32Array(R); let loss = 0;\n  idx.forEach((k) => {\n    const xs = st.data.X[k], fw = forward(st, xs, drop), e = f(fw.p - st.data.Y[k]); loss += e * e;\n    for (let j = 0; j < R; j++) { gB[j] = f(gB[j] + f(2 * e * fw.h[j] / idx.length)); for (let i = 0; i < D; i++) if (i !== drop) gA[i * R + j] = f(gA[i * R + j] + f(2 * e * st.B[j] * xs[i] / idx.length)); }\n  });\n  loss = f(loss / idx.length);\n  const t = st.step + 1, lr = lrAt(cfg, st.step), b1 = cfg.betas[0], b2 = cfg.betas[1];\n  const upd = (P, G, M, V) => { for (let i = 0; i < P.length; i++) { M[i] = f(b1 * M[i] + (1 - b1) * G[i]); V[i] = f(b2 * V[i] + (1 - b2) * G[i] * G[i]); const mh = M[i] / (1 - Math.pow(b1, t)), vh = V[i] / (1 - Math.pow(b2, t)); P[i] = f(P[i] - lr * cfg.wd * P[i] - lr * mh / (Math.sqrt(vh) + cfg.eps)); } };\n  let gn = 0; gA.forEach((x) => { gn += x * x; }); gB.forEach((x) => { gn += x * x; }); gn = f(Math.sqrt(gn));\n  upd(st.A, gA, st.m.A, st.v.A); upd(st.B, gB, st.m.B, st.v.B);\n  st.step = t; st.lossTail.push(loss); if (st.lossTail.length > 50) st.lossTail.shift();\n  return { loss, gradNorm: gn };\n}\nfunction tinySave(st, produced) {\n  const cfg = st.cfg, T = (name, shape, d) => [{ name, shape, data: d }];\n  const evalLoss = lossOver(st, cfg.evalBatch);\n  return C.makeCheckpoint({\n    step: st.step, epoch: st.cursor.epoch, cursor: Object.assign({}, st.cursor), rng: st.rng.snapshot(),\n    optimizer: { kind: 'adamw', lr: cfg.lr, betas: cfg.betas, eps: cfg.eps, wd: cfg.wd, step_count: st.step, schedule: { type: 'linear', warmup: cfg.warmup, total: cfg.total } },\n    data_sha256: st.data.sha, compat: compatOf(cfg), loss_tail: st.lossTail.slice(), eval_check: { batch: cfg.evalBatch, loss: evalLoss },\n    produced_by: Object.assign({ backend: 'cpu-js', device_fingerprint: 'js', engine_version: 'tiny-1', precision: 'float32' }, produced || {}),\n    tensors: { 'lora_A.f32': T('A', [cfg.dim, cfg.rank], st.A), 'lora_B.f32': T('B', [cfg.rank, 1], st.B), 'opt_m.f32': T('A', [cfg.dim, cfg.rank], st.m.A).concat(T('B', [cfg.rank, 1], st.m.B)), 'opt_v.f32': T('A', [cfg.dim, cfg.rank], st.v.A).concat(T('B', [cfg.rank, 1], st.v.B)) },\n  });\n}\nfunction compatOf(cfg) { return { base: 'tiny-lora', base_sha256: 'tiny', rank: cfg.rank, alpha: cfg.rank * 2, target_modules: ['A', 'B'], prompt_format_version: 1, tool_catalog_sha256: 'none' }; }\nfunction tinyLoad(st, cp) {\n  const v = C.verifyChecksums(cp); if (!v.ok) throw new Error('檢查點驗證失敗：' + v.bad.join('、'));\n  const cc = C.checkCompat(cp.ckpt, { compat: compatOf(st.cfg), data_sha256: st.data.sha, optimizer: { kind: 'adamw' } });\n  if (!cc.ok) { const e = new Error(cc.message); e.compat = cc; throw e; }\n  const d = (file) => C.decodeTensors(cp.files[file]), by = (l, n) => l.find((x) => x.name === n).data;\n  const a = d('lora_A.f32'), b = d('lora_B.f32'), m = d('opt_m.f32'), vv = d('opt_v.f32');\n  st.A.set(by(a, 'A')); st.B.set(by(b, 'B')); st.m.A.set(by(m, 'A')); st.m.B.set(by(m, 'B')); st.v.A.set(by(vv, 'A')); st.v.B.set(by(vv, 'B'));\n  st.step = cp.ckpt.step; st.cursor = Object.assign({}, cp.ckpt.cursor); st.rng = C.PCG32.fromSnapshot(cp.ckpt.rng); st.lossTail = (cp.ckpt.loss_tail || []).slice();\n}\n\n// engineFactory：符號式五類的真引擎由此注入，需提供 { step(batch), evalLoss(batch), save(), load(cp), dispose() }；預設為迷你訓練器\nfunction createCpuJsBackend(o) {\n  o = o || {};\n  const b = {\n    id: 'cpu-js', capabilities: { perStep: true, run: false, fp16: false }, kinds: B.KIND_BACKENDS,\n    async probe(ctx) {\n      const hw = (ctx && ctx.hw) || {};\n      return B.probeResult(true, '', { name: 'JavaScript 處理器計算', vendor: 'js', fp16: false }, { backend: 'cpu-js', cpu: hw.cpuModel || null, cores: hw.cores || null, engine_version: o.engineFactory ? 'injected' : 'tiny-1' });\n    },\n    async benchmark(cfg, opts) {\n      const c = Object.assign({}, cfg, { makeBatch: (i) => ({ indices: [i % ((cfg && cfg.nSamples) || DEFAULTS.nSamples)] }) });\n      return BC.stepBenchmark(b, c, Object.assign({}, opts, { isReference: !(opts && opts.reference) && !(opts && opts.fp16), tokensPerStep: (cfg && cfg.seqLen) || DEFAULTS.seqLen }));\n    },\n    async init(assetState, cfg) {\n      const st = o.engineFactory ? o.engineFactory(cfg) : createTinyEngine(cfg);\n      if (assetState && assetState.ckpt) { if (o.engineFactory) await st.load(assetState); else tinyLoad(st, assetState); }\n      return st;\n    },\n    async step(h, batch) { if (h.disposed) throw new Error('handle 已釋放'); return o.engineFactory ? h.step(batch) : tinyStep(h, batch); },\n    async evalLoss(h, batch) { if (o.engineFactory) return h.evalLoss(batch); return { loss: lossOver(h, (batch && batch.indices) || h.cfg.evalBatch) }; },\n    async saveCheckpoint(h) { return o.engineFactory ? h.save() : tinySave(h, o.produced); },\n    async loadCheckpoint(h, cp) { if (o.engineFactory) return h.load(cp); tinyLoad(h, cp); },\n    async dispose(h) { h.disposed = true; if (o.engineFactory && h.dispose) await h.dispose(); },\n    peakMemBytes() { return process.memoryUsage ? process.memoryUsage().rss : 0; },\n  };\n  return b;\n}\n\nmodule.exports = { createCpuJsBackend, createTinyEngine, tinyStep, tinySave, tinyLoad, lossOver, DEFAULTS, compatOf };\n","backend_cpu_py.js":"'use strict';\n// cpu-py 後端：桌面版以 Python 子行程呼叫 lora-train/train_lora.py（train.py 的 sft 階段呼叫的同一支訓練腳本；\n// train.py 本身是七階段管線、沒有步數／檢查點控制，所以 Studio 直接呼叫 train_lora.py）。\n// 純核心、依賴注入：偵測 Python、啟動子行程、檔案系統、時鐘都由呼叫端給，測試時全用假的。子行程一律 windowsHide:true。\nconst B = require('./backend_core.js');\nconst BC = require('./bench_core.js');\nconst C = require('./checkpoint_core.js');\nconst SC = require('./studio_config_core.js');\n\n// Python 探測順序：① lora-train/.venv（開發目錄與使用者資料夾，opts.venvDirs）② PATH 上的 python／python3／py ③ py 啟動器列出的各版本（py -0p）。\n// 只接受 3.11 以上（transformers 5.x 的要求）；挑第一個套件齊全的，沒有就挑第一個 3.11 以上的（讓 probe 說缺哪些套件）。\n// 回 { found, path, version, packages, tooOld?:版本, tried:[...] }；spawnSync、fs 可注入，測試不碰真的行程。\nconst MIN_PY = [3, 11];\nconst PY_PKGS = ['torch', 'transformers', 'peft'];\nfunction pyOk(v) { const m = /^(\\d+)\\.(\\d+)/.exec(String(v || '')); return !!m && (+m[1] > MIN_PY[0] || (+m[1] === MIN_PY[0] && +m[2] >= MIN_PY[1])); }\nfunction venvPythons(dirs, P, plat) {\n  const out = []; (dirs || []).forEach((d) => { if (!d) return; out.push(plat === 'win32' ? P.join(d, '.venv', 'Scripts', 'python.exe') : P.join(d, '.venv', 'bin', 'python')); });\n  return out.filter((x, i) => out.indexOf(x) === i);\n}\nfunction defaultDetect(spawnSync, opts) {\n  opts = opts || {}; const P = opts.path || require('path'), plat = opts.platform || process.platform;\n  const exists = (f) => { try { return (opts.fs || require('fs')).existsSync(f); } catch (e) { return false; } };\n  // spawnSync 可以是同步函式（測試用的假的）或回 Promise 的非同步執行器（主行程用：不阻塞主行程的事件迴圈）\n  return async function detect() {\n    // 用 importlib.metadata 讀套件版本，不 import torch（光 import torch 在這台就要十幾秒）\n    const code = \"import sys,json\\nfrom importlib import metadata as md\\nr={'version':sys.version.split()[0],'packages':{}}\\nfor m in ('torch','transformers','peft'):\\n    try:\\n        r['packages'][m]=md.version(m)\\n    except Exception:\\n        r['packages'][m]=None\\nprint(json.dumps(r))\";\n    const cands = venvPythons(typeof opts.venvDirs === 'function' ? opts.venvDirs() : opts.venvDirs, P, plat).filter(exists);\n    ['python', 'python3', 'py'].forEach((c) => cands.push(c));\n    // 2026-11-12：Ubuntu 22.04 的 python3 是 3.10，但常同時裝有 python3.11／3.12／3.13（遠端機 192.168.21.186 就是 python3.11 + venv）——只試 python3 會誤判「版本太舊」。Linux／macOS 也試帶版本號的指令。\n    if (plat !== 'win32') ['python3.13', 'python3.12', 'python3.11'].forEach((c) => { if (cands.indexOf(c) < 0) cands.push(c); });\n    const tmo = opts.timeoutMs || 8000;   // 單項探測逾時\n    try {   // py 啟動器列出的各版本（py -0p 每行最後一欄是路徑）\n      const l = await spawnSync('py', ['-0p'], { encoding: 'utf8', windowsHide: true, timeout: 5000 });\n      if (l && !l.error && l.status === 0) String(l.stdout).split(/\\r?\\n/).forEach((ln) => { const m = /(?:^|\\s)([A-Za-z]:[\\\\/].*python[0-9.]*\\.exe)\\s*$/i.exec(ln.trim()); if (m && cands.indexOf(m[1]) < 0) cands.push(m[1]); });\n    } catch (e) {}\n    // 結果快取：鍵＝python 絕對路徑＋執行檔與 site-packages 的修改時間（裝／卸套件會變）；只對絕對路徑的候選用\n    const stat = (f2) => { try { return (opts.fs || require('fs')).statSync(f2).mtimeMs; } catch (e) { return 0; } };\n    // 套件夾的修改時間：Windows venv 是 Lib/site-packages，Linux／macOS 是 lib/python3.x/site-packages（版本號資料夾要列出來才知道）。\n    // 2026-11-12：只看 Windows 的 Lib → Linux 上裝了 torch／transformers／peft 後快取鍵不變，一直顯示「缺少套件」或舊的「版本太舊」，使用者裝好了還是不認。\n    const siteMtime = (cmd) => {\n      const base = P.join(P.dirname(cmd), '..'); let m = stat(P.join(base, 'Lib', 'site-packages'));\n      try { const F = opts.fs || require('fs'); const ld = P.join(base, 'lib'); if (F.readdirSync) (F.readdirSync(ld) || []).filter((x) => /^python3/.test(x)).forEach((x) => { m += stat(P.join(ld, x, 'site-packages')); }); } catch (e) { /* 沒有 lib 資料夾（Windows 或不是 venv）：只用上面的 */ }\n      return m;\n    };\n    const keyOf = (cmd) => (P.isAbsolute && P.isAbsolute(cmd)) ? cmd + '|' + stat(cmd) + '|' + siteMtime(cmd) : null;\n    const tried = [], good = []; let tooOld = null;\n    for (const cmd of cands) {\n      try {\n        const key = opts.cache ? keyOf(cmd) : null; let j = key ? opts.cache.get(key) : null; const fromCache = !!j;\n        if (!j) {\n          const r = await spawnSync(cmd, ['-I', '-c', code], { encoding: 'utf8', windowsHide: true, timeout: tmo });\n          if (!r || r.error || r.status !== 0) { const why = r && r.error && /ETIMEDOUT/.test(String(r.error.code || r.error.message)) ? '逾時（' + Math.round(tmo / 1000) + ' 秒內沒回應）' : (r && r.error ? String(r.error.code || r.error.message) : '結束碼 ' + (r && r.status)); tried.push({ path: cmd, error: why }); continue; }\n          j = JSON.parse(String(r.stdout).trim().split('\\n').pop());\n          // 套件還不齊的結果不快取（使用者看到「缺少套件」之後馬上就會去裝；快取住就會一直顯示舊結果）；齊全的、或 Python 太舊的才快取\n          if (key && (!pyOk(j.version) || PY_PKGS.every((k) => j.packages && j.packages[k]))) opts.cache.set(key, j);\n        }\n        tried.push({ path: cmd, version: j.version, cached: fromCache });\n        if (!pyOk(j.version)) { tooOld = tooOld || j.version; continue; }\n        const res = { found: true, path: cmd, version: j.version, packages: j.packages };\n        if (PY_PKGS.every((k) => j.packages && j.packages[k])) return Object.assign(res, { tried });\n        good.push(res);\n      } catch (e) { tried.push({ path: cmd, error: String(e && e.message || e) }); }\n    }\n    if (good.length) return Object.assign(good[0], { tried });\n    return { found: false, tooOld, tried };\n  };\n}\n\nfunction triedNote(d) { const e = d && d.tried ? d.tried.filter((x) => x.error) : []; return e.length ? '探測失敗項目：' + e.map((x) => x.path + '（' + x.error + '）').join('、') + '。' : ''; }\n\n// 沒有可用環境時 probe 的說明與要執行的安裝指令\nfunction installHint(loraDir, plat) {\n  const d = loraDir || 'lora-train', v = d + '/.venv';\n  // 平台：呼叫端給的 > 依資料夾路徑長相判斷（C:\\ 或反斜線＝Windows，其餘＝Linux／macOS）。\n  // 2026-11-12 兩次事故：(1) Ubuntu 使用者看到 Windows 的 py -3.13／Scripts\\python.exe；(2) 指令之間用了全形分號「；」，整段貼進終端機不能執行。\n  // 規則：指令一律獨立一行、只用 ASCII（半形標點，用 && 串接，路徑用半形雙引號），中文說明另起一行，絕不跟指令混在同一行。\n  const win = plat ? plat === 'win32' : /^[A-Za-z]:|\\\\/.test(d);\n  const need = '需要 Python 3.11 以上與 torch／transformers／peft，建議在 lora-train/.venv 安裝。安裝指令（整行複製貼上）：';\n  const idx = 'https://download.pytorch.org/whl/cpu';\n  if (win) {\n    const py = v + '/Scripts/python.exe';\n    return need + '\\n' + 'py -3.13 -m venv \"' + v + '\" && \"' + py + '\" -m pip install torch --extra-index-url ' + idx\n      + ' && \"' + py + '\" -m pip install -r \"' + d + '/requirements.txt\" --extra-index-url ' + idx;\n  }\n  const py = v + '/bin/python';\n  // Linux／macOS：系統的 python3 常常太舊（Ubuntu 22.04 是 3.10，預設套件庫沒有 python3.13）。用 uv 自己抓 Python 3.13（不用 sudo、不動系統 Python）；備案是 Ubuntu 的 deadsnakes PPA\n  return need + '\\n'\n    + 'curl -LsSf https://astral.sh/uv/install.sh | sh && export PATH=\"$HOME/.local/bin:$PATH\" && uv venv --python 3.13 \"' + v + '\" && uv pip install --python \"' + py + '\" torch --index-url ' + idx\n    + ' && uv pip install --python \"' + py + '\" -r \"' + d + '/requirements.txt\" --extra-index-url ' + idx\n    + '\\n備案（Ubuntu，用 deadsnakes 套件庫，需要管理員權限；一樣整行複製貼上）：\\n'\n    + 'sudo add-apt-repository -y ppa:deadsnakes/ppa && sudo apt update && sudo apt install -y python3.13 python3.13-venv && python3.13 -m venv \"' + v + '\" && \"' + py + '\" -m pip install torch --extra-index-url ' + idx\n    + ' && \"' + py + '\" -m pip install -r \"' + d + '/requirements.txt\" --extra-index-url ' + idx;\n}\n\n// 解析 train_lora.py（HF Trainer）印出的一行：log 字典、評估、tqdm 進度、[done]、[paused]\nfunction parseProgressLine(line) {\n  let s = String(line).trim(); if (!s) return null;\n  let m;\n  // transformers 5.x 的 log 字典常接在進度條文字後面（同一行），數值是帶引號的字串\n  if ((m = /(\\{'[A-Za-z_].*\\})\\s*$/.exec(s))) s = m[1];\n  if ((m = s.match(/^\\{.*\\}$/))) {\n    const o = {}; const re = /'([A-Za-z_]+)':\\s*'?(-?[0-9.]+(?:e[-+]?[0-9]+)?|nan|inf)'?/gi; let k;\n    while ((k = re.exec(s))) o[k[1]] = /nan|inf/i.test(k[2]) ? NaN : parseFloat(k[2]);\n    if (o.eval_loss !== undefined) return { type: 'eval', evalLoss: o.eval_loss, epoch: o.epoch };\n    if (o.loss !== undefined || o.train_loss !== undefined) return { type: 'log', loss: o.loss !== undefined ? o.loss : o.train_loss, gradNorm: o.grad_norm, lr: o.learning_rate, epoch: o.epoch };\n    return null;\n  }\n  if ((m = s.match(/(\\d+)\\/(\\d+)\\s*\\[[^\\]]*?(?:,\\s*([\\d.]+)(s\\/it|it\\/s))?\\]/))) return { type: 'progress', step: +m[1], total: +m[2], secPerIt: m[3] ? (m[4] === 'it/s' ? 1 / parseFloat(m[3]) : parseFloat(m[3])) : null };\n  if ((m = s.match(/^\\[paused\\]\\s*step=(\\d+)/))) return { type: 'paused', step: +m[1] };\n  if ((m = s.match(/^\\[done\\]\\s*adapter saved to\\s*(.+)$/))) return { type: 'done', dir: m[1] };\n  if (/^(Traceback|[A-Za-z]*Error:|torch\\.cuda|RuntimeError)/.test(s)) return { type: 'error', text: s };\n  return null;\n}\n\n// ---- safetensors（JS 可讀，用來把 HF 檢查點的 LoRA 權重轉成規範化 float32）----\nfunction f16(h) { const s = (h & 0x8000) >> 15, e = (h & 0x7c00) >> 10, f = h & 0x03ff; if (e === 0) return (s ? -1 : 1) * Math.pow(2, -14) * (f / 1024); if (e === 31) return f ? NaN : (s ? -Infinity : Infinity); return (s ? -1 : 1) * Math.pow(2, e - 15) * (1 + f / 1024); }\nfunction readSafetensors(buf) {\n  const hl = Number(buf.readBigUInt64LE(0)), head = JSON.parse(buf.subarray(8, 8 + hl).toString('utf8')), base = 8 + hl, out = [];\n  Object.keys(head).forEach((name) => {\n    if (name === '__metadata__') return; const t = head[name], [a, b] = t.data_offsets, n = t.shape.reduce((x, y) => x * y, 1), d = new Float32Array(n);\n    for (let i = 0; i < n; i++) {\n      if (t.dtype === 'F32') d[i] = buf.readFloatLE(base + a + i * 4);\n      else if (t.dtype === 'F16') d[i] = f16(buf.readUInt16LE(base + a + i * 2));\n      else if (t.dtype === 'BF16') { const x = Buffer.alloc(4); x.writeUInt16LE(buf.readUInt16LE(base + a + i * 2), 2); d[i] = x.readFloatLE(0); }\n      else throw new Error('不支援的 safetensors dtype ' + t.dtype);\n    }\n    out.push({ name, shape: t.shape, data: d, srcDtype: t.dtype });\n  });\n  return out;\n}\nfunction loraTensors(list) {   // 依名稱分成 A／B，名稱保留層名（規範化檔內依名稱排序）\n  const A = [], Bt = []; list.forEach((t) => { if (/lora_A/.test(t.name)) A.push(t); else if (/lora_B/.test(t.name)) Bt.push(t); });\n  return { 'lora_A.f32': A, 'lora_B.f32': Bt };\n}\n\nconst NO_STEP = 'cpu-py 是整段訓練的子行程，不支援逐步呼叫；請用 startRun（暫停＝寫檢查點後結束子行程，續訓＝--resume_from_checkpoint）';\n\n// o: { detect, spawn, killTree, fs(existsSync/readdirSync/writeFileSync/readFileSync/unlinkSync/mkdirSync), path, loraDir, now, sleep, hw:{cpuModel,cores} }\nfunction createCpuPyBackend(o) {\n  const P = o.path || require('path'), now = o.now || (() => Date.now()), sleep = o.sleep || ((ms) => new Promise((r) => setTimeout(r, ms)));\n  const script = () => P.join(o.loraDir, 'train_lora.py');\n  const b = {\n    id: 'cpu-py', capabilities: { perStep: false, run: true, fp16: false },\n    async probe() {\n      let d; try { d = await o.detect(); } catch (e) { d = { found: false, error: String(e && e.message || e) }; }\n      const hw = o.hw || {};\n      const fp = { backend: 'cpu-py', cpu: hw.cpuModel || null, cores: hw.cores || null, python_version: d.version || null, torch_version: d.packages && d.packages.torch || null, engine_version: 'train_lora.py' };\n      const dev = { name: hw.cpuModel || 'CPU', vendor: 'cpu', fp16: false };\n      if (!d || !d.found) return B.probeResult(false, (d && d.tooOld ? '找到的 Python 版本太舊（' + d.tooOld + '）。' : '找不到 Python。') + triedNote(d) + installHint(o.loraDir, o.platform) + '；或改匯出訓練包到別台訓練', dev, fp);\n      const missing = ['torch', 'transformers', 'peft'].filter((k) => !(d.packages && d.packages[k]));\n      if (missing.length) return B.probeResult(false, '已找到 Python ' + d.version + (d.path ? '（' + d.path + '）' : '') + '，但缺少套件：' + missing.join('、') + '。' + installHint(o.loraDir, o.platform), dev, fp);\n      if (!o.fs.existsSync(script())) return B.probeResult(false, '找不到訓練腳本 ' + script(), dev, fp);\n      return B.probeResult(true, '', dev, fp);\n    },\n    buildArgs(cfg) {\n      const a = [script(), '--model_name_or_path', cfg.base || 'Qwen/Qwen3-0.6B', '--train_file', cfg.trainFile, '--output_dir', cfg.outputDir];\n      const add = (k, v) => { if (v !== undefined && v !== null && v !== '') a.push(k, String(v)); };\n      add('--num_train_epochs', cfg.epochs); add('--learning_rate', cfg.lr); add('--lora_r', cfg.rank); add('--lora_alpha', cfg.alpha);\n      add('--per_device_train_batch_size', cfg.batch); add('--gradient_accumulation_steps', cfg.accum); add('--max_steps', cfg.maxSteps);\n      add('--save_steps', cfg.saveSteps); add('--logging_steps', cfg.loggingSteps === undefined ? 1 : cfg.loggingSteps); add('--seed', cfg.seed); add('--max_seq_len', cfg.seqLen);\n      add('--val_fraction', cfg.valFraction); add('--stop_file', cfg.stopFile); add('--resume_from_checkpoint', cfg.resumeFrom);\n      return a;\n    },\n    // 電腦要保持可用：留一個核心、不彈視窗\n    // 核心數：cfg.threads（明確指定）＞ Studio 設定（o.config，見 studio_config_core.js）＞ 預設 N−1\n    buildEnv(cfg) { const cores = (o.hw && o.hw.cores) || 2; return { LORA_THREADS: String(cfg.threads || SC.resolveThreads(o.config, cores, cfg.purpose)), PYTHONUNBUFFERED: '1' }; },\n    latestCheckpoint(dir) {\n      if (!o.fs.existsSync(dir)) return null; let best = null;\n      o.fs.readdirSync(dir).forEach((n) => { const m = /^checkpoint-(\\d+)$/.exec(n); if (m && (!best || +m[1] > best.step)) best = { step: +m[1], dir: P.join(dir, n) }; });\n      return best;\n    },\n    // 啟動一次訓練（或續訓）。回傳 run：{ pause(), stop(), done:Promise, events }\n    async startRun(cfg, hooks) {\n      hooks = hooks || {}; const stopFile = cfg.stopFile || P.join(cfg.outputDir, 'PAUSE');\n      try { if (o.fs.existsSync(stopFile)) o.fs.unlinkSync(stopFile); } catch (e) {}\n      const c = Object.assign({}, cfg, { stopFile });\n      const py = (await o.detect()).path || 'python';\n      const child = o.spawn(py, b.buildArgs(c), { cwd: o.loraDir, env: Object.assign({}, o.env || {}, b.buildEnv(c)), windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] });\n      const run = { child, state: 'running', lastStep: 0, lastLoss: null, errors: [], events: 0, startedAt: now(), exitCode: null, pausedAtStep: null };\n      // 真實紀錄（給流程總覽讀）：日誌逐行寫進 <outputDir>/train.log，子行程 pid 寫進 run.pid；寫不了不影響訓練\n      try { o.fs.mkdirSync(cfg.outputDir, { recursive: true }); o.fs.writeFileSync(P.join(cfg.outputDir, 'run.pid'), String(child.pid || '')); } catch (e) { /* 忽略 */ }\n      const appendLog = (l) => { try { o.fs.appendFileSync(P.join(cfg.outputDir, 'train.log'), l + '\\n'); } catch (e) { /* 忽略 */ } };\n      let buf = ''; const feed = (chunk) => { buf += String(chunk).replace(/\\r/g, '\\n'); const parts = buf.split('\\n'); buf = parts.pop(); parts.forEach((l) => { appendLog(l); const e = parseProgressLine(l); if (!e) return; run.events++; e.t = now(); if (e.type === 'progress') run.lastStep = e.step; if (e.type === 'log') { run.lastLoss = e.loss; } if (e.type === 'paused') run.pausedAtStep = e.step; if (e.type === 'error') run.errors.push(e.text); if (hooks.onEvent) hooks.onEvent(e); }); };\n      child.stdout && child.stdout.on('data', feed); child.stderr && child.stderr.on('data', feed);\n      run.done = new Promise((res) => { child.on('exit', (code, sig) => { if (buf) feed('\\n'); run.exitCode = code; run.state = run.state === 'pausing' ? 'paused' : run.state === 'stopping' ? 'stopped' : (code === 0 ? 'finished' : 'failed'); res({ state: run.state, exitCode: code, signal: sig, errors: run.errors }); }); child.on('error', (e) => { run.errors.push(String(e && e.message || e)); run.state = 'failed'; res({ state: 'failed', exitCode: null, errors: run.errors }); }); });\n      const kill = () => { try { (o.killTree || ((c2) => c2.kill()))(child); } catch (e) {} };\n      // 暫停：建立 stop_file，訓練腳本在下一個優化步後存檢查點並結束；逾時就強制結束子行程並回報檢查點可能不是最新\n      run.pause = async (timeoutMs) => {\n        run.state = 'pausing'; try { o.fs.mkdirSync(cfg.outputDir, { recursive: true }); } catch (e) {} o.fs.writeFileSync(stopFile, 'pause');\n        const t0 = now(); let forced = false;\n        const limit = timeoutMs === undefined ? 120000 : timeoutMs;\n        while (run.exitCode === null && run.state === 'pausing' && now() - t0 < limit) { const r = await Promise.race([run.done, sleep(200).then(() => null)]); if (r) break; }\n        if (run.exitCode === null && run.state === 'pausing') { forced = true; kill(); await run.done; run.state = 'paused'; }\n        try { o.fs.unlinkSync(stopFile); } catch (e) {}\n        const ck = b.latestCheckpoint(cfg.outputDir);\n        return { ok: !!ck, forced, checkpoint: ck, step: ck ? ck.step : null, reason: ck ? (forced ? '逾時強制結束，檢查點可能不是最新（最近一個在 step ' + ck.step + '）' : '') : '沒有找到檢查點（checkpoint-N）：還沒到 save_steps 就暫停，無法續訓，只能重來' };\n      };\n      run.stop = async () => { run.state = 'stopping'; kill(); return run.done; };\n      return run;\n    },\n    // 續訓：從輸出資料夾最新的 checkpoint-N 繼續（Trainer 會還原優化器、排程、亂數與資料位置）\n    async resumeRun(cfg, hooks) {\n      const ck = b.latestCheckpoint(cfg.outputDir); if (!ck) throw new Error('找不到 checkpoint-N，無法續訓：' + cfg.outputDir);\n      return b.startRun(Object.assign({}, cfg, { resumeFrom: ck.dir }), hooks);\n    },\n    // 基準測試：小資料、max_steps = 暖機 + 30，從 log 事件的時間差算步時間；中斷／超時就結束子行程\n    async benchmark(cfg, opts) {\n      opts = opts || {}; const signal = opts.signal, warm = BC.BENCH.warmup, steps = BC.BENCH.steps, deadline = opts.deadlineMs === undefined ? BC.BENCH.deadlineMs : opts.deadlineMs, t0 = now();\n      const stamps = [], losses = []; let nonFinite = false, run = null, aborted = false, tooSlow = false, abortedAt = null;\n      try {\n        run = await b.startRun(Object.assign({}, cfg, { maxSteps: warm + steps, saveSteps: 100000, loggingSteps: 1, batch: BC.BENCH.batch, seqLen: BC.BENCH.seqLen, valFraction: 0, purpose: 'benchmark' }), { onEvent: (e) => { if (e.type === 'log') { stamps.push(e.t); losses.push(e.loss); if (!Number.isFinite(e.loss) || (e.gradNorm !== undefined && !Number.isFinite(e.gradNorm))) nonFinite = true; } } });\n        const onAbort = () => { if (abortedAt === null) { abortedAt = now(); aborted = true; run.stop(); } };\n        if (signal) { if (signal.aborted) onAbort(); else if (signal.addEventListener) signal.addEventListener('abort', onAbort, { once: true }); }\n        while (run.state === 'running') { const r = await Promise.race([run.done, sleep(100).then(() => null)]); if (r) break; if (now() - t0 > deadline) { tooSlow = true; await run.stop(); break; } }\n        await run.done;\n      } catch (e) { return { ok: false, error: String(e && e.message || e), reason: '基準測試失敗：' + (e && e.message || e), elapsedMs: now() - t0 }; }\n      if (aborted) return { ok: false, aborted: true, stoppedAfterMs: now() - abortedAt, elapsedMs: now() - t0, reason: '使用者中斷' };\n      if (tooSlow) return { ok: false, tooSlow: true, reason: '太慢：超過 ' + Math.round(deadline / 1000) + ' 秒仍未跑完 ' + (warm + steps) + ' 步', elapsedMs: now() - t0 };\n      if (run.state !== 'finished' || stamps.length < warm + 2) return { ok: false, error: run.errors.join(' | '), reason: '訓練子行程' + (run.state === 'finished' ? '輸出的 log 太少' : '失敗') + (run.errors.length ? '：' + run.errors[0] : ''), elapsedMs: now() - t0 };\n      const times = []; for (let i = warm + 1; i < stamps.length; i++) times.push(stamps[i] - stamps[i - 1]);\n      const sorted = times.slice().sort((x, y) => x - y), med = BC.percentile(sorted, 0.5), tokens = BC.BENCH.seqLen * BC.BENCH.batch;\n      const peak = o.peakMem ? await o.peakMem(run) : null;\n      // cpu-py 就是數值參考：只檢查全程無 NaN／Inf\n      return { ok: true, tokPerSec: med > 0 ? tokens / (med / 1000) : 0, peakMemBytes: peak, stepMsP50: med, stepMsP95: BC.percentile(sorted, 0.95), samples: times.length, elapsedMs: now() - t0, threads: Number(b.buildEnv(Object.assign({}, cfg, { purpose: 'benchmark' })).LORA_THREADS), trace: { loss1: losses[0], gradNorm1: null, loss30: losses[losses.length - 1], hasNonFinite: nonFinite }, numericCheck: { pass: !nonFinite, maxRelErr: 0, lossDelta: 0, reference: true, items: [], failed: nonFinite ? ['全程無NaN或Inf'] : [] } };\n    },\n    async init() { throw new Error(NO_STEP); },\n    async step() { throw new Error(NO_STEP); },\n    async evalLoss() { throw new Error(NO_STEP); },\n    async dispose(h) { if (h && h.run && h.run.state === 'running') await h.run.stop(); },\n    // 把 HF 檢查點的 LoRA 權重轉成規範化 float32。優化器張量在 torch 專有的 optimizer.pt（JS 讀不了），所以 opt_m／opt_v 標為缺少\n    async saveCheckpoint(h) {\n      const ck = b.latestCheckpoint(h.outputDir); if (!ck) throw new Error('沒有 checkpoint-N 可轉換');\n      const st = o.fs.readFileSync(P.join(ck.dir, 'adapter_model.safetensors')), tensors = loraTensors(readSafetensors(st));\n      let state = {}; try { state = JSON.parse(o.fs.readFileSync(P.join(ck.dir, 'trainer_state.json'), 'utf8')); } catch (e) {}\n      const hist = (state.log_history || []).filter((x) => x.loss !== undefined).map((x) => x.loss);\n      const cp = C.makeCheckpoint({ step: ck.step, epoch: state.epoch || 0, cursor: Object.assign(C.createCursor(h.cfg && h.cfg.seed || 0), { consumed_tokens: 0 }), rng: new C.PCG32(h.cfg && h.cfg.seed || 0, 11).snapshot(),\n        optimizer: Object.assign({ kind: 'adamw', lr: h.cfg && h.cfg.lr, step_count: ck.step }, { state: 'native-only' }), data_sha256: h.dataSha256 || '', compat: h.compat || {}, loss_tail: hist,\n        produced_by: { backend: 'cpu-py', device_fingerprint: (o.hw && o.hw.cpuModel) || '', engine_version: 'train_lora.py', precision: 'float32', native_dir: ck.dir }, tensors });\n      cp.ckpt.notes = ['優化器張量（optimizer.pt）為 torch 格式，JS 讀不了：換到別的後端續訓時優化器動量會重置；同為 cpu-py 時用 native_dir 的原生檢查點續訓（resumeRun）'];\n      return cp;\n    },\n    async loadCheckpoint() { throw new Error('無法由規範化檢查點在 cpu-py 重建 Trainer 狀態：優化器為 torch 專有格式，且 train_lora.py 還沒有 --init_adapter；同後端續訓請用 resumeRun（原生 checkpoint-N）'); },\n  };\n  return b;\n}\n\nmodule.exports = { createCpuPyBackend, defaultDetect, pyOk, installHint, parseProgressLine, readSafetensors, loraTensors, NO_STEP };\n","backend_planned.js":"'use strict';\n// webgpu／directml／vulkan：先登錄為「尚未實作」，probe 回 §5.2 的具體阻礙，不假裝可用。所有操作方法都拒絕並說明原因。\nconst B = require('./backend_core.js');\n\nconst BLOCKERS = {\n  'wasm-web': { reason: 'wasm-web（WebAssembly 處理器訓練）由渲染行程／網頁版的 Studio 執行（onnxruntime-web 在頁面內），桌面版主程序不載入它；桌面版請用 cpu-py', unblock: '桌面版沒有此需求；網頁版由 backend_wasm_web.js 在頁面內註冊' },\n  webgpu: { reason: 'WebGPU 尚未點亮：反向圖產生器已完成並在本機 WebGPU 上單層與 WASM 一致（basic 最佳化；DequantizeLinear 與最佳化全關在 WebGPU 會算錯，已改寫避開），但逐層引擎尚未在 WebGPU 跑完整 28 層、沒有速度與記憶體數字（見 DESIGN.TODO.offline-training-studio.md §5.6）', unblock: '階段 4 (a)→(b)→(c) 依序通過：單層梯度 ≤1e-3、區塊 ≤5e-3、全模型 20 步 loss 與 cpu-py 差 ≤2%' },\n  directml: { reason: 'DirectML 尚未實作：onnxruntime 的 DirectML 只做推論，且 qwen3-0.6b 在 onnxruntime-node 1.22.0／1.31.1 於 SkipSimplifiedLayerNormalization 節點 E_INVALIDARG；torch-directml 能否跑 LoRA 反向未驗證', unblock: '在隔離資料夾實測 torch-directml 跑通 train_lora.py 前向／反向且與 CPU 數值對得上（階段 5，下載前需使用者同意）' },\n  vulkan: { reason: 'Vulkan 後端尚未實作：llama.cpp 的 Vulkan LoRA 微調是否進主線、是否支援 Qwen3、所需算子（OUT_PROD、OPT_STEP_ADAMW）是否有 Vulkan 實作都未驗證，且輸出的 GGUF adapter 還沒有轉成 safetensors／ONNX LoRA 的轉換器', unblock: '讀上游原始碼與 PR 確認算子、在隔離資料夾跑通一次小訓練並與 cpu-py 對拍（階段 5，下載前需使用者同意）' },\n};\n\nfunction createPlannedBackend(id, o) {\n  const bl = BLOCKERS[id]; if (!bl) throw new Error('不是登錄中的規劃後端：' + id);\n  const no = async () => { throw new Error(id + ' 尚未實作：' + bl.reason); };\n  return {\n    id, planned: true, blocker: bl, capabilities: { perStep: true, run: false, fp16: true },\n    async probe(ctx) {\n      // 環境偵測可由呼叫端注入（例如瀏覽器有無 navigator.gpu），僅補充到 device，不改變「尚未實作」的結論\n      let env = null; try { env = o && o.envProbe ? await o.envProbe(id, ctx) : null; } catch (e) {}\n      return B.probeResult(false, bl.reason, { name: (env && env.name) || '', vendor: (env && env.vendor) || '' }, Object.assign({ backend: id, engine_version: 'not-implemented' }, env && env.fingerprint));\n    },\n    async benchmark() { return { ok: false, reason: bl.reason, numericCheck: { pass: false, failed: ['尚未實作'] } }; },\n    init: no, step: no, evalLoss: no, saveCheckpoint: no, loadCheckpoint: no,\n    async dispose() {},\n  };\n}\nconst createWebgpuBackend = (o) => createPlannedBackend('webgpu', o), createDirectmlBackend = (o) => createPlannedBackend('directml', o), createVulkanBackend = (o) => createPlannedBackend('vulkan', o);\n\nmodule.exports = { BLOCKERS, createPlannedBackend, createWebgpuBackend, createDirectmlBackend, createVulkanBackend };\n","checkpoint_core.js":"'use strict';\n// 規範化 float32 檢查點（DESIGN.TODO.offline-training-studio.md §3.1）：與後端無關的暫停／續訓格式。\n// 純核心、不碰 window／檔案系統：檔案以 { 檔名: Buffer } 表示，由呼叫端決定存到記憶體或資料夾。\n// 瀏覽器可用：不再硬依賴 Node 的 crypto／Buffer（網頁版 wasm-web 後端要在頁面內存取檢查點）。Node 下仍優先用 crypto 與 Buffer，行為不變。\nlet crypto = null; try { crypto = require('crypto'); } catch (e) { crypto = null; }\nlet Asset = null; try { Asset = require('./asset_core.js'); } catch (e) { Asset = null; }   // 只有沒有 Node crypto 時（瀏覽器）才用它的純 JS sha256；主行程嵌入版可以沒有這個檔\nconst hasBuf = typeof Buffer !== 'undefined';\nconst newBytes = (n) => (hasBuf ? Buffer.alloc(n) : new Uint8Array(n));\nconst u8of = (x) => (x instanceof Uint8Array ? x : new Uint8Array(x));\nconst textBytes = (str) => (hasBuf ? Buffer.from(str, 'utf8') : new TextEncoder().encode(str));\n\nconst FORMAT = 'fa-ckpt', VERSION = 1;\nconst TENSOR_FILES = ['lora_A.f32', 'lora_B.f32', 'opt_m.f32', 'opt_v.f32'];\n// 續訓相容欄位：任一不符就拒絕續訓、提示以新資產 fork（後端與裝置不在其中，允許不同，只記錄）\nconst COMPAT_FIELDS = ['base', 'base_sha256', 'rank', 'alpha', 'target_modules', 'prompt_format_version', 'tool_catalog_sha256'];\nconst TOL = { sameBackend: 1e-5, crossBackend: 0.02, crossBackendFp16: 0.05 };\n\nconst sha256 = (buf) => (crypto && crypto.createHash ? crypto.createHash('sha256').update(buf).digest('hex') : (function () { if (!Asset) throw new Error('沒有可用的 sha256（需要 Node crypto 或 asset_core.js）'); return Asset.sha256Hex(u8of(buf)); })());\n\n// ---- 與後端無關的亂數：PCG32（標準 XSH-RR 輸出，64 位元狀態用 BigInt） ----\nconst M64 = (1n << 64n) - 1n, MULT = 6364136223846793005n;\nclass PCG32 {\n  constructor(seed, seq) {\n    this.inc = ((BigInt(seq === undefined ? 54 : seq) << 1n) | 1n) & M64; this.state = 0n; this._adv();\n    this.state = (this.state + BigInt.asUintN(64, BigInt(seed))) & M64; this._adv();\n  }\n  _adv() { this.state = (this.state * MULT + this.inc) & M64; }\n  nextU32() {\n    const old = this.state; this._adv();\n    const xs = Number((((old >> 18n) ^ old) >> 27n) & 0xffffffffn), rot = Number(old >> 59n);\n    return ((xs >>> rot) | (xs << ((32 - rot) & 31))) >>> 0;\n  }\n  nextFloat() { return this.nextU32() / 4294967296; }                       // [0,1)\n  nextBelow(n) { const th = (4294967296 - n) % n; for (;;) { const r = this.nextU32(); if (r >= th) return r % n; } }   // 無偏差\n  nextNormal() { const u = this.nextFloat() || 1e-12, v = this.nextFloat(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); }\n  snapshot() { return { algo: 'pcg32', state: this.state.toString(), inc: this.inc.toString() }; }\n  static fromSnapshot(s) { const g = new PCG32(0, 0); g.state = BigInt(s.state); g.inc = BigInt(s.inc); return g; }\n}\nfunction shuffleIndices(n, seed) {\n  const a = Array.from({ length: n }, (_, i) => i), g = new PCG32(seed, 7);\n  for (let i = n - 1; i > 0; i--) { const j = g.nextBelow(i + 1); const t = a[i]; a[i] = a[j]; a[j] = t; }\n  return a;\n}\n\n// ---- 資料游標：順序由 order_seed＋epoch 決定，可重現 ----\nfunction createCursor(orderSeed) { return { shard: 0, offset: 0, order_seed: orderSeed, epoch: 0, consumed_tokens: 0 }; }\nfunction nextIndices(cursor, n, batchSize) {      // 回傳 {indices, cursor}（不改原物件）\n  const c = Object.assign({}, cursor), out = [];\n  let order = shuffleIndices(n, c.order_seed + c.epoch * 1000003);\n  for (let k = 0; k < batchSize; k++) {\n    if (c.offset >= n) { c.epoch++; c.offset = 0; order = shuffleIndices(n, c.order_seed + c.epoch * 1000003); }\n    out.push(order[c.offset++]);\n  }\n  return { indices: out, cursor: c };\n}\n\n// ---- 張量檔：4 位元組小端檔頭長度＋JSON 檔頭（依名稱排序的 shape 表）＋小端 float32 資料 ----\nfunction encodeTensors(list) {\n  const sorted = list.slice().sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));\n  let off = 0;\n  const meta = sorted.map((t) => { const len = t.data.length, m = { name: t.name, shape: t.shape || [len], offset: off, length: len }; off += len; return m; });\n  const head = textBytes(JSON.stringify({ format: 'fa-f32', tensors: meta }));\n  const out = newBytes(4 + head.length + off * 4); const dv = new DataView(out.buffer, out.byteOffset, out.byteLength); dv.setUint32(0, head.length, true); out.set(head, 4);\n  let p = 4 + head.length; sorted.forEach((t) => { for (let i = 0; i < t.data.length; i++) { dv.setFloat32(p, t.data[i], true); p += 4; } });\n  return out;\n}\nfunction decodeTensors(buf) {\n  const u = u8of(buf), dv = new DataView(u.buffer, u.byteOffset, u.byteLength);\n  const hl = dv.getUint32(0, true), head = JSON.parse(new TextDecoder('utf-8').decode(u.subarray(4, 4 + hl))), base = 4 + hl;\n  if (head.format !== 'fa-f32') throw new Error('不是 fa-f32 張量檔');\n  return head.tensors.map((m) => { const d = new Float32Array(m.length); for (let i = 0; i < m.length; i++) d[i] = dv.getFloat32(base + (m.offset + i) * 4, true); return { name: m.name, shape: m.shape, data: d }; });\n}\n\n// ---- 組裝／驗證 ----\n// tensors: { 'lora_A.f32': [{name,shape,data}], ... }；缺的檔（例如 cpu-py 拿不到優化器張量）寫進 missing_files，不假裝有\nfunction makeCheckpoint(o) {\n  const files = {}, missing = [];\n  TENSOR_FILES.forEach((f) => { const t = o.tensors && o.tensors[f]; if (t && t.length) files[f] = encodeTensors(t); else missing.push(f); });\n  const sha = {}; Object.keys(files).forEach((f) => { sha[f] = sha256(files[f]); });\n  const ckpt = {\n    format: FORMAT, version: VERSION, step: o.step, epoch: o.epoch || 0, dtype: 'float32',\n    cursor: o.cursor, rng: o.rng, optimizer: o.optimizer, data_sha256: o.data_sha256, compat: o.compat,\n    produced_by: o.produced_by, loss_tail: (o.loss_tail || []).slice(-50), eval_check: o.eval_check || null, sha256: sha, missing_files: missing,\n  };\n  return { ckpt, files };\n}\nfunction verifyChecksums(cp) {\n  const bad = [];\n  Object.keys(cp.ckpt.sha256 || {}).forEach((f) => { if (!cp.files[f]) bad.push(f + '（檔案不見）'); else if (sha256(cp.files[f]) !== cp.ckpt.sha256[f]) bad.push(f + '（sha256 不符）'); });\n  return { ok: bad.length === 0, bad };\n}\nfunction validateCkptJson(c) {\n  const errs = [];\n  if (!c || c.format !== FORMAT) errs.push('format 不是 ' + FORMAT);\n  else if (c.version !== VERSION) errs.push('version ' + c.version + ' 不是 ' + VERSION + '（舊版要先遷移，目前沒有遷移器）');\n  ['step', 'cursor', 'rng', 'optimizer', 'data_sha256', 'compat', 'produced_by'].forEach((k) => { if (c && c[k] === undefined) errs.push('缺欄位 ' + k); });\n  if (c && c.dtype !== 'float32') errs.push('dtype 必須是 float32');\n  if (c && c.rng && c.rng.algo !== 'pcg32') errs.push('rng.algo 必須是 pcg32');\n  return { ok: errs.length === 0, errors: errs };\n}\nconst same = (a, b) => JSON.stringify(a) === JSON.stringify(b);\n// 相容性：不符一律拒絕、提示 fork。cur = { compat, data_sha256, optimizer:{kind} }\nfunction checkCompat(ckpt, cur) {\n  const v = validateCkptJson(ckpt);\n  if (!v.ok) return { ok: false, mismatches: v.errors.map((e) => ({ field: 'format', detail: e })), action: 'reject', message: '檢查點格式不合：' + v.errors.join('；') };\n  const m = [];\n  COMPAT_FIELDS.forEach((f) => { if (!same(ckpt.compat[f], (cur.compat || {})[f])) m.push({ field: 'compat.' + f, checkpoint: ckpt.compat[f], current: (cur.compat || {})[f] }); });\n  if (ckpt.data_sha256 !== cur.data_sha256) m.push({ field: 'data_sha256', checkpoint: ckpt.data_sha256, current: cur.data_sha256 });\n  if ((ckpt.optimizer && ckpt.optimizer.kind) !== (cur.optimizer && cur.optimizer.kind)) m.push({ field: 'optimizer.kind', checkpoint: ckpt.optimizer && ckpt.optimizer.kind, current: cur.optimizer && cur.optimizer.kind });\n  return m.length\n    ? { ok: false, mismatches: m, action: 'fork', message: '相容欄位不符（' + m.map((x) => x.field).join('、') + '）：不能續訓，請以新資產 fork（parent 記來源）' }\n    : { ok: true, mismatches: [], action: 'resume' };\n}\n\n// ---- 數值比對 ----\nconst rel = (a, b) => Math.abs(a - b) / Math.max(Math.abs(b), 1e-12);\nfunction compareLoss(a, b, o) {                       // 跨後端：續訓前以 eval_batch 比對；半精度放寬到 5%\n  o = o || {}; const tol = o.tol !== undefined ? o.tol : (o.fp16 ? TOL.crossBackendFp16 : TOL.crossBackend);\n  const relErr = rel(a, b); return { ok: Number.isFinite(relErr) && relErr <= tol, relErr, tol };\n}\nfunction maxRelDiff(xs, ys) { if (xs.length !== ys.length) return Infinity; let m = 0; for (let i = 0; i < xs.length; i++) m = Math.max(m, rel(xs[i], ys[i])); return m; }\nfunction compareSameBackendRun(xs, ys, tol) { tol = tol === undefined ? TOL.sameBackend : tol; const d = maxRelDiff(xs, ys); return { ok: d <= tol, maxRelErr: d, tol }; }\nfunction trendWarning(lossTail, newLosses) {          // 只警示，不當拒絕條件\n  if (!lossTail || !lossTail.length || !newLosses || !newLosses.length) return { warn: false };\n  const mean = (a) => a.reduce((s, x) => s + x, 0) / a.length, a = mean(lossTail), b = mean(newLosses);\n  return { warn: !(b <= a * 1.5), tailMean: a, newMean: b };\n}\n// 續訓紀錄（§3.1 第 3 點）\nfunction resumeRecord(ckpt, toBackend, evalResult) {\n  return { at: 'resume', from: ckpt.produced_by.backend, to: toBackend, step: ckpt.step, sameBackend: ckpt.produced_by.backend === toBackend, evalCheck: evalResult || null,\n    text: '由 ' + ckpt.produced_by.backend + ' 後端暫停、' + toBackend + ' 後端續訓（step=' + ckpt.step + '）' };\n}\n\nmodule.exports = { FORMAT, VERSION, TENSOR_FILES, COMPAT_FIELDS, TOL, sha256, PCG32, shuffleIndices, createCursor, nextIndices, encodeTensors, decodeTensors, makeCheckpoint, verifyChecksums, validateCkptJson, checkCompat, rel, compareLoss, maxRelDiff, compareSameBackendRun, trendWarning, resumeRecord };\n","studio_config_core.js":"'use strict';\n// Studio 的 Configure 設定模型（純核心，不碰 window）：GUI 依 SCHEMA 畫欄位、存取由呼叫端負責，這裡只負責正規化、驗證與換算。\n// 目前欄位：訓練／基準使用的處理器核心數（自動＝總核心數−1，至少 1）、是否降低優先權。\nconst SCHEMA = [\n  { key: 'cpuCores', type: 'int|auto', default: 'auto', label: '訓練使用的處理器核心數', help: '自動＝總核心數−1（留一個給你用電腦）。設成全部核心訓練會比較快，但電腦會明顯變卡。', min: 1, appliesTo: ['cpu-py', 'cpu-js'] },\n  { key: 'lowPriority', type: 'bool', default: true, label: '以較低優先權執行訓練', help: '讓你操作其他程式時訓練自動讓路。' },\n  { key: 'benchmarkCoresCap', type: 'bool', default: true, label: '基準測試也遵守核心數上限', help: '關閉後基準測試可用到上面設定以外的核心（不建議）。' },\n];\nconst DEFAULTS = SCHEMA.reduce((o, s) => { o[s.key] = s.default; return o; }, {});\n\n// 正規化＋驗證：回 { config, errors[], warnings[] }；錯誤欄位退回預設並說明，不丟例外\nfunction normalize(input, totalCores) {\n  const cfg = Object.assign({}, DEFAULTS), errors = [], warnings = [], n = Math.max(1, totalCores | 0 || 1); input = input || {};\n  if (input.cpuCores !== undefined && input.cpuCores !== 'auto') {\n    const v = typeof input.cpuCores === 'string' && /^\\s*\\d+\\s*$/.test(input.cpuCores) ? parseInt(input.cpuCores, 10) : input.cpuCores;\n    if (!Number.isInteger(v) || v < 1) errors.push('cpuCores 必須是 1 以上的整數或 auto，收到 ' + JSON.stringify(input.cpuCores) + '，已改用 auto');\n    else if (v > n) { cfg.cpuCores = n; warnings.push('設定的核心數 ' + v + ' 超過這台電腦的 ' + n + ' 個，已改成 ' + n); }\n    else cfg.cpuCores = v;\n  }\n  if (cfg.cpuCores !== 'auto' && cfg.cpuCores >= n && n > 1) warnings.push('用掉全部 ' + n + ' 個核心：訓練時電腦會明顯變卡，建議至少留 1 個');\n  ['lowPriority', 'benchmarkCoresCap'].forEach((k) => { if (input[k] !== undefined) { if (typeof input[k] === 'boolean') cfg[k] = input[k]; else errors.push(k + ' 必須是 true／false，已用預設值'); } });\n  return { config: cfg, errors, warnings };\n}\n// 換算實際執行緒數：auto＝N−1（至少 1）；基準測試若啟用上限，不超過 N−1 與使用者設定兩者中較小者\nfunction resolveThreads(config, totalCores, purpose) {\n  const n = Math.max(1, totalCores | 0 || 1), auto = Math.max(1, n - 1), c = Object.assign({}, DEFAULTS, config || {});\n  const want = c.cpuCores === 'auto' ? auto : Math.min(n, Math.max(1, c.cpuCores | 0));\n  return purpose === 'benchmark' && c.benchmarkCoresCap ? Math.min(want, auto) : want;\n}\n\nmodule.exports = { SCHEMA, DEFAULTS, normalize, resolveThreads };\n","llm_export_core.js":"'use strict';\n/* LLM 模型匯出（UMD，純函式；不下載、不碰檔案系統、不自己 spawn，執行器由呼叫端注入）。\n * 設計見 DESIGN.lora-training.md §25（路徑 A：合併 → ONNX q8 或 GGUF Q8_0 → 核對 → 寫 manifest）。\n *   EXPORT_PLANS[format]            ONNX q8／GGUF q8_0 的五步（每一步要的工具）\n *   exportPlan(format, toolsState)  把步驟表套上工具狀態：每一步是「缺工具」或「待做」\n *   exportAvailability(toolsState)  格式是否可用，與不可用的具體原因（缺哪些工具）\n *   probeExportTools(detect)        工具偵測（detect 由呼叫端注入：name → { found, version?, reason? }）\n *   buildStepCommands(format, o)    每一步要執行的命令（argv 陣列，不經過 shell）；o 見函式註解\n *   runExportSteps(cmds, runner)    依序執行（runner 注入：argv → Promise<{code, stdout, stderr}>），遇錯停止\n *   parseStepResult(stdout)         取出執行器印的最後一行 JSON（{\"step\":…,\"ok\":…}）\n *   LLM_TRAIN_MODES / trainModePlan(mode)   訓練模式（LoRA 與完整微調都有腳本；完整微調只跑過 smoke）\n * 原則：工具沒找到就標「缺工具」，不假裝可用；執行器失敗就照實回報，不吞錯誤。\n */\n(function (root, factory) {\n    if (typeof module === 'object' && module.exports) module.exports = factory();\n    else root.FaStudioLlmExport = factory();\n}(typeof self !== 'undefined' ? self : this, function () {\n    // 工具名稱（detect 與 toolsState 用的鍵）\n    const TOOLS = {\n        optimum: 'optimum-cli（匯出用的 Python 環境，.venv-export）',\n        onnxruntime: 'onnxruntime（匯出用的 Python 環境，.venv-export）',\n        llamaCpp: 'llama.cpp（convert_hf_to_gguf.py、llama-quantize、llama-server）',\n        peft: 'peft（合併用的 Python 環境，.venv）'\n    };\n    // 每一步：tool 是需要的工具（null＝不需外部工具）；runner 為 true 表示執行器腳本存在\n    const EXPORT_PLANS = {\n        onnx: { format: 'onnx', label: 'ONNX', quant: 'q8', steps: [\n            { id: 'merge', label: '把 LoRA 併回基底權重', tool: 'peft', runner: true, script: 'merge_and_export.py' },\n            { id: 'convert', label: '匯出 ONNX fp32（optimum-cli export onnx）', tool: 'optimum', runner: true, script: 'export_onnx.py' },\n            { id: 'quantize', label: '動態量化 q8（onnxruntime，預設 full）', tool: 'onnxruntime', runner: true, script: 'export_onnx.py' },\n            { id: 'verify', label: '核對：與 HF（PyTorch）比對首步 logits 與貪婪 token', tool: 'optimum', runner: true, script: 'export_onnx.py' },\n            { id: 'pack', label: '寫 manifest（sha256）', tool: null, runner: true, script: 'export_onnx.py' }\n        ] },\n        gguf: { format: 'gguf', label: 'GGUF', quant: 'q8_0', steps: [\n            { id: 'merge', label: '把 LoRA 併回基底權重', tool: 'peft', runner: true, script: 'merge_and_export.py' },\n            { id: 'convert', label: '轉成 GGUF f16（llama.cpp 的 convert_hf_to_gguf.py）', tool: 'llamaCpp', runner: true, script: 'export_gguf.py' },\n            { id: 'quantize', label: '量化 Q8_0（llama-quantize）', tool: 'llamaCpp', runner: true, script: 'export_gguf.py' },\n            { id: 'verify', label: '核對：llama-server 貪婪 token 與 HF 比對', tool: 'llamaCpp', runner: true, script: 'export_gguf.py' },\n            { id: 'pack', label: '寫 manifest（sha256）', tool: null, runner: true, script: 'export_gguf.py' }\n        ] }\n    };\n    const FORMATS = Object.keys(EXPORT_PLANS);\n\n    // toolsState：{ optimum: {found}, onnxruntime: {found}, llamaCpp: {found}, peft: {found} }；缺的鍵視為沒找到\n    const has = (ts, name) => !!(ts && ts[name] && ts[name].found);\n\n    function stepState(step, ts) {\n        if (step.tool && !has(ts, step.tool)) return { state: '缺工具', blocker: '需要 ' + TOOLS[step.tool] + '；這台還沒找到' };\n        if (!step.runner) return { state: '尚未實作', blocker: '執行器尚未寫' };\n        return { state: '待做', blocker: '' };\n    }\n\n    function exportPlan(format, toolsState) {\n        const P = EXPORT_PLANS[format];\n        if (!P) return { ok: false, error: 'format 必須是 ' + FORMATS.join('／') + '，收到 ' + JSON.stringify(format) };\n        const steps = P.steps.map((s) => Object.assign({ id: s.id, label: s.label, tool: s.tool }, stepState(s, toolsState)));\n        const blockers = steps.filter((s) => s.state !== '待做').map((s) => s.label + '：' + s.state + '（' + s.blocker + '）');\n        return { ok: true, format: P.format, label: P.label, quant: P.quant, steps, ready: blockers.length === 0, blockers };\n    }\n\n    function exportAvailability(toolsState) {\n        const out = {};\n        FORMATS.forEach((f) => {\n            const plan = exportPlan(f, toolsState);\n            const missing = plan.steps.filter((s) => s.state === '缺工具').map((s) => s.tool);\n            const notBuilt = plan.steps.filter((s) => s.state === '尚未實作');\n            const available = plan.ready;\n            let reason = '';\n            if (!available) {\n                if (missing.length) reason = '缺工具：' + Array.from(new Set(missing)).map((t) => TOOLS[t]).join('、');\n                else reason = '匯出執行器尚未實作（' + notBuilt.map((s) => s.label).join('；') + '）';\n            }\n            out[f] = { available, format: f, quant: plan.quant, reason, missingTools: Array.from(new Set(missing)) };\n        });\n        return out;\n    }\n\n    // 偵測：detect 由呼叫端注入（主行程用檔案存在與 python -c import 檢查）；沒有 detect 就全部視為沒找到\n    function probeExportTools(detect) {\n        const names = Object.keys(TOOLS), state = {};\n        names.forEach((n) => {\n            let r = null;\n            try { r = typeof detect === 'function' ? detect(n) : null; } catch (e) { r = { found: false, reason: String((e && e.message) || e) }; }\n            state[n] = r && r.found ? { found: true, version: r.version || null, path: r.path || null } : { found: false, reason: (r && r.reason) || '沒有偵測函式或沒找到' };\n        });\n        return state;\n    }\n\n    // 給 pipeline_routes_core 的 exportCaps：{onnxExport, ggufExport}\n    function exportCapsFrom(toolsState) {\n        const av = exportAvailability(toolsState || {});\n        return { onnxExport: !!av.onnx.available, ggufExport: !!av.gguf.available };\n    }\n\n    /* buildStepCommands(format, o)：回 {ok, steps:[{id, label, argv}]} 或 {ok:false, error}\n     * o: { pyTrain（merge 用）, pyExport（ONNX／GGUF 的 Python）, scriptsDir（lora-train 資料夾）, baseDir（基底 HF）,\n     *      adapterDir（PEFT adapter）, workDir（合併後與各格式產物的根目錄）, outDir（本次格式的輸出資料夾）,\n     *      llamaDir（含 llama-quantize／llama-server 的 bin）, llamaSrc（llama.cpp 原始碼根，convert 用）, recipe（full｜mixed，ONNX 用） }\n     * 合併後的權重放 workDir/merged（所有格式共用）。argv[0] 是 Python 或工具路徑；路徑一律是字串、不經 shell。 */\n    function buildStepCommands(format, o) {\n        const P = EXPORT_PLANS[format];\n        if (!P) return { ok: false, error: '未知格式 ' + JSON.stringify(format) };\n        o = o || {};\n        const need = (k) => (o[k] ? null : '缺 ' + k);\n        const missing = (format === 'onnx' ? ['pyTrain', 'pyExport', 'scriptsDir', 'baseDir', 'adapterDir', 'workDir', 'outDir'] : ['pyTrain', 'pyExport', 'scriptsDir', 'baseDir', 'adapterDir', 'workDir', 'outDir', 'llamaDir', 'llamaSrc'])\n            .map(need).filter(Boolean);\n        if (missing.length) return { ok: false, error: missing.join('；') };\n        const join = (dir, f) => String(dir).replace(/[\\\\/]+$/, '') + '/' + f;\n        const merged = join(o.workDir, 'merged');\n        const recipe = o.recipe || 'full';\n        const onnx = format === 'onnx';\n        const py = o.pyExport; // 匯出步驟都用匯出環境（.venv-export）\n        const script = join(o.scriptsDir, onnx ? 'export_onnx.py' : 'export_gguf.py');\n        const steps = P.steps.map((s) => {\n            let argv;\n            if (s.id === 'merge') argv = [o.pyTrain, join(o.scriptsDir, 'merge_and_export.py'), '--base_dir', o.baseDir, '--adapter_dir', o.adapterDir, '--output_dir', merged];\n            else if (onnx) {\n                const base = [py, script, '--step', s.id, '--out', o.outDir, '--recipe', recipe];\n                if (s.id === 'pack') base.push('--tokenizer', o.baseDir, '--model', merged);\n                if (s.id === 'convert' || s.id === 'verify') base.push('--model', merged);\n                if (s.id === 'convert' || s.id === 'verify') base.push('--tokenizer', o.baseDir);\n                argv = base;\n            } else {\n                const base = [py, script, '--step', s.id, '--out', o.outDir];\n                if (s.id === 'convert') base.push('--model', merged, '--tokenizer', o.baseDir, '--llama_src', o.llamaSrc);\n                if (s.id === 'verify' || s.id === 'pack') base.push('--model', merged, '--tokenizer', o.baseDir);\n                if (s.id === 'convert' || s.id === 'quantize' || s.id === 'verify') base.push('--llama_dir', o.llamaDir);\n                argv = base;\n            }\n            return { id: s.id, label: s.label, argv };\n        });\n        return { ok: true, format, steps };\n    }\n\n    // 執行器印的最後一行 JSON（{\"step\":…,\"ok\":…}）；找不到回 null\n    function parseStepResult(stdout) {\n        const lines = String(stdout || '').split(/\\r?\\n/).map((l) => l.trim()).filter((l) => l.startsWith('{') && l.endsWith('}'));\n        for (let i = lines.length - 1; i >= 0; i--) {\n            try { const j = JSON.parse(lines[i]); if (j && typeof j === 'object' && 'ok' in j && 'step' in j) return j; } catch (e) { /* 不是我們的行 */ }\n        }\n        return null;\n    }\n\n    /* runExportSteps(cmds, runner, opts)：依序執行；runner(argv, id) → Promise<{code, stdout, stderr}>（可能丟例外）。\n     * 任一步失敗就停止（後面的步驟標「未執行」）。\n     * opts.onEvent(e)：每步開始／結束時呼叫。\n     * opts.skip：Set（步驟 id），在裡面的步驟不執行，標「略過（已完成）」（續跑用）。\n     * opts.isStopRequested()：每一步開始前檢查；要求停止（暫停或取消）就不再開新步驟，剩下的標「未執行」，回傳 stopped:true。 */\n    async function runExportSteps(cmds, runner, opts) {\n        const onEvent = (opts && opts.onEvent) || (() => {});\n        const skip = (opts && opts.skip) || new Set();\n        const stopReq = (opts && opts.isStopRequested) || (() => false);\n        const steps = [];\n        let failedAt = null, stopped = false;\n        for (let i = 0; i < cmds.steps.length; i++) {\n            const s = cmds.steps[i];\n            if (failedAt !== null || stopped) { steps.push({ id: s.id, label: s.label, state: '未執行' }); continue; }\n            if (skip.has(s.id)) { steps.push({ id: s.id, label: s.label, state: '略過（已完成）' }); onEvent({ type: 'step-skip', id: s.id }); continue; }\n            if (stopReq()) { stopped = true; steps.push({ id: s.id, label: s.label, state: '未執行' }); continue; }\n            onEvent({ type: 'step-start', id: s.id, label: s.label });\n            let r;\n            try { r = await runner(s.argv, s.id); } catch (e) { r = { code: -1, stdout: '', stderr: String((e && e.message) || e) }; }\n            const j = parseStepResult(r && r.stdout);\n            const ok = !!(r && r.code === 0 && j && j.ok === true);\n            // 被要求停止時中斷的步驟不是失敗：標「中斷」，之後的步驟不再開始\n            const interrupted = !ok && stopReq();\n            const rec = { id: s.id, label: s.label, state: ok ? '完成' : (interrupted ? '中斷' : '失敗'), code: r ? r.code : -1, result: j,\n                error: ok ? '' : ((j && j.error) || String((r && r.stderr) || '').split(/\\r?\\n/).filter(Boolean).slice(-3).join(' | ') || '沒有輸出（退出碼 ' + (r ? r.code : '?') + '）') };\n            steps.push(rec);\n            onEvent({ type: 'step-end', id: s.id, state: rec.state, error: rec.error });\n            if (interrupted) stopped = true;\n            else if (!ok) failedAt = s.id;\n        }\n        const done = steps.filter((x) => x.state === '完成' || x.state === '略過（已完成）').map((x) => x.id);\n        return { ok: failedAt === null && !stopped, stopped, format: cmds.format, failedAt, steps, done };\n    }\n\n    // 訓練模式：LoRA 已實作（cpu-py／wasm-web）；完整微調有腳本（train_full.py），只跑過 smoke\n    const LLM_TRAIN_MODES = [\n        { id: 'lora', label: 'LoRA 微調', implemented: true, note: '沿用 LoRA 訓練（cpu-py；網頁版 wasm-web）' },\n        { id: 'full', label: '完整微調', implemented: true, note: 'lora-train/train_full.py（CPU、fp32，約 10 GB 記憶體，3–4 步 smoke 已跑）；沒有做品質訓練，輸出可走匯出流程' }\n    ];\n    function trainModePlan(mode) {\n        const m = LLM_TRAIN_MODES.find((x) => x.id === mode);\n        if (!m) return { ok: false, error: '訓練模式必須是 ' + LLM_TRAIN_MODES.map((x) => x.id).join('／') + '，收到 ' + JSON.stringify(mode) };\n        return { ok: true, mode: m.id, label: m.label, implemented: m.implemented, note: m.note, blocker: m.implemented ? '' : (m.blocker || '') };\n    }\n\n    return { TOOLS, EXPORT_PLANS, FORMATS, exportPlan, exportAvailability, probeExportTools, exportCapsFrom, buildStepCommands, parseStepResult, runExportSteps, LLM_TRAIN_MODES, trainModePlan };\n}));\n","asset_core.js":"/* 訓練資產（fa-training-asset）核心（UMD，純函式，不碰 DOM／網路／檔案系統；Node 與瀏覽器都能載入）。\n * 設計見 DESIGN.TODO.offline-training-studio.md §2、§3、§3.1、§9。\n *  - sha256Hex(u8)：純 JavaScript 的 sha256（同步，不靠 crypto.subtle，所以瀏覽器與 Node 結果一致）\n *  - createManifest(opts)：由檔案表算出雜湊並建立 manifest\n *  - validateManifest(m)：欄位檢查，回 {ok, errors}\n *  - migrateManifest(m)：舊版（缺欄位、欄位名稱不同）升級到現行版本，不改動輸入\n *  - verifyFiles(manifest, files)：逐檔核對 sha256（竄改、缺檔、多出的檔）\n *  - checkCompat(base, incoming, opts)：base／rank／alpha／target_modules／prompt_format_version／tool_catalog_sha256／資料雜湊的相容性；不符回具體原因並建議 fork\n *  - forkManifest(parent, opts)：以新資產 fork，parent 欄位記來源\n * 「資產」＝ {manifest, files}，files 是 {相對路徑: Uint8Array}（不含 manifest.json 本身）。 */\n(function (root, factory) {\n    if (typeof module === 'object' && module.exports) module.exports = factory();\n    else root.FaStudioAsset = factory();\n})(typeof self !== 'undefined' ? self : this, function () {\n    'use strict';\n    const FORMAT = 'fa-training-asset';\n    const VERSION = 2; // 版本 1：舊式（檔案雜湊放在 files／hashes，沒有 compat／counts／eval／owner）\n    const KINDS = ['colu', 'blockly', 'matrix', 'uml', 'trainer', 'lora', 'llm'];\n    const OWNERS = ['user', 'builtin'];\n    // 續訓／合併要比對的相容欄位（§3.1）；不看後端與裝置\n    const COMPAT_FIELDS = ['base', 'base_sha256', 'rank', 'alpha', 'target_modules', 'prompt_format_version', 'tool_catalog_sha256'];\n    const COMPAT_LABEL = { base: '基底模型', base_sha256: '基底模型雜湊', rank: 'LoRA 秩（rank）', alpha: 'LoRA alpha', target_modules: '目標模組', prompt_format_version: '提示格式版本', tool_catalog_sha256: '工具目錄雜湊', data_sha256: '資料集雜湊', kind: '資產種類' };\n    const HEX64 = /^[0-9a-f]{64}$/;\n\n    // ===== sha256（純 JavaScript） =====\n    const K = new Uint32Array([\n        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]);\n    function toU8(x) {\n        if (x instanceof Uint8Array) return x;\n        if (typeof x === 'string') return new TextEncoder().encode(x);\n        if (x && x.buffer instanceof ArrayBuffer) return new Uint8Array(x.buffer, x.byteOffset, x.byteLength);\n        if (x instanceof ArrayBuffer) return new Uint8Array(x);\n        throw new Error('需要 Uint8Array 或字串');\n    }\n    function sha256Hex(input) {\n        const data = toU8(input); const n = data.length;\n        const h = new Uint32Array([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]);\n        const w = new Uint32Array(64);\n        const total = ((n + 9 + 63) >> 6) << 6; // 補 0x80 與 8 位元組長度後對齊 64\n        const block = (get) => {\n            for (let i = 0; i < 16; i++) w[i] = (get(i * 4) << 24) | (get(i * 4 + 1) << 16) | (get(i * 4 + 2) << 8) | get(i * 4 + 3);\n            for (let i = 16; i < 64; i++) {\n                const a = w[i - 15], b = w[i - 2];\n                const s0 = ((a >>> 7) | (a << 25)) ^ ((a >>> 18) | (a << 14)) ^ (a >>> 3);\n                const s1 = ((b >>> 17) | (b << 15)) ^ ((b >>> 19) | (b << 13)) ^ (b >>> 10);\n                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) | 0;\n            }\n            let a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];\n            for (let i = 0; i < 64; i++) {\n                const S1 = ((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7));\n                const ch = (e & f) ^ (~e & g);\n                const t1 = (hh + S1 + ch + K[i] + w[i]) | 0;\n                const S0 = ((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10));\n                const mj = (a & b) ^ (a & c) ^ (b & c);\n                const t2 = (S0 + mj) | 0;\n                hh = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;\n            }\n            h[0] = (h[0] + a) | 0; h[1] = (h[1] + b) | 0; h[2] = (h[2] + c) | 0; h[3] = (h[3] + d) | 0; h[4] = (h[4] + e) | 0; h[5] = (h[5] + f) | 0; h[6] = (h[6] + g) | 0; h[7] = (h[7] + hh) | 0;\n        };\n        const fullEnd = n - (n % 64);\n        for (let off = 0; off < fullEnd; off += 64) block((i) => data[off + i]);\n        const tail = new Uint8Array(total - fullEnd); tail.set(data.subarray(fullEnd), 0); tail[n - fullEnd] = 0x80;\n        const bits = n * 8; const dv = new DataView(tail.buffer);\n        dv.setUint32(tail.length - 8, Math.floor(bits / 4294967296)); dv.setUint32(tail.length - 4, bits >>> 0);\n        for (let off = 0; off < tail.length; off += 64) block((i) => tail[off + i]);\n        let out = ''; for (let i = 0; i < 8; i++) out += (h[i] >>> 0).toString(16).padStart(8, '0');\n        return out;\n    }\n\n    // ===== 工具 =====\n    function stable(v) { // 鍵排序的 JSON（雜湊用，與鍵順序無關）\n        if (Array.isArray(v)) return '[' + v.map(stable).join(',') + ']';\n        if (v && typeof v === 'object') return '{' + Object.keys(v).sort().map((k) => JSON.stringify(k) + ':' + stable(v[k])).join(',') + '}';\n        return JSON.stringify(v === undefined ? null : v);\n    }\n    const clone = (o) => JSON.parse(JSON.stringify(o));\n    function safePath(p) { // 容器內路徑：相對、正斜線、沒有 .. 與空段\n        if (typeof p !== 'string' || !p || p.length > 300) return false;\n        if (p.indexOf('\\\\') >= 0 || p[0] === '/' || /^[A-Za-z]:/.test(p) || p.indexOf('\\0') >= 0) return false;\n        return p.split('/').every((s) => s && s !== '.' && s !== '..');\n    }\n    function safeName(n) { return typeof n === 'string' && /^[\\w一-鿿][\\w一-鿿.\\- ]{0,79}$/.test(n) && n.indexOf('..') < 0 && !/[. ]$/.test(n); }\n    function hashFiles(files) { const out = {}; for (const p of Object.keys(files).sort()) out[p] = sha256Hex(files[p]); return out; }\n    // 資料集雜湊：data/ 底下所有檔的（路徑＋雜湊）依序串起來再雜湊\n    function dataHash(files, hashes) {\n        hashes = hashes || hashFiles(files); let s = '';\n        for (const p of Object.keys(hashes).sort()) if (p.indexOf('data/') === 0) s += p + '\\0' + hashes[p] + '\\n';\n        return sha256Hex(s);\n    }\n    function manifestHash(m) { return sha256Hex(stable(m)); }\n\n    // ===== 建立 =====\n    function createManifest(o) {\n        o = o || {}; const files = o.files || {};\n        if (KINDS.indexOf(o.kind) < 0) throw new Error('kind 必須是 ' + KINDS.join('／') + '，收到 ' + JSON.stringify(o.kind));\n        if (!safeName(o.name)) throw new Error('名稱不合法（只能用中英文數字、底線、連字號、點與空白，最長 80 字，且不可含 ..）：' + JSON.stringify(o.name));\n        for (const p of Object.keys(files)) if (!safePath(p) || p === 'manifest.json') throw new Error('檔案路徑不合法：' + p);\n        const sha = hashFiles(files);\n        const compat = Object.assign({}, o.compat || {});\n        if (compat.data_sha256 === undefined) compat.data_sha256 = dataHash(files, sha);\n        const base = o.base !== undefined ? o.base : (compat.base !== undefined ? compat.base : null);\n        const m = {\n            format: FORMAT, version: VERSION, kind: o.kind, name: o.name, created: o.created || new Date().toISOString(),\n            parent: o.parent || null, base, compat, counts: Object.assign({}, o.counts || {}), eval: o.eval === undefined ? null : o.eval,\n            sha256: sha, owner: o.owner || 'user'\n        };\n        if (o.extra !== undefined) m.extra = o.extra;\n        return m;\n    }\n\n    // ===== 驗證 =====\n    function validateManifest(m) {\n        const errors = [];\n        if (!m || typeof m !== 'object' || Array.isArray(m)) return { ok: false, errors: ['manifest 不是物件'] };\n        if (m.format !== FORMAT) errors.push('format 應為 ' + FORMAT + '，收到 ' + JSON.stringify(m.format));\n        if (!Number.isInteger(m.version)) errors.push('version 缺少或不是整數');\n        else if (m.version > VERSION) errors.push('資產版本（' + m.version + '）比這個程式支援的（' + VERSION + '）新，請先更新程式');\n        else if (m.version < VERSION) errors.push('資產版本（' + m.version + '）較舊，需先用 migrateManifest 升級');\n        if (KINDS.indexOf(m.kind) < 0) errors.push('kind 不合法：' + JSON.stringify(m.kind));\n        if (!safeName(m.name)) errors.push('name 不合法：' + JSON.stringify(m.name));\n        if (m.owner !== undefined && OWNERS.indexOf(m.owner) < 0) errors.push('owner 只能是 user 或 builtin');\n        if (!m.sha256 || typeof m.sha256 !== 'object' || Array.isArray(m.sha256)) errors.push('sha256 表缺少');\n        else for (const p of Object.keys(m.sha256)) { if (!safePath(p)) errors.push('sha256 表裡的路徑不合法：' + p); else if (!HEX64.test(String(m.sha256[p]))) errors.push('sha256 值格式不對：' + p); }\n        if (!m.compat || typeof m.compat !== 'object') errors.push('compat 缺少');\n        if (m.parent != null && (typeof m.parent !== 'object' || !m.parent.name)) errors.push('parent 格式不對（需要 {name, kind, manifest_sha256}）');\n        // llm（DESIGN.lora-training.md §25）：權重太大不放進資產的記憶體，列在 external（路徑相對於資產、可選的本機位置、位元組數）；sha256 表仍然包含它們\n        if (m.kind === 'llm') {\n            if (!m.llm || typeof m.llm !== 'object' || ['onnx', 'gguf'].indexOf(m.llm.format) < 0) errors.push('llm 資產需要 llm.format（onnx 或 gguf）');\n            if (m.external !== undefined && (typeof m.external !== 'object' || Array.isArray(m.external))) errors.push('external 必須是物件');\n            else for (const p of Object.keys(m.external || {})) {\n                const e = m.external[p] || {};\n                if (!safePath(p) || !m.sha256 || m.sha256[p] === undefined) errors.push('external 的路徑沒有對應的 sha256：' + p);\n                if (!Number.isInteger(e.bytes) || e.bytes < 0) errors.push('external 缺少 bytes：' + p);\n            }\n        } else if (m.external !== undefined && Object.keys(m.external || {}).length) errors.push('只有 llm 資產可以有 external 檔案');\n        return { ok: !errors.length, errors };\n    }\n\n    // ===== 遷移 =====\n    function migrateManifest(input) {\n        if (!input || typeof input !== 'object') return { ok: false, error: 'manifest 不是物件' };\n        const m = clone(input); const notes = [];\n        const isTrainerBundleLike = m.format === 'fa-offline-trainer';\n        if (m.format !== FORMAT && !isTrainerBundleLike) return { ok: false, error: 'format 不是 ' + FORMAT + '（收到 ' + JSON.stringify(m.format) + '），這不是訓練資產' };\n        if (isTrainerBundleLike) return { ok: false, error: '這是離線訓練器的 bundle（fa-offline-trainer），請用 trainer_adapter 轉成資產，不是資產 manifest' };\n        let v = m.version === undefined ? 0 : Number(m.version);\n        if (!Number.isInteger(v) || v < 0) return { ok: false, error: 'version 不是非負整數：' + JSON.stringify(m.version) };\n        if (v > VERSION) return { ok: false, error: '資產版本（' + v + '）比這個程式支援的（' + VERSION + '）新，請先更新程式' };\n        const from = v;\n        if (v < 1) { // 版本 0：只有 format／kind／name，雜湊沒記\n            if (!m.sha256 && !m.files && !m.hashes) notes.push('版本 0：沒有檔案雜湊，升級後 sha256 為空，核對時所有檔案會被視為「多出」，請重新計算');\n            v = 1; notes.push('0→1：補上版本號');\n        }\n        if (v < 2) { // 版本 1 → 2\n            if (!m.sha256) { m.sha256 = m.hashes || m.files || {}; notes.push('1→2：檔案雜湊欄位（hashes／files）改名為 sha256'); }\n            delete m.hashes; if (m.files && typeof m.files === 'object') delete m.files;\n            if (!m.compat) { m.compat = {}; ['base', 'rank', 'alpha', 'prompt_format_version', 'tool_catalog_sha256'].forEach((k) => { if (m[k] !== undefined) { m.compat[k] = m[k]; delete m[k]; } }); notes.push('1→2：補上 compat（舊的頂層 base／rank／prompt_format_version 搬進去）'); }\n            if (m.base === undefined) m.base = m.compat.base !== undefined ? m.compat.base : null;\n            if (!m.counts) { m.counts = {}; notes.push('1→2：補上 counts'); }\n            if (m.eval === undefined) m.eval = null;\n            if (!m.owner) { m.owner = 'user'; notes.push('1→2：補上 owner=user'); }\n            if (m.parent === undefined) m.parent = null;\n            if (!m.created) { m.created = ''; notes.push('1→2：舊資產沒有建立時間，留空'); }\n            v = 2;\n        }\n        m.version = VERSION;\n        const chk = validateManifest(m);\n        if (!chk.ok) return { ok: false, error: '升級後仍不合法：' + chk.errors.join('；'), manifest: m, notes };\n        return { ok: true, manifest: m, migrated: from !== VERSION, from, to: VERSION, notes };\n    }\n\n    // ===== 核對檔案 =====\n    function verifyFiles(manifest, files, opts) {\n        opts = opts || {}; const mismatched = [], missing = [], extra = [];\n        const want = manifest.sha256 || {};\n        // opts.external：不在記憶體裡的檔案（llm 的大權重）；這裡不核對，由呼叫端用串流方式另外核對\n        const ext = new Set(opts.external || Object.keys(manifest.external || {}));\n        for (const p of Object.keys(want)) {\n            if (ext.has(p) && !files[p]) continue;\n            const f = files[p];\n            if (!f) { missing.push(p); continue; }\n            if (sha256Hex(f) !== want[p]) mismatched.push(p);\n        }\n        for (const p of Object.keys(files)) if (!(p in want) && p !== 'manifest.json') extra.push(p);\n        const ok = !mismatched.length && !missing.length && (opts.allowExtra || !extra.length);\n        const parts = [];\n        if (mismatched.length) parts.push('內容被改過或毀損（sha256 對不上）：' + mismatched.slice(0, 5).join('、') + (mismatched.length > 5 ? '…共 ' + mismatched.length + ' 個' : ''));\n        if (missing.length) parts.push('缺少檔案：' + missing.slice(0, 5).join('、'));\n        if (extra.length && !opts.allowExtra) parts.push('多出 manifest 沒有記錄的檔案：' + extra.slice(0, 5).join('、'));\n        return { ok, mismatched, missing, extra, message: parts.join('；') };\n    }\n\n    // ===== 相容性 =====\n    // base、incoming 可以是 manifest 或 compat 物件（含 kind／data_sha256 時一併比）。opts.checkData（預設 true）：續訓要比資料雜湊；合併匯入不比。\n    function checkCompat(base, incoming, opts) {\n        opts = opts || {};\n        const A = (base && base.compat) ? Object.assign({}, base.compat, { kind: base.kind }) : Object.assign({}, base || {});\n        const B = (incoming && incoming.compat) ? Object.assign({}, incoming.compat, { kind: incoming.kind }) : Object.assign({}, incoming || {});\n        const fields = ['kind'].concat(COMPAT_FIELDS); if (opts.checkData !== false) fields.push('data_sha256');\n        const reasons = [];\n        for (const f of fields) {\n            const a = A[f], b = B[f];\n            if (a === undefined && b === undefined) continue;\n            if (a === undefined || b === undefined || stable(a) !== stable(b)) {\n                reasons.push({ field: f, expected: a === undefined ? null : a, actual: b === undefined ? null : b, message: (COMPAT_LABEL[f] || f) + '不同：原本 ' + (a === undefined ? '（未記錄）' : JSON.stringify(a)) + '，這份是 ' + (b === undefined ? '（未記錄）' : JSON.stringify(b)) });\n            }\n        }\n        if (!reasons.length) return { ok: true, reasons: [], suggest: null };\n        return { ok: false, reasons, suggest: 'fork', message: '不相容，不能直接續訓／合併：' + reasons.map((r) => r.message).join('；') + '。請改以新資產 fork（parent 欄位記錄來源）。' };\n    }\n\n    function forkManifest(parent, o) {\n        o = o || {}; const m = clone(parent);\n        const name = o.name || (String(parent.name) + '-fork');\n        if (!safeName(name)) throw new Error('fork 的名稱不合法：' + name);\n        m.name = name; m.created = o.created || new Date().toISOString(); m.owner = 'user';\n        m.parent = { name: parent.name, kind: parent.kind, version: parent.version, manifest_sha256: manifestHash(parent) };\n        if (o.compat) m.compat = Object.assign({}, m.compat, o.compat);\n        if (m.compat && o.files) m.compat.data_sha256 = dataHash(o.files);\n        if (o.files) m.sha256 = hashFiles(o.files);\n        return m;\n    }\n\n    return { FORMAT, VERSION, KINDS, OWNERS, COMPAT_FIELDS, sha256Hex, stable, safePath, safeName, hashFiles, dataHash, manifestHash, createManifest, validateManifest, migrateManifest, verifyFiles, checkCompat, forkManifest, toU8 };\n});\n","ext_job_core.js":"/* 外部訓練作業（ext job）的純函式核心（UMD，node 可測）。\n * 六種型別的訓練核心都是命令列腳本：music_train.py、sr_train.py、speech_train.py、a2n_train.py、vlm/train_vlm_lora.py、image_sdxs_lora.py。\n * 這裡負責，與程序本身無關：\n *   1) SPECS：每個型別的腳本、需要的 Python 模組、路徑欄位（資料夾或檔案，要有哪些檔）、參數範圍與預設、輸出檔、判定規則。\n *   2) checkPaths／planFor：檢查路徑與參數，組出「步驟清單」（每步 cmd／args／cwd，以及核對規則）。\n *   3) runJob：依序執行步驟（注入 spawn、readJson，測試用假的）；串流進度；可停止；結束後核對輸出檔與規則。\n * 判定規則（check）是陣列：{op:'eq',a,b}（相等）、{op:'true',key}、{op:'gt0',key}、{op:'lt',a,b}；可指定 checkFile 讀 JSON 檔（而不是 stdout 的最後一行）。\n * wired＝true 的型別才會被工作室接成可按開始；其餘保持 wired:false 並寫明原因。\n * 測試：renderer/src/studio/ext_job_core.test.js */\n(function (root, factory) { if (typeof module === 'object' && module.exports) module.exports = factory(); else (root.FaExtJob = factory()); })(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n\n  function num(v, d) { var n = Number(v); return Number.isFinite(n) ? n : d; }\n  function clampCheck(p, name, lo, hi, errors) { var v = Number(p[name]); if (!Number.isFinite(v) || v < lo || v > hi) errors.push(name + ' 必須在 ' + lo + ' 到 ' + hi + ' 之間（目前 ' + p[name] + '）'); }\n\n  // 進度行：JSON（有 step 與 loss，或 loss_mean_recent）→ step 事件；「step N pair P loss X」（SDXS）→ step 事件；其他非空白行當作一般紀錄（截到 300 字）\n  function parseLine(line) {\n    var s = String(line || '').trim(); if (!s) return null;\n    if (s.charAt(0) === '{') {\n      try {\n        var o = JSON.parse(s);\n        if (o && typeof o === 'object') {\n          var lv = o.loss !== undefined ? o.loss : o.loss_mean_recent;\n          if (o.step !== undefined && lv !== undefined) return { type: 'step', step: Number(o.step), loss: Number(lv) };\n          return { type: 'json', data: o };\n        }\n      } catch (e) { /* 不是 JSON：當文字 */ }\n    }\n    var m = /^step (\\d+) pair \\d+ loss ([-\\d.eE+]+)/.exec(s);\n    if (m) return { type: 'step', step: Number(m[1]) + 1, loss: Number(m[2]) };\n    return { type: 'log', text: s.slice(0, 300) };\n  }\n\n  // 失敗原因翻譯（stderr 尾端）。只認常見的、能直接指引使用者的錯誤；認不得回 null\n  function explainCommon(stderr) {\n    var s = String(stderr || '');\n    var m = /ModuleNotFoundError: No module named '([^']+)'/.exec(s);\n    if (m) return '缺少 Python 套件「' + m[1] + '」。請在訓練環境安裝它後再試。';\n    if (/Could not import module 'BloomPreTrainedModel'|torchvision::nms does not exist/.test(s)) return 'Python 環境的 transformers 與 torchvision 版本不合（import 失敗）。請重建訓練環境。';\n    if (/CUDA out of memory|OutOfMemoryError|std::bad_alloc|MemoryError/.test(s)) return '記憶體不足。請把批次（batch）或解析度調小後再試。';\n    if (/FileNotFoundError|No such file or directory/.test(s)) { var f = /No such file or directory: '([^']+)'/.exec(s); return '找不到檔案或資料夾' + (f ? '（' + f[1] + '）' : '') + '。請確認路徑。'; }\n    return null;\n  }\n\n  // 語音辨識資料：每行一筆 JSON，要有 audio（相對路徑）、text（參考文字）、split（train 或 eval）。lines 是前幾行（字串陣列）\n  function srJsonlError(lines) {\n    if (!lines || !lines.length) return '檔案是空的';\n    for (var i = 0; i < lines.length; i++) {\n      var r; try { r = JSON.parse(lines[i]); } catch (e) { return '第 ' + (i + 1) + ' 行不是合法的 JSON'; }\n      if (typeof r.audio !== 'string' || typeof r.text !== 'string') return '第 ' + (i + 1) + ' 行缺 audio（錄音相對路徑）或 text（參考文字）';\n      if (r.split !== 'train' && r.split !== 'eval') return '第 ' + (i + 1) + ' 行的 split 必須是 train 或 eval';\n    }\n    return '';\n  }\n\n  var SPECS = {\n    music: {\n      id: 'music', name: '音樂作曲', wired: true, script: 'music_train.py', python: ['torch'], needsNode: true,\n      summary: '從零開始的小型作曲模型（約 46 萬參數），用程式作曲的旋律訓練。不是預訓練模型的微調。',\n      paths: [],\n      limits: { perStyle: [9, 500], heldout: [1, 50], seedStart: [0, 1e9], steps: [10, 20000], batch: [1, 64], lr: [1e-5, 0.1], seed: [0, 1e9], sampleSeed: [0, 1e9] },\n      defaults: { perStyle: 90, heldout: 10, seedStart: 1, steps: 1500, batch: 16, lr: 0.001, seed: 0, sampleSeed: 123 },\n      estimate: '處理器（CPU）約 1 分鐘（1500 步，實測 55 秒）。',\n      outputs: ['model.pt', 'config.json', 'vocab.json', 'train_meta.json', 'samples_after.jsonl', 'log.jsonl'],\n      checks: [{ op: 'eq', a: 'reloaded_songs_identical_to_training_run', b: 'of' }],\n      explain: explainCommon,\n      limitsNote: '只在程式作曲的資料上驗證（留出 90 首：損失 4.756→1.150；語法合格 2/36→27/36）。沒有和真實作曲比較過音樂品質。'\n    },\n    speech_recognition: {\n      id: 'speech_recognition', name: '語音辨識', wired: true, script: 'sr_train.py', python: ['torch', 'transformers', 'peft'], needsNode: false,\n      summary: '把錄音聽寫成文字。小型語音辨識基底（39M 參數）只在 q／v 投影掛 LoRA。',\n      paths: [\n        { key: 'base', kind: 'dir', label: '基底模型資料夾（小型語音辨識基底）', must: ['config.json'] },\n        { key: 'data', kind: 'file', label: '語音資料檔（data.jsonl）', format: 'sr' }\n      ],\n      limits: { steps: [1, 5000], batch: [1, 32], lr: [1e-5, 0.1], rank: [1, 64], alpha: [1, 256], seed: [0, 1e9] },\n      defaults: { steps: 40, batch: 4, lr: 0.001, rank: 8, alpha: 16, seed: 0 },\n      estimate: '處理器（CPU）40 步約 30 秒（實測 29 秒）；步數多時大致成比例增加。',\n      outputs: ['adapter/adapter_model.safetensors', 'adapter/adapter_config.json', 'log.jsonl', 'train_meta.json'],\n      checks: [{ op: 'eq', a: 'reloaded_matches_training_run', b: 'of' }],\n      explain: explainCommon,\n      limitsNote: '驗證集的字錯率沒有下降（實測 15.81%→15.81%；120 步反而變差到 17.28%）。損失下降不代表辨識變好。'\n    },\n    speech: {\n      id: 'speech', name: '語音合成', wired: true, script: 'speech/speech_train.py', python: ['torch', 'kokoro', 'soundfile'], needsNode: false,\n      summary: '把文字念成聲音。只訓練基底語音包的風格偏移（256 維），其餘權重凍結；結果是一個與語音包同格式的 .bin。',\n      paths: [\n        { key: 'model', kind: 'dir', label: 'Kokoro-82M 模型資料夾（config.json、kokoro-v1_0.pth）', must: ['config.json', 'kokoro-v1_0.pth'] },\n        { key: 'voice', kind: 'file', label: '基底語音包（.pt 或 .bin）' },\n        { key: 'data', kind: 'dir', label: '配對資料夾（train.jsonl、heldout.jsonl 與錄音）', must: ['train.jsonl', 'heldout.jsonl'] }\n      ],\n      limits: { steps: [1, 2000], lr: [1e-5, 0.1], seed: [0, 1e9], evalEvery: [1, 2000] },\n      defaults: { steps: 30, lr: 0.005, seed: 0, evalEvery: 10 },\n      estimate: '處理器（CPU）約 2 秒／步（實測 30 步 51 秒；以你的電腦為準）。',\n      outputs: ['voice_trained.bin', 'summary.json', 'log.jsonl', 'delta.pt', 'check.wav'],\n      checks: [{ op: 'gt0', key: 'samples' }],\n      explain: explainCommon,\n      limitsNote: '只訓練語音包的風格偏移，不是整個模型的微調。留出句的損失會降（實測 30 步：2.103→1.308），但沒有主觀聆聽評分；訓練資料是基底模型自己合成的教師音訊。'\n    },\n    audio_to_notes: {\n      id: 'audio_to_notes', name: '音訊轉音符', wired: true, script: 'a2n_train.py', python: ['torch', 'onnxruntime'], needsNode: true,\n      summary: '把錄音轉成音符。以 Basic Pitch 的轉譜模型（nmp.onnx）為底，全參數微調（凍結 CQT 前端），匯出 ONNX。',\n      paths: [{ key: 'base', kind: 'file', label: '基底轉譜模型（nmp.onnx）' }],\n      limits: { trainCount: [8, 5000], evalCount: [4, 2000], seedTrain: [0, 1e9], seedEval: [0, 1e9], steps: [1, 20000], batch: [1, 32], lr: [1e-6, 0.1], seed: [0, 1e9] },\n      defaults: { trainCount: 200, evalCount: 40, seedTrain: 1, seedEval: 2, steps: 300, batch: 4, lr: 0.0001, seed: 0 },\n      estimate: '處理器（CPU）300 步約 25 秒（實測 24 秒；以你的電腦為準）。',\n      outputs: ['model.onnx', 'log.jsonl'],\n      checks: [{ op: 'true', key: 'ort_loads' }],\n      explain: explainCommon,\n      limitsNote: '只用合成資料（已知音符的鋼琴式音色）訓練與驗證。實測（訓練腳本的音符幀 F1，留出 40 段合成資料）：0.927→0.957；先前紀錄的應用程式解碼器（100 段）：0.735→0.941。沒有真實錄音的驗證；應用程式仍用原版模型，這個新模型還沒有接進轉譜流程。'\n    },\n    vision: {\n      id: 'vision', name: '看圖說文字', wired: true, script: 'vlm/train_vlm_lora.py', python: ['torch', 'transformers', 'peft', 'PIL'], needsNode: false,\n      summary: '看圖回答或描述圖片。以小型看圖模型（SmolVLM 格式）為底，只掛 LoRA 小檔。資料由程式合成（顏色與形狀的圖）。',\n      paths: [{ key: 'base', kind: 'dir', label: '基底看圖模型資料夾（SmolVLM 格式）', must: ['config.json'] }],\n      limits: { steps: [1, 5000], accum: [1, 64], lr: [1e-6, 0.1], r: [1, 64], alpha: [1, 256], seed: [0, 1e9] },\n      defaults: { steps: 300, accum: 4, lr: 0.0002, r: 8, alpha: 16, seed: 1234 },\n      estimate: '處理器（CPU）約 1 秒／步（實測 300 步 264 秒；以你的電腦為準）。',\n      outputs: ['adapter/adapter_model.safetensors', 'adapter/adapter_config.json', 'train_result.json', 'eval.json'],\n      checks: [{ op: 'gt0', key: 'n' }],\n      explain: explainCommon,\n      limitsNote: '只用合成的顏色與形狀圖訓練與評量（留出的顏色與形狀組合不進訓練）。評量只看顏色與形狀是否說對，沒有人工評量。'\n    },\n    image: {\n      id: 'image', name: '圖像生成', wired: true, script: 'image_sdxs_lora.py', python: ['torch', 'diffusers', 'safetensors', 'PIL'], needsNode: false,\n      summary: '在 SDXS 快速模型上訓練 LoRA 小檔（只掛在注意力層）。資料由程式合成的圖文配對。',\n      paths: [{ key: 'base', kind: 'dir', label: 'SDXS 基底模型資料夾（unet、vae、text_encoder、tokenizer）', must: ['model_index.json', 'unet', 'vae', 'text_encoder', 'tokenizer'] }],\n      limits: { steps: [1, 2000], rank: [1, 64], alpha: [1, 256], lr: [1e-6, 0.1], seed: [0, 1e9] },\n      defaults: { steps: 40, rank: 8, alpha: 8, lr: 0.0005, seed: 1234, prompt: 'a red circle on a white background' },\n      estimate: '處理器（CPU）約 1 秒／步（512 解析度，實測 40 步訓練 35 秒）；核對生圖另加約 10 秒。',\n      outputs: ['lora.safetensors', 'lora.train.json', 'verify_verify.json', 'verify_before.png', 'verify_after.png'],\n      checkFile: 'verify_verify.json',\n      checks: [{ op: 'true', key: 'repeat_identical_before' }, { op: 'true', key: 'fresh_process_identical_to_in_process' }],\n      explain: explainCommon,\n      limitsNote: '只用合成的圖文配對訓練，輸出只有 LoRA（沒有完整模型）。LoRA 還沒有接進網頁或桌面的 ONNX 生圖執行環境（未驗證）。'\n    },\n    // 加長上下文（DESIGN.offline-training-studio.md §16）：長文 LoRA（YaRN）→ 合併 → 替換 q8 圖的旋轉表與線性層 → 以 ORT 核對\n    context_extend: {\n      id: 'context_extend', name: '加長上下文', wired: true, script: 'lora-train/ctx_extend/ctx_train.py', python: ['torch', 'transformers', 'peft', 'onnxruntime', 'onnx'], needsNode: false,\n      summary: '把基底語言模型的上下文加寬為 2 倍或 4 倍（YaRN 旋轉位置），用長文做一段 LoRA 微調，合併後輸出新的完整模型（ONNX q8）。',\n      paths: [\n        { key: 'base', kind: 'dir', label: '基底模型資料夾（Qwen3-0.6B：config.json、model.safetensors）', must: ['config.json', 'model.safetensors'] },\n        { key: 'q8', kind: 'file', label: '基底 ONNX q8 圖（model_quantized.onnx，結構要與 app 內的相同）' }\n      ],\n      limits: { factor: [2, 4], steps: [1, 2000], longLen: [1024, 16384], shortLen: [256, 4096], rank: [1, 64], lr: [1e-6, 0.1], seed: [0, 1e9] },\n      defaults: { factor: 2, steps: 40, longLen: 8192, shortLen: 1024, rank: 8, lr: 0.0001, seed: 42 },\n      estimate: '處理器（CPU）：一步約 1 段長窗＋2 段短窗的前後向，實測時間見 DESIGN §16.5（以你的電腦為準）；另加合併、匯出與核對。',\n      outputs: ['onnx/model_quantized.onnx', 'onnx/build.json', 'verify.json', 'train/train_log.json'],\n      checkFile: 'verify.json',\n      checks: [{ op: 'true', key: 'ok' }],\n      explain: explainCommon,\n      limitsNote: '只用 repo 內的 DESIGN 文件當長文（留出文件不進訓練）。驗收門檻見 verify 步驟（預先登記：餘弦 ≥ 0.9、首步 top-1 一致）。長度超過 4 倍（163840）在 CPU 上不實測。'\n    }\n  };\n\n  // 外部登錄的型別（自帶步驟規劃）：registerSpec(spec, planSteps(params, env) → { ok, errors[], steps[] })\n  var PLANNERS = {};\n  function registerSpec(spec, planSteps) { SPECS[spec.id] = spec; if (planSteps) PLANNERS[spec.id] = planSteps; return spec; }\n\n  function specOf(type) { return SPECS[type] || null; }\n\n  // 參數檢查：回傳 { ok, errors[], params }（params 已補上預設值）\n  function normalizeParams(type, raw) {\n    var s = specOf(type); if (!s) return { ok: false, errors: ['不認得的型別：' + type], params: {} };\n    var p = Object.assign({}, s.defaults, raw || {}), errors = [];\n    Object.keys(s.limits || {}).forEach(function (k) {\n      if (p[k] === undefined) return;\n      if (!Number.isFinite(Number(p[k])) || p[k] === '' || p[k] === null || typeof p[k] === 'boolean') { errors.push(k + ' 必須是數字（目前 ' + JSON.stringify(p[k]) + '）'); return; }\n      p[k] = Number(p[k]); clampCheck(p, k, s.limits[k][0], s.limits[k][1], errors);\n    });\n    return { ok: errors.length === 0, errors: errors, params: p };\n  }\n\n  // 路徑檢查（fsx：{ exists(p), isDir(p), readLines(p, n) }，由主行程注入；測試用假的）\n  function checkPaths(type, paths, fsx) {\n    var s = specOf(type), errors = []; paths = paths || {};\n    if (!s) return ['不認得的型別：' + type];\n    (s.paths || []).forEach(function (spec) {\n      var v = paths[spec.key];\n      if (!v) { errors.push('缺' + spec.label); return; }\n      if (spec.kind === 'dir') {\n        if (!fsx.isDir(v)) { errors.push(spec.label + '不存在或不是資料夾：' + v); return; }\n        (spec.must || []).forEach(function (m) { if (!fsx.exists(v + '/' + m)) errors.push(spec.label + '裡缺 ' + m); });\n      } else if (!fsx.exists(v)) { errors.push(spec.label + '不存在：' + v); return; }\n      if (spec.format === 'sr' && fsx.exists(v)) { var e = srJsonlError(fsx.readLines(v, 50)); if (e) errors.push('語音資料格式不對：' + e); }\n    });\n    return errors;\n  }\n\n  // 組步驟。env：{ python, nodeExec（預設 process.execPath）, scriptsDir（腳本所在資料夾）, outDir, paths: {…} }\n  // 回傳 { ok, errors[], steps[{id,label,cmd,args,cwd,env?,check?,checkFile?}], outputs[], spec, params, outDir }。路徑存在與否由呼叫端（checkPaths）檢查。\n  function planFor(type, raw, env) {\n    var s = specOf(type); env = env || {};\n    var fail = function (msg) { return { ok: false, errors: [msg], steps: [], outputs: [] }; };\n    if (!s) return fail('不認得的型別：' + type);\n    if (!s.wired) return fail(s.name + '：' + (s.reason || '還沒接線'));\n    var n = normalizeParams(type, raw); if (!n.ok) return { ok: false, errors: n.errors, steps: [], outputs: [] };\n    var p = n.params, out = env.outDir, sd = env.scriptsDir, py = env.python, paths = env.paths || {}, steps = [];\n    if (!out) return fail('缺輸出資料夾');\n    if (!py) return fail('找不到訓練用的 Python（請在工作室的「運算後端」設定，或指定訓練環境的 Python 路徑）');\n    var script = sd + '/' + s.script, node = env.nodeExec || process.execPath, nodeEnv = { ELECTRON_RUN_AS_NODE: '1' };\n    var st = function (id, label, cmd, args, extra) { var o = { id: id, label: label, cmd: cmd, args: args, cwd: sd }; return Object.assign(o, extra || {}); };\n    if (type === 'music') {\n      var corpus = out + '/corpus';\n      steps.push(st('gen', '產生作曲資料', node, [sd + '/music_train_core.js', 'gen', corpus, String(p.perStyle), String(p.seedStart), String(p.heldout)], { env: nodeEnv }));\n      steps.push(st('train', '訓練作曲模型', py, [script, 'train', '--corpus', corpus, '--out', out, '--steps', String(p.steps), '--batch', String(p.batch), '--lr', String(p.lr), '--seed', String(p.seed), '--sample_seed', String(p.sampleSeed)]));\n      steps.push(st('check', '從磁碟重新載入並核對', py, [script, 'check', '--out', out, '--corpus', corpus, '--sample_seed', String(p.sampleSeed)], { check: s.checks }));\n    } else if (type === 'speech_recognition') {\n      if (!paths.base) return fail('缺基底模型資料夾（小型語音辨識基底）');\n      if (!paths.data) return fail('缺語音資料檔（data.jsonl）');\n      steps.push(st('train', '訓練語音辨識 LoRA', py, [script, 'train', '--base', paths.base, '--data', paths.data, '--out', out, '--steps', String(p.steps), '--batch', String(p.batch), '--lr', String(p.lr), '--rank', String(p.rank), '--alpha', String(p.alpha), '--seed', String(p.seed)]));\n      steps.push(st('check', '從磁碟重新載入並核對', py, [script, 'check', '--base', paths.base, '--adapter', out + '/adapter', '--data', paths.data, '--hyp', out + '/hyp_after.json'], { check: s.checks }));\n    } else if (type === 'speech') {\n      if (!paths.model || !paths.voice || !paths.data) return fail('缺 Kokoro 模型資料夾、基底語音包或配對資料夾');\n      var cfgArgs = ['--config', paths.model + '/config.json', '--weights', paths.model + '/kokoro-v1_0.pth'];\n      steps.push(st('train', '訓練風格偏移（語音包）', py, [script].concat(cfgArgs, ['train', '--data', paths.data, '--base-voice', paths.voice, '--out', out, '--steps', String(p.steps), '--lr', String(p.lr), '--seed', String(p.seed), '--eval-every', String(p.evalEvery)])));\n      steps.push(st('check', '合成一句，核對可以載入', py, [script].concat(cfgArgs, ['synth', '--voice', out + '/voice_trained.bin', '--text', 'This is a loading check.', '--out', out + '/check.wav']), { check: s.checks }));\n    } else if (type === 'audio_to_notes') {\n      if (!paths.base) return fail('缺基底轉譜模型（nmp.onnx）');\n      var tr = out + '/train_data', ev = out + '/eval_data';\n      steps.push(st('gen_train', '產生訓練用合成資料', node, [sd + '/a2n_train_core.js', 'gen', tr, String(p.trainCount), String(p.seedTrain)], { env: nodeEnv }));\n      steps.push(st('gen_eval', '產生留出用合成資料', node, [sd + '/a2n_train_core.js', 'gen', ev, String(p.evalCount), String(p.seedEval)], { env: nodeEnv }));\n      steps.push(st('train', '微調轉譜模型', py, [script, 'train', '--onnx', paths.base, '--train', tr, '--eval', ev, '--out', out, '--steps', String(p.steps), '--batch', String(p.batch), '--lr', String(p.lr), '--seed', String(p.seed)]));\n      steps.push(st('check', '用 ONNX 執行器重新載入核對', py, [script, 'check', '--onnx', out + '/model.onnx', '--base', paths.base, '--eval', ev, '--out', out], { check: s.checks }));\n    } else if (type === 'vision') {\n      if (!paths.base) return fail('缺基底看圖模型資料夾');\n      var vdata = out + '/data';\n      steps.push(st('train', '訓練看圖 LoRA（含合成資料）', py, [script, '--model', paths.base, '--data', vdata, '--out', out, '--steps', String(p.steps), '--accum', String(p.accum), '--lr', String(p.lr), '--r', String(p.r), '--alpha', String(p.alpha), '--seed', String(p.seed)]));\n      steps.push(st('check', '載入 LoRA 重跑留出題', py, [sd + '/vlm/eval_vlm.py', '--model', paths.base, '--data', vdata, '--out', out + '/eval.json', '--adapter', out + '/adapter', '--max-new', '24'], { check: s.checks }));\n    } else if (type === 'image') {\n      if (!paths.base) return fail('缺 SDXS 基底模型資料夾');\n      var idata = out + '/data', lora = out + '/lora.safetensors';\n      steps.push(st('data', '產生合成圖文配對', py, [script, 'make-data', '--out', idata]));\n      steps.push(st('train', '訓練圖像 LoRA', py, [script, 'train', '--model', paths.base, '--data', idata, '--out', lora, '--steps', String(p.steps), '--rank', String(p.rank), '--alpha', String(p.alpha), '--lr', String(p.lr), '--seed', String(p.seed), '--resolution', '512']));\n      steps.push(st('check', '同一提示同一種子重生，核對載入', py, [script, 'verify', '--model', paths.base, '--lora', lora, '--prompt', String(p.prompt), '--seed', String(p.seed), '--out-prefix', out + '/verify'], { checkFile: s.checkFile, check: s.checks }));\n    } else if (PLANNERS[type]) {\n      var ext = PLANNERS[type](p, env);\n      if (!ext.ok) return { ok: false, errors: ext.errors, steps: [], outputs: [] };\n      steps = ext.steps;\n    } else if (type === 'context_extend') {\n      if (!paths.base) return fail('缺基底模型資料夾（Qwen3-0.6B）');\n      if (!paths.q8) return fail('缺基底 ONNX q8 圖');\n      var ctxTrain = out + '/train', ctxOnnx = out + '/onnx', ctxPy = sd + '/lora-train/ctx_extend/ctx_onnx.py';\n      steps.push(st('train', '長文 LoRA 微調（YaRN ×' + p.factor + '）', py, [script, '--base', paths.base, '--factor', String(p.factor), '--out', ctxTrain, '--steps', String(p.steps), '--long_len', String(p.longLen), '--short_len', String(p.shortLen), '--rank', String(p.rank), '--lr', String(p.lr), '--seed', String(p.seed)]));\n      steps.push(st('build', '替換旋轉表與線性層，寫 ONNX q8', py, [ctxPy, 'build', '--hf', ctxTrain + '/hf', '--factor', String(p.factor), '--src', paths.q8, '--out', ctxOnnx]));\n      steps.push(st('verify', '與 HF fp32 比對（ORT）', py, [ctxPy, 'verify', '--hf', ctxTrain + '/hf', '--onnx', ctxOnnx + '/model_quantized.onnx', '--lengths', '512', '2048', '--out', out + '/verify.json'], { checkFile: s.checkFile, check: s.checks }));\n    } else {\n      return fail(s.name + '：這個型別的步驟還沒有寫');\n    }\n    return { ok: true, errors: [], steps: steps, outputs: s.outputs.slice(), spec: s, params: p, outDir: out };\n  }\n\n  // 執行一組步驟。opts：{ spawn(cmd,args,{cwd,env}) → 子行程（需 stdout/stderr 的 on('data')、on('close')/on('error')）；\n  //   kill(child)；exists(path)；readJson(path) → 物件（checkFile 用）；join(a,b)；onEvent(ev)；onStep(state) }\n  // 回傳 job：{ state: running|finished|failed|stopped, steps[], events[], step, loss, message, stop(), done: Promise<job> }\n  function runJob(plan, opts) {\n    opts = opts || {};\n    var spec = plan.spec, job = { state: 'running', message: '', steps: plan.steps.map(function (s) { return { id: s.id, label: s.label, state: 'pending' }; }), events: [], step: 0, loss: null, stderrTail: '', child: null, stopReq: false, outDir: plan.outDir, outputs: [] };\n    var resolveDone; job.done = new Promise(function (r) { resolveDone = r; });\n    function pushEv(ev) { job.events.push(ev); if (job.events.length > 400) job.events.shift(); if (ev.type === 'step') { job.step = ev.step; job.loss = ev.loss; } if (opts.onEvent) { try { opts.onEvent(ev); } catch (e) { /* 紀錄回呼不影響訓練 */ } } }\n    function finish(state, msg) {\n      if (job.state !== 'running') return;\n      job.state = state; job.message = msg || job.message; job.child = null;\n      if (state === 'finished') {\n        var miss = plan.outputs.filter(function (f) { return !opts.exists || !opts.exists(opts.join(plan.outDir, f)); });\n        if (miss.length) { job.state = 'failed'; job.message = '步驟都跑完了，但輸出檔沒有產生：' + miss.join('、'); } else job.outputs = plan.outputs.slice();\n      }\n      resolveDone(job);\n    }\n    function runStep(i) {\n      if (job.stopReq) return finish('stopped', '使用者停止');\n      if (i >= plan.steps.length) return finish('finished', '');\n      var st = plan.steps[i]; job.steps[i].state = 'running'; if (opts.onStep) opts.onStep({ index: i, id: st.id, state: 'running' });\n      var stdoutBuf = '', stderr = '', lastObj = null, ch;\n      try { ch = opts.spawn(st.cmd, st.args, { cwd: st.cwd, env: st.env }); } catch (e) { job.steps[i].state = 'failed'; return finish('failed', '步驟「' + st.label + '」無法啟動：' + String((e && e.message) || e)); }\n      job.child = ch;\n      function eat(line) {\n        var ev = parseLine(line); if (!ev) return;\n        if (ev.type === 'json') lastObj = ev.data;\n        if (ev.type === 'json' || ev.type === 'step' || ev.type === 'log') pushEv(Object.assign({ stepId: st.id }, ev));\n      }\n      ch.stdout.on('data', function (b) { stdoutBuf += String(b); var parts = stdoutBuf.split(/\\r?\\n/); stdoutBuf = parts.pop(); parts.forEach(eat); });\n      ch.stderr.on('data', function (b) { stderr = (stderr + String(b)).slice(-8000); });\n      ch.on('error', function (e) { job.stderrTail = stderr.slice(-2000); job.steps[i].state = 'failed'; finish('failed', '步驟「' + st.label + '」執行失敗：' + String((e && e.message) || e)); });\n      ch.on('close', function (code) {\n        job.child = null; if (stdoutBuf) eat(stdoutBuf); stdoutBuf = '';\n        if (job.stopReq) { job.steps[i].state = 'stopped'; return finish('stopped', '使用者停止（停在「' + st.label + '」）'); }\n        if (code !== 0) { job.stderrTail = stderr.slice(-2000); job.steps[i].state = 'failed'; var why = (spec && spec.explain && spec.explain(stderr)) || ('代碼 ' + code); return finish('failed', '步驟「' + st.label + '」失敗：' + why); }\n        if (st.check) {\n          var obj = lastObj;\n          if (st.checkFile) { try { obj = opts.readJson(opts.join(plan.outDir, st.checkFile)); } catch (e) { obj = null; } }\n          var bad = checkResult(st.check, obj);\n          if (bad) { job.steps[i].state = 'failed'; return finish('failed', '步驟「' + st.label + '」核對不過：' + bad); }\n        }\n        job.steps[i].state = 'done'; if (opts.onStep) opts.onStep({ index: i, id: st.id, state: 'done' });\n        runStep(i + 1);\n      });\n    }\n    job.stop = function () { if (job.state !== 'running') return { ok: true, already: true }; job.stopReq = true; if (job.child && opts.kill) { try { opts.kill(job.child); } catch (e) { /* 已結束 */ } } return { ok: true }; };\n    if (typeof setImmediate === 'function') setImmediate(function () { runStep(0); }); else setTimeout(function () { runStep(0); }, 0);\n    return job;\n  }\n\n  // 判定規則：回傳 null 代表全部通過，否則回傳人看得懂的原因\n  function checkResult(rules, obj) {\n    if (!Array.isArray(rules)) return null;\n    if (!obj || typeof obj !== 'object') return '核對步驟沒有輸出可判讀的結果';\n    for (var i = 0; i < rules.length; i++) {\n      var r = rules[i];\n      if (r.op === 'eq') {\n        if (obj[r.a] === undefined) return '核對結果缺少「' + r.a + '」';\n        if (Number(obj[r.a]) !== Number(obj[r.b])) return r.a + '＝' + obj[r.a] + '，應該等於 ' + obj[r.b] + '（從磁碟重新載入的結果與訓練時不同）';\n      } else if (r.op === 'true') {\n        if (obj[r.key] !== true) return '核對結果的「' + r.key + '」應該是 true（目前 ' + JSON.stringify(obj[r.key]) + '）';\n      } else if (r.op === 'gt0') {\n        if (!(Number(obj[r.key]) > 0)) return '核對結果的「' + r.key + '」應該大於 0（目前 ' + JSON.stringify(obj[r.key]) + '）';\n      } else if (r.op === 'lt') {\n        if (obj[r.a] === undefined || obj[r.b] === undefined) return '核對結果缺少「' + r.a + '」或「' + r.b + '」';\n        if (!(Number(obj[r.a]) < Number(obj[r.b]))) return r.a + '（' + obj[r.a] + '）應該小於 ' + r.b + '（' + obj[r.b] + '）';\n      } else return '不認得的核對規則：' + r.op;\n    }\n    return null;\n  }\n\n  // 工作室用的摘要（不含 child、不含 done）：給 status 輪詢\n  function publicJob(job) {\n    if (!job) return null;\n    return { state: job.state, message: job.message, steps: job.steps.slice(), step: job.step, loss: job.loss, events: job.events.slice(-50), outDir: job.outDir, outputs: job.outputs.slice(), stderrTail: job.state === 'failed' ? job.stderrTail : '' };\n  }\n\n  // 建立 LLM（從零開始）：自帶規格與步驟規劃（llm_scratch_core.js）。只在 node 載入；檔案不存在（部分內嵌）才略過，其他錯誤照丟\n  if (typeof module === 'object' && module.exports && typeof require === 'function') {\n    try { var LS = require('./llm_scratch_core.js'); registerSpec(LS.SPEC, LS.planSteps); } catch (e) { if (!(e && e.code === 'MODULE_NOT_FOUND')) throw e; }\n  }\n\n  return { SPECS: SPECS, registerSpec: registerSpec, specOf: specOf, normalizeParams: normalizeParams, checkPaths: checkPaths, planFor: planFor, runJob: runJob, parseLine: parseLine, checkResult: checkResult, publicJob: publicJob, explainCommon: explainCommon, srJsonlError: srJsonlError };\n});\n","llm_scratch_core.js":"/* 「建立 LLM（從零開始）」的純函式核心（UMD，node 可測）。設計見 DESIGN.offline-training-studio.md「建立 LLM（從零開始）」。\n * 訓練本身在 llm_scratch.py（命令列腳本）；這裡只負責：\n *   SPEC       ext_job_core 的型別規格（腳本、需要的 Python 套件、參數範圍與預設、輸出檔、判定規則）\n *   STAGES     七個階段的說明（介面逐段顯示：清理、分詞器、預訓練、指令微調、評量、匯出、載入核對）\n *   planSteps  依參數組出步驟（cmd／args／cwd／check），格式與 ext_job_core.planFor 相同\n *   estimate   老實估時間（依 token 數與模型大小；量測值見 SEC_PER_KTOK）\n *   param 數量 paramCount(preset, vocab)\n *   CLI        node llm_scratch_core.js native-check …：用應用程式的原生執行環境（nr-engine.js）載入並回答一題\n * 與 ext_job_core 的接法：ExtJob.registerSpec(LlmScratch.SPEC)（studio_host.js 啟動時註冊）。\n * 原生執行環境寫死 28 層／8 個 KV 頭／head_dim 128，所以模型只能改寬度與詞彙表大小（見 SHAPE）。 */\n(function (root, factory) { if (typeof module === 'object' && module.exports) module.exports = factory(); else (root.FaLlmScratch = factory()); })(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n\n  var SHAPE = { layers: 28, heads: 8, kvHeads: 8, headDim: 128 };\n  var PRESETS = {\n    mini: { label: '迷你（約 1 千 3 百萬參數）', hidden: 96, intermediate: 256 },\n    small: { label: '小型（約 2 千萬參數）', hidden: 128, intermediate: 384 },\n    tiny: { label: '實驗用（4 層，約 2 百萬到 4 百萬參數）', hidden: 96, intermediate: 512, layers: 4 },\n  };\n  var ARCHS = {\n    dense: { label: '密集（標準）', what: '每個詞元都經過整個前饋層。' },\n    moe: { label: '專家混合（MoE）', what: '每層有多個專家，路由器為每個詞元挑前幾名並加權；訓練時加負載平衡輔助損失，避免只用少數專家。總參數比密集多，但每個詞元用到的參數與同寬度的密集模型相同。匯出給原生執行環境時，圖裡會把所有專家都算一遍（數值相同，但沒有省算力）。' },\n    reasoning: { label: '推理（思考＋答案）', what: '預訓練後先用「思考＋答案」格式做指令微調，再用可以程式核對答案的算術題做強化學習（GRPO，答對才給分）。架構與密集模型相同，差別在訓練方式。' },\n  };\n  // 預訓練每 1000 個 token 的秒數：mini 在負載平均約 65 的忙碌 24 核機器上實測（1992 秒／77 千 token）；tiny 實測 2.4（600 步×1024 token＝1453 秒，同樣忙碌）；\n  // small 沒有實測，依參數量比例（約 1.5 倍）估計。電腦閒置時預期較快，但沒有量測。專家混合（MoE）實測 tiny 為 1.09 倍（1586／1453 秒），其他大小沿用這個比例（未實測）。\n  var SEC_PER_KTOK = { mini: 26, small: 39, tiny: 2.4 };\n  var MOE_FACTOR = 1.1;\n  // 指令微調每步（批次 4）的秒數：mini 實測約 3（150 步 444 秒，含評量；先前記成 97 是 24 個執行緒搶核造成的假象，已修正執行緒上限）；\n  // tiny 的算術微調實測約 0.044 秒／筆（1200 步×16 筆 760 秒）；small 依比例估。\n  var SFT_SEC_PER_STEP = { mini: 3, small: 4.5, tiny: 0.18 };\n  var GRPO_SEC_PER_STEP = 12;   // 8 題 × 每題 8 個取樣（tiny，實測 150 步約 30 分鐘）；依「題數×每題取樣數」成比例\n  // 參數量（與 llm_scratch.py 的結構一致：詞嵌入與輸出頭共享）\n  function paramCount(preset, vocab) {\n    var p = PRESETS[preset]; if (!p) return NaN;\n    var H = p.hidden, I = p.intermediate, S = SHAPE, qd = S.heads * S.headDim, kd = S.kvHeads * S.headDim;\n    var perLayer = H * qd + 2 * H * kd + qd * H + 3 * H * I + 2 * H + 2 * S.headDim;\n    return vocab * H + S.layers * perLayer + H;\n  }\n\n  var STAGES = [\n    { id: 'prep', label: '語料清理與切分', what: '統一編碼、去掉控制字元與重複行、濾掉不是文字的行；以區塊為單位切出留出集。' },\n    { id: 'tokenizer', label: '訓練分詞器（BPE）', what: '位元組級 BPE，能處理繁體中文；量測在留出文字上的壓縮率，並核對編碼後可以原樣還原。' },\n    { id: 'pretrain', label: '預訓練', what: '下一詞預測。顯示訓練損失、留出損失與困惑度，並用同一批開頭文字前後對照生成。' },\n    { id: 'sft', label: '指令微調', what: '套用聊天樣板（與應用程式原生執行環境同一份），只對助理的回答算損失。' },\n    { id: 'export', label: '匯出 ONNX（q8）', what: '匯出 ONNX fp32，再動態量化為 q8；與 PyTorch 比對 logits 與貪婪 token。GGUF 為選配（目前未做）。' },\n    { id: 'hf', label: '輸出標準 Hugging Face 格式', what: '同一顆模型另存成標準 Qwen3 的 safetensors（可直接給 LoRA 微調與加長上下文接手），並用 transformers 載入、與自己的 logits 與貪婪輸出比對。' },\n    { id: 'check', label: '重新載入核對', what: '重新載入 q8 模型兩次，貪婪生成，結果須逐字相同，並與匯出時相同。' },\n    { id: 'native', label: '原生執行環境載入並回答', what: '用應用程式的原生執行環境（onnxruntime-node）載入並回答一題；僅在找得到執行環境時進行。' },\n    { id: 'math', label: '產生算術題', what: '可程式核對答案的加減乘題（兩位數），附逐步推導；留出題與訓練題不重複。' },\n    { id: 'eval_math', label: '算術正確率評量', what: '在留出題上用貪婪解碼，分「思考」與「不思考」兩種模式算答對率。' },\n    { id: 'grpo', label: '強化學習（GRPO）', what: '每題取樣一組回答，答對得 1 分、答錯 0 分；用組內相對分數更新模型。' },\n  ];\n\n  function explain(stderr) {\n    var s = String(stderr || '');\n    var m = /ModuleNotFoundError: No module named '([^']+)'/.exec(s);\n    if (m) return '缺少 Python 套件「' + m[1] + '」。請在訓練環境安裝它後再試。';\n    if (/MemoryError|std::bad_alloc|out of memory/i.test(s)) return '記憶體不足。請把批次或序列長度調小後再試。';\n    var e = /\"error\":\\s*\"([^\"]+)\"/.exec(s); if (e) return e[1];\n    return null;\n  }\n\n  var SPEC = {\n    id: 'llm_scratch', name: '建立 LLM（從零開始）', wired: true, script: 'llm_scratch.py',\n    python: ['torch', 'tokenizers', 'onnx', 'onnxruntime', 'numpy'], needsNode: false,\n    summary: '從語料開始，訓練分詞器、預訓練、指令微調，匯出可在應用程式離線載入的小模型（Qwen3 同型，約 1 千萬到 2 千萬參數）。',\n    paths: [],\n    limits: { vocab: [512, 32000], steps: [10, 200000], batch: [1, 64], seq: [32, 1024], lr: [1e-5, 0.1], warmup: [1, 5000], seed: [0, 1e9], sftSteps: [1, 5000], sftBatch: [1, 64], sftLr: [1e-6, 0.1], threads: [1, 64], layers: [1, 28], heads: [1, 64], kvHeads: [1, 64], hidden: [16, 2048], intermediate: [16, 8192], experts: [2, 64], topK: [1, 8], moeInter: [8, 4096], auxCoef: [0, 1], mathTrain: [100, 50000], mathSteps: [1, 20000], grpoSteps: [1, 5000], grpoPrompts: [1, 64], grpoGroup: [2, 64], grpoLr: [1e-7, 0.01] },\n    defaults: { arch: 'dense', corpus: '', preset: 'mini', sftData: '', vocab: 4096, steps: 300, batch: 4, seq: 128, lr: 0.002, warmup: 20, seed: 0, sftSteps: 40, sftBatch: 4, sftLr: 0.0005, threads: 6, experts: 8, topK: 2, auxCoef: 0.01, mathTrain: 2500, mathSteps: 1500, grpoSteps: 200, grpoPrompts: 8, grpoGroup: 8, grpoLr: 0.00002 },\n    estimate: '處理器（CPU）上，迷你模型預訓練每 1000 個 token 約 26 秒、指令微調每步約 3 秒（實測，在負載很高的 24 核機器上；閒置時預期較快，未量測）。預設 300 步 × 4 × 128 ≈ 15 萬 token，預訓練約 1 小時，指令微調 40 步約 2 分鐘，全流程約 1 小時；要訓練得像樣需要數十倍以上的 token 與時間。專家混合約慢 1.1 倍（tiny 實測）；推理另加算術微調與強化學習（tiny：強化學習每步約 12 秒）。',\n    outputs: ['data/prep_report.json', 'tok/tokenizer.json', 'tok/tokenizer_report.json', 'base/ckpt.pt', 'base/pretrain_meta.json', 'chat/ckpt.pt', 'chat/sft_meta.json', 'export/q8/model_quantized.onnx', 'export/hf/model.safetensors', 'export/hf/config.json', 'export/tokenizer.json', 'export/manifest.json', 'export/check.json'],\n    checks: [{ op: 'true', key: 'reload_identical' }, { op: 'true', key: 'matches_export' }],\n    explain: explain,\n    limitsNote: '模型只有 1 千萬到 2 千萬參數、語料只有幾 MB 時，預訓練後的文字只會是「像中文的片段」，不是能可靠回答的助理；指令微調只教會它聊天格式與少量範例。這是完整流程的實作與驗證，不是可用的聊天品質。原生執行環境寫死 28 層／8 個 KV 頭／head_dim 128，所以只能調寬度；結束標記不在它寫死的停止清單裡，會一直生成到字數上限（輸出文字會在 <|im_end|> 處截斷）。',\n  };\n\n  // 依參數組步驟。env：{ python, nodeExec, scriptsDir, outDir, nativeRuntimeDir?, paths? }\n  // p.arch：dense（預設）、moe、reasoning。參數 layers／heads／kvHeads／hidden／intermediate 不填就用大小預設。\n  function nativeCompatible(p) { return (p.kvHeads == null || Number(p.kvHeads) === SHAPE.kvHeads); }\n  function planSteps(p, env) {\n    var errors = [];\n    if (!PRESETS[p.preset]) errors.push('preset 必須是 ' + Object.keys(PRESETS).join('／') + '（目前 ' + JSON.stringify(p.preset) + '）');\n    if (!ARCHS[p.arch]) errors.push('arch 必須是 ' + Object.keys(ARCHS).join('／') + '（目前 ' + JSON.stringify(p.arch) + '）');\n    if (p.warmup >= p.steps) errors.push('warmup 必須小於 steps');\n    var heads = p.heads != null ? Number(p.heads) : SHAPE.heads, kv = p.kvHeads != null ? Number(p.kvHeads) : SHAPE.kvHeads;\n    if (heads % kv) errors.push('注意力頭數（' + heads + '）必須是鍵值頭數（' + kv + '）的倍數');\n    if (p.arch === 'moe' && Number(p.topK) > Number(p.experts)) errors.push('每個詞元挑的專家數（' + p.topK + '）不能大於專家總數（' + p.experts + '）');\n    if (errors.length) return { ok: false, errors: errors, steps: [] };\n    var sd = env.scriptsDir, out = env.outDir, py = env.python, script = sd + '/' + SPEC.script, s = String;\n    var st = function (id, label, cmd, args, extra) { return Object.assign({ id: id, label: label, cmd: cmd, args: args, cwd: sd }, extra || {}); };\n    var arch = [];\n    if (p.arch === 'moe') arch.push('--arch', 'moe', '--experts', s(p.experts), '--top-k', s(p.topK), '--aux-coef', s(p.auxCoef)); else arch.push('--arch', 'dense');\n    if (p.moeInter != null && p.arch === 'moe') arch.push('--moe-inter', s(p.moeInter));\n    [['layers', '--layers'], ['heads', '--heads'], ['kvHeads', '--kv-heads'], ['hidden', '--hidden'], ['intermediate', '--intermediate']].forEach(function (kv2) { if (p[kv2[0]] != null) arch.push(kv2[1], s(p[kv2[0]])); });\n    var steps = [];\n    var prep = [script, 'prep', '--out', out + '/data'];\n    var corpus = p.corpus || (env.paths && env.paths.corpus) || '';\n    if (corpus) prep.push('--corpus', s(corpus)); else prep.push('--builtin');\n    steps.push(st('prep', STAGES[0].label, py, prep));\n    steps.push(st('tokenizer', STAGES[1].label, py, [script, 'tokenizer', '--data', out + '/data', '--out', out + '/tok', '--vocab', s(p.vocab)], { check: [{ op: 'true', key: 'roundtrip_all_ok' }] }));\n    steps.push(st('pretrain', STAGES[2].label, py, [script, 'pretrain', '--data', out + '/data', '--tok', out + '/tok/tokenizer.json', '--out', out + '/base', '--preset', p.preset, '--steps', s(p.steps), '--batch', s(p.batch), '--seq', s(p.seq), '--lr', s(p.lr), '--warmup', s(p.warmup), '--seed', s(p.seed), '--threads', s(p.threads), '--eval-every', s(Math.max(10, Math.floor(p.steps / 4)))].concat(arch), { check: [{ op: 'lt', a: 'heldout_loss_after', b: 'heldout_loss_before' }] }));\n    var final = out + '/chat';\n    if (p.arch === 'reasoning') {\n      var md = out + '/math';\n      steps.push(st('math', STAGES[8].label, py, [script, 'gen-math', '--out', md, '--n-train', s(p.mathTrain), '--seed', s(p.seed)]));\n      steps.push(st('sft', STAGES[3].label + '（思考＋答案）', py, [script, 'sft', '--base', out + '/base', '--data', md + '/math_train_hybrid.jsonl', '--out', out + '/chat', '--steps', s(p.mathSteps), '--batch', s(p.sftBatch), '--lr', s(p.sftLr), '--seed', s(p.seed), '--heldout-frac', '0.02', '--answer-tokens', '80'], { check: [{ op: 'lt', a: 'heldout_loss_after', b: 'heldout_loss_before' }] }));\n      steps.push(st('eval_sft', STAGES[9].label + '（微調後）', py, [script, 'eval-math', '--model', out + '/chat', '--data', md + '/math_heldout.jsonl', '--tag', 'sft', '--threads', s(p.threads)]));\n      steps.push(st('grpo', STAGES[10].label, py, [script, 'grpo', '--base', out + '/chat', '--problems', md + '/math_train_plain.jsonl', '--out', out + '/rl', '--steps', s(p.grpoSteps), '--prompts', s(p.grpoPrompts), '--group', s(p.grpoGroup), '--lr', s(p.grpoLr), '--seed', s(p.seed), '--threads', s(p.threads)]));\n      steps.push(st('eval_rl', STAGES[9].label + '（強化學習後）', py, [script, 'eval-math', '--model', out + '/rl', '--data', md + '/math_heldout.jsonl', '--tag', 'rl', '--threads', s(p.threads)]));\n      final = out + '/rl';\n    } else {\n      var sft = [script, 'sft', '--base', out + '/base', '--out', out + '/chat', '--steps', s(p.sftSteps), '--batch', s(p.sftBatch), '--lr', s(p.sftLr), '--seed', s(p.seed)];\n      if (p.sftData) sft.push('--data', s(p.sftData));\n      steps.push(st('sft', STAGES[3].label, py, sft, { check: [{ op: 'lt', a: 'heldout_loss_after', b: 'heldout_loss_before' }] }));\n    }\n    var native = nativeCompatible(p);\n    if (native) steps.push(st('export', STAGES[4].label, py, [script, 'export', '--model', final, '--out', out + '/export'], { check: [{ op: 'true', key: 'fp32_greedy_matches_torch' }] }));\n    steps.push(st('hf', STAGES[5].label, py, [script, 'export-hf', '--model', final, '--out', out + '/export/hf'], { check: [{ op: 'true', key: 'transformers_loads' }, { op: 'true', key: 'greedy_identical' }] }));\n    if (native) steps.push(st('check', STAGES[6].label, py, [script, 'check', '--model-dir', out + '/export'], { check: SPEC.checks }));\n    if (native && env.nativeRuntimeDir) {\n      steps.push(st('native', STAGES[7].label, env.nodeExec || process.execPath, [sd + '/llm_scratch_core.js', 'native-check', '--runtime', env.nativeRuntimeDir, '--model-dir', out + '/export', '--question', s(p.nativeQuestion || (p.arch === 'reasoning' ? '計算 37+48 等於多少？' : '臺灣的首都是哪裡？'))], { env: { ELECTRON_RUN_AS_NODE: '1' }, check: [{ op: 'true', key: 'native_loaded' }, { op: 'gt0', key: 'n_tokens' }, { op: 'true', key: 'native_reload_identical' }] }));\n    }\n    return { ok: true, errors: [], steps: steps, nativeCompatible: native };\n  }\n\n  // 估時間（分鐘）：預訓練的 token 數 × 每千 token 秒數；指令微調依步數；推理另加算術微調與強化學習；另加匯出與核對約 3 分鐘\n  function estimate(p) {\n    var spk = (SEC_PER_KTOK[p.preset] || SEC_PER_KTOK.mini) * (p.arch === 'moe' ? MOE_FACTOR : 1);\n    var pre = p.steps * p.batch * p.seq / 1000 * spk / 60, sfp = SFT_SEC_PER_STEP[p.preset] || SFT_SEC_PER_STEP.mini, grpo = 0, sft;\n    if (p.arch === 'reasoning') {\n      sft = p.mathSteps * (p.sftBatch / 4) * sfp / 60;\n      grpo = (p.grpoSteps || 0) * GRPO_SEC_PER_STEP * ((p.grpoPrompts || 8) * (p.grpoGroup || 8) / 64) / 60;\n    } else sft = p.sftSteps * (p.sftBatch / 4) * sfp / 60;\n    return { pretrainMin: Math.round(pre), sftMin: Math.max(1, Math.round(sft)), grpoMin: Math.round(grpo), exportMin: 3, totalMin: Math.round(pre + sft + grpo + 3), params: Math.round(paramCount(p.preset, p.vocab)) };\n  }\n\n  // ---- CLI：原生執行環境載入並回答 ----\n  function nativeCheck(opt) {\n    var path = require('path'), fs = require('fs');\n    var engine = require(path.join(opt.runtime, 'nr-engine.js'));\n    var modelPath = path.join(opt.modelDir, 'q8', 'model_quantized.onnx'), tokPath = path.join(opt.modelDir, 'tokenizer.json');\n    var gen = { do_sample: false };\n    var run = function () { return engine.generate({ modelPath: modelPath, tokenizerPath: tokPath, messages: [{ role: 'user', content: opt.question }], gen: gen, maxTokens: opt.maxTokens || 48, threads: 4 }); };\n    return run().then(function (a) {\n      return run().then(function (b) {\n        var rep = { event: 'native_check', native_loaded: true, native_answered: typeof a.text === 'string' && a.text.length > 0, native_reload_identical: a.text === b.text && JSON.stringify(a.ids) === JSON.stringify(b.ids), question: opt.question, answer: a.text, finish_reason: a.finish_reason, n_tokens: a.ids.length };\n        fs.writeFileSync(path.join(opt.modelDir, 'native_check.json'), JSON.stringify(rep, null, 2));\n        return rep;\n      });\n    });\n  }\n\n  return { SHAPE: SHAPE, PRESETS: PRESETS, ARCHS: ARCHS, nativeCompatible: nativeCompatible, SEC_PER_KTOK: SEC_PER_KTOK, SFT_SEC_PER_STEP: SFT_SEC_PER_STEP, GRPO_SEC_PER_STEP: GRPO_SEC_PER_STEP, MOE_FACTOR: MOE_FACTOR, STAGES: STAGES, SPEC: SPEC, paramCount: paramCount, planSteps: planSteps, estimate: estimate, nativeCheck: nativeCheck };\n});\n\nif (typeof require === 'function' && require.main === module) {\n  var C = module.exports, args = process.argv.slice(2), cmd = args.shift(), o = {};\n  for (var i = 0; i < args.length; i += 2) o[args[i].replace(/^--/, '')] = args[i + 1];\n  if (cmd === 'native-check') {\n    C.nativeCheck({ runtime: o.runtime, modelDir: o['model-dir'], question: o.question || '臺灣的首都是哪裡？', maxTokens: Number(o['max-tokens']) || 48 })\n      .then(function (r) { console.log(JSON.stringify(r)); }, function (e) { console.log(JSON.stringify({ event: 'native_check', native_loaded: false, native_answered: false, error: String((e && e.message) || e) })); process.exit(2); });\n  } else { console.error('用法：node llm_scratch_core.js native-check --runtime <執行包資料夾> --model-dir <export 資料夾> [--question 文字]'); process.exit(1); }\n}\n","studio_host.js":"'use strict';\n// 離線訓練工作室的「主行程端」（Node，CommonJS）。把後端登錄表、基準測試、自動選擇、cpu-py 訓練子行程包成一組以 op 名稱分派的操作，\n// 由 main-ext.js 的原生信箱（studio_* op）呼叫；renderer 把本檔與 studio 其餘核心（backend_*、bench_core、checkpoint_core、studio_config_core）\n// 當字串嵌進 floating-assistant.js，執行時寫到 <userData>/studio-host/ 再由主行程載入（不需要重新安裝）。\n// 純依賴注入：fs／path／os／child_process／userData 路徑都由呼叫端給，測試時全用假的。長工作（基準、訓練）一律背景執行、用 status 輪詢。\nconst BackendCore = require('./backend_core.js');\nconst BC = require('./bench_core.js');\nconst SC = require('./studio_config_core.js');\nconst CpuJs = require('./backend_cpu_js.js');\nconst CpuPy = require('./backend_cpu_py.js');\nconst Planned = require('./backend_planned.js');\nconst LlmExport = require('./llm_export_core.js');\nconst Asset = require('./asset_core.js');\nconst ExtJob = require('./ext_job_core.js');\n\n// LLM 匯出工具偵測（DESIGN §25）：不再只看 PATH。來源：lora-train/.venv（訓練，有 peft）、lora-train/.venv-export（匯出，有 optimum-cli、onnxruntime、transformers）、\n// 與 <userData>/studio-host/llm-export-config.json 的 { llamaBin, llamaSrc, trainPython, exportPython }（llama.cpp 不在任何 venv 裡，只能設定）。\n// 工具找不到就 found:false 並寫原因；不執行模型，只跑 import 與檔案存在檢查。\n\nfunction createStudioHost(d) {\n  const fs = d.fs, P = d.path, os = d.os, cp = d.cp;\n  const hostDir = d.hostDir, now = d.now || (() => Date.now());\n  const cpus = os.cpus() || [], hw = { cpuModel: (cpus[0] && cpus[0].model) || '', cores: cpus.length || 1 };\n  const jf = (name) => P.join(hostDir, name);\n  const readJson = (f, dflt) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch (e) { return dflt; } };\n  const writeJson = (f, o) => { try { fs.mkdirSync(P.dirname(f), { recursive: true }); fs.writeFileSync(f, JSON.stringify(o)); return true; } catch (e) { return false; } };\n\n  // ---- Configure 設定 ----\n  const loadConfig = () => SC.normalize(readJson(jf('studio-config.json'), {}), hw.cores);\n  let config = loadConfig().config;\n  // ---- 後端登錄 ----\n  // 訓練腳本所在：使用者資料夾 → 注入的 loraDir → 開發目錄／安裝目錄（loraDirs，由主行程給）；都沒有就回第一個（probe 會說找不到）\n  const loraDirOf = () => { const a = P.join(hostDir, 'lora-train'), cands = [a, d.loraDir].concat(d.loraDirs || []).filter(Boolean); for (const c of cands) { if (fs.existsSync(P.join(c, 'train_lora.py'))) return c; } return d.loraDir || a; };\n  const killTree = d.killTree || ((ch) => { try { if (process.platform === 'win32' && ch.pid) cp.spawn('taskkill', ['/PID', String(ch.pid), '/T', '/F'], { windowsHide: true }); else ch.kill('SIGTERM'); } catch (e) {} });\n  const spawnLow = (c, a, o) => {\n    const ch = cp.spawn(c, a, Object.assign({}, o, { windowsHide: true }));\n    // 以較低優先權執行（Configure 的 lowPriority）：不可用就略過，不影響訓練\n    try { if (config.lowPriority && ch && ch.pid && os.setPriority) os.setPriority(ch.pid, os.constants.priority.PRIORITY_BELOW_NORMAL); } catch (e) {}\n    return ch;\n  };\n  const registry = new BackendCore.BackendRegistry();\n  // 探測用的非同步執行器（execFile）：探測期間主行程的事件迴圈不被擋住（用 spawnSync 會讓整個主行程卡住數秒）\n  const runAsync = (cmd, args, o) => new Promise((res) => {\n    try { cp.execFile(cmd, args, { encoding: 'utf8', windowsHide: true, timeout: o && o.timeout }, (err, stdout) => { if (!err) return res({ status: 0, stdout: String(stdout) }); const e = err.killed ? Object.assign(new Error('ETIMEDOUT'), { code: 'ETIMEDOUT' }) : err; res({ error: e, status: null, stdout: String(stdout || '') }); }); } catch (e) { res({ error: e, status: null }); }\n  });\n  // Python 探測結果快取（存使用者資料夾；鍵含 python 路徑與修改時間，裝／卸套件後自動失效）\n  const detectCache = { get(k) { const m = readJson(jf('cpu-py-detect-cache.json'), {}); return m[k] || null; }, set(k, v) { const m = readJson(jf('cpu-py-detect-cache.json'), {}); m[k] = v; writeJson(jf('cpu-py-detect-cache.json'), m); } };\n  const pyDetect = CpuPy.defaultDetect(runAsync, { fs, path: P, cache: detectCache, venvDirs: () => [loraDirOf(), P.join(hostDir, 'lora-train'), d.loraDir].concat(d.loraDirs || []) });\n  const cpuPy = CpuPy.createCpuPyBackend({ detect: pyDetect, spawn: spawnLow, killTree, fs, path: P, get loraDir() { return loraDirOf(); }, hw, get config() { return config; }, env: d.env || {} });\n  registry.register(CpuJs.createCpuJsBackend({ engineVersion: 'tiny-1' }));\n  const rawProbe = cpuPy.probe.bind(cpuPy), PROBE_TTL = 60000, probeSt = { val: null, at: 0, running: null };\n  const refreshProbe = () => probeSt.running || (probeSt.running = (async () => { try { probeSt.val = await rawProbe(); probeSt.at = now(); } finally { probeSt.running = null; } })());\n  cpuPy.probe = async (ctx) => {\n    const fresh = probeSt.val && now() - probeSt.at < (probeSt.val.available ? PROBE_TTL : 5000);   // 不可用的結果只留 5 秒：使用者裝好環境後很快就要看到變化\n    if (fresh) return probeSt.val;\n    if (ctx && ctx.fast) { refreshProbe().catch(() => {}); return probeSt.val ? Object.assign({}, probeSt.val, { probing: true }) : BackendCore.probeResult(false, '探測中…', { name: hw.cpuModel || 'CPU', vendor: 'cpu', fp16: false }, { backend: 'cpu-py' }); }\n    await refreshProbe(); return probeSt.val;\n  };\n  registry.register(cpuPy);\n  ['wasm-web', 'webgpu', 'directml', 'vulkan'].forEach((id) => registry.register(Planned.createPlannedBackend(id, {})));\n  const benchCache = BC.createBenchCache({ load: () => readJson(jf('bench-cache.json'), null), save: (o) => writeJson(jf('bench-cache.json'), o) }, now);\n  const ctxOf = (p) => ({ hw, modelSha256: (p && p.modelSha256) || null });\n\n  const jobs = new Map(); let seq = 0;\n  const newId = (k) => k + (++seq) + '_' + now().toString(36);\n  let activeBench = null, activeTrain = null;\n\n  // ---- 基準測試資料（小：16 筆；不下載任何東西）----\n  function benchDataFile() {\n    const f = jf('bench-train.jsonl'); if (fs.existsSync(f)) return f;\n    const rows = []; for (let i = 0; i < BC.BENCH.samples; i++) rows.push(JSON.stringify({ id: 'b' + i, split: 'train', domain: 'bench', messages: [{ role: 'user', content: '基準測試問題 ' + i }], completion: '基準測試回答 ' + i, meta: {} }));\n    fs.mkdirSync(P.dirname(f), { recursive: true }); fs.writeFileSync(f, rows.join('\\n') + '\\n'); return f;\n  }\n  // 基準測試時間上限：預設 60 秒是給 GPU／頁內後端的；cpu-py 是整段 Python 訓練，慢的處理器（如這台 4 核 i5-2320，每步十幾秒）要 33 步，放寬到 20 分鐘（仍可隨時按停止，3 秒內結束）\n  const BENCH_DEADLINE_CPU_PY = 20 * 60 * 1000, benchDeadline = (id) => id === 'cpu-py' ? BENCH_DEADLINE_CPU_PY : undefined;\n  const benchCfg = (id, p) => id === 'cpu-py'\n    ? { base: (p && p.base) || 'Qwen/Qwen3-0.6B', trainFile: benchDataFile(), accum: 1, outputDir: P.join(hostDir, 'bench-out'), threads: SC.resolveThreads(config, hw.cores, 'benchmark') }\n    : { threads: SC.resolveThreads(config, hw.cores, 'benchmark') };\n\n  // ---- LLM 匯出（DESIGN §25）----\n  const exportJobs = new Map(); let activeExport = null;\n  const llmCfg = () => readJson(jf('llm-export-config.json'), {});\n  const venvPy = (dir, name) => P.join(dir, name, process.platform === 'win32' ? P.join('Scripts', 'python.exe') : P.join('bin', 'python'));\n  const exists = (f) => { try { return !!f && fs.existsSync(f); } catch (e) { return false; } };\n  async function probeLlmTools() {\n    const cfg = llmCfg(), dir = loraDirOf(), tools = {}, paths = {};\n    const trainPy = cfg.trainPython || (await pyDetect().catch(() => ({}))).path || null;\n    const exportPy = cfg.exportPython || (exists(venvPy(dir, '.venv-export')) ? venvPy(dir, '.venv-export') : null);\n    paths.trainPy = trainPy; paths.exportPy = exportPy;\n    const pyCheck = async (py, code, label, want) => {\n        if (!py) return { found: false, reason: '找不到' + label + '的 Python' };\n        const r = await runAsync(py, ['-c', code], { timeout: 30000 });\n        if (r.error || r.status !== 0) return { found: false, reason: label + '（' + py + '）import 失敗' };\n        return { found: true, version: String(r.stdout || '').trim().split(/\\r?\\n/).pop() || null, path: py };\n    };\n    tools.peft = await pyCheck(trainPy, 'import peft, transformers; print(peft.__version__)', '訓練環境', 'peft');\n    const exOk = await pyCheck(exportPy, 'import onnxruntime, transformers; print(onnxruntime.__version__)', '匯出環境', 'onnxruntime');\n    tools.onnxruntime = exOk;\n    const oc = exportPy ? P.join(P.dirname(exportPy), process.platform === 'win32' ? 'optimum-cli.exe' : 'optimum-cli') : null;\n    tools.optimum = exists(oc) ? { found: true, path: oc, version: null } : { found: false, reason: '匯出環境裡沒有 optimum-cli' };\n    const bin = cfg.llamaBin || null, src = cfg.llamaSrc || null;\n    const hasLlama = bin && exists(P.join(bin, 'llama-quantize' + (process.platform === 'win32' ? '.exe' : ''))) && exists(P.join(bin, 'llama-server' + (process.platform === 'win32' ? '.exe' : '')));\n    const hasConv = src && exists(P.join(src, 'convert_hf_to_gguf.py'));\n    tools.llamaCpp = hasLlama && hasConv ? { found: true, path: bin } : { found: false, reason: !bin ? '沒有設定 llama.cpp（llm-export-config.json 的 llamaBin）' : (!hasLlama ? 'llamaBin 裡沒有 llama-quantize／llama-server' : 'llamaSrc 裡沒有 convert_hf_to_gguf.py') };\n    paths.llamaBin = bin; paths.llamaSrc = src; paths.lora = dir;\n    return { tools, paths };\n  }\n  // 續跑用：每一步的輸出（續跑前若這一步沒完成，先刪掉它可能殘留的半成品，免得匯出腳本誤判「已存在」）\n  const STEP_OUT = {\n      onnx: { merge: (w) => [P.join(w, 'merged')], convert: (o) => [P.join(o, 'fp32')], quantize: (o) => [P.join(o, 'q8')], verify: (o) => [P.join(o, 'check.json')], pack: (o) => [P.join(o, 'manifest.json')] },\n      gguf: { merge: (w) => [P.join(w, 'merged')], convert: (o) => [P.join(o, 'model-f16.gguf'), P.join(o, 'hf-input')], quantize: (o) => [P.join(o, 'model-q8_0.gguf')], verify: (o) => [P.join(o, 'check_gguf.json')], pack: (o) => [P.join(o, 'manifest_gguf.json')] }\n  };\n  const rmOut = (f) => { try { fs.rmSync ? fs.rmSync(f, { recursive: true, force: true }) : null; } catch (e) { /* 刪不掉就讓步驟自己報錯 */ } };\n  const stateFile = (w) => P.join(w, 'export_state.json');\n  // 啟動（新工作或續跑）。續跑＝同一個 workDir，從 export_state.json 讀已完成的步驟，跳過它們\n  async function launchLlmJob(format, workDir, p, pr) {\n    const outDir = P.join(workDir, format);\n    const cmds = LlmExport.buildStepCommands(format, { pyTrain: pr.paths.trainPy, pyExport: pr.paths.exportPy, scriptsDir: pr.paths.lora, baseDir: p.baseDir, adapterDir: p.adapterDir, workDir, outDir, llamaDir: pr.paths.llamaBin, llamaSrc: pr.paths.llamaSrc, recipe: String(p.recipe || 'full') });\n    if (!cmds.ok) return { ok: false, error: cmds.error };\n    const prev = readJson(stateFile(workDir), null);\n    const doneSet = new Set(prev && prev.format === format ? (prev.done || []) : []);\n    // 已完成的步驟要確認輸出還在；不在就當沒做過\n    for (const id of Array.from(doneSet)) { const outs = (STEP_OUT[format][id] || (() => []))(id === 'merge' ? workDir : outDir); if (!outs.every((f) => exists(f))) doneSet.delete(id); }\n    for (const st of cmds.steps) if (!doneSet.has(st.id)) for (const f of (STEP_OUT[format][st.id] || (() => []))(st.id === 'merge' ? workDir : outDir)) rmOut(f);\n    const job = { id: newId('llmexp'), format, state: 'running', events: [], result: null, workDir, outDir, startedAt: now(), endedAt: 0, child: null, stopReq: null, done: Array.from(doneSet), baseDir: p.baseDir, adapterDir: p.adapterDir, recipe: String(p.recipe || 'full') };\n    exportJobs.set(job.id, job); activeExport = job;\n    const runner = (argv) => new Promise((res) => {\n        let out = '', err = '', settled = false; const done = (r) => { if (!settled) { settled = true; job.child = null; res(r); } };\n        // 匯出用低優先權（訓練也是 nice 19）；Linux 用 nice 前綴，其他系統直接執行\n        const useNice = process.platform === 'linux' && exists('/usr/bin/nice');\n        const cmd = useNice ? '/usr/bin/nice' : argv[0], args = useNice ? ['-n', '19'].concat(argv) : argv.slice(1);\n        let ch; try { ch = cp.spawn(cmd, args, { cwd: pr.paths.lora, windowsHide: true, detached: process.platform !== 'win32' }); } catch (e) { return done({ code: -1, stdout: '', stderr: String((e && e.message) || e) }); }\n        job.child = ch;\n        ch.stdout.on('data', (b) => { out += String(b); if (out.length > 4e6) out = out.slice(-2e6); });\n        ch.stderr.on('data', (b) => { err += String(b); if (err.length > 4e6) err = err.slice(-2e6); });\n        ch.on('error', (e) => done({ code: -1, stdout: out, stderr: err + String((e && e.message) || e) }));\n        ch.on('close', (code) => done({ code, stdout: out, stderr: err }));\n    });\n    job.done_promise = LlmExport.runExportSteps(cmds, runner, {\n        skip: doneSet,\n        isStopRequested: () => !!job.stopReq,\n        onEvent: (e) => { job.events.push(e); if (job.events.length > 400) job.events.shift(); if (e.type === 'step-end' && e.state === '完成') { if (job.done.indexOf(e.id) < 0) job.done.push(e.id); writeJson(stateFile(workDir), { format, done: job.done, recipe: job.recipe, baseDir: p.baseDir, adapterDir: p.adapterDir }); } }\n    })\n        .then((r) => {\n            job.result = r; job.endedAt = now();\n            job.state = r.ok ? 'finished' : (job.stopReq ? job.stopReq : 'failed');\n            writeJson(stateFile(workDir), { format, done: r.done, recipe: job.recipe, baseDir: p.baseDir, adapterDir: p.adapterDir, state: job.state });\n            writeJson(P.join(workDir, 'export_job.json'), { format, recipe: job.recipe, state: job.state, ok: r.ok, failedAt: r.failedAt, steps: r.steps, startedAt: job.startedAt, endedAt: job.endedAt, baseDir: p.baseDir, adapterDir: p.adapterDir });\n        })\n        .catch((e) => { job.state = 'failed'; job.result = { ok: false, failedAt: null, steps: [], error: String((e && e.message) || e) }; job.endedAt = now(); });\n    return { ok: true, jobId: job.id, workDir, outDir, format, steps: cmds.steps.map((s) => ({ id: s.id, label: s.label })), skipped: Array.from(doneSet) };\n  }\n  // 匯出結果打包成資產內容（給工作室登錄成 kind:'llm' 資產）：小檔案放進資產（base64），權重在外部（位置、大小、sha256）\n  function llmBundle(p) {\n    const j = exportJobs.get(p && p.jobId) || activeExport;\n    if (!j) return { ok: false, error: '找不到匯出工作' };\n    if (j.state !== 'finished') return { ok: false, error: '匯出尚未完成（目前：' + j.state + '）' };\n    const man = readJson(P.join(j.outDir, 'manifest.json'), null) || readJson(P.join(j.outDir, 'manifest_gguf.json'), null);\n    if (!man || !Array.isArray(man.files)) return { ok: false, error: '找不到匯出的 manifest（pack 步驟沒有完成？）' };\n    // 要進資產的：部署用的權重（ONNX 的 q8 或 GGUF 的 Q8_0）與小檔（分詞器、設定、核對報告）。fp32 的 ONNX（約 3 GB）是中間產物，不進資產。\n    const DEPLOY = { onnx: ['q8/model_quantized.onnx'], gguf: ['model-q8_0.gguf'] };\n    const want = DEPLOY[man.format] || [];\n    const files = [], excluded = [];\n    for (const f of man.files) {\n      const abs = P.join(j.outDir, f.path);\n      if (!exists(abs)) return { ok: false, error: '缺檔：' + f.path };\n      const st = fs.statSync(abs);\n      if (st.size !== f.bytes) return { ok: false, error: '大小與 manifest 不符：' + f.path };\n      if (/\\.onnx(_data)?$|\\.gguf$/.test(f.path) && want.indexOf(f.path) < 0) { excluded.push(f.path); continue; }\n      files.push({ rel: f.path, path: abs, bytes: f.bytes, sha256: f.sha256 });\n    }\n    return { ok: true, format: man.format, quant: man.format === 'onnx' ? 'q8' : 'q8_0', recipe: man.recipe || j.recipe || null, files, excluded,\n      source: { baseDir: j.baseDir || null, adapterDir: j.adapterDir || null }, outDir: j.outDir };\n  }\n  // 登錄（桌面版，主行程端）：把匯出的部署檔直接從磁碟讀進 <userData>/studio-assets/llm/<名稱>/（與 rawfs 儲存層同一個版面），manifest 最後寫。\n  // 不經過渲染程序的 base64 IPC：756 MB 的 q8 在字串上限（約 512 MB）以上，渲染端讀不了（實測的錯誤見 DESIGN §25.13）。\n  function llmRegister(p) {\n    const b = llmBundle(p);\n    if (!b.ok) return b;\n    const name = String(p.name || ('llm-' + b.format + '-' + new Date().toISOString().replace(/[:.]/g, '-')));\n    if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(name)) return { ok: false, error: '名稱不合法（只能用英數、點、底線、連字號，最長 64 字）：' + name };\n    const root = P.join(P.dirname(hostDir), 'studio-assets'), dir = P.join(root, 'llm', name);\n    if (exists(P.join(dir, 'manifest.json'))) return { ok: false, error: '「' + name + '」已存在（換一個名稱）' };\n    const files = {};\n    for (const f of b.files) {\n      const u = fs.readFileSync(f.path);\n      if (u.length !== f.bytes) return { ok: false, error: '大小與 manifest 不符：' + f.rel };\n      files[f.rel] = new Uint8Array(u.buffer, u.byteOffset, u.length);\n    }\n    const base = (b.source.baseDir || '').split(/[\\\\/]/).pop() || null, adapter = (b.source.adapterDir || '').split(/[\\\\/]/).pop() || null;\n    const m = Asset.createManifest({ kind: 'llm', name, files, owner: 'user', base, compat: { base, adapter }, counts: {}, eval: null });\n    m.llm = { format: b.format, quant: b.quant, recipe: b.recipe, excluded: b.excluded };\n    m.counts = { files: Object.keys(files).length, bytes: Object.keys(files).reduce((x, k) => x + files[k].length, 0) };\n    const v = Asset.validateManifest(m); if (!v.ok) return { ok: false, error: '資產 manifest 不合法：' + v.errors.join('；') };\n    // 先寫檔（暫存名再改名），每個檔寫完讀回雜湊核對\n    const written = [];\n    try {\n      for (const rel of Object.keys(files)) {\n        const dst = P.join(dir, rel), tmp = dst + '.tmp-' + process.pid; fs.mkdirSync(P.dirname(dst), { recursive: true });\n        fs.writeFileSync(tmp, files[rel]); fs.renameSync(tmp, dst); written.push(dst);\n        const back = fs.readFileSync(dst); if (Asset.sha256Hex(new Uint8Array(back.buffer, back.byteOffset, back.length)) !== m.sha256[rel]) throw new Error('寫入後核對失敗：' + rel);\n      }\n      fs.writeFileSync(P.join(dir, 'manifest.json'), JSON.stringify(m, null, 1)); // manifest 最後寫：沒有它的資料夾視為未完成\n    } catch (e) { for (const f of written) { try { fs.unlinkSync(f); } catch (_) { /* */ } } return { ok: false, error: String((e && e.message) || e) }; }\n    return { ok: true, kind: 'llm', name, files: Object.keys(files), bytes: m.counts.bytes, excluded: b.excluded, dataMayBeLost: false, warning: '', root: dir };\n  }\n  // 模型選單（桌面版）：把工作室的 llm 資產設為離線模型。主行程的 main-ext.js 讀 <hostDir>/llm-model-choice.json（沒有就照舊用標準版）\n  // 桌面版：資產的權重落在儲存層（rawfs：<userData>/studio-assets/llm/<名稱>/…），模型路徑由名稱決定\n  function llmUse(p) {\n    const name = String(p.name || ''); if (!/^[^\\/\\\\.][^\\/\\\\]*$/.test(name)) return { ok: false, error: '名稱不合法' };\n    const root = P.join(P.dirname(hostDir), 'studio-assets', 'llm', name);\n    const modelPath = P.join(root, 'q8', 'model_quantized.onnx'), tokenizerPath = P.join(root, 'tokenizer.json');\n    if (!exists(modelPath)) return { ok: false, error: '資產 llm/' + name + ' 裡沒有 q8/model_quantized.onnx（或還沒寫到儲存層）' };\n    if (!exists(tokenizerPath)) return { ok: false, error: '資產 llm/' + name + ' 裡沒有 tokenizer.json' };\n    writeJson(jf('llm-model-choice.json'), { name, modelPath, tokenizerPath, chosenAt: now() });\n    return { ok: true, name, modelPath, tokenizerPath };\n  }\n  function llmUseClear() { try { fs.unlinkSync(jf('llm-model-choice.json')); } catch (e) { /* 本來就沒有 */ } return { ok: true }; }\n  function llmUseCurrent() { const c = readJson(jf('llm-model-choice.json'), null); return { ok: true, choice: c && exists(c.modelPath) ? c : null }; }\n  async function startLlmExport(p) {\n    const format = String(p.format || '');\n    if (!LlmExport.FORMATS.includes(format)) return { ok: false, error: '格式必須是 ' + LlmExport.FORMATS.join(' 或 ') };\n    if (activeExport && activeExport.state === 'running') return { ok: false, error: '已有匯出在執行中（' + activeExport.id + '）' };\n    const baseDir = String(p.baseDir || ''), adapterDir = String(p.adapterDir || '');\n    if (!baseDir || !exists(baseDir)) return { ok: false, error: '基底模型資料夾不存在：' + baseDir };\n    if (!adapterDir) return { ok: false, error: '請給 LoRA adapter 資料夾（adapterDir）' };\n    const pr = await probeLlmTools();\n    const av = LlmExport.exportAvailability(pr.tools)[format];\n    if (!av.available) return { ok: false, error: av.reason, tools: pr.tools };\n    const stamp = new Date(now()).toISOString().replace(/[:.]/g, '-');\n    const workDir = String(p.workDir || P.join(pr.paths.lora, 'out', 'llm-export', stamp));\n    if (exists(workDir) && fs.readdirSync(workDir).length) return { ok: false, error: '工作資料夾不是空的（要續跑請用 resume）：' + workDir };\n    return launchLlmJob(format, workDir, p, pr);\n  }\n  // 續跑：同一個工作資料夾（需要它的 export_state.json）；不會重做已完成的步驟\n  async function resumeLlmExport(p) {\n    if (activeExport && activeExport.state === 'running') return { ok: false, error: '已有匯出在執行中' };\n    const prev = exportJobs.get(p && p.jobId) || null;\n    const workDir = String((p && p.workDir) || (prev && prev.workDir) || '');\n    if (!workDir || !exists(workDir)) return { ok: false, error: '找不到工作資料夾' };\n    const st = readJson(stateFile(workDir), null);\n    if (!st || !st.format) return { ok: false, error: '工作資料夾沒有 export_state.json，不能續跑' };\n    const baseDir = String(p && p.baseDir || st.baseDir || ''), adapterDir = String(p && p.adapterDir || st.adapterDir || '');\n    if (!baseDir || !exists(baseDir)) return { ok: false, error: '基底模型資料夾不存在：' + baseDir };\n    const pr = await probeLlmTools();\n    const av = LlmExport.exportAvailability(pr.tools)[st.format];\n    if (!av.available) return { ok: false, error: av.reason, tools: pr.tools };\n    return launchLlmJob(st.format, workDir, { baseDir, adapterDir, recipe: String(p && p.recipe || st.recipe || 'full') }, pr);\n  }\n  // 暫停／取消：要求停止，並結束目前的子行程（整個行程群組）。暫停與取消都保留已完成步驟；差別只在狀態名稱\n  function stopLlmExport(p, kind) {\n    const j = exportJobs.get(p && p.jobId) || activeExport;\n    if (!j || j.state !== 'running') return { ok: false, error: '沒有執行中的匯出' };\n    j.stopReq = kind; // 'paused' 或 'cancelled'\n    try { if (j.child && j.child.pid) { if (process.platform !== 'win32') process.kill(-j.child.pid, 'SIGTERM'); else j.child.kill('SIGTERM'); } } catch (e) { try { j.child.kill('SIGTERM'); } catch (_) { /* 已結束 */ } }\n    return { ok: true, jobId: j.id, state: kind };\n  }\n\n  // ---- 外部訓練作業（六種型別的命令列核心；ext_job_core.js）----\n  // 輸出放 <userData>/studio-ext/<型別>/<名稱>/；每次只跑一個；同名輸出夾已有內容就拒絕（不覆寫）。\n  const extJobsMap = new Map(); let activeExt = null;\n  const extRoot = P.join(P.dirname(hostDir), 'studio-ext');\n  const extKill = (ch) => { try { if (process.platform !== 'win32' && ch.pid) process.kill(-ch.pid, 'SIGTERM'); else ch.kill('SIGTERM'); } catch (e) { try { ch.kill('SIGTERM'); } catch (_) { /* 已結束 */ } } };\n  // 腳本位置：主行程注入的候選資料夾（開發樹的 renderer/src/studio），第一個含該腳本的為準\n  const extScriptsDir = (spec) => { for (const dd of (d.extScriptDirs || [])) { if (dd && exists(P.join(dd, spec.script))) return dd; } return null; };\n  // 訓練用 Python：參數指定 → llm-export-config.json 的 trainPython → 既有的 cpu-py 探測\n  // 訓練用 Python（每個型別可以不同）：參數指定 → llm-export-config.json 的 extPythons[型別] → trainPython → 既有的 cpu-py 探測\n  async function extPython(p, type) { if (p && p.python) return String(p.python); const cfg = llmCfg(); const per = cfg.extPythons && cfg.extPythons[type]; if (per) return String(per); if (cfg.trainPython) return cfg.trainPython; const pr = await pyDetect().catch(() => null); return (pr && pr.path) || null; }\n  // 路徑：p.paths（新）；舊的 p.base／p.data 也接受\n  function extPaths(p) { const out = Object.assign({}, (p && p.paths) || {}); if (p && p.base && !out.base) out.base = p.base; if (p && p.data && !out.data) out.data = p.data; return out; }\n  const extFsx = { exists: (f) => exists(f), isDir: (f) => { try { return fs.statSync(f).isDirectory(); } catch (e) { return false; } }, readLines: (f, n) => { try { return fs.readFileSync(f, 'utf8').split(/\\r?\\n/).filter((l) => l.trim()).slice(0, n); } catch (e) { return []; } } };\n  // 逐個模組檢查 import（回傳缺的套件與原因；不跑訓練）\n  async function extModules(py, mods) {\n    const missing = [];\n    for (const m of mods) { const r = await runAsync(py, ['-c', 'import ' + m], { timeout: 60000 }); if (r.error || r.status !== 0) missing.push(m); }\n    return missing;\n  }\n  async function extCheck(p) {\n    const type = String((p && p.type) || ''), spec = ExtJob.specOf(type);\n    if (!spec) return { ok: false, error: '不認得的型別：' + type };\n    if (!spec.wired) return { ok: false, wired: false, error: spec.name + '：' + spec.reason };\n    const n = ExtJob.normalizeParams(type, (p && p.params) || {});\n    const paths = extPaths(p), py = await extPython(p, type), scripts = extScriptsDir(spec);\n    const out = { ok: false, wired: true, type, params: n.params, errors: n.errors.slice(), python: py, scriptsDir: scripts, estimate: spec.estimate, limitsNote: spec.limitsNote || '', paths };\n    if (!py) out.errors.push('找不到訓練用的 Python（請在「運算後端」設定，或指定這個型別的 Python 路徑）');\n    if (py && /[\\\\/]/.test(py) && !exists(py)) out.errors.push('找不到訓練用的 Python：' + py + '（路徑不存在，請改指定正確的 Python）');\n    if (!scripts) out.errors.push('找不到訓練腳本 ' + spec.script + '（主行程沒有接上腳本資料夾）');\n    out.errors = out.errors.concat(ExtJob.checkPaths(type, paths, extFsx));\n    if (py && scripts && !(/[\\\\/]/.test(py) && !exists(py))) { out.missing = await extModules(py, spec.python); if (out.missing.length) out.errors.push('訓練環境缺套件：' + out.missing.join('、')); }\n    out.ok = out.errors.length === 0;\n    return out;\n  }\n  async function extStart(p) {\n    if (activeExt && activeExt.job.state === 'running') return { ok: false, error: '已有外部訓練在執行（' + activeExt.id + '）' };\n    if (activeTrain && activeTrain.state === 'running') return { ok: false, error: '內建訓練進行中，請先等它結束或停止' };\n    const type = String((p && p.type) || ''), name = String((p && p.name) || '');\n    if (!/^[A-Za-z0-9\\u4e00-\\u9fff][A-Za-z0-9._\\-\\u4e00-\\u9fff]{0,63}$/.test(name)) return { ok: false, error: '名稱不合法（英數、中文、點、底線、連字號，最長 64 字）' };\n    const chk = await extCheck(p); if (!chk.ok) return { ok: false, error: (chk.errors || [chk.error || '檢查沒有通過']).join('；'), check: chk };\n    const spec = ExtJob.specOf(type), outDir = P.join(extRoot, type, name);\n    if (exists(outDir) && fs.readdirSync(outDir).length) return { ok: false, error: '輸出資料夾已有內容（換一個名稱，不覆寫）：' + outDir };\n    const plan = ExtJob.planFor(type, p.params || {}, { outDir, scriptsDir: chk.scriptsDir, python: chk.python, nodeExec: process.execPath, paths: chk.paths, nativeRuntimeDir: (typeof d.nativeRuntimeDir === 'function' ? d.nativeRuntimeDir() : null) });\n    if (!plan.ok) return { ok: false, error: plan.errors.join('；') };\n    fs.mkdirSync(outDir, { recursive: true });\n    writeJson(P.join(outDir, 'ext_request.json'), { type, name, params: plan.params, python: chk.python, paths: chk.paths, startedAt: now() });\n    const id = newId('ext');\n    const job = ExtJob.runJob(plan, {\n      spawn: (c, a, o) => cp.spawn(c, a, { cwd: o.cwd, env: Object.assign({}, process.env, o.env || {}), windowsHide: true, detached: process.platform !== 'win32', stdio: ['ignore', 'pipe', 'pipe'] }),\n      kill: extKill, exists: (f) => exists(f), join: (a, b) => P.join(a, b), readJson: (f) => JSON.parse(fs.readFileSync(f, 'utf8')),\n    });\n    const rec = { id, type, name, job, startedAt: now(), endedAt: 0, outDir };\n    extJobsMap.set(id, rec); activeExt = rec;\n    job.done.then((j) => { rec.endedAt = now(); writeJson(P.join(outDir, 'ext_job.json'), Object.assign({ type, name, startedAt: rec.startedAt, endedAt: rec.endedAt }, ExtJob.publicJob(j))); });\n    return { ok: true, jobId: id, outDir, steps: plan.steps.map((s) => ({ id: s.id, label: s.label })), estimate: spec.estimate, limitsNote: spec.limitsNote || '' };\n  }\n  function extStatus(p) {\n    const rec = extJobsMap.get(p && p.jobId) || activeExt; if (!rec) return { ok: true, state: 'idle' };\n    return Object.assign({ ok: true, jobId: rec.id, type: rec.type, name: rec.name, outDir: rec.outDir, elapsedMs: (rec.endedAt || now()) - rec.startedAt }, ExtJob.publicJob(rec.job));\n  }\n  function extStop(p) { const rec = extJobsMap.get(p && p.jobId) || activeExt; if (!rec || rec.job.state !== 'running') return { ok: true, already: true }; return rec.job.stop(); }\n\n  const ops = {\n    // 狀態：硬體、設定、各後端是否可用與原因\n    async studio_probe(p) {\n      const kind = (p && p.kind) || 'lora', list = await registry.listFor(kind, Object.assign(ctxOf(p), { fast: true }));   // 畫面用：不等慢的探測\n      const sym = BackendCore.isSymbolicKind(kind);\n      return { ok: true, kind, symbolic: sym, hw, config, backends: sym ? [{ id: 'cpu-js', available: true, reason: '', note: '只需處理器' }] : list.map((x) => ({ id: x.id, available: x.available, reason: x.reason, probing: x.reason === '探測中…' || !!(x.probe && x.probe.probing), device: x.probe && x.probe.device, planned: !!(registry.get(x.id) || {}).planned })), loraDir: loraDirOf(), threads: SC.resolveThreads(config, hw.cores, 'train') };\n    },\n    async studio_probe_wait() { try { await (probeSt.running || Promise.resolve()); } catch (e) {} return { ok: true, done: !probeSt.running }; },\n    async studio_config_get() { return { ok: true, config, schema: SC.SCHEMA, hw }; },\n    async studio_config_set(p) {\n      const r = SC.normalize(Object.assign({}, config, (p && p.patch) || {}), hw.cores);\n      config = r.config; writeJson(jf('studio-config.json'), config);\n      return { ok: true, config, errors: r.errors, warnings: r.warnings };\n    },\n    // 基準測試：對所有可用後端依序跑，一次一個；回 jobId，用 studio_bench_status 輪詢，studio_bench_stop 中斷\n    async studio_bench_start(p) {\n      if (activeBench && activeBench.state === 'running') return { ok: false, error: '基準測試正在執行（job ' + activeBench.id + '）' };\n      if (activeTrain && activeTrain.state === 'running') return { ok: false, error: '訓練進行中：為了讓電腦保持可用，訓練結束或暫停後才能跑基準測試' };\n      const kind = (p && p.kind) || 'lora', ids = registry.supportedFor(kind);\n      const job = { id: newId('bench'), kind, state: 'running', rows: [], log: [], startedAt: now(), ac: { aborted: false, listeners: [], addEventListener(t, f) { this.listeners.push(f); }, removeEventListener() {} } };\n      job.signal = job.ac; activeBench = job; jobs.set(job.id, job);\n      (async () => {\n        try {\n          for (const id of ids) {\n            if (job.ac.aborted) break;\n            const b = registry.get(id), pr = await BackendCore.safeProbe(b, ctxOf(p));\n            const fp = Object.assign({}, pr.fingerprint, { model_sha256: (p && p.modelSha256) || null, backend: id });\n            const row = { id, available: pr.available, reason: pr.reason || '', state: 'pending', fingerprint: fp };\n            job.rows.push(row);\n            if (!pr.available) { row.state = 'skipped'; continue; }\n            row.state = 'running';\n            let r; try { r = await b.benchmark(benchCfg(id, p), { signal: job.signal, deadlineMs: (p && p.deadlineMs) || benchDeadline(id) }); } catch (e) { r = { ok: false, error: String(e && e.message || e), reason: String(e && e.message || e) }; }\n            if (r && r.aborted) { row.state = 'aborted'; row.reason = '使用者中斷'; break; }\n            row.result = { ok: !!r.ok, tokPerSec: r.tokPerSec, peakMemBytes: r.peakMemBytes, stepMsP50: r.stepMsP50, stepMsP95: r.stepMsP95, numericCheck: r.numericCheck, reason: r.reason, elapsedMs: r.elapsedMs };\n            row.passed = BC.benchPassed(r); row.state = row.passed ? 'passed' : 'failed'; row.at = now();\n            if (r && r.ok) await benchCache.store(id, fp, r);\n          }\n          job.state = job.ac.aborted ? 'aborted' : 'done';\n        } catch (e) { job.state = 'error'; job.error = String(e && e.message || e); }\n        job.endedAt = now();\n      })();\n      return { ok: true, jobId: job.id };\n    },\n    async studio_bench_status(p) { const j = jobs.get(p && p.jobId) || activeBench; if (!j) return { ok: false, error: '沒有這個基準測試工作' }; return { ok: true, jobId: j.id, state: j.state, rows: j.rows, error: j.error || null, elapsedMs: (j.endedAt || now()) - j.startedAt }; },\n    async studio_bench_stop(p) {\n      const j = jobs.get(p && p.jobId) || activeBench; if (!j || j.state !== 'running') return { ok: true, already: true };\n      j.ac.aborted = true; j.ac.listeners.forEach((f) => { try { f(); } catch (e) {} }); return { ok: true };\n    },\n    // 自動選擇：只用快取（不跑基準，避免意外吃資源）；沒有快取結果就回 needsRebench\n    async studio_select(p) {\n      const r = await BC.autoSelect({ kind: (p && p.kind) || 'lora', registry, cache: benchCache, ctx: Object.assign(ctxOf(p), { fast: true }), pin: p && p.pin, skipBench: true });\n      return Object.assign({ ok: !!r.chosen }, r);\n    },\n    // 訓練：目前只有 lora（cpu-py）有真的子行程訓練；符號式五類由主程式端的 sym_train_core 執行（設計 §15.3）\n    async studio_train_start(p) {\n      p = p || {}; const kind = p.kind || 'lora';\n      if (kind !== 'lora') return { ok: false, error: kind + ' 是符號式訓練，由主程式的 studio_server（sym_train_core）執行，不經主行程子行程；這裡只處理 lora' };\n      if (p.backend && p.backend !== 'cpu-py') return { ok: false, error: '後端 ' + p.backend + ' 目前只有 cpu-py 能實際訓練' };\n      if (activeTrain && (activeTrain.state === 'running' || activeTrain.state === 'pausing')) return { ok: false, error: '已有訓練在執行（' + activeTrain.id + '）' };\n      if (activeBench && activeBench.state === 'running') return { ok: false, error: '基準測試進行中，請先等它結束或按停止' };\n      const cfg = p.cfg || {};\n      // 從資產挑的資料集：伺服器把檔案內容放在 cfg.trainText，這裡寫成輸出資料夾下的 train.jsonl 再當訓練檔（使用者不必自己找路徑）\n      if (cfg.trainText && cfg.outputDir) { try { fs.mkdirSync(cfg.outputDir, { recursive: true }); cfg.trainFile = P.join(cfg.outputDir, 'train.jsonl'); fs.writeFileSync(cfg.trainFile, String(cfg.trainText)); delete cfg.trainText; } catch (e) { return { ok: false, error: '寫入訓練資料失敗：' + String(e && e.message || e) }; } }\n      if (!cfg.trainFile || !cfg.outputDir) return { ok: false, error: '缺少 trainFile／outputDir' };\n      const pr = await BackendCore.safeProbe(cpuPy, ctxOf(p)); if (!pr.available) return { ok: false, error: 'cpu-py 不可用：' + pr.reason };\n      const job = { id: newId('train'), kind, state: 'running', events: [], lastStep: 0, lastLoss: null, startedAt: now(), cfg };\n      const hooks = { onEvent: (e) => { job.events.push(e); if (job.events.length > 400) job.events.shift(); if (e.step) job.lastStep = e.step; if (e.type === 'log') job.lastLoss = e.loss; } };\n      try { job.run = p.resume ? await cpuPy.resumeRun(cfg, hooks) : await cpuPy.startRun(cfg, hooks); } catch (e) { return { ok: false, error: String(e && e.message || e) }; }\n      activeTrain = job; jobs.set(job.id, job);\n      job.run.done.then((r) => { job.state = (job.run && job.run.state) || 'finished'; job.result = r && { state: r.state }; job.endedAt = now(); });\n      return { ok: true, jobId: job.id };\n    },\n    // 流程總覽讀真實紀錄（DESIGN §19）：<runDir>/train.log 尾端 2MB；run.pid 對應的子行程 VmRSS（Linux 才有 /proc；其他系統說明未取樣）；主行程 RSS 另附\n    async studio_run_info(p) {\n      const dir = String((p && p.runDir) || ''); if (!dir) return { ok: false, error: '缺 runDir' };\n      let log = null; try { const t = fs.readFileSync(P.join(dir, 'train.log'), 'utf8'); log = t.length > 2000000 ? t.slice(t.length - 2000000) : t; } catch (e) { log = null; }\n      let pid = null; try { pid = parseInt(fs.readFileSync(P.join(dir, 'run.pid'), 'utf8'), 10) || null; } catch (e) { pid = null; }\n      let rssBytes = null, rssReason = '';\n      if (!pid) rssReason = '沒有 run.pid（子行程 pid 未記錄）';\n      else if (process.platform === 'win32') {\n        try { const r = cp.spawnSync('tasklist', ['/FI', 'PID eq ' + pid, '/FO', 'CSV', '/NH'], { encoding: 'utf8', windowsHide: true, timeout: 5000 }); const bytes = parseTasklistMemory(r.stdout || ''); if (bytes !== null) rssBytes = bytes; else rssReason = 'tasklist 查不到子行程 ' + pid + '（可能已結束）'; }\n        catch (e) { rssReason = 'tasklist 執行失敗：' + String((e && e.message) || e); }\n      }\n      else if (process.platform !== 'linux') rssReason = '這個系統（' + process.platform + '）還沒有子行程記憶體取樣（尚未實作）';\n      else { try { const st = fs.readFileSync('/proc/' + pid + '/status', 'utf8'); const m = /VmRSS:\\s+(\\d+)\\s+kB/.exec(st); if (m) rssBytes = +m[1] * 1024; else rssReason = '/proc 沒有 VmRSS 欄位'; } catch (e) { rssReason = '子行程已結束，或讀不到 /proc/' + pid + '/status'; } }\n      let hostRssBytes = null; try { hostRssBytes = process.memoryUsage().rss; } catch (e) { hostRssBytes = null; }\n      const events = log ? log.split(/\\r?\\n/).map((l) => CpuPy.parseProgressLine(l)).filter(Boolean).slice(-5000) : [];\n      return { ok: true, runDir: dir, log, events, pid, rssBytes, rssReason: rssBytes === null ? rssReason : '', hostRssBytes };\n    },\n    // LLM 匯出工具偵測（DESIGN §20.3 第 2 項）：只在 PATH 上找可執行檔；onnxruntime 要查 python 模組，這版還沒做，照實回報\n    async studio_export_tools() {\n        const pr = await probeLlmTools();\n        return { ok: true, tools: LlmExport.probeExportTools((n) => pr.tools[n]), paths: pr.paths, checkedAt: now() };\n    },\n    // LLM 匯出（DESIGN §25）：背景執行；每一步的 JSON 結果由 llm_export_core.runExportSteps 整理\n    async studio_llm_export(p) { return startLlmExport(p || {}); },\n    async studio_llm_export_pause(p) { return stopLlmExport(p || {}, 'paused'); },\n    async studio_llm_export_bundle(p) { return llmBundle(p || {}); },\n    async studio_llm_register(p) { return llmRegister(p || {}); },\n    async studio_llm_use(p) { return llmUse(p || {}); },\n    async studio_llm_use_clear() { return llmUseClear(); },\n    async studio_llm_use_current() { return llmUseCurrent(); },\n    async studio_llm_export_cancel(p) { return stopLlmExport(p || {}, 'cancelled'); },\n    async studio_llm_export_resume(p) { return resumeLlmExport(p || {}); },\n    async studio_llm_export_status(p) {\n        const j = exportJobs.get(p && p.jobId) || activeExport; if (!j) return { ok: true, state: 'idle' };\n        return { ok: true, jobId: j.id, format: j.format, state: j.state, events: j.events.slice(-100), steps: j.result ? j.result.steps : null, failedAt: j.result ? j.result.failedAt : null, workDir: j.workDir, outDir: j.outDir, elapsedMs: (j.endedAt || now()) - j.startedAt };\n    },\n    async studio_run_current() { const j = activeTrain || Array.from(jobs.values()).pop(); return { ok: true, runDir: j && j.cfg && j.cfg.outputDir ? j.cfg.outputDir : null }; },\n    async studio_train_status(p) {\n      const j = jobs.get(p && p.jobId) || activeTrain; if (!j || j.kind === undefined || !j.run) return { ok: true, running: false, state: 'idle' };\n      const r = j.run; return { ok: true, jobId: j.id, running: r.state === 'running' || r.state === 'pausing', state: r.state, step: r.lastStep, loss: r.lastLoss, errors: r.errors.slice(-5), events: j.events.slice(-(Number(p && p.tail) || 50)), exitCode: r.exitCode, elapsedMs: (j.endedAt || now()) - j.startedAt };\n    },\n    async studio_train_pause(p) { const j = jobs.get(p && p.jobId) || activeTrain; if (!j || !j.run || j.run.state !== 'running') return { ok: false, error: '沒有執行中的訓練可暫停' }; const r = await j.run.pause(p && p.timeoutMs); return Object.assign({ ok: r.ok }, r); },\n    async studio_train_stop(p) { const j = jobs.get(p && p.jobId) || activeTrain; if (!j || !j.run || !(j.run.state === 'running' || j.run.state === 'pausing')) return { ok: true, already: true }; await j.run.stop(); return { ok: true }; },\n    async studio_ext_check(p) { return extCheck(p || {}); },\n    async studio_ext_start(p) { return extStart(p || {}); },\n    async studio_ext_status(p) { return extStatus(p || {}); },\n    async studio_ext_stop(p) { return extStop(p || {}); },\n    async studio_dispose() { try { if (activeExt && activeExt.job.state === 'running') activeExt.job.stop(); } catch (e) {} try { if (activeBench) { activeBench.ac.aborted = true; activeBench.ac.listeners.forEach((f) => f()); } if (activeTrain && activeTrain.run && activeTrain.run.state === 'running') await activeTrain.run.stop(); } catch (e) {} return { ok: true }; },\n  };\n  return { ops, registry, handle: async (op, payload) => { const f = ops[op]; if (!f) return { ok: false, code: 'bad_op', message: '未知的 Studio 操作：' + op }; try { return await f(payload || {}); } catch (e) { return { ok: false, code: 'internal', message: String((e && e.message) || e) }; } } };\n}\n\n// tasklist /FO CSV 的記憶體欄（例如 \"1,234,567 K\"）→ 位元組；查不到回 null。純函式，測試用\nfunction parseTasklistMemory(text) {\n  const m = /\"([\\d,]+)\\s*K\"\\s*$/m.exec(String(text || '')); if (!m) return null;\n  const kb = Number(m[1].replace(/,/g, '')); return Number.isFinite(kb) ? kb * 1024 : null;\n}\nmodule.exports = { createStudioHost, parseTasklistMemory };\n","lora-train/train_lora.py":'#!/usr/bin/env python\n"""LoRA SFT fine-tuning of Qwen3-0.6B on the unified dataset produced by gen/merge_dataset.js.\n\nCPU-only by design (see requirements.txt): this machine has no CUDA GPU, and the Intel\nAI Boost NPU here is inference-only, so this script never touches accelerators other\nthan the CPU. Run it from the project\'s isolated venv:\n\n    lora-train/.venv/Scripts/python lora-train/train_lora.py --train_file lora-train/data/train.jsonl ...\n\nEach training example comes from lora-train/schema.md\'s unified format:\n    {"messages": [...], "completion": "...", "domain": "...", "stage": "...", "meta": {...}}\n"messages" is the exact production prompt (already produced by the real recipe_core.js /\nthink_stack.js / uml_core.js / ... formatters -- see gen/*.js). "completion" is the single\nprogram-verified correct assistant reply. We apply the tokenizer\'s own chat template so the\ntrained model sees exactly the token sequence production will feed it at inference time,\nthen mask the loss to the completion tokens only (standard SFT: don\'t waste gradient on\nlearning to reproduce the prompt).\n\nOnly "meta.thinking": true examples get enable_thinking=True in the chat template; everything\nelse defaults to False, matching the native runner\'s hardcoded enable_thinking:false path\n(DESIGN.offline-text.md / DESIGN.TODO.native-runner.md).\n"""\nimport argparse\nimport hashlib\nimport json\nimport os\nimport random\nimport sys\nfrom dataclasses import dataclass\n\nimport torch\nfrom torch.utils.data import Dataset\nfrom transformers import (\n    AutoModelForCausalLM,\n    AutoTokenizer,\n    Trainer,\n    TrainerCallback,\n    TrainingArguments,\n)\nfrom peft import LoraConfig, get_peft_model, TaskType\nfrom lora_common import normalize, encode\n\n\nclass StopFileCallback(TrainerCallback):\n    """Pause support: after any optimizer step, if stop_file exists, force a checkpoint save and end training."""\n\n    def __init__(self, path):\n        self.path = path\n\n    def on_step_end(self, args, state, control, **kwargs):\n        if self.path and os.path.exists(self.path):\n            control.should_save = True\n            control.should_training_stop = True\n            print(f"[paused] step={state.global_step}", flush=True)\n        return control\n\n\ndef read_jsonl(path):\n    rows = []\n    with open(path, "r", encoding="utf-8") as f:\n        for line_no, line in enumerate(f, 1):\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                rows.append(json.loads(line))\n            except json.JSONDecodeError as e:\n                raise ValueError(f"{path}:{line_no}: bad JSON ({e})") from e\n    return rows\n\n\nclass ChatSFTDataset(Dataset):\n    """Builds (input_ids, labels) with the prompt masked out (-100) and only the\n    completion contributing to the loss. One example at a time; the data collator\n    pads/batches."""\n\n    def __init__(self, rows, tokenizer, max_seq_len):\n        self.tokenizer = tokenizer\n        self.max_seq_len = max_seq_len\n        self.examples = []\n        for row in rows:\n            x = normalize(row)\n            if not x.get("messages") or x["chosen"] is None:\n                continue\n            # same encode as eval and DPO (lora_common.encode): chat template (+tools) + prefill,\n            # loss only on chosen + <|im_end|>, left-truncated to max_seq_len\n            ids, labels = encode(tokenizer, x, seq=max_seq_len)\n            self.examples.append({"input_ids": ids, "labels": labels, "attention_mask": [1] * len(ids)})\n\n    def __len__(self):\n        return len(self.examples)\n\n    def __getitem__(self, idx):\n        return self.examples[idx]\n\n\n@dataclass\nclass PadCollator:\n    pad_token_id: int\n\n    def __call__(self, batch):\n        max_len = max(len(b["input_ids"]) for b in batch)\n        if os.environ.get("LORA_TRACE_FILE"):   # 測試用：記錄每個 micro-batch 的內容雜湊，驗證續訓不重複／不漏資料\n            h = hashlib.sha256(json.dumps([b["input_ids"] for b in batch]).encode()).hexdigest()[:16]\n            with open(os.environ["LORA_TRACE_FILE"], "a", encoding="utf-8") as f:\n                f.write(h + "\\n")\n        input_ids, labels, attn = [], [], []\n        for b in batch:\n            pad_len = max_len - len(b["input_ids"])\n            input_ids.append(b["input_ids"] + [self.pad_token_id] * pad_len)\n            labels.append(b["labels"] + [-100] * pad_len)\n            attn.append(b["attention_mask"] + [0] * pad_len)\n        return {\n            "input_ids": torch.tensor(input_ids, dtype=torch.long),\n            "labels": torch.tensor(labels, dtype=torch.long),\n            "attention_mask": torch.tensor(attn, dtype=torch.long),\n        }\n\n\nclass FaCkptCallback(TrainerCallback):\n    """每次存檢查點時，在 checkpoint-N/fa-ckpt.json 寫一份與 DESIGN.TODO.offline-training-studio.md §3.1 對照的描述。\n    權重與優化器仍是 HF Trainer 原生格式（adapter_model.safetensors、optimizer.pt、scheduler.pt、rng_state.pth）；\n    differences 欄位列出與 §3.1 不同之處，工作室續訓時要先讀它。"""\n\n    def __init__(self, meta):\n        self.meta = meta\n\n    def on_save(self, args, state, control, **kwargs):\n        ck = os.path.join(args.output_dir, f"checkpoint-{state.global_step}")\n        losses = [h["loss"] for h in state.log_history if "loss" in h]\n        doc = {\n            "format": "fa-ckpt", "version": 1, "producer": "lora-train/train_lora.py", "step": state.global_step, "epoch": state.epoch,\n            "cursor": {"order_seed": args.seed, "micro_batches_per_step": args.gradient_accumulation_steps,\n                       "consumed_micro_batches": state.global_step * args.gradient_accumulation_steps,\n                       "method": "seeded RandomSampler + skip_first_batches on resume"},\n            "rng": {"seed": args.seed, "algo": "hf-rng_state.pth (torch/numpy/python)"},\n            "optimizer": {"kind": "adamw", "lr": args.learning_rate, "schedule": {"type": "linear", "warmup": 10, "total": state.max_steps}},\n            "data_sha256": self.meta["data_sha256"],\n            "compat": {"base": self.meta["base"], "rank": self.meta["rank"], "alpha": self.meta["alpha"],\n                       "target_modules": self.meta["target_modules"], "prompt_format_version": self.meta.get("prompt_format_version", ""),\n                       "tool_catalog_sha256": self.meta.get("tool_catalog_sha256", "")},\n            "produced_by": {"backend": "cpu-py", "precision": "float32", "torch": __import__("torch").__version__},\n            "loss_tail": losses[-20:],\n            "differences": ["權重與優化器不是 lora_A/B.f32、opt_m/opt_v，而是 HF 原生檔", "rng 不是 PCG32，是 HF rng_state.pth",\n                            "資料游標以 seed 重現洗牌並跳過已看的 micro-batch，沒有 shard/offset 欄位"],\n        }\n        os.makedirs(ck, exist_ok=True)\n        with open(os.path.join(ck, "fa-ckpt.json"), "w", encoding="utf-8") as f:\n            json.dump(doc, f, ensure_ascii=False, indent=1)\n\n\ndef split_train_val(rows, val_fraction, seed):\n    """Carve a validation slice out of the TRAIN split (never the frozen heldout\n    files -- those are merged separately by gen/merge_dataset.js and must only be\n    used for final eval, per schema.md\'s holdout discipline)."""\n    rng = random.Random(seed)\n    rows = rows[:]\n    rng.shuffle(rows)\n    n_val = 0 if val_fraction <= 0 else (max(1, int(len(rows) * val_fraction)) if len(rows) > 10 else 0)\n    return rows[n_val:], rows[:n_val]\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument("--model_name_or_path", default="Qwen/Qwen3-0.6B")\n    ap.add_argument("--train_file", required=True, help="unified JSONL, split=train only")\n    ap.add_argument("--output_dir", default="lora-train/out/adapter")\n    ap.add_argument("--val_fraction", type=float, default=0.1)\n    ap.add_argument("--max_seq_len", type=int, default=int(os.environ.get("LORA_SEQ", 1024)))\n    ap.add_argument("--num_train_epochs", type=float, default=3.0)\n    ap.add_argument("--per_device_train_batch_size", type=int, default=int(os.environ.get("LORA_BATCH", 2)))\n    ap.add_argument("--gradient_accumulation_steps", type=int, default=8)\n    ap.add_argument("--learning_rate", type=float, default=1e-4)\n    ap.add_argument("--lora_r", type=int, default=16)\n    ap.add_argument("--lora_alpha", type=int, default=32)\n    ap.add_argument("--lora_dropout", type=float, default=0.05)\n    ap.add_argument(\n        "--lora_target_modules",\n        default="q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj",\n    )\n    ap.add_argument("--logging_steps", type=int, default=10)\n    ap.add_argument("--save_steps", type=int, default=200)\n    ap.add_argument("--max_steps", type=int, default=-1, help="set >0 for a quick smoke test")\n    ap.add_argument("--seed", type=int, default=42)\n    ap.add_argument("--domains", default="", help="comma list to filter training to specific domains; empty = all")\n    # Studio（renderer/src/studio/backend_cpu_py.js）用：暫停＝建立 stop_file，存檢查點後停；續訓＝從 checkpoint-N 繼續\n    ap.add_argument("--resume_from_checkpoint", default="", help="path of an HF Trainer checkpoint-N dir to resume from (optimizer, scheduler, rng restored)")\n    ap.add_argument("--stop_file", default="", help="when this file exists after a step: save a checkpoint and stop (pause)")\n    args = ap.parse_args()\n\n    torch.manual_seed(args.seed)\n    torch.set_num_threads(int(os.environ.get("LORA_THREADS", torch.get_num_threads())))\n\n    rows = read_jsonl(args.train_file)\n    bad_split = [r for r in rows if r.get("split") != "train"]\n    if bad_split:\n        raise SystemExit(\n            f"--train_file contains {len(bad_split)} row(s) with split != \'train\' "\n            f"(e.g. id={bad_split[0].get(\'id\')!r}) -- heldout data must never be trained on. "\n            f"Re-run gen/merge_dataset.js or filter the file first."\n        )\n    if args.domains:\n        wanted = set(d.strip() for d in args.domains.split(",") if d.strip())\n        rows = [r for r in rows if r.get("domain") in wanted]\n        print(f"[data] filtered to domains={sorted(wanted)}: {len(rows)} rows")\n\n    if not rows:\n        raise SystemExit("no training rows after filtering -- nothing to train on")\n\n    by_domain = {}\n    for r in rows:\n        by_domain.setdefault(r.get("domain", "?"), 0)\n        by_domain[r.get("domain", "?")] += 1\n    print("[data] rows per domain:", by_domain)\n\n    train_rows, val_rows = split_train_val(rows, args.val_fraction, args.seed)\n    print(f"[data] train={len(train_rows)} val={len(val_rows)}")\n\n    print(f"[model] loading {args.model_name_or_path} (CPU, fp32)")\n    tokenizer = AutoTokenizer.from_pretrained(args.model_name_or_path)\n    if tokenizer.pad_token_id is None:\n        tokenizer.pad_token = tokenizer.eos_token\n    model = AutoModelForCausalLM.from_pretrained(\n        args.model_name_or_path, torch_dtype=torch.float32\n    )\n    model.config.use_cache = False  # required for gradient checkpointing / training\n\n    lora_config = LoraConfig(\n        task_type=TaskType.CAUSAL_LM,\n        r=args.lora_r,\n        lora_alpha=args.lora_alpha,\n        lora_dropout=args.lora_dropout,\n        target_modules=[m.strip() for m in args.lora_target_modules.split(",") if m.strip()],\n        bias="none",\n    )\n    model = get_peft_model(model, lora_config)\n    model.print_trainable_parameters()\n\n    train_ds = ChatSFTDataset(train_rows, tokenizer, args.max_seq_len)\n    val_ds = ChatSFTDataset(val_rows, tokenizer, args.max_seq_len) if val_rows else None\n    collator = PadCollator(pad_token_id=tokenizer.pad_token_id)\n\n    training_args = TrainingArguments(\n        output_dir=args.output_dir,\n        num_train_epochs=args.num_train_epochs,\n        per_device_train_batch_size=args.per_device_train_batch_size,\n        gradient_accumulation_steps=args.gradient_accumulation_steps,\n        learning_rate=args.learning_rate,\n        logging_steps=args.logging_steps,\n        save_steps=args.save_steps,\n        save_total_limit=2,\n        warmup_steps=10,\n        lr_scheduler_type="linear",\n        eval_strategy="steps" if val_ds else "no",\n        eval_steps=args.save_steps if val_ds else None,\n        max_steps=args.max_steps,\n        report_to=[],\n        use_cpu=True,\n        bf16=False,\n        fp16=False,\n        dataloader_num_workers=0,\n        remove_unused_columns=False,\n        seed=args.seed,\n    )\n\n    ckpt_meta = {"data_sha256": hashlib.sha256(open(args.train_file, "rb").read()).hexdigest(), "base": args.model_name_or_path,\n                 "rank": args.lora_r, "alpha": args.lora_alpha, "target_modules": sorted(lora_config.target_modules),\n                 "tool_catalog_sha256": None}\n    trainer = Trainer(\n        model=model,\n        args=training_args,\n        train_dataset=train_ds,\n        eval_dataset=val_ds,\n        data_collator=collator,\n        callbacks=([StopFileCallback(args.stop_file)] if args.stop_file else []) + [FaCkptCallback(ckpt_meta)],\n    )\n    trainer.train(resume_from_checkpoint=args.resume_from_checkpoint or None)\n\n    os.makedirs(args.output_dir, exist_ok=True)\n    model.save_pretrained(args.output_dir)\n    tokenizer.save_pretrained(args.output_dir)\n    print(f"[done] adapter saved to {args.output_dir}")\n\n\nif __name__ == "__main__":\n    main()\n',"lora-train/lora_common.py":'"""Shared row normalisation + encoding used by training, DPO and eval (one encoding everywhere).\n\nReference row format: {task, kind, messages, tools, prefill, chosen, rejected}.\nOur unified rows (schema.md) carry id/domain/stage/split/meta and `completion` instead of `chosen`; this module maps\nthem so both formats train/eval identically:\n    chosen  = row.chosen  or row.completion\n    task    = row.task    or row.domain          kind = row.kind or row.stage\n    tools   = row.tools (may be None)            prefill = row.prefill or \'\'\nEncoding (same as the reference): apply_chat_template(messages, tools=tools, add_generation_prompt=True,\nenable_thinking=False, tokenize=False) + prefill, then loss only on  chosen + \'<|im_end|>\'.\n(meta.thinking=True rows keep enable_thinking=True.)\n"""\nimport json, os\n\n\ndef read_jsonl(path):\n    return [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]\n\n\ndef normalize(row):\n    r = dict(row)\n    r["chosen"] = row.get("chosen") if row.get("chosen") is not None else row.get("completion")\n    r["task"] = row.get("task") or row.get("domain") or "?"\n    r["kind"] = row.get("kind") or row.get("stage") or "?"\n    r["tools"] = row.get("tools") or None\n    r["prefill"] = row.get("prefill") or ""\n    r["rejected"] = row.get("rejected")\n    return r\n\n\ndef prompt_text(tok, x):\n    thinking = bool((x.get("meta") or {}).get("thinking", False))\n    return tok.apply_chat_template(x["messages"], tools=x["tools"], add_generation_prompt=True,\n                                   enable_thinking=thinking, tokenize=False) + x["prefill"]\n\n\ndef encode(tok, x, tail=None, seq=None):\n    """-> (ids, labels). labels are -100 over the prompt(+prefill); loss on tail + <|im_end|> (tail defaults to chosen)."""\n    seq = seq or int(os.environ.get("LORA_SEQ", 1024))\n    a = tok(prompt_text(tok, x), add_special_tokens=False)["input_ids"]\n    b = tok((x["chosen"] if tail is None else tail) + "<|im_end|>", add_special_tokens=False)["input_ids"]\n    return (a + b)[-seq:], ([-100] * len(a) + b)[-seq:]\n',"lora-train/requirements.txt":"# CPU-only LoRA fine-tuning stack for Qwen3-0.6B.\n#\n# IMPORTANT: install this into its own virtualenv (lora-train/.venv), never into the\n# shared/global Python environment. This repo's global env has `docling` pinned to\n# transformers<5.0.0,huggingface_hub<1 for other skills (pdf/docx processing) -- a\n# plain `pip install datasets` there drags transformers to the 5.x line and breaks it.\n#\n# Requires Python 3.11 or newer (transformers 5.x does not install on 3.10).\n#\n#   py -3.13 -m venv lora-train/.venv\n#   lora-train/.venv/Scripts/python.exe -m pip install torch --extra-index-url https://download.pytorch.org/whl/cpu\n#   lora-train/.venv/Scripts/python.exe -m pip install -r lora-train/requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu\n#\n# This machine has no CUDA GPU; the Intel AI Boost NPU here is inference-only\n# (no backprop/training support), so the torch wheel above is explicitly the CPU build.\ntransformers>=5.22.0\npeft>=0.21.0\naccelerate>=1.15.0\ndatasets>=5.2.0\nsafetensors>=0.4.3\nsentencepiece>=0.2.0\n","lora-train/train_full.py":'#!/usr/bin/env python\n"""完整參數微調（全部權重可訓練）的 SFT 腳本，DESIGN.lora-training.md §25（路徑 B）。\n\n與 train_lora.py 用同一份資料與編碼（ChatSFTDataset／PadCollator／StopFileCallback 直接沿用），差別只有：\n  - 不包 PEFT：整個 Qwen3-0.6B 都訓練，優化器是 HF Trainer 預設的 AdamW（記憶體：權重＋梯度＋Adam 兩份狀態，fp32 約 10 GB）。\n  - 存檔是完整 HF 資料夾（safetensors＋config＋tokenizer），可直接餵 merge 之後的匯出流程：\n    export_onnx.py --model <本腳本的輸出> 與 export_gguf.py --model <本腳本的輸出>（不需要 merge）。\n  - 暫停／續訓與 train_lora.py 相同：--stop_file 存在就存檢查點並停；--resume_from_checkpoint 接續 checkpoint-N。\n  - 存檔時也把 config.json 換回基底的（transformers 5.x 存的 rope 欄位格式 4.x 讀不到，見 merge_and_export.py）。\n\nCPU only（這台沒有 GPU）。用 lora-train/.venv（transformers 5.x）執行：\n    lora-train/.venv/bin/python lora-train/train_full.py --train_file <train.jsonl> --output_dir <新空目錄> \\\n        --max_steps 4 --per_device_train_batch_size 1 --gradient_accumulation_steps 1 --max_seq_len 512\n\n注意：\n  - 完整微調的輸出 **不是** 1 MB 級的 adapter，而是約 2.4 GB 的權重；每個 checkpoint 另加約 4.8 GB 的優化器狀態。\n    `save_total_limit=2`，磁碟要先確認。\n  - 沒有足夠資料與時間的完整訓練不在本次範圍；本腳本只保證「能跑、能暫停續訓、輸出能匯出」。\n"""\nimport argparse\nimport hashlib\nimport json\nimport os\nimport resource\nimport shutil\nimport sys\nimport time\n\nimport torch\nfrom transformers import AutoModelForCausalLM, AutoTokenizer, Trainer, TrainerCallback, TrainingArguments\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom train_lora import ChatSFTDataset, PadCollator, StopFileCallback, read_jsonl, split_train_val  # noqa: E402\n\n\nclass FullCkptCallback(TrainerCallback):\n    """每次存檔寫 checkpoint-N/fa-ckpt.json（描述與 train_lora.py 的 fa-ckpt 相同格式，但 producer／權重格式不同）。"""\n\n    def __init__(self, meta):\n        self.meta = meta\n\n    def on_save(self, args, state, control, **kwargs):\n        ck = os.path.join(args.output_dir, f"checkpoint-{state.global_step}")\n        os.makedirs(ck, exist_ok=True)\n        doc = {\n            "format": "fa-ckpt", "version": 1, "producer": "lora-train/train_full.py",\n            "step": state.global_step, "epoch": state.epoch,\n            "cursor": {"order_seed": args.seed, "micro_batches_per_step": args.gradient_accumulation_steps,\n                       "consumed_micro_batches": state.global_step * args.gradient_accumulation_steps,\n                       "method": "seeded RandomSampler + skip_first_batches on resume"},\n            "optimizer": {"kind": "adamw", "lr": args.learning_rate, "schedule": {"type": "linear", "warmup": 10, "total": state.max_steps}},\n            "data_sha256": self.meta["data_sha256"], "compat": {"base": self.meta["base"], "full_finetune": True},\n            "produced_by": {"backend": "cpu-py", "precision": "float32", "torch": torch.__version__},\n            "differences": ["權重是完整 HF safetensors（不是 LoRA），優化器狀態 HF 原生檔（optimizer.pt）"],\n        }\n        with open(os.path.join(ck, "fa-ckpt.json"), "w", encoding="utf-8") as f:\n            json.dump(doc, f, ensure_ascii=False, indent=1)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument("--model_name_or_path", default="lora-train/models/Qwen3-0.6B")\n    ap.add_argument("--train_file", required=True, help="unified JSONL（split=train）")\n    ap.add_argument("--output_dir", required=True)\n    ap.add_argument("--val_fraction", type=float, default=0.0)\n    ap.add_argument("--max_seq_len", type=int, default=512)\n    ap.add_argument("--num_train_epochs", type=float, default=1.0)\n    ap.add_argument("--per_device_train_batch_size", type=int, default=1)\n    ap.add_argument("--gradient_accumulation_steps", type=int, default=1)\n    ap.add_argument("--learning_rate", type=float, default=1e-5)\n    ap.add_argument("--logging_steps", type=int, default=1)\n    ap.add_argument("--save_steps", type=int, default=200)\n    ap.add_argument("--max_steps", type=int, default=-1)\n    ap.add_argument("--seed", type=int, default=42)\n    ap.add_argument("--resume_from_checkpoint", default="")\n    ap.add_argument("--stop_file", default="")\n    args = ap.parse_args()\n\n    torch.manual_seed(args.seed)\n    torch.set_num_threads(int(os.environ.get("LORA_THREADS", torch.get_num_threads())))\n    t0 = time.time()\n\n    rows = read_jsonl(args.train_file)\n    bad = [r for r in rows if r.get("split") != "train"]\n    if bad:\n        raise SystemExit(f"--train_file 有 {len(bad)} 列 split != \'train\'（heldout 不得拿來訓練）")\n    if not rows:\n        raise SystemExit("沒有訓練資料")\n    train_rows, val_rows = split_train_val(rows, args.val_fraction, args.seed)\n\n    tokenizer = AutoTokenizer.from_pretrained(args.model_name_or_path)\n    if tokenizer.pad_token_id is None:\n        tokenizer.pad_token = tokenizer.eos_token\n    model = AutoModelForCausalLM.from_pretrained(args.model_name_or_path, dtype=torch.float32)\n    model.config.use_cache = False\n    n_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    print(f"[model] {args.model_name_or_path} fp32，可訓練參數 {n_params}", flush=True)\n\n    train_ds = ChatSFTDataset(train_rows, tokenizer, args.max_seq_len)\n    print(f"[data] train examples={len(train_ds)}", flush=True)\n    if len(train_ds) == 0:\n        raise SystemExit("編碼後沒有任何樣本")\n\n    targs = TrainingArguments(\n        output_dir=args.output_dir, num_train_epochs=args.num_train_epochs,\n        per_device_train_batch_size=args.per_device_train_batch_size,\n        gradient_accumulation_steps=args.gradient_accumulation_steps, learning_rate=args.learning_rate,\n        logging_steps=args.logging_steps, save_steps=args.save_steps, save_total_limit=2, warmup_steps=10,\n        lr_scheduler_type="linear", max_steps=args.max_steps, report_to=[], use_cpu=True, bf16=False, fp16=False,\n        dataloader_num_workers=0, remove_unused_columns=False, seed=args.seed,\n    )\n    meta = {"data_sha256": hashlib.sha256(open(args.train_file, "rb").read()).hexdigest(), "base": args.model_name_or_path}\n    trainer = Trainer(model=model, args=targs, train_dataset=train_ds, data_collator=PadCollator(tokenizer.pad_token_id),\n                      callbacks=([StopFileCallback(args.stop_file)] if args.stop_file else []) + [FullCkptCallback(meta)])\n    t_train = time.time()\n    trainer.train(resume_from_checkpoint=args.resume_from_checkpoint or None)\n    train_secs = time.time() - t_train\n\n    os.makedirs(args.output_dir, exist_ok=True)\n    trainer.model.save_pretrained(args.output_dir, safe_serialization=True)\n    tokenizer.save_pretrained(args.output_dir)\n    base_cfg = os.path.join(args.model_name_or_path, "config.json")\n    if os.path.exists(base_cfg):\n        shutil.copyfile(base_cfg, os.path.join(args.output_dir, "config.json"))\n    peak_mb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0\n    summary = {"global_step": trainer.state.global_step, "train_seconds": round(train_secs, 1),\n               "total_seconds": round(time.time() - t0, 1), "peak_rss_mb": round(peak_mb, 1),\n               "losses": [h["loss"] for h in trainer.state.log_history if "loss" in h]}\n    with open(os.path.join(args.output_dir, "train_full_summary.json"), "w", encoding="utf-8") as f:\n        json.dump(summary, f, ensure_ascii=False, indent=1)\n    print(f"[done] full model saved to {args.output_dir} steps={summary[\'global_step\']} "\n          f"train_seconds={summary[\'train_seconds\']} peak_rss_mb={summary[\'peak_rss_mb\']}", flush=True)\n\n\nif __name__ == "__main__":\n    main()\n',"lora-train/merge_and_export.py":'#!/usr/bin/env python3\n"""把 LoRA adapter（PEFT 格式）併回基底權重，存成一般 HF 資料夾（safetensors），供後續匯出用。\nDESIGN.lora-training.md §25。\n\n    python3 merge_and_export.py --base_dir models/Qwen3-0.6B \\\n        --adapter_dir <含 adapter_config.json 與 adapter_model.safetensors 的資料夾> \\\n        --output_dir <新的空目錄>\n\n注意：\n- tokenizer 一律取自基底資料夾（adapter 資料夾通常沒有 tokenizer 檔）。\n- 輸出的 config.json 與 tokenizer 與基底相同；權重為 fp32。\n- 合併前後各算一次首步 logits，最大絕對差寫進 merge_info.json。\n- 只做合併與存檔，不匯出 ONNX／GGUF。\n- config.json 會換成基底的（見程式內註解：5.x 的 rope 欄位格式 4.x 讀不到）。\n"""\nimport argparse\nimport json\nimport os\nimport shutil\nimport sys\n\nimport torch\nfrom peft import PeftModel\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument("--base_dir", required=True, help="基底 HF 資料夾（例如 models/Qwen3-0.6B）")\n    ap.add_argument("--adapter_dir", required=True)\n    ap.add_argument("--output_dir", required=True)\n    ap.add_argument("--probe", default="台北在哪個國家？", help="合併前後各算一次首步 logits 做一致性檢查")\n    a = ap.parse_args()\n\n    if os.path.exists(a.output_dir) and os.listdir(a.output_dir):\n        sys.exit(f"[error] output_dir 不是空目錄：{a.output_dir}")\n    os.makedirs(a.output_dir, exist_ok=True)\n\n    print(f"[load] base {a.base_dir}", flush=True)\n    tok = AutoTokenizer.from_pretrained(a.base_dir)\n    base = AutoModelForCausalLM.from_pretrained(a.base_dir, dtype=torch.float32).eval()\n\n    print(f"[load] adapter {a.adapter_dir}", flush=True)\n    peft_model = PeftModel.from_pretrained(base, a.adapter_dir).eval()\n    ids = tok(a.probe, return_tensors="pt")["input_ids"]\n    with torch.no_grad():\n        ref = peft_model(ids).logits[0, -1].clone()\n\n    print("[merge] merge_and_unload", flush=True)\n    merged = peft_model.merge_and_unload().eval()\n    with torch.no_grad():\n        got = merged(ids).logits[0, -1]\n    diff = float((ref - got).abs().max())\n    print(f"[check] PEFT vs merged 首步 logits 最大絕對差 = {diff:.3e}", flush=True)\n\n    print(f"[save] {a.output_dir}", flush=True)\n    merged.save_pretrained(a.output_dir, safe_serialization=True)\n    tok.save_pretrained(a.output_dir)\n    # transformers 5.x 存的 config 把 rope_theta 改放進 rope_parameters，4.x 讀不到會退回預設 10000，\n    # 實測 4.57 讀 5.x 存的合併權重首步 logprob 偏掉 ~0.2（llama.cpp 與 5.x 一致）。所以改回基底的 config.json\n    # （架構相同，只差 dtype 欄位，載入時會轉 fp32）。\n    shutil.copyfile(os.path.join(a.base_dir, "config.json"), os.path.join(a.output_dir, "config.json"))\n    info = {"base_dir": a.base_dir, "adapter_dir": a.adapter_dir,\n            "merge_max_abs_logit_diff": diff, "dtype": "float32", "config_source": "base（覆寫 5.x 存的 config）",\n            "adapter_config": json.load(open(os.path.join(a.adapter_dir, "adapter_config.json")))}\n    with open(os.path.join(a.output_dir, "merge_info.json"), "w", encoding="utf-8") as f:\n        json.dump(info, f, ensure_ascii=False, indent=1)\n    print("[done]", flush=True)\n    print(json.dumps({"step": "merge", "ok": True, "output_dir": a.output_dir, "merge_max_abs_logit_diff": diff},\n                     ensure_ascii=False), flush=True)\n\n\nif __name__ == "__main__":\n    try:\n        main()\n    except SystemExit as e:  # 空目錄檢查等明確錯誤：照樣回報 JSON，讓執行器拿得到原因\n        if e.code not in (0, None):\n            print(json.dumps({"step": "merge", "ok": False, "error": str(e.code)[:500]}, ensure_ascii=False), flush=True)\n        raise\n    except Exception as e:\n        print(json.dumps({"step": "merge", "ok": False, "error": f"{type(e).__name__}: {str(e)[:500]}"}, ensure_ascii=False), flush=True)\n        sys.exit(1)\n',"lora-train/export_onnx.py":'#!/usr/bin/env python3\n"""合併後的 HF 資料夾 → ONNX（fp32）→ 動態 q8 → 核對 → 寫資產 manifest。DESIGN.lora-training.md §25。\n\n分四步，每步可單獨跑（工作室的執行器一步一步呼叫）；全部在 <out> 資料夾內：\n  convert   optimum-cli export onnx（fp32，text-generation-with-past，圖的輸入輸出與 app 的 q8 圖相同）→ <out>/fp32/\n  quantize  onnxruntime quantize_dynamic（per_channel、QUInt8 權重）→ <out>/q8/model_quantized.onnx\n            recipe=full：所有 MatMul 都量化（與官方 q8 同結構，可接 lora-slot-build.js 的 LoRA 槽）\n            recipe=mixed：down_proj 保留 fp32（其他照舊）；品質明顯較好，但不能再套 LoRA 槽（槽轉換器要求 196 個 MatMulInteger）\n  verify    與 HF（PyTorch fp32）比對：每個提示首步 logits 的餘弦與 top-1、貪婪 N 個 token（用 KV cache 跑 ONNX）→ <out>/check.json\n  pack      寫 <out>/manifest.json：每個產物的檔名、大小、sha256、來源與 recipe\n\n用法（一定要用 .venv-export：transformers 4.57.x；訓練用的 .venv 是 5.x，tokenizer 會壞）：\n    .venv-export/bin/python export_onnx.py --step convert   --model <merged_dir> --out <out> --tokenizer <base_dir>\n    .venv-export/bin/python export_onnx.py --step quantize  --out <out> --recipe mixed\n    .venv-export/bin/python export_onnx.py --step verify    --model <merged_dir> --out <out> --tokenizer <base_dir>\n    .venv-export/bin/python export_onnx.py --step pack      --out <out>\n每一步成功會在 stdout 印一行 JSON（{"step":…,"ok":true,…}），失敗印 {"step":…,"ok":false,"error":…} 並以非零碼結束。\n"""\nimport argparse\nimport hashlib\nimport json\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport time\n\nPROMPTS = [\n    "台北在哪個國家？",\n    "def add(a, b):",\n    "Choose the best tool: A. search B. calc\\nAnswer:",\n    "請把這個任務拆成三個子步驟：整理資料、計算平均、輸出報表。",\n    \'{"name": "get_weather", "arguments": {"city": "Taipei"}}\',\n    "The quick brown fox jumps over",\n]\nGREEDY_N = 16\n\n\ndef emit(step, ok, **kw):\n    print(json.dumps(dict(step=step, ok=ok, **kw), ensure_ascii=False), flush=True)\n\n\ndef sha256(path):\n    h = hashlib.sha256()\n    with open(path, "rb") as f:\n        for chunk in iter(lambda: f.read(1 << 20), b""):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef size_of(path):\n    """ONNX 外部資料檔一起算"""\n    total = os.path.getsize(path)\n    if os.path.exists(path + "_data"):\n        total += os.path.getsize(path + "_data")\n    return total\n\n\ndef find_optimum_cli():\n    cand = os.path.join(os.path.dirname(sys.executable), "optimum-cli")\n    if os.path.exists(cand):\n        return cand\n    found = shutil.which("optimum-cli")\n    if not found:\n        raise RuntimeError("找不到 optimum-cli（請用 .venv-export 的 python 執行）")\n    return found\n\n\ndef step_convert(a):\n    fp = os.path.join(a.out, "fp32")\n    if os.path.exists(os.path.join(fp, "model.onnx")):\n        return {"skipped": "已存在 " + fp}\n    os.makedirs(a.out, exist_ok=True)\n    cmd = [find_optimum_cli(), "export", "onnx", "--model", a.model, "--task", "text-generation-with-past",\n           "--dtype", "fp32", "--no-post-process", fp]\n    t0 = time.time()\n    subprocess.check_call(cmd)\n    return {"model": os.path.join(fp, "model.onnx"), "bytes": size_of(os.path.join(fp, "model.onnx")),\n            "seconds": round(time.time() - t0, 1)}\n\n\ndef step_quantize(a):\n    from onnxruntime.quantization import QuantType, quantize_dynamic\n    import onnx\n    src = os.path.join(a.out, "fp32", "model.onnx")\n    if not os.path.exists(src):\n        raise RuntimeError("沒有 fp32 圖：先跑 --step convert")\n    excl = []\n    if a.recipe == "mixed":\n        m = onnx.load(src, load_external_data=False)\n        excl = [n.name for n in m.graph.node if n.op_type == "MatMul" and "down_proj" in n.name]\n        if not excl:\n            raise RuntimeError("mixed 找不到 down_proj 節點，圖結構不符")\n    elif a.recipe != "full":\n        raise RuntimeError("recipe 必須是 full 或 mixed")\n    os.makedirs(os.path.join(a.out, "q8"), exist_ok=True)\n    dst = os.path.join(a.out, "q8", "model_quantized.onnx")\n    t0 = time.time()\n    quantize_dynamic(src, dst, weight_type=QuantType.QUInt8, per_channel=True, nodes_to_exclude=excl,\n                     use_external_data_format=False)\n    return {"model": dst, "recipe": a.recipe, "fp32_kept_nodes": len(excl), "bytes": size_of(dst),\n            "seconds": round(time.time() - t0, 1)}\n\n\ndef cosine(x, y):\n    import numpy as np\n    return float(x @ y / (np.linalg.norm(x) * np.linalg.norm(y)))\n\n\ndef onnx_greedy(sess, ids_list, n_new, cfg_layers, kv_heads, head_dim):\n    """KV cache 貪婪解碼；回傳 (首步 logits, 生成的 token)"""\n    import numpy as np\n    past = {f"past_key_values.{l}.{k}": np.zeros((1, kv_heads, 0, head_dim), dtype=np.float32)\n            for l in range(cfg_layers) for k in ("key", "value")}\n    ids = list(ids_list)\n    first = None\n    out = []\n    plen = 0\n    feed_ids = ids\n    for _ in range(n_new):\n        L = plen + len(feed_ids)\n        feed = dict(past)\n        feed["input_ids"] = np.array([feed_ids], dtype=np.int64)\n        feed["attention_mask"] = np.ones((1, L), dtype=np.int64)\n        feed["position_ids"] = np.arange(plen, L, dtype=np.int64)[None]\n        names = [o.name for o in sess.get_outputs()]\n        res = dict(zip(names, sess.run(None, feed)))\n        lg = res["logits"][0, -1]\n        if first is None:\n            first = lg.copy()\n        nxt = int(lg.argmax())\n        out.append(nxt)\n        past = {f"past_key_values.{l}.{k}": res[f"present.{l}.{k}"] for l in range(cfg_layers) for k in ("key", "value")}\n        plen = L\n        feed_ids = [nxt]\n    return first, out\n\n\ndef hf_greedy(hf, ids_list, n_new):\n    import torch\n    import numpy as np\n    ids = list(ids_list)\n    first = None\n    out = []\n    with torch.no_grad():\n        for _ in range(n_new):\n            lg = hf(torch.tensor([ids])).logits[0, -1].numpy()\n            if first is None:\n                first = lg.copy()\n            nxt = int(lg.argmax())\n            out.append(nxt)\n            ids.append(nxt)\n    return first, out\n\n\ndef step_verify(a):\n    import numpy as np\n    import onnxruntime as ort\n    import torch\n    from transformers import AutoModelForCausalLM, AutoTokenizer\n    tok = AutoTokenizer.from_pretrained(a.tokenizer)\n    hf = AutoModelForCausalLM.from_pretrained(a.model, dtype=torch.float32).eval()\n    cfg = hf.config\n    layers, kv_heads = cfg.num_hidden_layers, cfg.num_key_value_heads\n    head_dim = getattr(cfg, "head_dim", cfg.hidden_size // cfg.num_attention_heads)\n    models = {"fp32": os.path.join(a.out, "fp32", "model.onnx")}\n    q8 = os.path.join(a.out, "q8", "model_quantized.onnx")\n    if os.path.exists(q8):\n        models["q8"] = q8\n    sessions = {k: ort.InferenceSession(p, providers=["CPUExecutionProvider"]) for k, p in models.items()}\n    rows = []\n    summary = {}\n    refs = {}\n    for p in PROMPTS:\n        ids = tok(p)["input_ids"]\n        refs[p] = hf_greedy(hf, ids, GREEDY_N)\n    for name, sess in sessions.items():\n        cos, top1, gmatch, gfull = [], 0, 0, 0\n        for p in PROMPTS:\n            ids = tok(p)["input_ids"]\n            ref_first, ref_tokens = refs[p]\n            first, toks = onnx_greedy(sess, ids, GREEDY_N, layers, kv_heads, head_dim)\n            c = cosine(first.astype(np.float64), ref_first.astype(np.float64))\n            cos.append(c)\n            top1 += int(first.argmax()) == int(ref_first.argmax())\n            k = 0\n            while k < len(toks) and toks[k] == ref_tokens[k]:\n                k += 1\n            gmatch += k\n            gfull += int(toks == ref_tokens)\n            rows.append({"variant": name, "prompt": p, "cos": round(c, 6), "top1": int(first.argmax()) == int(ref_first.argmax()),\n                         "greedy_prefix_match": k, "greedy_total": GREEDY_N, "onnx_tokens": toks, "hf_tokens": ref_tokens})\n        summary[name] = {"cos_min": round(min(cos), 6), "cos_mean": round(sum(cos) / len(cos), 6),\n                         "top1": f"{top1}/{len(PROMPTS)}", "greedy_prefix_match": f"{gmatch}/{GREEDY_N * len(PROMPTS)}",\n                         "greedy_full_match": f"{gfull}/{len(PROMPTS)}", "bytes": size_of(models[name])}\n    check = {"reference": "HF（PyTorch fp32，合併後模型）", "prompts": PROMPTS, "greedy_n": GREEDY_N,\n             "summary": summary, "rows": rows}\n    with open(os.path.join(a.out, "check.json"), "w", encoding="utf-8") as f:\n        json.dump(check, f, ensure_ascii=False, indent=1)\n    return {"summary": summary, "check": os.path.join(a.out, "check.json")}\n\n\nTOKENIZER_FILES = ["tokenizer.json", "tokenizer_config.json", "vocab.json", "merges.txt"]\n\n\ndef step_pack(a):\n    # 桌面版 nr-engine 要 modelPath＋tokenizerPath：把基底 tokenizer 檔放進匯出資料夾（與 app 的 q8 資料夾結構一致）\n    if a.tokenizer and os.path.isdir(a.tokenizer):\n        for f in TOKENIZER_FILES:\n            src = os.path.join(a.tokenizer, f)\n            if os.path.exists(src):\n                shutil.copyfile(src, os.path.join(a.out, f))\n    files = []\n    for rel in [os.path.join("fp32", "model.onnx"), os.path.join("fp32", "model.onnx_data"),\n                os.path.join("q8", "model_quantized.onnx"), "check.json"] + TOKENIZER_FILES:\n        p = os.path.join(a.out, rel)\n        if os.path.exists(p):\n            files.append({"path": rel.replace(os.sep, "/"), "bytes": os.path.getsize(p), "sha256": sha256(p)})\n    cfg_src = os.path.join(a.out, "fp32", "config.json")\n    if os.path.exists(cfg_src):\n        files.append({"path": "fp32/config.json", "bytes": os.path.getsize(cfg_src), "sha256": sha256(cfg_src)})\n    man = {"kind": "llm", "format": "onnx", "source": a.model or None, "recipe": a.recipe, "files": files,\n           "note": "fp32/ 是未量化圖；q8/model_quantized.onnx 是 quantize_dynamic 的結果（recipe=mixed 時 down_proj 保留 fp32，不能再套 lora-slot-build 的 LoRA 槽）",\n           "io": "input_ids/attention_mask/position_ids/past_key_values.*（與 app 的 q8 圖相同）"}\n    with open(os.path.join(a.out, "manifest.json"), "w", encoding="utf-8") as f:\n        json.dump(man, f, ensure_ascii=False, indent=1)\n    return {"manifest": os.path.join(a.out, "manifest.json"), "files": len(files)}\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument("--step", required=True, choices=["convert", "quantize", "verify", "pack"])\n    ap.add_argument("--model", help="合併後的 HF 資料夾（convert／verify）")\n    ap.add_argument("--tokenizer", help="tokenizer 資料夾（預設同 --model；合併後資料夾的 tokenizer 若由 transformers 5 存的，4.x 讀不了，請指向基底）")\n    ap.add_argument("--out", required=True)\n    ap.add_argument("--recipe", default="full", choices=["full", "mixed"])\n    a = ap.parse_args()\n    a.tokenizer = a.tokenizer or a.model\n    fn = {"convert": step_convert, "quantize": step_quantize, "verify": step_verify, "pack": step_pack}[a.step]\n    try:\n        res = fn(a)\n        emit(a.step, True, **res)\n    except Exception as e:  # 讓執行器拿到明確錯誤\n        emit(a.step, False, error=f"{type(e).__name__}: {str(e)[:500]}")\n        sys.exit(1)\n\n\nif __name__ == "__main__":\n    main()\n',"lora-train/export_gguf.py":'#!/usr/bin/env python3\n"""合併後的 HF 資料夾 → GGUF（f16）→ Q8_0 → 用 llama.cpp 的 llama-server 實際推論核對 → 寫資產 manifest。\nDESIGN.lora-training.md §25。工具來自 llama.cpp（實測版本 b12286）：convert_hf_to_gguf.py、llama-quantize、llama-server。\n\n分四步（與 export_onnx.py 同樣格式：每步在 stdout 印一行 JSON）：\n  convert   convert_hf_to_gguf.py --outtype f16 → <out>/model-f16.gguf\n            轉換器會讀 tokenizer；transformers 5 存的 tokenizer_config.json 在 4.x 讀不了，所以本步會先在\n            <out>/hf-input/ 建一個「合併後權重＋基底 tokenizer」的符號連結資料夾，只給轉換器用。\n  quantize  llama-quantize <f16> Q8_0 → <out>/model-q8_0.gguf\n  verify    起 llama-server（-c 512、--port 隨機空閒埠），對每個提示用 /completion（temperature 0、top_k 1、\n            return_tokens）取貪婪 N 個 token，與 HF（PyTorch fp32，合併後模型）的貪婪 token 逐一比對 → <out>/check_gguf.json\n  pack      寫 <out>/manifest_gguf.json（檔名、大小、sha256、來源、recipe）\n\n用法（用 .venv-export 的 python；llama.cpp 的工具路徑用 --llama_dir 指向含 llama-quantize／llama-server 的 bin 資料夾，\nconvert_hf_to_gguf.py 用 --llama_src 指向 llama.cpp 原始碼根目錄）：\n    .venv-export/bin/python export_gguf.py --step convert  --model <merged> --tokenizer <base> --out <out> \\\n        --llama_src <llama.cpp 根> --llama_dir <llama.cpp>/build/bin\n    .venv-export/bin/python export_gguf.py --step quantize --out <out> --llama_dir <llama.cpp>/build/bin\n    .venv-export/bin/python export_gguf.py --step verify   --model <merged> --tokenizer <base> --out <out> --llama_dir <llama.cpp>/build/bin\n    .venv-export/bin/python export_gguf.py --step pack     --out <out>\n\n注意：verify 只比對貪婪 token（llama-server 不回傳完整 logits），所以不宣稱首步 logits 餘弦；這一點寫在 check_gguf.json。\n"""\nimport argparse\nimport hashlib\nimport json\nimport os\nimport shutil\nimport socket\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\nGREEDY_N = 16\nPROMPTS = [\n    "台北在哪個國家？",\n    "def add(a, b):",\n    "Choose the best tool: A. search B. calc\\nAnswer:",\n    "請把這個任務拆成三個子步驟：整理資料、計算平均、輸出報表。",\n    \'{"name": "get_weather", "arguments": {"city": "Taipei"}}\',\n    "The quick brown fox jumps over",\n]\nBASE_TOK_FILES = ["tokenizer.json", "tokenizer_config.json", "vocab.json", "merges.txt", "generation_config.json"]\n\n\ndef emit(step, ok, **kw):\n    print(json.dumps(dict(step=step, ok=ok, **kw), ensure_ascii=False), flush=True)\n\n\ndef sha256(path):\n    h = hashlib.sha256()\n    with open(path, "rb") as f:\n        for chunk in iter(lambda: f.read(1 << 20), b""):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef tool(a, name):\n    if a.llama_dir:\n        p = os.path.join(a.llama_dir, name)\n        if os.path.exists(p):\n            return p\n        raise RuntimeError(f"找不到 {p}")\n    found = shutil.which(name)\n    if not found:\n        raise RuntimeError(f"找不到 {name}（請用 --llama_dir 指定）")\n    return found\n\n\ndef step_convert(a):\n    if not a.llama_src:\n        raise RuntimeError("convert 需要 --llama_src（llama.cpp 原始碼根目錄，內含 convert_hf_to_gguf.py）")\n    inp = os.path.join(a.out, "hf-input")\n    os.makedirs(inp, exist_ok=True)\n    for f in ["model.safetensors", "config.json"]:\n        dst = os.path.join(inp, f)\n        if not os.path.exists(dst):\n            os.symlink(os.path.abspath(os.path.join(a.model, f)), dst)\n    for f in BASE_TOK_FILES:\n        src = os.path.join(a.tokenizer, f)\n        dst = os.path.join(inp, f)\n        if os.path.exists(src) and not os.path.exists(dst):\n            os.symlink(os.path.abspath(src), dst)\n    outp = os.path.join(a.out, "model-f16.gguf")\n    env = dict(os.environ)\n    env["PYTHONPATH"] = os.pathsep.join([a.llama_src, os.path.join(a.llama_src, "gguf-py")])\n    t0 = time.time()\n    subprocess.check_call([sys.executable, os.path.join(a.llama_src, "convert_hf_to_gguf.py"), inp,\n                           "--outtype", "f16", "--outfile", outp], env=env, stdout=subprocess.DEVNULL)\n    return {"model": outp, "bytes": os.path.getsize(outp), "seconds": round(time.time() - t0, 1)}\n\n\ndef step_quantize(a):\n    src = os.path.join(a.out, "model-f16.gguf")\n    if not os.path.exists(src):\n        raise RuntimeError("沒有 f16 GGUF：先跑 --step convert")\n    dst = os.path.join(a.out, "model-q8_0.gguf")\n    t0 = time.time()\n    subprocess.check_call([tool(a, "llama-quantize"), src, dst, "Q8_0"], stdout=subprocess.DEVNULL)\n    return {"model": dst, "bytes": os.path.getsize(dst), "seconds": round(time.time() - t0, 1)}\n\n\ndef free_port():\n    s = socket.socket()\n    s.bind(("127.0.0.1", 0))\n    p = s.getsockname()[1]\n    s.close()\n    return p\n\n\ndef post(port, payload, timeout=120):\n    req = urllib.request.Request(f"http://127.0.0.1:{port}/completion", data=json.dumps(payload).encode(),\n                                 headers={"Content-Type": "application/json"})\n    with urllib.request.urlopen(req, timeout=timeout) as r:\n        return json.loads(r.read().decode("utf-8"))\n\n\ndef step_verify(a):\n    import torch\n    from transformers import AutoModelForCausalLM, AutoTokenizer\n    gguf = os.path.join(a.out, "model-q8_0.gguf")\n    if not os.path.exists(gguf):\n        raise RuntimeError("沒有 q8_0 GGUF：先跑 --step quantize")\n    tok = AutoTokenizer.from_pretrained(a.tokenizer)\n    hf = AutoModelForCausalLM.from_pretrained(a.model, dtype=torch.float32).eval()\n    ref = {}\n    with torch.no_grad():\n        for p in PROMPTS:\n            ids = tok(p)["input_ids"]\n            seq = list(ids)\n            out = []\n            for _ in range(GREEDY_N):\n                nxt = int(hf(torch.tensor([seq])).logits[0, -1].argmax())\n                out.append(nxt)\n                seq.append(nxt)\n            ref[p] = (ids, out)\n    del hf\n    port = free_port()\n    log = os.path.join(a.out, "llama-server.log")\n    with open(log, "w") as lf:\n        srv = subprocess.Popen([tool(a, "llama-server"), "-m", gguf, "--port", str(port), "-c", "512", "-t", "8",\n                                "--no-webui"], stdout=lf, stderr=subprocess.STDOUT)\n    rows, pref, full, top1 = [], 0, 0, 0\n    try:\n        for _ in range(120):\n            try:\n                urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=2)\n                break\n            except Exception:\n                time.sleep(1)\n        else:\n            raise RuntimeError("llama-server 沒有在 120 秒內就緒，見 llama-server.log")\n        for p in PROMPTS:\n            ids, ref_out = ref[p]\n            res = post(port, {"prompt": p, "n_predict": GREEDY_N, "temperature": 0, "top_k": 1, "return_tokens": True,\n                              "cache_prompt": False})\n            toks = res.get("tokens", [])\n            k = 0\n            while k < min(len(toks), len(ref_out)) and toks[k] == ref_out[k]:\n                k += 1\n            pref += k\n            full += int(toks == ref_out)\n            rows.append({"prompt": p, "prompt_ids_match_hf": None, "llama_tokens": toks, "hf_tokens": ref_out,\n                         "greedy_prefix_match": k, "greedy_total": GREEDY_N})\n    finally:\n        srv.terminate()\n        try:\n            srv.wait(timeout=20)\n        except subprocess.TimeoutExpired:\n            srv.kill()\n    summary = {"greedy_prefix_match": f"{pref}/{GREEDY_N * len(PROMPTS)}", "greedy_full_match": f"{full}/{len(PROMPTS)}",\n               "bytes": os.path.getsize(gguf)}\n    check = {"reference": "HF（PyTorch fp32，合併後模型，貪婪）", "runtime": "llama-server（llama.cpp b12286，/completion，temperature 0，top_k 1）",\n             "note": "只比貪婪 token；llama-server 不回傳完整 logits，因此不含首步 logits 餘弦", "summary": summary, "rows": rows}\n    with open(os.path.join(a.out, "check_gguf.json"), "w", encoding="utf-8") as f:\n        json.dump(check, f, ensure_ascii=False, indent=1)\n    return {"summary": summary, "check": os.path.join(a.out, "check_gguf.json")}\n\n\ndef step_pack(a):\n    files = []\n    for rel in ["model-q8_0.gguf", "check_gguf.json"]:\n        p = os.path.join(a.out, rel)\n        if os.path.exists(p):\n            files.append({"path": rel, "bytes": os.path.getsize(p), "sha256": sha256(p)})\n    man = {"kind": "llm", "format": "gguf", "quant": "Q8_0", "source": a.model, "files": files,\n           "runtime_check": "llama-server（b12286）貪婪 token 對 HF 參考"}\n    with open(os.path.join(a.out, "manifest_gguf.json"), "w", encoding="utf-8") as f:\n        json.dump(man, f, ensure_ascii=False, indent=1)\n    return {"manifest": os.path.join(a.out, "manifest_gguf.json"), "files": len(files)}\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument("--step", required=True, choices=["convert", "quantize", "verify", "pack"])\n    ap.add_argument("--model", help="合併後的 HF 資料夾（convert／verify）")\n    ap.add_argument("--tokenizer", help="tokenizer 資料夾（預設同 --model；建議指向基底）")\n    ap.add_argument("--out", required=True)\n    ap.add_argument("--llama_src", help="llama.cpp 原始碼根目錄（convert）")\n    ap.add_argument("--llama_dir", help="含 llama-quantize／llama-server 的資料夾（預設用 PATH）")\n    a = ap.parse_args()\n    a.tokenizer = a.tokenizer or a.model\n    os.makedirs(a.out, exist_ok=True)\n    fn = {"convert": step_convert, "quantize": step_quantize, "verify": step_verify, "pack": step_pack}[a.step]\n    try:\n        emit(a.step, True, **fn(a))\n    except Exception as e:\n        emit(a.step, False, error=f"{type(e).__name__}: {str(e)[:500]}")\n        sys.exit(1)\n\n\nif __name__ == "__main__":\n    main()\n'},FA_STUDIO_VIEWER_HTML="<!doctype html>\n<html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>離線訓練工作室</title>\n<style>\n:root{--bg:#fff;--fg:#1f2328;--mut:#656d76;--bd:#d0d7de;--ac:#0969da;--sf:#f6f8fa;--ok:#1a7f37;--er:#cf222e;--wn:#9a6700;--hl:#ddf4ff}\n@media (prefers-color-scheme:dark){:root:not([data-theme]){--bg:#0d1117;--fg:#e6edf3;--mut:#8b949e;--bd:#30363d;--ac:#58a6ff;--sf:#161b22;--ok:#3fb950;--er:#f85149;--wn:#d29922;--hl:#0c2d4a}}\n:root[data-theme=\"dark\"]{--bg:#0d1117;--fg:#e6edf3;--mut:#8b949e;--bd:#30363d;--ac:#58a6ff;--sf:#161b22;--ok:#3fb950;--er:#f85149;--wn:#d29922;--hl:#0c2d4a}\n*{box-sizing:border-box}html,body{height:100%}body{margin:0;background:var(--bg);color:var(--fg);font:13px/1.5 -apple-system,\"Segoe UI\",\"Noto Sans TC\",sans-serif;display:flex;flex-direction:column}\nheader{display:flex;align-items:center;gap:8px;padding:5px 10px;border-bottom:1px solid var(--bd);background:var(--sf);flex-wrap:wrap}\nheader b{font-size:14px}.sp{flex:1}\nbutton,select,input{font:inherit;color:inherit;background:var(--bg);border:1px solid var(--bd);border-radius:5px;padding:2px 8px}\nbutton{cursor:pointer}button:hover:not(:disabled){border-color:var(--ac)}button:disabled{opacity:.5;cursor:not-allowed}\nbutton.pri{background:var(--ac);border-color:var(--ac);color:#fff}button.dng{color:var(--er)}\n#main{flex:1;display:flex;min-height:0}#main.stack{flex-direction:column}\n.pane{display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden}\n.pane.hid{display:none}\n.bar{display:flex;align-items:stretch;border-bottom:1px solid var(--bd);background:var(--sf);flex:none;user-select:none}\n.tabs{display:flex;flex:1;overflow-x:auto;min-width:0}\n.tab{padding:5px 10px;cursor:pointer;border-right:1px solid var(--bd);white-space:nowrap;color:var(--mut)}\n.tab .x{margin-left:6px;opacity:.6}.tab .x:hover{opacity:1;color:#c00}\n.tab.act{background:var(--bg);color:var(--fg);box-shadow:inset 0 -2px 0 var(--ac)}.tab.over{background:var(--hl)}\n.bar button{border:none;border-radius:0;background:none;padding:0 8px}\n.body{flex:1;overflow:auto;padding:10px;min-height:0}\n#split{flex:none;width:6px;background:var(--bd);cursor:col-resize}#main.stack #split{width:auto;height:6px;cursor:row-resize}#split:hover{background:var(--ac)}\n.badge{display:inline-block;padding:0 7px;border-radius:9px;border:1px solid var(--bd);font-size:11px;color:var(--mut);margin-left:4px}\n.badge.ok{color:var(--ok);border-color:var(--ok)}.badge.er{color:var(--er);border-color:var(--er)}.badge.wn{color:var(--wn);border-color:var(--wn)}\n.warn{border:1px solid var(--wn);color:var(--wn);padding:6px 10px;border-radius:6px;margin-bottom:8px}\n.todo{border:1px dashed var(--bd);padding:10px;border-radius:6px;color:var(--mut)}\n.grp{margin:10px 0 4px;font-weight:600}.row{display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px solid var(--bd);flex-wrap:wrap}.row .n{flex:1;min-width:120px;word-break:break-all}\n.card{border:1px solid var(--bd);border-radius:6px;padding:8px;margin:8px 0;background:var(--sf)}\ntable{border-collapse:collapse;width:100%;font-size:12px}td,th{border:1px solid var(--bd);padding:3px 6px;text-align:left}th{background:var(--sf)}\npre{background:var(--sf);border:1px solid var(--bd);border-radius:5px;padding:6px;overflow:auto;max-height:200px;margin:4px 0;font-size:12px}\nlabel{display:block;margin:4px 0 0;color:var(--mut);font-size:12px}input[type=text],select{width:100%}\n#menu{position:fixed;z-index:9;background:var(--bg);border:1px solid var(--bd);border-radius:6px;box-shadow:0 4px 14px #0004;display:none;min-width:130px}\n#menu div{padding:5px 12px;cursor:pointer}#menu div:hover{background:var(--hl)}\ncanvas{width:100%;height:60px;border:1px solid var(--bd);border-radius:4px;background:var(--sf)}\n</style></head><body>\n__SHIM__\n<header><b>🏭 離線訓練工作室</b><span class=\"badge\" id=\"mode\">載入中…</span><span class=\"sp\"></span>\n<button id=\"bReset\" title=\"把分頁位置、分隔線、最大化都還原成預設\">還原版面</button></header>\n<div id=\"main\"><div class=\"pane\" id=\"pL\"></div><div id=\"split\" title=\"拖曳調整寬度；雙擊還原\"></div><div class=\"pane\" id=\"pR\"></div></div>\n<div id=\"menu\"></div>\n<script>__LAYOUT__<\/script>\n<script>\n(function(){\nvar CFG=__CFG__;function applyTheme(t){if(t==='light'||t==='dark')document.documentElement.setAttribut