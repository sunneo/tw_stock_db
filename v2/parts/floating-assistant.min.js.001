},y),e("catalog_onboard",'認識一個新的 Python 函式庫：（PyPI 套件要使用者同意）安裝→抽取每個函式的簽名、型別、副作用→在沙盒裡探測純函式、驗證型別→登記成可用的「單元」並存檔。回傳：單元數、可信任的數量、沒晉升的原因。參數：{"modules":["要抽取的模組（匯入名稱）"],"packages":["PyPI 套件名稱，可加==版本；標準庫不用填"],"probe":true}。只接受 PyPI 套件名稱，不接受網址或 git。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=this._createProgressWidget("🧩 認識新函式庫："+(Array.isArray(t.modules)?t.modules.join("、"):String(t.modules||""))),r=await this._unitCatalogOnboard(t,n);return r.ok?n.finish("完成："+r.units+" 個單元，可信任 "+r.trusted):n.fail(r.error),JSON.stringify(r)},{type:"object",properties:{modules:{type:"array",items:{type:"string"},description:"要抽取的模組（匯入名稱，例如 statistics、yaml）"},packages:{type:"array",items:{type:"string"},description:"要安裝的 PyPI 套件（可加 ==版本）；標準庫不用填"},probe:{type:"boolean",description:"是否探測純函式（預設 true）"}},required:["modules"],additionalProperties:!1}),e("catalog_query","查詢單元目錄（已認識的函式、工具）。action：search（text 關鍵字；可加 takes／returns 型別、trusted、runtime、limit）、show（id）、path（from、to 型別字串，找出幾步接得起來的接線；cast=true 允許不明型別強制轉型）、plan（同 path，但直接產生可以交給 catalog_run 的程式骨架）、stats。trusted＝型別已知且有測試或探測驗證過；沒 trusted 的要先告知風險。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return await this._unitCatalogStoreLoad(),JSON.stringify(this._unitCatalogQuery(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{action:{type:"string",enum:["search","show","path","plan","stats"]},text:{type:"string"},id:{type:"string"},from:{type:"string"},to:{type:"string"},takes:{type:"string"},returns:{type:"string"},trusted:{type:"boolean"},runtime:{type:"string"},limit:{type:"number"},cast:{type:"boolean"}},additionalProperties:!1}),e("catalog_run",'執行一個「呼叫格式」程式（把幾個單元接起來）。先靜態檢查（單元存在、參數齊全、型別接得上、副作用彙整），有風險的副作用會先請使用者同意整個程式。格式：{"inputs":{"名稱":{"type":"url"}},"steps":[{"id":"s1","call":"單元id","args":{"參數":{"$in":"名稱"}|字面值|{"$ref":"前一步id.欄位"}}},{"id":"s2","each":{"$ref":"s1.items"},"max":10,"do":[…]},{"id":"s3","if":{"$ref":"s1.ok"},"then":[…],"else":[…]}],"return":{"$ref":"s2"}}。另外給 args（輸入值）。dry_run=true 只檢查與模擬、不呼叫。要先用 catalog_query 的 plan 取得骨架。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}if(!t.program||"object"!=typeof t.program)return JSON.stringify({ok:!1,error:"缺少 program（物件）"});try{await this._unitCatalogStoreLoad();const e=await this._unitCatalogRunProgram(t.program,t.args||{},{dryRun:!0===t.dry_run});return JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{program:{type:"object",description:"呼叫格式程式（inputs、steps、return）"},args:{type:"object",description:"輸入值（對應 program.inputs）"},dry_run:{type:"boolean"}},required:["program"],additionalProperties:!1}),e("catalog_bind","把 UML 使用案例接到單元目錄的單元（需求 → 活動 → 單元），純程式、0 次模型呼叫。給 UML 文字（一行一件事，格式同 uml_to_code：actor: User／class PdfService { +download(url:Url):FileId; +countPages(pdf:PdfFile):int }／usecase 名稱: User -> PdfService.download(url) -> PdfService.countPages(pdf):int），回傳每個使用案例每一步挑到的單元（檢索＋型別合約打分）、資料流怎麼接（同名優先，其次型別接得上；接不上用型別接線矩陣找橋接單元）、可以直接交給 catalog_run 的呼叫程式與檢查結果。沒有單元對得上的步驟會列在 issues，不會亂猜。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{await this._unitCatalogStoreLoad(),await this._unitCatalogShapeLoad();const e=await this._unitCatalogBindAsync(String(t.uml||""));return e.ok?JSON.stringify({ok:!0,model:e.model,summary:e.summary,semantic:e.semantic,semantic_note:e.semantic_note,usecases:e.results.map(e=>({usecase:e.usecase,valid:e.valid,errors:e.errors,bound:e.bound+"/"+e.total,steps:e.steps.map(e=>({step:e.step,unit:e.unit||e.units||null,by:e.by,score:e.score})),issues:e.issues,effects:e.effects,program:e.program}))}):JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{uml:{type:"string",description:"UML 文字（格式見工具說明）"}},required:["uml"],additionalProperties:!1}),e("catalog_intent",'管理單元目錄的「中文用途說明」——一句中文，讓中文需求找得到名稱與說明都是英文的單元（實測：加了用途說明，找單元前 5 名命中率 60.5% → 92.1%）。action:"missing" 列出還沒有中文說明的單元（id、英文說明、必填參數）；action:"set" 一次補多個，items 是 {單元id: "一句中文說明"}（2～80 字、要有中文、單元要存在；寫「做什麼」加幾個同義說法，例如「算母體標準差」「把一段長文字依寬度折成多行 自動換行」，不要寫實作細節）；action:"list" 看目前全部。補完後語意檢索的單元向量會在下次 /unit-catalog embed build 重算。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{await this._unitCatalogStoreLoad(),await this._unitCatalogIntentsLoad();const e=String(t.action||"missing");if("set"===e){if(!t.items||"object"!=typeof t.items)return JSON.stringify({ok:!1,error:"items 要是 {單元id: 中文說明}"});const e=await this._unitCatalogIntentSet(t.items);return JSON.stringify(Object.assign({ok:!0},e))}if("list"===e)return JSON.stringify({ok:!0,intents:this._unitCatalogIntents()});const n=this._unitCatalogIntentMissing(),r=Math.max(1,Math.min(60,Number(t.limit)||30));return JSON.stringify({ok:!0,missing_total:n.length,units:n.slice(0,r).map(e=>({id:e.id,summary:e.summary,params:e.params.filter(e=>e.required).map(e=>e.name)}))})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{action:{type:"string",enum:["missing","set","list"],default:"missing"},items:{type:"object",description:'action:"set" 用：{單元id: "一句中文說明"}'},limit:{type:"number",description:'action:"missing" 最多列幾個（預設 30，最多 60）'}},additionalProperties:!1}),e("catalog_card","讀一份很長的說明文件（GitHub 倉庫的 README、使用手冊、設計文件、維基、StackOverflow 問答），整理成「能力卡片」：一句說明、語言、執行環境（瀏覽器／Node／Python）、安裝指令或 CDN 網址、主要函式、能力描述（動詞＋受詞）、需要的條件（相機、WebGL、模型檔、API 金鑰…）、授權、是否停止維護，每個欄位附信心。長文用「地圖縮放」：先切成章節樹，依重要性（安裝、用法、功能、API）在字數預算內由大到小放大讀，每片段各自抽事實再投票融合——不是整份塞給模型。給 url（GitHub 倉庫網址會自動抓 README）或 text；kind 可選 readme／qa／wiki／guide／design。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._unitCatalogCard(t);return JSON.stringify({ok:!0,kind:e.kind,chars:e.chars,card:e.card})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{url:{type:"string",description:"說明文件的網址（GitHub 倉庫網址會自動取 README）"},text:{type:"string",description:"直接給文字（跟 url 二選一）"},kind:{type:"string",enum:["readme","qa","wiki","guide","design"],description:"文件種類，影響章節的重要性判斷（預設 readme）"},name:{type:"string"},description:{type:"string",description:"搜尋結果給的一句話描述（有的話優先當說明）"},budget_chars:{type:"number",description:"最多讀幾個字（預設 12000）"},context_tokens:{type:"number",description:"模型的上下文長度，用來決定每片大小"}},additionalProperties:!1}),e("catalog_js","把一份 JavaScript 原始碼（未壓縮的 .js 檔網址，或直接給文字）抽成單元登記進單元目錄：找出對外提供的函式與類別方法（ES module export、CommonJS、UMD 工廠函式、瀏覽器全域函式、prototype 方法），參數與回傳型別來自 JSDoc、預設值、參數名稱，副作用（網路、DOM、相機、檔案、計時…）靜態分析並順著呼叫鏈合併。不執行任何程式碼；信任等級一律 0，規劃時才會被用到。壓縮過的檔案函式名稱已被縮短，抽出來沒什麼用。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._unitCatalogJsOnboard(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{url:{type:"string"},text:{type:"string"},pkg:{type:"string",description:"單元名稱的前綴（預設取檔名）"},version:{type:"string"}},additionalProperties:!1}),e("catalog_discover","缺口驅動的探索：給 UML 使用案例（uml）或需要的能力清單（needs），先用單元目錄接線，沒有單元可用的步驟就是「缺口」；為每個缺口產生英文搜尋關鍵字、用 browser_search 找（github、wiki、stackoverflow、codeproject…）、讀 README（長文地圖縮放＋多片段投票，見 catalog_card）、整理成能力卡片、依缺口排名（說明相符、執行環境相容、有沒有停止維護、需不需要金鑰或伺服器），輸出計畫：每個缺口建議用哪個專案、怎麼安裝、主要函式、需要什麼、備選是誰；找不到的明講。extract 不是 false 時，如果卡片有未壓縮的 CDN 檔會順手抽成單元再接一次線看缺口有沒有補上。這個工具只規劃，不安裝也不執行。計畫出來後，只有真的有分歧的地方（幾個候選分數差不多、推薦的需要金鑰或伺服器而備選不需要、只勉強過門檻、找不到）才會跳選擇題問使用者，沒有分歧的直接用推薦的；使用者不點選項、直接打字，就當成補充（內容在 user_notes，裡面的網址在 user_urls，可以拿去 catalog_card 讀）。decisions 是使用者做的決定，照它做，不要再問一次。找不到或只勉強過門檻的缺口，會先反思：可能打錯字（問使用者要不要改成猜的那個、或讓他直接打自己的說法，改正後再找一次）、可能是新的需求（reflections 裡 kind 是 novel、novel 列出缺口）——這種不是「找不到」，是「還沒有」：照 novel_next 改用 UML 拆成極小的單元、現有的用 catalog_bind 接線、沒有的才新寫，寫好用 catalog_onboard 回填目錄。reflect:false 可以關掉反思。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._unitCatalogDiscover(t);return JSON.stringify({ok:e.ok,plan_id:e.plan_id,feedback_hint:"使用者採用或退回、或你試跑之後，用 catalog_feedback 記下來（plan_id＋gap＋verdict）",gaps:e.gaps_initial,resolved:e.resolved,rounds:e.rounds,candidates:(e.candidates||[]).map(e=>{const{card:t,features:n,need:r,...a}=e;return Object.assign(a,{alternatives:(a.alternatives||[]).map(e=>({name:e.name,url:e.url,score:e.score}))})}),references:e.references,unresolved:e.unresolved,decisions:e.decisions,user_notes:e.user_notes,user_urls:e.user_urls,reflections:e.reflections,novel:e.novel,novel_next:(e.novel||[]).length?FaCatalogReflect.NOVEL_NEXT:void 0,text:e.text,error:e.error})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{reflect:{type:"boolean",description:"false＝不做反思（預設：找不到或只勉強過門檻的缺口，先想想是不是打錯字、或是新的需求）"},ask:{type:"boolean",description:"false＝遇到分歧也不問使用者，全部用推薦的（預設：只有真的有分歧才問，一次最多3題）"},max_questions:{type:"number",description:"一次最多問幾題，預設3"},uml:{type:"string",description:"UML 文字（格式同 catalog_bind）"},needs:{type:"array",items:{type:"string"},description:"沒有 UML 時，直接列需要的能力（中英文都可以）"},runtime:{type:"string",enum:["browser","node","python"],default:"browser"},extract:{type:"boolean",description:"false＝不要抽單元，只規劃"},use_learned:{type:"boolean",description:"true＝用 catalog_feedback train 存下來的排名模型（資料夠才有意義）"},use_embed:{type:"boolean",description:"false＝不用嵌入模型排名（語意檢索有啟用才會用）"},use_model:{type:"boolean",description:"true＝用離線小模型把需求改寫成英文搜尋關鍵字（實測這一步它比詞庫好）；預設不用"},max_gaps:{type:"number"},per_gap:{type:"number"},context_tokens:{type:"number"}},additionalProperties:!1}),e("catalog_feedback",'把 catalog_discover 計畫的結果記成標註，累積成排名模型的訓練資料。verdict：adopt（使用者採用了推薦的專案）、reject（使用者退回，可附 reason）、run_ok（拿它在沙盒試跑成功）、run_fail（試跑失敗，附 error 原文——權限、網路、資源、逾時這類環境問題不會算成專案不好，API 用錯、缺套件、沒定義算輕的負例）。gap 是缺口編號（例如 need/1），不給就是計畫裡全部；url 可以指定備選專案；plan_id 不給就用最近一次的計畫。使用者明講採用或退回時、你在沙盒試過它之後，都要呼叫。另外 action:"stats" 看累積多少、夠不夠訓練；"train" 做留一組交叉驗證（save:true 才存模型）；"export" 匯出 JSON；"clear" 清掉。',async function(e){let t={};tr