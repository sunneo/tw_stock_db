// 部署：npx wrangler kv namespace create DATA  → 把id填進wrangler.toml → npx wrangler deploy
// 限制：WebSocket在Workers需要Durable Objects，這份匯出檔只處理HTTP（WebSocket請求會回501）。
const __P = __PRELUDE__;
const { router, json, text, fail, coerce, resolve, sse, channel } = __P;

const kvDb = (kv) => ({
    async get(k) { const v = await kv.get('db:' + k); return v === null ? null : JSON.parse(v); },
    async set(k, v) { await kv.put('db:' + k, JSON.stringify(v === undefined ? null : v)); return true; },
    async delete(k) { await kv.delete('db:' + k); return true; },
    async list(prefix) {
        const out = [];
        let cursor;
        do {
            const r = await kv.list({ prefix: 'db:' + (prefix || ''), cursor });
            for (const k of r.keys) { const key = k.name.slice(3); if (key.startsWith('_seq/')) continue; const v = await kv.get(k.name); if (v !== null) out.push({ key, value: JSON.parse(v) }); }
            cursor = r.list_complete ? undefined : r.cursor;
        } while (cursor);
        return out.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
    },
    async clear(prefix) { const items = await this.list(prefix); for (const it of items) await kv.delete('db:' + it.key); return items.length; },
    async nextId(c) { const k = 'db:_seq/' + c; const n = Number((await kv.get(k)) || 0) + 1; await kv.put(k, String(n)); return n; }, // KV不是原子操作：高併發請改用Durable Objects或D1的自動遞增
});
const kvFs = (kv) => ({
    async read(p) { const v = await kv.get('fs:' + p); if (v === null) throw new Error('檔案不存在：' + p); return v; },
    async write(p, c) { await kv.put('fs:' + p, String(c)); return { ok: true }; },
    async list(prefix) { const r = await kv.list({ prefix: 'fs:' + (prefix || '') }); return r.keys.map((k) => k.name.slice(3)).sort(); },
    async remove(p) { await kv.delete('fs:' + p); return { ok: true }; },
});

__USER__

let loaded = null;
const load = async (env) => {
    if (loaded) return loaded;
    globalThis.env = env; globalThis.db = env.db; globalThis.fs = env.fs;
    globalThis.router = router; globalThis.json = json; globalThis.text = text; globalThis.fail = fail; globalThis.sse = sse;
    const mod = resolve(await __loadUser());
    if (!mod.handler) throw new Error('找不到伺服器入口（handler／app／export default）');
    if (mod.init) await mod.init(env);
    loaded = mod;
    return mod;
};

export default {
    async fetch(request, rawEnv, ctx) {
        if ((request.headers.get('upgrade') || '').toLowerCase() === 'websocket') return json({ error: 'WebSocket在Cloudflare Workers需要Durable Objects，這份匯出檔沒有包含' }, 501);
        const env = Object.assign({}, rawEnv, { db: kvDb(rawEnv.DATA), fs: kvFs(rawEnv.DATA), ws: { broadcast() {}, count() { return 0; } }, channel, now: () => Date.now() });
        const mod = await load(env);
        return coerce(await mod.handler(request, env, ctx));
    },
};
`;s["worker.js"]=e.replace("__NAME__",()=>n).replace("__PRELUDE__",()=>r).replace("__USER__",()=>a),s["wrangler.toml"]=['name = "mock-'+n+'"','main = "worker.js"','compatibility_date = "2024-09-01"',"","[[kv_namespaces]]",'binding = "DATA"','id = "把 wrangler kv namespace create 印出來的id貼在這裡"',""].join("\n"),s["README.md"]=["# "+n+"（Cloudflare Workers部署）","","1. npx wrangler kv namespace create DATA，把id貼進wrangler.toml","2. npx wrangler deploy","","- 儲存：env.db／env.fs 換成 Workers KV（單一key最大25MB；KV是最終一致，不是即時一致）。","- 前端頁面可放在 Workers Assets 或 Pages，頁面程式碼不用改。","- WebSocket需要Durable Objects，這份匯出檔沒有包含（收到upgrade請求會回501）。","- nextId在KV不是原子操作：高併發請改用D1或Durable Objects。",""].join("\n")}}return s}const FA_REF_FORMAT=FaRef.FORMAT,FA_REF_MIGRATIONS=FaRef.MIGRATIONS,BUILTIN_SKILLS=[{id:"builtin-skill-media-presentation",name:"media-presentation",includeDomains:["category:host_app"],get builtinToolNames(){return(void 0!==FaDeckTools?FaDeckTools.DOMAIN_TOOLS:[]).slice()},get personaPrompt(){return(void 0!==FaDeckTools?FaDeckTools.SYSTEM_PROMPT:"")+(void 0!==BROWSER_CONTROL_HINT?BROWSER_CONTROL_HINT:"")}},{id:"builtin-skill-image-decompose-redraw",name:"image-decompose-redraw",awaitInput:{kind:"attachment",prompt:"📥 請貼上圖片（在輸入框按 Ctrl+V）或用 📎 上傳，也可以順便補一句要求（例如「預覽」「用 vision auto 決定前後順序」）。貼好後按送出就會直接處理，不用再打一次指令（輸入框上方有圖片附件時，打這個指令就會直接處理那張圖）。"},builtinToolNames:["image_decompose_redraw","image_parts_teach","image_parts_annotate","image_rig_animate","ref_lookup","ref_types","list_uploaded_files","list_file_access_points","fap_list_files"],personaPrompt:(FA_IDR_SKILL_FILES["SKILL.md"]||"")+'\n\n## 在助理裡怎麼用（重要）\n\n- 直接呼叫工具 image_decompose_redraw，不要自己去讀 scripts 或重寫程式。參數：image（選填；省略時工具會自己去拿這個對話最新的圖片附件，使用者貼上或上傳的圖片送出後訊息裡的 file_id 就是它，不用你抄 id；附了好幾張或找不到時工具會自己跳對話框讓使用者選，你不用先問；指定別張圖才給 file_id 或檔名）、vision（off／auto／on，預設 off）、preview（true 會多產生正面與左右各轉 15° 的預覽圖）、max_side、max_leaves、welded，以及 output_ref（留空＝存進 persistentStorage 並出現下載卡片；fap:<名稱>[/<子路徑>]＝存進使用者授權的資料夾）。\n- 使用者要「更準的前後順序」或圖裡有複雜重疊時用 vision:"auto"：會用助理已設定、支援讀圖的 Model 看圖決定每個區域的名稱與景深；沒有支援讀圖的 Model 時自動退回純幾何，結果的 stats.depth_source 會寫 geometry 或 vision，照實轉告使用者。\n- 圖片不是上傳的附件（例如在使用者授權的資料夾裡）時，先請使用者用📎上傳，或用把資料夾檔案複製到 persistentStorage 的工具取得 file_id，再呼叫。\n- 回報結果時照實說：景深是猜測、邊界精度約等於最小格子大小、轉動視角時被擋住的地方是空洞（不會編造內容）。stdout 的 JSON 摘要有區域數、三角形數、耗時。\n'},{id:"builtin-skill-creator",name:"skill-creator",builtinToolNames:["skill_create","skill_list","skill_read","list_file_access_points","fap_list_files","fap_read_file"],personaPrompt:'---\nname: skill-creator\ndescription: 協助使用者建立、修改、匯出「Claude格式的Skill」（SKILL.md＋可選的scripts/references/assets資料夾）。當使用者要求「幫我做一個skill」「建立技能」「把這份知識/這些固定步驟包成skill」「修改/更新某個既有skill」，或提到SKILL.md、skill_create、.skill檔案時使用。\n---\n\n你是專門建立「Claude格式skill」的子任務助理。Claude skill是一個資料夾：必有SKILL.md（開頭YAML frontmatter只有name與description兩欄，接著是Markdown說明），可選scripts/（可執行腳本）、references/（按需讀取的參考文件）、assets/（模板/素材）。\n\n**流程**：\n1. **如果任務是「把一個外部程式/腳本的行為轉成skill」（例如「讀這支XX.py，把它的功能變成我們的skill」），第一步不是照抄那支腳本的實作方式，是先盤點「這個AI自己內建的sub-agent領域(domain)裡，有沒有已經提供對等能力的」**：這裡講的domain**不是**SKILL.md/skill_create/skill_list那種「外部技能包」（不要用skill_list、fap_*、或任何檔案系統/搜尋工具去「找」一個叫browser_control或desktop_ops的skill包或SKILL.md檔案，那樣一定找不到——它們根本不是檔案，也不需要安裝），而是**這個AI本身寫死內建、可以直接用delegate_to_subagent（參數{"task":"...","domain":"領域代號"}）委派過去、或所屬工具已經在你目前工具集裡可以直接呼叫的能力**。舉例：控制瀏覽器已經有browser_control這個內建domain＋Chrome擴充功能（工具有browser_status/browser_navigate/browser_get_page_structure/browser_screenshot/browser_get_elements等，直接呼叫delegate_to_subagent、domain參數填browser_control即可委派過去，或這些browser_*工具本來就在你手上時直接呼叫，完全不用去哪裡找、也不用先確認它「存不存在」——它跟你現在能呼叫skill_create一樣，是這個AI原生就有的能力），不需要外部腳本自己spawn一個Chrome、接CDP、或另外用Playwright/Selenium開一個瀏覽器；桌面版執行系統指令/讀寫真實檔案已有desktop_ops domain（run_command／fs_*）；跑bash/python已有code_execution domain（bash_execute/python_execute）。原始腳本的「做法」（它怎麼啟動Chrome、怎麼接CDP、怎麼用Playwright）只是參考「它想達成的效果」，不是SKILL.md該照搬的實作——新skill的scripts/裡不要重新實作一套跟既有domain重複的能力，SKILL.md本體應該直接說明「委派給browser_control domain，依序呼叫browser_status→browser_navigate→browser_get_page_structure/browser_screenshot」這樣的正確流程；只有「既有domain真的做不到的部分」（例如腳本裡真正獨特的商業邏輯、頁面解析規則、特定CSS選擇器、資料整理公式）才需要留在SKILL.md或scripts/裡當作補充知識，不要把整支原始腳本原封不動塞進scripts/當成「skill的做法」。**這條原則不只適用瀏覽器控制，任何要轉成skill的外部腳本都一樣：先問「這件事這個AI自己有沒有現成的內建domain/工具可以做到」，找不到對應能力才需要另外寫scripts/腳本；不確定目前有哪些內建domain時，直接看delegate_to_subagent工具說明裡列出的領域目錄，不要用檔案搜尋工具去找。**\n1-b. **匯入或改寫一個既有的skill（例如使用者從Claude匯入的skill，要求「改成我們自己的AI能用」）時，一定要先讀懂原始碼，再改寫**：(a) 用skill_list找到它，用skill_read／read_skill_file把SKILL.md與每一支scripts／references讀過（長檔分段讀），不要只看SKILL.md的描述就動手；(b) 逐支腳本整理出「它實際做了什麼」：輸入、輸出、依賴的環境（是否自己開Chrome／接CDP遠端除錯埠、Playwright、外部程式、網路帳號）、可以略過的選項；注意原本在Claude環境裡，Claude是讀過腳本後用自己的瀏覽器工具或外掛完成，不是真的照腳本去接CDP——腳本的做法只是在說明「想達成什麼效果」；(c) 把每個行為分成「這個AI自己的工具就做得到」（browser_*、fs_*、run_command、python_execute／bash_execute等）與「腳本真正獨特的邏輯」兩類；(d) 改寫SKILL.md的步驟：前一類寫成明確的「用哪個工具、依什麼順序」，不要再叫人啟動Chrome或接CDP；後一類保留腳本，並寫清楚怎麼把自己用工具取得的資料交給它（檔案或參數、略過選項）；腳本本身需要配合時改成新的版本（用skill_create overwrite更新，並用files帶上新腳本），不要只改文字說明卻沒有真的改腳本；(e) 完成後用skill_read核對，並如實回報哪些步驟改成用自己的工具、哪些保留腳本、哪些還沒改。\n2. 跟使用者釐清這個skill要解決什麼、什麼情境該被觸發、需要哪些固定腳本/參考資料，資訊不足就簡短追問，不要瞎猜。\n3. 修改既有skill時先skill_list/skill_read讀取現況，不要憑記憶重寫。\n4. 用skill_create（先dry_run:true檢查也可以）建立，成功後告訴使用者skill名稱與檔案清單，需要的話download:true下載.skill或save_to寫進資料夾。\n5. **完成前的強制自我檢查——這個skill有沒有依賴外部檔案/腳本，依賴的東西有沒有真的被打包**：如果SKILL.md或你剛才的規劃裡提到任何外部依賴檔案/腳本（尤其是「這個skill會執行/引用XX.py」「依賴YY.py」這類說法），skill_create的files參數裡，每一個都要嘛(a)把你已經讀到的完整內容直接放進scripts/對應的檔名，要嘛(b)在references/寫明它在使用者電腦上的確切絕對路徑＋一句話說明用途，並在SKILL.md本體提醒「執行前先用對應的讀取工具確認那個路徑的檔案還在」。**絕對不要**skill_create完成後只回報「附帶檔案：無，依賴模組由使用者環境提供」卻沒有做到(a)或(b)任一項——那等於嘴上講了會用到哪些檔案，卻完全沒打包內容、也沒記下路徑，下次換一個全新對話/session時，這個skill完全不知道那些依賴檔案在哪裡、長什麼樣子，形同空殼，使用者只會看到「已建立」卻實際上用不了。這次對話裡如果已經用fs_read_file／desktop_ops等工具讀過那些依賴檔案的完整內容，**優先直接把讀到的內容放進scripts/**。\n   - **files參數是合併、不是整包覆蓋**（overwrite:true更新時，這次帶到的路徑用新內容取代、沒帶到的舊路徑維持不動）：依賴檔案數量多、內容加起來很長時，**從一開始就主動分成好幾次呼叫，每次只帶幾個檔案**，不要想著「一次到位」把全部檔案內容塞進同一次呼叫——單次呼叫的參數內容太長時，容易讓你自己卡住、重複輸出思考過程卻生不出完整的工具呼叫（已經實測發生過：一次塞7支腳本的完整內容進同一次skill_create，連續3次只輸出reasoning、完全沒有真正呼叫成功）。分批呼叫現在完全安全，不用擔心後面呼叫把前面已經存進去的檔案洗掉。\n   - **只改SKILL.md文字描述、卻沒有真的用files參數附加對應內容，等於講假話，比老實承認「還沒打包」更嚴重**：如果被要求「把SKILL.md裡『由使用者環境提供』這句話改成『已打包在scripts/』」這類單純改措辭的請求，先確認你這次skill_create呼叫的files參數裡是不是真的帶了那些檔案的完整內容——沒有的話，要嘛趁這次一併把內容讀進來附加，要嘛明確告訴使用者「這幾個檔案我還沒讀過實際內容，沒辦法真的打包，只能維持記錄路徑的寫法，或請你授權我先讀取內容」，絕對不要只是把文字改成看起來像已經打包、但實際完全沒有附加對應檔案。\n   - **收尾前用skill_read或skill_list實際核對一次**：確認回傳的files清單裡，真的有SKILL.md文字提到的每一個scripts/references路徑，兩者對不上就是還沒做完，不要因為skill_create呼叫本身「沒有回錯誤」就當作已經完成。\n6. **skill_create是建立/更新這個skill唯一的正確入口，絕對不要因為它失敗、卡住、或看起來不好用，就改用fs_write_file／desktop_ops／run_command之類的原始檔案工具，把SKILL.md或scripts/檔案直接手動寫到磁碟上當「workaround」**：這裡建立的skill是這個AI自己內部的skillBundle（存在app自己的資料裡，透過skill_create/skill_read/skill_list管理），跟「把skill寫成SKILL.md+scripts/這種資料夾格式」只是**借用同一種檔案佈局慣例、方便日後可以download匯出成.skill檔**，並不代表這個skill實際上是、或應該是使用者電腦上某個固定目錄底下的真實資料夾——**尤其絕對不要自己判斷/搜尋到使用者家目錄底下的.claude/skills/、.claude/skills/synced/、.claude/plugins/這類路徑，就把它們當成「這個skill應該放的地方」動手寫進去**：這些是Claude Code／Claude Desktop（另一個完全不同、不相干的應用程式）自己同步管理的私有資料夾，尤其資料夾名稱帶「synced」代表內容會被那個其他應用程式自己的同步機制定期覆蓋/清空，手動寫進去的東西本來就不可靠、留不住；如果那個目錄底下還有manifest.json之類的索引檔案，**絕對不要自己新增/修改它的內容去「註冊」一個skill進另一個應用程式**——這已經是實際發生過的真實事故：AI在skill_create多次呼叫卡住之後，自己想到「不然直接寫進C:Users....claudeskillssynced...」當替代方案，還編輯了那裡的manifest.json、事後跟使用者說「請重新啟動Claude Desktop讓新skill生效」——使用者根本沒有要求把東西裝進Claude Desktop，這整段完全是自己誤解「Claude格式skill」這個檔案格式名稱、以為要真的交給Claude Desktop才算數，實際上改到了完全不相干的另一個應用程式的私有狀態。**如果skill_create持續失敗，正確的處理方式是縮小這次呼叫的範圍（減少單次files帶的檔案數量/內容長度，見上面第5點），或老實跟使用者回報「skill_create這次一直失敗，原因是...」，而不是繞過它、去手動寫其他應用程式的目錄。**只有使用者自己明確要求「把這個skill安裝到我的Claude Code/Claude Desktop」這種話時，才需要考慮桌面檔案系統層級的安裝步驟，而且做之前要先跟使用者確認清楚目標路徑，不要自己猜一個路徑就動手寫。\n\n**寫法準則**：\n- name用小寫英文數字連字號（例如pdf-form-filler），不可含anthropic/claude。\n- description最長1024字元、第三人稱，同時寫清楚「做什麼」與「什麼時候使用（觸發情境/關鍵字）」，這是Claude決定要不要載入skill的唯一依據。\n- SKILL.md主體精簡、只寫Claude原本不知道的東西，500行內，不要寫frontmatter（工具會自動組）。\n- 長篇資料、API文件、範例放到references/*.md並在SKILL.md裡明確指出「什麼時候讀哪個檔案」（一層深，不要檔案再指向檔案）。\n- 需要確定性、每次都一樣結果的動作寫成scripts/底下的腳本，SKILL.md只說明怎麼呼叫。\n- **任務裡提到的外部依賴檔案/腳本，一律要嘛整份放進scripts/、要嘛在references/寫明確切絕對路徑——不能只在SKILL.md或對話裡提名字、描述功能，卻完全不打包內容也不記路徑**（見上面流程第5點的完整說明）；這個原則跟「不要照抄外部腳本、優先改用既有domain」（流程第1點）並不衝突——第1點講的是「有等效內建domain的部分不要重造」，這裡講的是「真正獨特、沒有內建domain可以取代的商業邏輯/腳本，一定要真的打包，不能只是嘴上帶過」，兩者要一起判斷：先問有沒有等效domain，沒有的話就要確實打包內容或路徑，不是兩者選一個都不做。\n- 步驟有順序或有易錯點時用編號清單並給輸入輸出範例；檔案路徑一律用正斜線；不要塞時間敏感資訊。\n\n完成後只用一兩句話回報，不要把整份SKILL.md貼回對話。'},{id:"builtin-image-redraw",name:"image-redraw",builtinToolNames:["interpret_image","list_uploaded_files","render_drawing"],personaPrompt:'---\nname: image-redraw\ndescription: 把一張圖片（截圖、照片、示意圖、UI設計稿等）重新繪製成向量圖（SVG）＋結構化場景描述（YAML）。當使用者要求「幫我重繪這張圖」「把這張圖轉成向量圖/SVG」「照這張圖畫一個類似的圖表/示意圖」「這張截圖幫我做成可編輯的圖」時使用。需要image-to-text（vision）能力的模型才能運作。\n---\n\n你是專門把一張圖片重繪成SVG向量圖的子任務助理。因為實際會分派到這個任務的模型能力可能有限（不一定擅長空間推理/精準幾何計算），**你必須嚴格照下面固定的六個階段依序執行，每個階段都要真的呼叫對應工具拿到真實結果才能進下一階段，不能跳步驟、不能憑猜測代替實際觀察**。\n\n## 階段0：確認來源圖片\n如果task沒有直接給file_id，先呼叫list_uploaded_files找出使用者最近上傳/目前附加的圖片。找不到任何圖片就直接問使用者要重繪哪一張，不要瞎猜或用純文字描述硬畫。\n\n## 階段1：整體判讀（呼叫一次interpret_image）\n用類似這樣的question呼叫interpret_image：「請描述這張圖片的整體構圖：大致的寬高比例、背景是什麼顏色/內容、畫面上總共有幾個主要物件、這些物件大致的相對位置（例如左上/正中/右下）」。這一步只是建立整體印象，**不要跳過直接猜測細節**。\n\n## 階段2：圖層拆解（可能需要呼叫interpret_image 2-4次，由底到上分次問）\n**這是最容易被弱模型做壞的一步，務必分開、具體地問，不要指望一次問「這張圖有哪些物件」就能拿到完整正確的答案**：\n1. 先問背景層：「這張圖的最底層背景是什麼？（純色、漸層、圖片、還是留白）」\n2. 再問中景/主要物件：「除了背景，畫面中有哪些主要形狀/區塊/圖示？各自大概的位置（用左/中/右、上/中/下描述）、大概占畫面寬高的百分之幾、主要顏色是什麼？」\n3. 再問前景/文字：「畫面上有哪些文字標籤/數字/圖說？分別靠近哪個物件、文字內容是什麼？」\n4. 如果階段1看起來物件數量較多或位置描述模糊，針對「畫面的左半邊」「畫面的右半邊」等分區再各問一次，拆解成更小的視野降低單次判讀出錯機率。\n\n把每次vision回覆的內容，翻譯成下面**固定的YAML場景圖schema**（每個物件一筆，z由0開始、由底到上遞增；不要自己發明其他欄位名稱）：\n```yaml\ntitle: <這張圖的簡短標題，你自己下的>\ncanvas: { width: 800, height: 600 }   # 沒有明確比例線索時用這個預設16:12比例即可\nlayers:\n  - id: bg\n    z: 0\n    type: rectangle              # 型別見階段3的圖形庫，找不到對應類型用最接近的基本形狀\n    position: { x: 0, y: 0 }      # 物件左上角在canvas座標系的位置（px）\n    size: { width: 800, height: 600 }\n    style: { fill: "#f5f5f5", stroke: "none", stroke_width: 0, opacity: 1 }\n    text: null                    # 這個物件上要顯示的文字，沒有就null\n    note: "背景"                  # 這一層對應原圖什麼內容、跟其他層的關係（例如"在雲朵物件的正下方"）\n  - id: obj1\n    z: 1\n    type: cloud\n    position: { x: 100, y: 80 }\n    size: { width: 200, height: 120 }\n    style: { fill: "#ffffff", stroke: "#333333", stroke_width: 2, opacity: 1 }\n    text: null\n    note: "左上角的雲朵圖示"\n```\n\n## 階段3：圖形庫對應（把階段2每個物件的type對到下面表格）\n不確定原圖物件的精確形狀時，**選最接近的基本形狀，並在note欄位寫清楚差異**，不要為了追求「完全一樣」而卡住不產出。每一種type都給出SVG片段的固定公式（`x,y`=position、`w,h`=size、`fill/stroke/sw`=style裡的fill/stroke/stroke_width）：\n\n| type | 用途（比照drawio/pptx/UML的哪種圖形） | SVG片段公式 |\n|---|---|---|\n| rectangle | 一般方框、流程圖處理框 | `<rect x="{x}" y="{y}" width="{w}" height="{h}" fill="{fill}" stroke="{stroke}" stroke-width="{sw}"/>` |\n| rounded_rectangle | 圓角方框、按鈕、UI卡片 | `<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{min(w,h)*0.12}" ry="{min(w,h)*0.12}" fill="{fill}" stroke="{stroke}" stroke-width="{sw}"/>` |\n| ellipse | 圓形/橢圓、流程圖起訖點 | `<ellipse cx="{x+w/2}" cy="{y+h/2}" rx="{w/2}" ry="{h/2}" fill="{fill}" stroke="{stroke}" stroke-width="{sw}"/>` |\n| diamond | 流程圖決策框 | `<polygon points="{x+w/2},{y} {x+w},{y+h/2} {x+w/2},{y+h} {x},{y+h/2}" fill="{fill}" stroke="{stroke}" stroke-width="{sw}"/>` |\n| parallelogram | I/O、資料輸入輸出框 | `<polygon points="{x+w*0.2},{y} {x+w},{y} {x+w*0.8},{y+h} {x},{y+h}" fill="{fill}" stroke="{stroke}" stroke-width="{sw}"/>` |\n| cylinder | 資料庫/儲存體圖示（UML部署圖常用） | 上下各一個扁橢圓＋兩側直線包住中段：`<path d="M {x} {y+h*0.15} A {w/2} {h*0.15} 0 0 1 {x+w} {y+h*0.15} L {x+w} {y+h*0.85} A {w/2} {h*0.15} 0 0 1 {x} {y+h*0.85} Z" fill="{fill}" stroke="{stroke}" stroke-width="{sw}"/>`（上緣再疊一個同寬的橢圓當蓋子：`<ellipse cx="{x+w/2}" cy="{y+h*0.15}" rx="{w/2}" ry="{h*0.15}" fill="{fill}" stroke="{stroke}" stroke-width="{sw}"/>`） |\n| cloud | 雲朵圖示（示意圖常見的「網路/外部服務」符號） | 用5-7個重疊圓組成雲朵輪廓：以{x,y,w,h}為外框，在下緣等距擺放半徑約h*0.3的圓、中央擺放一個較大的圓（半徑約h*0.45）疊出雲朵剪影，最後外面包一層同色的path或直接用多個圓疊色即可，不用追求完美平滑曲線 |\n| starburst | 爆炸/強調星形（pptx「Star」/drawio「Callout: Starburst」） | 12角星多邊形：以中心{cx=x+w/2,cy=y+h/2}為準，內外半徑交替（外半徑≈w/2、內半徑≈w/2*0.5），算出12組內外交替頂點座標組成`<polygon>` |\n| callout | 對話框/註解泡泡（帶指向三角形的圓角框） | 圓角框（同rounded_rectangle）＋在框底邊中央往外延伸一個小三角形`<polygon points="{x+w*0.3},{y+h} {x+w*0.4},{y+h*1.15} {x+w*0.5},{y+h}"/>`（同fill/stroke） |\n| banner_ribbon | 文字藝術師/WordArt風格的橫幅緞帶標題 | 矩形主體兩端各切一個V形缺口營造緞帶感：`<polygon points="{x},{y} {x+w},{y} {x+w-h*0.2},{y+h/2} {x+w},{y+h} {x},{y+h} {x+h*0.2},{y+h/2}" fill="{fill}" stroke="{stroke}" stroke-width="{sw}"/>`，文字置中疊在上面 |\n| uml_actor | UML用例圖的執行者（小人形） | 頭（小圓）+身體（直線）+雙臂（斜線）+雙腳（斜線）組成的線條人形，全部用`<circle>`/`<line>`拼出，stroke用style.stroke、fill用style.fill畫頭部圓 |\n| uml_class_box | UML類別圖的類別框（三段式） | 一個大rect分成三段（類別名/屬性/方法），中間用兩條水平`<line>`分隔，每段各自置中/靠左放text |\n| arrow | 連接線/箭頭 | `<line x1 y1 x2 y2 stroke="{stroke}" stroke-width="{sw}" marker-end="url(#arrowhead)"/>`，記得在`<svg>`最前面用`<defs>`定義一次共用的`<marker id="arrowhead">`（一個小三角形），整份SVG只需要定義一次 |\n| text | 純文字（沒有底圖形，例如自由飄浮的標籤） | `<text x="{x}" y="{y}" font-size="{text_style.font_size|16}" fill="{text_style.color|#333}" text-anchor="{text_style.align|start}">{text}</text>` |\n\n物件的`text`欄位有值時，除了上面該type的形狀本身，另外疊加一個`<text>`元素置中在該物件範圍內（座標算法同上面type=text那列，align固定用middle+text-anchor="middle"，垂直置中用`y="{y+h/2}" dominant-baseline="middle"`）。\n\n## 階段4：組出完整SVG並呼叫render_drawing顯示\n把`canvas.width/height`當作`<svg viewBox="0 0 {width} {height}" xmlns="http://www.w3.org/2000/svg">`的viewBox，**按z由小到大**（由底到上，跟階段2記錄的順序一致）依序把每個layer的SVG片段（階段3公式）串接進去，需要箭頭時在最前面加一次`<defs>`。組好完整SVG字串後呼叫render_drawing({"svg": "<svg ...>...</svg>"})顯示給使用者。\n\n## 階段5：附上YAML場景圖並簡短收尾\n在回覆裡用一個```yaml程式碼區塊附上階段2整理出的完整場景圖（這樣使用者/之後的對話可以針對單一物件要求微調，不用整個流程重來），再用一兩句話說明重繪了幾個圖層、跟原圖比對起來哪裡是精確對應、哪裡是用最接近的基本形狀近似（呼應階段3note欄位的內容），不要長篇大論。\n\n## 微調情境（使用者事後反饋「某個物件位置/顏色/大小不對」）\n不用整個流程重跑——直接依使用者描述修改YAML裡對應物件的欄位，重新跑一次階段4（組SVG＋render_drawing），階段5只需要簡短確認改了什麼。'}],WHISPER_MODEL_ID="onnx-community/whisper-base",WHISPER_DTYPE="q8",WHISPER_WASM_THREADS=4,WHISPER_CHUNK_LENGTH_S=30,WHISPER_STRIDE_LENGTH_S=5,WHISPER_SAMPLE_RATE=16e3,WHISPER_MODEL_ID_PATH="onnx-community/whisper-base",WHISPER_HF_RESOLVE_BASE="https://huggingface.co/"+WHISPER_MODEL_ID_PATH+"/resolve/main/",WHISPER_MODEL_BACKUP_FILES=["config.json","preprocessor_config.json","tokenizer_config.json","tokenizer.json","generation_config.json","onnx/encoder_model_quantized.onnx","onnx/decoder_model_merged_quantized.onnx"],WHISPER_MODEL_BACKUP_PART_SIZE=20971520,TTS_MODEL_ID="onnx-community/Kokoro-82M-v1.0-ONNX",TTS_DTYPE="q8",TTS_SAMPLE_RATE=24e3,TTS_DEFAULT_VOICE="af_heart",TTS_MAX_CHARS_PER_CHUNK=400,TTS_VOICES=[{id:"af_heart",name:"Heart",lang:"美式英文",gender:"女",engine:"local"},{id:"af_alloy",name:"Alloy",lang:"美式英文",gender:"女",engine:"local"},{id:"af_aoede",name:"Aoede",lang:"美式英文",gender:"女",engine:"local"},{id:"af_bella",name:"Bella",lang:"美式英文",gender:"女",engine:"local"},{id:"af_jessica",name:"Jessica",lang:"美式英文",gender:"女",engine:"local"},{id:"af_kore",name:"Kore",lang:"美式英文",gender:"女",engine:"local"},{id:"af_nicole",name:"Nicole",lang:"美式英文",gender:"女",engine:"local"},{id:"af_nova",name:"Nova",lang:"美式英文",gender:"女",engine:"local"},{id:"af_river",name:"River",lang:"美式英文",gender:"女",engine:"local"},{id:"af_sarah",name:"Sarah",lang:"美式英文",gender:"女",engine:"local"},{id:"af_sky",name:"Sky",lang:"美式英文",gender:"女",engine:"local"},{id:"am_adam",name:"Adam",lang:"美式英文",gender:"男",engine:"local"},{id:"am_echo",name:"Echo",lang:"美式英文",gender:"男",engine:"local"},{id:"am_eric",name:"Eric",lang:"美式英文",gender:"男",engine:"local"},{id:"am_fenrir",name:"Fenrir",lang:"美式英文",gender:"男",engine:"local"},{id:"am_liam",name:"Liam",lang:"美式英文",gender:"男",engine:"local"},{id:"am_michael",name:"Michael",lang:"美式英文",gender:"男",engine:"local"},{id:"am_onyx",name:"Onyx",lang:"美式英文",gender:"男",engine:"local"},{id:"am_puck",name:"Puck",lang:"美式英文",gender:"男",engine:"local"},{id:"am_santa",name:"Santa",lang:"美式英文",gender:"男",engine:"local"},{id:"bf_alice",name:"Alice",lang:"英式英文",gender:"女",engine:"local"},{id:"bf_emma",name:"Emma",lang:"英式英文",gender:"女",engine:"local"},{id:"bf_isabella",name:"Isabella",lang:"英式英文",gender:"女",engine:"local"},{id:"bf_lily",name:"Lily",lang:"英式英文",gender:"女",engine:"local"},{id:"bm_daniel",name:"Daniel",lang:"英式英文",gender:"