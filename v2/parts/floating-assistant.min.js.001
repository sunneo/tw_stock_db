   muxer.finalize();\n              if (!disk) { resolve({ blob: new Blob([muxer.target.buffer], { type: 'video/mp4' }), audioDropped: !!(audioIn && !audioPick), streamed: false }); return null; }\n              return disk.writable.close().then(function () { return disk.handle.getFile(); }).then(function (file) {\n                resolve({ blob: file, audioDropped: !!(audioIn && !audioPick), streamed: true, cleanup: function () { return disk.dir.removeEntry(disk.name).catch(function () {}); } });\n              });\n            }).catch(fail);\n            return;\n          }\n\n          // Basic backpressure -- don't queue unboundedly many frames ahead of the encoder if it's falling behind.\n          if (encoder.encodeQueueSize > 4) { setTimeout(encodeNext, 10); return; }\n\n          try {\n            frameCallback(i);\n            var frame = new VideoFrame(canvas, { timestamp: i * frameDurationUs, duration: frameDurationUs });\n            encoder.encode(frame, { keyFrame: i % keyFrameEveryNFrames === 0 });\n            frame.close();\n          } catch (e) { fail(e); return; }\n\n          if (onProgress) { onProgress(i + 1, totalFrames); }\n          i++;\n          if (feeder) {\n            // keep the audio about a second ahead of the video so the two tracks are interleaved in the file\n            feeder.feedUntil(Math.round(((i / fps) + 1) * audioIn.sampleRate)).then(function () { setTimeout(encodeNext, 0); }, fail);\n          } else { setTimeout(encodeNext, 0); }\n        }\n\n        encodeNext();\n      });\n    });\n  }\n\n  // ---------------------------------------------------- export options dialog\n  //\n  // A small, self-contained modal (native confirm()/prompt() can't take two\n  // fields at once) -- reuses the SAME .ai-chat-dialog-overlay/.ai-chat-dialog\n  // CSS classes the skill/function/RAG admin dialogs already use (see\n  // ai_chat.js/ai_chat.css), but is built entirely dynamically here rather\n  // than depending on any static markup in index.html.erb or on the AiChat\n  // instance's own openDialog/closeDialog methods -- this file has no\n  // dependency on ai_chat.js at all, only shares its CSS class names for a\n  // visually consistent look.\n  // 匯出選項視窗用的樣式：這些 class 原本由 Redmine 那邊的 CSS 提供，這個專案裡沒有，視窗會變成沒樣式的表單掉在頁面最下面。\n  // 這裡自帶一份（只注入一次），視窗置中、蓋在所有東西上面。\n  function ensureDialogStyle() {\n    if (document.getElementById('dk-dialog-style')) { return; }\n    var s = document.createElement('style'); s.id = 'dk-dialog-style';\n    s.textContent = '.ai-chat-dialog-overlay{position:fixed;inset:0;z-index:2147483000;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;padding:16px;box-sizing:border-box}'\n      + '.ai-chat-dialog{width:min(420px,100%);max-height:90vh;overflow:auto;background:#fff;color:#222;border-radius:12px;padding:18px 20px;box-shadow:0 12px 40px rgba(0,0,0,.45);font:14px/1.5 sans-serif;box-sizing:border-box}'\n      + '.ai-chat-dialog h3{margin:0 0 12px;font-size:17px;color:#222}'\n      + '.ai-chat-dialog select,.ai-chat-dialog input[type=number]{padding:6px 8px;border:1px solid #bbb;border-radius:6px;background:#fff;color:#222;box-sizing:border-box;font:inherit}'\n      + '.ai-chat-dialog .block{display:block}'\n      + '.ai-chat-dialog-actions{display:flex;gap:8px;margin-top:14px}.ai-chat-dialog-actions-spacer{flex:1}'\n      + '.ai-chat-dialog-actions button{padding:6px 16px;border-radius:6px;border:1px solid #bbb;background:#f3f3f3;color:#222;cursor:pointer;font:inherit}'\n      + '.ai-chat-dialog-actions button:last-child{background:#76b900;border-color:#76b900;color:#fff;font-weight:bold}';\n    document.head.appendChild(s);\n  }\n  function showMp4ExportOptionsDialog(defaults) {\n    defaults = defaults || {};\n    return new Promise(function (resolve) {\n      ensureDialogStyle();\n      var overlay = document.createElement('div');\n      overlay.className = 'ai-chat-dialog-overlay';\n\n      var dialog = document.createElement('div');\n      dialog.className = 'ai-chat-dialog';\n      dialog.innerHTML =\n        '<h3>匯出MP4影片</h3>' +\n        '<div style=\"margin-bottom:0.8em;\">' +\n        '<label class=\"block\">秒數（至少1秒，無上限）<br>' +\n        '<input type=\"number\" class=\"ai-chat-mp4dlg-duration\" min=\"1\" step=\"1\" style=\"width:100%;\"></label>' +\n        '</div>' +\n        '<div style=\"margin-bottom:0.8em;\">' +\n        '<label class=\"block\">播放速度（0.1x ~ 4.0x）<br>' +\n        '<input type=\"number\" class=\"ai-chat-mp4dlg-speed\" min=\"0.1\" max=\"4\" step=\"0.1\" style=\"width:100%;\"></label>' +\n        '</div>' +\n        '<div class=\"ai-chat-dialog-actions\">' +\n        '<span class=\"ai-chat-dialog-actions-spacer\"></span>' +\n        '<button type=\"button\" class=\"ai-chat-mp4dlg-cancel\">取消</button>' +\n        '<button type=\"button\" class=\"ai-chat-mp4dlg-confirm\">匯出</button>' +\n        '</div>';\n      overlay.appendChild(dialog);\n      document.body.appendChild(overlay);\n\n      var durationInput = dialog.querySelector('.ai-chat-mp4dlg-duration');\n      var speedInput = dialog.querySelector('.ai-chat-mp4dlg-speed');\n      durationInput.value = Number.isFinite(defaults.durationSeconds) ? defaults.durationSeconds : 5;\n      speedInput.value = Number.isFinite(defaults.speed) ? defaults.speed : 1;\n\n      function close(result) {\n        document.body.removeChild(overlay);\n        resolve(result);\n      }\n\n      overlay.addEventListener('click', function (e) { if (e.target === overlay) { close(null); } });\n      dialog.querySelector('.ai-chat-mp4dlg-cancel').addEventListener('click', function () { close(null); });\n      dialog.querySelector('.ai-chat-mp4dlg-confirm').addEventListener('click', function () {\n        var durationSeconds = Math.max(1, parseFloat(durationInput.value) || 5);\n        var speed = Math.max(0.1, Math.min(4, parseFloat(speedInput.value) || 1));\n        close({ durationSeconds: durationSeconds, speed: speed });\n      });\n    });\n  }\n\n  window.AiChatVideoExport = {\n    encodeCanvasFramesToMp4: encodeCanvasFramesToMp4,\n    showMp4ExportOptionsDialog: showMp4ExportOptionsDialog\n  };\n})(window);\n",rpg_art:"/* 簡報的程序化圖片（不需要圖檔）：像素風地圖、會走路會轉向的人物、半身像（頭像）、背景、落花；加上 RPG 式的對話框與電影字幕。\n * 簡報的 collage 物件直接用它們：項目的 src 寫成\n *     map:<地圖>      像素地圖（house_interior 屋內／village 村莊／peach_orchard 桃園），鋪滿舞台，16×9 格\n *     actor:<人物>    像素小人（預設外觀名稱或自訂的 look），4 個方向、走路兩步；站在格子或座標的底邊中央\n *     bust:<人物>     半身像（向量，會眨眼、說話時嘴巴開合），大張劇情畫面與頭像用\n *     cg:<背景>       大張劇情畫面的背景（peach_oath 桃園黃昏、dusk_hall 暮色大廳），鋪滿舞台\n *     fx:petals       飄落的花瓣（鋪滿舞台）\n * 這些都是 collage 項目：位置、出現時間、keys 移動、say 台詞、scene、camera、sounds 全部沿用 collage 的設計（見 deck_core.js）。\n * 純函式（UMD），沒有相依；畫在 canvas 2D。\n */\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatDeckRpgArt = factory(); }\n})(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n\n  var COLS = 16, ROWS = 9;\n  var FONT = '\"Noto Sans TC\",\"Microsoft JhengHei\",\"PingFang TC\",\"Heiti TC\",sans-serif';\n  var MAP_NAMES = ['house_interior', 'village', 'peach_orchard'];\n  var CG_NAMES = ['peach_oath', 'dusk_hall'];\n  var FX_NAMES = ['petals'];\n  var FACES = ['down', 'up', 'left', 'right'];\n\n  // ---------------------------------------------------------------- 人物外觀（封閉字彙）\n  var SKIN = { fair: '#F3CFA8', tan: '#DDA878', dark: '#8E5B3B', red: '#C65A43' };\n  var HAIR = { black: '#1E1B26', gray: '#A5A5AE', brown: '#5E3B1F', white: '#EFEFEF' };\n  var ROBE = { green: '#3C8A55', red: '#B8382F', blue: '#3A63B5', black: '#2B2B35', brown: '#8A5A30', gray: '#80808A', yellow: '#D4A82C', white: '#E8E4D8' };\n  var HAIR_STYLES = ['topknot', 'long', 'short', 'bun', 'wild'];\n  var BEARDS = ['none', 'short', 'long', 'bushy'];\n  var HEADGEAR = ['none', 'headband', 'hat'];\n  var PRESETS = {\n    liu_bei: { name: '劉備', skin: 'fair', hair: 'black', hairStyle: 'topknot', beard: 'none', robe: 'blue', head: 'none' },\n    guan_yu: { name: '關羽', skin: 'red', hair: 'black', hairStyle: 'topknot', beard: 'long', robe: 'green', head: 'none' },\n    zhang_fei: { name: '張飛', skin: 'dark', hair: 'black', hairStyle: 'wild', beard: 'bushy', robe: 'black', head: 'headband' },\n    mother: { name: '母親', skin: 'fair', hair: 'gray', hairStyle: 'bun', beard: 'none', robe: 'brown', head: 'none' },\n    villager_m: { name: '村民', skin: 'tan', hair: 'brown', hairStyle: 'short', beard: 'none', robe: 'gray', head: 'none' },\n    villager_f: { name: '村婦', skin: 'fair', hair: 'brown', hairStyle: 'long', beard: 'none', robe: 'red', head: 'none' },\n    elder: { name: '老者', skin: 'fair', hair: 'white', hairStyle: 'short', beard: 'long', robe: 'white', head: 'none' },\n    soldier: { name: '士兵', skin: 'tan', hair: 'black', hairStyle: 'short', beard: 'short', robe: 'red', head: 'hat' },\n    child: { name: '孩子', skin: 'fair', hair: 'black', hairStyle: 'bun', beard: 'none', robe: 'yellow', head: 'none', kid: true }\n  };\n  var PRESET_NAMES = Object.keys(PRESETS);\n  // the default voice (blips of the dialogue box) of each drawn character; see VOICES in deck_core.js\n  var VOICE_OF = { liu_bei: 'calm', guan_yu: 'deep', zhang_fei: 'rough', mother: 'old_woman', villager_m: 'young', villager_f: 'young', elder: 'elder', soldier: 'deep', child: 'child' };\n\n  function isObj(x) { return x && typeof x === 'object' && !Array.isArray(x); }\n  function str(x) { return typeof x === 'string' ? x : ''; }\n  function clamp(x, a, b) { return Math.max(a, Math.min(b, x)); }\n  function ease(p) { p = clamp(p, 0, 1); return p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2; }\n  function hash(a, b) { var h = (a * 374761393 + b * 668265263) | 0; h = (h ^ (h >>> 13)) * 1274126177 | 0; return ((h ^ (h >>> 16)) >>> 0) / 4294967295; }\n  function shade(hex, f) { // f<1 darker, f>1 lighter\n    var n = parseInt(String(hex).replace('#', ''), 16), r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;\n    var m = function (c) { return Math.round(clamp(f < 1 ? c * f : c + (255 - c) * (f - 1), 0, 255)); };\n    return 'rgb(' + m(r) + ',' + m(g) + ',' + m(b) + ')';\n  }\n\n  // ---------------------------------------------------------------- 地圖（16×9 格；地面＋物件＋錨點）\n  // 地面碼：. 草 , 土路 f 木地板 W 牆面 k 地毯 w 水 v 落花\n  function rows(list) { return list.map(function (r) { return r.split(''); }); }\n  var MAPS = {\n    house_interior: {\n      label: '屋內', sky: '#3A2A1E',\n      ground: rows(['WWWWWWWWWWWWWWWW', 'WWWWWWWWWWWWWWWW', 'ffffffffffffffff', 'ffffffffffffffff', 'ffffkkkkkkffffff', 'ffffkkkkkkffffff', 'ffffkkkkkkffffff', 'ffffffffffffffff', 'fffffffffffffffd'.replace(/d$/, 'f')]),\n      doorTiles: [[7, 8], [8, 8]],\n      objects: [{ k: 'window', x: 3, y: 1 }, { k: 'window', x: 11, y: 1 }, { k: 'bed', x: 1, y: 3 }, { k: 'table', x: 10, y: 4 }, { k: 'pot', x: 13, y: 3 }, { k: 'shelf', x: 6, y: 2 }],\n      anchors: { door: [7, 8], center: [7, 5], bed: [2, 5], table: [9, 5], mother: [6, 4], left: [4, 5], right: [11, 5] }\n    },\n    village: {\n      label: '村莊', sky: '#7FC4E8',\n      ground: rows(['................', '................', '................', '.......,,.......', '.......,,.......', ',,,,,,,,,,,,,,,,', ',,,,,,,,,,,,,,,,', '................', '..........F.....']),\n      objects: [{ k: 'house', x: 1, y: 1 }, { k: 'house', x: 10, y: 1 }, { k: 'tree', x: 0, y: 2 }, { k: 'tree', x: 15, y: 3 }, { k: 'tree', x: 6, y: 2 }, { k: 'well', x: 8, y: 2 }, { k: 'fence', x: 4, y: 7 }, { k: 'fence', x: 11, y: 7 }, { k: 'tree', x: 2, y: 8 }, { k: 'tree', x: 13, y: 8 }],\n      anchors: { home_door: [3, 4], door: [3, 4], zhang_door: [12, 4], center: [8, 5], west: [2, 5], east: [13, 5], well: [8, 4], exit_east: [15, 5], exit_west: [0, 5], left: [5, 5], right: [10, 5] }\n    },\n    peach_orchard: {\n      label: '桃園', sky: '#F4C7D4',\n      ground: rows(['vv..vv..vv..vv..', '..vv..vv..vv..vv', '................', '................', '................', ',,,,,,,,,,v.....', '.,,,,,,,,,,,,,..', '..vv..vv..vv..vv', 'vv..vv..vv..vv..']),\n      objects: [{ k: 'peach', x: 1, y: 1 }, { k: 'peach', x: 4, y: 0 }, { k: 'peach', x: 7, y: 1 }, { k: 'peach', x: 14, y: 1 }, { k: 'peach', x: 0, y: 4 }, { k: 'peach', x: 3, y: 8 }, { k: 'peach', x: 14, y: 8 }, { k: 'bigpeach', x: 11, y: 4 }],\n      anchors: { entry: [0, 5], center: [7, 5], tree: [11, 5], tree_left: [9, 5], tree_mid: [11, 5], tree_right: [13, 5], left: [4, 5], right: [12, 5] }\n    }\n  };\n  function anchorOf(map, name) { var m = MAPS[map]; return m && m.anchors[name] ? m.anchors[name] : null; }\n  function resolvePoint(map, p) {\n    if (typeof p === 'string') { return anchorOf(map, p); }\n    if (Array.isArray(p) && p.length === 2 && typeof p[0] === 'number' && typeof p[1] === 'number') { return [p[0], p[1]]; }\n    return null;\n  }\n\n  function lookOf(def) {\n    var base = PRESETS[def && def.preset] || {}, o = {}, k;\n    for (k in base) { o[k] = base[k]; }\n    if (def && isObj(def.look)) { for (k in def.look) { o[k] = def.look[k]; } }\n    if (def && def.name) { o.name = def.name; }\n    o.skin = SKIN[o.skin] ? o.skin : 'fair'; o.hair = HAIR[o.hair] ? o.hair : 'black'; o.robe = ROBE[o.robe] ? o.robe : 'gray';\n    o.hairStyle = HAIR_STYLES.indexOf(o.hairStyle) >= 0 ? o.hairStyle : 'short'; o.beard = BEARDS.indexOf(o.beard) >= 0 ? o.beard : 'none'; o.head = HEADGEAR.indexOf(o.head) >= 0 ? o.head : 'none';\n    o.name = o.name || '';\n    return o;\n  }\n\n  // ---------------------------------------------------------------- 繪製：地圖\n  function R(ctx, x, y, w, h, col) { ctx.fillStyle = col; ctx.fillRect(x, y, w, h); }\n  function drawGround(ctx, mapName, ox, oy, T) {\n    var m = MAPS[mapName], g = m.ground, px = T / 8;\n    for (var y = 0; y < ROWS; y++) {\n      for (var x = 0; x < COLS; x++) {\n        var ch = g[y][x], X = ox + x * T, Y = oy + y * T, h = hash(x, y), h2 = hash(x + 31, y + 17);\n        if (ch === '.' || ch === 'v' || ch === 'F') {\n          R(ctx, X, Y, T + 1, T + 1, h < 0.5 ? 