g * dg + db * db) > tol ? 1 : 0;\n    }\n    for (var pass = 0; pass < (opts.passes == null ? 2 : opts.passes); pass++) {\n      var nx = new Uint8Array(n);\n      for (y = 0; y < h; y++) {\n        for (x = 0; x < w; x++) {\n          var c = 0, t = 0;\n          for (var dy = -1; dy <= 1; dy++) { for (var dx = -1; dx <= 1; dx++) { var yy = y + dy, xx = x + dx; if (yy >= 0 && yy < h && xx >= 0 && xx < w) { t++; c += m[yy * w + xx]; } } }\n          nx[y * w + x] = c * 2 > t ? 1 : 0;\n        }\n      }\n      m = nx;\n    }\n    var fg = 0; for (i = 0; i < n; i++) { fg += m[i]; }\n    return { mask: m, fg: fg / n, tol: tol };\n  }\n\n  // ---------- panorama / orbit photos -> near-and-far layered model for VR ----------\n  // A panorama is seen from the inside, so its depth bands (far / middle / near) are bent onto a cylinder around the viewer: each band is still a closed solid\n  // (bending moves vertices only, the faces stay the same), far bands sit at a bigger radius, near bands closer. Output goes through toSpec like any other scene.\n  function signedVolume(mesh) {\n    var V = mesh.vertices, vol = 0;\n    mesh.faces.forEach(function (f) { var a = V[f[0]], b = V[f[1]], c = V[f[2]]; vol += (a[0] * (b[1] * c[2] - b[2] * c[1]) - a[1] * (b[0] * c[2] - b[2] * c[0]) + a[2] * (b[0] * c[1] - b[1] * c[0])) / 6; });\n    return vol;\n  }\n  // scene coordinates (x 0..xSpan, y 0..ySpan, z toward the viewer) -> a cylinder of radius R around the origin; fovRad = the horizontal angle the picture covers (2*PI for a full panorama)\n  function bendCylinder(mesh, o) {\n    var fov = o.fovRad || 2 * Math.PI, R = o.radius || 5, xs = o.xSpan || 1, ys = o.ySpan || 0.5, eye = o.eye == null ? 1.6 : o.eye, zk = o.zK || 1.33, rminF = 0.2;\n    var out = { vertices: mesh.vertices.map(function (v) {\n      var th = (v[0] / xs - 0.5) * fov, r = Math.max(R * rminF, R * (1 - zk * v[2])), yy = (v[1] - ys / 2) * R * fov / xs * (xs / xs) + eye;\n      return [Math.round(r * Math.sin(th) * 1e4) / 1e4, Math.round(yy * 1e4) / 1e4, Math.round(-r * Math.cos(th) * 1e4) / 1e4];\n    }), faces: mesh.faces.map(function (f) { return f.slice(); }) };\n    if (signedVolume(out) < 0) { out.faces = out.faces.map(function (f) { return [f[0], f[2], f[1]]; }); }\n    return out;\n  }\n  // several photos' depth maps [{w,h,data}] (already in left-to-right order) -> one strip {w,h,data}: each map is scaled to 0..1 on its own (depth models give relative depth, so this is only approximate), resampled to a common height, laid side by side\n  function stitchDepths(list, opts) {\n    opts = opts || {};\n    var H = opts.height || Math.min.apply(null, list.map(function (d) { return d.h; })), cols = [], W = 0;\n    list.forEach(function (d) {\n      var mn = Infinity, mx = -Infinity, i; for (i = 0; i < d.data.length; i++) { if (d.data[i] < mn) { mn = d.data[i]; } if (d.data[i] > mx) { mx = d.data[i]; } }\n      var rg = mx - mn, w = Math.max(2, Math.round(d.w * H / d.h)), g = resampleGrid(d.data, d.w, d.h, w, H);\n      cols.push({ w: w, g: g.map(function (r) { return r.map(function (v) { return rg > EPS ? (v - mn) / rg : 0.5; }); }) }); W += w;\n    });\n    var data = new Float32Array(W * H), x0 = 0;\n    cols.forEach(function (c) { for (var y = 0; y < H; y++) { for (var x = 0; x < c.w; x++) { data[y * W + x0 + x] = c.g[y][x]; } } x0 += c.w; });\n    return { w: W, h: H, data: data };\n  }\n  // how wide a field of view a strip covers: a ~2:1 picture is taken as a full 360 degree equirectangular panorama, otherwise about 45 degrees per unit of aspect ratio\n  function panoFov(aspect) { return Math.abs(aspect - 2) < 0.2 ? 360 : Math.min(360, Math.max(60, Math.round(aspect * 45))); }\n  // depth rows -> band labels 1..n (1 = farthest) by quantile of the depth values\n  function depthBands(depth, n) {\n    var vals = [], y, x; for (y = 0; y < depth.length; y++) { for (x = 0; x < depth[y].length; x++) { vals.push(depth[y][x]); } }\n    vals.sort(function (a, b) { return a - b; });\n    var cuts = []; for (var i = 1; i < n; i++) { cuts.push(vals[Math.min(vals.length - 1, Math.floor(vals.length * i / n))]); }\n    return depth.map(function (r) { return r.map(function (v) { var b = 1; for (var k = 0; k < cuts.length; k++) { if (v >= cuts[k]) { b = k + 2; } } return b; }); });\n  }\n  // depth {w,h,data} (the whole panorama strip) -> { objects:[{id, mesh, shape, ...}], background:null, panorama:true }\n  function buildPanorama(depth, opts) {\n    opts = opts || {};\n    var longest = Math.max(depth.w, depth.h), k = Math.min(1, (opts.workMax || 160) / longest), w = Math.max(4, Math.round(depth.w * k)), h = Math.max(2, Math.round(depth.h * k));\n    var dep = resampleGrid(depth.data, depth.w, depth.h, w, h), labels = depthBands(dep, opts.bands || 3);\n    var sc = buildScene({ labels: labels, depth: dep }, { shape: 'blocks', closeMode: 'objects', maxFaces: opts.maxFaces || 12000 });\n    var maxdim = Math.max(w, h), bend = { fovRad: (opts.fovDeg || 360) * Math.PI / 180, radius: opts.radius || 5, xSpan: w / maxdim, ySpan: h / maxdim, eye: opts.eye == null ? 1.6 : opts.eye };\n    sc.objects.forEach(function (o) { o.mesh = bendCylinder(o.mesh, bend); o.name = ['遠景', '中景', '近景', '最近景', '最近景2', '最近景3'][o.id - 1] || ('層' + o.id); });\n    sc.background = null; sc.panorama = true; sc.pano = bend; return sc;\n  }\n\n  // ---------- EXIF (JPEG APP1): GPS position, heading, camera model; just enough to tell whether photos turn around a spot ----------\n  // buf: ArrayBuffer/Uint8Array of a JPEG -> { lat, lon, heading, make } (fields missing when absent) | null\n  function readExif(buf) {\n    var u = buf instanceof Uint8Array ? buf : new Uint8Array(buf), dv = new DataView(u.buffer, u.byteOffset, u.byteLength), p = 2;\n    if (u.length < 12 || dv.getUint16(0) !== 0xFFD8) { return null; }\n    while (p + 4 < u.length) {\n      var mk = dv.getUint16(p), len = dv.getUint16(p + 2);\n      if (mk === 0xFFE1 && String.fromCharCode(u[p + 4], u[p + 5], u[p + 6], u[p + 7]) === 'Exif') { return parseTiff(dv, p + 10); }\n      if (mk === 0xFFDA || (mk & 0xFF00) !== 0xFF00) { break; }\n      p += 2 + len;\n    }\n    return null;\n  }\n  function parseTiff(dv, t) {\n    var le = dv.getUint16(t) === 0x4949, g16 = function (o) { return dv.getUint16(o, le); }, g32 = function (o) { return dv.getUint32(o, le); };\n    var TS = { 1: 1, 2: 1, 3: 2, 4: 4, 5: 8, 7: 1, 9: 4, 10: 8 };\n    function entries(off) { var n = g16(t + off), out = {}; for (var i = 0; i < n; i++) { var e = t + off + 2 + i * 12; out[g16(e)] = { type: g16(e + 2), count: g32(e + 4), at: e + 8 }; } return out; }\n    function valAt(e) { var sz = (TS[e.type] || 1) * e.count; return sz <= 4 ? e.at : t + g32(e.at); }\n    function str(e) { var o = valAt(e), s = ''; for (var i = 0; i < e.count - 1; i++) { s += String.fromCharCode(dv.getUint8(o + i)); } return s; }\n    function rats(e) { var o = valAt(e), r = []; for (var i = 0; i < e.count; i++) { var d = g32(o + i * 8 + 4); r.push(d ? g32(o + i * 8) / d : 0); } return r; }\n    try {\n      var ifd0 = entries(g32(t + 4)), out = {};\n      if (ifd0[0x010F]) { out.make = str(ifd0[0x010F]); }\n      if (ifd0[0x8825]) {\n        var gps = entries(g32(ifd0[0x8825].at)), lat = gps[2] && rats(gps[2]), lon = gps[4] && rats(gps[4]);\n        if (lat && lon && gps[1] && gps[3]) {\n          out.lat = (lat[0] + lat[1] / 60 + lat[2] / 3600) * (str(gps[1]) === 'S' ? -1 : 1); out.lon = (lon[0] + lon[1] / 60 + lon[2] / 3600) * (str(gps[3]) === 'W' ? -1 : 1);\n        }\n        if (gps[17]) { out.heading = rats(gps[17])[0]; }\n      }\n      return out;\n    } catch (e) { return null; }\n  }\n  // shots: [{lat, lon, heading}] (one per photo, in the order given). 'outward' = the photos are taken from about one spot while turning (headings spread over >= 240 degrees, positions within `spotM` metres):\n  // they can be laid side by side as one panorama, ordered by heading. 'inward' = positions go around a centre (not handled: needs a reconstruction we do not have). 'unknown' otherwise.\n  function orbitKind(shots, opts) {\n    opts = opts || {};\n    var s = (shots || []).filter(function (x) { return x && isFinite(x.heading); });\n    if (s.length < 3) { return { kind: 'unknown', reason: '至少要三張有方向資料的照片' }; }\n    var gps = s.filter(function (x) { return isFinite(x.lat) && isFinite(x.lon); }), spot = opts.spotM || 25, spread = 0;\n    var hs = s.map(function (x) { return ((x.heading % 360) + 360) % 360; }).sort(function (a, b) { return a - b; }), maxGap = 0;\n    for (var i = 0; i < hs.length; i++) { var gap = (i === hs.length - 1 ? hs[0] + 360 : hs[i + 1]) - hs[i]; if (gap > maxGap) { maxGap = gap; } }\n    var cover = 360 - maxGap;\n    if (gps.length >= 3) {\n      var la = gps.reduce(function (a, x) { return a + x.lat; }, 0) / gps.length, lo = gps.reduce(function (a, x) { return a + x.lon; }, 0) / gps.length;\n      gps.forEach(function (x) { var dy = (x.lat - la) * 111320, dx = (x.lon - lo) * 111320 * Math.cos(la * Math.PI / 180); spread = Math.max(spread, Math.sqrt(dx * dx + dy * dy)); });\n    }\n    if (cover >= 240 && spread <= spot) { return { kind: 'outward', coverDeg: Math.round(cover), spreadM: Math.round(spread * 10) / 10, order: s.map(function (x, i) { return i; }).sort(function (a, b) { return (((s[a].heading % 360) + 360) % 360) - (((s[b].heading % 360) + 360) % 360); }) }; }\n    if (spread > spot && cover >= 180) { return { kind: 'inward', coverDeg: Math.round(cover), spreadM: Math.round(spread * 10) / 10 }; }\n    return { kind: 'unknown', coverDeg: Math.round(cover), spreadM: Math.round(spread * 10) / 10 };\n  }\n\n  // a scene's objects (not the backdrop) merged into ONE mesh with front-projected texture coordinates -> { vertices, faces, uvs } | null; every object is closed, so the merge is closed too\n  function subjectMesh(scene) {\n    var vs = [], fs = [], uvs = [], md = Math.max(scene.width || 1, scene.height || 1), W = scene.width || md, H = scene.height || md;\n    (scene.objects || []).forEach(function (o) {\n      var base = vs.length;\n      o.mesh.vertices.forEach(function (v) { vs.push([v[0], v[1], v[2]]); uvs.push([Math.round(Math.max(0, Math.min(1, v[0] * md / W)) * 10000) / 10000, Math.round(Math.max(0, Math.min(1, v[1] * md / H)) * 10000) / 10000]); });\n      o.mesh.faces.forEach(function (f) { fs.push([f[0] + base, f[1] + base, f[2] + base]); });\n    });\n    return vs.length ? { vertices: vs, faces: fs, uvs: uvs } : null;\n  }\n\n  // ---------- subject only: the user wants ONE thing out of the picture (a coffee cup on a table -> just the cup, to be put on a table in a scene) ----------\n  var GENERIC_NAME = /^(?:這張|那張|這幅|這個|那個|這些|這|那|它|牠|他|圖片?|照片|相片|主體|主角|物體|東西|物件|前景|整張.*|全部.*|場景|模型|3d.*|三維.*)$/i;\n  function cleanName(s) {\n    s = String(s == null ? '' : s).trim().replace(/^[「\"'『《“]+|[」\"'』》”]+$/g, '').trim();\n    s = s.replace(/(?:的)(?:圖片|照片|相片|圖|模型|物件)$/, '').replace(/(?:照片|相片|圖片)$/, '');\n    s = s.replace(/^(?:這張|那張|這幅)?(?:圖片|照片|相片|圖)(?:裡面|裡|裏|中|上)?的?/, '').replace(/^(?:一個|一隻|一顆|一只|一杯|一台|一張|一把|一棵|一條|一件|一盞|一支|這個|那個|這隻|那隻|1個|a\\s+|an\\s+|the\\s+)/i, '').replace(/^的/, '').trim();\n    return GENERIC_NAME.test(s) ? '' : s;\n  }\n  function cleanTarget(s) { return String(s == null ? '' : s).trim().replace(/^[「\"'『《“]+|[」\"'』》”]+$/g, '').replace(/(?:模組|模型|物件)$/, '').replace(/^(?:那個|這個|那張|這張|一個|一張|the\\s+|a\\s+)/i, '').trim(); }\n  // text -> { subject:'main'|'all', name:'', target:'', decided:bool, source:'flag'|'phrase'|'default'|'hint' }\n  // 'main' = only the subject (name = what it is, when the words say so); decided:false = the words hint at it but the program cannot tell -> ask the model one closed question (intentQuestion / intentFromPick)\n  function subjectIntent(text) {\n    var r = subjectIntent0(text), m;\n    if (r.subject === 'main' && !r.target && (m = /(?:擺放|放置|擺|放)(?:到|在|進|於)\\s*(.+?)(?:上面|上方|上|裡面|裡|旁邊|旁)(?=[，。,.！!？?；;\\s]|$)/.exec(String(text || '')))) { r.target = cleanTarget(m[1]); }\n    return r;\n  }\n  function subjectIntent0(text) {\n    var t = String(text || '').replace(/\\[附件：[^\\]]*\\]/g, ' '), m, name = '', target = '';\n    if ((m = /--subject[=\\s]+(?:\"([^\"]+)\"|'([^']+)'|([^\\s]+))/i.exec(t))) {\n      var v = (m[1] || m[2] || m[3] || '').trim();\n      if (/^(?:all|全部|整張)$/i.test(v)) { return { subject: 'all', name: '', target: '', decided: true, source: 'flag' }; }\n      return { subject: 'main', name: /^(?:main|主體|auto|自動)$/i.test(v) ? '' : cleanName(v), target: '', decided: true, source: 'flag' };\n    }\n    if (/背景也要|含背景|連背景|包含背景|帶背景|整個場景|整張場景|whole\\s+scene|with\\s+(?:the\\s+)?background/i.test(t)) { return { subject: 'all', name: '', target: '', decided: true, source: 'phrase' }; }\n    // 「把 X 擺到 Y 上」\n    if ((m = /(?:把|將|拿)\\s*(.+?)\\s*(?:要|想要|想|可以|能)?\\s*(?:再)?(?:擺放|放置|擺|放|貼|搬|移)(?:到|在|進|入|於|去)\\s*(.+?)(?:上面|上方|上|裡面|裡|旁邊|旁|前面|前|內)(?=[，。,.！!？?；;\\s]|$)/.exec(t))) {\n      name = cleanName(m[1]); target = cleanTarget(m[2]);\n      if (name) { return { subject: 'main', name: name, target: target, decided: true, source: 'phrase' }; }\n      return { subject: 'main', name: '', target: target, decided: false, source: 'hint' };\n    }\n    // 「把／將 X 變成 3D」「X 轉成立體」：X 就是主體（南瓜燈照片 → 只切出南瓜燈）；「這張圖」之類的泛稱不算\n    if ((m = /(?:把|將)\\s*(.+?)\\s*(?:變成|轉成|做成|作成|製成|轉為|變為|轉換成|轉)\\s*(?:成)?\\s*(?:3d|三維|立體)/i.exec(t)) && (name = cleanName(m[1])) && !/[和與跟及、,，]|\band\b/.test(name)) { return { subject: 'main', name: name, target: '', decided: true, source: 'phrase' }; }\n    // 「只要／只想要／只放 X」\n    if ((m = /只(?:想要|需要|要|想放|放|留|保留|(?:取|切|剪|摳|挖|分|抓|扣|抽|拿)出|取|切|剪|摳|挖|抓|扣|拿|轉|做|作)\\s*(?:出)?(?:一個|一隻|一顆)?\\s*(.+?)(?=[，。,.！!？?；;\\n]|$|不要|就好|就可以|即可|而已|然後|並且|變成|轉成|做成|擺|放到|放在|貼|到)/.exec(t))) {\n      name = cleanName(m[1]);\n      if (name.length > 12) { return { subject: 'main', name: '', target: '', decided: false, source: 'hint' }; }\n      return { subject: 'main', name: name, target: '', decided: true, source: 'phrase' };\n    }\n    if ((m = /(?:^|[\\s,.;])only\\s+(?:want\\s+|need\\s+)?(?:the\\s+|a\\s+|an\\s+)?([a-z][a-z ]{1,30}?)(?=[,.;]|\\s+on\\b|\\s+onto\\b|\\s+in\\b|\\s+without\\b|$)/i.exec(t)) || (m = /\\bjust\\s+(?:the\\s+|a\\s+|an\\s+)([a-z][a-z ]{1,30}?)(?=[,.;]|\\s+on\\b|\\s+onto\\b|\\s+in\\b|\\s+without\\b|$)/i.exec(t))) {\n      name = cleanName(m[1]); return { subject: 'main', name: name, target: '', decided: true, source: 'phrase' };\n    }\n    if ((m = /\\b(?:put|place|set)\\s+(?:the\\s+|a\\s+|an\\s+|this\\s+)?([a-z][a-z ]{1,30}?)\\s+(?:photo\\s+|picture\\s+|image\\s+)?(?:on|onto)\\s+(?:the\\s+|a\\s+)?([a-z][a-z ]{1,30})/i.exec(t))) {\n      name = cleanName(m[1]); target = cleanTarget(m[2]); if (name) { return { subject: 'main', name: name, target: target, decided: true, source: 'phrase' }; }\n    }\n    if (/去背|(?:切|剪|摳|挖|扣|取)出(?:主體|主角|前景)|不要背景|沒有背景|無背景|不含背景|只要(?:前景|主體|主角)|只留主體|不要桌子|不要其他|其他不要|without\\s+(?:the\\s+)?background/i.test(t)) { return { subject: 'main', name: '', target: '', decided: true, source: 'phrase' }; }\n    if (/主體|主角|單一物件|只|擺到|擺在|放到|放在|放進|subject|\\bonly\\b|\\bjust\\b/i.test(t)) { return { subject: 'main', name: '', target: '', decided: false, source: 'hint' }; }\n    return { subject: 'all', name: '', target: '', decided: true, source: 'default' };\n  }\n  // the one closed question for an undecided case; the answer index goes through intentFromPick (null stays undecided -> the program keeps the default 'all')\n  function intentQuestion(text) {\n    return { question: '使用者對一張照片說：「' + String(text || '').replace(/\\[附件：[^\\]]*\\]/g, ' ').trim().slice(0, 200) + '」。他想要得到什麼？', options: ['只要照片裡的主體（一個物件，不要桌子、背景和其他東西）', '要照片裡所有的東西（含背景）'] };\n  }\n  function intentFromPick(i) { return i === 0 ? 'main' : (i === 1 ? 'all' : null); }\n  // per-candidate question for the vision model (a cropped picture of one found object): A yes / B no\n  // one picture holding the n candidates side by side, tiles labelled A, B, C…: which tile is \"name\"? (the last option = none of them)\n  function choiceQuestion(name, n) { var o = [], i; for (i = 0; i < n; i++) { o.push('小圖 ' + String.fromCharCode(65 + i)); } o.push('都不是'); return { question: '這張圖把找到的東西排成幾張小圖（左上角標了字母）。哪一張小圖裡的主要東西是「' + String(name) + '」？', options: o }; }\n  function itemQuestion(name) { return { question: '這張圖裡最主要的東西是「' + String(name) + '」嗎？', options: ['是', '不是'] }; }\n  // found objects ranked as the subject: biggest and nearest the middle first. -> [{ id, area, frac, box:[x0,y0,x1,y1] (inclusive cells), cx, cy, score }]\n  function rankSubjects(labels, w, h) {\n    var st = {}, y, x, id;\n    for (y = 0; y < h; y++) { for (x = 0; x < w; x++) { id = labels[y][x]; if (!id) { continue; } var s = st[id] || (st[id] = { id: id, area: 0, x0: x, y0: y, x1: x, y1: y, sx: 0, sy: 0 }); s.area++; s.sx += x; s.sy += y; if (x < s.x0) { s.x0 = x; } if (x > s.x1) { s.x1 = x; } if (y < s.y0) { s.y0 = y; } if (y > s.y1) { s.y1 = y; } } }\n    return Object.keys(st).map(function (k) {\n      var s = st[k], cx = s.sx / s.area, cy = s.sy / s.area, dist = Math.sqrt(Math.pow(cx / w - 0.5, 2) + Math.pow(cy / h - 0.5, 2)) / 0.7071;\n      return { id: s.id, area: s.area, frac: s.area / (w * h), box: [s.x0, s.y0, s.x1, s.y1], cx: cx, cy: cy, score: (s.area / (w * h)) * (1 - 0.8 * dist) };\n    }).sort(function (a, b) { return b.score - a.score; });\n  }\n  // keep one label as the only object (id 1), everything else becomes empty\n  function keepLabel(labels, id) { return labels.map(function (r) { return r.map(function (v) { return v === id ? 1 : 0; }); }); }\n\n  // ---------- options from the user's words (the program decides; the model is only asked when this cannot) ----------\n  // close: 'objects' (default; every found object is a closed solid, the backdrop is a thin closed slab) | 'all' (the user wants everything closed / printable: the backdrop is a full-thickness solid too)\n  function parseOptions(text) {\n    var t = String(text || ''), out = { close: 'objects', shape: 'auto', whole: false, segment: false, panorama: false, closeSource: 'default' }, m;\n    if (/--panorama(?![a-z])|全景|環景|轉圈|panorama/i.test(t)) { out.panorama = true; }\n    if (/--segment(?![a-z])|自動(?:分割|分物件)|分割模型|segment\\s+objects/i.test(t)) { out.segment = true; }\n    if ((m = /--close[=\\s]+(objects|all)(?![a-z])/i.exec(t))) { out.close = m[1].toLowerCase(); out.closeSource = 'flag'; }\n    else if (/(?:全部|所有|整個|整張|統一|每個|一律)[^，。,.\\n]{0,8}封閉|要能?(?:3d)?列印|可(?:以)?列印|print(?:able)?|watertight|everything\\s+closed|close\\s+all/i.test(t)) { out.close = 'all'; out.closeSource = 'phrase'; }\n    else if (/(?:物件|東西|蘋果|人物|人臉)[^，。,.\\n]{0,6}(?:要|得|需要)?封閉|closed\\s+objects?/i.test(t)) { out.close = 'objects'; out.closeSource = 'phrase'; }\n    if ((m = /--shape[=\\s]+(auto|cylinder|blocks|smooth)(?![a-z])/i.exec(t))) { out.shape = m[1].toLowerCase(); }\n    else if (/平滑|光滑|圓潤|smooth/i.test(t)) { out.shape = 'smooth'; }\n    else if (/圓柱|柱體|cylinder/i.test(t)) { out.shape = 'cylinder'; }\n    else if (/樂高|方塊|lego|blocks?/i.test(t)) { out.shape = 'blocks'; }\n    if (/--whole(?![a-z])|整張圖當一個|整張當一個|不要?分物件|whole\\s+image/i.test(t)) { out.whole = true; }\n    if (/--editor(?![a-z])|開編輯器/i.test(t)) { out.editor = true; }\n    out.noBackground = /--no-?background|(?:去掉|去除|拿掉|移除|刪掉|刪除|不要|不用|不需要|不含|不帶|不放|沒有|無|去)掉?[^，。,.\\n]{0,4}背景|背景(?:不要|去掉|拿掉|移除|不用)|去背|without\\s+(?:the\\s+)?background|no\\s+background/i.test(t) && !/背景也要|含背景|連背景|包含背景|帶背景/.test(t);\n    // 深度（正面凹凸的強度）與厚度（背面推測的厚度）：--depth 1.5／--thick 2（倍數），或用說的：「厚一點」「薄一點」「立體感強一點」「平一點」「厚度 2 倍」「深度 0.5 倍」\n    var clampK = function (v) { return Math.max(0.2, Math.min(4, v)); };\n    out.depthScale = 1; out.thickScale = 1;\n    // 實際尺寸（單位：公分、公釐、公尺）：「深度 10 公分」＝模型前後總深度；「高 30 公分」「寬 20cm」「大小 30 公分」（最長邊）；--depth 10cm\n    var UNIT = '(公分|厘米|釐米|cm|公釐|毫米|mm|公尺|米|m)(?![a-z])', toM = function (v, u) { v = parseFloat(v); u = String(u).toLowerCase(); return u === 'mm' || u === '公釐' || u === '毫米' ? v / 1000 : (u === 'm' || u === '公尺' || u === '米' ? v : v / 100); };\n    var lenOf = function (words) { var r = new RegExp('(?:' + words + ')\\\\s*(?:是|為|約|大約|要|=|:|：)?\\\\s*(\\\\d+(?:\\\\.\\\\d+)?)\\\\s*' + UNIT, 'i').exec(t); return r ? Math.max(0.002, Math.min(100, toM(r[1], r[2]))) : 0; };\n    out.depthM = lenOf('--depth[=\\\\s]+|深度|前後|front.to.back|depth') || 0; out.heightM = lenOf('高度|高|height') || 0; out.widthM = lenOf('寬度|寬|width') || 0; out.sizeM = lenOf('--size[=\\\\s]+|大小|尺寸|最長邊|整體|size') || 0;\n    if ((m = /--depth[=\\s]+(\\d+(?:\\.\\d+)?)(?!\\s*(?:cm|mm|m|公|厘|釐|毫|米))/i.exec(t))) { out.depthScale = clampK(parseFloat(m[1])); }\n    else if ((m = /深度\\s*(?:x|×|\\*|乘)?\\s*(\\d+(?:\\.\\d+)?)\\s*倍/i.exec(t))) { out.depthScale = clampK(parseFloat(m[1])); }\n    else if (/(?:立體感|深度|凹凸)[^，。,.\\n]{0,4}(?:強|大|深|明顯|多|高)|深一點|更立體/.test(t)) { out.depthScale = 1.6; }\n    else if (/(?:立體感|深度|凹凸)[^，。,.\\n]{0,4}(?:弱|小|淺|少|低)|淺一點|平一點|平坦/.test(t)) { out.depthScale = 0.6; }\n    if ((m = /--thick(?:ness)?[=\\s]+(\\d+(?:\\.\\d+)?)/i.exec(t))) { out.thickScale = clampK(parseFloat(m[1])); }\n    else if ((m = /厚度\\s*(?:x|×|\\*|乘)?\\s*(\\d+(?:\\.\\d+)?)\\s*倍/i.exec(t))) { out.thickScale = clampK(parseFloat(m[1])); }\n    else if (/厚一點|厚一些|加厚|更厚|厚度[^，。,.\\n]{0,4}(?:大|高|多|厚)/.test(t)) { out.thickScale = 1.6; }\n    else if (/薄一點|薄一些|變薄|更薄|扁一點|厚度[^，。,.\\n]{0,4}(?:小|低|少|薄)/.test(t)) { out.thickScale = 0.6; }\n    var si = subjectIntent(t); out.subject = si.subject; out.subjectName = si.name; out.subjectTarget = si.target; out.subjectDecided = si.decided; out.subjectSource = si.source;\n    return out;\n  }\n\n  // a picture that was already cut out (transparent background): the alpha channel IS the foreground mask. img { width, height, data: RGBA } -> { mask: Uint8Array (1 = opaque), fg } | null when there is not enough transparency to mean it\n  function alphaMask(img) {\n    if (!img || !img.data) { return null; }\n    var n = img.width * img.height, m = new Uint8Array(n), solid = 0, i;\n    for (i = 0; i < n; i++) { if (img.data[i * 4 + 3] >= 128) { m[i] = 1; solid++; } }\n    var fg = solid / n; if (fg < 0.02 || 1 - fg < 0.02) { return null; }\n    return { mask: m, fg: fg };\n  }\n  // does the program fail to read this request? (only then the LLM is asked) = the words hint at a subject but could not be decided, or the sentence has real content and nothing in it was recognised\n  function needsLlm(text, o) {\n    var t = String(text || '').replace(/\\[附件：[^\\]]*\\]/g, ' ').replace(/--[a-z-]+(?:[=\\s]+[^\\s-][^\\s]*)?/gi, ' ').trim(); if (!t) { return false; }\n    if (o && o.subjectDecided === false) { return true; }\n    var rec = o && (o.subjectSource !== 'default' || o.shape !== 'auto' || o.closeSource !== 'default' || o.whole || o.segment || o.panorama || o.editor || o.noBackground || o.depthM || o.heightM || o.widthM || o.sizeM || o.depthScale !== 1 || o.thickScale !== 1);\n    if (rec) { return false; }\n    var rest = t.replace(/[\\s，。,.！!？?、；;：:「」\"']/g, '').replace(/請|幫我|麻煩|謝謝|可以|好嗎|一下|把|將|這張|圖片|照片|圖|變成|轉成|轉為|轉|做成|作成|3d化|3d|三維|立體|成|image-?to-?3d/gi, '');\n    return rest.length >= 4;\n  }\n\n  // ---------- the user's request read by an LLM (the program checks every field; flags typed as --xxx always win; without an answer the words are read by parseOptions above) ----------\n  function llmRequest(text) {\n    return {\n      system: '你是「圖片轉 3D」指令的解析器。只輸出一個 JSON 物件，不要解釋、不要程式碼區塊。欄位（使用者沒提到的就省略）：{\"subject\":\"main 或 all\",\"subject_name\":\"主體的名稱（用使用者話裡的詞）\",\"target\":\"要擺上去的物件名稱\",\"shape\":\"auto、smooth、cylinder、blocks 其中之一\",\"close\":\"objects 或 all\",\"depth_scale\":數字,\"thickness_scale\":數字,\"whole\":布林,\"segment\":布林,\"panorama\":布林,\"no_background\":布林,\"depth_cm\":數字,\"height_cm\":數字,\"width_cm\":數字,\"size_cm\":數字}。說明：depth_cm＝模型前後的總深度（公分）、height_cm 高、width_cm 寬、size_cm 最長邊，使用者給了實際尺寸才填（單位換算成公分）；subject=main 表示使用者只要圖裡的某一個主體（例如「只要小提琴」「去掉背景」「把咖啡杯擺到桌子上」），其他東西都不要；subject=all 表示整張圖所有物件都要。close=all 表示連背景都做成實心（要列印、全部封閉）。shape：smooth 平滑、cylinder 圓柱、blocks 樂高方塊。no_background=true 表示不要背景（去掉背景、去背）。depth_scale 大於 1 表示正面凹凸更