頁）。",{},[]),i("browser_navigate","tab_navigate","讓分頁前往新網址，或 action 為 back/forward/reload。等頁面載入完成才回傳。",{tab_id:o,url:{type:"string"},action:{type:"string",enum:["goto","back","forward","reload"]}},[]),i("browser_close","tab_close","關閉一個分頁（tab_id）或整個分頁群組（group_id）。只能關閉助理自己開的。**任務做完、不再需要的分頁就用這個關掉**（最後一個分頁關掉時空的「AI Controlled」群組會自動消失）。",{tab_id:o,group_id:{type:"integer"}},[]),i("browser_activate_tab","tab_activate","把分頁切到前景（讓使用者看到）。會打擾使用者正在做的事，只有使用者明確要看這個頁面時才用；被切到前景的分頁回合結束後會保留、不會被自動關閉。點擊/打字/截圖等操作不需要先切到前景。",{tab_id:o},[]),i("browser_scroll","scroll","在分頁內捲動。direction: down/up/top/bottom/left/right；amount是像素（預設約一個畫面的80%）；selector可指定要捲動的容器。回傳目前scroll_y、是否已到底。",{tab_id:o,direction:{type:"string",enum:["down","up","top","bottom","left","right"]},amount:{type:"number"},selector:{type:"string"}},[]),e("browser_screenshot","對分頁截圖（畫面會顯示給使用者）。預設你只拿到尺寸與標題、看不到像素；**要讓自己看到截圖內容，帶interpret:true（可加question指定想看什麼）**，會用支援讀圖的model看這張圖並把描述放在回傳的description。region:{x,y,width,height}只截指定範圍（座標是分頁可視區像素、左上角0,0，跟browser_get_elements的座標同一套；full_page:true時改用整頁座標），scale(1~3)可放大小範圍讓文字更清楚。save:true把截圖存成圖片檔案（回傳file_id，之後可用compare_images跟其他圖片比對）。full_page:true截整頁（最高8000px）。要看頁面文字內容仍優先用browser_get_page_structure / browser_get_page_text。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=t.region&&"object"==typeof t.region?{x:Number(t.region.x),y:Number(t.region.y),width:Number(t.region.width),height:Number(t.region.height)}:null;if(e&&!(Number.isFinite(e.x)&&Number.isFinite(e.y)&&e.width>0&&e.height>0))return JSON.stringify({ok:!1,error:"region需要{x,y,width,height}四個數字，width/height要大於0"});const n=Object.assign({},t);delete n.interpret,delete n.question,delete n.save,e?n.region=e:delete n.region;const r=this._bcShapeResult("screenshot",await this._bcCall("screenshot",n,45e3));if(!r||"image"!==r.type)return JSON.stringify(r);if(e&&(!r.meta||!r.meta.region_applied))try{const t=await this._cropDataUrl(r.dataUrl,e,r.meta&&r.meta.width);r.dataUrl=t.dataUrl,r.meta.region_applied={x:t.x,y:t.y,width:t.width,height:t.height,by:"local"},r.meta.width=t.width,r.meta.height=t.height,r.meta.note="擴充功能沒有區域截圖功能，已在本機從整張截圖裁出指定範圍（x="+t.x+",y="+t.y+","+t.width+"×"+t.height+"）。"}catch(e){r.meta.warning="要求的範圍沒有裁成功（"+String(e&&e.message||e)+"），這張是整個畫面／整頁。"}if(t.save||t.interpret){const e=await(await fetch(r.dataUrl)).blob(),t=`screenshot_${(new Date).toISOString().replace(/[:.]/g,"-")}.jpg`;r.meta.file_id=await this.fileCache.put(t,e.type||"image/jpeg",e,"uploaded"),r.meta.filename=t}if(t.interpret)try{const e=await this._interpretImageWithVisionModel(r.dataUrl,t.question);r.meta.description=e.description,r.meta.model_used=e.modelUsed}catch(e){r.meta.interpret_error=String(e.message||e)}return JSON.stringify(r)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{tab_id:o,full_page:{type:"boolean"},quality:{type:"integer"},region:{type:"object",description:"只截這個範圍：{x,y,width,height}（像素，左上角0,0）",properties:{x:{type:"number"},y:{type:"number"},width:{type:"number"},height:{type:"number"}}},scale:{type:"number",description:"（選填）放大倍率1~3，搭配region放大小範圍"},save:{type:"boolean",description:"（選填）把截圖存成圖片檔案，回傳file_id"},interpret:{type:"boolean",description:"（選填）true＝用vision model實際看這張截圖，描述放在回傳的description"},question:{type:"string",description:"（選填）搭配interpret，想問這張截圖的具體問題"}},additionalProperties:!1});const l={offset:{type:"integer",description:"選填：從第幾個字元開始讀（分頁用，預設0）"},max_chars:{type:"integer",description:"選填：這次最多讀幾個字元（預設12000）"},start_line:{type:"integer",description:"選填：從第幾行開始讀（1起算，優先於offset）"},max_lines:{type:"integer",description:"選填：這次最多讀幾行"}};i("browser_get_page_text","get_page_text","取得分頁的可見文字內容（innerText），含目前捲動位置。**分頁讀取**：回傳has_more:true代表還沒讀完，用offset（或start_line）繼續讀，長文章要分頁讀完整份，不要只看第一段就下結論。",Object.assign({tab_id:o},l),[]),e("browser_get_page_structure","以結構化方式讀取分頁內容（讀網頁的首選）：回傳標題階層(headings)、Markdown格式的正文(markdown，含標題/清單/表格/連結)、表格資料(tables，含欄位名稱與列)、連結清單(links)、圖片清單(images，含src/alt)、表單欄位(forms)。自動避開導覽列/頁尾等雜訊。**分頁讀取**：markdown欄位回傳has_more:true代表還沒讀完，用offset（或start_line）繼續讀，長文章要分頁讀完整份。**圖文穿插**：interpret_images:true時，會對前幾張圖片（interpret_images_count，預設5、最多10）自動呼叫vision model，把解讀結果填進images[].description（沒有配置支援讀圖的model、或該張圖片解讀失敗會是images[].description_error，不影響其他張）；這會增加額外的網路請求/延遲，圖片不是頁面重點時不要開。",async function(e){let t,n={};try{n=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{t=this._bcShapeResult("get_page_structure",await this._bcCall("get_page_structure",n,3e4))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}if(n.interpret_images&&t&&Array.isArray(t.images)&&t.images.length){const e=Math.max(1,Math.min(10,Number(n.interpret_images_count)||5));for(const n of t.images.slice(0,e))try{const{dataUrl:e}=await this._resolveImageInputForInterpretation({imageUrl:n.src}),t=await this._interpretImageWithVisionModel(e,n.alt?`這張圖片的alt文字是「${n.alt}」，請描述圖片實際內容（如果圖片裡有文字，也請列出來）。`:void 0);n.description=t.description}catch(e){n.description_error=String(e.message||e)}}return JSON.stringify(t)},{type:"object",properties:Object.assign({tab_id:o},l,{interpret_images:{type:"boolean",description:"選填：true時對前幾張圖片自動呼叫vision model補上description（見上方工具說明）"},interpret_images_count:{type:"integer",description:"選填：搭配interpret_images，要解讀前幾張圖片，預設5、最多10"}}),required:[],additionalProperties:!1}),i("browser_get_elements","get_elements","列出分頁上可互動的元素（連結、按鈕、輸入框…）與其中心座標x,y，用來決定browser_mouse要點哪裡。預設只列目前可視區內的元素，viewport_only:false列全頁。",{tab_id:o,max:{type:"integer"},viewport_only:{type:"boolean"}},[]),i("browser_mouse","mouse","控制滑鼠（真實輸入事件）。action: click/double_click/right_click/move/wheel/drag/down/up。x,y是分頁可視區的像素座標（來自browser_get_elements）。drag需要to_x,to_y；wheel用delta_y。",{tab_id:o,action:{type:"string",enum:["click","double_click","right_click","move","wheel","drag","down","up"]},x:{type:"number"},y:{type:"number"},to_x:{type:"number"},to_y:{type:"number"},delta_x:{type:"number"},delta_y:{type:"number"},button:{type:"string",enum:["left","right","middle"]},modifiers:{type:"array",items:{type:"string"}}},["x","y"]),i("browser_type_text","type_text","在目前有焦點的輸入框輸入文字（先用browser_mouse點一下輸入框，或給selector自動聚焦）。clear:true先清空；submit:true輸入後按Enter。",{tab_id:o,text:{type:"string"},selector:{type:"string"},clear:{type:"boolean"},submit:{type:"boolean"}},["text"]),i("browser_press_key","press_key","按一個鍵。key例如Enter、Tab、Escape、Backspace、ArrowDown、PageDown、a；modifiers可放ctrl/shift/alt/meta（例如ctrl+a全選）。",{tab_id:o,key:{type:"string"},modifiers:{type:"array",items:{type:"string"}}},["key"]),i("browser_click","click",'用CSS selector或文字內容找到元素並點擊（真實滑鼠事件），不用先截圖算座標——**同一個網站的很多個頁面結構相同時（例如逐一走訪多個網址各下載一次），同一個selector可以在每個頁面重複使用，比每次screenshot+browser_get_elements快很多**。selector與text至少給一個（可以只給text，例如text:"免費下載"會在常見可點擊元素裡找innerText/value包含這段文字的）；兩者都給時先用selector篩選、再用text篩選。index選填，同時符合多個時選第幾個（0起算，預設0）。**如果這次點擊預期會觸發檔案下載，一定要加wait_download:true**，回傳的download會有實際存檔路徑(path)、檔名可以從path取得——沒有這個flag點了下載也不知道有沒有成功、存在哪裡。找不到元素時回報的visible_count/matched_by_selector等數字要拿來判斷selector對不對，不要瞎猜著重試。',{tab_id:o,selector:{type:"string",description:"選填，CSS selector"},text:{type:"string",description:"選填，元素可見文字/value/aria-label要包含這段（不分大小寫）"},index:{type:"integer",description:"選填，同時符合多個時選第幾個，0起算，預設0"},wait_download:{type:"boolean",description:"選填，點擊後等待這次觸發的檔案下載完成，回傳存檔路徑"},download_timeout_ms:{type:"integer",description:"選填，等下載的逾時時間(毫秒)，預設20000"},download_behavior:{type:"string",enum:["capture","allow","deny","default"],description:"選填，這次點擊前先設定這個分頁的下載行為：capture=（wait_download:true時的預設，建議）攔下下載、不讓Chrome存檔，位元組串流給FAP並驗證大小與crc32、回傳抓到了什麼（檔名、大小、sha256），再寫進FAP的下載卡片（帶save_path還會寫進該資料夾）；allow=直接存到download_path、不跳「另存新檔」對話框（會一直生效到改成default或分頁關掉）；deny=擋掉下載、只回報有下載想發生（denied:true）；default=還給Chrome自己處理。預期會跳另存新檔對話框時用allow"},save_path:{type:"string",description:"選填，capture擷取到的檔案要同時寫進哪個資料夾（絕對路徑，桌面版才能寫；不給就只進FAP的下載卡片）"},deliver:{type:"boolean",description:"選填，capture的檔案是否交給FAP下載卡片，預設true"},download_path:{type:"string",description:"download_behavior為allow時必填：存檔資料夾的絕對路徑（例如C:\\Users\\你\\Downloads\\ai 或 /home/你/Downloads/ai）"}},[],3e4),i("browser_wait_download","wait_download","等待一個新的檔案下載完成，回傳存檔路徑(path)、網址、mime、大小。用在下載不是由browser_click直接觸發的情況（例如按Enter觸發、或頁面延遲幾秒後才自動下載）；如果是點擊按鈕觸發下載，優先在browser_click直接帶wait_download:true，不用另外呼叫這個。since_ms選填，不給就只等「這次呼叫之後」才新出現的下載。",{since_ms:{type:"number",description:"選填，只算這個時間戳記(ms)之後才建立的下載為新下載；不給就用呼叫當下的時間"},timeout_ms:{type:"integer",description:"選填，逾時時間(毫秒)，預設20000"},tab_id:o,save_path:{type:"string",description:"選填，capture擷取到的檔案要同時寫進哪個資料夾（絕對路徑，桌面版）"},deliver:{type:"boolean",description:"選填，是否交給FAP下載卡片，預設true"}},[],19e4),i("browser_set_download_behavior","set_download_behavior","預先設定一個分頁的下載行為（之後這個分頁觸發的下載都照它處理，直到改回default或分頁關掉）。behavior=allow要附path（存檔資料夾的絕對路徑）：下載直接存進去、不跳「另存新檔」對話框（擴充功能碰不到系統對話框，所以要靠這個避開）；capture=攔下下載交給FAP（建議，抓到什麼都看得到、驗得到）；deny=擋掉下載、只回報有下載想發生；default=還給Chrome。通常直接在browser_click帶download_behavior（或wait_download:true，預設capture）就好，這個用在下載不是點擊觸發的情況。",{tab_id:o,behavior:{type:"string",enum:["capture","allow","deny","default"]},path:{type:"string",description:"behavior為allow時必填，存檔資料夾的絕對路徑"}},["behavior"],15e3),e("browser_upload",'把檔案放進網頁的上傳欄位（不會跳系統的檔案選擇對話框）。檔案來源（files，可多個）：聊天附件或 FAP 產生過的檔案，用檔名（或 file_id）指定，例如 {"name":"報告.pdf"}；桌面版也可以用本機絕對路徑 {"path":"C:\\Users\\你\\a.pdf"}。放進哪裡：(1) selector＝檔案欄位 input type=file 的 CSS selector（欄位被藏起來也可以），直接填入；(2) click_selector／click_text＝點下去會開檔案選擇對話框的按鈕（自訂的「選擇檔案」按鈕），會先捲到畫面中央、點擊、攔下對話框、填入。檔案位元組會分段傳給擴充功能並核對（crc32、放進欄位後的大小），回傳每個檔案的大小與 sha256、網頁實際收到的檔名。填入後網頁會收到 input／change 事件，但不會自動按「送出」，要送出請另外 browser_click。拖放區（沒有 input type=file、要真實拖放事件的）這個工具做不到。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._bcUpload(t))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{tab_id:o,files:{type:"array",items:{type:"object",properties:{name:{type:"string",description:"聊天附件或 FAP 檔案的檔名（可以只寫一部分）"},file_id:{type:"string"},path:{type:"string",description:"桌面版：本機檔案絕對路徑"}}},description:"要上傳的檔案（一個或多個）"},selector:{type:"string",description:"檔案欄位（input type=file）的 CSS selector；給了就直接填入"},index:{type:"integer",description:"selector 符合多個欄位時選第幾個（0 起算）"},click_selector:{type:"string",description:"沒有 selector 時：點這個 CSS selector 的元素（會開檔案選擇對話框）"},click_text:{type:"string",description:"沒有 selector 時：點可見文字包含這段的元素（例如「選擇檔案」）"},click_index:{type:"integer"},timeout_ms:{type:"integer",description:"點擊後等對話框出現的逾時（毫秒），預設 8000"}},required:["files"],additionalProperties:!1}),i("browser_list_downloads","list_downloads","列出這次擴充功能執行期間記得的最近幾筆下載（除錯用，不是完整下載歷史，重新啟動瀏覽器/擴充功能就會清空）。",{max:{type:"integer",description:"選填，最多列幾筆，預設10"}},[],1e4),e("git_push",'把一個File Access Point資料夾（git repo）本機已經commit的內容推上遠端(origin)。一定需要使用者已填入有寫入權限的GitHub Personal Access Token（不論公開或私有repo，push都需要驗證身分），沒有的話會直接回報錯誤而不是嘗試匿名push。參數: {"ref":"fap:我的專案", "branch":"main"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.ref||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少ref參數"});try{return JSON.stringify(await this._gitPush(n,{branch:t.branch}))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{ref:{type:"string",description:"File Access Point資料夾，格式：fap:<名稱或id>[/<子路徑>]"},branch:{type:"string",description:"要push的分支（留空＝目前所在分支）"}},required:["ref"],additionalProperties:!1}),e("list_uploaded_files","列出使用者透過📎附件按鈕上傳、目前還在快取中的檔案清單（不含AI自己產生的匯出檔）。無參數。",async function(){try{const e=(await this.fileCache.getAll()).filter(e=>"uploaded"===e.kind).map(e=>({file_id:e.id,filename:e.filename,sizeBytes:e.sizeBytes,uploadedAt:e.createdAt}));return JSON.stringify({ok:!0,files:e})}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{},additionalProperties:!1}),e("parse_uploaded_file",'解析一個已上傳檔案的內容，依副檔名自動判斷格式（csv/xlsx/js/json/txt/markdown/yaml/docx/pptx/pdf/toon/cfg/inf/ini/log都支援，壓縮檔支援zip/jar/7z/rar/tar/tar.gz/tgz/gzip/bzip2/tar.bz2/xz/tar.xz/iso，用檔頭判斷格式，副檔名不對也認得出來）。壓縮檔預設只回傳內含項目清單與摘要（jar會附MANIFEST重點、類別與套件），要看特定項目的實際內容再帶entry_path指定（二進位項目不會顯示；有加密要帶password）。pdf會逐頁擷取文字內容接成fullText（只回傳前12000字元，超長文件需要完整全文請改用summarize_large_text）；純掃描/圖片PDF沒有文字層，擷取不到內容屬於正常情況（不支援OCR），回應裡的note欄位會說明。**PDF文字跟圖片是分開解析的**：預設只解析文字（速度快），如果PDF裡有圖表/圖片需要理解內容，帶interpret_images:true重新呼叫——有圖片的頁面會被整頁截圖（不是逐一還原內嵌圖片，比較可靠），截圖先以「[圖片區塊：第N頁截圖｜file_id=...]」佔位標籤插入該頁文字，interpret_images:true時才會真的呼叫vision model描述內容並附加在佔位標籤後面（interpret_images_count控制最多對幾頁截圖做vision描述，避免每頁都跑vision太慢，預設3）；回應的pageImages欄位列出每張截圖的file_id/是否已描述，之後也可以直接拿file_id呼叫interpret_image單獨補問。**有密碼保護的PDF**：呼叫這個工具時如果偵測到需要密碼，會在畫面上自動跳出密碼輸入框讓使用者當場輸入（跟File Access Point權限不足時的行為一致），這次工具呼叫會停在那裡等使用者輸入完成，不需要事先知道密碼或另外處理，使用者輸入錯誤會再跳一次、取消輸入則工具回報明確錯誤。參數: {"file_id":"...", "entry_path":"（選填，僅壓縮檔用）"}**分頁讀取**：純文字、壓縮檔項目、PDF文字如果回傳has_more:true，用offset/start_line/max_chars/max_lines繼續讀到完整份；精準編修（程式碼、字幕）不要用summarize_large_text，要分頁把整份讀完。要「改」附件內容請用bash_execute/python_execute的attachment_files參數。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file_id||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file_id參數（用list_uploaded_files查詢可用的file_id）"});const r=await this.fileCache.get(n);if(!r||"uploaded"!==r.kind)return JSON.stringify({ok:!1,error:`找不到上傳檔案 file_id=${n}（可能已被淘汰或這不是使用者上傳的檔案）`});const a=await this._parseUploadedFileContent(r,{entryPath:t.entry_path,offset:t.offset,maxChars:t.max_chars,startLine:t.start_line,maxLines:t.max_lines,interpretImages:t.interpret_images,interpretImagesCount:t.interpret_images_count,password:t.password});return JSON.stringify(Object.assign({filename:r.filename},a))},{type:"object",properties:{file_id:{type:"string",description:"要解析的檔案id，用list_uploaded_files取得"},entry_path:{type:"string",description:"（選填）壓縮檔內要抽取內容的項目路徑"},password:{type:"string",description:"（選填）加密壓縮檔（zip／7z／rar）的密碼；使用者沒給就不要猜"},offset:{type:"integer",description:"選填：純文字/壓縮檔項目/PDF文字從第幾個字元開始讀（分頁用，預設0）"},max_chars:{type:"integer",description:"選填：這次最多讀幾個字元（預設依模型內容窗口自適應）"},start_line:{type:"integer",description:"選填：從第幾行開始讀（1起算，優先於offset）"},max_lines:{type:"integer",description:"選填：這次最多讀幾行"},interpret_images:{type:"boolean",description:"（選填，僅PDF）true時對含圖片的頁面截圖並交給vision model描述內容，預設false只解析文字"},interpret_images_count:{type:"integer",description:"（選填，僅PDF且interpret_images:true時）最多對幾頁截圖做vision描述，預設3"}},required:["file_id"],additionalProperties:!1}),e("interpret_image",'請AI實際「看」一張圖片並用文字描述/回答關於這張圖片的問題（附件圖片、File Access Point裡的圖片、或圖片URL都支援）。內部會自動從目前設定的LLM Models清單挑一個支援讀圖(vision)的model來解讀，呼叫端不用（也不需要）自己判斷哪個model支援讀圖。三種輸入來源三選一：file_id（📎附件或AI產生的圖片，用list_uploaded_files查）、fap_ref搭配需要先呼叫fap_copy_to_storage複製成file_id（File Access Point本身不支援直接讀二進位圖片內容）、image_url（http(s)網址或data:image/...開頭的data URL，遠端URL可能受目標網站CORS限制而失敗）。question選填，不給的話預設請model詳細描述圖片內容（含圖片裡的文字）；想確認特定細節時直接問具體問題（例如「這張圖表股價的最高點在哪一天」「這是什麼型態的K線圖」）比只說「描述這張圖」更準確。參數: {"file_id":"..."} 或 {"image_url":"https://..."}，可加 {"question":"..."}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file_id||"").trim(),r=String(t.image_url||"").trim();if(!n&&!r)return JSON.stringify({ok:!1,error:"需要提供file_id或image_url其中之一"});try{const{dataUrl:e,label:a}=await this._resolveImageInputForInterpretation({fileId:n||null,imageUrl:r||null}),s=await this._visionDescribe({images:[e],prompt:t.question,runLlm:()=>this._interpretImageOnline(e,t.question)});return s.ok?"llm"===s.backend?JSON.stringify({ok:!0,source:a,backend:"llm",model_used:s.llm.modelUsed,vision_confirmed:s.llm.visionConfirmed,description:s.llm.description,policy:s.policy}):JSON.stringify({ok:!0,source:a,backend:"offline",model_used:s.model,vision_confirmed:!1,description:s.text,note:(s.attempts.some(e=>"llm"===e.backend&&!e.ok)?"線上視覺模型沒有可用或全部失敗（"+s.attempts.filter(e=>"llm"===e.backend).map(e=>e.error).join("；").slice(0,160)+"），已改用離線模型。":"")+"離線模型的描述主要是英文。"+(s.note?" "+s.note:""),policy:s.policy,attempts:s.attempts}):JSON.stringify({ok:!1,error:s.error,attempts:s.attempts,policy:s.policy,hint:"離線模型要先在 Configure →「離線模型管理」下載；也可以直接用 image_to_text"})}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file_id:{type:"string",description:"要解讀的圖片file_id（用list_uploaded_files取得；FAP裡的圖片請先用fap_copy_to_storage複製成file_id）"},image_url:{type:"string",description:"要解讀的圖片網址（http(s)開頭），跟file_id擇一提供"},question:{type:"string",description:"選填：想問關於這張圖片的具體問題，不給的話預設要求詳細描述圖片內容"}},required:[],additionalProperties:!1}),e("extract_pptx_images",'把已上傳的pptx投影片裡「嵌入的圖片」逐張抽出來，存成圖片檔案（回傳每張的slide投影片編號、順序、file_id），之後可以用interpret_image/compare_images讀圖或比較。**只抽得出嵌入的圖片（png/jpg/gif/webp/svg），抽不出「整張投影片的渲染畫面」**（文字/圖形/表格不會變成圖片）；emf/wmf/tif等瀏覽器不支援的格式會列在skipped。參數: {"file":"pptx的file_id或檔名，留空用最近上傳的","slides":"（選填）投影片範圍例如"2-5"或"3"，預設全部","max_images":"（選填）最多抽幾張，預設30，最高80"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file||t.file_id||"").trim(),r=await this._resolveUploadedFileRecord(n);if(!r)return JSON.stringify({ok:!1,error:n?`找不到符合「${n}」的檔案`:"沒有可用的pptx（請先上傳）"});if("pptx"!==this._detectFileFormat(r.filename))return JSON.stringify({ok:!1,error:`「${r.filename}」不是pptx檔案`});try{return JSON.stringify(await this._extractPptxImages(r,t))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file:{type:"string",description:"pptx的file_id或檔名；留空＝最近上傳的"},slides:{type:"string",description:'（選填）投影片範圍，例如"3"或"2-5"，預設全部'},max_images:{type:"integer",description:"（選填）最多抽幾張，預設30，最高80"}},additionalProperties:!1}),e("merge_pdfs",'把多個檔案依指定順序合併成一份PDF：PDF、各種圖片（jpg／png／gif／webp／bmp／avif／tiff／heic／svg…）、文字檔（txt／md／csv／log／json／程式碼…）、docx、xlsx 都可以，也能混在一起；副檔名不重要，用內容判斷。純本地、不經過AI。PDF＝直接複製原始頁面（文字仍可選取）；圖片＝等比例縮放置中到頁面（預設A4；page_size／orientation／fit／margin／zoom／background 同 images_to_pdf，要逐張旋轉或影像處理請改用 images_to_pdf）；文字檔＝排版後畫成頁面（中文OK）；docx／xlsx／pptx／doc／xls／rtf／odt＝桌面版用 Word／Excel／PowerPoint（Windows）或 LibreOffice 轉成PDF（版面、圖片、字型都保留；第一次會跳出「允許執行程式」確認），都沒有時 docx／xlsx 退回簡化版（只有文字、標題、表格內容，會在 warnings 說明），其他格式就明說需要 Office。files＝file_id或檔名（照這個順序）；folder＝整個資料夾（fap:名稱/路徑 或桌面版絕對路徑，依檔名自然排序，pattern可篩如"*.docx"）；沒給＝這個對話附加的全部檔案（依檔名自然排序）；sort：none／name／name_desc／modified／reverse。filename、output_path（fap:名稱/資料夾 或桌面版絕對路徑）；office_engine：auto（預設）／office／libreoffice／simple（不叫外部程式、強制簡化版）；on_error：fail（預設，有一個壞就整份不做並說是哪一個）／skip。⚠️PDF有密碼保護不支援。回傳{ok,pdf_file_id,filename,sizeBytes,pageCount,fileCount,files:[{filename,kind,pages,method}],warnings?,saved_to?}，成功時會自動產生下載附件。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._mergeDocsToPdf(t,e=>this._log("📄 "+e));return await this._deliverToolResultFile(e,"pdf_file_id",e=>`📎 已合併 ${e.fileCount} 個檔案成PDF（共${e.pageCount}頁）：${e.filename}（${(e.sizeBytes/1024/1024).toFixed(1)}MB）${e.saved_to?"，已存到 "+e.saved_to:""}`,"merge_pdfs"),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{files:{type:"array",items:{type:"string"},description:"（選填）要依序合併的檔案 file_id或檔名（也可以是 fap:名稱/路徑、桌面版絕對路徑）；留空＝這個對話附加的全部檔案"},folder:{type:"string",description:"（選填）整個資料夾：fap:名稱/路徑 或桌面版絕對路徑，依檔名自然排序"},pattern:{type:"string",description:'（選填）folder 的檔名篩選，例如 "*.docx"'},sort:{type:"string",enum:["none","name","name_desc","modified","reverse"],description:"（選填）預設：有給 files＝照給的順序，folder／附件＝依檔名自然排序"},page_size:{type:"string",description:'（選填）圖片與文字頁的頁面大小：a4（預設）／a3／a5／b5／letter／legal／"210x297mm"'},orientation:{type:"string",enum:["auto","portrait","landscape"],description:"（選填）預設 auto（圖片依寬高、文字直式）"},fit:{type:"string",enum:["contain","cover","stretch","actual"],description:"（選填）圖片：contain（預設，等比置中）／cover（填滿裁切）／stretch／actual"},margin:{type:"number",description:"（選填）圖片頁的邊界 pt，預設 0"},margin_mm:{type:"number",description:"（選填）文字頁的邊界 mm，預設 15"},zoom:{type:"number"},background:{type:"string"},jpeg_quality:{type:"number"},office_engine:{type:"string",enum:["auto","office","libreoffice","simple"],description:"（選填）docx／xlsx 等怎麼轉：auto（預設，先 Word／Excel 再 LibreOffice 再簡化版）"},filename:{type:"string",description:"（選填）輸出檔名"},output_path:{type:"string",description:"（選填）把PDF存到：fap:名稱/資料夾 或桌面版絕對路徑"},on_error:{type:"string",enum:["fail","skip"],description:"（選填）有檔案壞掉時：fail（預設）／skip"}},additionalProperties:!1}),e("uml_to_code",'把 UML 轉成程式碼骨架（Python／TypeScript／Java），純程式、秒完成、不經過 AI。你（或離線小模型）只要寫「一行一件事」的 UML 文字，格式：model: 名稱／actor: A, B／class Name extends Base implements I { +id:int; items:List<Item>; +total():decimal; add(item:Item):void }／interface Name { op(x:int):bool }／enum Name { A, B }／Order *-- Item（組成）Cart o-- Item（聚合）A --\x3e B : 標籤 1..*（關聯）A ..> B（依賴）／usecase 名稱: Actor -> Cls.op(args):ret -> Cls2.op2()（呼叫順序）。型別：int float str bool date datetime decimal any、List<T> Map<K,V> Optional<T> 或已定義的類別。類別名稱英文 PascalCase，屬性與操作 camelCase。格式或內容有錯會精確回報哪一行、為什麼，改好再呼叫一次。架構與 library 由程式依 scenario 的關鍵字推薦（也可用 constraints 指定，例如 {"persistence":"sqlite"}）；要先看有哪些選項與推薦用 design_choices。產生 zip（下載附件）並回傳檔案清單、設計決策、Mermaid 類別圖。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlToCode(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{uml:{type:"string",description:"UML 文字（格式見工具說明）"},language:{type:"string",enum:["python","typescript","java"],default:"python",description:"目標語言"},package:{type:"string",description:"（選填）套件／專案名稱，小寫英文"},scenario:{type:"string",description:"（選填）原始情境文字；用來推薦架構與 library（網站、命令列、資料庫、登入、排程…）"},constraints:{type:"object",description:'（選填）指定抉擇，例如 {"architecture":"layered","interface":"rest","persistence":"sqlite"}；選項見 design_choices'},remember:{type:"boolean",description:"（選填）true＝把 constraints 記成使用者偏好，以後推薦優先採用"}},required:["uml"],additionalProperties:!1}),e("glue_list","列出「膠水」——骨架之後把設計接到真正 library 的寫法（ORM 模型、repository 實作、Pydantic schema、依賴注入、FastAPI 路由與啟動、Typer 指令、JWT、HTTP 客戶端、排程、記錄、設定、冒煙測試…）：每一塊的適用條件、占的位置（slot）、驗證過的版本、經驗（成功／失敗、最近環境）、來源（內建／AI 登記／使用者）。uml_to_code 會依設計自動挑選並套用；你可以用 glue_define 登記自己接通的寫法，用 glue_report 回報某塊膠水在你的環境跑測試的結果。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=this.advancedSettings.glueExperience||{},r=FaGlue.GLUE.concat(this.advancedSettings.userGlue||[]).filter(e=>!t.lang||e.lang===t.lang);return JSON.stringify({ok:!0,glue:r.map(e=>({id:e.id,lang:e.lang,slot:e.slot,label:e.label,source:e.source,requires:e.requires,verified:e.verified,experience:n[e.id]||{ok:0,fail:0},score:Math.round(100*FaGlue.score(e,n))/100,files:e.files.map(e=>e.path)}))})},{type:"object",properties:{lang:{type:"string",enum:["python","typescript","java"],description:"（選填）只列這個語言"}},additionalProperties:!1}),e("glue_define","登記一塊「膠水」：你（AI）把某個 library 組合手動接通、測試通過之後，把那些檔案整理成 template 登記起來，之後離線小模型與其他 AI 產生專案時直接重用，不用重新摸索。template 用 {{名稱}} 取代會變的部分，可用的變數：pkg（套件名）、src（原始碼目錄）、title（系統名稱）；每個實體／使用案例一個檔案時 per 填 entity 或 usecase，變數是 name、snake、plural、table、fields（每個有 name、py、mapped、col）／className、path、steps；迴圈 {{#each entities}}…{{/each}}、條件 {{#if x}}…{{else}}…{{/if}}、過濾 |snake |camel |pascal |upper。登記後標為「未驗證」，要累積 glue_report 的成功經驗才會贏過內建且已驗證的膠水（同一個 slot 只留分數最高的一塊）。路徑必須是專案內的相對路徑。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaGlue.validateGlue(Object.assign({},t,{source:"ai"}));if(!n.ok)return JSON.stringify({ok:!1,error:"膠水格式不合格",errors:n.errors});const r=(this.advancedSettings.userGlue||[]).filter(e=>e.id!==n.glue.id).concat([n.glue]).slice(-60);return this.advancedSettings.userGlue=r,this._saveAdvancedSettings(),JSON.stringify({ok:!0,id:n.glue.id,slot:n.glue.slot,note:"已登記為未驗證；用它產生專案、測試通過後請呼叫 glue_report 回報"})},{type:"object",properties:{id:{type:"string",description:"小寫英數與連字號，例如 py-fastapi-jwt-auth"},lang:{type:"string",enum:["python","typescript","java"]},slot:{type:"string",description:"占的位置，例如 api、persistence、auth、cli、services；同一個位置只留分數最高的一塊"},label:{type:"string"},requires:{type:"object",description:'（選填）適用條件，例如 {"interface":["rest"],"persistence":["orm"],"libs":["fastapi"]}'},files:{type:"array",items:{type:"object"},description:'[{path, template, per:"project"|"entity"|"usecase"}]'},notes:{type:"string"}},required:["id","lang","slot","files"],additionalProperties:!1}),e("glue_report","回報一塊膠水在真實環境的結果：用 uml_to_code／uml_design 產生的專案，裝好依賴、跑過測試之後，成功或失敗都回報（ok、環境版本、備註）。經驗會累積，決定同一個位置有多塊膠水時挑哪一塊，也讓使用者知道哪些組合真的驗證過。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.glue_id||"");return FaGlue.GLUE.concat(this.advancedSettings.userGlue||[]).some(e=>e.id===n)?(this.advancedSettings.glueExperience=FaGlue.report(this.advancedSettings.glueExperience||{},n,!0===t.ok,t.env,t.note),this._saveAdvancedSettings(),JSON.stringify({ok:!0,glue_id:n,experience:this.advancedSettings.glueExperience[n]})):JSON.stringify({ok:!1,error:"沒有這塊膠水："+n+"（用 glue_list 看有哪些）"})},{type:"object",properties:{glue_id:{type:"string"},ok:{type:"boolean",description:"測試是否通過"},env:{type:"object",description:'（選填）環境，例如 {"python":"3.11","fastapi":"0.110.0"}'},note:{type:"string",description:"（選填）備註，失敗時寫原因"}},required:["glue_id","ok"],additionalProperties:!1}),e("design_choices","列出「UML 確定之後」的設計抉擇：架構風格（分層、六角、命令列、函式庫、事件驅動）與各關注點（對外介面、資料儲存、驗證、測試、記錄、呼叫外部服務、認證、排程、訊息）的選項、各語言對應的 library 與取捨；依 scenario 推薦（程式依關鍵字決定，平手才列成選擇題），並列出符合的常見設計片段（購物車、登入、Repository、Observer、Strategy、狀態機、庫存、排程…）。純查表，不經過 AI。選好後把選擇放進 uml_to_code 的 constraints。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=["python","typescript","java"].includes(t.language)?t.language:"python",r=FaDesign.recommend(String(t.scenario||""),n,{prefs:this.advancedSettings.designPrefs||{},constraints:t.constraints||{}});return JSON.stringify({ok:!0,language:n,tags:r.tags,architecture:r.architecture,architectures:FaDesign.ARCH.map(e=>({id:e.id,label:e.label,notes:e.notes,tradeoff:e.tradeoff})),choices:r.choices.map(e=>({concern:e.concern,label:e.label,chosen:e.option,lib:e.lib,by:e.by,reason:e.reason,options:FaDesign.CONCERNS[e.concern].options.map(e=>({id:e.id,label:e.label,lib:e.libs[n],tradeoff:e.tradeoff}))})),ambiguous:r.ambiguous,fragments:FaDesign.matchFragments(String(t.scenario||"")).slice(0,4).map(e=>({id:e.fragment.id,label:e.fragment.label,hits:e.hits,uml:e.fragment.dsl}))})},{type:"object",properties:{scenario:{type:"string",description:"（選填）情境文字，用來推薦"},language:{type:"string",enum:["python","typescript","java"],default:"python"},constraints:{type:"object",description:"（選填）已經指定的抉擇"}},additionalProperties:!1}),e("mix_understand","讀一份「混合內容」的輸入：英文敘述夾著各種語言的程式、設定、錯誤輸出（PHP、HTML、JavaScript、WebGL 著色器 GLSL、TOML、INI、Python、CSS、JSON、YAML、shell、SQL…，不用事先標記），並推出使用者的意圖。做法：①切成區段並認出每一段的語言（明確的記號——圍欄、<?php?>、<script type=x-shader>——信心最高；其餘逐行評分並用前後文平滑，單獨一行沒把握會沿用前後文，整段分數太低標「不確定」）②英文句子做詞類標註、片語切分，用 LALR 子句文法解析，抽出「動作＋對象＋修飾」框架（祈使句、問句、請求、「我想要…」；解析不了的句子保留原句、標低信心）③把「this shader」「the query below」「the error above」這類說法對回最近的、類型相符的區段④對上離線訓練器的意圖目錄（每個領域規則的意圖說明與例句），每個意圖附證據。全是程式計算，不呼叫模型；只做英文，語意只到「做什麼、對什麼」。來源三選一：text、file_id、path（桌面版）。回傳 {blocks, sentences, asks, intents, summary}。用這個工具決定要把問題交給哪個領域／工具，不要自己從頭猜。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._mixUnderstand(t);if(!e.ok)return JSON.stringify(e);const n=e.r;return JSON.stringify({ok:!0,source:e.source,languages:n.languages,blocks:n.mix.blocks.map(e=>({id:e.id,lang:e.lang,name:e.name,kind:e.kind,confidence:e.confidence,explicit:e.explicit,uncertain:e.uncertain||void 0,lines:[e.fromLine,e.toLine],evidence:e.evidence[0]})),sentences:n.sentences.slice(0,40).map(e=>({text:e.text.slice(0,160),type:e.frame.type,act:e.frame.act&&e.frame.act.lemma,object:e.frame.obj&&e.frame.obj.text,wh:e.frame.wh||void 0,kind:e.frame.intentKind||void 0,pps:e.frame.pps.map(e=>e.prep+" "+(e.np&&e.np.text)),parsed:e.frame.parsed,confidence:e.frame.confidence,refs:e.refs.map(e=>({block:e.block,lang:e.lang,why:e.reason})),intent:e.intents[0]?{id:e.intents[0].id,score:e.intents[0].score}:void 0})),asks:n.asks.slice(0,12),intents:n.intents,summary:n.summary})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{text:{type:"string",description:"混合內容的文字"},file_id:{type:"string"},path:{type:"string"}},additionalProperties:!1}),e("mix_highlight","把一份混合內容（英文敘述夾著 PHP、HTML、JavaScript、GLSL 著色器、TOML、INI、Python、CSS、JSON、YAML、shell、SQL、錯誤輸出…）自動切段、認出每段的語言並逐詞著色，不用事先標記。每一段有語言、信心度與依據（明確記號或逐行評分）；不確定的段落標「不確定」。區段裡專有的識別字會被學成該語言的詞（存起來，下次更準）。回傳區段清單，並產生一份 HTML 下載附件（暗色主題、每段有語言標籤與行號）；附件卡片上有「🪟 檢視器」按鈕，開一個跳出的浮動視窗檢視（open:true 會直接開）。來源三選一：text、file_id、path。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._mixAnalyze(t);if(!e.ok)return JSON.stringify(e);const n='<!doctype html><meta charset="utf-8"><title>混合內容語法高亮</title><body style="background:#1e1e1e;margin:12px">'+FaMix.toHtml(e.r)+"</body>",r=new Blob([n],{type:"text/html"}),a=await this.fileCache.put("mixed-highlight.html","text/html",r,"uploaded"),s={ok:!0,source:e.source,languages:e.r.languages,blocks:FaMix.describe(e.r),html_file_id:a,filename:"mixed-highlight.html"};return await this._deliverToolResultFile(s,"html_file_id",e=>"📎 混合內容語法高亮："+e.filename),!0===t.open&&this._openHtmlViewer(s.filename,n,a),JSON.stringify(s)}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{text:{type:"string",description:"混合內容的文字"},file_id:{type:"string"},path:{type:"string"},open:{type:"boolean",description:"true＝直接開檢視器視窗（預設只放下載卡片，卡片上有「檢視器」按鈕）"}},additionalProperties:!1}),e("log_learn",NaN,async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._logLearn(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{text:{type:"string",description:"貼上的日誌文字"},file_id:{type:"string",description:"上傳檔案的 file_id"},path:{type:"string",description:"（桌面版）日誌檔的絕對路徑"},name:{type:"string",description:"（選填）格式名稱，之後用它指定"},confirm:{type:"boolean",description:"預設 true：放卡片讓使用者確認；false 直接存"},kind:{type:"string",enum:["log","config","grammar"],description:"（選填）強制當日誌、章節式設定檔或自己長文法；省略＝自動判斷"},extend:{type:"string",description:"（選填）已存的文法名稱：讀這份新樣本，讓那份文法繼續長"},max_lines:{type:"integer",description:"最多分析幾行（預設 50000）"}},additionalProperties:!1}),e("log_triage",'把貼上的一段文字逐行分成三種：A＝使用者自己說的話、B＝程式印出來的 log、C＝堆疊的一層。含中文的句子也可能是 log，所以不看有沒有中文：堆疊由解析器判定，log 由專案索引核對（要跟索引記錄的 log 格式字串對得上），都不是的行才算「認不出」。action:triage（預設）回傳每行的分類與「認不出」的行，每個認不出的行附一題選擇題（A／B／C）；你回答後用 action:answer（answers 填 {"行號":"字母"}）交給程式核對——你說 B 但索引沒有這個訊息，程式會改回 A。root 是專案資料夾（要有資料庫索引，沒有索引就只做堆疊判斷）。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._repoTriage(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{root:{type:"string",description:"專案資料夾：fap:<名稱>，或桌面版的絕對路徑"},text:{type:"string",description:"貼上的全文"},action:{type:"string",enum:["triage","answer"]},answers:{type:"object",description:'answer：{"行號":"A|B|C"}'}},required:["text"],additionalProperties:!1}),e("log_ask",'對學過（或剛 log_learn 過）的日誌做摘要與問答，全是程式查詢：「摘要」「哪個錯誤最多」「錯誤什麼時候第一次出現」「有幾筆錯誤」「欄位 xxx 的值分布」「最忙的時段」「模板有哪些」「找 「xxx」在哪些行」。text 只給一行日誌＝問「這一行是什麼意思」（比對到哪個模板、欄位值、這種紀錄的統計）。開放式問題（原因、建議）程式不亂答，會回傳 kind:"open" 與精簡的模板統計脈絡（不是整份日誌），請你根據脈絡回答。要指定日誌：format（學過的格式名稱，省略＝最近一份）或直接帶 text／file_id／path 現學現問。找某個值需要原始行：同一個對話裡剛 log_learn 過的有，只存在訓練器裡的沒有（會明說需要檔案）。**設定檔**（INI／TOML／EDK2）的問法：「[database] 有哪些設定」「workers 設成多少」「哪些是布林／GUID／路徑」「有沒有重複的鍵」「Sources 有哪些原始檔」；text 給一行 key = value＝查這個鍵現在的值與型別；帶 other_text／other_file_id／other_path（另一份設定檔）＝比較兩份差在哪（改值、新增、移除）。機密欄位的值一律顯示為已遮蔽。**自己長出文法的格式**（YAML、BitBake、nginx…）：「SRC_URI 被怎麼設定」（列出所有操作與修飾，依順序）、「services.web.image 是什麼」（用路徑）、「services.web 有哪些設定」、「哪些用了 += 」、「有哪些 inherit」「有哪些函式」、「文法」（EBNF）、「antlr」（ANTLR 風格）、「bison」（遞迴的產生式，bison 風格）、「分析表」（LALR 狀態與 shift／reduce／goto）、「衝突」（shift/reduce、reduce/reduce）、「斷點」（哪幾行合成一個陳述、為什麼、續行符號與終結符號）；text 給一行＝同時回答 LALR 分析表接不接受它、卡在哪個 token、這裡本來可以接受什麼。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._logAsk(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{question:{type:"string",description:"問題；省略＝摘要"},format:{type:"string",description:"學過的格式名稱（省略＝最近一份）"},text:{type:"string",description:"一行日誌或一行 key = value（問這一行是什麼）、或整份日誌／設定檔文字"},file_id:{type:"string"},path:{type:"string"},other_text:{type:"string",description:"（設定檔比較）另一份設定檔的文字"},other_file_id:{type:"string"},other_path:{type:"string"},kind:{type:"string",enum:["log","config","grammar"]}},additionalProperties:!1}),e("webedit_open",'在對話裡放一個「網頁編輯器」（AI 輔助的小網站編輯器）：預覽、程式碼（HTML／CSS／JS 多個檔）、模擬後端（JS 的 Node 風格或 Python Flask／FastAPI；全部在頁面內執行、不佔埠，fetch／WebSocket／EventSource 都由它回應，資料持久，可匯出 Node／Cloudflare 部署檔），右邊用對話修改（頁面直接改；後端會交給程式設計專家並先在沙盒測過）、附圖、復原／重做、摘要成 prompt，進度會保留。參數：starter（起手式：blank、todo、chat、form、python_api）、或 request（一句話描述要做的網站，AI 先做出第一版）、或 spec（整份描述，格式見 webedit_topic）、或 id（重新打開之前的專案）。做完編輯器就在對話裡了，不要再把程式碼貼到對話。PHP 目前不能在瀏覽器裡執行。參數: {"starter":"todo","request":"（選填）","spec":{},"id":"（選填）"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._webeditOpen(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{starter:{type:"string",description:"起手式：blank、todo、chat、form、python_api"},request:{type:"string",description:"一句話描述要做的網站"},spec:{type:"object",description:"整份專案描述"},id:{type:"string",description:"重新打開之前的專案"},title:{type:"string"}},additionalProperties:!1}),e("webedit_topic",'查網頁編輯器的說明：topic=format（專案描述格式）、edits（編輯動作）、backend（模擬後端怎麼寫、語言限制）、starters（起手式清單）。參數: {"topic":"backend"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaWebEdit.TOPICS,r=String(t.topic||"");return JSON.stringify(n[r]?{ok:!0,topic:r,text:n[r]}:{ok:!0,topics:Object.keys(n)})},{type:"object",properties:{topic:{type:"string",enum:["format","edits","backend","starters"]}},additionalProperties:!1}),e("worksheet_make",'做一份學習單／練習卷（教育文書）：程式讀請求 → 排版成 SVG/HTML → 輸出 PDF（向量）＋預覽圖 PNG＋可再微調的 HTML，三個檔案都會變成下載卡片。現成的有：串珠「10又幾」（金色珠加幾顆彩色珠、右邊橫線填數字）、數的組成（二元樹：每格一直排積木、紅圈樹根、藍圈兒子寫數字）、數一數、十格框、數線、加減法算式；現成的做不到就用 draw（自由繪圖區塊，圓／方框／線／多邊形／文字，座標是百分比，見 worksheet_topic）自己畫，不要回答「模板不支援」。request＝使用者的原話（不要改寫）；有參考圖片就帶 reference_file_id（視覺模型只被問一小段 JSON：每串顆數與顏色，程式檢查後才採用）。也可以直接給 spec（描述格式見 worksheet_topic）。回傳 worksheet_id、notes（程式用了哪些預設）、questions（有歧義、已先用預設的地方）。參數: {"request":"使用者的原話","reference_file_id":"（選填）參考圖片","spec":{"（選填）整份學習單描述"}}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._worksheetMake(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{request:{type:"string",description:"使用者要的學習單（原話）"},template:{type:"string",description:"（選填）範本 id：blank、draw_area、bead_rows、number_bond、count_rows、ten_frames、number_line、equations，或使用者存的 user_…；見 worksheet_topic(templates)"},reference_file_id:{type:"string",description:"（選填）參考圖片的 file_id"},spec:{type:"object",description:"（選填）整份學習單描述，格式見 worksheet_topic"}},additionalProperties:!0}),e("worksheet_adjust",'調整剛做好的學習單（人工調整，不是重新生成）：edits 是一組封閉的編輯動作，例如改標題、改某一串的顏色、改串數、教師版附答案、換橫式、加減區塊。改完重新輸出 PDF／預覽圖／HTML。動作清單見 worksheet_topic({"topic":"edits"})。參數: {"edits":[{"op":"set_color","count":3,"color":"#F2D4CF"}],"worksheet_id":"（選填，預設最近一份）"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._worksheetAdjust(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{edits:{type:"array",items:{type:"object"},description:'編輯動作，例如 {"op":"set_title","text":"…"}'},worksheet_id:{type:"string"}},required:["edits"],additionalProperties:!1}),e("worksheet_open",'在對話裡放一個「學習單編輯器」小工具（可以直接在裡面用對話或屬性面板改、附圖、復原／重做、把編輯過程摘要成 prompt；進度會保留，之後可以接著改）。worksheet_make 做完會自動放一個；用這個工具來：重新打開某一份（worksheet_id）、接著最近一份、或開一份空白的讓使用者自己從對話開始做。參數: {"worksheet_id":"（選填，預設最近一份）","blank":false}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{let e=!0===t.blank?null:await this._wsLoadSpec(t.worksheet_id);if(!e){if(t.worksheet_id&&!0!==t.blank)return JSON.stringify({ok:!1,error:"找不到這份學習單："+t.worksheet_id});e={id:this._wsStoreSpec(FaWorksheet.validate({title:"學習單",blocks:[]}).spec)}}return this._wsPushEditor(e.id),JSON.stringify({ok:!0,worksheet_id:e.id,note:"編輯器已經放在對話裡了；告訴使用者可以直接在裡面改，不要再重複描述裡面的內容。"})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{worksheet_id:{type:"string"},blank:{type:"boolean",description:"true＝開一份空白的"}},additionalProperties:!1}),e("worksheet_topic",'查學習單的進階說明：topic=format（描述格式與每種區塊的欄位）、templates（範本清單）、draw（自由繪圖區塊）、number_bond（數的組成）、edits（調整動作清單）、reference（用參考圖片的做法）、colors（串珠標準色）。參數: {"topic":"format"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaWorksheet.TOPICS,r=String(t.topic||"");return"templates"===r?JSON.stringify({ok:!0,topic:r,text:n.templates,templates:FaWorksheet.listTemplates(this._wsUserTemplates()).map(e=>({id:e.id,name:e.label,about:e.desc,group:e.group}))}):JSON.stringify(n[r]?{ok:!0,topic:r,text:n[r]}:{ok:!0,topics:Object.keys(n),note:'用 {"topic":"format"} 等查看'})},{type:"object",properties:{topic:{type:"string",enum:["format","templates","draw","number_bond","edits","reference","colors"]}},additionalProperties:!1}),e("ask_user_card",'在對話裡放一張「互動卡片」讓使用者填（表單或多步驟 wizard），等使用者送出後把回應交給你。用在「需要使用者從幾個選項裡決定、或補幾個欄位」而你不該替他猜的時候，比用文字一題一題問快。使用者看到的是勾選／單選／下拉／文字框，送出後卡片變唯讀；回應只回傳給這個工具，不會變成使用者訊息。規格 spec：{title, description, questions:[…]}（單張表單）或 {title, steps:[{id,title,questions,next:[{when:{q,eq|in|has|nonEmpty},goto:步驟id|"done"}]}]}（wizard，next 沒寫就依序）。題目 {id, type, label, hint, required, default, showIf:{q,eq|in|has|nonEmpty}, media:{text,image(https或data:image),html(可互動的 widget，在沙盒 iframe，用 window.faCard.answer(值) 回傳；type 要是 widget),height}}。type：single（單選）、multi（多選，minSelect／maxSelect）、dropdown、text、textarea、number（min／max）、color、widget、info（只顯示）。single／multi 的選項 {id,label,desc,image,color(#rrggbb 色塊),extra:{kind:"text"|"select",options,required}}：extra 是選項後面的文字框或下拉（選到那個選項才能填）；題目還可以有 after:[{id,kind:"text"|"select",label,options}] 固定接在選項後面。id 一律英文字母開頭。回傳 {ok,confirmed,status,answers:{題目id:值,"題目id.選項id":後面欄位的值},summary:[…]}；confirmed=false 是使用者取消；如果回傳 skipped:true 與 supplement，代表使用者沒點選項、直接打字回答，那段文字就是他的回答與補充條件，照它做。只在計畫真的有分歧（幾條做法差很多、缺必要資訊又沒有合理預設、動作不可逆）時才問，每題要標出建議的選項，一次最多問2到3題，其餘用預設值並在計畫裡註明。需要依回應決定下一張卡片：用這個工具兩次，第二次的規格依第一次的回應來寫。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=t.spec&&"object"==typeof t.spec?t.spec:t,r=await this.askCard(n);return r.ok?r.useRecommended?JSON.stringify({ok:!0,confirmed:!1,skipped:!0,use_defaults:!0,answers_so_far:r.flat,note:"使用者說之後都不要再問、統一用建議的：這題不用他回答，請用你認為最合理的預設做，並在回覆裡簡短說你用了什麼；之後同類的分歧也直接用建議的，不要再用這個工具問。"}):r.supplement?JSON.stringify({ok:!0,confirmed:!1,skipped:!0,status:r.status,supplement:r.supplement,answers_so_far:r.flat,note:"使用者沒有用卡片作答，改成直接打字回答（內容在 supplement，也已顯示在對話裡）。請把它當成使用者對這個問題的回答與補充條件，照它調整做法；不要當成使用者取消，也不要把同一題再問一次。"}):JSON.stringify({ok:!0,confirmed:r.confirmed,status:r.status,answers:r.flat,summary:r.summary,steps:r.steps}):JSON.stringify({ok:!1,error:r.error,hint:"修正規格後再呼叫一次"})},{type:"object",properties:{spec:{type:"object",description:"卡片規格：{title,description,questions} 或 {title,steps:[…]}，欄位見工具說明"}},required:["spec"],additionalProperties:!0}),e("uml_guide","用互動卡片一步一步引導使用者把「情境」設計成 UML 與程式骨架：程式先讀情境（參與者、使用案例、類別），再用卡片問使用者真正需要決定的事——語言與套件、要實作哪些使用案例（可以勾掉或補一句）、架構風格，接著依這些回應產生第二張卡片（平手的設計抉擇必須使用者選，其餘有帶程式的建議值），最後確認，才依答案產生設計、專案 zip 與設計檢視器。全程不需要 AI 或模型生成 UML，弱的 AI／離線模型也能用；使用者的回應只回傳給這個工具。情境要用「<參與者>可以<動作><名詞>」的句型（例如「顧客可以加入購物車並結帳付款」）；讀不出來會回報，不會編造。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlGuide(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{scenario:{type:"string",description:"情境（使用者故事、需求文字）"},language:{type:"string",enum:["python","typescript","java"],default:"python"},package:{type:"string"},constraints:{type:"object",description:"（選填）已經決定的抉擇，卡片會用它當預設值"}},required:["scenario"],additionalProperties:!1}),e("uml_design","用「這台電腦上的離線小模型」把情境一步一步設計成 UML 再產生程式骨架：程式把設計拆成封閉的小問題（參與者與使用案例 → 類別 → 每個類別的屬性與操作 → 關係 → 呼叫順序），模型一次只回答一個、每個回覆都被驗證，之後只重做有問題的那一區（top-down rework），再用 design_choices 的規則選架構與 library。比較強的線上 AI 不需要這個：自己寫 UML 文字直接呼叫 uml_to_code 更快更準。這是線上模型的補救能力：大問題自己一次做不完時用它。大問題會先由程式切成小塊（依句子，每塊一個領域），每塊各自一次一小題拆完，再合併成一份。預設用目前的線上模型（體檢結果是「程式先讀情境」的除外，那種改用離線模型或 uml_guide）；model 可以指定 offline（離線小模型，第一次要下載）或 online。回傳的 model_used 說明這次用了哪個。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlDesign(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{scenario:{type:"string",description:"情境（使用者故事、需求文字）"},language:{type:"string",enum:["python","typescript","java"],default:"python"},package:{type:"string"},constraints:{type:"object",description:"（選填）指定抉擇"},model:{type:"string",enum:["offline","online"],description:"（選填）用離線小模型或線上模型；不指定就自動選"}},required:["scenario"],additionalProperties:!1}),e("browser_task","穩定地操作瀏覽器完成一件事（比一個一個呼叫 browser_* 工具穩，離線小模型、會亂來的模型一律用這個）：先把每個動作計畫好，再由程式檢查（動作要真的存在、型別對、狀態接得上——沒開分頁不能點、沒觀察過元素不能按座標、換頁或點擊後要重新看元素、不接受 javascript:／file: 網址、不替使用者輸入密碼或卡號），通過才執行；每做到一次觀察（讀頁面、列元素）就依看到的內容重新計畫下一批；失敗會重新觀察再計畫。goal＝要做什麼（含網址最好）。可以自己給 steps（強模型的計畫也會被同樣檢查）：每步 {do, ...}，do 只能是 open(url)／goto(url)／back／reload／read／look／click(x,y，座標來自剛做的 look)／click_text(text 或 selector)／type(text，要先 click 輸入框或給 selector，submit:true 會按送出)／key(key)／scroll(direction)／wait_download／close／finish。手動模式（預設）會先把計畫給使用者看、同意才連線；有副作用的步驟（送出、付款、刪除、發佈、登入…）兩種模式都一定先問使用者。擴充功能還沒連上會等一下（有逾時），連不上通常是瀏覽器停在「誰在使用 Chrome？」設定檔選擇器——要請使用者自己選，不要替他選帳號。回傳做了哪些動作、最後的頁面文字與可點的元素。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._bcPlanRun(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{goal:{type:"string",description:"要做什麼（原話，含網址）"},steps:{type:"array",items:{type:"object"},description:"選填：自己排好的步驟（會被檢查）"},mode:{type:"string",enum:["manual","auto"]},max_rounds:{type:"integer"},wait_ms:{type:"integer",description:"等擴充功能連上的毫秒數，預設 25000"},once:{type:"boolean",description:"只做第一批就回傳"},use_model:{type:"boolean"}},required:["goal"]}),e("plan_route","找不到工具時用這個，不要猜也不要說做不到：把需求排成一條可以走的路線。程式判斷需求是哪一類——要對外部世界做事（寄信、發文、付款：問使用者提供 API、或用瀏覽器控制操作網頁版、或寫好範本由使用者自己送）、用現成模型（翻譯、語音、辨識：Hugging Face／離線模型）、寫程式（桌面版 Python／JavaScript／bash；網頁版 Python（Pyodide）／JavaScript／bash（busybox 模擬））、或先用 UML design 拆的大系統。回傳路線、步驟與閘門：手動模式（預設）先把計畫送給使用者、問要不要；自動模式直接做；有副作用的步驟（寄出、發佈、付款、刪除）兩種模式都一定先問使用者。message 是可以直接給使用者看的計畫文字；uml_issue 可以餵給 uml_edit 的 issues，把缺的能力補進 UML。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._routePlan(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{need:{type:"string",description:"要做的事（原話）"},mode:{type:"string",enum:["manual","auto"],description:"不給就用 /route 的設定"},api_provided:{type:"boolean",description:"使用者已經提供了 API"}},required:["need"]}),e("register_designed_tool",'把「UML design 設計、再用程式實現」的功能登記成工具（runtime 設計的工具）。登記後它跟內建工具一樣：有名稱、說明、參數結構，食譜（CoLU 的選擇題＋程式填欄位）挑得到、工具反思搜得到、離線模式也能呼叫；到 Advance Settings「設計出來的工具」可以管理。name＝英文字母數字底線；description＝一句話說明（搜尋與路由都靠它，寫使用者平常會怎麼說）；parameters＝JSON Schema（{type:"object",properties:{…},required:[…]}，欄位要有 description，食譜才補得對）；handler＝JavaScript 處理程式的本體（參數在 args，可以 await，回傳值就是結果；只能用瀏覽器內的功能）；uml 與 scenario 選填，留著以後修改設計用。同名會更新。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(this._designedRegister(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{name:{type:"string"},description:{type:"string"},parameters:{type:"object",description:"JSON Schema"},handler:{type:"string",description:"JavaScript 處理程式本體（args 是參數物件）"},uml:{type:"string",description:"設計用的 UML（文字 DSL）"},scenario:{type:"string"},enabled:{type:"boolean"}},required:["name","description","handler"]}),e("intent_parse","從文字描述（議題追蹤 ITS 的描述、使用者的話、測試需求）讀出「意圖」：做了什麼行為（動詞＋物件）、實際看到什麼、期待什麼、怎麼驗證；明確寫的與隱含的分開標（implicit:true＋依據）——壞掉的現象反過來就是隱含的期待（「無法開機」→「應該能開機」），沒有驗證步驟就補一個隱含的（照重現步驟再做一次）。缺什麼（重現步驟、預期結果、環境）不猜，列成封閉的小問題。uml:true 順便產生 UML（重現與驗證的使用案例，可接 uml_to_code）；testcase:true 產生測試案例（前置、步驟、預期、迴歸案例）；match:true 用雙語的意象去配現有工具（例如配 testcase writer／testcase design 這類工具）。離線模式下會用中英互譯讀懂程式認不得的句子。這是 intent-to-bugfix、intent-to-testcase 的第一步，下一步照 uml_design／食譜／工具做。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._intentParse(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{text:{type:"string",description:"描述原文（不要改寫）"},kind:{type:"string",enum:["bugfix","testcase","feature"],description:"不填＝程式判斷"},uml:{type:"boolean"},testcase:{type:"boolean"},match:{type:"boolean"},translate:{type:"boolean",description:"讀不出的句子先中英互譯（離線模式預設開）"}},required:["text"]}),e("skill_compile","把技能（內建的或匯入的 SKILL）讀成「食譜」：程式讀 SKILL.md 抽出步驟與用到的工具、依欄位名稱與型別綁到手上有的東西（附件、網址、使用者的話、聲音／語速／語言），編成可重複執行的食譜；最後一步交給呼叫端執行。對不上的步驟（沒指名工具、工具不存在、要跑腳本、必填欄位綁不到）不猜，列成「缺口」，附相近的現有工具或給 uml_design 的情境。design＝true：缺的能力直接用 uml_design 設計、登記成「待實作」的設計工具（草稿）；處理程式補上並啟用後再編一次，缺口就對上它。有缺口的是草稿（不會自動使用）。skill＝技能名稱（省略＝全部啟用中的技能）；save＝true 才存下來。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._skillCompile(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{skill:{type:"string",description:"技能名稱（省略＝全部）"},save:{type:"boolean",description:"true＝存成食譜（草稿或已編好）"},design:{type:"boolean",description:"true＝缺口用 UML design 設計並登記成待實作的設計工具（手動模式會先問你）"}}}),e("list_designed_tools","列出 runtime 設計出來的工具（名稱、說明、參數、是否啟用、執行次數、最近的錯誤）。",async function(){return JSON.stringify({ok:!0,tools:this._designedList()})},{type:"object",properties:{}}),e("remove_designed_tool","刪除一個 runtime 設計出來的工具（只刪登記，不影響內建工具）。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}return JSON.stringify(this._designedRemove(String(t.name||"")))},{type:"object",properties:{name:{type:"string"}},required:["name"]}),e("llvm_execute",'LLVM IR 的執行環境（跟 python_execute、bash_execute 一樣是程式開發工具）：給一份 LLVM IR 文字，在這裡編成 WebAssembly 並執行，回傳 stdout／stderr／結束碼；IR 有錯會指出行號。不需要 clang 或 llc。用途：驗證手寫或模型產生的 IR、教學、把 UML 產生的 IR（uml_to_wasm）改過再跑、做小型的底層實驗。emit：run（預設，編譯並執行）、check（只檢查）、wasm（編成 .wasm 並交付檔案）。支援範圍（第一版）：i1／i8／i32／i64／double、指標（ptr 或 T*）、struct、陣列、字串常數（c"..."）、全域變數、br／if／迴圈、直接呼叫、記憶體讀寫、整數與浮點運算、型別轉換；進入點是 @_start（void）或 @main（回傳結束碼）。內建的 libc：puts、putchar、getchar、malloc、calloc、free、strlen、memcpy、memset、memcmp、strcmp、abs、exit（宣告了就自動連結；printf 這類可變參數函式不支援，用 puts／putchar）；WASI：fd_write、fd_read、args_get、environ_get、clock_time_get、random_get、proc_exit。不支援：phi、例外、函式指標、可變參數、float（只有 double）、有號的 i8／i1 比較（先 sext）。預設有步數上限（一億次區塊轉換），無窮迴圈會被中止並說明；fuel 給 0＝不設上限。終端機裡也有同樣的指令：lli（執行）、llc（編譯；-c 產生物件檔）、llcheck（檢查）、llink（連結多個檔案）、wasmrun（執行 .wasm）；物件檔放在 /mnt 底下就是存進 File Access Point。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._llvmExecute(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{ir:{type:"string",description:"LLVM IR 文字"},emit:{type:"string",enum:["run","check","wasm"]},args:{type:"array",items:{type:"string"},description:"程式的命令列參數"},stdin:{type:"string"},env:{type:"object"},fuel:{type:"integer",description:"步數上限（區塊轉換次數），0＝不限"},name:{type:"string"},modules:{type:"array",items:{type:"object"},description:"選填：要一起連結的其他檔案 [{name, ir}]（ir 可以是 .ll 文字，也可以是 llc -c 產生的物件檔文字）；連結器會解決符號、擋重複定義與簽名衝突"}},required:["ir"]}),e("uml_to_wasm","把 UML 設計編成 LLVM IR 再編成 WebAssembly（wasm32-wasi），在這裡真的跑一次並驗證：類別→struct、操作→函式、使用案例→會依序呼叫操作的函式；執行輸出必須跟 UML 預期的呼叫軌跡一致才算通過。產出 model.ll（LLVM IR 文字）、model.wasm、run.js（用 node 跑）。第一版範圍：整數、浮點、布林、字串、類別的欄位與方法、使用案例的呼叫順序；不含繼承的虛擬呼叫、例外、容器（List／Map 用空指標代替並警告）。不需要 clang 或 llc。uml 是文字 DSL（跟 uml_to_code 一樣）；不給 uml 就用最近一次 uml_design／uml_guide 的設計。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlToWasm(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{uml:{type:"string",description:"UML 文字 DSL（選填）"},session:{type:"string"},run:{type:"boolean",description:"false＝只編譯不執行"}}}),e("uml_edit",'編修進行中的 UML 設計（uml_design／uml_guide 產生的那一份）：反思或決策的結論要對應到「補哪裡、刪哪裡」，這個工具就是把它套上去並重建專案。ops＝編修指令陣列（每個都被程式驗證，會讓設計出錯的會被退回並說明原因）：add_actor／remove_actor（name）、add_class（name、kind、members:["pay(amount:float):bool","total:float"]）、remove_class（name；相關關係與呼叫步驟程式一併收拾）、rename_class（from、to）、add_member（cls、member）、remove_member（cls、name）、add_relation（from、to、kind: assoc/inherit/implement/compose/aggregate/depend）、remove_relation（from、to）、add_usecase（name、actor、steps:["Cart.add(item)","Order.pay(x)"]）、remove_usecase（name）、add_step（usecase、step、at）、remove_step（usecase、to、msg 或 at）。auto_fix＝true 會讓程式找出問題（沒人用的類別、空類別、太短的呼叫順序），每個問題列出候選編修給小模型挑編號（挑不出來用程式的預設）。回傳改了什麼（changes）、被退回的原因、剩下的問題、編修後的 UML。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._umlEdit(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{session:{type:"string",description:"工作階段 id（不給就用最近一個）"},ops:{type:"array",items:{type:"object"},description:"編修指令"},auto_fix:{type:"boolean",description:"讓程式找問題、小模型挑修法"},use_model:{type:"boolean",description:"false＝不問模型，全用程式的預設修法"}}}),e("images_to_pdf",'把圖片合成一份PDF：可以指定順序，每一頁可以縮放、旋轉、做影像處理（灰階、影像強化、色調強化、減少色彩、高斯模糊、馬賽克…）。純本地、不經過AI、幾秒完成。使用者說「圖片轉PDF／合併成PDF／縮放到A4／旋轉／灰階／影像強化／減色／模糊／馬賽克」就直接用這個，不要自己寫Python（沙盒裡沒有Pillow，裝不起來）、也不要用ImageMagick。\n【最簡單】不給任何參數＝這個對話附加的全部圖片，依檔名的數字順序（1_、2_…10_，不是上傳順序）一張一頁。\n【格式】副檔名不重要，用檔案內容判斷：jpg／jpeg／jfif／png／gif／webp／bmp／ico／avif／svg／tiff（第一頁）／heic／heif 都可以（沒有副檔名、副檔名亂寫也行）；tga／psd／raw 這類不支援，請使用者先轉成 jpg 或 png。folder 沒給pattern時只收看起來像圖片的副檔名；給 pattern（例如 "*"）就全收、用內容判斷。\n【來源】files＝file_id或檔名（照你給的順序）；pages＝每頁一個物件（順序就是頁序）；folder＝整個資料夾（fap:名稱/路徑，或桌面版的絕對路徑，依檔名自然排序，pattern可篩例如"*.jpg"）；sort：none／name／name_desc／modified／reverse。\n【頁面】page_size：fit（頁面＝圖片大小，預設）、a3／a4／a5／b5／letter／legal，或"210x297mm"；orientation：auto（寬圖用橫的，預設）／portrait／landscape（使用者說「都是直式A4」用portrait）；fit：contain（整張放進頁面、等比、置中＝「Zoom／縮放置中」，預設）／cover（填滿、超出的裁掉）／stretch（拉伸變形）／actual（原始大小，太大才縮）；zoom：在fit結果上再縮放的百分比（80＝留邊）；margin：pt（預設0）；background：頁面底色（預設白）。\n【處理 ops】依序執行，放在頂層＝所有頁面共用，放在pages[i].ops＝只作用那一頁。每個是{"op":名稱,…}：grayscale（灰階）、enhance（影像強化：自動對比＋銳化＋飽和度）、tone（色調強化：自動白平衡＋對比＋飽和度；可帶contrast／saturation／warmth／white_balance）、reduce_colors（減少色彩，colors 2～256，dither:true抖色）、blur（高斯模糊，radius＝標準差像素）、mosaic（馬賽克，block＝格子像素；region:{x,y,w,h}百分比只蓋一塊，不給＝整張）、sharpen、auto_contrast、brightness／contrast／saturation（amount -100～100）、gamma（value）、threshold（黑白二值，預設Otsu）、posterize、invert、rotate（degrees順時針，任意角度）、scale（改圖片像素：percent／width／height／max_side）、crop（x,y,w,h百分比，unit:"px"用像素）、flip（direction）。pages[i].rotate、pages[i].scale是縮寫（最先做）。注意：scale改的是圖片像素，zoom改的是它在頁面上的大小。\n【輸出】filename；output_path（fap:名稱/資料夾，或桌面版的絕對路徑，把PDF存到那裡）；不給output_path＝只產生下載附件。on_error：fail（預設，有一張壞就整份不做並說是哪一張）／skip。參數有錯會整份不處理，訊息說是哪一頁哪個參數。回傳{ok,pdf_file_id,filename,pageCount,pages:[{source,input,output,ops,page_mm}],saved_to?,warnings?}。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await this._imagesToPdfAdvanced(t,e=>this._log("🖼️→📄 "+e));return await this._deliverToolResultFile(e,"pdf_file_id",e=>`📎 已把 ${e.pageCount} 張圖片合成PDF：${e.filename}（${(e.sizeBytes/1024).toFixed(0)}KB）${e.saved_to?"，已存到 "+e.saved_to:""}`,"images_to_pdf"),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{files:{type:"array",items:{type:"string"},description:"（選填）圖片 file_id或檔名，照這個順序一張一頁；留空＝這個對話附加的全部圖片（依檔名數字順序）"},pages:{type:"array",description:"（選填）每頁一個物件，順序＝頁序；要逐頁不同的旋轉／縮放／處理時用",items:{type:"object",properties:{file:{type:"string",description:"file_id、檔名、fap:名稱/路徑 或 桌面版絕對路徑"},rotate:{type:"number",description:"順時針角度（90、-90、180、15…）"},scale:{type:"number",description:"圖片像素縮放百分比（50＝縮成一半）"},ops:{type:"array",items:{type:"object"},description:"只作用這一頁的處理（接在全部頁面共用的ops後面）"},zoom:{type:"number"},fit:{type:"string"},page_size:{type:"string"},orientation:{type:"string"},margin:{type:"number"},background:{type:"string"}},required:["file"]}},folder:{type:"string",description:"（選填）整個資料夾的圖片：fap:名稱/路徑，或桌面版絕對路徑，依檔名自然排序"},pattern:{type:"string",description:'（選填）folder的檔名篩選，例如 "*.jpg"'},sort:{type:"string",enum:["none","name","name_desc","modified","reverse"],description:"（選填）排序：預設——有給files/pages＝照給的順序，folder／附件＝依檔名自然排序"},ops:{type:"array",items:{type:"object",properties:{op:{type:"string",enum:["grayscale","enhance","tone","reduce_colors","blur","mosaic","sharpen","auto_contrast","brightness","contrast","saturation","gamma","threshold","posterize","invert","rotate","scale","crop","flip"]}},required:["op"],additionalProperties:!0},description:'（選填）所有頁面共用的處理，依序執行，例如 [{"op":"enhance"},{"op":"grayscale"}]'},page_size:{type:"string",description:'（選填）fit（預設）／a3／a4／a5／b5／letter／legal／"210x297mm"'},orientation:{type:"string",enum:["auto","portrait","landscape"],description:"（選填）預設 auto"},fit:{type:"string",enum:["contain","cover","stretch","actual"],description:"（選填）contain（預設，等比置中）／cover（填滿裁切）／stretch／actual"},zoom:{type:"number",description:"（選填）頁面上再縮放的百分比，80＝留邊"},margin:{type:"number",description:"（選填）頁面邊界 pt，預設 0"},background:{type:"string",description:'（選填）頁面底色，例如 "#ffffff"（預設白）'},dpi:{type:"number",description:"（選填）fit／actual 用：像素換成實際大小的解析度（預設 96）"},format:{type:"string",enum:["auto","jpeg","png"],description:"（選填）嵌進PDF的格式：auto（預設；減色／二值化用png，其餘jpeg）"},jpeg_quality:{type:"number",description:"（選填）0.3～1，預設 0.92"},filename:{type:"string",description:"（選填）輸出檔名"},output_path:{type:"string",description:"（選填）把PDF存到：fap:名稱/資料夾 或桌面版絕對路徑（資料夾或完整 .pdf 路徑）"},on_error:{type:"string",enum:["fail","skip"],description:"（選填）有圖壞掉時：fail（預設）／skip"},max_pixels:{type:"number",description:"（選填）單張處理前的像素上限（預設約 6000 萬，超過先縮小）"}},additionalProperties:!1}),e("remove_pdf_pages",'移除PDF指定頁面，回傳移除後的新PDF（複製剩餘頁面的原始物件，不重新渲染，文字仍可選取/搜尋）。pages用頁碼範圍語法：逗號分隔、可以用"start-end"區間、順序不重要、重複頁碼會自動忽略、結尾多餘逗號沒關係，例如"1-5,6"或"6,2,2,1-3,"都合法。回傳{ok, pdf_file_id, filename, sizeBytes, originalPageCount, removedPages, remainingPageCount}，成功時會自動產生下載附件。⚠️不支援有密碼保護的PDF；移除後如果會變成0頁會直接報錯，不會產生空白PDF。參數: {"file":"PDF的file_id或檔名","pages":"要移除的頁碼範圍，例如\\"1-5,6\\""}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file||t.file_id||"").trim(),r=String(t.pages||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file參數（PDF的file_id或檔名）"});if(!r)return JSON.stringify({ok:!1,error:'缺少pages參數（要移除的頁碼範圍，例如"1-5,6"）'});try{const e=await this._removePdfPages(n,r,e=>this._log("📄 "+e));return await this._deliverToolResultFile(e,"pdf_file_id",e=>`📎 已移除${e.removedPages.length}頁（剩${e.remainingPageCount}頁）：${e.filename}（${(e.sizeBytes/1024/1024).toFixed(1)}MB）`),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file:{type:"string",description:"PDF的file_id或檔名"},pages:{type:"string",description:'要移除的頁碼範圍，例如"1-5,6"'}},required:["file","pages"],additionalProperties:!1}),e("extract_pdf_pages",'把PDF指定頁面取出、變成一份新的PDF（複製原始頁面物件，不重新渲染，文字仍可選取/搜尋，輸出固定依頁碼由小到大排序，跟輸入範圍的先後順序無關）。pages用頁碼範圍語法：逗號分隔、可以用"start-end"區間、順序不重要、重複頁碼會自動忽略、結尾多餘逗號沒關係，例如"1-5,6"或"6,2,2,1-3,"都合法。回傳{ok, pdf_file_id, filename, sizeBytes, originalPageCount, extractedPages}，成功時會自動產生下載附件。⚠️不支援有密碼保護的PDF。參數: {"file":"PDF的file_id或檔名","pages":"要取出的頁碼範圍，例如\\"1-5,6\\""}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file||t.file_id||"").trim(),r=String(t.pages||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file參數（PDF的file_id或檔名）"});if(!r)return JSON.stringify({ok:!1,error:'缺少pages參數（要取出的頁碼範圍，例如"1-5,6"）'});try{const e=await this._extractPdfPages(n,r,e=>this._log("📄 "+e));return await this._deliverToolResultFile(e,"pdf_file_id",e=>`📎 已取出${e.extractedPages.length}頁：${e.filename}（${(e.sizeBytes/1024/1024).toFixed(1)}MB）`),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file:{type:"string",description:"PDF的file_id或檔名"},pages:{type:"string",description:'要取出的頁碼範圍，例如"1-5,6"'}},required:["file","pages"],additionalProperties:!1}),e("extract_pdf_images",'把PDF指定頁面整頁渲染成PNG圖片（是「該頁畫面長什麼樣子」的截圖，不是抽取頁面內容流裡個別的內嵌圖片物件——即使該頁是純文字/向量圖形也能正常輸出一張圖）。pages用頁碼範圍語法：逗號分隔、可以用"start-end"區間、順序不重要、重複頁碼會自動忽略、結尾多餘逗號沒關係，例如"1-5,6"。只指定1頁時直接回傳一張PNG；指定多頁時自動打包成一份zip（裡面每張圖檔名是pdf_image_{頁碼}.png），成功時會自動產生下載附件。回傳單頁時{ok, image_file_id, filename, sizeBytes, page, originalPageCount}；多頁時{ok, zip_file_id, filename, sizeBytes, originalPageCount, pages:[{page,filename,sizeBytes}]}。支援有密碼保護的PDF（會跳密碼輸入框）。參數: {"file":"PDF的file_id或檔名","pages":"要輸出成圖片的頁碼範圍，例如\\"1-5,6\\"","scale":"（選填）渲染解析度倍率，預設2，最高6，數字越大圖越清楚但檔案也越大"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file||t.file_id||"").trim(),r=String(t.pages||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file參數（PDF的file_id或檔名）"});if(!r)return JSON.stringify({ok:!1,error:'缺少pages參數（要輸出成圖片的頁碼範圍，例如"1-5,6"）'});try{const e=await this._extractPdfPageImages(n,r,{scale:t.scale},e=>this._log("🖼️ "+e));return e.ok&&e.image_file_id?await this._deliverToolResultFile(e,"image_file_id",e=>`📎 已輸出第${e.page}頁：${e.filename}（${(e.sizeBytes/1024).toFixed(0)}KB）`):e.ok&&e.zip_file_id&&await this._deliverToolResultFile(e,"zip_file_id",e=>`📎 已輸出${e.pages.length}張圖片並打包：${e.filename}（${(e.sizeBytes/1024/1024).toFixed(1)}MB）`),JSON.stringify(e)}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{file:{type:"string",description:"PDF的file_id或檔名"},pages:{type:"string",description:'要輸出成圖片的頁碼範圍，例如"1-5,6"'},scale:{type:"number",description:"（選填）渲染解析度倍率，預設2，最高6"}},required:["file","pages"],additionalProperties:!1}),e("compare_images",'把2~6張圖片「一起」交給支援讀圖(vision)的model比較（相同點/差異、哪一張符合某個描述、哪一張對應哪一張），比分別呼叫interpret_image再自己對照準確。圖片來源：file_id（📎附件、extract_pptx_images/extract_video_frames/browser_screenshot產生的圖片）或http(s)圖片網址，混用也可以。典型用途：拿投影片裡抽出的圖，跟影片幾個時間點的畫面比對，找出投影片圖片出現在影片的哪個時間，再用extract_clip_range剪那一段。參數: {"images":["file_id或網址",...],"question":"（選填）想比較什麼，例如"圖1（投影片）跟哪一張影格畫面最像？""}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=Array.isArray(t.images)?t.images.map(e=>String(e||"").trim()).filter(Boolean):[];if(n.length<2)return JSON.stringify({ok:!1,error:"images至少要給2張（file_id或圖片網址）"});if(n.length>6)return JSON.stringify({ok:!1,error:"images最多6張，太多張請分批比較（例如先各自縮小候選範圍）"});try{const e=[],r=[];for(const t of n){const n=/^(https?:\/\/|data:image\/)/i.test(t),a=await this._resolveImageInputForInterpretation(n?{imageUrl:t}:{fileId:t});e.push(a.dataUrl),r.push(a.label&&a.label.length>60?a.label.slice(0,57)+"…":a.label)}const a=await this._interpretImageWithVisionModel(e,t.question,r);return JSON.stringify({ok:!0,images:n.map((e,t)=>({label:`圖${t+1}`,source:r[t],ref:e})),model_used:a.modelUsed,vision_confirmed:a.visionConfirmed,comparison:a.description})}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{images:{type:"array",items:{type:"string"},description:"2~6個圖片來源：file_id或http(s)圖片網址；回答會用「圖1、圖2…」（照這個順序）稱呼它們"},question:{type:"string",description:"（選填）想比較什麼；不給就做一般的相同點/差異比較"}},required:["images"],additionalProperties:!1}),e("extract_video_frames",'擷取已上傳影片在「指定時間點」的畫面，每個時間點存成一張JPEG圖片（回傳每張的時間與file_id），之後可以用interpret_image看內容、或用compare_images跟其他圖片（例如投影片裡的圖）比對，找出內容對應的時間範圍。用關鍵影格查詢，長影片取幾個點也很快。參數: {"video":"影片file_id或檔名，留空用最近上傳的","times":[10,"1:20",95.5],"max_width":"（選填）輸出寬度px，預設640，範圍160~1280","quality":"（選填）JPEG品質0.3~0.95，預設0.8"}。times最多24個；不確定內容在哪時，先每隔一段時間（例如每30秒）取樣，比對後再對候選附近加密取樣縮小範圍。',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.video||t.file||t.file_id||"").trim(),r=await this._resolveUploadedFileRecord(n);if(!r)return JSON.stringify({ok:!1,error:n?`找不到符合「${n}」的影片`:"沒有可用的影片"});const a=(Array.isArray(t.times)?t.times:[t.times]).map(e=>this._parseTimeValue(e)).filter(e=>null!=e&&e>=0);if(!a.length)return JSON.stringify({ok:!1,error:'缺少times（秒數或"1:20"這種寫法的陣列）'});if(a.length>24)return JSON.stringify({ok:!1,error:"times最多24個，請分批取樣"});try{return JSON.stringify(await this._extractVideoFrames(r,a,t))}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{video:{type:"string",description:"影片的file_id或檔名；留空＝最近上傳的"},times:{type:"array",items:{},description:'要擷取畫面的時間點陣列，秒數或"1:20"/"0:01:20"字串，最多24個'},max_width:{type:"integer",description:"（選填）輸出寬度px，預設640，範圍160~1280"},quality:{type:"number",description:"（選填）JPEG品質0.3~0.95，預設0.8"}},required:["times"],additionalProperties:!1}),e("fetch_web_page",'抓取一個網頁的完整內容，轉成方便閱讀的Markdown文字後存進persistentStorage（跟使用者上傳檔案一樣會出現在list_uploaded_files清單裡）。browser_search只回傳標題+極短摘要，想深入了解某篇特定文章/頁面的完整內容時用這個工具抓下來，再視需要用parse_uploaded_file看細節、或內容很長時用summarize_large_text分段摘要。需要目前環境已經提供CORS代理能力才能運作，若回傳「找不到可用的CORS代理」錯誤，如實告知使用者這個限制，不要假裝抓取成功。只支援伺服器端直接回傳HTML的網頁，抓不到內容通常代表目標網頁完全靠JS動態渲染（例如SPA），這種情況也如實告知使用者，不要編造內容。參數: {"url":"https://..."}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.url||"").trim();if(!/^https?:\/\//i.test(n))return JSON.stringify({ok:!1,error:"url必須是http(s)開頭的完整網址"});let r;try{r=this._resolveWebFetchProxyUrl()}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}try{const e=await fetch(r+n,{headers:{Accept:"text/html"}});if(!e.ok)return JSON.stringify({ok:!1,error:`抓取失敗：HTTP ${e.status}`});const t=e.headers.get("content-type")||"";if(t&&!/text\/html|application\/xhtml/i.test(t))return JSON.stringify({ok:!1,error:`這個網址回傳的不是HTML網頁（content-type: ${t}），這個工具只處理網頁內容`});const a=await e.text(),{title:s,markdown:i}=this._extractReadableContentFromHtml(a);if(!i.trim())return JSON.stringify({ok:!1,error:"這個網頁沒有擷取到任何可讀文字內容——可能是完全靠JavaScript動態渲染的頁面（例如SPA），伺服器端回傳的原始HTML本身沒有實際內容"});const o=new Blob([i],{type:"text/markdown"}),l=(s||new URL(n).hostname).replace(/[\\/:*?"<>|]/g,"_").slice(0,80),c=await this.fileCache.put(`${l}.md`,"text/markdown",o,"uploaded");return JSON.stringify({ok:!0,file_id:c,title:s||n,url:n,sizeChars:i.length,preview:i.slice(0,500)+(i.length>500?"…（完整內容請用parse_uploaded_file或summarize_large_text搭配這個file_id查看）":"")})}catch(e){return JSON.stringify({ok:!1,error:String(e.message||e)})}},{type:"object",properties:{url:{type:"string",description:"要抓取的網頁完整網址，須以http(s)://開頭"}},required:["url"],additionalProperties:!1});const c={fap:{type:"string",description:"專案資料夾：已授權資料夾的參照 fap:<名稱>[/子路徑]（用 list_file_access_points 查），桌面版也可以是絕對路徑。不給就用使用者 📎 上傳的檔案（zip 會展開）"},wiki:{type:"array",items:{type:"string"},description:"選填，說明文件的網址（會抓下來當背景資料；沒有 README 時拿第一頁當簡介）"},format:{type:"array",items:{type:"string",enum:["md","mediawiki","html","pdf","docx"]},description:"輸出格式，可多個；不給就用 ⚙ 設定裡的預設"},template:{type:"string",description:"選填，範本代號（用 docgen_list_templates 查）；不給由程式依架構比對挑"},lang:{type:"string",enum:["zh-TW","en"],description:"文件語言，預設繁體中文"},level:{type:"string",enum:["brief","standard","detailed"],description:"詳細程度（表格列數）"},analysis:{type:"boolean",description:"文件最後附上分析附錄（架構比對的所有訊號與分數）"},noai:{type:"boolean",description:"true＝全部由程式寫成，不呼叫模型潤飾"},version:{type:"string",description:"文件版本，例如 1.0"},request:{type:"string",description:"使用者對這份文件的補充要求或讀者（會寫在副標題）"}},d=e=>async function(t){let n={};try{n=await this.repairJsonPayload(String(t||"{}"))}catch(e){}try{return JSON.stringify(await this._docgenRun(e,this._docgenArgsFromTool(n)))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}};e("docgen_design_guide","為一個專案寫「設計文件」：程式掃描原始檔取出建置、進入點、命令列、設定、路由、資料模型、硬體存取等事實（每筆都附檔案:行號），加權比對架構（OpenBMC、RTOS、BIOS、核心驅動、Web 服務、CGI、系統服務、GUI、分散式、外掛式命令列）、挑範本、組成文件並驗證所有引用，輸出成檔案卡片（md／mediawiki／html／pdf／docx）。找不到的東西不編，寫進「待確認與風險」。來源用 fap 資料夾或使用者上傳的程式碼。",d("design"),{type:"object",properties:c,additionalProperties:!1}),e("docgen_user_guide","為一個專案寫「使用手冊」：同樣先掃描取事實，再依專案類型（命令列、GUI、Web API、系統服務、驅動、BMC…）選範本，寫簡介、安裝、啟動、命令列選項、API、設定、疑難排解；內容只來自 README 與原始檔，附檔案:行號。輸出成檔案卡片。",d("user"),{type:"object",properties:c,additionalProperties:!1}),e("docgen_list_templates","列出文件範本（內建與使用者在 ⚙ 設定裡自訂的）：代號、類型（design／user）、適用架構、章節。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=FaDocgen.listTemplates(this._docgenSettings().templates).filter(e=>!t.kind||e.kind===t.kind);return JSON.stringify({ok:!0,templates:n.map(e=>({id:e.id,kind:e.kind,label:e.label,arch:e.arch,builtin:!!e.builtin,sections:e.sections}))})},{type:"object",properties:{kind:{type:"string",enum:["design","user"]}},additionalProperties:!1}),this._imageRegisterUnits(e),e("generate_image","畫圖的唯一入口（程式會先分流，不用你自己挑路線）：【工程圖／CAD 風格的尺寸圖（零件長寬厚、尺寸線、明細表、組裝步驟）也直接用這個工具：程式依零件表照尺寸畫，數字與比例都精準，不要自己手寫 SVG 座標；對話裡有零件表就用它，沒有就請它自己列】；使用者要「純 SVG」時，結果會附一個 .svg 檔下載。單純形狀的組合圖（流程圖、架構圖、圖表、幾何圖形、圖示…）由程式要求寫成 SVG／Mermaid 純文字再畫出來；要畫面的圖（照片、插畫、人物、風景、畫風…）由程式把需求拆成欄位（主體、動作、場景、畫風、光線、鏡頭、氣氛、色調）、依模型的吃法（SD／SDXS 逗號關鍵詞、FLUX 自然語句、SD3 混合）組成提示詞，再交給擴散模型（線上 NVIDIA 或本機小模型）。所以 prompt 直接給使用者的需求（中文也可以），不要自己改寫成英文咒語。可選參數：image（使用者貼的圖的 file_id：會先用視覺模型看懂，轉成描述當依據）、base_request（要先用純文字畫出一張工程圖／示意圖當基底，視覺模型看懂它之後再生成）、route（auto｜shapes｜diffusion，預設 auto）、style（畫風：photo｜cinematic｜anime｜watercolor｜oil｜sketch｜ink｜render3d｜pixel｜flat｜cyberpunk｜fantasy｜lowpoly｜clay｜illustration）、where（local｜remote：remote＝交給遠端群組裡的機器畫，圖會取回本機使用）、machine（where=remote 時的機器名稱或 auto）、provider（auto｜online｜local）、model、seed。回傳 file_id 與 client_file_url（可以直接用在簡報等地方）；圖已顯示在對話裡。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{return JSON.stringify(await this._imageMake(t))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:{draft:{type:"boolean",description:"選填：false＝不畫構圖草稿（預設：場景類的圖會先用通用繪圖畫草稿、給視覺模型看）"},check:{type:"boolean",description:"選填：false＝不請視覺模型檢查成品缺不缺元素"},retouch:{type:"boolean",description:"選填：false＝不做成品後製（自動對比、亮度、飽和度、銳化）"},reflect:{type:"boolean",description:"選填：畫之前先「構想」——查場景素材目錄、請模型想要準備哪些主體與素材、各放哪裡（預設：場景類或不熟的概念才會想；false＝不想）"},prompt:{type:"string",description:"要畫什麼（使用者的需求，中文英文都可以）"},image:{type:"string",description:"選填：使用者貼的圖片的 file_id（會先看懂再生成）"},base_request:{type:"string",description:"選填：要先用純文字畫出的工程圖／示意圖基底的描述"},route:{type:"string",enum:["auto","shapes","diffusion"],description:"選填：auto（預設）、shapes（強制用 SVG／Mermaid 純文字畫）、diffusion（強制用擴散模型）"},style:{type:"string",enum:["photo","cinematic","anime","watercolor","oil","sketch","ink","render3d","pixel","flat","cyberpunk","fantasy","lowpoly","clay","illustration"],description:"選填：畫風"},where:{type:"string",enum:["local","remote"],description:"選填：remote＝交給遠端群組的機器畫，圖取回本機"},machine:{type:"string",description:"where=remote 時的機器名稱，或 auto"},provider:{type:"string",enum:["auto","online","local"],description:"選填：擴散模型用線上、本機小模型，或自動"},model:{type:"string",description:"選填：線上模型 廠商/模型名"},width:{type:"integer"},height:{type:"integer"},steps:{type:"integer"},seed:{type:"integer"},cfg_scale:{type:"number"}},required:["prompt"],additionalProperties:!1});{const t={url:{type:"string",description:"網頁的完整網址（wiki、新聞、小說章節頁…），會自動抓下來轉成文字"},file_id:{type:"string",description:"已上傳的檔案或 fetch_web_page 回傳的 file_id（txt、md、docx、pdf…都可以）"},text:{type:"string",description:"直接給文章文字"}},n=async(e,t)=>{e._articleCache=e._articleCache||new Map;const n=t.file_id?"f:"+t.file_id:t.url?"u:"+String(t.url).trim():t.text?"t:"+String(t.text).length+":"+String(t.text).slice(0,40):"";if(!n)return{error:"要給 url、file_id 或 text 其中一個"};const r=e._articleCache.get(n);if(r)return r;let a="",s="",i=t.file_id?String(t.file_id):"";if(t.text)a=String(t.text);else{if(t.url){const n=e.tools.fetch_web_page;if(!n)return{error:"這個環境沒有 fetch_web_page，改用 file_id 或 text"};let r;try{r=JSON.parse(await n.callback.call(e,JSON.stringify({url:String(t.url).trim()})))}catch(e){return{error:"抓取網頁失敗："+String(e&&e.message||e)}}if(!r||!1===r.ok)return{error:String(r&&r.error||"抓取網頁失敗")};i=r.file_id,s=r.title||""}const n=await e.fileCache.get(i);if(!n)return{error:"找不到檔案 file_id="+i};s||(s=n.filename||"");for(let t=0,r=0;r<40;r++){const r=await e._parseUploadedFileContent(n,{offset:t,maxChars:2e5});if(!r||!1===r.ok)return{error:String(r&&r.error||"讀不出這個檔案")};if("string"!=typeof r.content)return{error:"這種檔案沒有可以分章節的連續文字（格式："+(r.format||"?")+"）；表格或圖片請改用對應的工具"};if(a+=r.content,!r.has_more||null==r.next_offset||a.length>4e6)break;t=r.next_offset}}if(!a.trim())return{error:"文章是空的"};const o={key:n,file_id:i||null,title:s,text:a,outline:FaArticleOutline.outline(a)};return e._articleCache.size>8&&e._articleCache.delete(e._articleCache.keys().next().value),e._articleCache.set(n,o),o};e("article_outline","看一篇長文章的目錄（章節標題、層級、每節字數、開頭幾個字），之後用 article_section 挑要讀的章節——外面的 wiki、新聞、一整本小說、上傳的文件都適用，文章很長時一定先看目錄，不要從頭翻頁讀。標題的認法：Markdown、MediaWiki、HTML、編號標題、小說的「第一章／第十二回／Chapter 3／楔子／尾聲」；都沒有就依段落切成幾份。來源給 url（網頁，自動抓）、file_id（上傳的檔案或 fetch_web_page 抓回來的）或 text 其中一個。max_depth 只看上面幾層。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await n(this,t);if(e.error)return JSON.stringify({ok:!1,error:e.error});const r=t.max_depth?FaArticleOutline.outline(e.text,{max_depth:t.max_depth}):e.outline;return JSON.stringify({ok:!0,title:e.title,file_id:e.file_id,style:r.style,total_chars:r.total_chars,sections:r.sections.map(e=>({n:e.n,level:e.level,title:e.title,chars:e.chars,preview:e.preview})),next:"article_section 用 n（章節編號）、標題的一部分或 {from, to} 讀內容，長章節會分頁（has_more / next_offset）；來源用同一個 url／file_id"})}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:Object.assign({max_depth:{type:"integer",description:"只列到第幾層標題（1 最上層）"}},t),additionalProperties:!1}),e("article_section","讀一篇長文章的某一章節（先用 article_outline 看目錄）。section＝目錄裡的編號 n，或標題的一部分（例如「第十二回」「分類」），或 {from, to} 連續幾節。長章節每次最多 max_chars 字（預設 12000），has_more 為 true 時用 offset=next_offset 接著讀。來源跟 article_outline 同一個（url／file_id／text）。",async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}try{const e=await n(this,t);if(e.error)return JSON.stringify({ok:!1,error:e.error});const r=FaArticleOutline.sectionText(e.text,e.outline,t.section,{offset:t.offset,maxChars:t.max_chars});return r.error?JSON.stringify({ok:!1,error:r.error}):JSON.stringify(Object.assign({ok:!0,title:e.title},r))}catch(e){return JSON.stringify({ok:!1,error:String(e&&e.message||e)})}},{type:"object",properties:Object.assign({section:{description:"章節編號（數字）、標題的一部分（字串），或 {from, to}"},offset:{type:"integer",description:"這一節裡從第幾個字元開始（接續上一次的 next_offset）"},max_chars:{type:"integer",description:"這次最多讀幾個字元，預設 12000"}},t),required:["section"],additionalProperties:!1})}e("summarize_large_text",'把一個已存進persistentStorage的大型文字內容（使用者上傳的檔案，或AI自己透過fetch_web_page等工具抓回來存進去的網頁內容——這類內容一樣會出現在list_uploaded_files清單裡）分段摘要——不論原始內容多長，都會自動切成多個區塊各自摘要、再彙整成一份涵蓋全文重點的最終摘要，不像parse_uploaded_file遇到超長純文字內容時會直接截斷丟棄後面的部分。壓縮檔（zip/tar/tgz）必須指定entry_path指定要摘要哪個內部檔案，不能對整個壓縮檔本身摘要；xlsx/docx/pptx這類二進位格式請改用parse_uploaded_file取得結構化內容。pdf視為長文字文件支援：會逐頁擷取文字、完整涵蓋全文不截斷（比parse_uploaded_file固定只看前12000字元更適合長文件），純掃描/圖片PDF因為沒有文字層（不支援OCR）擷取不到內容。內容越長，處理時間越久（每個區塊都是一次LLM往返），不是瞬間完成。參數: {"file_id":"...", "entry_path":"（選填，壓縮檔用）", "focus":"（選填）你想特別關注的重點方向，會用來引導每個區塊的摘要方向"}',async function(e){let t={};try{t=await this.repairJsonPayload(String(e||"{}"))}catch(e){}const n=String(t.file_id||"").trim();if(!n)return JSON.stringify({ok:!1,error:"缺少file_id參數（用list_uploaded_files查詢可用的file_id）"});c