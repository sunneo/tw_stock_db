 ("GET", "HEAD"):','        rel = environ.get("PATH_INFO", "/").lstrip("/") or "index.html"',"        path = os.path.normpath(os.path.join(PUBLIC, rel))",'        if os.path.isdir(path): path = os.path.join(path, "index.html")',"        if path.startswith(PUBLIC) and os.path.isfile(path):",'            data = open(path, "rb").read()','            start_response("200 OK", [("Content-Type", mimetypes.guess_type(path)[0] or "application/octet-stream"), ("Content-Length", str(len(data)))])',"            return [data]","    start_response(status, headers)","    return [body]","",'if __name__ == "__main__":',"    from wsgiref.simple_server import make_server",'    port = int(os.environ.get("PORT", 8000))','    print("http://localhost:%d" % port)','    make_server("0.0.0.0", port, application).serve_forever()',""].join("\n"),d=["import os","from app import app as api","from starlette.applications import Starlette","from starlette.routing import Mount","from starlette.staticfiles import StaticFiles","",'PUBLIC = os.path.join(os.path.dirname(os.path.abspath(__file__)), "public")',"","# 後端的路由優先，其餘網址去 public/ 找靜態頁面",'application = Starlette(routes=[Mount("/", app=api)])',"try:",'    api.mount("/", StaticFiles(directory=PUBLIC, html=True), name="public")',"except Exception:","    pass","app = api","",'if __name__ == "__main__":',"    import uvicorn",'    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", 8000)))',""].join("\n");function p(e,t){var n=["# "+String(t||"我的網站")+"：部署教學","","這包檔案是從編輯器的「模擬後端」匯出的：後端程式跟你在編輯器裡測試的是同一份，頁面放在 `public/`。編輯器裡的伺服器只是讓你體驗架設的感覺，要讓別人連得到，就照下面部署到真正的主機。",""];return"python"===e?n.push("## 一、先在自己電腦跑跑看","","```bash","python -m venv .venv",".venv\\Scripts\\activate        # macOS／Linux：source .venv/bin/activate","pip install -r requirements.txt","python main.py","```","","打開 http://localhost:8000 。","","## 二、放上網路（任選一種）","","### Render（最省事，有免費方案）","1. 把這個資料夾推到 GitHub。","2. Render → New → Web Service，選那個 repo。","3. Build Command：`pip install -r requirements.txt`；Start Command：見 `Procfile` 那一行。","4. 部署完成會給你一個 https 網址。","","### Railway／Fly.io","- Railway：New Project → Deploy from GitHub，會讀 `Procfile`。","- Fly.io：`fly launch`，它會用資料夾裡的 `Dockerfile`。","","### 自己的主機（VPS）","```bash","docker build -t mysite .","docker run -d -p 80:8000 --restart unless-stopped mysite","```","","## 三、注意","- 編輯器裡的資料只存在記憶體；真正部署後要存資料請用資料庫（SQLite 檔、Postgres 等），並放在會保留的磁碟。",'- 前端的 `fetch("/api/...")` 不用改，因為頁面和後端在同一個網址。',"- 密碼、金鑰一律用環境變數，不要寫進程式碼。"):"node"===e?n.push("## 一、先在自己電腦跑跑看","","```bash","npm install","npm start","```","","預設在 http://localhost:8787 ，頁面放在 `public/index.html`。環境變數：`PORT`、`DATA_DIR`（資料存放的資料夾）、`PUBLIC_DIR`。","","## 二、放上網路（任選一種）","","### Render／Railway／Fly.io","1. 推到 GitHub。","2. 建立 Web Service，Build：`npm install`，Start：`npm start`。","3. 要保留資料，掛一個持久磁碟，並把 `DATA_DIR` 指到它。","","### 自己的主機（VPS）","```bash","npm install --omit=dev","npm install -g pm2","pm2 start npm --name mysite -- start","pm2 save && pm2 startup","```","前面再放 Nginx 或 Caddy 做 https。","","## 三、注意","- 資料存成 `DATA_DIR` 裡的 JSON 檔，適合小型專案；用戶多了請改成真正的資料庫。","- 密碼、金鑰一律用環境變數。"):n.push("## 一、先在自己電腦跑跑看","","```bash","npm install","npx wrangler dev","```","","## 二、部署到 Cloudflare","","```bash","npx wrangler login","npx wrangler deploy","```","","部署完成會給你一個 `*.workers.dev` 的網址，之後可以在 Cloudflare 後台綁自己的網域。","","## 三、注意","- 即時通訊（WebSocket）在 Cloudflare 需要 Durable Objects，匯出的只有骨架，要自己補完。","- 資料請改存 Workers KV、D1 或 Durable Objects；匯出檔的儲存只是示範。"),n.join("\n")+"\n"}function u(e,t){var n,r,a=[],i=String(e||"");if("python"===t)for(r=/@\w+\.(route|get|post|put|delete|patch|websocket)\(\s*["']([^"']+)["']([^)]*)\)/g;n=r.exec(i);){var s="route"===n[1]?((/methods\s*=\s*\[([^\]]*)\]/.exec(n[3])||[])[1]||"GET").replace(/["'\s]/g,"").toUpperCase():n[1].toUpperCase();a.push(s+" "+n[2])}else for(r=/\b\w+\.(get|post|put|delete|patch|crud|ws|sse)\(\s*["'`]([^"'`]+)["'`]/g;n=r.exec(i);)a.push(("crud"===n[1]?"CRUD":n[1].toUpperCase())+" "+n[2]);return a.filter(function(e,t){return a.indexOf(e)===t}).slice(0,40)}var f=[{id:"blank",label:"空白網頁",desc:"只有一個標題的 HTML，從零開始用對話做。",spec:function(){return{v:1,title:"我的網頁",files:[{name:"index.html",content:'<!doctype html>\n<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>我的網頁</title></head>\n<body>\n<h1>Hello</h1>\n</body></html>\n'}],backend:null}}},{id:"todo",label:"待辦清單（HTML＋JS 後端）",desc:"新增、勾選、刪除待辦；後端用 router().crud 存在持久的 env.db。",spec:function(){return{title:"待辦清單",files:[{name:"index.html",content:'<!doctype html>\n<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>待辦清單</title><link rel="stylesheet" href="style.css"></head>\n<body>\n<main>\n<h1>待辦清單</h1>\n<form id="f"><input id="t" placeholder="要做什麼？" autocomplete="off" required><button>新增</button></form>\n<ul id="list"></ul>\n<p id="msg" class="muted"></p>\n</main>\n<script src="app.js"><\/script>\n</body></html>\n'},{name:"style.css",content:'body{font-family:system-ui,"Microsoft JhengHei",sans-serif;background:#f4f6f8;margin:0}\nmain{max-width:460px;margin:24px auto;background:#fff;padding:20px;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.08)}\nh1{margin:0 0 12px;font-size:22px}\nform{display:flex;gap:8px}\ninput{flex:1;padding:8px;border:1px solid #cbd5e1;border-radius:8px}\nbutton{padding:8px 14px;border:0;border-radius:8px;background:#2f6fd0;color:#fff;cursor:pointer}\nul{list-style:none;padding:0;margin:14px 0 0}\nli{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #eef2f6}\nli.done span{text-decoration:line-through;color:#94a3b8}\nli span{flex:1}\n.muted{color:#64748b;font-size:12px}\n'},{name:"app.js",content:'const list = document.getElementById("list"), msg = document.getElementById("msg");\nasync function load() {\n  const r = await fetch("/api/todos"); const items = await r.json();\n  list.innerHTML = "";\n  items.forEach((it) => {\n    const li = document.createElement("li"); if (it.done) li.className = "done";\n    const cb = document.createElement("input"); cb.type = "checkbox"; cb.checked = !!it.done; cb.onchange = async () => { await fetch("/api/todos/" + it.id, { method: "PUT", headers: { "content-type": "application/json" }, body: JSON.stringify({ ...it, done: cb.checked }) }); load(); };\n    const sp = document.createElement("span"); sp.textContent = it.text;\n    const x = document.createElement("button"); x.textContent = "刪除"; x.onclick = async () => { await fetch("/api/todos/" + it.id, { method: "DELETE" }); load(); };\n    li.append(cb, sp, x); list.appendChild(li);\n  });\n  msg.textContent = items.length + " 項";\n}\ndocument.getElementById("f").onsubmit = async (e) => {\n  e.preventDefault(); const t = document.getElementById("t");\n  await fetch("/api/todos", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ text: t.value, done: false }) });\n  t.value = ""; load();\n};\nload();\n'}],backend:{lang:"js",code:'// 模擬後端（Node 風格）：資料存在持久的 env.db，重新整理不會消失\nconst app = router();\napp.crud("/api/todos", "todos");\napp.get("/api/ping", () => ({ ok: true, time: Date.now() }));\n'}}}},{id:"chat",label:"聊天室（輪詢）",desc:"多人聊天：訊息存在後端的持久資料，頁面每隔一下用 fetch 取回新訊息（不需要 WebSocket）。",spec:function(){return{title:"聊天室",files:[{name:"index.html",content:'<!doctype html>\n<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>聊天室</title>\n<style>body{font-family:system-ui,"Microsoft JhengHei",sans-serif;margin:0;background:#eef2f7}#w{max-width:480px;margin:20px auto;background:#fff;border-radius:12px;padding:14px}#log{height:240px;overflow:auto;border:1px solid #dbe3ec;border-radius:8px;padding:8px;margin-bottom:8px}#log div{margin:2px 0}#log b{color:#2563eb}form{display:flex;gap:6px}input{flex:1;padding:8px}#n{flex:0 0 90px}</style></head>\n<body><div id="w"><h2>聊天室</h2><div id="log"></div><form id="f"><input id="n" placeholder="名字" value="訪客"><input id="m" placeholder="說點什麼" autocomplete="off"><button>送出</button></form><small id="st">載入中…</small></div>\n<script>\nconst log = document.getElementById("log"), st = document.getElementById("st");\nlet shown = 0;\nasync function poll() {\n  try {\n    const list = await (await fetch("/api/messages")).json();\n    if (list.length !== shown) { log.innerHTML = ""; list.forEach((x) => { const d = document.createElement("div"); const b = document.createElement("b"); b.textContent = x.name + "："; d.append(b, document.createTextNode(x.text)); log.appendChild(d); }); log.scrollTop = log.scrollHeight; shown = list.length; }\n    st.textContent = "共 " + list.length + " 則（每秒更新）";\n  } catch (e) { st.textContent = "連不上後端"; }\n}\ndocument.getElementById("f").onsubmit = async (e) => {\n  e.preventDefault(); const m = document.getElementById("m"); if (!m.value.trim()) return;\n  await fetch("/api/messages", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name: document.getElementById("n").value || "訪客", text: m.value, at: Date.now() }) });\n  m.value = ""; poll();\n};\npoll(); setInterval(poll, 1000);\n<\/script></body></html>\n'}],backend:{lang:"js",code:'// 模擬後端（Node 風格）：訊息存在持久的 env.db，頁面用 fetch 取回，不需要即時連線\nconst app = router();\napp.crud("/api/messages", "messages");\n'}}}},{id:"form",label:"聯絡表單（POST＋列表）",desc:"送出表單存進後端，下面列出收到的訊息。",spec:function(){return{title:"聯絡表單",files:[{name:"index.html",content:'<!doctype html>\n<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>聯絡表單</title>\n<style>body{font-family:system-ui,"Microsoft JhengHei",sans-serif;background:#f6f7f9;margin:0}main{max-width:420px;margin:24px auto;background:#fff;padding:18px;border-radius:12px}label{display:block;margin:8px 0 2px}input,textarea{width:100%;box-sizing:border-box;padding:8px}button{margin-top:10px;padding:8px 16px}pre{background:#f1f5f9;padding:8px;border-radius:8px;white-space:pre-wrap}</style></head>\n<body><main><h2>聯絡我們</h2><form id="f"><label>姓名</label><input name="name" required><label>訊息</label><textarea name="msg" rows="3" required></textarea><button>送出</button></form><h3>已收到</h3><pre id="out"></pre></main>\n<script>\nasync function refresh() { const r = await fetch("/api/messages"); document.getElementById("out").textContent = JSON.stringify(await r.json(), null, 2); }\ndocument.getElementById("f").onsubmit = async (e) => { e.preventDefault(); const d = Object.fromEntries(new FormData(e.target)); await fetch("/api/messages", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(d) }); e.target.reset(); refresh(); };\nrefresh();\n<\/script></body></html>\n'}],backend:{lang:"js",code:'// 模擬後端：收到的訊息存進 env.db\nconst app = router();\napp.post("/api/messages", async (req, env) => {\n  const b = await req.json();\n  if (!b.name || !b.msg) return fail(400, "姓名和訊息都要填");\n  const id = await env.db.nextId("messages");\n  await env.db.set("messages/" + id, { id, name: String(b.name).slice(0, 40), msg: String(b.msg).slice(0, 500), at: new Date().toISOString() });\n  return json({ ok: true, id }, 201);\n});\napp.get("/api/messages", async (req, env) => {\n  const rows = await env.db.list("messages/");\n  return json(rows.map((r) => r.value));\n});\n'}}}},{id:"python_api",label:"Python（Flask）API",desc:"頁面呼叫 Python 後端（Pyodide 跑 Flask）：問候與計算。",spec:function(){return{title:"Python 後端範例",files:[{name:"index.html",content:'<!doctype html>\n<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Python 後端範例</title>\n<style>body{font-family:system-ui,"Microsoft JhengHei",sans-serif;margin:24px}input{padding:6px}</style></head>\n<body><h2>Python 後端範例</h2><p>輸入名字，由 Python（Flask）回應：</p><input id="n" value="小明"> <button id="b">打招呼</button><pre id="o"></pre>\n<script>\ndocument.getElementById("b").onclick = async () => { const r = await fetch("/api/hello?name=" + encodeURIComponent(document.getElementById("n").value)); document.getElementById("o").textContent = JSON.stringify(await r.json(), null, 2); };\n<\/script></body></html>\n'}],backend:{lang:"python",code:'from flask import Flask, jsonify, request\n\napp = Flask(__name__)\n\n@app.get("/api/hello")\ndef hello():\n    name = request.args.get("name", "世界")\n    return jsonify({"message": f"哈囉，{name}！", "length": len(name)})\n'}}}}];function m(){return f.map(function(e){return{id:e.id,label:e.label,desc:e.desc}})}var h=["set_title","set_file","patch_file","add_file","remove_file","rename_file","set_backend","patch_backend","remove_backend"];function g(e,t,n){var r=String(null==t.find?"":t.find),a=String(null==t.replace?"":t.replace);if(!r)throw new Error(n+"：find 不能是空的");var i=function(e,t){if(!t)return 0;for(var n=0,r=0;(r=e.indexOf(t,r))>=0;)n++,r+=t.length;return n}(e,r);if(0===i)throw new Error(n+"：找不到要取代的文字（find 要跟現在的內容一字不差，包含縮排）："+r.slice(0,50));if(i>1&&!0!==t.all)throw new Error(n+"：要取代的文字出現 "+i+" 次，請多帶幾行上下文讓它唯一，或加 all:true");return!0===t.all?e.split(r).join(a):e.replace(r,function(){return a})}function b(e){var t=i(e).spec,n=[t.title+"："+t.files.length+" 個檔案（"+t.files.map(function(e){return e.name}).join("、")+"）"];return n.push(t.backend?"後端："+("python"===t.backend.lang?"Python":"JS（Node 風格）")+"，"+(u(t.backend.code,t.backend.lang).join("、")||"沒有讀到路由"):"沒有後端"),n}function y(e,t){return(e=String(e||"")).length>t?e.slice(0,t)+"\n…（共 "+e.length+" 字，後面省略）":e}var _={format:'網頁描述（JSON）：{title, files:[{name,content}], backend:{lang:"js"|"python", code}|null}。files[0] 是 index.html，其他檔案用 <link rel="stylesheet" href="style.css">、<script src="app.js"><\/script> 引用（預覽時內嵌）。後端 lang js＝沙盒 mock 伺服器的寫法（router／app.crud／app.get／env.db），python＝Flask／FastAPI。後端是「假的伺服器」（記憶體傳遞，資料存在記憶體或持久儲存），沒有 WebSocket。',edits:'編輯動作：{op:"patch_file",name,find,replace,all?}、{op:"set_file",name,content}、{op:"add_file",name,content}、{op:"remove_file",name}、{op:"rename_file",name,to}、{op:"set_title",text}、{op:"set_backend",lang,code}、{op:"patch_backend",find,replace,all?}、{op:"remove_backend"}。patch 的 find 要跟現有內容一字不差、而且只出現一次。',backend:'模擬後端：假的伺服器，傳遞方式跟 AIDoc 的假 server 一樣——頁面的請求用訊息傳給 app，後端程式在記憶體裡執行、把結果傳回去，資料放在記憶體或持久儲存；不開埠、不需要 WebSocket。只是體驗架設的感覺，要上線請匯出部署檔（含部署教學）。JS 後端（Node 風格）：const app = router(); app.crud("/api/x","x"); app.get("/api/ping", () => ({ok:true})); app.post(...); 資料用 env.db（持久）；可以匯出成 Node 或 Cloudflare 的部署檔。Python 後端：Flask／Bottle／FastAPI／Starlette，用 Pyodide 跑（app 載入一次、編輯期間保留；資料請存 /tmp 的檔案或 sqlite3）。要即時更新就讓頁面定時 fetch。PHP：瀏覽器裡沒有 PHP 執行環境，目前不能跑。',starters:"起手式："+f.map(function(e){return e.id+"（"+e.label+"）"}).join("、")+"。"};return{LIMITS:e,OPS:h,TOPICS:_,STARTERS:m(),defaults:a,validate:i,buildHtml:s,routesOf:u,pyPackages:o,pyKind:l,deployGuide:p,exportPython:function(e){var t=i(e).spec,n=t.backend;if(!n||"python"!==n.lang)return null;var r=l(n.code),a=o(n.code).slice();"asgi"===r?["starlette","uvicorn","aiofiles"].forEach(function(e){a.indexOf(e)<0&&a.push(e)}):a.indexOf("gunicorn")<0&&a.push("gunicorn");var u=[{name:"app.py",content:n.code},{name:"main.py",content:"asgi"===r?d:c},{name:"requirements.txt",content:a.join("\n")+"\n"}],f="asgi"===r?"uvicorn main:app --host 0.0.0.0 --port $PORT":"gunicorn main:application --bind 0.0.0.0:$PORT";return u.push({name:"Procfile",content:"web: "+f+"\n"}),u.push({name:"Dockerfile",content:["FROM python:3.12-slim","WORKDIR /app","COPY requirements.txt .","RUN pip install --no-cache-dir -r requirements.txt","COPY . .","ENV PORT=8000","EXPOSE 8000","CMD "+JSON.stringify(f.replace("$PORT","8000").split(" ")),""].join("\n")}),u.push({name:"public/index.html",content:s(t)}),(t.files||[]).forEach(function(e){"index.html"!==e.name&&u.push({name:"public/"+e.name,content:e.content})}),u.push({name:"README.md",content:p("python",t.title)}),{files:u,kind:r}},starter:function(e){var t=f.filter(function(t){return t.id===e})[0];return t?i(t.spec()).spec:null},listStarters:m,applyEdits:function(t,a){var s,o=(s=i(t).spec,JSON.pa