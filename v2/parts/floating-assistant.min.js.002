ror': 'x', 'rows': ['..rrr...', '.rhrrr..', 'rhrrrrrr', 'rrrrrrrr', 'rrrrrrrr', '.rrrrrrr', '..rrrrrr', '...rrrrr', '....rrrr', '.....rrr', '......rr', '.......r'], 'shade': false, 'outline': true},\n    sword: {'palette': {'b': '#cfd8dc', 'd': '#90a4ae', 'g': '#c9a227', 'w': '#6d4c41'}, 'mirror': 'x', 'rows': ['.......b', '.......b', '......bb', '......bb', '......bb', '......bb', '......bb', '......bb', '......bb', '......bb', '......bb', '......bb', '..gggggg', '..gggggg', '.......w', '.......w', '.......w', '......ww', '......gg'], 'shade': true, 'outline': true},\n    potion: {'palette': {'g': '#b0bec5', 'l': '#e53935', 'd': '#8e0000', 'c': '#8d6e63'}, 'mirror': 'x', 'rows': ['....cccc', '....cccc', '.....ggg', '.....ggg', '....gggg', '...ggggg', '..ggllll', '.gllllll', '.gllllll', '.gdddddd', '..gddddd'], 'shade': true, 'outline': true},\n    coin: {'palette': {'y': '#ffd54f', 'o': '#f9a825', 'd': '#b8860b'}, 'size': [12, 12], 'rows': ['....yyyy....', '..yyyyyyyy..', '.yyyyooyyyy.', '.yyyoyyoyyy.', 'yyyyoyyyyyyy', 'yyyyoyyyyyyy', 'yyyyoyyyyyyy', 'yyyyoyyyyyyy', '.yyyoyyoyyy.', '.yyyyooyyyy.', '..yyyyyyyy..', '....yyyy....'], 'shade': true, 'outline': true},\n    key: {'palette': {'y': '#ffd54f', 'd': '#b8860b'}, 'size': [16, 8], 'rows': ['.yyyy...........', 'yy..yy..........', 'y....y..........', 'yy..yyyyyyyyyyyy', '.yyyy......yy.yy', '...........y..yy', '................', '................'], 'shade': true, 'outline': true},\n    flower: {'palette': {'p': '#f48fb1', 'y': '#ffd54f', 's': '#43a047', 'l': '#66bb6a'}, 'mirror': 'x', 'rows': ['...pp...', '..pppp.p', '.ppppppp', '.pppyyyp', '..pyyyyy', '.ppyyyyy', '..ppppyy', '...pp.ys', '.......s', '..l....s', '.lll...s', '..ll...s'], 'shade': false, 'outline': true},\n    mushroom: {'palette': {'r': '#e53935', 'w': '#fafafa', 's': '#efebe9', 'd': '#c9bfb8'}, 'mirror': 'x', 'rows': ['....rrrr', '..rrrrrr', '.rrwwrrr', '.rwwwrrr', 'rrrwwrrw', 'rrrrrrww', 'rrrrrrrr', '.....sss', '.....sss', '.....sss', '....ssss'], 'shade': true, 'outline': true},\n    gem: {'palette': {'b': '#4fc3f7', 'l': '#b3e5fc', 'd': '#0277bd'}, 'mirror': 'x', 'rows': ['..bbbb', '.blllb', 'blllbb', 'bbbbbb', '.dbbbb', '..dbbb', '...dbb', '....db'], 'shade': false, 'outline': true},\n    chest: {'palette': {'w': '#8d6e63', 'l': '#a1887f', 'd': '#5d4037', 'y': '#ffd54f'}, 'size': [16, 12], 'rows': ['..dddddddddddd..', '.dllllllllllllld', 'dlwwwwwwwwwwwwwd', 'dwwwwwwwwwwwwwwd', 'dddddddddddddddd', 'dwwwwwwyywwwwwwd', 'dwwwwwwyywwwwwwd', 'dwwwwwwwwwwwwwwd', 'dwwwwwwwwwwwwwwd', 'dwwwwwwwwwwwwwwd', 'dddddddddddddddd'], 'shade': false, 'outline': true}\n  };\n  var TEMPLATE_NAMES = Object.keys(TEMPLATES);\n  function template(name, recolor) {\n    var t = TEMPLATES[name]; if (!t) { return null; } var spec = JSON.parse(JSON.stringify(t));\n    if (isObj(recolor)) { Object.keys(recolor).forEach(function (k) { if (spec.palette[k] && isHex(recolor[k])) { spec.palette[k] = recolor[k]; } }); }\n    return spec;\n  }\n\n  return { MIN: MIN, MAX: MAX, MAXOPS: MAXOPS, OPS: OPS, TEMPLATES: TEMPLATES, TEMPLATE_NAMES: TEMPLATE_NAMES, validate: validate, render: render, check: check, template: template, dims: dims };\n});\n",deck_core:"// Core of \"/media-presentation\": the deck format (a declarative .deck.yaml; the only script a deck may carry is the html of a \"widget\" visual, which runs in its own sandboxed frame), its validator, the\n// narration/subtitle timing, the cue schedule, the whole-deck timeline and the frame renderer.\n//\n// Pure: no DOM, no network. Everything that touches the browser (loading images, TTS, the player window, the exporters)\n// lives in ai_chat_deck_player.js and hands this file ready-made things (Image objects, a visual \"drawer\", audio length).\n// That split is what makes the renderer deterministic: renderFrame(ctx, deck, timeline, T, info) is a function of T only,\n// so the live player and the MP4 exporter call the SAME function and what you see is what is exported.\n//\n// Loadable both as a browser global (window.AiChatDeckCore) and by node (test/media/*.test.js).\n(function (root, factory) {\n  if (typeof module === 'object' && module.exports) { module.exports = factory(); } else { root.AiChatDeckCore = factory(); }\n})(typeof self !== 'undefined' ? self : this, function () {\n  'use strict';\n\n  // procedural pictures (map:, actor:, bust:, cg:, fx:) live in rpg_art.js; resolved lazily so load order does not matter\n  var _art = null;\n  function art() { if (_art) { return _art; } _art = (typeof AiChatDeckRpgArt !== 'undefined' && AiChatDeckRpgArt) || (typeof require === 'function' ? (function () { try { return require('./rpg_art.js'); } catch (e) { return null; } })() : null); return _art; }\n  function isProc(src) { return /^(map|actor|bust|cg|fx):/.test(str(src)); }\n  // a valid moment: seconds, or { sentence: N (1-based) | line: <say id>, edge?: start|end, offset?: seconds }\n  function okAt(at) { if (typeof at === 'number') { return true; } if (!isObj(at)) { return false; } if (at.edge != null && at.edge !== 'start' && at.edge !== 'end') { return false; } if (at.offset != null && typeof at.offset !== 'number') { return false; } return (Number.isInteger(at.sentence) && at.sentence >= 1) || (typeof at.line === 'string' && at.line.length > 0); }\n\n  var W = 1920, H = 1080;\n  var KIND = 'ai_chat_deck';\n  var LAYOUTS = ['title', 'topic', 'content', 'split', 'visual'];\n  var VISUAL_KINDS = ['shapes', 'anim2d', 'svg', 'mermaid', 'chart', 'image', 'collage', 'table', 'scene3d', 'group', 'code', 'terminal', 'quiz', 'widget', 'video'];\n  var TRANSITIONS = ['fade', 'slide-left', 'slide-right', 'push', 'zoom', 'wipe', 'curtain', 'spin', 'fly', 'none'];\n  var STYLES = ['flat', '3d'];\n  var ENVIRONMENTS = ['template', 'studio', 'opera', 'space'];\n  // The camera of a 3D slide (see ai_chat_deck_stage3d.js): a shot, or a list of shots the camera moves through during the slide.\n  var CAMERA_PRESETS = ['front', 'three-quarter', 'left', 'right