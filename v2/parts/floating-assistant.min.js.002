tep: 0.16, wind: 1.6, ding: 0.9, sparkle: 0.8, growl: 0.9, bell: 1.2, splat: 0.4, blip: 0.09 };\n\n  function rng(seed) { var s = seed >>> 0 || 1; return function () { s ^= s << 13; s >>>= 0; s ^= s >>> 17; s ^= s << 5; s >>>= 0; return (s / 4294967296) * 2 - 1; }; }\n  function env(t, a, d) { return t < a ? t / a : Math.exp(-(t - a) / d); }\n\n  // one tone with a pitch that can slide: f0 -> f1 over `dur`, amplitude envelope attack a, decay d\n  function tone(out, sr, start, dur, f0, f1, a, d, gain, shape) {\n    var n = Math.floor(dur * sr), s0 = Math.floor(start * sr), ph = 0;\n    for (var i = 0; i < n && s0 + i < out.length; i++) {\n      var t = i / sr, f = f0 + (f1 - f0) * (t / dur); ph += 2 * Math.PI * f / sr;\n      var v = shape === 'square' ? (Math.sin(ph) > 0 ? 0.6 : -0.6) : (shape === 'tri' ? (2 / Math.PI) * Math.asin(Math.sin(ph)) : Math.sin(ph));\n      out[s0 + i] += v * env(t, a, d) * gain;\n    }\n  }\n  function noise(out, sr, start, dur, a, d, gain, lp, seed) {\n    var r = rng(seed || 7), n = Math.floor(dur * sr), s0 = Math.floor(start * sr), y = 0;\n    for (var i = 0; i < n && s0 + i < out.length; i++) { var t = i / sr; y += (r() - y) * lp; out[s0 + i] += y * env(t, a, d) * gain; }\n  }\n\n  function render(name, sr, opts) {\n    opts = opts || {}; name = NAMES.indexOf(name) >= 0 ? name : 'pop'; sr = sr || 44100;\n    var dur = opts.dur || (name === 'blip' ? ((opts.voice && opts.voice.len) || 0.06) + 0.03 : SEC[name]), out = new Float32Array(Math.ceil(dur * sr)), vol = opts.volume == null ? 1 : opts.volume;\n    if (name === 'pop') { tone(out, sr, 0, 0.16, 520, 1500, 0.004, 0.035, 0.7, 'sine'); noise(out, sr, 0, 0.04, 0.001, 0.01, 0.25, 0.6, 3); }\n    else if (name === 'boing') { tone(out, sr, 0, 0.45, 180, 520, 0.005, 0.18, 0.55, 'tri'); tone(out, sr, 0.04, 0.4, 360, 1040, 0.005, 0.12, 0.2, 'sine'); }\n    else if (name === 'whoosh') { noise(out, sr, 0, 0.7, 0.18, 0.22, 0.9, 0.12, 11); noise(out, sr, 0.1, 0.5, 0.2, 0.15, 0.4, 0.4, 13); }\n    else if (name === 'thump') { tone(out, sr, 0, 0.32, 110, 45, 0.003, 0.07, 0.95, 'sine'); noise(out, sr, 0, 0.06, 0.001, 0.015, 0.3, 0.08, 5); }\n    else if (name === 'knock') { [0, 0.2].forEach(function (s, k) { tone(out, sr, s, 0.12, 260, 190, 0.002, 0.03, 0.8, 'sine'); noise(out, sr, s, 0.03, 0.001, 0.008, 0.35, 0.3, 21 + k); }); }\n    else if (name === 'step') { tone(out, sr, 0, 0.12, 140, 80, 0.002, 0.03, 0.7, 'sine'); noise(out, sr, 0, 0.05, 0.001, 0.012, 0.3, 0.2, 9); }\n    else if (name === 'wind') { noise(out, sr, 0, 1.6, 0.4, 0.9, 0.55, 0.035, 17); noise(out, sr, 0.2, 1.2, 0.5, 0.7, 0.3, 0.07, 19); }\n    else if (name === 'ding') { tone(out, sr, 0, 0.9, 1320, 1320, 0.003, 0.25, 0.5, 'sine'); tone(out, sr, 0, 0.9, 1980, 1980, 0.003, 0.15, 0.2, 'sine'); }\n    else if (name === 'sparkle') { [0, 0.08, 0.16, 0.26, 0.36].forEach(function (s, k) { tone(out, sr, s, 0.3, 1800 + k * 380, 2200 + k * 380, 0.002, 0.07, 0.3, 'sine'); }); }\n    else if (name === 'growl') { tone(out, sr, 0, 0.9, 90, 70, 0.08, 0.5, 0.6, 'square'); tone(out, sr, 0, 0.9, 135, 100, 0.08, 0.4, 0.25, 'tri'); noise(out, sr, 0, 0.9, 0.1, 0.5, 0.15, 0.05, 23); }\n    else if (name === 'bell') { [523, 1046, 1568, 2093].forEach(function (f, k) { tone(out, sr, 0, 1.2, f, f, 0.002, 0.5 / (k + 1), 0.4 / (k + 1), 'sine'); }); }\n    else if (name === 'blip') {\n      // one letter of somebody's voice: a short tone, its pitch hopping from letter to letter (step -2..2 comes from the letter), vibrato, a little noise for a rough voice\n      var vc = opts.voice || {}, st = opts.step || 0, len = vc.len || 0.06, jit = vc.jitter == null ? 0.5 : vc.jitter, f = (vc.pitch || 230) * Math.pow(2, st * jit * 1.6 / 12), ph = 0, vib = vc.vibrato || 0, shape = vc.wave || 'tri';\n      for (var bi = 0; bi < Math.floor(len * sr) && bi < out.length; bi++) {\n        var bt = bi / sr; ph += 2 * Math.PI * f * (1 + vib * 0.05 * Math.sin(2 * Math.PI * 28 * bt)) / sr;\n        var bv = shape === 'square' ? (Math.sin(ph) > 0 ? 0.6 : -0.6) : (shape === 'tri' ? (2 / Math.PI) * Math.asin(Math.sin(ph)) : Math.sin(ph));\n        out[bi] += bv * env(bt, 0.004, len * 0.5) * 0.9;\n      }\n      if (vc.noise) { noise(out, sr, 0, len, 0.002, len * 0.4, vc.noise * 0.7, 0.35, 41 + st + 3); }\n    }\n    else if (name === 'splat') { noise(out, sr, 0, 0.3, 0.002, 0.07, 0.8, 0.25, 31); tone(out, sr, 0, 0.3, 220, 80, 0.002, 0.06, 0.5, 'sine'); }\n    var peak = 0; for (var i = 0; i < out.length; i++) { var a = Math.abs(out[i]); if (a > peak) { peak = a; } }\n    var g = peak > 0 ? (0.85 / peak) * vol : 0; for (var j = 0; j < out.length; j++) { out[j] *= g; }\n    return out;\n  }\n\n  return { NAMES: NAMES, DURATION: SEC, render: render };\n});\n",stage_core:"/* 故事／名詞清單 → 舞台描述（FaStage）：從文字推導「意象」（誰、在哪、做什麼、說什麼），再變成簡報的動畫物件描述（visual: {kind: collage}）。\n * 給離線小模型與會退化的線上模型用（CoLU 的形狀：程式讀、程式排、程式檢查；歧義才問模型一個封閉的選擇題）。\n *\n *   ① readStory   句子（跟簡報的 splitSentences 完全同一套切法，所以第 N 句就是念到的第 N 句）→ 每句有哪些角色／物件／地點（詞表，中英）、幾個（「三隻小豬」）、\n *                  誰說了什麼（「…」或「X說，…」）、動詞的意象（跑過來＝從場外跑進來、吹＝風、敲＝敲門、跳、飛、倒…）、進出場景（走進屋裡／走出屋外）。\n *   ② planStage   角色依第一次出現的句子「彈出來」（at: {sentence: N}）、地點當背景、對話變成說話泡泡（say）、走進／走出變成鏡頭拉近／拉遠（camera）、\n *                  跑／飛／吹／敲／跳／倒變成移動（keys）與音效（sounds／sfx）、驚嘆聲變成大字（texts shout）。圖片只是占位字串 \"emoji:🐷\"，由宿主換成真的圖片。\n *   ③ 缺口與問題  說話的人認不出來（這句話是誰說的？）→ 封閉選單（候選角色，最多 4 個），模型挑不出來就用程式的預設（最近提到的角色）。\n *   ④ introList   名詞清單（「蜘蛛、猴子、蝴蝶」）→ 旁白「這是蜘蛛。這是猴子。…」＋每個東西彈出來、圈起來、擺動（小朋友認識東西）。\n * 純函式（UMD），沒有相依（splitSentences 可注入，預設用 deck_core 的）。\n */\n(function (root, factory) {\n  var Core = (typeof AiChatDeckCore !== 'undefined' && AiChatDeckCore) || (root && root.AiChatDeckCore) || (typeof require === 'function' ? (function () { try { return require('./deck_core.js'); } catch (e) { return null; } })() : null);\n  if (typeof module === 'object' && module.exports) { module.exports = factory(Core); } else { root.AiChatDeckStage = factory(Core); }\n})(typeof self !== 'undefined' ? self : this, function (Core) {\n  'use strict';\n\n  // ---------- 詞表：[id, 中文名稱（長的在前）, 英文名稱, emoji, 種類（char 角色／thing 東西／place 地點）] ----------\n  var LEX = [\n    ['pig', '小豬,豬', 'pig,piglet', '🐷', 'char'], ['wolf', '大野狼,野狼,狼', 'wolf', '🐺', 'char'], ['monkey', '猴子,猴', 'monkey', '🐒', 'char'], ['spider', '蜘蛛', 'spider', '🕷️', 'char'],\n    ['butterfly', '蝴蝶', 'butterfly', '🦋', 'char'], ['rabbit', '兔子,小兔,兔', 'rabbit,bunny,hare', '🐰', 'char'], ['turtle', '烏龜,龜', 'turtle,tortoise', '🐢', 'char'], ['cat', '小貓,貓咪,貓', 'cat,kitten', '🐱', 'char'],\n    ['dog', '小狗,狗', 'dog,puppy', '🐶', 'char'], ['bird', '小鳥,鳥', 'bird', '🐦', 'char'], ['fish', '小魚,魚', 'fish', '🐟', 'char'], ['bear', '大熊,熊', 'bear', '🐻', 'char'], ['lion', '獅子', 'lion', '🦁', 'char'],\n    ['tiger', '老虎', 'tiger', '🐯', 'char'], ['elephant', '大象,象', 'elephant', '🐘', 'char'], ['cow', '乳牛,牛', 'cow', '🐮', 'char'], ['horse', '馬', 'horse', '🐴', 'char'], ['sheep', '綿羊,小羊,羊', 'sheep,lamb', '🐑', 'char'],\n    ['duck', '鴨子,鴨', 'duck', '🦆', 'char'], ['chicken', '小雞,母雞,雞', 'chicken,hen', '🐔', 'char'], ['frog', '青蛙', 'frog', '🐸', 'char'], ['bee', '蜜蜂', 'bee', '🐝', 'char'], ['ant', '螞蟻', 'ant', '🐜', 'char'],\n    ['snake', '蛇', 'snake', '🐍', 'char'], ['panda', '貓熊,熊貓', 'panda', '🐼', 'char'], ['fox', '狐狸', 'fox', '🦊', 'char'], ['mouse', '老鼠', 'mouse', '🐭', 'char'], ['dragon', '龍', 'dragon', '🐲', 'char'],\n    ['boy', '小男孩,男孩', 'boy', '👦', 'char'], ['girl', '小女孩,女孩', 'girl', '👧', 'char'], ['baby', '寶寶,嬰兒', 'baby', '👶', 'char'], ['king', '國王', 'king', '🤴', 'char'], ['princess', '公主', 'princess', '👸', 'char'],\n    ['mother', '媽媽,母親', 'mother,mom', '👩', 'char'], ['father', '爸爸,父親', 'father,dad', '👨', 'char'], ['robot', '機器人', 'robot', '🤖', 'char'], ['ghost', '幽靈,鬼', 'ghost', '👻', 'char'], ['pumpkin', '南瓜', 'pumpkin', '🎃', 'thing'],\n    ['house', '房子,屋子,小屋,家', 'house,home', '🏠', 'place'], ['castle', '城堡', 'castle', '🏰', 'place'], ['school', '學校', 'school', '🏫', 'place'], ['forest', '森林', 'forest', '🌲', 'place'], ['mountain', '高山,山', 'mountain', '⛰️', 'place'],\n    ['sea', '大海,海邊,海', 'sea,ocean', '🌊', 'place'], ['farm', '農場', 'farm', '🚜', 'place'], ['sun', '太陽', 'sun', '☀️', 'thing'], ['moon', '月亮', 'moon', '🌙', 'thing'], ['star', '星星', 'star', '⭐', 'thing'],\n    ['cloud', '白雲,雲', 'cloud', '☁️', 'thing'], ['rain', '下雨,雨', 'rain', '🌧️', 'thing'], ['tree', '大樹,樹', 'tree', '🌳', 'thing'], ['flower', '花朵,花', 'flower', '🌸', 'thing'], ['apple', '蘋果', 'apple', '🍎', 'thing'],\n    ['banana', '香蕉', 'banana', '🍌', 'thing'], ['grape', '葡萄', 'grape', '🍇', 'thing'], ['strawberry', '草莓', 'strawberry', '🍓', 'thing'], ['watermelon', '西瓜', 'watermelon', '🍉', 'thing'], ['carrot', '紅蘿蔔,胡蘿蔔', 'carrot', '🥕', 'thing'],\n    ['cake', '蛋糕', 'cake', '🎂', 'thing'], ['candy', '糖果', 'candy', '🍬', 'thing'], ['bread', '麵包', 'bread', '🍞', 'thing'], ['egg', '雞蛋,蛋', 'egg', '🥚', 'thing'], ['car', '汽車,小汽車', 'car', '🚗', 'thing'],\n    ['boat', '小船,船', 'boat,ship', '🚢', 'thi